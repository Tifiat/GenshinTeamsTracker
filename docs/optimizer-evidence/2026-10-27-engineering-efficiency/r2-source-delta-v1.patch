+func TestGenerateCreatesDeterministicGenericPublic45Fixture(t *testing.T) {
+	config := Config{Wearers: [4]WearerSpec{
+		{WearerKey: "zeta_unlisted", Element: "pyro", SetUID: "public_set_a"},
+		{WearerKey: "alpha_unlisted", Element: "hydro", SetUID: "public_set_b"},
+		{WearerKey: "delta_unlisted", Element: "pyro", SetUID: "public_set_a"},
+		{WearerKey: "beta_unlisted", Element: "physical", SetUID: "public_set_c"},
+	}}
+	fixture, err := Generate(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	repeated, err := Generate(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(fixture, repeated) {
+		t.Fatal("fixture IDs, ordering or generated content are not deterministic")
+	}
+	if err := theoryalloc.ValidateFull45(fixture.AnchorState); err != nil {
+		t.Fatalf("anchor is not a legal full45 witness: %v", err)
+	}
+
+	wantWearers := [4]string{"alpha_unlisted", "beta_unlisted", "delta_unlisted", "zeta_unlisted"}
+	if fixture.WearerKeys != wantWearers {
+		t.Fatalf("wearers were not canonicalized: got %v want %v", fixture.WearerKeys, wantWearers)
+	}
+	wantElements := map[string]string{
+		"alpha_unlisted": "hydro", "beta_unlisted": "physical",
+		"delta_unlisted": "pyro", "zeta_unlisted": "pyro",
+	}
+	choices, keys, values, mainValues := theoryalloc.MainChoices(), theoryalloc.StatKeys(), theoryalloc.StatValues(), theoryalloc.MainValues()
+	expectedPerWearer := expectedPieceCount(choices, keys)
+	if expectedPerWearer != 295 {
+		t.Fatalf("unexpected production template size: got %d pieces per wearer, review the bound", expectedPerWearer)
+	}
+	if len(fixture.Artifacts) != 4*expectedPerWearer {
+		t.Fatalf("got %d artifacts, want %d", len(fixture.Artifacts), 4*expectedPerWearer)
+	}
+
+	byID := make(map[int64]contracts.Artifact, len(fixture.Artifacts))
+	for index, artifact := range fixture.Artifacts {
+		if artifact.ArtifactID != int64(index+1) {
+			t.Fatalf("artifact IDs/order are not deterministic at row %d: %d", index, artifact.ArtifactID)
+		}
+		if _, duplicate := byID[artifact.ArtifactID]; duplicate {
+			t.Fatalf("duplicate physical artifact ID %d", artifact.ArtifactID)
+		}
+		byID[artifact.ArtifactID] = artifact
+	}
+
+	allIDs := map[int64]bool{}
+	for actor, wearerKey := range fixture.WearerKeys {
+		initialLines, upgradeUnits := actorRollTotals(fixture.AnchorState, actor)
+		if initialLines != 20 || math.Abs(upgradeUnits-25) > 1e-8 {
+			t.Fatalf("%s anchor has %d initial lines and %g upgrade units, want 20 and 25", wearerKey, initialLines, upgradeUnits)
+		}
+		ids := fixture.CandidateIDsByWearer[actor]
+		if len(ids) != expectedPerWearer {
+			t.Fatalf("%s has %d candidates, want %d", wearerKey, len(ids), expectedPerWearer)
+		}
+		identitySet := map[string]bool{}
+		mainCounts := map[string]int{}
+		balancedCounts := map[string]int{}
+		critCounts := map[string]int{}
+		endpointCoverage := map[string]bool{}
+		anchorUsed := map[int64]bool{}
+		for slot := range fixture.Anchor[actor] {
+			id := fixture.Anchor[actor][slot]
+			if id <= 0 || anchorUsed[id] {
+				t.Fatalf("%s anchor has a missing/reused item ID %d", wearerKey, id)
+			}
+			anchorUsed[id] = true
+		}
+		for _, id := range ids {
+			if allIDs[id] {
+				t.Fatalf("physical artifact ID %d appears in two wearer inventories", id)
+			}
+			allIDs[id] = true
+			artifact, exists := byID[id]
+			if !exists {
+				t.Fatalf("%s references missing artifact %d", wearerKey, id)
+			}
+			slot := slotIndex(artifact.Slot)
+			if slot < 0 || artifact.SetUID != fixture.SlotSetUIDsByWearer[actor][slot] {
+				t.Fatalf("%s candidate uses set %q in slot %q, want declared slot set", wearerKey, artifact.SetUID, artifact.Slot)
+			}
+			if !containsString(choices[slot], artifact.MainStat.Key) {
+				t.Fatalf("artifact %d has illegal %s main %q", id, artifact.Slot, artifact.MainStat.Key)
+			}
+			mainValue, ok := mainValues[artifact.MainStat.Key]
+			if !ok || artifact.MainStat.Value != decimal(mainValue) {
+				t.Fatalf("artifact %d did not use the production main value", id)
+			}
+			if artifact.Rarity != 5 || artifact.Level != 20 || len(artifact.Substats) != 4 {
+				t.Fatalf("artifact %d is not a level-20 five-star four-line piece", id)
+			}
+			for sub := 1; sub < len(artifact.Substats); sub++ {
+				if artifact.Substats[sub-1].Key >= artifact.Substats[sub].Key {
+					t.Fatalf("artifact %d substats are not sorted/unique", id)
+				}
+			}
+			for _, sub := range artifact.Substats {
+				if sub.Key == artifact.MainStat.Key {
+					t.Fatalf("artifact %d has a main/substat collision", id)
+				}
+			}
+
+			identity := artifact
+			identity.ArtifactID = 0
+			identityJSON, err := contracts.CanonicalJSON(identity)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if identitySet[string(identityJSON)] {
+				t.Fatalf("%s contains a duplicate exact piece identity", wearerKey)
+			}
+			identitySet[string(identityJSON)] = true
+			mainCounts[artifact.Slot+"/"+artifact.MainStat.Key]++
+
+			state, upgrades := replacePiece(fixture.AnchorState, actor, slot, artifact, keys, values)
+			if err := theoryalloc.ValidateFull45(state); err != nil {
+				t.Fatalf("artifact %d cannot replace its anchor slot in a legal full45 state: %v", id, err)
+			}
+			upgradeTotal := 0.0
+			endpointStat := ""
+			endpointCount := 0
+			for line, upgrade := range upgrades {
+				if !isQuarter(upgrade) || upgrade < 0 {
+					t.Fatalf("artifact %d has an illegal quarter-upgrade value %g", id, upgrade)
+				}
+				upgradeTotal += upgrade
+				if math.Abs(upgrade-5) < 1e-8 {
+					endpointCount++
+					endpointStat = artifact.Substats[line].Key
+				}
+			}
+			if math.Abs(upgradeTotal-5) > 1e-8 {
+				t.Fatalf("artifact %d has %g upgrades, want five", id, upgradeTotal)
+			}
+			mainKey := artifact.Slot + "/" + artifact.MainStat.Key
+			if endpointCount == 1 {
+				endpointCoverage[mainKey+"/"+endpointStat] = true
+			}
+			if allUpgradesEqual(upgrades, 1.25) {
+				balancedCounts[mainKey]++
+			}
+			if isCritTemplate(artifact, keys, values) {
+				critCounts[mainKey]++
+			}
+		}
+
+		anchorMains := [5]string{"hp", "atk", "atk_percent", wantElementsMain(wantElements[wearerKey]), "crit_damage"}
+		if fixture.AnchorState.Mains[actor] != anchorMains {
+			t.Fatalf("%s anchor mains = %v, want %v", wearerKey, fixture.AnchorState.Mains[actor], anchorMains)
+		}
+		for slot, mains := range choices {
+			for _, main := range mains {
+				eligible := 0
+				for _, key := range keys {
+					if key != main {
+						eligible++
+						if !endpointCoverage[slots[slot]+"/"+main+"/"+key] {
+							t.Fatalf("%s lacks endpoint template for %s/%s substat %s", wearerKey, slots[slot], main, key)
+						}
+					}
+				}
+				key := slots[slot] + "/" + main
+				if mainCounts[key] != eligible+2 || balancedCounts[key] != 1 || critCounts[key] != 1 {
+					t.Fatalf("%s %s has %d pieces, %d balanced, and %d crit templates; want %d, 1, and 1", wearerKey, key, mainCounts[key], balancedCounts[key], critCounts[key], eligible+2)
+				}
+			}
+		}
+	}
+
+	if len(allIDs) != len(fixture.Artifacts) {
+		t.Fatalf("per-wearer inventory lists cover %d of %d artifacts", len(allIDs), len(fixture.Artifacts))
+	}
+	// Canonical order places the two identical set/element declarations at
+	// delta and zeta, not at their original input positions.
+	if err := assertSameGenericTemplates(t, fixture, 2, 3); err != nil {
+		t.Fatal(err)
+	}
+}
