+	EnginePatchManifestSHA256  string `json:"engine_patch_manifest_sha256"`
+}
+
+// StatResponseSample retains one full ordinary result summary and its paired
+// response. The observed delta is local proposal evidence, not an exact
+// formula, cap/global proof, or ordinary finalist verification.
+type StatResponseSample struct {
+	Seed                  int64              `json:"seed"`
+	SampleSeed            string             `json:"sample_seed"`
+	Iterations            int                `json:"iterations"`
+	DPS                   float64            `json:"dps"`
