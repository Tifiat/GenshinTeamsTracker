+
+func expectedPieceCount(choices [5][]string, keys [10]string) int {
+	total := 0
+	for _, mains := range choices {
+		for _, main := range mains {
+			eligible := 0
+			for _, key := range keys {
+				if key != main {
+					eligible++
+				}
+			}
+			total += 2 + eligible
+		}
+	}
+	return total
+}
+
+func replacePiece(anchor theoryalloc.State, actor, slot int, artifact contracts.Artifact,
+	keys [10]string, values [10]float64,
+) (theoryalloc.State, [4]float64) {
+	state := anchor
+	state.Mains[actor][slot] = artifact.MainStat.Key
+	var upgrades [4]float64
+	for line, sub := range artifact.Substats {
+		statIndex := -1
+		for index, key := range keys {
+			if key == sub.Key {
+				statIndex = index
+				break
+			}
+		}
+		if statIndex < 0 {
+			return state, upgrades
+		}
+		value, err := strconv.ParseFloat(sub.Value, 64)
+		if err != nil || values[statIndex] <= 0 {
+			return state, upgrades
+		}
+		upgrades[line] = value/values[statIndex] - 1
+		state.Lines[actor][slot][line] = statIndex
+		state.Upgrades[actor][slot][line] = upgrades[line]
+	}
+	return state, upgrades
+}
+
+func actorRollTotals(state theoryalloc.State, actor int) (initialLines int, upgradeUnits float64) {
+	for slot := range state.Lines[actor] {
+		for line := range state.Lines[actor][slot] {
+			if state.Lines[actor][slot][line] >= 0 {
+				initialLines++
+			}
+			upgradeUnits += state.Upgrades[actor][slot][line]
+		}
+	}
+	return initialLines, upgradeUnits
+}
+
+func isCritTemplate(artifact contracts.Artifact, keys [10]string, values [10]float64) bool {
+	units := make([]float64, 0, len(artifact.Substats))
+	for _, sub := range artifact.Substats {
+		for index, key := range keys {
+			if key == sub.Key {
+				value, err := strconv.ParseFloat(sub.Value, 64)
+				if err != nil || values[index] <= 0 {
+					return false
+				}
+				units = append(units, value/values[index]-1)
+				break
+			}
+		}
+	}
+	sort.Float64s(units)
+	if len(units) != 4 {
+		return false
+	}
+	if math.Abs(units[0]) < 1e-7 && math.Abs(units[1]) < 1e-7 && math.Abs(units[2]-2.5) < 1e-7 && math.Abs(units[3]-2.5) < 1e-7 {
+		return true
+	}
+	wantSingleCrit := [4]float64{.75, .75, 1, 2.5}
+	for index, want := range wantSingleCrit {
+		if math.Abs(units[index]-want) > 1e-7 {
+			return false
+		}
+	}
+	return true
+}
+
+func assertSameGenericTemplates(t *testing.T, fixture Fixture, left, right int) error {
+	t.Helper()
+	leftIDs, rightIDs := fixture.CandidateIDsByWearer[left], fixture.CandidateIDsByWearer[right]
+	if len(leftIDs) != len(rightIDs) {
+		return fmt.Errorf("same set/element actors received different candidate counts")
+	}
+	byID := make(map[int64]contracts.Artifact, len(fixture.Artifacts))
+	for _, artifact := range fixture.Artifacts {
+		byID[artifact.ArtifactID] = artifact
+	}
+	for index, leftID := range leftIDs {
+		leftPiece, rightPiece := byID[leftID], byID[rightIDs[index]]
+		leftPiece.ArtifactID, rightPiece.ArtifactID = 0, 0
+		if !reflect.DeepEqual(leftPiece, rightPiece) {
+			return fmt.Errorf("same set/element actors received role-dependent template at row %d", index)
+		}
+	}
+	return nil
+}
+
+func containsString(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func slotIndex(slot string) int {
+	for index, candidate := range slots {
+		if candidate == slot {
+			return index
+		}
+	}
+	return -1
+}
+
+func wantElementsMain(element string) string { return element + "_damage_bonus" }
+
+func isQuarter(value float64) bool { return math.Abs(value*4-math.Round(value*4)) < 1e-7 }
+
+func allUpgradesEqual(values [4]float64, wanted float64) bool {
+	for _, value := range values {
+		if math.Abs(value-wanted) > 1e-8 {
+			return false
+		}
+	}
+	return true
+}
+
+func TestExpectedGeneratedArtifactOrderUsesStableStatTemplateSequence(t *testing.T) {
+	config := Config{Wearers: [4]WearerSpec{
+		{WearerKey: "actor_a", Element: "pyro", SetUID: "set_a"},
+		{WearerKey: "actor_b", Element: "hydro", SetUID: "set_b"},
+		{WearerKey: "actor_c", Element: "anemo", SetUID: "set_c"},
+		{WearerKey: "actor_d", Element: "geo", SetUID: "set_d"},
+	}}
+	fixture, err := Generate(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	keys := theoryalloc.StatKeys()
+	if !sort.StringsAreSorted(keys[:]) {
+		t.Fatalf("production stat-key sequence is no longer stable/sorted: %v", keys)
+	}
+	if fixture.Artifacts[0].ArtifactID != 1 || fixture.Artifacts[len(fixture.Artifacts)-1].ArtifactID != int64(len(fixture.Artifacts)) {
+		t.Fatal("artifact sequence endpoints are not stable")
+	}
+}
