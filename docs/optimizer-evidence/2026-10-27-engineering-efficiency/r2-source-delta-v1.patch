+++ b/internal/setcontext/theory_model_test.go
@@ -0,0 +1,115 @@
+package setcontext
+
+// Synthetic cache/route ownership checks; no engine or activation evidence.
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/formula"
+	"genshinteamstracker/native/gcsim_optimizer/internal/seteffects"
+)
+
+func theoryCacheModel(t *testing.T) (*NeutralModel, *Context, [32]byte) {
+	t.Helper()
+	base := fixtureContext(t)
+	captured, err := compileCapture(base, syntheticCapture(base, "100"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ports := []formula.EffectPort{}
+	for member := range base.Seeds() {
+		ports = append(ports, formula.EffectPort{Member: member, NodeID: 1, Key: "test", Observed: 100})
+	}
+	prepared, err := captured.panel.PrepareEffectInputs(ports)
+	if err != nil {
+		t.Fatal(err)
+	}
+	model := &NeutralModel{
+		origin: base, panel: captured.panel, prepared: prepared, binding: &seteffects.NeutralBinding{},
+		owners: map[string]int{}, specializations: formula.NewSpecializationCache(4, 1000),
+	}
+	for index, actor := range base.actors {
+		model.owners[actor] = index
+	}
+	if _, err := model.bindProgram(map[string]*formula.InputExpression{"test": {Operation: "constant", Value: 0}}); err != nil {
+		t.Fatal(err)
+	}
+	key := model.programOrder[0]
+	model.targetPrograms = map[string]contextDispatch{base.key: {key: key, uncertainty: []string{"fixture_uncertainty"}}}
+	model.effectDimensions, model.constantDimensions = []int{0}, []int{0}
+	return model, base, key
+}
+
+func TestNeutralModelTheoryForkOwnsCachesAndRetainsFamilyIdentity(t *testing.T) {
+	parent, target, key := theoryCacheModel(t)
+	handle, family, codes, err := parent.TheoryFamily(target)
+	if err != nil || handle == nil || len(codes) != 0 || !strings.HasPrefix(family, "program:") {
+		t.Fatalf("synthetic cached family unavailable: %q %v %v", family, codes, err)
+	}
+	panel, err := handle.SearchPanel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := panel.ArtifactProgram([]float64{0}, 0); err != nil {
+		t.Fatal(err)
+	}
+	stats, cacheStats := parent.Stats(), parent.specializations.Stats()
+	branch, sibling := parent.ForkTheory(), parent.ForkTheory()
+	if branch.prepared == parent.prepared || branch.binding == parent.binding || branch.specializations == parent.specializations || branch.programCache[key] == parent.programCache[key] {
+		t.Fatal("fork shared mutable model programs, binding, or cache")
+	}
+	child, childFamily, childCodes, err := branch.TheoryFamily(target)
+	if err != nil || child == nil || childFamily != family || len(childCodes) != 0 {
+		t.Fatalf("fork changed retained arithmetic family: %q %v %v", childFamily, childCodes, err)
+	}
+	childPanel, err := child.SearchPanel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := childPanel.ArtifactProgram([]float64{0}, 0); err != nil {
+		t.Fatal(err)
+	}
+	if branch.specializations.Stats().Hits != cacheStats.Hits+1 {
+		t.Fatal("fork lost the retained specialization source identity")
+	}
+	if _, err := branch.programCache[key].Evaluate([]float64{9}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := branch.bindProgram(map[string]*formula.InputExpression{"test": {Operation: "constant", Value: 1}}); err != nil {
+		t.Fatal(err)
+	}
+	dispatch := branch.targetPrograms[target.key]
+	dispatch.uncertainty[0] = "changed"
+	branch.owners["actor_a"] = 3
+	branch.programOrder[0] = [32]byte{9}
+	branch.effectKeys[0], branch.constantKeys[0] = "changed", "changed"
+	branch.effectDimensions[0], branch.constantDimensions[0] = 9, 9
+	delete(branch.programCache, key)
+	delete(branch.targetPrograms, target.key)
+	if !reflect.DeepEqual(parent.Stats(), stats) || parent.specializations.Stats() != cacheStats || sibling.specializations.Stats() != cacheStats ||
+		len(parent.programCache) != 1 || len(sibling.programCache) != 1 || parent.programCache[key] == nil ||
+		parent.programOrder[0] != key || sibling.programOrder[0] != key || parent.targetPrograms[target.key].uncertainty[0] != "fixture_uncertainty" ||
+		parent.owners["actor_a"] != 0 || parent.effectKeys[0] != "test" || parent.constantKeys[0] != "test" ||
+		parent.effectDimensions[0] != 0 || parent.constantDimensions[0] != 0 {
+		t.Fatal("child mutation changed parent/sibling cache, FIFO, diagnostics, dimensions, or counters")
+	}
+	value, err := parent.programCache[key].Evaluate([]float64{0}, nil)
+	if err != nil || value != 100 {
+		t.Fatalf("child cache scratch changed retained parent arithmetic: %g %v", value, err)
+	}
+}
+
+func TestTheoryFamilyUnavailablePreservesOrdinaryResolveBoundary(t *testing.T) {
+	parent, base, _ := theoryCacheModel(t)
+	target := replaced(t, base, []Set{{UID: "unsupported", Count: 4}})
+	branch := parent.ForkTheory()
+	before := parent.Stats()
+	handle, family, codes, err := branch.TheoryFamily(target)
+	if err != nil || handle != nil || family != "" || !reflect.DeepEqual(codes, []string{"neutral binding is unavailable"}) {
+		t.Fatalf("ordinary unavailable boundary was replaced: handle %v family %q codes %v err %v", handle, family, codes, err)
+	}
+	if branch.stats.Requests != before.Requests+1 || branch.stats.Unavailable != before.Unavailable+1 || !reflect.DeepEqual(parent.Stats(), before) {
+		t.Fatal("unavailable child resolution changed parent counters or was not accounted")
+	}
+}
diff --git a/internal/seteffects/mechanic_ir.go b/internal/seteffects/mechanic_ir.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/mechanic_ir.go
@@ -0,0 +1,687 @@
+package seteffects
+
+// MechanicIR is portable static evidence. It never contains a VM, a bound
+// observation, an execution certificate, or a team-specific value. A cache hit
+// rebinds source declarations into fresh modules and environments, and skips
+// the ordinary declaration/link and call-graph passes for saved modules.
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/format"
+	"go/token"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+const (
+	mechanicIRSchema         = 4
+	mechanicIRCompiler       = "source-module-plan-lazy-dependency-v4"
+	mechanicIRRootRole       = "root"
+	mechanicIRDependencyRole = "dependency"
+	mechanicIRMaxFile        = 4 << 20
+	mechanicIRMaxFiles       = 4096
+	mechanicIRMaxBytes       = 128 << 20
+	mechanicIRMaxNodes       = 4096
+	mechanicIRMaxEdges       = 16384
+)
+
+type MechanicIRCall struct {
+	From       string `json:"from"`
+	To         string `json:"to,omitempty"`
+	Expression string `json:"expression"`
+	Kind       string `json:"kind"`
+}
+
+type MechanicIROperation struct {
+	Caller  string                             `json:"caller"`
+	Symbol  string                             `json:"symbol"`
+	Effects []contracts.MechanicEffectKind     `json:"effects"`
+	Reads   []contracts.MechanicResourceEffect `json:"reads,omitempty"`
+	Writes  []contracts.MechanicResourceEffect `json:"writes,omitempty"`
+}
+
+type MechanicIRGuard struct {
+	Symbol    string `json:"symbol"`
+	Condition string `json:"condition"`
+}
+
+type MechanicIRDependency struct {
+	Symbol     string `json:"symbol"`
+	Expression string `json:"expression"`
+	Kind       string `json:"kind"`
+}
+
+type MechanicIRBoundary struct {
+	Symbol     string `json:"symbol"`
+	Expression string `json:"expression"`
+	Reason     string `json:"reason"`
+}
+
+type MechanicIRCoverage struct {
+	Parse     string `json:"parse"`
+	Link      string `json:"link"`
+	Semantics string `json:"semantics"`
+	Runtime   string `json:"runtime"`
+}
+
+type MechanicIR struct {
+	Schema              int                    `json:"schema"`
+	Compiler            string                 `json:"compiler"`
+	Role                string                 `json:"role"`
+	Entry               string                 `json:"entry"`
+	SourceClosureSHA256 string                 `json:"source_closure_sha256"`
+	BuildProfileSHA256  string                 `json:"build_profile_sha256"`
+	OperationABISHA256  string                 `json:"operation_abi_sha256"`
+	Symbols             []string               `json:"symbols"`
+	Calls               []MechanicIRCall       `json:"calls"`
+	Operations          []MechanicIROperation  `json:"operations"`
+	Guards              []MechanicIRGuard      `json:"guards"`
+	Dependencies        []MechanicIRDependency `json:"dependencies"`
+	TraceRequirements   []string               `json:"trace_requirements"`
+	Unresolved          []MechanicIRBoundary   `json:"unresolved"`
+	Coverage            MechanicIRCoverage     `json:"coverage"`
+	ModulePlan          *mechanicModulePlan    `json:"module_plan"`
+}
+
+// This value is copied into each source program after its bound envelope has
+// been validated. Dependency cache keys never capture a VM or mutable program.
+type mechanicCompileContext struct {
+	Engine              contracts.EngineBinding
+	CatalogSHA256       string
+	SourceClosureSHA256 string
+	BuildProfileSHA256  string
+	OperationABISHA256  string
+}
+
+type MechanicIRCacheStats struct {
+	SemanticAnalyses uint64 `json:"semantic_analyses"`
+	FreshBinds       uint64 `json:"fresh_binds"`
+	MemoryHits       uint64 `json:"memory_hits"`
+	WritableHits     uint64 `json:"writable_hits"`
+	BundledHits      uint64 `json:"bundled_hits"`
+	Misses           uint64 `json:"misses"`
+	Writes           uint64 `json:"writes"`
+	Repairs          uint64 `json:"repairs"`
+	Errors           uint64 `json:"errors"`
+}
+
+func (c *RuleParseCache) recordMechanicSemanticAnalysis() {
+	if c == nil {
+		return
+	}
+	c.irMu.Lock()
+	c.irStats.SemanticAnalyses++
+	c.irMu.Unlock()
+}
+func (c *RuleParseCache) recordMechanicFreshBind() {
+	if c == nil {
+		return
+	}
+	c.irMu.Lock()
+	c.irStats.FreshBinds++
+	c.irMu.Unlock()
+}
+
+type mechanicIRFlight struct {
+	done chan struct{}
+	ir   MechanicIR
+	err  error
+}
+
+type mechanicIRRecord struct {
+	Key           string          `json:"key"`
+	PayloadSHA256 string          `json:"payload_sha256"`
+	Payload       json.RawMessage `json:"payload"`
+}
+
+func (c *RuleParseCache) MechanicIRStats() MechanicIRCacheStats {
+	if c == nil {
+		return MechanicIRCacheStats{}
+	}
+	c.irMu.Lock()
+	defer c.irMu.Unlock()
+	return c.irStats
+}
+
+func (c *SourceCatalog) CurrentMechanicIRCacheStats() MechanicIRCacheStats {
+	if c == nil {
+		return MechanicIRCacheStats{}
+	}
+	if c.parseCache != nil {
+		return c.parseCache.MechanicIRStats()
+	}
+	return c.MechanicCache
+}
+
+func mechanicIRKey(entry string, repository *ruleRepository, operations ruleOperationIndex, engine contracts.EngineBinding, catalogSHA string, sources, libraries map[string][]byte) (string, string, string, string, error) {
+	return mechanicIRKeyRole(mechanicIRRootRole, entry, repository, operations, engine, catalogSHA, sources, libraries)
+}
+
+func mechanicIRKeyRole(role, entry string, repository *ruleRepository, operations ruleOperationIndex, engine contracts.EngineBinding, catalogSHA string, sources, libraries map[string][]byte) (string, string, string, string, error) {
+	if role != mechanicIRRootRole && role != mechanicIRDependencyRole {
+		return "", "", "", "", fmt.Errorf("invalid mechanic IR role")
+	}
+	identities := map[string]string{}
+	for name, body := range libraries {
+		identities[name] = contracts.TextSHA256(string(body))
+	}
+	for name, body := range sources {
+		if old, ok := libraries[name]; ok && !bytes.Equal(old, body) {
+			return "", "", "", "", fmt.Errorf("conflicting rule source")
+		}
+		if repository != nil {
+			if old, ok := repository.files[name]; ok && !bytes.Equal(old, body) {
+				return "", "", "", "", fmt.Errorf("repository rule source mismatch")
+			}
+		}
+		identities[name] = contracts.TextSHA256(string(body))
+	}
+	closure, err := contracts.CanonicalSHA256(struct {
+		Files      map[string]string `json:"files"`
+		Repository string            `json:"repository"`
+	}{identities, func() string {
+		if repository != nil {
+			return repository.sourceFingerprint
+		}
+		return ""
+	}()})
+	if err != nil {
+		return "", "", "", "", err
+	}
+	profile := "none"
+	if repository != nil {
+		profile = repository.profileFingerprint
+	}
+	opABI, err := contracts.CanonicalSHA256(operations)
+	if err != nil {
+		return "", "", "", "", err
+	}
+	key, err := contracts.CanonicalSHA256(struct {
+		Schema                                                                      int `json:"schema"`
+		Compiler, Go, Role, Entry, Engine, Manifest, Catalog, Closure, Profile, ABI string
+	}{mechanicIRSchema, mechanicIRCompiler, runtime.Version(), role, entry, engine.ArtifactSHA256, engine.SourceManifestSHA256, catalogSHA, closure, profile, opABI})
+	return key, closure, profile, opABI, err
+}
+
+func (c *RuleParseCache) loadMechanicIR(key string, expected MechanicIR, build func() (MechanicIR, error)) (MechanicIR, string, error) {
+	if c == nil {
+		ir, err := build()
+		return ir, "source", err
+	}
+	c.irMu.Lock()
+	if ir, ok := c.irMemory[key]; ok {
+		c.irStats.MemoryHits++
+		c.irMu.Unlock()
+		return cloneMechanicIR(ir), "memory", nil
+	}
+	if flight := c.irFlights[key]; flight != nil {
+		c.irMu.Unlock()
+		<-flight.done
+		return cloneMechanicIR(flight.ir), "coalesced", flight.err
+	}
+	flight := &mechanicIRFlight{done: make(chan struct{})}
+	c.irFlights[key] = flight
+	c.irMu.Unlock()
+	finish := func(ir MechanicIR, origin string, err error) (MechanicIR, string, error) {
+		c.irMu.Lock()
+		if err == nil {
+			c.irMemory[key] = cloneMechanicIR(ir)
+		}
+		flight.ir, flight.err = ir, err
+		delete(c.irFlights, key)
+		close(flight.done)
+		c.irMu.Unlock()
+		return cloneMechanicIR(ir), origin, err
+	}
+	if c.mechanicCacheEnabled {
+		for _, candidate := range []struct{ dir, origin string }{{c.writableDir, "writable"}, {c.readOnlyBundledDir, "bundled"}} {
+			if candidate.dir == "" {
+				continue
+			}
+			ir, found, err := readMechanicIR(candidate.dir, key)
+			if err == nil && found && !mechanicIRMatches(ir, expected) {
+				err = errors.New("mechanic IR identity mismatch")
+			}
+			if err != nil {
+				c.irMu.Lock()
+				c.irStats.Errors++
+				if found {
+					c.irStats.Repairs++
+				}
+				c.irMu.Unlock()
+				continue
+			}
+			if found {
+				c.irMu.Lock()
+				if candidate.origin == "writable" {
+					c.irStats.WritableHits++
+				} else {
+					c.irStats.BundledHits++
+				}
+				c.irMu.Unlock()
+				return finish(ir, candidate.origin, nil)
+			}
+		}
+	}
+	c.irMu.Lock()
+	c.irStats.Misses++
+	c.irMu.Unlock()
+	ir, err := build()
+	if err != nil {
+		return finish(MechanicIR{}, "source", err)
+	}
+	if c.mechanicCacheEnabled && c.writableDir != "" && c.writableDir != c.readOnlyBundledDir {
+		if err := writeMechanicIR(c.writableDir, key, ir); err != nil {
+			c.irMu.Lock()
+			c.irStats.Errors++
+			c.irMu.Unlock()
+		} else {
+			c.irMu.Lock()
+			c.irStats.Writes++
+			c.irMu.Unlock()
+			if err := cleanupMechanicIR(c.writableDir); err != nil {
+				c.irMu.Lock()
+				c.irStats.Errors++
+				c.irMu.Unlock()
+			}
+		}
+	}
+	return finish(ir, "source", nil)
+}
+
+func mechanicIRMatches(ir, expected MechanicIR) bool {
+	role := expected.Role
+	if role == "" {
+		role = mechanicIRRootRole
+	}
+	return ir.Schema == mechanicIRSchema && ir.Compiler == mechanicIRCompiler && ir.Role == role && ir.Entry == expected.Entry && ir.SourceClosureSHA256 == expected.SourceClosureSHA256 && ir.BuildProfileSHA256 == expected.BuildProfileSHA256 && ir.OperationABISHA256 == expected.OperationABISHA256
+}
+
+func cloneMechanicIR(ir MechanicIR) MechanicIR {
+	// JSON also copies nested operation effects. No caller can mutate a memory hit.
+	data, _ := json.Marshal(ir)
+	var copy MechanicIR
+	_ = json.Unmarshal(data, &copy)
+	return copy
+}
+
+func readMechanicIR(dir, key string) (MechanicIR, bool, error) {
+	if err := ensureRuleParseCacheDir(dir, false); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return MechanicIR{}, false, nil
+		}
+		return MechanicIR{}, false, err
+	}
+	name := filepath.Join(dir, key+".gttir")
+	info, err := os.Lstat(name)
+	if errors.Is(err, os.ErrNotExist) {
+		return MechanicIR{}, false, nil
+	}
+	if err != nil {
+		return MechanicIR{}, false, err
+	}
+	if !safeRegularRuleParseCacheFile(info) || info.Size() > mechanicIRMaxFile {
+		return MechanicIR{}, true, errors.New("invalid mechanic IR entry")
+	}
+	f, err := os.Open(name)
+	if err != nil {
+		return MechanicIR{}, true, err
+	}
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil || !safeRegularRuleParseCacheFile(opened) || !os.SameFile(info, opened) {
+		return MechanicIR{}, true, errors.New("mechanic IR entry changed")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, mechanicIRMaxFile+1))
+	if err != nil || len(data) > mechanicIRMaxFile {
+		return MechanicIR{}, true, errors.New("invalid mechanic IR payload")
+	}
+	var record mechanicIRRecord
+	if err := json.Unmarshal(data, &record); err != nil {
+		return MechanicIR{}, true, err
+	}
+	if record.Key != key || contracts.TextSHA256(string(record.Payload)) != record.PayloadSHA256 {
+		return MechanicIR{}, true, errors.New("mechanic IR digest mismatch")
+	}
+	var ir MechanicIR
+	if err := json.Unmarshal(record.Payload, &ir); err != nil {
+		return MechanicIR{}, true, err
+	}
+	if ir.Schema != mechanicIRSchema || ir.Compiler != mechanicIRCompiler || ir.Role != mechanicIRRootRole && ir.Role != mechanicIRDependencyRole || len(ir.Symbols) > mechanicIRMaxNodes || len(ir.Calls) > mechanicIRMaxEdges || len(ir.Dependencies) > mechanicIRMaxEdges || len(ir.Unresolved) > mechanicIRMaxEdges {
+		return MechanicIR{}, true, errors.New("mechanic IR schema or size mismatch")
+	}
+	return ir, true, nil
+}
+
+func writeMechanicIR(dir, key string, ir MechanicIR) error {
+	payload, err := json.Marshal(ir)
+	if err != nil {
+		return err
+	}
+	record, err := json.Marshal(mechanicIRRecord{Key: key, PayloadSHA256: contracts.TextSHA256(string(payload)), Payload: payload})
+	if err != nil {
+		return err
+	}
+	if len(record) > mechanicIRMaxFile {
+		return errors.New("mechanic IR exceeds file limit")
+	}
+	if err := ensureRuleParseCacheDir(dir, true); err != nil {
+		return err
+	}
+	temp, err := os.CreateTemp(dir, ".tmp-"+key+"-*.gttir")
+	if err != nil {
+		return err
+	}
+	name := temp.Name()
+	activeKey := ruleParseCacheTempPathKey(name)
+	activeRuleParseCacheTemps.Store(activeKey, struct{}{})
+	defer activeRuleParseCacheTemps.Delete(activeKey)
+	defer os.Remove(name)
+	if _, err = temp.Write(record); err != nil {
+		temp.Close()
+		return err
+	}
+	if err = temp.Sync(); err != nil {
+		temp.Close()
+		return err
+	}
+	if err = temp.Close(); err != nil {
+		return err
+	}
+	target := filepath.Join(dir, key+".gttir")
+	if info, err := os.Lstat(target); err == nil && !safeRegularRuleParseCacheFile(info) {
+		return errors.New("unsafe mechanic IR target")
+	}
+	return os.Rename(name, target)
+}
+
+func cleanupMechanicIR(dir string) error {
+	if err := ensureRuleParseCacheDir(dir, false); err != nil {
+		return err
+	}
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return err
+	}
+	if len(entries) > 100000 {
+		return errors.New("mechanic IR cache scan limit")
+	}
+	type file struct {
+		name   string
+		size   int64
+		mod    time.Time
+		active bool
+	}
+	var files []file
+	var bytes int64
+	for _, entry := range entries {
+		name := entry.Name()
+		permanent := len(name) == 70 && strings.HasSuffix(name, ".gttir") && validRuleParseCacheKey(name[:64])
+		temporary := len(name) > 76 && strings.HasPrefix(name, ".tmp-") && strings.HasSuffix(name, ".gttir") && validRuleParseCacheKey(name[5:69]) && name[69] == '-'
+		owned := permanent || temporary
+		if !owned {
+			continue
+		}
+		info, err := entry.Info()
+		if err != nil || !safeRegularRuleParseCacheFile(info) {
+			continue
+		}
+		full := filepath.Join(dir, name)
+		files = append(files, file{full, info.Size(), info.ModTime(), temporary && (activeRuleParseCacheTemp(full) || time.Since(info.ModTime()) < ruleParseCacheOrphanAge)})
+		bytes += info.Size()
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].mod.Before(files[j].mod) })
+	count := len(files)
+	for _, f := range files {
+		if count <= mechanicIRMaxFiles && bytes <= mechanicIRMaxBytes && !(strings.HasPrefix(filepath.Base(f.name), ".tmp-") && time.Since(f.mod) > ruleParseCacheOrphanAge) {
+			continue
+		}
+		if f.active {
+			continue
+		}
+		info, err := os.Lstat(f.name)
+		if err != nil || !safeRegularRuleParseCacheFile(info) {
+			continue
+		}
+		if err := os.Remove(f.name); err != nil {
+			return err
+		}
+		bytes -= f.size
+		count--
+	}
+	if count > mechanicIRMaxFiles || bytes > mechanicIRMaxBytes {
+		return errors.New("mechanic IR protected entries exceed budget")
+	}
+	return nil
+}
+
+func buildMechanicIR(p *ruleProgram, repository *ruleRepository, operations ruleOperationIndex, closure, profile, abi string) (MechanicIR, error) {
+	ir := MechanicIR{Schema: mechanicIRSchema, Compiler: mechanicIRCompiler, Role: mechanicIRRootRole, Entry: p.entry, SourceClosureSHA256: closure, BuildProfileSHA256: profile, OperationABISHA256: abi, Coverage: MechanicIRCoverage{Parse: "parsed", Link: "partial", Semantics: "partial", Runtime: "unverified"}}
+	seen := map[string]bool{}
+	var visit func(string, string, *ruleFunction, int)
+	visit = func(module, key string, fn *ruleFunction, depth int) {
+		identity := module + "." + key
+		if strings.HasPrefix(key, module+".") {
+			identity = key
+		}
+		if seen[identity] {
+			return
+		}
+		if depth > 64 {
+			ir.Unresolved = append(ir.Unresolved, MechanicIRBoundary{identity, key, "source graph depth budget"})
+			return
+		}
+		if len(seen) >= mechanicIRMaxNodes {
+			if len(ir.Unresolved) < mechanicIRMaxEdges {
+				ir.Unresolved = append(ir.Unresolved, MechanicIRBoundary{identity, key, "source graph node budget"})
+			}
+			return
+		}
+		seen[identity] = true
+		ir.Symbols = append(ir.Symbols, identity)
+		if fn == nil || fn.body == nil {
+			return
+		}
+		locals := map[string]string{}
+		if fn.typ != nil && fn.typ.Params != nil {
+			for _, field := range fn.typ.Params.List {
+				typ := ruleTypeName(field.Type, fn.env)
+				for _, id := range field.Names {
+					locals[id.Name] = typ
+				}
+			}
+		}
+		if fn.receiver != "" {
+			if dot := strings.LastIndex(key, "."); dot > 0 {
+				locals[fn.receiver] = key[:dot]
+			}
+		}
+		ast.Inspect(fn.body, func(n ast.Node) bool {
+			switch x := n.(type) {
+			case *ast.AssignStmt:
+				if len(x.Lhs) == len(x.Rhs) {
+					for i, left := range x.Lhs {
+						id, ok := left.(*ast.Ident)
+						if !ok {
+							continue
+						}
+						if literal, ok := x.Rhs[i].(*ast.CompositeLit); ok {
+							locals[id.Name] = ruleTypeName(literal.Type, fn.env)
+						}
+					}
+				}
+			case *ast.ValueSpec:
+				if x.Type != nil {
+					for _, id := range x.Names {
+						locals[id.Name] = ruleTypeName(x.Type, fn.env)
+					}
+				}
+			}
+			return true
+		})
+		ast.Inspect(fn.body, func(n ast.Node) bool {
+			if len(ir.Calls)+len(ir.Unresolved) >= mechanicIRMaxEdges {
+				if len(ir.Unresolved) < mechanicIRMaxEdges {
+					ir.Unresolved = append(ir.Unresolved, MechanicIRBoundary{identity, "", "source graph edge budget"})
+				}
+				return false
+			}
+			switch x := n.(type) {
+			case *ast.Ident:
+				if _, global := p.modules[module].globals[x.Name]; global && len(ir.Dependencies) < mechanicIRMaxEdges {
+					ir.Dependencies = append(ir.Dependencies, MechanicIRDependency{identity, x.Name, "package_global"})
+				}
+			case *ast.SelectorExpr:
+				if id, ok := x.X.(*ast.Ident); ok && fn.env.imports[id.Name] == "" && len(ir.Dependencies) < mechanicIRMaxEdges {
+					ir.Dependencies = append(ir.Dependencies, MechanicIRDependency{identity, mechanicExpr(x), "field_or_method"})
+				}
+			case *ast.IfStmt:
+				ir.Guards = append(ir.Guards, MechanicIRGuard{identity, mechanicExpr(x.Cond)})
+			case *ast.CaseClause:
+				for _, expr := range x.List {
+					ir.Guards = append(ir.Guards, MechanicIRGuard{identity, mechanicExpr(expr)})
+				}
+			case *ast.CallExpr:
+				expr := mechanicExpr(x.Fun)
+				target := ""
+				kind := "unresolved"
+				switch call := x.Fun.(type) {
+				case *ast.Ident:
+					if _, ok := p.modules[module].functions[call.Name]; ok {
+						target = module + "." + call.Name
+						kind = "source"
+					} else if mechanicBuiltin(call.Name) {
+						kind = "builtin"
+					}
+				case *ast.SelectorExpr:
+					if id, ok := call.X.(*ast.Ident); ok {
+						if imported := fn.env.imports[id.Name]; imported != "" {
+							target = imported + "." + call.Sel.Name
+							kind = "source"
+						} else if typ := locals[id.Name]; typ != "" {
+							candidate := typ + "." + call.Sel.Name
+							if op, ok := operations[candidate]; ok {
+								kind = "operation"
+								ir.Operations = append(ir.Operations, MechanicIROperation{identity, op.Symbol, append([]contracts.MechanicEffectKind(nil), op.Effects...), append([]contracts.MechanicResourceEffect(nil), op.Reads...), append([]contracts.MechanicResourceEffect(nil), op.Writes...)})
+							} else {
+								target = candidate
+								kind = "source"
+							}
+						}
+					} else if literal, ok := call.X.(*ast.CompositeLit); ok {
+						if typ := ruleTypeName(literal.Type, fn.env); typ != "" {
+							target = typ + "." + call.Sel.Name
+							kind = "source"
+						}
+					}
+				}
+				ir.Calls = append(ir.Calls, MechanicIRCall{identity, target, expr, kind})
+				if kind == "unresolved" {
+					ir.Unresolved = append(ir.Unresolved, MechanicIRBoundary{identity, expr, "dynamic or untyped call"})
+				}
+				if kind == "source" && target != "" {
+					slash := strings.LastIndex(target, "/")
+					split := slash + 1 + strings.Index(target[slash+1:], ".")
+					if split > 0 {
+						pkg, symbol := target[:split], target[split+1:]
+						loaded, linkErr := ruleTry(func() any { return p.module(pkg) })
+						m, _ := loaded.(*ruleModule)
+						var callee *ruleFunction
+						if m != nil {
+							callee = m.functions[symbol]
+							if callee == nil {
+								callee = m.functions[target]
+							}
+						}
+						if linkErr != nil || callee == nil {
+							ir.Unresolved = append(ir.Unresolved, MechanicIRBoundary{identity, expr, "source callee unavailable"})
+						} else {
+							if m.functions[target] != nil {
+								symbol = target
+							}
+							visit(pkg, symbol, callee, depth+1)
+						}
+					}
+				}
+			}
+			return true
+		})
+	}
+	entry := p.modules[p.entry]
+	if entry == nil {
+		return MechanicIR{}, fmt.Errorf("mechanic entry module missing")
+	}
+	keys := make([]string, 0, len(entry.functions))
+	for key := range entry.functions {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		visit(p.entry, key, entry.functions[key], 0)
+	}
+	for _, fn := range entry.initializers {
+		visit(p.entry, "init", fn, 0)
+	}
+	if len(ir.Unresolved) == 0 {
+		ir.Coverage.Link = "linked"
+	}
+	if len(ir.Operations) > 0 {
+		ir.TraceRequirements = []string{"authoritative_operation_invocations"}
+	}
+	if len(ir.Unresolved) == 0 && len(ir.Operations) == 0 {
+		ir.Coverage.Semantics = "source_only"
+	}
+	sort.Strings(ir.Symbols)
+	plan, err := buildMechanicModulePlan(p)
+	if err != nil {
+		return MechanicIR{}, err
+	}
+	ir.ModulePlan = &plan
+	_ = repository // repository identity is already in the source closure key.
+	return ir, nil
+}
+
+func mechanicBuiltin(name string) bool {
+	switch name {
+	case "append", "cap", "clear", "close", "complex", "copy", "delete", "imag", "len", "make", "max", "min", "new", "panic", "print", "println", "real", "recover":
+		return true
+	}
+	return false
+}
+func mechanicExpr(expr ast.Node) string {
+	var b strings.Builder
+	if err := format.Node(&b, token.NewFileSet(), expr); err != nil {
+		return "<unformatted>"
+	}
+	s := b.String()
+	if len(s) > 256 {
+		return s[:256]
+	}
+	return s
+}
+
+// CompilerGeneratedMechanicIR is the single producer for writable and bundled
+// records. A packaging step may copy its .gttir files verbatim into a read-only
+// directory; both paths use the same validator above.
+func CompilerGeneratedMechanicIR(catalog *SourceCatalog) map[string]MechanicIR {
+	out := map[string]MechanicIR{}
+	if catalog == nil {
+		return out
+	}
+	for _, row := range catalog.Sets {
+		if row.MechanicIR != nil {
+			out[row.Key] = cloneMechanicIR(*row.MechanicIR)
+		}
+	}
+	return out
+}
