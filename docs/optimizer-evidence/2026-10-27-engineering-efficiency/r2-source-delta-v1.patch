new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_operation_arguments.go
@@ -0,0 +1,42 @@
+package seteffects
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func ruleOperationArguments(operation contracts.MechanicOperation,args []any) (bool,error) {
+	for i,value:=range args {
+		index:=i;if operation.Variadic && index>=len(operation.Parameters)-1{index=len(operation.Parameters)-1}
+		if index<0 || index>=len(operation.Parameters){return false,fmt.Errorf("operation argument index outside source signature")}
+		parameter:=operation.Parameters[index]
+		if !parameter.Known{return false,nil}
+		argument:=contracts.MechanicArgument{Type:parameter.Type,Encoding:parameter.Encoding,Bits:parameter.Bits,Signed:parameter.Signed}
+		switch parameter.Encoding {
+		case "boolean":
+			b,ok:=value.(bool);if !ok{return false,fmt.Errorf("operation argument contradicts source boolean type")};argument.Value=strconv.FormatBool(b)
+		case "string":
+			s,ok:=value.(string);if !ok{return false,fmt.Errorf("operation argument contradicts source string type")};argument.Value=s
+		case "integer","float_bits":
+			if _,symbolic:=value.(*RuleScalar);symbolic{return false,nil}
+			var number float64
+			switch v:=value.(type){case float64:number=v;case ruleTypedNumber:
+				if v.typ!=parameter.Type{return false,fmt.Errorf("operation argument contradicts source enum type")};number=v.value
+			default:return false,fmt.Errorf("operation argument contradicts source numeric type")}
+			if parameter.Encoding=="integer" {
+				// The source VM is a float adapter. A nonintegral/out-of-exact-range
+				// value is an unsupported coercion, not invented valid integer data.
+				if math.IsNaN(number)||math.IsInf(number,0)||math.Trunc(number)!=number||math.Abs(number)>1<<53{return false,nil}
+				if parameter.Signed {argument.Value=strconv.FormatInt(int64(number),10)}else{if number<0{return false,nil};argument.Value=strconv.FormatUint(uint64(number),10)}
+			}else if parameter.Bits==32 {argument.Value=fmt.Sprintf("%08x",math.Float32bits(float32(number)))}else{argument.Value=fmt.Sprintf("%016x",math.Float64bits(number))}
+		default:return false,nil
+		}
+		known,err:=contracts.ValidateMechanicArgument(argument)
+		if err!=nil{return false,nil} // Numeric representability remains opaque.
+		if !known{return false,nil}
+	}
+	return true,nil
+}
diff --git a/internal/seteffects/rule_operations.go b/internal/seteffects/rule_operations.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_operations.go
@@ -0,0 +1,120 @@
+package seteffects
+
+import (
+	"bytes"
+	"fmt"
+	"go/ast"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"path"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+type ruleOperationIndex map[string]contracts.MechanicOperation
+
+func bindRuleOperations(input *contracts.MechanicOperations, repository *ruleRepository, engine contracts.EngineBinding, cache *RuleParseCache) (ruleOperationIndex,error) {
+	if input==nil { return nil,nil }
+	if err:=contracts.ValidateMechanicOperations(*input,engine);err!=nil { return nil,err }
+	if repository==nil { return nil,fmt.Errorf("mechanic operation descriptors require their bound source repository") }
+	out:=ruleOperationIndex{}
+	for _,operation:=range input.Operations {
+		if operation.BuildProfileSHA256!="" && operation.BuildProfileSHA256!=repository.profileFingerprint { return nil,fmt.Errorf("mechanic operation target build profile mismatch") }
+		body,ok:=repository.files[operation.SourcePath]
+		if !ok || contracts.TextSHA256(string(body))!=operation.SourceSHA256 || operation.ClosureSHA256!=repository.sourceFingerprint {
+			return nil,fmt.Errorf("mechanic operation source/closure binding mismatch")
+		}
+		active:=false
+		for _,name:=range repository.packages[repository.module+"/"+path.Dir(operation.SourcePath)] { active=active || name==operation.SourcePath }
+		if !active { return nil,fmt.Errorf("mechanic operation is outside the engine build profile") }
+		var file *ast.File
+		var err error
+		if cache!=nil { file,err=cache.loadFile(operation.SourcePath,body) } else { file,err=parser.ParseFile(token.NewFileSet(),operation.SourcePath,body,parser.SkipObjectResolution) }
+		if err!=nil { return nil,err }
+		var signature *ast.FuncType
+		pkg:=repository.module+"/"+path.Dir(operation.SourcePath)
+		for _,decl:=range file.Decls {
+			if fn,ok:=decl.(*ast.FuncDecl);ok && fn.Name.Name==operation.Method && fn.Recv!=nil && len(fn.Recv.List)==1 {
+				receiver:=fn.Recv.List[0].Type
+				if pointer,ok:=receiver.(*ast.StarExpr);ok { receiver=pointer.X }
+				if id,ok:=receiver.(*ast.Ident);ok && pkg+"."+id.Name==operation.Receiver { signature=fn.Type }
+			}
+			if group,ok:=decl.(*ast.GenDecl);ok {
+				for _,spec:=range group.Specs {
+					typeSpec,ok:=spec.(*ast.TypeSpec);if !ok || pkg+"."+typeSpec.Name.Name!=operation.Receiver { continue }
+					if iface,ok:=typeSpec.Type.(*ast.InterfaceType);ok { for _,field:=range iface.Methods.List { for _,name:=range field.Names { if name.Name==operation.Method { signature,_=field.Type.(*ast.FuncType) } } } }
+				}
+			}
+		}
+		var text bytes.Buffer
+		if signature==nil { return nil,fmt.Errorf("mechanic operation symbol is absent from its source") }
+		if err:=format.Node(&text,token.NewFileSet(),signature);err!=nil { return nil,err }
+		if text.String()!=operation.Signature { return nil,fmt.Errorf("mechanic operation source signature mismatch") }
+		parameters:=0;variadic:=false
+		var parameterTypes []contracts.MechanicParameter
+		if signature.Params!=nil {
+			for _,field:=range signature.Params.List {
+				count:=len(field.Names);if count==0 {count=1};parameters+=count
+				kind:=ruleParameterType(repository,cache,pkg,ruleSourceImports(file),field.Type,map[string]bool{},0)
+				for n:=0;n<count;n++{parameterTypes=append(parameterTypes,kind)}
+				if _,ok:=field.Type.(*ast.Ellipsis);ok {variadic=true}
+			}
+		}
+		if parameters!=len(operation.Parameters) || variadic!=operation.Variadic { return nil,fmt.Errorf("mechanic operation parameter schema differs from source signature") }
+		for i,actual:=range parameterTypes {
+			if actual.Known && actual!=operation.Parameters[i] {return nil,fmt.Errorf("mechanic operation parameter type contradicts its source")}
+			if !actual.Known && operation.Parameters[i].Known {return nil,fmt.Errorf("mechanic operation asserts an unproved source parameter type")}
+		}
+		operation.Parameters=append([]contracts.MechanicParameter(nil),operation.Parameters...)
+		operation.Reads=append([]contracts.MechanicResourceEffect(nil),operation.Reads...)
+		operation.Writes=append([]contracts.MechanicResourceEffect(nil),operation.Writes...)
+		operation.Effects=append([]contracts.MechanicEffectKind(nil),operation.Effects...)
+		out[operation.Symbol]=operation
+	}
+	return out,nil
+}
+
+// Promotion follows source struct/interface membership, never a method-name
+// search across unrelated packages or concrete runtime types.
+func (p *ruleProgram) operation(receiver,method string,seen map[string]bool,depth int) (contracts.MechanicOperation,bool) {
+	if depth>32 || receiver=="" || seen[receiver] { return contracts.MechanicOperation{},false }
+	seen[receiver]=true
+	if operation,ok:=p.operations[receiver+"."+method];ok { return operation,true }
+	split:=strings.LastIndex(receiver,".");if split<0 { return contracts.MechanicOperation{},false }
+	m:=p.module(receiver[:split]);if m==nil { return contracts.MechanicOperation{},false }
+	name:=receiver[split+1:]
+	var embedded []*ast.Field
+	switch typ:=m.types[name].(type) {
+	case *ast.StructType: embedded=typ.Fields.List
+	case *ast.InterfaceType: embedded=typ.Methods.List
+	default:return contracts.MechanicOperation{},false
+	}
+	found:=[]contracts.MechanicOperation{}
+	for _,field:=range embedded {
+		if len(field.Names)!=0 { continue }
+		branch:=map[string]bool{};for key,value:=range seen { branch[key]=value }
+		if operation,ok:=p.operation(ruleTypeName(field.Type,m.typeEnvs[name]),method,branch,depth+1);ok { found=append(found,operation) }
+	}
+	if len(found)!=1 { return contracts.MechanicOperation{},false }
+	return found[0],true
+}
+
+func (v *ruleVM) operationFailure(receiver any,name string,args []any) (contracts.MechanicBoundary,bool) {
+	ref,ok:=receiver.(ruleRef)
+	if !ok || v.program==nil || len(v.program.operations)==0 { return contracts.MechanicBoundary{},false }
+	operation,ok:=v.program.operation(ref.typ,name,map[string]bool{},0)
+	if !ok { return contracts.MechanicBoundary{},false }
+	b:=contracts.MechanicBoundary{Kind:contracts.MechanicUnknownOperation,Operation:operation.Symbol,Receiver:ref.typ,Owner:ref.index,OwnerKnown:ref.kind=="char",OwnerRole:"receiver",Reason:"engine operation requires target-context observation: "+operation.Symbol}
+	countOK:=len(operation.Parameters)==len(args)
+	if operation.Variadic { countOK=len(args)>=len(operation.Parameters)-1 }
+	if !countOK { b.Kind=contracts.MechanicInvalidOperation;b.Reason="mechanic invocation does not match its bound signature";return b,true }
+	known,err:=ruleOperationArguments(operation,args)
+	if err!=nil{b.Kind=contracts.MechanicInvalidOperation;b.Reason=err.Error();return b,true}
+	if !known{b.Reason="engine operation argument needs authoritative evaluation: "+operation.Symbol}
+	// Descriptors authorize effect routing, not a guessed implementation of an
+	// engine-state mutation or a constant from a previous invocation.
+	if operation.HasEffect(contracts.MechanicEffectSchedule) { b.Kind=contracts.MechanicScheduleChange }
+	return b,true
+}
