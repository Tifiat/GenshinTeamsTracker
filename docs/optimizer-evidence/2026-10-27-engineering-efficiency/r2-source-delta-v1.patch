+		{"nonzero_after", func(l *IREnergyLedger) { l.Events[0].EnergyAfter = "1" }},
+		{"negative_before", func(l *IREnergyLedger) { l.Events[0].EnergyBefore = "-1" }},
+		{"event_capacity_mismatch", func(l *IREnergyLedger) { l.Events[0].EnergyMax = "60" }},
+		{"event_nan", func(l *IREnergyLedger) { l.Events[0].Amount = "NaN" }},
+		{"event_infinite", func(l *IREnergyLedger) { l.Events[0].EnergyAfter = "Inf" }},
+		{"negative_frame", func(l *IREnergyLedger) { l.Events[0].Frame = -1 }},
+		{"bad_sequence", func(l *IREnergyLedger) { l.Events[0].SequenceIndex = 1 }},
+		{"negative_particle", func(l *IREnergyLedger) { l.Events[3].Amount = "-1" }},
+		{"missing_particle_field", func(l *IREnergyLedger) { l.Events[3].OnField = nil }},
+		{"zero_capacity_nonzero_burst", func(l *IREnergyLedger) { l.Events[0].Amount = "1" }},
+		{"positive_capacity_zero_burst", func(l *IREnergyLedger) { l.Events[4].Amount = "0" }},
+		{"positive_capacity_negative_burst", func(l *IREnergyLedger) { l.Events[4].Amount = "-1" }},
+		{"positive_capacity_overflow", func(l *IREnergyLedger) { l.Events[4].EnergyBefore = "61" }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ledger := zeroCapacityLedgerFixture()
+			tc.change(&ledger)
+			if err := ledger.validate("energy_ledger"); err == nil {
