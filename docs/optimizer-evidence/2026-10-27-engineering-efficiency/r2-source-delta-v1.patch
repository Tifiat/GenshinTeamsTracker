+package search
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"testing"
+)
+
+// Compare retained output with a single full sort of every scored build. This
+// oracle does not use the streaming cutoff or the production merge cadence.
+func TestCandidateRetentionMatchesAllScoredBuilds(t *testing.T) {
+	for _, limit := range []int{2, 8, 24} {
+		for _, order := range []string{"improving", "declining", "ties", "near_ties", "mixed", "signed_zero"} {
+			t.Run(fmt.Sprintf("%s/limit%d", order, limit), func(t *testing.T) {
+				engine := &Engine{config: Config{FinalistLimit: limit}}
+				run := &candidateRun{engine: engine}
+				all := retentionStream(order, 513)
+				// The initial anchor may be visited again; equal scores must keep
+				// the first source label.
+				for i := 17; i < len(all); i += 43 {
+					all[i] = all[0]
+					all[i].Source = "revisited_anchor"
+				}
+				for i, row := range all {
+					run.retain(row)
+					if len(run.rows) > 2*limit {
+						t.Fatal("retention exceeded its existing bound")
+					}
+					if i%17 != 0 && i != len(all)-1 {
+						continue
+					}
+					got := engine.mergeFinalists(limit, run.rows...)
+					want := engine.mergeFinalists(limit, all[:i+1]...)
+					if !reflect.DeepEqual(got, want) {
+						t.Fatalf("scored prefix %d changed retained builds or source labels", i+1)
+					}
+					for j := range want {
+						if math.Float64bits(got[j].DPS) != math.Float64bits(want[j].DPS) {
+							t.Fatalf("scored prefix %d changed DPS bits", i+1)
+						}
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestCandidateRetentionRevisitedAnchorAtCutoff(t *testing.T) {
+	engine := &Engine{config: Config{FinalistLimit: 2}}
+	all := retentionStream("declining", 5)
+	anchor := all[1]
+	anchor.Source = "candidate_anchor"
+	all = []ScoredAssignment{anchor, all[0], all[2], all[3], all[4]}
+	run := &candidateRun{engine: engine, rows: []ScoredAssignment{anchor}}
+	for _, row := range all[1:] {
+		run.retain(row)
+	}
+	if !run.hasRankFloor || run.retentionFloor.Assignment != anchor.Assignment {
+		t.Fatal("fixture did not put the initial anchor at the exact cutoff")
+	}
+	revisited := anchor
+	revisited.Source = "real_candidate"
+	run.retain(revisited)
+	got := engine.mergeFinalists(2, run.rows...)
+	want := engine.mergeFinalists(2, append(all, revisited)...)
+	if !reflect.DeepEqual(got, want) || got[1].Source != "candidate_anchor" {
+		t.Fatal("revisited anchor changed the retained build or its first source")
+	}
+}
+
+func retentionStream(order string, count int) []ScoredAssignment {
+	rows := make([]ScoredAssignment, count)
+	for i := range rows {
+		// Physical IDs are deliberately out of scoring order, so exact ties
+		// must still admit a later lexicographically better assignment.
+		id := int64((i*137)%count + 1)
+		for actor := range rows[i].Assignment {
+			for slot := range rows[i].Assignment[actor] {
+				rows[i].Assignment[actor][slot] = 20*id + int64(5*actor+slot)
+			}
+		}
+		rows[i].Source = fmt.Sprintf("scored_%d", i)
+		switch order {
+		case "improving":
+			rows[i].DPS = float64(i - count/2)
+		case "declining":
+			rows[i].DPS = float64(count/2 - i)
+		case "ties":
+			rows[i].DPS = 100
+		case "near_ties":
+			rows[i].DPS = 100 + float64(i%9)*.25e-9
+		case "signed_zero":
+			rows[i].DPS = math.Copysign(0, float64(i%2)-.5)
+		default:
+			rows[i].DPS = float64((i*73)%97 - 48)
+		}
+	}
+	return rows
+}
+
+func BenchmarkCandidateRetention(b *testing.B) {
+	rows := retentionStream("mixed", 1021)
+	engine := &Engine{config: Config{FinalistLimit: 8}}
+	for _, previous := range []bool{true, false} {
+		name := "cutoff"
+		if previous {
+			name = "previous_batch_sort"
+		}
+		b.Run(name, func(b *testing.B) {
+			b.ReportAllocs()
+			for b.Loop() {
+				run := &candidateRun{engine: engine}
+				for _, row := range rows {
+					if previous {
+						run.rows = append(run.rows, row)
+						if len(run.rows) > 2*engine.config.FinalistLimit {
+							run.rows = engine.mergeFinalists(engine.config.FinalistLimit, run.rows...)
+						}
+					} else {
+						run.retain(row)
+					}
+				}
+				_ = engine.mergeFinalists(engine.config.FinalistLimit, run.rows...)
+			}
+		})
+	}
+}
