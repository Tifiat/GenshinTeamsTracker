new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/directions_test.go
@@ -0,0 +1,140 @@
+package supportimpact
+
+import (
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+)
+
+func responseFixture() engineclient.StatResponseResult {
+	actors := map[string]float64{"a": 10, "b": 60, "c": 20, "d": 10}
+	r := engineclient.StatResponseResult{EngineUnchanged: true, ProposalEvidenceOnly: true, CallLimit: 4, AttemptedCalls: 4}
+	digest := strings.Repeat("a", 64)
+	r.Binding = engineclient.StatResponseBinding{AnchorConfigSHA256: digest, RequestSHA256: digest, EngineArtifactSHA256: digest,
+		EngineBindingSHA256: digest, EngineSourceManifestSHA256: digest, EnginePatchManifestSHA256: digest}
+	r.PreparedConfigSHA256, r.ProbeConfigSHA256 = digest, digest
+	for _, seed := range []int64{11, 12} {
+		r.Baseline = append(r.Baseline, engineclient.StatResponseSample{Seed: seed, DPS: 100, CharacterDPS: actors,
+			SampleSeed: strconv.FormatInt(seed, 10), Iterations: 1, ConfigSHA256: digest, EngineResultSHA256: digest})
+	}
+	r.Perturbations = []engineclient.StatResponsePerturbationResult{{
+		Perturbation: engineclient.StatResponsePerturbation{Actor: "a", Stat: "atk%", Delta: 0.2}, ConfigSHA256: strings.Repeat("b", 64),
+		// Aggregates are intentionally false: directions must derive their
+		// evidence from full paired ordinary rows, not these cached summaries.
+		MeanDPSDelta: 999, MeanCharacterDPSDelta: map[string]float64{"a": 999},
+		Samples: []engineclient.StatResponseSample{
+			{Seed: 11, SampleSeed: "11", Iterations: 1, DPS: 105, ConfigSHA256: strings.Repeat("b", 64), EngineResultSHA256: digest, CharacterDPS: map[string]float64{"a": 10, "b": 65, "c": 20, "d": 10}},
+			{Seed: 12, SampleSeed: "12", Iterations: 1, DPS: 107, ConfigSHA256: strings.Repeat("b", 64), EngineResultSHA256: digest, CharacterDPS: map[string]float64{"a": 10, "b": 67, "c": 20, "d": 10}},
+		},
+	}}
+	return r
+}
+
+func TestResponseDirectionsPreservePairedAllyEvidence(t *testing.T) {
+	r := responseFixture()
+	d, err := DirectionsFromResponses([]string{"a", "b", "c", "d"}, r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(d) != 1 || d[0].MeanDPSChange != 6 || d[0].MeanOtherDPSChange != 6 || d[0].Stat != "atk_percent" ||
+		d[0].Status != "positive_on_sampled_seeds" || d[0].MinimumDPSChange != 5 || d[0].MinimumOtherDPSChange != 5 || d[0].MaximumDPSChange != 7 || d[0].SeedDPSChanges[12] != 7 {
+		t.Fatalf("wrong paired interpretation: %#v", d)
+	}
+	d[0].SeedDPSChanges[11] = 999
+	if r.Perturbations[0].Samples[0].DPS != 105 {
+		t.Fatal("evidence mutated")
+	}
+}
+
+func TestResponseDirectionsRequireSeparateFlatMeasurements(t *testing.T) {
+	r := responseFixture()
+	actors := []string{"a", "b", "c", "d"}
+	onlyPercent, err := DirectionsFromResponses(actors, r)
+	if err != nil || len(onlyPercent) != 1 || onlyPercent[0].Stat != "atk_percent" {
+		t.Fatalf("percentage evidence implied a flat slope: %+v %v", onlyPercent, err)
+	}
+	for index, stat := range []struct {
+		key   string
+		delta float64
+	}{
+		{"atk", 97.25}, {"hp", 1493.75}, {"def", 115.75},
+	} {
+		row := r.Perturbations[0]
+		row.Perturbation = engineclient.StatResponsePerturbation{Actor: "a", Stat: stat.key, Delta: stat.delta}
+		row.ConfigSHA256 = strings.Repeat(string(rune('c'+index)), 64)
+		row.Samples = append([]engineclient.StatResponseSample(nil), row.Samples...)
+		for sample := range row.Samples {
+			row.Samples[sample].ConfigSHA256 = row.ConfigSHA256
+			row.Samples[sample].DPS = r.Baseline[sample].DPS + float64((index+1)*10+sample)
+		}
+		r.Perturbations = append(r.Perturbations, row)
+	}
+	r.CallLimit, r.AttemptedCalls = 10, 10
+	directions, err := DirectionsFromResponses(actors, r)
+	if err != nil || len(directions) != 4 {
+		t.Fatalf("direct flat evidence was lost: %+v %v", directions, err)
+	}
+	want := map[string]float64{"atk_percent": 6, "atk": 10.5, "hp": 20.5, "def": 30.5}
+	for _, direction := range directions {
+		mean, found := want[direction.Stat]
+		if !found || direction.MeanDPSChange != mean {
+			t.Fatalf("flat and percent probes were conflated: %+v", direction)
+		}
+		delete(want, direction.Stat)
+	}
+	if len(want) != 0 {
+		t.Fatalf("missing direct directions: %+v", want)
+	}
+}
+
+func TestResponseDirectionsForeignPriorityRequiresEveryPairedSeed(t *testing.T) {
+	r := responseFixture()
+	r.Perturbations[0].Samples[0].CharacterDPS = map[string]float64{"a": 17, "b": 58, "c": 20, "d": 10}
+	d, err := DirectionsFromResponses([]string{"a", "b", "c", "d"}, r)
+	if err != nil || len(d) != 1 {
+		t.Fatalf("directions: %#v %v", d, err)
+	}
+	if d[0].Status != "positive_on_sampled_seeds" || d[0].MeanOtherDPSChange != 2.5 || d[0].MinimumOtherDPSChange != -2 {
+		t.Fatalf("mixed foreign response must not look positive on every seed: %#v", d[0])
+	}
+}
+
+func TestResponseDirectionsDoNotTurnNoiseOrPlateauIntoCap(t *testing.T) {
+	for _, value := range []float64{100, 95} {
+		r := responseFixture()
+		r.Perturbations[0].Samples[0].DPS = value
+		d, err := DirectionsFromResponses([]string{"a", "b", "c", "d"}, r)
+		if err != nil || d[0].Status != "inconclusive_local_response" {
+			t.Fatalf("claimed cap/useless stat: %#v %v", d, err)
+		}
+	}
+}
+
+func TestResponseDirectionsRejectIncompleteOrMisboundEvidence(t *testing.T) {
+	for name, mutate := range map[string]func(*engineclient.StatResponseResult){
+		"partial":            func(r *engineclient.StatResponseResult) { r.AttemptedCalls-- },
+		"tampered engine":    func(r *engineclient.StatResponseResult) { r.EngineUnchanged = false },
+		"missing actors":     func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].CharacterDPS = nil },
+		"foreign owner":      func(r *engineclient.StatResponseResult) { r.Perturbations[0].Perturbation.Actor = "e" },
+		"wrong seed":         func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].Seed = 13 },
+		"wrong config":       func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].ConfigSHA256 = "other" },
+		"duplicate seed":     func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].Seed = 12 },
+		"not finite":         func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].DPS = math.NaN() },
+		"no identity":        func(r *engineclient.StatResponseResult) { r.Binding.RequestSHA256 = "" },
+		"different anchor":   func(r *engineclient.StatResponseResult) { r.PreparedConfigSHA256 = strings.Repeat("c", 64) },
+		"unpaired RNG":       func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].SampleSeed = "other" },
+		"wrong fidelity":     func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].Iterations = 2 },
+		"no result identity": func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].EngineResultSHA256 = "" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			r := responseFixture()
+			mutate(&r)
+			if _, err := DirectionsFromResponses([]string{"a", "b", "c", "d"}, r); err == nil {
+				t.Fatal("invalid evidence accepted")
+			}
+		})
+	}
+}
diff --git a/internal/supportimpact/plan.go b/internal/supportimpact/plan.go
new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/plan.go
@@ -0,0 +1,98 @@
+package supportimpact
+
+import (
+	"fmt"
+	"math"
+	"sort"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+)
+
+type ProbeTarget struct {
+	Owner  string `json:"owner"`
+	Stat   string `json:"stat"`
+	Reason string `json:"reason"`
+}
+
+type ResponsePlan struct {
+	Required     bool                          `json:"required"`
+	Plan         engineclient.StatResponsePlan `json:"plan"`
+	Targets      []ProbeTarget                 `json:"targets"`
+	Deferred     []ProbeTarget                 `json:"deferred"`
+	OmittedStats []string                      `json:"omitted_stats"`
+	Scope        string                        `json:"scope"`
+}
+
+// PlanResponseCheck is a character-independent escape policy, not an inferred
+// role classifier. Unattributed opaque regions cannot safely be assigned to a
+// named character. The finite plan therefore covers every wearer fairly, in
+// rounds, and retains explicit unprobed directions when the call allowance is
+// too small. A connected support edge is not a completeness certificate: other
+// frozen support paths can coexist with it.
+//
+// Main-stat-scale positive input displacements are diagnostic only; they do
+// not claim to be complete legal artifact builds. Final candidates must pay
+// their actual main/substat opportunity costs and pass ordinary verification.
+func PlanResponseCheck(coverage Report, actors []string, seeds []uint64, maxCalls int) (ResponsePlan, error) {
+	out := ResponsePlan{Required: coverage.NeedsResponseCheck(), Targets: []ProbeTarget{}, Deferred: []ProbeTarget{}, Scope: "bounded_local_support_stat_subset_not_completeness",
+		OmittedStats: []string{"er", "cr", "cd", "pyro%", "hydro%", "electro%", "cryo%", "anemo%", "geo%", "dendro%", "phys%"}}
+	if len(actors) != 4 || len(seeds) < 2 || maxCalls < 0 || maxCalls > 128 {
+		return out, fmt.Errorf("invalid response-check allowance or team/panel")
+	}
+	ordered := append([]string(nil), actors...)
+	sort.Strings(ordered)
+	for i, actor := range ordered {
+		if actor == "" || i > 0 && ordered[i-1] == actor {
+			return out, fmt.Errorf("response actors must be distinct")
+		}
+	}
+	seedSeen := map[uint64]bool{}
+	for _, seed := range seeds {
+		if seed == 0 || seed > math.MaxInt64 || seedSeen[seed] {
+			return out, fmt.Errorf("invalid paired response seed")
+		}
+		seedSeen[seed] = true
+		out.Plan.Seeds = append(out.Plan.Seeds, int64(seed))
+	}
+	if !out.Required {
+		return out, nil
+	}
+	// These are shared artifact dimensions, never character-name defaults.
+	// Healing bonus is a main-stat-only direction and must not disappear just
+	// because no damage graph contains a substat coordinate for it. Flat ATK,
+	// HP, and DEF each get their own five-upgrade-unit probe: their responses
+	// cannot be inferred from a percentage-stat response.
+	stats := []struct {
+		key   string
+		delta float64
+	}{
+		{"atk%", .466}, {"hp%", .466}, {"heal", .359}, {"em", 186.5}, {"def%", .583},
+		{"atk", 97.25}, {"hp", 1493.75}, {"def", 115.75},
+	}
+	available := maxCalls/len(seeds) - 1
+	if available < 0 {
+		available = 0
+	}
+	// Never spend a partial owner round on whichever names sort first. The
+	// unused allowance remains unused, not a promise to cover other stats.
+	available -= available % len(ordered)
+	for _, stat := range stats {
+		for _, actor := range ordered {
+			target := ProbeTarget{Owner: actor, Stat: stat.key, Reason: "opaque_or_unbound_dependency"}
+			if len(out.Plan.Perturbations) >= available {
+				out.Deferred = append(out.Deferred, target)
+				continue
+			}
+			out.Targets = append(out.Targets, target)
+			out.Plan.Perturbations = append(out.Plan.Perturbations, engineclient.StatResponsePerturbation{Actor: actor, Stat: stat.key, Delta: stat.delta})
+		}
+	}
+	if len(out.Plan.Perturbations) > 0 {
+		out.Plan.CallLimit = len(seeds) * (1 + len(out.Plan.Perturbations))
+		// Product response uses one exact paired seed panel. With any nonzero
+		// personal/foreign response we still measure both seeds. An all-channel
+		// zero on the first seed cannot qualify as positive on EVERY seed.
+		out.Plan.ScreenZeroFirstSeed = len(seeds) == 2
+	}
+	return out, nil
+}
