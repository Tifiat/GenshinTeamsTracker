+func TestMechanicIRInvalidModulePlanRecompilesSource(t *testing.T) {
+	cache := NewRuleParseCache("", t.TempDir())
+	source := map[string][]byte{"internal/artifacts/sample/rule.go": []byte(`package sample
+const Answer = 7
+func Start() int { return Answer }`)}
+	engine := contracts.EngineBinding{ArtifactSHA256: strings.Repeat("a", 64), SourceManifestSHA256: strings.Repeat("b", 64)}
+	prepare := func() (*ruleProgram, string) {
+		p, ir, origin, analysisErr, compileErr := prepareMechanicProgram(source, nil, nil, nil, engine, strings.Repeat("c", 64), cache)
+		if compileErr != nil || analysisErr != nil || p == nil || ir == nil {
+			t.Fatalf("prepare: %s %v %v", origin, analysisErr, compileErr)
+		}
+		return p, origin
+	}
+	_, cold := prepare()
+	if cold != "source" {
+		t.Fatalf("cold origin %q", cold)
+	}
+	cache.irMu.Lock()
+	for key, ir := range cache.irMemory {
+		if ir.ModulePlan == nil || len(ir.ModulePlan.Modules) != 1 || len(ir.ModulePlan.Modules[0].Globals) != 1 {
+			cache.irMu.Unlock()
+			t.Fatal("cold module plan missing constant")
+		}
+		ir.ModulePlan.Modules[0].Globals[0].Constant = false
+		cache.irMemory[key] = ir
+	}
+	cache.irMu.Unlock()
+	p, repaired := prepare()
+	if repaired != "source" || cache.MechanicIRStats().Repairs == 0 || cache.MechanicIRStats().SemanticAnalyses < 2 {
+		t.Fatalf("invalid plan not repaired: %s %#v", repaired, cache.MechanicIRStats())
+	}
+	value, err := newRuleVM(p, nil, 10000).entry("Start")
+	if err != nil || value != float64(7) {
+		t.Fatalf("recompiled constant: %v %v", value, err)
+	}
+}
