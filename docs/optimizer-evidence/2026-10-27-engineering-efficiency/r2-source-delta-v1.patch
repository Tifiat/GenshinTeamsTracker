--- /dev/null
+++ b/cmd/gtt-optimizer/mechanic_theory_test.go
@@ -0,0 +1,51 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theorysearch"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theoryverify"
+)
+
+func TestTheoryFallbackCandidateUsesCompleteLegalOriginalTuple(t *testing.T) {
+	var cfg theorysearch.Config
+	var mains [4][5]string
+	for actor, name := range []string{"a", "b", "c", "d"} {
+		cfg.Wearers[actor] = name
+		mains[actor] = [5]string{"hp", "atk", "atk_percent", "atk_percent", "crit_rate"}
+	}
+	cfg.Initial = alloc.Seed(mains, [4][10]float64{}, 0, 45)
+	build, err := theoryFallbackCandidate(cfg, strings.Repeat("a", 64), strings.Repeat("b", 64), []string{"unknown_operation"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var identity theoryverify.BuildIdentity
+	if err := json.Unmarshal(build.BuildIdentity, &identity); err != nil {
+		t.Fatal(err)
+	}
+	if identity.Kind != theoryverify.BuildKind || len(identity.Packages) != 4 || identity.Witness45 != cfg.Initial {
+		t.Fatalf("incomplete ordinary identity: %#v", identity)
+	}
+	if len(build.Origins) != 1 || build.Origins[0].Kind != "mechanic_model_unavailable" {
+		t.Fatalf("wrong origin: %#v", build.Origins)
+	}
+	allocations, err := theorysearch.AllocationsForWitness(cfg.Initial, cfg.Wearers)
+	if err != nil || len(allocations) != 4 {
+		t.Fatalf("complete native fallback allocations missing: %v %v", allocations, err)
+	}
+}
+
+func TestTheoryFallbackCodesAreBoundedAndDistinct(t *testing.T) {
+	rows := make([]theorysearch.Unavailable, 40)
+	for i := range rows {
+		rows[i].Reasons = []string{"same", "reason_" + string(rune('a'+i))}
+	}
+	diagnostic := theorysearch.FailureDiagnostic{Unavailable: rows, UnavailableTotal: len(rows)}
+	codes := theoryFallbackCodes(diagnostic, nil)
+	if len(codes) != 32 || codes[0] != "same" {
+		t.Fatalf("unbounded diagnostics: %v", codes)
+	}
+}
