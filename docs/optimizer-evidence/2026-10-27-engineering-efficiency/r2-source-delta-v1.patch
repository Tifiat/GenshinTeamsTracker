+func neutralCandidateReportsBitEqual(left, right search.CandidateReport) bool {
+	if !reflect.DeepEqual(left, right) {
+		return false
+	}
+	a := []float64{left.Low, left.High, left.Step.AnchorDPS, left.Step.ProposalDPS}
+	b := []float64{right.Low, right.High, right.Step.AnchorDPS, right.Step.ProposalDPS}
+	for i := range a {
+		if math.Float64bits(a[i]) != math.Float64bits(b[i]) {
+			return false
+		}
+	}
+	for i, row := range left.Step.Finalists {
+		if math.Float64bits(row.DPS) != math.Float64bits(right.Step.Finalists[i].DPS) {
+			return false
+		}
+	}
+	return true
+}
