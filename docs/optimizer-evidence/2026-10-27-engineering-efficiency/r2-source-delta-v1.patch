+// snapshotNeutralSearchFinalists preserves RunNeutral's ordered raw panel
+// before replacement and support-response rows can mutate product finalists.
+func snapshotNeutralSearchFinalists(request contracts.OptimizerRequest, base *setcontext.Context, candidates []allsets.Candidate) ([]map[string]any, error) {
+	if len(candidates) == 0 {
+		return []map[string]any{}, nil
+	}
+	rows := make([]map[string]any, 0, len(candidates))
+	renderer, err := allsets.FinalistRenderer(request, base, candidates)
+	if err != nil {
+		return nil, err
+	}
+	for i, candidate := range candidates {
+		rendered, renderErr := renderer(candidate.Score, 500, 4)
+		if renderErr != nil {
+			return nil, fmt.Errorf("render neutral raw finalist %d: %w", i, renderErr)
+		}
+		packages := make([]any, len(candidate.Packages))
+		for actor, pack := range candidate.Packages {
+			packages[actor] = pack
+		}
+		rows = append(rows, map[string]any{
+			"label":          fmt.Sprintf("raw_search_%02d", i),
+			"score":          candidate.Score,
+			"packages":       packages,
+			"context_sha256": candidate.Context.Key(),
+			"config_sha256":  rendered.SHA256,
+		})
+	}
+	return rows, nil
 }
 
