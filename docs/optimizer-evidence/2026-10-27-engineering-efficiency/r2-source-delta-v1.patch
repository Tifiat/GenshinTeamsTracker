+func newEarlyPreparationState(job string) (*earlyPreparationState, error) {
+	if !filepath.IsAbs(job) {
+		return nil, fmt.Errorf("early_preparation_job_must_be_absolute")
+	}
+	info, err := os.Stat(job)
+	if err != nil {
+		return nil, fmt.Errorf("early_preparation_job_directory_invalid: %w", err)
+	}
+	if !info.IsDir() {
+		return nil, fmt.Errorf("early_preparation_job_path_not_directory")
+	}
+	if _, err := os.Stat(filepath.Join(job, earlyPreparationLedgerName)); err == nil || !os.IsNotExist(err) {
+		return nil, fmt.Errorf("early_preparation_ledger_already_exists")
+	}
+	return &earlyPreparationState{job: job}, nil
