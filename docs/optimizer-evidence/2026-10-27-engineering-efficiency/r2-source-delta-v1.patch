diff --git a/internal/mechanicdiagnostics/store.go b/internal/mechanicdiagnostics/store.go
new file mode 100644
--- /dev/null
+++ b/internal/mechanicdiagnostics/store.go
@@ -0,0 +1,452 @@
+// Package mechanicdiagnostics persists bounded, source-identified frozen
+// mechanic observations. It never accepts a runtime MechanicBoundary directly:
+// callers must map it to the static, allowlisted fields in Observation.
+package mechanicdiagnostics
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"regexp"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+const (
+	SchemaVersion     = 2
+	MaxRecords        = 256
+	MaxRecordBytes    = 16 * 1024
+	MaxDirectoryBytes = 8 * 1024 * 1024
+	MaxFrames         = 12
+	tempMaxAge        = 24 * time.Hour
+)
+
+var (
+	identifier = regexp.MustCompile(`^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$`)
+	digest     = regexp.MustCompile(`^[0-9a-f]{64}$`)
+	muByRoot   sync.Map // *sync.Mutex; serializes callers in this process per directory
+)
+
+// SourceFrame names static source only. Paths must be repository-relative Go
+// source paths; no caller-generated path or runtime stack is accepted.
+type SourceFrame struct {
+	Path   string `json:"path"`
+	Symbol string `json:"symbol"`
+}
+
+// Observation contains only static source identity and bounded diagnostic
+// categories. The caller must supply a verified content/closure fingerprint.
+// Nil OutputMask means unknown; zero is an explicitly known empty mask.
+type Observation struct {
+	EngineID      string
+	CompilerID    string
+	MechanicID    string
+	ClosureSHA256 string
+	Source        SourceFrame
+	CallStack     []SourceFrame
+	Kind          string
+	Operation     string
+	OutputMask    *uint64
+	ReasonCode    contracts.MechanicReasonCode
+	ConsumerSite  string
+	Fallback      string
+	Influence     string
+}
+
+// FrozenRecord is the stable, allowlisted on-disk format. There are deliberately no
+// request, profile, rotation, artifact, owner, frame, or raw error fields.
+type FrozenRecord struct {
+	Schema        int                          `json:"schema"`
+	EngineID      string                       `json:"engine_id"`
+	CompilerID    string                       `json:"compiler_id"`
+	MechanicID    string                       `json:"mechanic_id"`
+	ClosureSHA256 string                       `json:"closure_sha256"`
+	Source        SourceFrame                  `json:"source"`
+	CallStack     []SourceFrame                `json:"call_stack,omitempty"`
+	Kind          string                       `json:"kind"`
+	Operation     string                       `json:"operation"`
+	OutputMask    *uint64                      `json:"output_mask"`
+	ReasonCode    contracts.MechanicReasonCode `json:"reason_code"`
+	ConsumerSite  string                       `json:"consumer_site,omitempty"`
+	Fallback      string                       `json:"fallback"`
+	Influence     string                       `json:"influence"`
+	FirstSeen     time.Time                    `json:"first_seen"`
+	LastSeen      time.Time                    `json:"last_seen"`
+	Count         uint64                       `json:"count"`
+}
+
+// Stats includes nonfatal failures and evictions since Open, for the caller's
+// ordinary run summary. No overflow counter is persisted in this directory.
+type Stats struct {
+	Records  int
+	Bytes    int64
+	Overflow uint64
+	Errors   uint64
+	Evicted  uint64
+}
+
+type Store struct {
+	root  string
+	mu    *sync.Mutex
+	stats Stats
+}
+
+// Open takes the already-resolved diagnostics directory, never a profile or
+// settings root. The caller owns path selection and treats errors as nonfatal.
+func Open(root string) (*Store, error) {
+	if root == "" || !filepath.IsAbs(root) {
+		return nil, errors.New("diagnostics root must be explicit and absolute")
+	}
+	root = filepath.Clean(root)
+	v, _ := muByRoot.LoadOrStore(root, &sync.Mutex{})
+	s := &Store{root: root, mu: v.(*sync.Mutex)}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return nil, err
+	}
+	if err := s.reconcile(); err != nil {
+		return nil, err
+	}
+	return s, nil
+}
+
+func (s *Store) Path() string { return s.root }
+
+func (s *Store) Stats() Stats {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.stats
+}
+
+func allowed(value string, options ...string) bool {
+	for _, option := range options {
+		if value == option {
+			return true
+		}
+	}
+	return false
+}
+
+func validFrame(f SourceFrame) bool {
+	if !identifier.MatchString(f.Symbol) || len(f.Path) > 256 || !strings.HasSuffix(f.Path, ".go") || strings.Contains(f.Path, "\\") || strings.Contains(f.Path, ":") || path.IsAbs(f.Path) || path.Clean(f.Path) != f.Path {
+		return false
+	}
+	if !(strings.HasPrefix(f.Path, "pkg/") || strings.HasPrefix(f.Path, "internal/")) {
+		return false
+	}
+	for _, part := range strings.Split(f.Path, "/") {
+		if !identifier.MatchString(part) {
+			return false
+		}
+	}
+	return true
+}
+
+func valid(o Observation) bool {
+	if !identifier.MatchString(o.EngineID) || !identifier.MatchString(o.CompilerID) || !identifier.MatchString(o.MechanicID) || !digest.MatchString(o.ClosureSHA256) || !validFrame(o.Source) || len(o.CallStack) > MaxFrames {
+		return false
+	}
+	for _, f := range o.CallStack {
+		if !validFrame(f) {
+			return false
+		}
+	}
+	if !allowed(o.Kind, "unsupported_source", "unknown_operation", "schedule_change", "analysis_budget", "invalid_operation") || (o.Operation != "" && !identifier.MatchString(o.Operation)) {
+		return false
+	}
+	if !contracts.ValidMechanicReasonCode(o.ReasonCode) || !contracts.ValidMechanicConsumerSite(o.ConsumerSite) {
+		return false
+	}
+	if !allowed(o.Fallback, "frozen", "source_replay", "full_simulation", "excluded") {
+		return false
+	}
+	if !allowed(o.Influence, "unknown", "proven_affects_output", "proven_no_effect", "conservative") {
+		return false
+	}
+	return true
+}
+
+func identity(o Observation) string {
+	// No run/build/team/frame/version appears in this key. Distinct verified
+	// technical causes at one boundary remain separate, repeatable records.
+	h := sha256.Sum256([]byte(o.MechanicID + "\x00" + o.ClosureSHA256 + "\x00" + o.Source.Path + "\x00" + o.Source.Symbol + "\x00" + o.Kind + "\x00" + o.Operation + "\x00" + string(o.ReasonCode) + "\x00" + o.ConsumerSite))
+	return hex.EncodeToString(h[:])
+}
+
+// Record merges repeats by logical mechanic + source closure +
+// unresolved operation. Invalid observations increment Errors and write nothing.
+func (s *Store) Record(o Observation) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !valid(o) {
+		s.stats.Errors++
+		return errors.New("invalid or non-allowlisted mechanic observation")
+	}
+	if err := s.reconcile(); err != nil {
+		s.stats.Errors++
+		return err
+	}
+	name := identity(o) + ".json"
+	file := filepath.Join(s.root, name)
+	now := time.Now().UTC()
+	r := FrozenRecord{Schema: SchemaVersion, EngineID: o.EngineID, CompilerID: o.CompilerID, MechanicID: o.MechanicID, ClosureSHA256: o.ClosureSHA256, Source: o.Source, CallStack: o.CallStack, Kind: o.Kind, Operation: o.Operation, OutputMask: o.OutputMask, ReasonCode: o.ReasonCode, ConsumerSite: o.ConsumerSite, Fallback: o.Fallback, Influence: o.Influence, FirstSeen: now, LastSeen: now, Count: 1}
+	if data, err := os.ReadFile(file); err == nil {
+		var old FrozenRecord
+		if err := json.Unmarshal(data, &old); err == nil && old.Schema == SchemaVersion && old.MechanicID == o.MechanicID && old.ClosureSHA256 == o.ClosureSHA256 && old.Kind == o.Kind && old.Operation == o.Operation && old.ReasonCode == o.ReasonCode && old.ConsumerSite == o.ConsumerSite && old.Source == o.Source {
+			r.FirstSeen = old.FirstSeen
+			if old.Count == ^uint64(0) {
+				r.Count = old.Count
+			} else {
+				r.Count = old.Count + 1
+			}
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		s.stats.Errors++
+		return err
+	}
+	data, err := json.Marshal(r)
+	if err != nil {
+		s.stats.Errors++
+		return err
+	}
+	if len(data) > MaxRecordBytes {
+		s.stats.Overflow++
+		return errors.New("mechanic record exceeds size limit")
+	}
+	// Records alone occupy at most 4 MiB. Make space for the temporary copy
+	// before creation, then enforce record count and bytes again after replace.
+	if err := s.makeRoom(name, int64(len(data))); err != nil {
+		s.stats.Overflow++
+		return err
+	}
+	tmp, err := os.CreateTemp(s.root, ".mechanic-tmp-")
+	if err != nil {
+		s.stats.Errors++
+		return err
+	}
+	tmpName := tmp.Name()
+	defer os.Remove(tmpName)
+	if err := tmp.Chmod(0600); err != nil {
+		tmp.Close()
+		s.stats.Errors++
+		return err
+	}
+	if _, err = tmp.Write(data); err != nil {
+		tmp.Close()
+		s.stats.Errors++
+		return err
+	}
+	if err = tmp.Sync(); err != nil {
+		tmp.Close()
+		s.stats.Errors++
+		return err
+	}
+	if err = tmp.Close(); err != nil {
+		s.stats.Errors++
+		return err
+	}
+	// Rename replaces the destination in this directory; on failure, leave the
+	// old record in place and remove the temporary copy.
+	if err = replaceFile(tmpName, file, os.Rename, time.Sleep); err != nil {
+		s.stats.Errors++
+		return err
+	}
+	if err = s.reconcile(); err != nil {
+		s.stats.Errors++
+		return err
+	}
+	return nil
+}
+
+// On Windows, another reader that did not open the destination with delete
+// sharing can briefly deny MoveFileEx(REPLACE_EXISTING). Keep the old record
+// and retry only those sharing/access errors while holding the per-root lock.
+// A persistent error is returned, counted, and never treated as a merged hit.
+func replaceFile(source, destination string, rename func(string, string) error, wait func(time.Duration)) error {
+	const attempts = 21
+	var err error
+	for attempt := 0; attempt < attempts; attempt++ {
+		if err = rename(source, destination); err == nil {
+			return nil
+		}
+		if !transientWindowsRename(err) || attempt == attempts-1 {
+			return err
+		}
+		wait(100 * time.Millisecond)
+	}
+	return err
+}
+
+func transientWindowsRename(err error) bool {
+	if runtime.GOOS != "windows" {
+		return false
+	}
+	var code syscall.Errno
+	return errors.As(err, &code) && (code == 5 || code == 32) // access denied / sharing violation
+}
+
+type entry struct {
+	name  string
+	bytes int64
+	last  time.Time
+}
+
+func (s *Store) scan() ([]entry, int64, error) {
+	items, err := os.ReadDir(s.root)
+	if err != nil {
+		return nil, 0, err
+	}
+	var records []entry
+	var total int64
+	for _, item := range items {
+		if item.IsDir() {
+			return nil, 0, fmt.Errorf("unexpected directory in diagnostics: %s", item.Name())
+		}
+		info, err := item.Info()
+		if err != nil {
+			return nil, 0, err
+		}
+		total += info.Size()
+		if strings.HasPrefix(item.Name(), ".mechanic-tmp-") {
+			if time.Since(info.ModTime()) > tempMaxAge {
+				if err := os.Remove(filepath.Join(s.root, item.Name())); err != nil {
+					return nil, 0, err
+				}
+				total -= info.Size()
+			}
+			continue
+		}
+		if len(item.Name()) != 69 || !strings.HasSuffix(item.Name(), ".json") || !digest.MatchString(strings.TrimSuffix(item.Name(), ".json")) {
+			return nil, 0, fmt.Errorf("unexpected file in diagnostics: %s", item.Name())
+		}
+		if info.Size() > MaxRecordBytes {
+			if err := os.Remove(filepath.Join(s.root, item.Name())); err != nil {
+				return nil, 0, err
+			}
+			total -= info.Size()
+			s.stats.Evicted++
+			continue
+		}
+		f, err := os.Open(filepath.Join(s.root, item.Name()))
+		if err != nil {
+			return nil, 0, err
+		}
+		var r FrozenRecord
+		dec := json.NewDecoder(io.LimitReader(f, MaxRecordBytes+1))
+		dec.DisallowUnknownFields()
+		err = dec.Decode(&r)
+		var trailing any
+		if err == nil {
+			if more := dec.Decode(&trailing); more != io.EOF {
+				err = errors.New("trailing record data")
+			}
+		}
+		f.Close()
+		o := Observation{EngineID: r.EngineID, CompilerID: r.CompilerID, MechanicID: r.MechanicID, ClosureSHA256: r.ClosureSHA256, Source: r.Source, CallStack: r.CallStack, Kind: r.Kind, Operation: r.Operation, OutputMask: r.OutputMask, ReasonCode: r.ReasonCode, ConsumerSite: r.ConsumerSite, Fallback: r.Fallback, Influence: r.Influence}
+		if err != nil || r.Schema != SchemaVersion || r.Count == 0 || r.LastSeen.IsZero() || r.FirstSeen.IsZero() || r.FirstSeen.After(r.LastSeen) || !valid(o) || identity(o)+".json" != item.Name() {
+			if err := os.Remove(filepath.Join(s.root, item.Name())); err != nil {
+				return nil, 0, err
+			}
+			total -= info.Size()
+			s.stats.Evicted++
+			continue
+		}
+		records = append(records, entry{item.Name(), info.Size(), r.LastSeen})
+	}
+	return records, total, nil
+}
+
+func (s *Store) reconcile() error {
+	records, total, err := s.scan()
+	if err != nil {
+		return err
+	}
+	sort.Slice(records, func(i, j int) bool { return records[i].last.Before(records[j].last) })
+	for len(records) > MaxRecords || total > MaxDirectoryBytes {
+		if len(records) == 0 {
+			s.stats.Records = 0
+			s.stats.Bytes = total
+			return errors.New("diagnostics directory exceeds limit with active temp files")
+		}
+		old := records[0]
+		records = records[1:]
+		if err := os.Remove(filepath.Join(s.root, old.name)); err != nil {
+			return err
+		}
+		total -= old.bytes
+		s.stats.Evicted++
+	}
+	s.stats.Records = len(records)
+	s.stats.Bytes = total
+	return nil
+}
+
+func (s *Store) makeRoom(replacing string, incoming int64) error {
+	records, total, err := s.scan()
+	if err != nil {
+		return err
+	}
+	sort.Slice(records, func(i, j int) bool { return records[i].last.Before(records[j].last) })
+	newRecord := true
+	for _, e := range records {
+		if e.name == replacing {
+			newRecord = false
+			break
+		}
+	}
+	for len(records)+boolInt(newRecord) > MaxRecords || total+incoming > MaxDirectoryBytes {
+		if len(records) == 0 {
+			return errors.New("diagnostics directory has no space")
+		}
+		old := records[0]
+		records = records[1:]
+		if err := os.Remove(filepath.Join(s.root, old.name)); err != nil {
+			return err
+		}
+		if old.name == replacing {
+			newRecord = true
+		}
+		total -= old.bytes
+		s.stats.Evicted++
+	}
+	return nil
+}
+
+func boolInt(v bool) int {
+	if v {
+		return 1
+	}
+	return 0
+}
+
+// Clear removes only managed record files. Active temporary files remain and
+// expire through the normal crash-recovery path.
+func (s *Store) Clear() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	records, _, err := s.scan()
+	if err != nil {
+		s.stats.Errors++
+		return err
+	}
+	for _, e := range records {
+		if err := os.Remove(filepath.Join(s.root, e.name)); err != nil {
+			s.stats.Errors++
+			return err
+		}
+	}
+	return s.reconcile()
+}
