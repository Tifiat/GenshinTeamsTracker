+		if actor != 0 {
+			for _, id := range ids {
+				used[id] = true
+			}
+		}
+	}
+	rawSize := 1
+	for _, pool := range c.Index.CandidateIDsBySlot {
+		free := 0
+		for _, id := range pool {
