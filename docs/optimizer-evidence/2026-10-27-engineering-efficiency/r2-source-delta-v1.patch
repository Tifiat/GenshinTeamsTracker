+			t.Fatalf("missing artifact totals for %s:\n%s", wearer.WearerKey, rendered.Text)
+		}
+		if !strings.Contains(rendered.Text, wearer.WearerKey+` add set="`+wearer.SelectedSetUID+`" count=4;`) {
+			t.Fatalf("set package changed while rendering artifact totals for %s", wearer.WearerKey)
+		}
+	}
+	if !strings.Contains(rendered.Text, "ignore_burst_energy=true") || !strings.Contains(rendered.Text, "# rotation sentinel\n") {
+		t.Fatal("energy option or prepared ordinary frame changed")
