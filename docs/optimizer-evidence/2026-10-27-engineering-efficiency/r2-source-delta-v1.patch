diff --git a/internal/seteffects/rule_parameter_types.go b/internal/seteffects/rule_parameter_types.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_parameter_types.go
@@ -0,0 +1,54 @@
+package seteffects
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"path"
+	"strconv"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func ruleSourceImports(file *ast.File) map[string]string {
+	out:=map[string]string{}
+	for _,imp:=range file.Imports {module,err:=strconv.Unquote(imp.Path.Value);if err!=nil{continue};name:=path.Base(module);if imp.Name!=nil{name=imp.Name.Name};out[name]=module}
+	return out
+}
+
+// A small exact type proof for supported ABI scalars. Composite/interface or
+// ambiguous types stay opaque; the resolver does not guess an underlying type.
+func ruleParameterType(repository *ruleRepository,cache *RuleParseCache,module string,imports map[string]string,expr ast.Expr,seen map[string]bool,depth int) contracts.MechanicParameter {
+	if depth>16 {return contracts.MechanicParameter{}}
+	if ellipsis,ok:=expr.(*ast.Ellipsis);ok{return ruleParameterType(repository,cache,module,imports,ellipsis.Elt,seen,depth+1)}
+	var target,name string
+	var builtin contracts.MechanicParameter
+	var isBuiltin bool
+	switch expr:=expr.(type) {
+	case *ast.Ident:
+		builtin,isBuiltin=contracts.MechanicBuiltinParameter(expr.Name)
+		if isBuiltin && repository==nil{return builtin}
+		target,name=module,expr.Name
+	case *ast.SelectorExpr:
+		pkg,ok:=expr.X.(*ast.Ident);if !ok{return contracts.MechanicParameter{}}
+		target,name=imports[pkg.Name],expr.Sel.Name
+	default:return contracts.MechanicParameter{}
+	}
+	identity:=target+"."+name
+	opaque:=contracts.MechanicParameter{Type:identity}
+	if target=="" || seen[identity] || repository==nil{return opaque}
+	seen[identity]=true
+	var declaration *ast.TypeSpec
+	var declarationFile *ast.File
+	for _,fileName:=range repository.packages[target] {
+		var file *ast.File;var err error
+		if cache!=nil{file,err=cache.loadFile(fileName,repository.files[fileName])}else{file,err=parser.ParseFile(token.NewFileSet(),fileName,repository.files[fileName],parser.SkipObjectResolution)}
+		if err!=nil{return opaque}
+		for _,decl:=range file.Decls {if group,ok:=decl.(*ast.GenDecl);ok{for _,spec:=range group.Specs{if value,ok:=spec.(*ast.TypeSpec);ok && value.Name.Name==name{if declaration!=nil{return opaque};declaration,declarationFile=value,file}}}}
+	}
+	if declaration==nil{if isBuiltin{return builtin};return opaque}
+	underlying:=ruleParameterType(repository,cache,target,ruleSourceImports(declarationFile),declaration.Type,seen,depth+1)
+	if !underlying.Known{return opaque}
+	if !declaration.Assign.IsValid(){underlying.Type=identity}
+	return underlying
+}
