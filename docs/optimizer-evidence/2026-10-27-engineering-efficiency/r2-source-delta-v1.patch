+func commonTheoryResponseFixture() (contracts.OptimizerRequest, theoryverify.ResponseAnchor, theoryverify.Candidate, engineclient.StatResponseBinding) {
+	hash := strings.Repeat("a", 64)
+	request := contracts.OptimizerRequest{Legality: contracts.LegalityPolicy{TheorySearch: true}}
+	config := "actor_a skill;\n"
+	binding := engineclient.StatResponseBinding{AnchorConfigSHA256: contracts.TextSHA256(config), RequestSHA256: hash,
+		EngineArtifactSHA256: hash, EngineBindingSHA256: hash, EngineSourceManifestSHA256: hash, EnginePatchManifestSHA256: hash}
+	anchor := theoryverify.ResponseAnchor{CandidateSHA256: hash, EngineArtifactSHA256: hash, SourceManifestSHA256: hash,
+		Binding: theoryResponseBinding(binding)}
+	anchor.Config.Text, anchor.Config.SHA256 = config, binding.AnchorConfigSHA256
+	candidate := theoryverify.Candidate{Key: hash}
+	alias := theorysearch.Alias{}
+	for _, wearer := range []string{"actor_a", "actor_b", "actor_c", "actor_d"} {
+		alias.Packages = append(alias.Packages, theorysearch.PackageRow{WearerKey: wearer})
+	}
+	candidate.Row.Aliases = []theorysearch.Alias{alias}
+	return request, anchor, candidate, binding
+}
+
+func TestCommonTheoryResponseUsesSharedAllowanceAndDetachedEvidence(t *testing.T) {
+	request, anchor, candidate, binding := commonTheoryResponseFixture()
+	report := supportimpact.Report{Coordinates: []supportimpact.Coordinate{
+		{Key: "actor_a.atk_percent", Owner: "actor_a", Recipients: []string{"actor_a"}},
+	}}
+	direction := supportimpact.Direction{Binding: binding, Owner: "actor_a", Stat: "atk_percent", Amount: .466,
+		MeanOtherDPSChange: 5, MinimumOtherDPSChange: 4, Status: "positive_on_sampled_seeds",
+		SeedDPSChanges: map[int64]float64{31: 4, 37: 6}, ResultSHA256BySeed: map[int64]string{31: strings.Repeat("b", 64), 37: strings.Repeat("c", 64)}}
+	resolverCalls, responseCalls := 0, 0
+	producer := commonTheoryResponseProducer("managed-test-root", func(_ context.Context, packages [4]domain.Package) (supportimpact.Report, error) {
+		resolverCalls++
+		if len(packages[0].Sets) != 0 {
+			t.Fatal("anchor package changed")
+		}
+		return report, nil
+	}, func(_ context.Context, got contracts.OptimizerRequest, coverage supportimpact.Report, config, root string, allowance supportimpact.ResponseAllowance) (supportimpact.ResponseCheck, error) {
+		responseCalls++
+		if !got.Legality.TheorySearch || config != anchor.Config.Text || root != "managed-test-root" ||
+			allowance.MaxCalls != 66 || allowance.Timeout != 180*time.Second || len(coverage.Coordinates) != 1 {
+			t.Fatal("Theory bypassed the common context/allowance", allowance)
+		}
+		return supportimpact.ResponseCheck{Binding: binding, Status: "completed_proposal_only", Directions: []supportimpact.Direction{direction}}, nil
+	})
+	panel, err := producer(context.Background(), request, anchor, candidate)
+	if err != nil || resolverCalls != 1 || responseCalls != 1 || len(panel.Directions) != 1 || !panel.Directions[0].CrossAncestryMissing ||
+		panel.AnchorCandidateSHA256 != candidate.Key || panel.Binding != anchor.Binding {
+		t.Fatal("shared response evidence was not mapped exactly", panel, err)
+	}
+	panel.Directions[0].SeedDPSChanges[31] = -100
+	panel.Directions[0].ResultSHA256BySeed[31] = "changed"
+	if direction.SeedDPSChanges[31] != 4 || direction.ResultSHA256BySeed[31] == "changed" {
+		t.Fatal("Theory publication shares mutable response evidence")
+	}
+}
+
+func TestCommonTheoryResponseProducerBridgesRawTheoryIntoActualRunWithoutRequiredGap(t *testing.T) {
+	_, anchor, candidate, _ := commonTheoryResponseFixture()
+	request, _ := productFixtures(t)
+	request.Artifacts = []contracts.Artifact{}
+	request.Legality.FixedFourPiece = false
+	request.Legality.FixedSetPackages = false
+	request.Legality.TheorySearch = true
+	request.Legality.MaxOffSetPiecesPerWearer = 0
+	request.Legality.AuthorizedLowerRarityArtifactIDs = []int64{}
+	for index := range request.Wearers {
+		wearer := &request.Wearers[index]
+		wearer.SelectedSetUID = ""
+		wearer.SelectedSets = nil
+		wearer.CurrentArtifacts = []contracts.ArtifactAssignment{}
+		wearer.TheoryBaseline = &contracts.TheoryArtifactBaseline{MainStats: []contracts.TheoryMainStat{
+			{Slot: "flower", Key: "hp", Value: "4780"},
+			{Slot: "plume", Key: "atk", Value: "311"},
+			{Slot: "sands", Key: "atk_percent", Value: "0.466"},
+			{Slot: "goblet", Key: "atk_percent", Value: "0.466"},
+			{Slot: "circlet", Key: "crit_rate", Value: "0.311"},
+		}}
+	}
+	wire, err := contracts.CanonicalJSON(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request, _, err = contracts.DecodeTheoryRequest(wire)
+	if err != nil {
+		t.Fatalf("decode canonical raw Theory wire request: %v", err)
+	}
+
+	coverageCalls := 0
+	producer := commonTheoryResponseProducer("managed-test-root", func(context.Context, [4]domain.Package) (supportimpact.Report, error) {
+		coverageCalls++
+		return supportimpact.Report{}, nil
+	}, supportimpact.RunResponseCheck)
+	panel, err := producer(context.Background(), request, anchor, candidate)
+	if err != nil || coverageCalls != 1 || panel.Status != "not_required" || len(panel.Directions) != 0 ||
+		panel.Binding != anchor.Binding || panel.AnchorConfigSHA256 != anchor.Config.SHA256 {
+		t.Fatalf("raw Theory producer did not bridge to the actual no-required-check path: panel=%+v coverage=%d err=%v", panel, coverageCalls, err)
+	}
+}
+
+func TestCommonTheoryResponseRejectsForeignBindingAndPreservesUnprobedOrCancel(t *testing.T) {
+	request, anchor, candidate, binding := commonTheoryResponseFixture()
+	coverage := func(context.Context, [4]domain.Package) (supportimpact.Report, error) {
+		return supportimpact.Report{}, nil
+	}
+	for _, test := range []struct {
+		name     string
+		status   string
+		probeErr error
+		foreign  bool
+	}{
+		{"optional_unavailable", "unprobed_seeded_ordinary_unavailable", nil, false},
+		{"cancel", "failed", context.Canceled, false},
+		{"foreign", "completed_proposal_only", nil, true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			producer := commonTheoryResponseProducer("managed-test-root", coverage, func(context.Context, contracts.OptimizerRequest, supportimpact.Report, string, string, supportimpact.ResponseAllowance) (supportimpact.ResponseCheck, error) {
+				check := supportimpact.ResponseCheck{Binding: binding, Status: test.status}
+				if test.foreign {
+					check.Binding.RequestSHA256 = strings.Repeat("d", 64)
+					check.Directions = []supportimpact.Direction{{Binding: check.Binding}}
+				}
+				return check, test.probeErr
+			})
+			panel, err := producer(context.Background(), request, anchor, candidate)
+			if test.foreign && err == nil {
+				t.Fatal("foreign response binding accepted")
+			}
+			if test.probeErr != nil && !errors.Is(err, test.probeErr) {
+				t.Fatal("cancel became successful proposal", err)
+			}
+			if !test.foreign && test.probeErr == nil && (err != nil || panel.Status != test.status || len(panel.Directions) != 0) {
+				t.Fatal("optional unprobed response acquired fake evidence", panel, err)
+			}
+		})
+	}
