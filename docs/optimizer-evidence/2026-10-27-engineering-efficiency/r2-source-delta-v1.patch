@@ -0,0 +1,132 @@
+package main
+
+import (
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/search"
+)
+
+func TestSelectResponseReservationsKeepsLowFormulaResponseInsideSelectedLimit(t *testing.T) {
+	request, _ := productFixtures(t)
+	request = withResultOptionsAndEnergyPolicy(t, request, contracts.ResultOptions{SetGroupLimit: 1, BuildsPerGroup: 2})
+	request = addArtifactVariants(t, request, 2, func(_ int, artifact contracts.Artifact) string { return artifact.SetUID })
+	anchor := variantAssignment(request, 0)
+	responseAssignment := oneSwapAssignment(request, 0, 1)
+	formulaAssignment := oneSwapAssignment(request, 0, 2)
+
+	selected, deferred, err := selectResponseReservations(request,
+		[]search.ScoredAssignment{
+			{Assignment: anchor, DPS: 1000, Source: "anchor"},
+			{Assignment: formulaAssignment, DPS: 999, Source: "formula"},
+		},
+		[]search.ScoredAssignment{
+			{Assignment: responseAssignment, DPS: 1, Source: "response-first"},
+			{Assignment: responseAssignment, DPS: 2, Source: "response-duplicate"},
+		}, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if deferred != 0 || len(selected) != 2 {
+		t.Fatalf("got %d selected and %d deferred responses, want 2 and 0", len(selected), deferred)
+	}
+	if selected[0].Assignment != anchor || selected[0].Source != "anchor" ||
+		selected[1].Assignment != responseAssignment || selected[1].Source != "response-first" {
+		t.Fatalf("anchor/response reservation order or provenance changed: %+v", selected)
+	}
+}
+
+func TestSelectResponseReservationsRespectsAllSetsGroupAndTotalCaps(t *testing.T) {
+	request, _ := productFixtures(t)
+	request = withResultOptionsAndEnergyPolicy(t, request, contracts.ResultOptions{SetGroupLimit: 2, BuildsPerGroup: 2})
+	request = addArtifactVariants(t, request, 4, func(variant int, artifact contracts.Artifact) string {
+		switch variant {
+		case 1:
+			return artifact.SetUID
+		case 2, 3:
+			return "alternate_set"
+		default:
+			return "third_set"
+		}
+	})
+	anchor := variantAssignment(request, 0)
+	responseFirst := oneSwapAssignment(request, 0, 1)
+	responseOverGroupCap := anchor
+	responseOverGroupCap[0][2] = variantAssignment(request, 1)[0][2]
+	responseOtherPackage := variantAssignment(request, 4)
+	formulaGroupBFirst := variantAssignment(request, 2)
+	formulaGroupBSecond := variantAssignment(request, 3)
+	formulaThirdPackage := variantAssignment(request, 4)
+
+	selected, deferred, err := selectResponseReservations(request,
+		[]search.ScoredAssignment{
+			{Assignment: anchor, DPS: 100, Source: "anchor"},
+			{Assignment: formulaGroupBFirst, DPS: 1000, Source: "formula-b1"},
+			{Assignment: formulaGroupBSecond, DPS: 900, Source: "formula-b2"},
+			{Assignment: formulaThirdPackage, DPS: 800, Source: "formula-c"},
+		},
+		[]search.ScoredAssignment{
+			{Assignment: responseFirst, DPS: 1, Source: "response-first"},
+			{Assignment: responseOverGroupCap, DPS: 2, Source: "response-over-group-cap"},
+			{Assignment: responseOtherPackage, DPS: 3, Source: "response-other-package"},
+			{Assignment: responseOverGroupCap, DPS: 4, Source: "response-duplicate"},
+		}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(selected) != 4 || deferred != 2 {
+		t.Fatalf("got %d selected and %d deferred responses, want 4 and 2: %+v", len(selected), deferred, selected)
+	}
+	want := []search.ScoredAssignment{
+		{Assignment: anchor, DPS: 100, Source: "anchor"},
+		{Assignment: responseFirst, DPS: 1, Source: "response-first"},
+		{Assignment: formulaGroupBFirst, DPS: 1000, Source: "formula-b1"},
+		{Assignment: formulaGroupBSecond, DPS: 900, Source: "formula-b2"},
+	}
+	for i := range want {
+		if selected[i] != want[i] {
+			t.Fatalf("selected row %d = %+v, want %+v", i, selected[i], want[i])
+		}
+	}
+}
+
+func TestSelectResponseReservationsSingleSlotDefersUniqueResponse(t *testing.T) {
+	request, _ := productFixtures(t)
+	request = withResultOptionsAndEnergyPolicy(t, request, contracts.ResultOptions{SetGroupLimit: 1, BuildsPerGroup: 1})
+	request = addArtifactVariants(t, request, 1, func(_ int, artifact contracts.Artifact) string { return artifact.SetUID })
+	anchor := variantAssignment(request, 0)
+	responseAssignment := oneSwapAssignment(request, 0, 1)
+
+	selected, deferred, err := selectResponseReservations(request,
+		[]search.ScoredAssignment{{Assignment: anchor, DPS: 100, Source: "anchor"}},
+		[]search.ScoredAssignment{
+			{Assignment: anchor, DPS: 100, Source: "duplicate-anchor"},
+			{Assignment: responseAssignment, DPS: 1, Source: "response"},
+			{Assignment: responseAssignment, DPS: 2, Source: "response-duplicate"},
+		}, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(selected) != 1 || selected[0].Source != "anchor" || deferred != 1 {
+		t.Fatalf("single-slot result should retain only anchor and defer one unique response: selected=%+v deferred=%d", selected, deferred)
+	}
+}
+
+func TestSelectResponseReservationsEmptyAndMaximumOptions(t *testing.T) {
+	request, _ := productFixtures(t)
+	request = withResultOptionsAndEnergyPolicy(t, request, contracts.ResultOptions{
+		SetGroupLimit: 50, BuildsPerGroup: 101, ExpandedLimits: true,
+	})
+	anchor := variantAssignment(request, 0)
+	if _, _, err := selectResponseReservations(request, nil, nil, true); err == nil {
+		t.Fatal("empty candidate list should fail because it has no anchor")
+	}
+	selected, deferred, err := selectResponseReservations(request,
+		[]search.ScoredAssignment{{Assignment: anchor, DPS: 100, Source: "anchor"}}, nil, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(selected) != 1 || cap(selected) != 1 || deferred != 0 {
+		t.Fatalf("maximum configured budget must allocate only observed rows: len=%d cap=%d deferred=%d", len(selected), cap(selected), deferred)
+	}
+}
diff --git a/cmd/gtt-optimizer/support_response.go b/cmd/gtt-optimizer/support_response.go
new file mode 100644
--- /dev/null
+++ b/cmd/gtt-optimizer/support_response.go
@@ -0,0 +1,241 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/energy"
+	"genshinteamstracker/native/gcsim_optimizer/internal/evaluator"
+	"genshinteamstracker/native/gcsim_optimizer/internal/finalists"
+	"genshinteamstracker/native/gcsim_optimizer/internal/search"
+	"genshinteamstracker/native/gcsim_optimizer/internal/searchcontrol"
+	"genshinteamstracker/native/gcsim_optimizer/internal/supportimpact"
+)
+
+// One invocation-wide response escape lane, never one allowance per set,
+// actor, refinement cycle or finalist. These diagnostic calls have n=1 and do
+// not replace the common-fidelity ordinary measurement of complete builds.
+const supportResponseCalls = 66
+const supportResponseVisitLimit = 200000
+
+type inventoryResponseReceipt struct {
+	Status            string                       `json:"status"`
+	Anchor            domain.Assignment            `json:"anchor"`
+	ContextSHA256     string                       `json:"context_sha256,omitempty"`
+	Coverage          supportimpact.Report         `json:"coverage"`
+	Check             *supportimpact.ResponseCheck `json:"check,omitempty"`
+	Combined          search.ResponseProposals     `json:"combined_proposals"`
+	Individual        search.ResponseProposals     `json:"individual_proposals"`
+	RejectedEnergy    int                          `json:"rejected_energy"`
+	ElapsedMS         float64                      `json:"elapsed_ms"`
+	DeferredContexts  int                          `json:"deferred_contexts"`
+	DeferredFinalists int                          `json:"deferred_finalists"`
+}
+
+type responseCheckRunner func(context.Context, contracts.OptimizerRequest, supportimpact.Report, string, string, supportimpact.ResponseAllowance) (supportimpact.ResponseCheck, error)
+
+func runInventoryResponse(ctx context.Context, request contracts.OptimizerRequest, index *domain.Index,
+	panel *evaluator.Panel, energyModel *energy.Model, anchor search.ScoredAssignment,
+	render finalists.CandidateRenderer, runRoot string, finishedEarly bool,
+	run responseCheckRunner) (receipt inventoryResponseReceipt, proposals []search.ScoredAssignment, err error) {
+	started := time.Now()
+	defer func() { receipt.ElapsedMS = float64(time.Since(started)) / float64(time.Millisecond) }()
+	if index == nil || panel == nil || render == nil || run == nil {
+		return receipt, nil, fmt.Errorf("missing response proposal context")
+	}
+	receipt.Anchor, receipt.Coverage = anchor.Assignment, panel.SupportCoverage()
+	if !receipt.Coverage.NeedsResponseCheck() {
+		receipt.Status = "no_observed_gap_not_completeness"
+		return receipt, nil, nil
+	}
+	if request.EffectiveResultOptions().FastMode {
+		receipt.Status = "unprobed_fast_mode"
+		return receipt, nil, nil
+	}
+	if finishedEarly {
+		receipt.Status = "unprobed_user_finish"
+		return receipt, nil, nil
+	}
+	if request.EffectiveResultOptions().BuildsPerGroup < 2 {
+		// An anchor alone cannot establish whether a different legal build wins.
+		// Do not spend a response panel when the user allowed no challenger.
+		receipt.Status = "unprobed_exact_finalist_limit"
+		return receipt, nil, nil
+	}
+	// Soft Finish interrupts this optional search lane, not ordinary
+	// verification of the retained complete anchor. Emergency Cancel still
+	// belongs to the outer context and aborts the whole request.
+	responseCtx, closeResponse := searchcontrol.Begin(ctx)
+	defer func() {
+		requested := searchcontrol.Requested(responseCtx)
+		closeResponse()
+		if requested && ctx.Err() == nil {
+			receipt.Status = "partial_user_finish"
+			proposals, err = nil, nil
+		}
+	}()
+	rendered, err := render(anchor, 1, 1)
+	if err != nil {
+		return receipt, nil, err
+	}
+	check, err := run(responseCtx, request, receipt.Coverage, rendered.Text, runRoot,
+		supportimpact.ResponseAllowance{MaxCalls: supportResponseCalls, Timeout: 180 * time.Second})
+	receipt.Check, receipt.Status = &check, check.Status
+	if err != nil {
+		return receipt, nil, fmt.Errorf("support response check: %w", err)
+	}
+	if len(check.Directions) == 0 {
+		return receipt, nil, nil
+	}
+	solver, err := search.NewInventory(index, panel, search.DefaultConfig(), energyModel)
+	if err != nil {
+		return receipt, nil, err
+	}
+	// Joint locally measured directions get a reservation before individual
+	// dimensions. Neither list goes through a formula top-K after this point.
+	receipt.Combined, err = solver.ProposeCombinedResponseDirections(responseCtx, anchor.Assignment, check.Directions, 5, supportResponseVisitLimit/2)
+	if err != nil {
+		return receipt, nil, err
+	}
+	receipt.Individual, err = solver.ProposeResponseDirections(responseCtx, anchor.Assignment, check.Directions, 8, supportResponseVisitLimit/2)
+	if err != nil {
+		return receipt, nil, err
+	}
+	seen := map[domain.Assignment]bool{anchor.Assignment: true}
+	for _, row := range append(append([]search.ResponseProposal{}, receipt.Combined.Proposals...), receipt.Individual.Proposals...) {
+		if seen[row.Candidate.Assignment] {
+			continue
+		}
+		if energyModel != nil {
+			assessment, e := energyModel.Feasibility(row.Candidate.Assignment)
+			if e != nil {
+				return receipt, nil, e
+			}
+			if !assessment.Feasible {
+				receipt.RejectedEnergy++
+				continue
+			}
+		}
+		seen[row.Candidate.Assignment] = true
+		proposals = append(proposals, row.Candidate)
+	}
+	proposals, err = prioritizeResponseReservations(index, anchor.Assignment, proposals, check.Directions, receipt.Coverage)
+	if err != nil {
+		return receipt, nil, err
+	}
+	return receipt, proposals, nil
+}
+
+func responseWarnings(receipt inventoryResponseReceipt) []string {
+	if !receipt.Coverage.NeedsResponseCheck() {
+		return nil
+	}
+	warnings := []string{"support_response_bounded_local_not_completeness"}
+	positive := false
+	if receipt.Check != nil {
+		for _, direction := range receipt.Check.Directions {
+			positive = positive || direction.Status == "positive_on_sampled_seeds"
+		}
+	}
+	hasResponseEvidence := receipt.Check != nil && receipt.Check.Evidence != nil && receipt.Check.Evidence.AttemptedCalls > 0
+	if hasResponseEvidence && !positive {
+		warnings = append(warnings, "support_response_unresolved")
+	}
+	if receipt.Status == "unprobed_seeded_ordinary_unavailable" {
+		warnings = append(warnings, "support_response_seeded_ordinary_unavailable")
+	}
+	if receipt.Status == "unprobed_exact_finalist_limit" || receipt.DeferredFinalists > 0 {
+		warnings = append(warnings, "support_response_challenger_unverified_exact_limit")
+	}
+	if receipt.Combined.DirectionsQuotaLimited+receipt.Combined.DirectionsDeferred+
+		receipt.Individual.DirectionsQuotaLimited+receipt.Individual.DirectionsDeferred > 0 || receipt.DeferredContexts > 0 || receipt.DeferredFinalists > 0 {
+		warnings = append(warnings, "support_response_proposals_limited")
+	}
+	return warnings
+}
+
+// Allocate scarce ordinary-verification slots using measured response, not
+// wearer alphabet or the formula whose missing dependency triggered this lane.
+// Displacement-scaled slopes are LOCAL PROPOSAL PRIORITIES ONLY: no corrected
+// DPS is written, no cap/extrapolation/noise certificate is implied. Ordinary
+// full-build measurement at the same fidelity remains the ranking authority.
+func prioritizeResponseReservations(index *domain.Index, anchor domain.Assignment, rows []search.ScoredAssignment,
+	directions []supportimpact.Direction, coverage supportimpact.Report) ([]search.ScoredAssignment, error) {
+	priorities := make(map[domain.Assignment]supportimpact.ProposalPriority, len(rows))
+	before, err := index.AssignmentStats(anchor)
+	if err != nil {
+		return nil, err
+	}
+	crossKnown := coverage.KnownForeignCoordinates()
+	var axes [4][]supportimpact.ProposalAxis
+	for _, direction := range directions {
+		actor := -1
+		for i, wearer := range index.Wearers {
+			if wearer.WearerKey == direction.Owner {
+				actor = i
+				break
+			}
+		}
+		if actor < 0 {
+			return nil, fmt.Errorf("unbound response reservation direction")
+		}
+		axes[actor] = append(axes[actor], supportimpact.ProposalAxis{Stat: direction.Stat, Amount: direction.Amount,
+			TotalChange: direction.MeanDPSChange, OtherChange: direction.MeanOtherDPSChange,
+			MissingForeign: direction.MinimumOtherDPSChange > 0 && !crossKnown[direction.Owner+"."+direction.Stat]})
+	}
+	for _, row := range rows {
+		after, err := index.AssignmentStats(row.Assignment)
+		if err != nil {
+			return nil, err
+		}
+		p := supportimpact.ProposalPriority{Available: true}
+		for actor := range anchor {
+			distance := 0
+			for slot := range anchor[actor] {
+				if anchor[actor][slot] != row.Assignment[actor][slot] {
+					distance++
+				}
+			}
+			local, err := supportimpact.LocalProposalPriority(axes[actor], before[actor], after[actor], distance)
+			if err != nil {
+				return nil, err
+			}
+			p.TotalGuide += local.TotalGuide
+			p.OtherGuide += local.OtherGuide
+			p.MissingOtherGuide += local.MissingOtherGuide
+			p.UnmeasuredLosses += local.UnmeasuredLosses
+			p.ChangedSlots += local.ChangedSlots
+		}
+		if err := supportimpact.ValidateProposalPriority(p); err != nil {
+			return nil, err
+		}
+		priorities[row.Assignment] = p
+	}
+	out := append([]search.ScoredAssignment{}, rows...)
+	sort.SliceStable(out, func(i, j int) bool {
+		a, b := priorities[out[i].Assignment], priorities[out[j].Assignment]
+		if comparison := supportimpact.CompareProposalPriorities(a, b); comparison != 0 {
+			return comparison < 0
+		}
+		return compareDomainAssignments(out[i].Assignment, out[j].Assignment) < 0
+	})
+	// With several challenger slots, retain an endpoint/local shape pair. A
+	// scarce single challenger keeps the risk-aware first choice. This does
+	// not increase the panel, and the final selector still enforces its limits.
+	if len(out) > 2 {
+		firstLocal := priorities[out[0].Assignment].ChangedSlots == 1
+		for i := 1; i < len(out); i++ {
+			if priorities[out[i].Assignment].TotalGuide >= 0 && (priorities[out[i].Assignment].ChangedSlots == 1) != firstLocal {
+				row := out[i]
+				copy(out[2:i+1], out[1:i])
+				out[1] = row
+				break
+			}
+		}
+	}
+	return out, nil
+}
