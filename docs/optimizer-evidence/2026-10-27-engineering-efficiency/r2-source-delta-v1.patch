+func TestNeutralCandidateMemoExactSearchParityAndLogicalWork(t *testing.T) {
+	index, c, cfg := neutralCandidateMemoFixture(t)
+	panel, err := c.Handle.SearchPanel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, refine := range []bool{false, true} {
+		name := "screen"
+		if refine {
+			name = "refine"
+		}
+		t.Run(name, func(t *testing.T) {
+			memo := newNeutralCandidateMemo(4, 100)
+			key := neutralCandidateSearchKey(index, c, cfg, 0, 20, refine)
+			calls, observed := 0, 0
+			work := func() (search.CandidateReport, error) {
+				calls++
+				solver, err := search.NewInventory(c.Index, panel, cfg)
+				if err != nil {
+					return search.CandidateReport{}, err
+				}
+				solver.ObserveCandidates(func(search.ScoredAssignment) { observed++ })
+				if refine {
+					return solver.RefineCandidates(context.Background(), c.Score.Assignment, 0, 20)
+				}
+				return solver.ScreenCandidates(context.Background(), c.Score.Assignment, 0, 20)
+			}
+			first, reused, err := memo.run(context.Background(), key, work)
+			if err != nil || reused || first.Step.Expanded == 0 || observed == 0 {
+				t.Fatalf("first real search: reused=%v observed=%d report=%+v err=%v", reused, observed, first, err)
+			}
+			firstObserved := observed
+			again, reused, err := memo.run(context.Background(), key, work)
+			if err != nil || !reused || calls != 1 || observed != firstObserved || !reflect.DeepEqual(first, again) {
+				t.Fatalf("identical call changed report/work: reused=%v calls=%d observed=%d err=%v", reused, calls, observed, err)
+			}
+			oracle, err := work()
+			if err != nil || !reflect.DeepEqual(oracle, again) || first.Step.Expanded+again.Step.Expanded != 2*oracle.Step.Expanded {
+				t.Fatalf("cached report differs from independent real search or logical charge: err=%v", err)
+			}
+			// Neither the miss's result nor a hit may mutate retained finalists.
+			first.Step.Finalists[0].DPS = -1
+			again.Step.Finalists[0].Assignment[0][0] = -1
+			third, reused, err := memo.run(context.Background(), key, work)
+			if err != nil || !reused || !reflect.DeepEqual(third, oracle) {
+				t.Fatal("report finalists alias the cache", err)
+			}
+		})
+	}
+}
