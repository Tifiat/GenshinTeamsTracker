+)
+
+func TestMechanicFallbackOneExistingOrdinarySlotNoFormula(t *testing.T) {
+	request, _ := productFixtures(t)
+	index, err := domain.Build(request, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	plan, err := prepareMechanicFallback(request, index, mechanicpolicy.NewModelUnavailable(mechanicpolicy.ModelUnavailable, []string{"unbound_operation"}), false, 1, false)
+	if err != nil || !plan.Decision.VerifyOrdinary || plan.AnchorSource != mechanicpolicy.InputIncumbent {
+		t.Fatalf("fallback plan: %#v %v", plan, err)
+	}
+	calls := 0
+	verify := func(_ context.Context, _ contracts.OptimizerRequest, _ *domain.Index, candidates []search.ScoredAssignment, _ string, iterations, workers, parallelism int) (finalists.VerificationResult, error) {
+		calls++
+		if len(candidates) != 1 || candidates[0].Assignment != index.Incumbent || iterations != 500 || workers != 4 || parallelism != 1 {
+			t.Fatalf("ordinary slot changed: %#v %d/%d/%d", candidates, iterations, workers, parallelism)
+		}
+		return finalists.VerificationResult{Candidates: []finalists.MeasuredCandidate{{Assignment: index.Incumbent, MeasuredDPS: 123, Iterations: 500}}, Iterations: 500}, nil
+	}
+	measured, err := verifyMechanicFallbackWith(context.Background(), request, index, plan, t.TempDir(), verify)
+	if err != nil || calls != 1 || measured == nil || measured.MeasuredDPS != 123 {
+		t.Fatalf("ordinary anchor: %#v %d %v", measured, calls, err)
+	}
+	encoded, err := json.Marshal(measured)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(encoded), "formula") || strings.Contains(string(encoded), "residual") {
+		t.Fatalf("unavailable formula serialized: %s", encoded)
+	}
+}
+
+func TestMechanicFallbackFastFinishAndNonModelError(t *testing.T) {
+	request, _ := productFixtures(t)
+	index, err := domain.Build(request, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	modelErr := mechanicpolicy.NewModelUnavailable(mechanicpolicy.ModelUnavailable, nil)
+	for _, mode := range []struct{ fast, finish bool }{{true, false}, {false, true}} {
+		copy := request
+		copy.ResultOptions = &contracts.ResultOptions{SetGroupLimit: 3, BuildsPerGroup: 2, FastMode: mode.fast}
+		plan, err := prepareMechanicFallback(copy, index, modelErr, mode.finish, 1, false)
+		if err != nil || plan.Decision.VerifyOrdinary {
+			t.Fatalf("fast/finish forced measurement: %#v %v", plan, err)
+		}
+		measured, err := verifyMechanicFallbackWith(context.Background(), copy, index, plan, t.TempDir(), nil)
+		if err != nil || measured != nil {
+			t.Fatalf("fast/finish ran verifier: %#v %v", measured, err)
+		}
+	}
+	invalid := errors.New("invalid rotation")
+	_, err = prepareMechanicFallback(request, index, invalid, false, 1, false)
+	if !errors.Is(err, invalid) {
+		t.Fatalf("invalid input became model fallback: %v", err)
+	}
+}
