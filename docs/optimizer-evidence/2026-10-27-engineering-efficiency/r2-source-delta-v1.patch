+++ b/internal/formula/artifact_arithmetic_test.go
@@ -0,0 +1,286 @@
+package formula
+
+import (
+	"fmt"
+	"math"
+	"math/rand"
+	"testing"
+)
+
+// This reference retains the generic interpreter and math predicates from
+// before the artifact fast path. It deliberately does not call its helpers.
+func referenceArtifactNode(n *compiledNode, values []float64) (float64, error) {
+	var v float64
+	switch n.op {
+	case opConstant:
+		v = n.value
+	case opArtifactStat:
+		return 0, fmt.Errorf("artifact stat in constant subgraph")
+	case opAdd:
+		for _, i := range n.inputs {
+			v += values[i]
+		}
+	case opMultiply:
+		v = 1
+		for _, i := range n.inputs {
+			v *= values[i]
+		}
+	case opMin, opMax:
+		v = values[n.inputs[0]]
+		for _, i := range n.inputs[1:] {
+			if n.op == opMin {
+				v = math.Min(v, values[i])
+			} else {
+				v = math.Max(v, values[i])
+			}
+		}
+	case opPower:
+		v = math.Pow(values[n.inputs[0]], values[n.inputs[1]])
+	case opSelectLT:
+		v = values[n.inputs[3]]
+		if values[n.inputs[0]] < values[n.inputs[1]] {
+			v = values[n.inputs[2]]
+		}
+	default:
+		return 0, fmt.Errorf("invalid operation")
+	}
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return 0, fmt.Errorf("produced a non-finite value")
+	}
+	return v, nil
+}
+
+func referenceArtifactSweep(p *ArtifactProgram, delta []float64) (float64, error) {
+	for _, v := range delta {
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			return 0, fmt.Errorf("nonfinite artifact input")
+		}
+	}
+	for _, i := range p.active {
+		n := &p.nodes[i]
+		if n.op == opArtifactStat {
+			p.values[i] = delta[n.coordinate]
+			continue
+		}
+		v, err := referenceArtifactNode(n, p.values)
+		if err != nil {
+			return 0, err
+		}
+		p.values[i] = v
+	}
+	return p.values[p.root], nil
+}
+
+// The benchmark includes the previous wrapper's change mask and validation,
+// not just its cheaper inner sweep, so both sides do the same candidate work.
+func previousArtifactEvaluation(p *ArtifactProgram, delta []float64) (float64, error) {
+	if p == nil || len(delta) != len(p.coordinates) {
+		return 0, fmt.Errorf("artifact program coordinate mismatch")
+	}
+	for _, v := range delta {
+		if math.IsNaN(v) || math.IsInf(v, 0) {
+			return 0, fmt.Errorf("nonfinite artifact input")
+		}
+	}
+	p.prepareDependencies()
+	changed := ^uint64(0)
+	if p.previousValid && p.dependencies != nil {
+		changed = 0
+		for i, value := range delta {
+			if math.Float64bits(value) != math.Float64bits(p.previous[i]) {
+				changed |= uint64(1) << uint(i)
+			}
+		}
+		if changed&p.usedInputs == 0 {
+			copy(p.previous, delta)
+			return p.values[p.root], nil
+		}
+	}
+	p.previousValid = false
+	partial := p.dependencies != nil && changed&p.usedInputs != p.usedInputs
+	evaluate := func(i uint32) error {
+		n := &p.nodes[i]
+		if n.op == opArtifactStat {
+			p.values[i] = delta[n.coordinate]
+			return nil
+		}
+		v, err := referenceArtifactNode(n, p.values)
+		if err != nil {
+			return err
+		}
+		p.values[i] = v
+		return nil
+	}
+	if p.active == nil {
+		for i := range p.nodes {
+			if err := evaluate(uint32(i)); err != nil {
+				return 0, err
+			}
+		}
+	} else {
+		for _, i := range p.active {
+			if partial && p.dependencies[i]&changed == 0 {
+				continue
+			}
+			if err := evaluate(i); err != nil {
+				return 0, err
+			}
+		}
+	}
+	v := p.values[p.root]
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return 0, fmt.Errorf("nonfinite artifact program result")
+	}
+	if p.dependencies != nil {
+		copy(p.previous, delta)
+		p.previousValid = true
+	}
+	return v, nil
+}
+
+func arithmeticDispatchFixture(t testing.TB, blocks int) *ArtifactProgram {
+	t.Helper()
+	b := newProgramBuilder([]string{"a.atk", "a.crit", "b.hp", "b.unused"})
+	add := func(n compiledNode) uint32 {
+		id, err := b.add(n)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return id
+	}
+	x := add(compiledNode{op: opArtifactStat, coordinate: 0})
+	y := add(compiledNode{op: opArtifactStat, coordinate: 1})
+	z := add(compiledNode{op: opArtifactStat, coordinate: 2})
+	one := add(compiledNode{op: opConstant, coordinate: -1, value: 1})
+	half := add(compiledNode{op: opConstant, coordinate: -1, value: .5})
+	cap := add(compiledNode{op: opMin, coordinate: -1, inputs: []uint32{y, one}})
+	floor := add(compiledNode{op: opMax, coordinate: -1, inputs: []uint32{z, one}})
+	power := add(compiledNode{op: opPower, coordinate: -1, inputs: []uint32{floor, half}})
+	roots := make([]uint32, 0, blocks)
+	for i := 0; i < blocks; i++ {
+		c := add(compiledNode{op: opConstant, coordinate: -1, value: 1 + float64(i)/128})
+		sum := add(compiledNode{op: opAdd, coordinate: -1, inputs: []uint32{x, c, cap}})
+		product := add(compiledNode{op: opMultiply, coordinate: -1, inputs: []uint32{sum, cap, power}})
+		branch := add(compiledNode{op: opSelectLT, coordinate: -1, inputs: []uint32{x, c, product, sum}})
+		roots = append(roots, branch)
+	}
+	root := add(compiledNode{op: opAdd, coordinate: -1, inputs: roots})
+	return b.finish(root)
+}
+
+func TestArtifactArithmeticMatchesGenericInterpreter(t *testing.T) {
+	fast := arithmeticDispatchFixture(t, 32)
+	reference := copyArtifactScratch(fast)
+	x := []float64{0, 0, 0, 0}
+	rng := rand.New(rand.NewSource(817))
+	for i := 0; i < 3000; i++ {
+		if i%9 != 0 {
+			x[rng.Intn(len(x))] = rng.Float64()*8 - 4
+		}
+		if i%13 == 0 {
+			x[0] = math.Copysign(0, -1)
+		}
+		if i%17 == 0 {
+			x[1] = math.SmallestNonzeroFloat64
+		}
+		if i%31 == 0 {
+			x[3] = math.NaN()
+		}
+		got, err := fast.Evaluate(x)
+		want, other := referenceArtifactSweep(reference, x)
+		if fmt.Sprint(err) != fmt.Sprint(other) || math.Float64bits(got) != math.Float64bits(want) {
+			t.Fatal(i, got, want, err, other)
+		}
+	}
+}
+
+func TestArtifactArithmeticOrderedFoldsAndErrorRecovery(t *testing.T) {
+	for _, op := range []uint8{opAdd, opMultiply, opMin, opMax} {
+		for _, inputs := range [][]float64{
+			{}, {math.Copysign(0, -1)}, {0, math.Copysign(0, -1)},
+			{1e16, 1, -1e16}, {1e308, 1e-308, 1e-308}, {math.MaxFloat64, 2, 0},
+			{math.MaxFloat64, math.MaxFloat64, -math.MaxFloat64},
+			{math.SmallestNonzeroFloat64, .5, -1},
+			{math.Copysign(0, -1), 0}, {0, math.Copysign(0, -1), 0},
+			{2, 2, 2}, {-5, -2, -3}, {.5, math.SmallestNonzeroFloat64},
+		} {
+			if len(inputs) == 0 && (op == opMin || op == opMax) {
+				continue // Invalid IR; the source validator requires an operand.
+			}
+			p := &ArtifactProgram{coordinates: make([]string, len(inputs)), root: uint32(len(inputs))}
+			var operands []uint32
+			for i := range inputs {
+				p.nodes = append(p.nodes, compiledNode{op: opArtifactStat, coordinate: i})
+				operands = append(operands, uint32(i))
+			}
+			p.nodes = append(p.nodes, compiledNode{op: op, inputs: operands})
+			p.values = make([]float64, len(p.nodes))
+			for i := range p.nodes {
+				p.active = append(p.active, uint32(i))
+			}
+			reference := copyArtifactScratch(p)
+			valid := make([]float64, len(inputs))
+			for i := range valid {
+				valid[i] = 1
+			}
+			for _, delta := range [][]float64{valid, inputs, valid} {
+				got, err := p.Evaluate(delta)
+				want, other := referenceArtifactSweep(reference, delta)
+				if fmt.Sprint(err) != fmt.Sprint(other) || math.Float64bits(got) != math.Float64bits(want) {
+					t.Fatal(op, delta, got, want, err, other)
+				}
+			}
+		}
+	}
+}
+
+func TestFinitePredicateAllExponentsAndRepresentativePayloads(t *testing.T) {
+	for sign := uint64(0); sign < 2; sign++ {
+		for exponent := uint64(0); exponent < 2048; exponent++ {
+			for _, mantissa := range []uint64{0, 1, 0x8000000000000, 0xfffffffffffff} {
+				bits := sign<<63 | exponent<<52 | mantissa
+				v := math.Float64frombits(bits)
+				if isFinite(v) != (!math.IsNaN(v) && !math.IsInf(v, 0)) {
+					t.Fatalf("finite predicate changed for %016x", bits)
+				}
+			}
+		}
+	}
+}
+
+var arithmeticBenchmarkSink float64
+
+func BenchmarkArtifactArithmeticDispatch(b *testing.B) {
+	for _, generic := range []bool{true, false} {
+		name := "prepared_fast_path"
+		if generic {
+			name = "previous_dispatch"
+		}
+		b.Run(name, func(b *testing.B) {
+			p := arithmeticDispatchFixture(b, 1024)
+			x := [][]float64{{2, .4, 3, 0}, {3, .7, 4, 1}}
+			if generic {
+				if _, err := previousArtifactEvaluation(p, x[1]); err != nil {
+					b.Fatal(err)
+				}
+			} else if _, err := p.Evaluate(x[1]); err != nil {
+				b.Fatal(err)
+			}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				var v float64
+				var err error
+				if generic {
+					v, err = previousArtifactEvaluation(p, x[i&1])
+				} else {
+					v, err = p.Evaluate(x[i&1])
+				}
+				if err != nil {
+					b.Fatal(err)
+				}
+				arithmeticBenchmarkSink = v
+			}
+		})
+	}
+}
