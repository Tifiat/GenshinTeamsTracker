diff --git a/internal/seteffects/rule_repository.go b/internal/seteffects/rule_repository.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_repository.go
@@ -0,0 +1,216 @@
+package seteffects
+
+// The repository is verified source, not executable engine state. Modules are
+// linked on demand through ordinary import/type identities. Engine references
+// still stop at the operation ABI; loading their source cannot invent state.
+import (
+	"debug/buildinfo"
+	"fmt"
+	"go/build"
+	"go/parser"
+	"go/token"
+	"io"
+	"path"
+	"path/filepath"
+	"runtime"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+type RuleSourceRepository struct {
+	Module string                          `json:"module"`
+	Files  map[string]contracts.SourceText `json:"files"`
+}
+
+type ruleRepository struct {
+	profile            build.Context
+	module             string
+	files              map[string][]byte
+	packages           map[string][]string
+	profileFingerprint string
+	sourceFingerprint  string
+}
+
+func newRuleRepository(input *RuleSourceRepository, profile build.Context) (*ruleRepository, error) {
+	if input == nil {
+		return nil, nil
+	}
+	if input.Module+"/" != gcsimImport || profile.GOOS == "" || profile.GOARCH == "" || len(input.Files) > 4096 {
+		return nil, fmt.Errorf("invalid mechanic source repository identity")
+	}
+	r := &ruleRepository{module: input.Module, files: map[string][]byte{}, packages: map[string][]string{}}
+	r.profile = profile
+	r.profileFingerprint, _ = contracts.CanonicalSHA256(struct {
+		GoVersion, GOOS, GOARCH     string
+		Cgo                         bool
+		Tags, ToolTags, ReleaseTags []string
+	}{runtime.Version(), profile.GOOS, profile.GOARCH, profile.CgoEnabled, profile.BuildTags, profile.ToolTags, profile.ReleaseTags})
+	bytes := 0
+	for name, source := range input.Files {
+		if path.Clean(name) != name || path.IsAbs(name) || strings.Contains(name, "\\") || strings.HasPrefix(name, "../") || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
+			return nil, fmt.Errorf("invalid mechanic repository path")
+		}
+		bytes += len(source.Text)
+		if bytes > 64<<20 || source.Text == "" || contracts.TextSHA256(source.Text) != source.SHA256 {
+			return nil, fmt.Errorf("mechanic repository source mismatch or size limit")
+		}
+		r.files[name] = []byte(source.Text)
+	}
+	identities := map[string]string{}
+	for name, source := range input.Files {
+		identities[name] = source.SHA256
+	}
+	r.sourceFingerprint, _ = contracts.CanonicalSHA256(struct {
+		SchemaVersion int               `json:"schema_version"`
+		Files         map[string]string `json:"files"`
+	}{1, identities})
+	r.profile.OpenFile = func(name string) (io.ReadCloser, error) {
+		body, ok := r.files[filepath.ToSlash(filepath.Clean(name))]
+		if !ok {
+			return nil, fmt.Errorf("source is outside the bound mechanic repository")
+		}
+		return io.NopCloser(strings.NewReader(string(body))), nil
+	}
+	for name := range r.files {
+		matched, err := r.profile.MatchFile(filepath.FromSlash(path.Dir(name)), path.Base(name))
+		if err != nil {
+			return nil, fmt.Errorf("mechanic build constraint: %w", err)
+		}
+		if matched {
+			if !profile.CgoEnabled {
+				file, parseErr := parser.ParseFile(token.NewFileSet(), name, r.files[name], parser.ImportsOnly)
+				if parseErr != nil {
+					return nil, parseErr
+				}
+				cgo := false
+				for _, imp := range file.Imports {
+					cgo = cgo || imp.Path.Value == `"C"`
+				}
+				if cgo {
+					continue
+				}
+			}
+			pkg := input.Module + "/" + path.Dir(name)
+			r.packages[pkg] = append(r.packages[pkg], name)
+		}
+	}
+	for pkg := range r.packages {
+		sort.Strings(r.packages[pkg])
+	}
+	return r, nil
+}
+
+func boundRuleRepository(input *RuleSourceRepository, engine contracts.EngineBinding) (*ruleRepository, error) {
+	if input == nil {
+		return nil, nil
+	}
+	info, err := buildinfo.ReadFile(engine.BinaryPath)
+	if err != nil {
+		return nil, fmt.Errorf("mechanic source build profile: %w", err)
+	}
+	profile, err := ruleBuildProfile(info)
+	if err != nil {
+		return nil, err
+	}
+	return newRuleRepository(input, profile)
+}
+
+func ruleBuildProfile(info *debug.BuildInfo) (build.Context, error) {
+	profile := build.Default
+	if info.GoVersion != runtime.Version() {
+		return profile, fmt.Errorf("unsupported mechanic source toolchain profile: engine %s consumer %s", info.GoVersion, runtime.Version())
+	}
+	settings := map[string]string{}
+	for _, setting := range info.Settings {
+		settings[setting.Key] = setting.Value
+	}
+	consumerExperiment := ""
+	if own, ok := debug.ReadBuildInfo(); ok {
+		for _, setting := range own.Settings {
+			if setting.Key == "GOEXPERIMENT" {
+				consumerExperiment = setting.Value
+			}
+		}
+	}
+	if settings["GOEXPERIMENT"] != consumerExperiment {
+		return profile, fmt.Errorf("unsupported mechanic source experiment profile")
+	}
+	profile.GOOS, profile.GOARCH = "", ""
+	profile.CgoEnabled = false
+	profile.BuildTags = nil
+	for _, setting := range info.Settings {
+		switch setting.Key {
+		case "GOOS":
+			profile.GOOS = setting.Value
+		case "GOARCH":
+			profile.GOARCH = setting.Value
+		case "CGO_ENABLED":
+			profile.CgoEnabled = setting.Value == "1"
+		case "-tags":
+			profile.BuildTags = strings.FieldsFunc(setting.Value, func(r rune) bool { return r == ',' || r == ' ' })
+		}
+	}
+	if profile.GOARCH != "amd64" {
+		return profile, fmt.Errorf("unsupported mechanic source architecture profile")
+	}
+	if runtime.GOARCH != "amd64" {
+		return profile, fmt.Errorf("unsupported mechanic consumer architecture profile")
+	}
+	level, err := strconv.Atoi(strings.TrimPrefix(settings["GOAMD64"], "v"))
+	if err != nil || level < 1 || level > 4 {
+		return profile, fmt.Errorf("unsupported mechanic source architecture feature level")
+	}
+	profile.ToolTags = nil
+	for _, tag := range build.Default.ToolTags {
+		if strings.HasPrefix(tag, "goexperiment.") {
+			profile.ToolTags = append(profile.ToolTags, tag)
+		}
+	}
+	for n := 1; n <= level; n++ {
+		profile.ToolTags = append(profile.ToolTags, fmt.Sprintf("amd64.v%d", n))
+	}
+	// Exact toolchain equality above also fixes language release/default
+	// experiment tags; an unknown engine toolchain fails instead of borrowing.
+	profile.ReleaseTags = append([]string(nil), build.Default.ReleaseTags...)
+	return profile, nil
+}
+
+// A program may be used by several public replay calls. Module linking shares
+// only immutable syntax/declarations; every VM still owns globals and closures.
+// Registry reads also take this lock so lazy insertion cannot race a replay.
+func (p *ruleProgram) module(name string) *ruleModule {
+	p.moduleMu.Lock()
+	defer p.moduleMu.Unlock()
+	if m := p.modules[name]; m != nil {
+		return m
+	}
+	if p.repository == nil {
+		return nil
+	}
+	names := p.repository.packages[name]
+	if len(names) == 0 {
+		return nil
+	}
+	files := make(map[string][]byte, len(names))
+	for _, file := range names {
+		files[file] = p.repository.files[file]
+	}
+	linked, err := prepareMechanicDependency(files, p.repository, p.operations, p.mechanicContext, p.parseCache)
+	if err != nil {
+		ruleFail("source dependency linking: " + err.Error())
+	}
+	if p.linkedNodes+linked.linkedNodes > maxASTNodes {
+		ruleFailKind(contracts.MechanicAnalysisBudget, "source dependency node budget exhausted")
+	}
+	p.linkedNodes += linked.linkedNodes
+	m := linked.modules[name]
+	if m == nil {
+		ruleFail("source dependency module absent: " + name)
+	}
+	p.modules[name] = m
+	return m
+}
