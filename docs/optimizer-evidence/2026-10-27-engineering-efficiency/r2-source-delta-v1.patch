+package formula
+
+// Each run refers to the existing ordered active list, never node-ID ranges.
+// Both the list and these masks are immutable after specialization.
+type artifactDependencyRun struct {
+    mask uint64
+    start, end uint32
+}
+
+func (p *ArtifactProgram) prepareDependencyRuns() {
+    if len(p.active) == 0 || p.dependencies == nil {
+        return
+    }
+    count := 1
+    previous := p.dependencies[p.active[0]]
+    for _, i := range p.active[1:] {
+        mask := p.dependencies[i]
+        if mask != previous {
+            count++
+            previous = mask
+        }
+    }
+    // 16-byte metadata per run is bounded by one uint32 active list.
+    // No retained allocation for interleaved/uncompressed graphs.
+    if count > len(p.active)/4 {
+        return
+    }
+    runs := make([]artifactDependencyRun, 0, count)
+    start := 0
+    previous = p.dependencies[p.active[0]]
+    for offset := 1; offset < len(p.active); offset++ {
+        mask := p.dependencies[p.active[offset]]
+        if mask != previous {
+            runs = append(runs, artifactDependencyRun{previous, uint32(start), uint32(offset)})
+            start, previous = offset, mask
+        }
+    }
+    p.dependencyRuns = append(runs, artifactDependencyRun{previous, uint32(start), uint32(len(p.active))})
+}
