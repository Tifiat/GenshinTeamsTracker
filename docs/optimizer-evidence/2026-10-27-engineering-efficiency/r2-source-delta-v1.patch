+)
+
+func operationFixture() (MechanicOperations,EngineBinding) {
+	engine:=EngineBinding{ArtifactSHA256:strings.Repeat("a",64),SourceManifestSHA256:strings.Repeat("b",64),Capabilities:[]string{MechanicOperationsCapability}}
+	parameter,_:=MechanicBuiltinParameter("int")
+	op:=MechanicOperation{Symbol:"example.Type.Operation",Receiver:"example.Type",Method:"Operation",Signature:"func(int)",SourcePath:"pkg/example/example.go",SourceSHA256:strings.Repeat("c",64),ClosureSHA256:strings.Repeat("d",64),Parameters:[]MechanicParameter{parameter},Effects:[]MechanicEffectKind{MechanicEffectSchedule}}
+	return MechanicOperations{SchemaVersion:1,EngineSHA256:engine.ArtifactSHA256,SourceManifestSHA256:engine.SourceManifestSHA256,Operations:[]MechanicOperation{op}},engine
+}
+
+func TestMechanicOperationUnknownEffectsAreOpaqueButBadBindingsAreErrors(t *testing.T) {
+	input,engine:=operationFixture()
+	if err:=ValidateMechanicOperations(input,engine);err!=nil { t.Fatal(err) }
+	input.Operations[0].Effects=[]MechanicEffectKind{"future_operation"}
+	if err:=ValidateMechanicOperations(input,engine);err!=nil || !input.Operations[0].OpaqueEffects() { t.Fatalf("unknown operation category lost partial semantics: %v",err) }
+	input.SchemaVersion=2
+	if err:=ValidateMechanicOperations(input,engine);err==nil { t.Fatal("incompatible ABI was accepted as an opaque success") }
+	input.SchemaVersion=1;input.EngineSHA256=strings.Repeat("e",64)
+	if err:=ValidateMechanicOperations(input,engine);err==nil { t.Fatal("wrong engine binding accepted") }
+	input,engine=operationFixture();engine.Capabilities=nil
+	if err:=ValidateMechanicOperations(input,engine);err==nil { t.Fatal("descriptor invented a capability absent from the engine") }
+}
+
+func invocationFixture() MechanicInvocationTrace {
+	trace:=MechanicInvocationTrace{SchemaVersion:1,Scope:"declared_operation_set",CoveredOperations:[]string{"example.Type.Operation"},ContextSHA256:strings.Repeat("a",64),ConfigSHA256:strings.Repeat("b",64),MemberContentSHA256:strings.Repeat("c",64),Seed:"7",TraceID:"trace/7",Complete:true}
+	one:=MechanicInvocation{ID:"invocation/1",OperationSymbol:"example.Type.Operation",SourceOccurrence:"occurrence/1",CallPath:"callback/1/operation/1",ContextSHA256:trace.ContextSHA256,ConfigSHA256:trace.ConfigSHA256,Seed:trace.Seed,TraceID:trace.TraceID,Order:1,Frame:100,Receiver:MechanicResourceIdentity{Type:"example.Type",Resource:"character",Instance:"actor/2",Lifetime:"iteration/7",Owner:2,OwnerKnown:true},Arguments:[]MechanicArgument{{Type:"float64",Encoding:"float_bits",Bits:64,Value:"0000000000000000"}},CallerOwner:1,CallerKnown:true,Complete:true}
+	two:=one;two.ID="invocation/2";two.Order=2;two.CallPath="callback/1/operation/2"
+	trace.Invocations=[]MechanicInvocation{one,two}
+	return trace
+}
+
+func TestMechanicInvocationJoinRequiresExactCallNotNearestFrame(t *testing.T) {
+	trace:=invocationFixture()
+	expected:=trace.Invocations[1]
+	got,reason,err:=JoinMechanicInvocation(trace,expected)
+	if err!=nil || reason!="" || got==nil || got.ID!="invocation/2" { t.Fatal(got,reason,err) }
+	for _,mutate:=range []func(*MechanicInvocation){
+		func(v *MechanicInvocation){v.ID=""},
+		func(v *MechanicInvocation){v.SourceOccurrence="different/occurrence"},
+		func(v *MechanicInvocation){v.ContextSHA256=strings.Repeat("c",64)},
+		func(v *MechanicInvocation){v.Receiver.Lifetime="another/iteration"},
+		func(v *MechanicInvocation){v.Receiver.Owner=3},
+		func(v *MechanicInvocation){v.CallerOwner=2},
+		func(v *MechanicInvocation){v.Arguments=[]MechanicArgument{{Type:"float64",Encoding:"float_bits",Bits:64,Value:"8000000000000000"}}},
+	} {
+		query:=expected;mutate(&query)
+		if found,reason,err:=JoinMechanicInvocation(trace,query);err!=nil || found!=nil || reason=="" { t.Fatal("ambiguous/mismatched invocation was reused",reason,err) }
+	}
+	trace.Invocations=nil
+	if found,reason,err:=JoinMechanicInvocation(trace,expected);err!=nil || found!=nil || reason!="mechanic_invocation_not_observed" { t.Fatal("absent neutral call became no-op",reason,err) }
+}
+
+func TestMechanicInvocationTruncationIsIncompleteAndDuplicateIdentityInvalid(t *testing.T) {
+	trace:=invocationFixture()
+	expected:=trace.Invocations[0]
+	trace.Truncated=true
+	if found,reason,err:=JoinMechanicInvocation(trace,expected);err!=nil || found!=nil || reason!="mechanic_invocation_trace_incomplete" { t.Fatal(found,reason,err) }
+	trace.Truncated=false;trace.Invocations[1].ID=trace.Invocations[0].ID
+	if _,_,err:=JoinMechanicInvocation(trace,expected);err==nil { t.Fatal("duplicate invocation identity was silently disambiguated") }
+}
+
+func TestMechanicNestedBoundsAndResourceBindingsAreExplicit(t *testing.T) {
+	input,engine:=operationFixture()
+	for _,binding:=range []string{"argument:garbage","argument:-1","argument:4"} {
+		op:=input.Operations[0];op.Reads=[]MechanicResourceEffect{{Resource:"shared",OwnerBinding:binding,Lifetime:"iteration"}}
+		if !op.OpaqueEffects(){t.Fatal("invalid argument binding certified a resource",binding)}
+	}
+	input.Operations[0].Parameters=make([]MechanicParameter,maxMechanicArguments+1)
+	if err:=ValidateMechanicOperations(input,engine);err==nil {t.Fatal("unbounded operation parameters accepted")}
+	trace:=invocationFixture();trace.Invocations[0].Receiver.Resource=""
+	if err:=ValidateMechanicInvocationTrace(trace);err==nil{t.Fatal("receiver without resource kind accepted")}
+	trace=invocationFixture();trace.Invocations[0].Arguments=make([]MechanicArgument,maxMechanicArguments+1)
+	if err:=ValidateMechanicInvocationTrace(trace);err==nil{t.Fatal("unbounded invocation arguments accepted")}
+}
+
+func TestMechanicMalformedTypedArgumentsNeverJoin(t *testing.T) {
+	for _,argument:=range []MechanicArgument{
+		{Type:"int",Encoding:"integer",Bits:64,Signed:true,Value:"01"},
+		{Type:"int8",Encoding:"integer",Bits:8,Signed:true,Value:"128"},
+		{Type:"int",Encoding:"float_bits",Bits:64,Value:"0000000000000000"},
+		{Type:"float64",Encoding:"float_bits",Bits:64,Value:"zzzzzzzzzzzzzzzz"},
+		{Type:"float64",Encoding:"float_bits",Bits:64,Value:"00000000"},
+	} {
+		trace:=invocationFixture();trace.Invocations[0].Arguments=[]MechanicArgument{argument}
+		if _,_,err:=JoinMechanicInvocation(trace,trace.Invocations[0]);err==nil {t.Fatal("matching malformed arguments were accepted",argument)}
+	}
+}
+
+func TestMechanicSourceReadRootsRequireTheActualVerifiedMember(t *testing.T) {
+	trace:=invocationFixture()
+	observation:=MechanicResourceObservation{Identity:trace.Invocations[0].Receiver,Provenance:"source_reads",SourceOccurrence:"occurrence/1",ReadRoots:[]uint32{9},Value:EventValue{Kind:"number",Number:7}}
+	trace.Invocations[0].Before=[]MechanicResourceObservation{observation}
+	expected:=trace.Invocations[0]
+	if found,reason,err:=JoinMechanicInvocation(trace,expected);err!=nil || found!=nil || reason!="mechanic_resource_dependencies_unverified"{t.Fatal(found,reason,err)}
+	member:=IRSeedMember{Seed:7,Nodes:[]IRNode{{NodeID:8}}}
+	if _,_,err:=JoinMechanicInvocationForMember(trace,expected,member,trace.MemberContentSHA256,trace.ContextSHA256,trace.ConfigSHA256);err==nil{t.Fatal("nonempty invented roots were accepted")}
+	member.Nodes[0].NodeID=9
+	joined,reason,err:=JoinMechanicInvocationForMember(trace,expected,member,trace.MemberContentSHA256,trace.ContextSHA256,trace.ConfigSHA256)
+	if err!=nil || joined==nil || reason!=""{t.Fatal(joined,reason,err)}
+	joined.Before[0].ReadRoots[0]=42
+	if trace.Invocations[0].Before[0].ReadRoots[0]!=9{t.Fatal("joined data mutated the source trace")}
+}
diff --git a/internal/contracts/mechanic_validation.go b/internal/contracts/mechanic_validation.go
