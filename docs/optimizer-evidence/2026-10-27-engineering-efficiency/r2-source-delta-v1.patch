+func syntheticRequestInput(t *testing.T) (string, Config, contracts.EngineBinding) {
+	t.Helper()
+	config := Config{Wearers: [4]WearerSpec{
+		{WearerKey: "actor_d", Element: "geo", SetUID: "set_d"},
+		{WearerKey: "actor_a", Element: "anemo", SlotSetUIDs: [5]string{"set_totm", "set_totm", "set_no", "set_no", "set_flex"}},
+		{WearerKey: "actor_c", Element: "hydro", SetUID: "set_c"},
+		{WearerKey: "actor_b", Element: "pyro", SetUID: "set_b"},
+	}}
+	declarationOrder := []string{"actor_d", "actor_b", "actor_a", "actor_c"}
+	var lines []string
+	lines = append(lines, "options swap_delay=12 iteration=7 workers=4 ignore_burst_energy=true;")
+	for _, actor := range declarationOrder {
+		lines = append(lines, actor+" char lvl=90/90 cons=0 talent=9,9,9;")
+		lines = append(lines, actor+" add weapon=\"weapon_"+strings.TrimPrefix(actor, "actor_")+"\" refine=1 lvl=90/90;")
+		var spec WearerSpec
+		for _, candidate := range config.Wearers {
+			if candidate.WearerKey == actor {
+				spec = candidate
+				break
+			}
+		}
+		setUIDs, err := declaredSetUIDs(spec)
+		if err != nil {
+			t.Fatal(err)
+		}
+		counts := map[string]int{}
+		for _, uid := range setUIDs {
+			counts[uid]++
+		}
+		uids := make([]string, 0, len(counts))
+		for uid := range counts {
+			uids = append(uids, uid)
+		}
+		sort.Strings(uids)
+		for _, uid := range uids {
+			count := counts[uid]
+			if count >= 4 {
+				count = 4 // source pre-render rows declare the active bonus tier
+			}
+			lines = append(lines, fmt.Sprintf(`%s add set="%s" count=%d;`, actor, uid, count))
+		}
+		// These provisional rows deliberately contain duplicate main keys and
+		// arithmetic-looking text; preparation must not parse them as artifacts.
+		lines = append(lines, actor+" add stats hp=4780 atk=311 atk%=0.466 atk%=0.466;")
+		lines = append(lines, actor+" add stats def%=0.062*2 atk=311*10 cr=0.1;")
+	}
+	lines = append(lines,
+		"target lvl=100 resist=0.1 radius=2 pos=0,2.4 hp=999999999;",
+		"active actor_d;",
+		"actor_d skill;",
+		"actor_a burst;",
+	)
+	binding := fakeCanonicalEngineBinding(t)
+	return strings.Join(lines, "\n") + "\n", config, binding
+}
+
+func fakeCanonicalEngineBinding(t *testing.T) contracts.EngineBinding {
+	t.Helper()
+	binding := contracts.EngineBinding{
+		BinaryPath:           "C:/synthetic/gcsim.exe",
+		ArtifactSHA256:       strings.Repeat("1", 64),
+		SourceManifestSHA256: strings.Repeat("3", 64),
+		PatchManifestSHA256:  strings.Repeat("4", 64),
+		Capabilities:         []string{"gtt_compact_ir_v1", "gtt_finalist_simulation_v1"},
+	}
+	var err error
+	binding.BindingSHA256, err = contracts.CanonicalSHA256(struct {
+		Kind                 string `json:"kind"`
+		ArtifactSHA256       string `json:"artifact_sha256"`
+		SourceManifestSHA256 string `json:"source_manifest_sha256"`
+		PatchManifestSHA256  string `json:"patch_manifest_sha256"`
+	}{"gtt.standalone_engine_binding.v1", binding.ArtifactSHA256, binding.SourceManifestSHA256, binding.PatchManifestSHA256})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return binding
+}
+
+func wearerKeys(request contracts.OptimizerRequest) []string {
+	keys := make([]string, len(request.Wearers))
+	for i, wearer := range request.Wearers {
+		keys[i] = wearer.WearerKey
+	}
+	return keys
+}
+
+func countLinePrefix(text, prefix string) int {
+	count := 0
+	for _, line := range strings.Split(text, "\n") {
+		if strings.HasPrefix(strings.TrimSuffix(line, "\r"), prefix) {
+			count++
+		}
+	}
+	return count
+}
+
+func lineWithPrefix(text, prefix string) string {
+	for _, line := range strings.Split(text, "\n") {
+		line = strings.TrimSuffix(line, "\r")
+		if strings.HasPrefix(line, prefix) {
+			return line
+		}
+	}
+	return ""
+}
diff --git a/internal/supportimpact/coverage.go b/internal/supportimpact/coverage.go
new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/coverage.go
@@ -0,0 +1,200 @@
+// Package supportimpact records what a captured damage graph can and cannot
+// say about artifact response. It is not a second damage model. In particular,
+// a missing edge is never evidence that a support stat is useless or capped.
+package supportimpact
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+type Coordinate struct {
+	Key        string   `json:"coordinate"`
+	Owner      string   `json:"owner"`
+	Recipients []string `json:"recipients"`
+}
+
+type Gap struct {
+	Seed        uint64   `json:"seed"`
+	BoundaryID  string   `json:"boundary_id"`
+	NodeID      uint32   `json:"node_id"`
+	Reason      string   `json:"reason"`
+	Recipients  []string `json:"recipients"`
+	Attribution string   `json:"attribution"`
+}
+
+// Report contains structural observations, not a response certificate. Legacy
+// captures attach global warnings to disconnected zero nodes; these remain
+// unattributed rather than assigning their repeated share=1 to every wearer.
+type Report struct {
+	Coordinates           []Coordinate `json:"coordinates"`
+	Gaps                  []Gap        `json:"gaps"`
+	GraphScope            string       `json:"graph_scope"`
+	AdditionalUncertainty []string     `json:"additional_uncertainty"`
+}
+
+// KnownForeignCoordinates identifies an observed edge to a different actor.
+// Presence is structural evidence, not completeness of all foreign paths.
+// The returned map is independent of this report and its immutable snapshots.
+func (r Report) KnownForeignCoordinates() map[string]bool {
+	out := make(map[string]bool, len(r.Coordinates))
+	for _, coordinate := range r.Coordinates {
+		for _, recipient := range coordinate.Recipients {
+			if recipient != coordinate.Owner {
+				out[coordinate.Key] = true
+			}
+		}
+	}
+	return out
+}
+
+func (r Report) NeedsResponseCheck() bool {
+	if len(r.Gaps) != 0 || len(r.AdditionalUncertainty) != 0 {
+		return true
+	}
+	for _, coordinate := range r.Coordinates {
+		if len(coordinate.Recipients) == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func (r Report) Clone() Report {
+	out := Report{Coordinates: make([]Coordinate, len(r.Coordinates)), Gaps: make([]Gap, len(r.Gaps)),
+		GraphScope: r.GraphScope, AdditionalUncertainty: append([]string{}, r.AdditionalUncertainty...)}
+	for i, row := range r.Coordinates {
+		out.Coordinates[i] = row
+		out.Coordinates[i].Recipients = append([]string{}, row.Recipients...)
+	}
+	for i, row := range r.Gaps {
+		out.Gaps[i] = row
+		out.Gaps[i].Recipients = append([]string{}, row.Recipients...)
+	}
+	return out
+}
+
+// A changed-set program can add dependencies which are absent from its neutral
+// reference graph. Keep reference observations, but never relabel them as a
+// fresh capture of the new effects or lose the program's extra unknowns.
+func (r Report) ForParametricView(uncertainty []string) Report {
+	out := r.Clone()
+	out.GraphScope = "neutral_reference_only"
+	seen := map[string]bool{}
+	for _, reason := range append(out.AdditionalUncertainty, uncertainty...) {
+		if reason != "" {
+			seen[reason] = true
+		}
+	}
+	out.AdditionalUncertainty = []string{}
+	for reason := range seen {
+		out.AdditionalUncertainty = append(out.AdditionalUncertainty, reason)
+	}
+	sort.Strings(out.AdditionalUncertainty)
+	return out
+}
+
+// Analyze follows actual ancestors, not ResponseCoordinates metadata or the
+// source provider's name. A provider may be reading a different character.
+// It visits each node/edge once per seed; no candidate evaluation is performed.
+func Analyze(actors []string, members []contracts.IRSeedMember) (Report, error) {
+	out := Report{Coordinates: []Coordinate{}, Gaps: []Gap{}, GraphScope: "captured_graph", AdditionalUncertainty: []string{}}
+	if len(actors) != 4 || len(members) == 0 {
+		return out, fmt.Errorf("support coverage requires four actors and a seed panel")
+	}
+	actorIndex := make(map[string]int, len(actors))
+	for i, actor := range actors {
+		if actor == "" || strings.Contains(actor, ".") {
+			return out, fmt.Errorf("invalid support coverage actor")
+		}
+		if _, exists := actorIndex[actor]; exists {
+			return out, fmt.Errorf("duplicate support coverage actor")
+		}
+		actorIndex[actor] = i
+	}
+	coordinateMasks := map[string]uint8{}
+	seenSeeds := map[uint64]bool{}
+	for _, member := range members {
+		if member.Seed == 0 || seenSeeds[member.Seed] {
+			return out, fmt.Errorf("support coverage seeds must be positive and distinct")
+		}
+		seenSeeds[member.Seed] = true
+		consumers := make([]uint8, len(member.Nodes)+1)
+		for i, node := range member.Nodes {
+			if node.NodeID != uint32(i+1) {
+				return out, fmt.Errorf("support coverage requires contiguous graph nodes")
+			}
+			for _, input := range node.Inputs {
+				if input.NodeID == 0 || input.NodeID >= node.NodeID {
+					return out, fmt.Errorf("support coverage graph is not topologically ordered")
+				}
+			}
+		}
+		for _, channel := range member.Channels {
+			actor, exists := actorIndex[channel.ActorKey]
+			if !exists || channel.RootNodeID == 0 || int(channel.RootNodeID) >= len(consumers) {
+				return out, fmt.Errorf("support coverage channel has unknown actor or root")
+			}
+			consumers[channel.RootNodeID] |= 1 << actor
+		}
+		for i := len(member.Nodes) - 1; i >= 0; i-- {
+			node := member.Nodes[i]
+			for _, input := range node.Inputs {
+				consumers[input.NodeID] |= consumers[node.NodeID]
+			}
+			if node.Operation != "artifact_stat" {
+				continue
+			}
+			owner, stat, found := strings.Cut(node.Coordinate, ".")
+			if _, exists := actorIndex[owner]; !found || !exists || stat == "" {
+				return out, fmt.Errorf("support coverage has unbound artifact coordinate %q", node.Coordinate)
+			}
+			// Retain unconsumed input leaves too. Their zero mask says only that
+			// this capture has no path, not that changing them has no real effect.
+			coordinateMasks[node.Coordinate] |= consumers[node.NodeID]
+		}
+		seenBoundaries := map[string]bool{}
+		for _, boundary := range member.OpaqueBoundaries {
+			if boundary.BoundaryID == "" || seenBoundaries[boundary.BoundaryID] || boundary.ReasonCode == "" ||
+				boundary.NodeID == 0 || int(boundary.NodeID) >= len(consumers) ||
+				member.Nodes[boundary.NodeID-1].Operation != "opaque_frozen" {
+				return out, fmt.Errorf("support coverage has invalid opaque boundary")
+			}
+			seenBoundaries[boundary.BoundaryID] = true
+			mask := consumers[boundary.NodeID]
+			attribution := "reachable_damage"
+			if mask == 0 {
+				attribution = "unattributed"
+			}
+			out.Gaps = append(out.Gaps, Gap{Seed: member.Seed, BoundaryID: boundary.BoundaryID,
+				NodeID: boundary.NodeID, Reason: boundary.ReasonCode,
+				Recipients: recipients(actors, mask), Attribution: attribution})
+		}
+	}
+	for key, mask := range coordinateMasks {
+		owner, _, _ := strings.Cut(key, ".")
+		out.Coordinates = append(out.Coordinates, Coordinate{Key: key, Owner: owner, Recipients: recipients(actors, mask)})
+	}
+	sort.Slice(out.Coordinates, func(i, j int) bool { return out.Coordinates[i].Key < out.Coordinates[j].Key })
+	sort.Slice(out.Gaps, func(i, j int) bool {
+		if out.Gaps[i].Seed != out.Gaps[j].Seed {
+			return out.Gaps[i].Seed < out.Gaps[j].Seed
+		}
+		return out.Gaps[i].BoundaryID < out.Gaps[j].BoundaryID
+	})
+	return out, nil
+}
+
+func recipients(actors []string, mask uint8) []string {
+	out := []string{}
+	for i, actor := range actors {
+		if mask&(1<<i) != 0 {
+			out = append(out, actor)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/internal/supportimpact/coverage_test.go b/internal/supportimpact/coverage_test.go
new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/coverage_test.go
@@ -0,0 +1,130 @@
+package supportimpact
+
+import (
+	"reflect"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func coverageFixture() contracts.IRSeedMember {
+	return contracts.IRSeedMember{Seed: 11,
+		Nodes: []contracts.IRNode{
+			{NodeID: 1, Operation: "artifact_stat", Coordinate: "support.atk_percent"},
+			{NodeID: 2, Operation: "artifact_stat", Coordinate: "support.crit_rate"},
+			{NodeID: 3, Operation: "opaque_frozen", Value: "20"},
+			{NodeID: 4, Operation: "add", Inputs: []contracts.IRInput{{NodeID: 1}, {NodeID: 3}}},
+			{NodeID: 5, Operation: "opaque_frozen", Value: "0"},
+			{NodeID: 6, Operation: "artifact_stat", Coordinate: "support.hp_percent"},
+		},
+		Channels: []contracts.IRChannel{
+			{ActorKey: "carry", RootNodeID: 4, ResponseCoordinates: []string{"support.crit_rate"}},
+			{ActorKey: "support", RootNodeID: 2},
+		},
+		OpaqueBoundaries: []contracts.IROpaqueBoundary{
+			{BoundaryID: "a", NodeID: 3, ReasonCode: "unsupported_helper"},
+			{BoundaryID: "b", NodeID: 5, ReasonCode: "global_warning", BaselineDamageShare: "1"},
+		},
+	}
+}
+
+func TestCoverageUsesRealAncestryNotMetadataOrWarningShares(t *testing.T) {
+	r, err := Analyze([]string{"support", "carry", "third", "fourth"}, []contracts.IRSeedMember{coverageFixture()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []Coordinate{
+		{Key: "support.atk_percent", Owner: "support", Recipients: []string{"carry"}},
+		{Key: "support.crit_rate", Owner: "support", Recipients: []string{"support"}},
+		{Key: "support.hp_percent", Owner: "support", Recipients: []string{}},
+	}
+	if !reflect.DeepEqual(r.Coordinates, want) {
+		t.Fatalf("coverage: %#v", r.Coordinates)
+	}
+	if !r.NeedsResponseCheck() || r.Gaps[0].Attribution != "reachable_damage" ||
+		!reflect.DeepEqual(r.Gaps[0].Recipients, []string{"carry"}) ||
+		r.Gaps[1].Attribution != "unattributed" || len(r.Gaps[1].Recipients) != 0 {
+		t.Fatalf("wrong attribution: %#v", r.Gaps)
+	}
+	copy := r.Clone()
+	copy.Coordinates[0].Recipients[0] = "mutated"
+	copy.Gaps[0].Recipients[0] = "mutated"
+	if r.Coordinates[0].Recipients[0] != "carry" || r.Gaps[0].Recipients[0] != "carry" {
+		t.Fatal("mutable snapshot")
+	}
+}
+
+func TestCoverageCombinesSeedsWithoutLosingPerSeedGaps(t *testing.T) {
+	a, b := coverageFixture(), coverageFixture()
+	b.Seed = 12
+	b.Channels[0].ActorKey = "third"
+	r, err := Analyze([]string{"support", "carry", "third", "fourth"}, []contracts.IRSeedMember{b, a})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(r.Coordinates[0].Recipients, []string{"carry", "third"}) || len(r.Gaps) != 4 || r.Gaps[0].Seed != 11 {
+		t.Fatalf("lost seed evidence: %#v", r)
+	}
+}
+
+func TestKnownForeignCoordinatesPreservesObservedEdgeAndMissingFallback(t *testing.T) {
+	r, err := Analyze([]string{"support", "carry", "third", "fourth"}, []contracts.IRSeedMember{coverageFixture()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]bool{"support.atk_percent": true}
+	known := r.KnownForeignCoordinates()
+	if !reflect.DeepEqual(known, want) || known["support.crit_rate"] || known["support.hp_percent"] || known["absent.atk"] {
+		t.Fatal("self/unrepresented coordinate became known foreign ancestry", known)
+	}
+	delete(known, "support.atk_percent")
+	known["support.hp_percent"] = true
+	if !reflect.DeepEqual(r.KnownForeignCoordinates(), want) || !reflect.DeepEqual(r.ForParametricView([]string{"unknown"}).KnownForeignCoordinates(), want) {
+		t.Fatal("foreign-edge map mutated a snapshot or claimed new ancestry")
+	}
+}
+
+func TestParametricViewPreservesUnknownsWithoutClaimingFreshCapture(t *testing.T) {
+	r, err := Analyze([]string{"support", "carry", "third", "fourth"}, []contracts.IRSeedMember{coverageFixture()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := r.ForParametricView([]string{"new_callback_unknown", "new_callback_unknown"})
+	if v.GraphScope != "neutral_reference_only" || len(v.Gaps) != 2 || len(v.AdditionalUncertainty) != 1 || !v.NeedsResponseCheck() {
+		t.Fatalf("lost uncertainty: %#v", v)
+	}
+	v.Coordinates[0].Recipients[0] = "changed"
+	if r.GraphScope != "captured_graph" || len(r.AdditionalUncertainty) != 0 || r.Coordinates[0].Recipients[0] != "carry" {
+		t.Fatal("parametric view mutated reference evidence")
+	}
+}
+
+func TestCoverageRejectsInvalidBindings(t *testing.T) {
+	for name, change := range map[string]func(*contracts.IRSeedMember){
+		"cycle":              func(m *contracts.IRSeedMember) { m.Nodes[3].Inputs[0].NodeID = 4 },
+		"foreign owner":      func(m *contracts.IRSeedMember) { m.Nodes[0].Coordinate = "stranger.atk_percent" },
+		"foreign recipient":  func(m *contracts.IRSeedMember) { m.Channels[0].ActorKey = "stranger" },
+		"unknown root":       func(m *contracts.IRSeedMember) { m.Channels[0].RootNodeID = 90 },
+		"false boundary":     func(m *contracts.IRSeedMember) { m.OpaqueBoundaries[0].NodeID = 1 },
+		"duplicate boundary": func(m *contracts.IRSeedMember) { m.OpaqueBoundaries[1].BoundaryID = "a" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			m := coverageFixture()
+			change(&m)
+			if _, err := Analyze([]string{"support", "carry", "third", "fourth"}, []contracts.IRSeedMember{m}); err == nil {
+				t.Fatal("invalid graph accepted")
+			}
+		})
+	}
+}
+
+func TestOrphanCoordinateTriggersCheckWithoutOpaqueWarning(t *testing.T) {
+	r := Report{Coordinates: []Coordinate{{Key: "support.atk_percent", Owner: "support"}}}
+	if !r.NeedsResponseCheck() {
+		t.Fatal("lost ancestry was mistaken for no useful response")
+	}
+	r.Coordinates[0].Recipients = []string{"carry"}
+	if r.NeedsResponseCheck() {
+		t.Fatal("connected-only graph invented an observed gap")
+	}
+}
diff --git a/internal/supportimpact/directions.go b/internal/supportimpact/directions.go
new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/directions.go
@@ -0,0 +1,201 @@
+package supportimpact
+
+import (
+	"encoding/hex"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+)
+
+// Direction is a local, measured search proposal. It is deliberately not a
+// correction to formula DPS, a verified build, or a certificate of a stat cap.
+// Amount is the exact probe displacement, not an artifact allocation.
+type Direction struct {
+	Binding               engineclient.StatResponseBinding `json:"binding"`
+	Owner                 string                           `json:"owner"`
+	Stat                  string                           `json:"stat"`
+	Amount                float64                          `json:"amount"`
+	MeanDPSChange         float64                          `json:"mean_dps_change"`
+	MinimumDPSChange      float64                          `json:"minimum_dps_change"`
+	MaximumDPSChange      float64                          `json:"maximum_dps_change"`
+	MeanOtherDPSChange    float64                          `json:"mean_other_dps_change"`
+	MinimumOtherDPSChange float64                          `json:"minimum_other_dps_change"`
+	SeedDPSChanges        map[int64]float64                `json:"seed_dps_changes"`
+	Status                string                           `json:"status"`
+	ConfigSHA256          string                           `json:"config_sha256"`
+	ResultSHA256BySeed    map[int64]string                 `json:"result_sha256_by_seed"`
+	SampleCount           int                              `json:"sample_count"`
+}
+
+var responseCanonicalStats = map[string]string{
+	"hp": "hp", "atk": "atk", "def": "def", "hp%": "hp_percent",
+	"atk%": "atk_percent", "def%": "def_percent", "em": "em",
+	"er": "energy_recharge", "cr": "crit_rate", "cd": "crit_damage",
+	"heal": "healing_bonus", "pyro%": "pyro_damage_bonus", "hydro%": "hydro_damage_bonus",
+	"cryo%": "cryo_damage_bonus", "electro%": "electro_damage_bonus", "anemo%": "anemo_damage_bonus",
+	"geo%": "geo_damage_bonus", "dendro%": "dendro_damage_bonus", "phys%": "physical_damage_bonus",
+}
+
+// DirectionsFromResponses preserves the actual observations. A
+// positive response on every sampled seed makes a direction eligible for a
+// legal candidate proposal, not automatically preferable to its opportunity
+// cost. A predeclared all-channel first-seed zero may stop its second call;
+// that one observed zero is labeled screened, never a fabricated paired sample.
+// Mixed, zero and negative observations do not certify no support value/caps.
+func DirectionsFromResponses(actors []string, result engineclient.StatResponseResult) ([]Direction, error) {
+	if len(actors) != 4 || !result.ProposalEvidenceOnly || !result.EngineUnchanged ||
+		result.SkippedCalls < 0 || result.AttemptedCalls+result.SkippedCalls != result.CallLimit ||
+		(!result.ScreeningEnabled && result.SkippedCalls != 0) ||
+		(result.ScreeningEnabled && len(result.Baseline) != 2) ||
+		result.CallLimit <= 0 || result.CallLimit > 128 || len(result.Baseline) < 2 {
+		return nil, fmt.Errorf("directions require a complete bound paired response panel")
+	}
+	binding := result.Binding
+	for _, digest := range []string{binding.AnchorConfigSHA256, binding.RequestSHA256,
+		binding.EngineArtifactSHA256, binding.EngineBindingSHA256, binding.EngineSourceManifestSHA256,
+		binding.EnginePatchManifestSHA256, result.ProbeConfigSHA256} {
+		if !responseDigest(digest) {
+			return nil, fmt.Errorf("response direction requires exact anchor/request/engine/source identities")
+		}
+	}
+	if result.PreparedConfigSHA256 != binding.AnchorConfigSHA256 {
+		return nil, fmt.Errorf("response anchor differs from its prepared config")
+	}
+	owners := map[string]bool{}
+	for _, actor := range actors {
+		if actor == "" || owners[actor] {
+			return nil, fmt.Errorf("directions require distinct actor identities")
+		}
+		owners[actor] = true
+	}
+	baselines := map[int64]engineclient.StatResponseSample{}
+	for _, sample := range result.Baseline {
+		if _, duplicate := baselines[sample.Seed]; duplicate || !validResponseSample(sample) || sample.ConfigSHA256 != result.ProbeConfigSHA256 {
+			return nil, fmt.Errorf("invalid paired baseline")
+		}
+		if err := validateResponseActors(owners, sample.CharacterDPS); err != nil {
+			return nil, err
+		}
+		baselines[sample.Seed] = sample
+	}
+	if result.CallLimit != len(baselines)*(1+len(result.Perturbations)) {
+		return nil, fmt.Errorf("response panel call accounting mismatch")
+	}
+	out := make([]Direction, 0, len(result.Perturbations))
+	screened := 0
+	seen := map[engineclient.StatResponsePerturbation]bool{}
+	for _, row := range result.Perturbations {
+		p := row.Perturbation
+		stat, known := responseCanonicalStats[p.Stat]
+		if result.ScreeningEnabled && p.Delta < 0 {
+			return nil, fmt.Errorf("screened panel requires positive perturbation deltas")
+		}
+		wantSamples := len(baselines)
+		if row.SecondSeedScreened {
+			if !result.ScreeningEnabled || len(result.Baseline) != 2 || p.Delta <= 0 {
+				return nil, fmt.Errorf("invalid first-seed screen declaration")
+			}
+			wantSamples, screened = 1, screened+1
+		}
+		if !owners[p.Actor] || !known || !finiteResponse(p.Delta) || p.Delta == 0 || seen[p] || len(row.Samples) != wantSamples || !responseDigest(row.ConfigSHA256) {
+			return nil, fmt.Errorf("invalid response direction binding")
+		}
+		seen[p] = true
+		d := Direction{Binding: binding, Owner: p.Actor, Stat: stat, Amount: p.Delta, ConfigSHA256: row.ConfigSHA256, SampleCount: len(row.Samples),
+			MinimumDPSChange: math.Inf(1), MaximumDPSChange: math.Inf(-1),
+			MinimumOtherDPSChange: math.Inf(1),
+			SeedDPSChanges:        map[int64]float64{}, ResultSHA256BySeed: map[int64]string{}}
+		for _, sample := range row.Samples {
+			base, exists := baselines[sample.Seed]
+			_, duplicate := d.SeedDPSChanges[sample.Seed]
+			if !exists || duplicate || !validResponseSample(sample) || sample.ConfigSHA256 != row.ConfigSHA256 {
+				return nil, fmt.Errorf("response sample is not bound to its paired baseline/config")
+			}
+			if err := validateResponseActors(owners, sample.CharacterDPS); err != nil {
+				return nil, err
+			}
+			if row.SecondSeedScreened {
+				if sample.Seed != result.Baseline[0].Seed || sample.DPS != base.DPS {
+					return nil, fmt.Errorf("first-seed screen lacks exact zero team response")
+				}
+				for actor := range owners {
+					if sample.CharacterDPS[actor] != base.CharacterDPS[actor] {
+						return nil, fmt.Errorf("first-seed screen hides a nonzero personal or foreign response")
+					}
+				}
+			}
+			// Derive from retained ordinary values rather than trusting a cached
+			// aggregate or labeling the source provider as the damage recipient.
+			delta := sample.DPS - base.DPS
+			d.SeedDPSChanges[sample.Seed] = delta
+			d.ResultSHA256BySeed[sample.Seed] = sample.EngineResultSHA256
+			d.MeanDPSChange += delta / float64(len(row.Samples))
+			d.MinimumDPSChange = math.Min(d.MinimumDPSChange, delta)
+			d.MaximumDPSChange = math.Max(d.MaximumDPSChange, delta)
+			otherDelta := 0.0
+			for actor := range owners {
+				if actor != p.Actor {
+					otherDelta += sample.CharacterDPS[actor] - base.CharacterDPS[actor]
+				}
+			}
+			d.MeanOtherDPSChange += otherDelta / float64(len(row.Samples))
+			d.MinimumOtherDPSChange = math.Min(d.MinimumOtherDPSChange, otherDelta)
+		}
+		d.Status = "inconclusive_local_response"
+		if row.SecondSeedScreened {
+			// One measured zero, not two measurements or proof of an irrelevant
+			// stat/cap. It cannot pass the existing positive-on-every-seed gate.
+			d.Status = "screened_zero_first_seed"
+		} else if d.MinimumDPSChange > 0 {
+			d.Status = "positive_on_sampled_seeds"
+		} else if d.MaximumDPSChange < 0 {
+			d.Status = "negative_on_sampled_seeds"
+		}
+		out = append(out, d)
+	}
+	if screened != result.SkippedCalls {
+		return nil, fmt.Errorf("screened response call accounting mismatch")
+	}
+	// Stable identity order; do not rank stat units or displacements as if
+	// unlike-sized probes had equal artifact costs.
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Owner != out[j].Owner {
+			return out[i].Owner < out[j].Owner
+		}
+		if out[i].Stat != out[j].Stat {
+			return out[i].Stat < out[j].Stat
+		}
+		return out[i].Amount < out[j].Amount
+	})
+	return out, nil
+}
+
+func validateResponseActors(owners map[string]bool, values map[string]float64) error {
+	if len(values) != len(owners) {
+		return fmt.Errorf("per-actor response evidence is unavailable")
+	}
+	for actor, value := range values {
+		if !owners[actor] || !finiteResponse(value) || value < 0 {
+			return fmt.Errorf("invalid per-actor response evidence")
+		}
+	}
+	return nil
+}
+
+func finiteResponse(value float64) bool { return !math.IsNaN(value) && !math.IsInf(value, 0) }
+
+func responseDigest(value string) bool {
+	if len(value) != 64 {
+		return false
+	}
+	_, err := hex.DecodeString(value)
+	return err == nil
+}
+
+func validResponseSample(sample engineclient.StatResponseSample) bool {
+	return sample.Seed > 0 && sample.SampleSeed == strconv.FormatInt(sample.Seed, 10) && sample.Iterations == 1 &&
+		finiteResponse(sample.DPS) && sample.DPS >= 0 && responseDigest(sample.EngineResultSHA256)
+}
