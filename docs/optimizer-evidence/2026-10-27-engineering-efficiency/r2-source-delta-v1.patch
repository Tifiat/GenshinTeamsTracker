+func TestPrepareRequestCollapsesStatsAndPreservesDeclaredContext(t *testing.T) {
+	configText, config, binding := syntheticRequestInput(t)
+	options := contracts.ResultOptions{SetGroupLimit: 1, BuildsPerGroup: 2}
+	prepared, err := PrepareRequest(configText, config, binding, []uint64{101, 202}, options)
