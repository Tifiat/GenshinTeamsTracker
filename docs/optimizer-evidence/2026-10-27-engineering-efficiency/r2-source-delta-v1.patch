+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := memo.bind(context.Background(), index, otherContext, c.Handle, c.Packages, seed, "wrong_handle"); err == nil {
+		t.Fatal("score binding accepted a handle from another context")
+	}
+}
