+	"genshinteamstracker/native/gcsim_optimizer/internal/theorysearch"
+)
+
+type finishDuringFirstResolver struct {
+	searchCtx context.Context
+	marker    string
+	requested bool
+}
+
+func (w *finishDuringFirstResolver) Resolve(context.Context, [4]domain.Package) (*theorysearch.Entry, []string, error) {
+	return &theorysearch.Entry{Family: "fixture-family", Objective: func(alloc.State, bool) (float64, [4][10]float64, error) {
+		if !w.requested {
+			w.requested = true
+			if err := os.WriteFile(w.marker, nil, 0600); err != nil {
+				return 0, [4][10]float64{}, err
+			}
+			searchcontrol.Ready(w.searchCtx)
+		}
+		return 100, [4][10]float64{}, nil
+	}}, nil, nil
+}
+func (w *finishDuringFirstResolver) Fork() (theorysearch.Resolver, error) {
+	return nil, errors.New("unexpected fixture fork")
+}
+func (*finishDuringFirstResolver) Close() {}
+
+func finishDuringFirstConfig() theorysearch.Config {
+	cfg := theorysearch.Config{Binding: "binding", RequestSHA256: "request", SessionID: "session",
+		Wearers: [4]string{"wearer-a", "wearer-b", "wearer-c", "wearer-d"}}
+	mains := [4][5]string{}
+	for a := range cfg.Wearers {
+		mains[a] = [5]string{"hp", "atk", "em", "em", "em"}
+		pkg := domain.Package{Sets: []contracts.SetRequirement{{SetUID: fmt.Sprintf("set-%d", a), Count: 4}}}
+		cfg.Original[a] = pkg
+		cfg.Domains[a] = []domain.Package{pkg}
+	}
+	cfg.Initial = alloc.Seed(mains, [4][10]float64{}, 0, 45)
+	return cfg
+}
+
+func TestHandleTheoryFirstFailureDistinguishesSoftFinishAndFailure(t *testing.T) {
+	t.Run("genuine failure is retained", func(t *testing.T) {
+		root := t.TempDir()
+		firstErr := errors.New("fixture search failure")
+		softFinished, handledErr := handleTheoryFirstFailure(root, context.Background(), firstErr, theorySearchFailureReceipt{})
+		if softFinished || !errors.Is(handledErr, firstErr) {
+			t.Fatalf("genuine failure disposition = (%t, %v)", softFinished, handledErr)
+		}
+		if _, err := os.Stat(filepath.Join(root, "theory-search-failure.json")); err != nil {
+			t.Fatalf("genuine failure sidecar missing: %v", err)
+		}
+	})
+
+	t.Run("cooperative Finish preserves completion", func(t *testing.T) {
+		root := t.TempDir()
+		marker := filepath.Join(root, "finish")
+		searchCtx, stop := searchcontrol.Begin(searchcontrol.WithFile(context.Background(), marker))
+		defer stop()
+		cfg := finishDuringFirstConfig()
+		session, err := theorysearch.New(cfg, &finishDuringFirstResolver{searchCtx: searchCtx, marker: marker})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer session.Close()
+		if _, err = session.First(searchCtx, cfg.Binding); !errors.Is(err, context.Canceled) {
+			t.Fatalf("First() error = %v, want cooperative cancellation", err)
+		}
+		if !searchcontrol.Requested(searchCtx) {
+			t.Fatal("fixture did not request cooperative Finish")
+		}
+		firstErr := context.Canceled
+		softFinished, handledErr := handleTheoryFirstFailure(root, searchCtx, firstErr, theorySearchFailureReceipt{})
+		if !softFinished || handledErr != nil || !theorySoftFinish(searchCtx, firstErr) {
+			t.Fatalf("cooperative Finish disposition = (%t, %v)", softFinished, handledErr)
+		}
+		if !searchcontrol.Requested(searchCtx) {
+			t.Fatal("cooperative Finish request was consumed by failure handling")
+		}
+		if _, err = os.Stat(filepath.Join(root, "theory-search-failure.json")); !os.IsNotExist(err) {
+			t.Fatalf("cooperative Finish emitted a failure sidecar: %v", err)
+		}
+		if _, err = session.Finish(); err != nil {
+			t.Fatalf("cooperative Finish could not publish retained work: %v", err)
+		}
+	})
+
+	t.Run("emergency cancellation remains a retained error", func(t *testing.T) {
+		root := t.TempDir()
+		outer, cancel := context.WithCancel(context.Background())
+		cancel()
+		searchCtx, stop := searchcontrol.Begin(outer)
+		defer stop()
+		softFinished, handledErr := handleTheoryFirstFailure(root, searchCtx, context.Canceled, theorySearchFailureReceipt{})
+		if softFinished || !errors.Is(handledErr, context.Canceled) || theorySoftFinish(searchCtx, context.Canceled) {
+			t.Fatalf("emergency cancellation disposition = (%t, %v)", softFinished, handledErr)
+		}
+		if _, err := os.Stat(filepath.Join(root, "theory-search-failure.json")); err != nil {
+			t.Fatalf("emergency cancellation sidecar missing: %v", err)
+		}
+	})
+}
+
+func TestTheorySearchFailureSidecarIsFailureOnlyAndExclusive(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "theory-search-failure.json")
+	receipt := theorySearchFailureReceipt{
+		SchemaVersion:            1,
+		SchemaKind:               "gtt_gcsim_optimizer_theory_search_failure_envelope_v1",
+		SearchFailure:            theorysearch.FailureDiagnostic{SchemaVersion: theorysearch.FailureDiagnosticSchemaVersion, SchemaKind: theorysearch.FailureDiagnosticSchemaKind, Error: "fixture failure"},
+		ExpectedEngine:           contracts.EngineBinding{ArtifactSHA256: "engine-artifact", BindingSHA256: "engine-binding", SourceManifestSHA256: "engine-source", PatchManifestSHA256: "engine-patch"},
+		ExpectedCatalogSHA256:    "catalog",
+		ExpectedSourceTextSHA256: "source-text",
+		SourceBindingStatus:      "not_rechecked_after_search_failure",
+	}
+	if err := retainTheorySearchFailureOnError(root, nil, receipt); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("successful/no-error path created a failure sidecar: %v", err)
+	}
+	firstErr := errors.New("fixture failure")
+	if err := retainTheorySearchFailureOnError(root, firstErr, receipt); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got theorySearchFailureReceipt
+	if err = json.Unmarshal(before, &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.SchemaKind != receipt.SchemaKind || got.SearchFailure.Error != "fixture failure" ||
+		got.ExpectedEngine.ArtifactSHA256 != "engine-artifact" || got.ExpectedCatalogSHA256 != "catalog" ||
+		got.ExpectedSourceTextSHA256 != "source-text" || got.SourceBindingStatus != "not_rechecked_after_search_failure" {
+		t.Fatalf("sidecar identity mismatch: %+v", got)
+	}
+	if err = retainTheorySearchFailureOnError(root, errors.New("second failure"), receipt); err == nil {
+		t.Fatal("existing failure sidecar was overwritten")
+	}
+	after, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(after, before) {
+		t.Fatal("exclusive sidecar collision changed saved bytes")
+	}
+}
