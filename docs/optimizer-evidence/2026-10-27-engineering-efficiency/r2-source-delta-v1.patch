+func TestNeutralBoundScoreMemoCancelFiniteAndBoundedRetention(t *testing.T) {
+	index, c, report := neutralCheckedBoundReport(t)
+	seed := report.Step.Finalists[0].Assignment
+	memo := newNeutralBoundScoreMemo(2)
+	for _, row := range report.Step.Finalists[:3] {
+		one := report
+		one.Step.Finalists = []search.ScoredAssignment{row}
+		if err := memo.rememberCheckedReport(context.Background(), index, c, one); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(memo.entries) != 2 || len(memo.order) != 2 {
+		t.Fatal("checked-score retention exceeded entry bound", len(memo.entries), len(memo.order))
+	}
+	if _, err := memo.bind(context.Background(), index, c.Context, c.Handle, c.Packages, seed, "evicted"); err != nil || memo.hits != 0 || memo.evaluations != 1 {
+		t.Fatal("oldest checked score was not evicted", memo.hits, memo.evaluations, err)
+	}
+	newest := report.Step.Finalists[2].Assignment
+	if _, err := memo.bind(context.Background(), index, c.Context, c.Handle, c.Packages, newest, "retained"); err != nil || memo.hits != 1 || memo.evaluations != 1 {
+		t.Fatal("newest checked score was not retained", memo.hits, memo.evaluations, err)
+	}
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := memo.bind(canceled, index, c.Context, c.Handle, c.Packages, newest, "cancel"); !errors.Is(err, context.Canceled) || memo.hits != 1 || memo.evaluations != 1 {
+		t.Fatal("checked score bypassed cancellation", memo.hits, memo.evaluations, err)
+	}
+	empty := newNeutralBoundScoreMemo(2)
+	if err := empty.rememberCheckedReport(canceled, index, c, report); err != nil || len(empty.entries) != 0 {
+		t.Fatal("canceled search populated score reuse", err)
+	}
+	for _, value := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		bad := cloneNeutralCandidateReport(report)
+		bad.Step.Finalists[0].DPS = value
+		if err := empty.rememberCheckedReport(context.Background(), index, c, bad); err == nil || len(empty.entries) != 0 {
+			t.Fatal("nonfinite checked score was retained", value, err)
+		}
+		empty.entries[neutralBoundScoreIdentity(index, c.Context, c.Handle, seed)] = value
+		if _, err := empty.bind(context.Background(), index, c.Context, c.Handle, c.Packages, seed, "invalid_score"); err == nil || empty.hits != 0 {
+			t.Fatal("nonfinite cached score was accepted", value, err)
+		}
+		clear(empty.entries)
+	}
+	if err := empty.rememberCheckedReport(context.Background(), index, c, report); err != nil {
+		t.Fatal(err)
+	}
+	conflict := cloneNeutralCandidateReport(report)
+	conflict.Step.Finalists[0].DPS = math.Nextafter(conflict.Step.Finalists[0].DPS, math.Inf(1))
+	if err := empty.rememberCheckedReport(context.Background(), index, c, conflict); err == nil {
+		t.Fatal("same bound identity accepted a different full-panel score")
+	}
+}
