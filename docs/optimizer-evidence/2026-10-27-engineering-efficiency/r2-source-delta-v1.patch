@@ -0,0 +1,27 @@
+package theoryalloc
+
+import (
+	"fmt"
+	"math"
+)
+
+// ValidateFull45 checks the publication witness used by the pinned team search:
+// twenty mandatory initial rolls and twenty-five upgrades for every actor.
+// State.Validate retains its upper-bound semantics for the allocation solver.
+func ValidateFull45(state State) error {
+	if err := state.Validate(45, true); err != nil {
+		return err
+	}
+	for actor, upgrades := range state.Upgrades {
+		sum := 0.0
+		for _, slot := range upgrades {
+			for _, x := range slot {
+				sum += x
+			}
+		}
+		if math.Abs(sum-25) > 1e-7 {
+			return fmt.Errorf("actor %d has %g upgrades; full45 requires 25", actor, sum)
+		}
+	}
+	return nil
+}
diff --git a/internal/theoryalloc/rules.go b/internal/theoryalloc/rules.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/rules.go
@@ -0,0 +1,34 @@
+package theoryalloc
+
+import "math"
+
+// StatKeys returns substat keys in the objective gradient's coordinate order.
+func StatKeys() [10]string { return statKeys }
+
+// StatValues returns the maximum roll values corresponding to StatKeys.
+func StatValues() [10]float64 { return statValues }
+
+// MainValues returns an independent copy of the idealized main-stat values.
+func MainValues() map[string]float64 {
+	out := make(map[string]float64, len(mainValues))
+	for key, value := range mainValues {
+		out[key] = value
+	}
+	return out
+}
+
+// MainChoices returns independent main choices for flower, plume, sands,
+// goblet, and circlet, respectively.
+func MainChoices() [5][]string {
+	var out [5][]string
+	for slot, choices := range mainChoices {
+		out[slot] = append([]string(nil), choices...)
+	}
+	return out
+}
+
+// This comparison is the only dependency extracted from the research
+// marginal.go file. Its threshold is retained exactly.
+func quarterBetter(value, incumbent float64) bool {
+	return value > incumbent+1e-12*(1+math.Abs(incumbent))
+}
diff --git a/internal/theoryalloc/slot_lines.go b/internal/theoryalloc/slot_lines.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/slot_lines.go
@@ -0,0 +1,139 @@
+package theoryalloc
+
+import "fmt"
+
+// SlotLineConfig bounds the fixed-main, one-line-at-a-time search. Zero
+// Passes defaults to two; zero InnerIterations defaults to four upgrade steps.
+type SlotLineConfig struct {
+	Passes          int
+	InnerIterations int
+}
+
+type SlotLineResult struct {
+	State         State
+	Value         float64
+	Evaluations   int
+	OptimizeCalls int
+	Candidates    int
+	Accepted      int
+	Passes        int
+	Stop          string
+}
+
+// SlotLines searches one legal line replacement per actor/slot at a time.
+// Each candidate is scored after bounded upgrade optimization, without a
+// frozen-gradient or immediate-score cutoff. The slot winner becomes the next
+// slot's anchor. This finite neighborhood is a heuristic, not a global or
+// physical roll-tier certificate.
+func SlotLines(obj Objective, start State, cfg Config, search SlotLineConfig) (SlotLineResult, error) {
+	var out SlotLineResult
+	if obj == nil {
+		return out, fmt.Errorf("nil objective")
+	}
+	var err error
+	cfg, err = normalizedConfig(cfg)
+	if err != nil {
+		return out, err
+	}
+	if err := start.Validate(cfg.Budget, true); err != nil {
+		return out, err
+	}
+	if search.Passes < 0 || search.Passes > 2 || search.InnerIterations < 0 {
+		return out, fmt.Errorf("slot-line search allows at most two passes and nonnegative iterations")
+	}
+	if search.Passes == 0 {
+		search.Passes = 2
+	}
+	if search.InnerIterations == 0 {
+		search.InnerIterations = 4
+	}
+	inner := cfg
+	inner.MaxIterations = search.InnerIterations
+	inner.Polish = false
+	counted := func(state State, needGradient bool) (float64, [4][10]float64, error) {
+		out.Evaluations++
+		return obj(state, needGradient)
+	}
+	initial, _, err := counted(start, false)
+	if err != nil {
+		return out, err
+	}
+	if !finite(initial) {
+		return out, fmt.Errorf("non-finite initial objective")
+	}
+	out.State, out.Value = start, initial
+	run := func(state State, local Config) (Result, error) {
+		out.OptimizeCalls++
+		return Optimize(counted, state, local)
+	}
+	first, err := run(start, inner)
+	if err != nil {
+		out.Stop = "objective_error"
+		return out, err
+	}
+	if quarterBetter(first.Value, out.Value) {
+		out.State, out.Value = first.State, first.Value
+	}
+	stable := false
+	for pass := 0; pass < search.Passes; pass++ {
+		out.Passes++
+		changed := false
+		for actor := range out.State.Lines {
+			for slot := range out.State.Lines[actor] {
+				anchor := out.State
+				bestState, bestValue := anchor, out.Value
+				present := [10]bool{}
+				for _, stat := range anchor.Lines[actor][slot] {
+					present[stat] = true
+				}
+				for line := range anchor.Lines[actor][slot] {
+					for stat := range statKeys {
+						if present[stat] || statKeys[stat] == anchor.Mains[actor][slot] {
+							continue
+						}
+						candidate := anchor
+						candidate.Lines[actor][slot][line] = stat
+						out.Candidates++
+						result, runErr := run(candidate, inner)
+						if runErr != nil {
+							out.Stop = "objective_error"
+							return out, runErr
+						}
+						if quarterBetter(result.Value, bestValue) {
+							bestState, bestValue = result.State, result.Value
+						}
+					}
+				}
+				if quarterBetter(bestValue, out.Value) {
+					out.State, out.Value = bestState, bestValue
+					out.Accepted++
+					changed = true
+				}
+			}
+		}
+		if !changed {
+			stable = true
+			break
+		}
+	}
+	finalCfg := cfg
+	finalCfg.Polish = true
+	final, err := run(out.State, finalCfg)
+	if err != nil {
+		out.Stop = "objective_error"
+		return out, err
+	}
+	if quarterBetter(final.Value, out.Value) {
+		out.State, out.Value = final.State, final.Value
+	}
+	if err := out.State.Validate(cfg.Budget, true); err != nil {
+		out.Stop = "invalid_final_state"
+		return out, err
+	}
+	if stable {
+		out.Stop = "slot_stable"
+	} else {
+		out.Stop = "pass_cap"
+	}
+	return out, nil
+}
diff --git a/internal/theorypackages/catalog.go b/internal/theorypackages/catalog.go
new file mode 100644
--- /dev/null
+++ b/internal/theorypackages/catalog.go
@@ -0,0 +1,50 @@
+// Package theorypackages owns Theory's ordered catalog and tuple identities.
+// It contains no allocation/search implementation or gameplay rules.
+package theorypackages
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+// Packages enumerates all declared virtual packages, including the independent
+// zero-bonus alternative. A source's unresolved mechanics are not a filter.
+// This is the unchanged catalog policy extracted from the retained Theory draft.
+func Packages(catalog []domain.SetCapability) ([]domain.Package, error) {
+	seen := map[string]bool{}
+	out := []domain.Package{{}}
+	var pairs []string
+	for _, s := range catalog {
+		if s.UID == "" || seen[s.UID] || (!s.TwoPiece && s.FourPiece) {
+			return nil, fmt.Errorf("invalid theory catalog")
+		}
+		seen[s.UID] = true
+		if s.TwoPiece {
+			pairs = append(pairs, s.UID)
+			out = append(out, domain.Package{Sets: []contracts.SetRequirement{{SetUID: s.UID, Count: 2}}})
+		}
+		if s.FourPiece {
+			out = append(out, domain.Package{Sets: []contracts.SetRequirement{{SetUID: s.UID, Count: 4}}})
+		}
+	}
+	sort.Strings(pairs)
+	for i, a := range pairs {
+		for _, b := range pairs[i+1:] {
+			out = append(out, domain.Package{Sets: []contracts.SetRequirement{{SetUID: a, Count: 2}, {SetUID: b, Count: 2}}})
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Key() < out[j].Key() })
+	return out, nil
+}
+
+func Key(p [4]domain.Package) string {
+	keys := make([]string, 4)
+	for i := range p {
+		keys[i] = p[i].Key()
+	}
+	return strings.Join(keys, "|")
+}
diff --git a/internal/theorypackages/catalog_test.go b/internal/theorypackages/catalog_test.go
new file mode 100644
--- /dev/null
+++ b/internal/theorypackages/catalog_test.go
@@ -0,0 +1,54 @@
+package theorypackages
+
+import (
+	"reflect"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+func TestCatalogRetainsEveryDeclaredBonusAndStableTupleOrder(t *testing.T) {
+	rows, err := Packages([]domain.SetCapability{{UID: "b", TwoPiece: true}, {UID: "a", TwoPiece: true, FourPiece: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var keys []string
+	for _, p := range rows {
+		keys = append(keys, p.Key())
+	}
+	want := []string{"a:2", "a:2+b:2", "a:4", "b:2", "none"}
+	if !reflect.DeepEqual(keys, want) {
+		t.Fatalf("lost/reordered declared package: got %v want %v", keys, want)
+	}
+	changed, err := Packages([]domain.SetCapability{{UID: "a", TwoPiece: true, FourPiece: true}, {UID: "b", TwoPiece: true}})
+	if err != nil || !reflect.DeepEqual(rows, changed) {
+		t.Fatal("catalog input order changed declared package order")
+	}
+	tuple := [4]domain.Package{rows[4], rows[2], rows[3], rows[1]}
+	if got := Key(tuple); got != "none|a:4|b:2|a:2+b:2" {
+		t.Fatalf("tuple wearer order or package identity changed: %s", got)
+	}
+	tuple[1], tuple[2] = tuple[2], tuple[1]
+	if Key(tuple) == "none|a:4|b:2|a:2+b:2" {
+		t.Fatal("distinct ownership collapsed into an alias key")
+	}
+}
+
+func TestCatalogRejectsInvalidCapabilitiesAndOwnsReturnedSets(t *testing.T) {
+	for _, invalid := range [][]domain.SetCapability{
+		{{UID: ""}}, {{UID: "a", FourPiece: true}}, {{UID: "a"}, {UID: "a", TwoPiece: true}},
+	} {
+		if _, err := Packages(invalid); err == nil {
+			t.Fatal("invalid catalog accepted")
+		}
+	}
+	rows, err := Packages([]domain.SetCapability{{UID: "a", TwoPiece: true, FourPiece: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	rows[0].Sets[0] = contracts.SetRequirement{SetUID: "caller-mutation", Count: 4}
+	if rows[1].Sets[0].SetUID != "a" {
+		t.Fatal("returned package rows share mutable set slices")
+	}
+}
diff --git a/internal/theorysearch/failure.go b/internal/theorysearch/failure.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/failure.go
@@ -0,0 +1,92 @@
+package theorysearch
+
+import (
+	"sort"
+	"strings"
+)
+
+const (
+	FailureDiagnosticSchemaKind    = "gtt_gcsim_optimizer_theory_search_failure_v1"
+	FailureDiagnosticSchemaVersion = 1
+	failureUnavailableLimit        = 64
+)
+
+// FailureDiagnostic is a bounded, read-only snapshot of a failed search. It
+// intentionally excludes scored candidates, allocations, and recommendations.
+type FailureDiagnostic struct {
+	SchemaVersion      int           `json:"schema_version"`
+	SchemaKind         string        `json:"schema_kind"`
+	SessionID          string        `json:"session_id"`
+	RequestSHA256      string        `json:"request_sha256"`
+	BindingSHA256      string        `json:"binding_sha256"`
+	Phase              string        `json:"phase"`
+	Error              string        `json:"error"`
+	ActiveWork         Work          `json:"active_branch_work"`
+	Unavailable        []Unavailable `json:"unavailable"`
+	UnavailableTotal   int           `json:"unavailable_total"`
+	UnavailableOmitted int           `json:"unavailable_omitted"`
+	VisitedTupleCount  int           `json:"visited_tuple_count"`
+	ResolvedAliasCount int           `json:"resolved_alias_count"`
+}
+
+// FailureDiagnostics returns a bounded deep copy of the current branch's
+// failure evidence. It remains usable after abort closes the resolver.
+func (s *Session) FailureDiagnostics(err error) FailureDiagnostic {
+	out := FailureDiagnostic{
+		SchemaVersion: FailureDiagnosticSchemaVersion,
+		SchemaKind:    FailureDiagnosticSchemaKind,
+		Phase:         "initial",
+		Unavailable:   []Unavailable{},
+	}
+	if err != nil {
+		out.Error = err.Error()
+	}
+	if s == nil {
+		return out
+	}
+	out.SessionID = s.cfg.SessionID
+	out.RequestSHA256 = s.cfg.RequestSHA256
+	out.BindingSHA256 = s.cfg.Binding
+	if s.phase != "" {
+		out.Phase = s.phase
+	}
+	if s.active == nil {
+		return out
+	}
+	out.ActiveWork = s.active.work
+	out.VisitedTupleCount = len(s.active.visited)
+	for _, rows := range s.active.aliases {
+		out.ResolvedAliasCount += len(rows)
+	}
+
+	rows := make([]Unavailable, 0, len(s.active.unavailable))
+	for _, row := range s.active.unavailable {
+		row = cloneUnavailable(row)
+		sort.Strings(row.Reasons)
+		sort.Slice(row.Packages, func(i, j int) bool {
+			return row.Packages[i].WearerKey < row.Packages[j].WearerKey
+		})
+		for i := range row.Packages {
+			sort.Slice(row.Packages[i].Sets, func(a, b int) bool {
+				if row.Packages[i].Sets[a].SetUID != row.Packages[i].Sets[b].SetUID {
+					return row.Packages[i].Sets[a].SetUID < row.Packages[i].Sets[b].SetUID
+				}
+				return row.Packages[i].Sets[a].Count < row.Packages[i].Sets[b].Count
+			})
+		}
+		rows = append(rows, row)
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].TupleKey != rows[j].TupleKey {
+			return rows[i].TupleKey < rows[j].TupleKey
+		}
+		return strings.Join(rows[i].Reasons, "\x00") < strings.Join(rows[j].Reasons, "\x00")
+	})
+	out.UnavailableTotal = len(rows)
+	if len(rows) > failureUnavailableLimit {
+		out.UnavailableOmitted = len(rows) - failureUnavailableLimit
+		rows = rows[:failureUnavailableLimit]
+	}
+	out.Unavailable = rows
+	return out
+}
diff --git a/internal/theorysearch/focusedfailure_test.go b/internal/theorysearch/focusedfailure_test.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/focusedfailure_test.go
@@ -0,0 +1,118 @@
+package theorysearch
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+type failureNilResolver struct{ closed bool }
+
+func (w *failureNilResolver) Resolve(context.Context, [4]domain.Package) (*Entry, []string, error) {
+	return nil, nil, nil
+}
+func (w *failureNilResolver) Fork() (Resolver, error) { return &failureNilResolver{}, nil }
+func (w *failureNilResolver) Close()                  { w.closed = true }
+
+func TestFailureDiagnosticsRetainsNoErrorUnavailableAfterClose(t *testing.T) {
+	cfg, _ := sessionFixtureConfig(t, [4]int{1, 1, 1, 1})
+	w := &failureNilResolver{}
+	s, err := New(cfg, w)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.First(context.Background(), cfg.Binding); !errors.Is(err, ErrNoResult) {
+		t.Fatalf("First() error = %v, want ErrNoResult", err)
+	}
+	if !w.closed {
+		t.Fatal("failed First did not close the resolver")
+	}
+
+	first := s.FailureDiagnostics(err)
+	if first.SchemaVersion != FailureDiagnosticSchemaVersion || first.SchemaKind != FailureDiagnosticSchemaKind ||
+		first.SessionID != cfg.SessionID || first.RequestSHA256 != cfg.RequestSHA256 || first.BindingSHA256 != cfg.Binding ||
+		first.Phase != "initial" || first.Error != ErrNoResult.Error() {
+		t.Fatalf("failure identity mismatch: %+v", first)
+	}
+	if first.UnavailableTotal != 1 || first.UnavailableOmitted != 0 || len(first.Unavailable) != 1 ||
+		first.Unavailable[0].Reasons[0] != "source_resolution_unavailable" {
+		t.Fatalf("nil/no-error resolution was not retained: %+v", first)
+	}
+	if first.VisitedTupleCount != 1 || first.ResolvedAliasCount != 0 || first.ActiveWork.AliasHits != 8 {
+		t.Fatalf("failure counters mismatch: %+v", first)
+	}
+
+	first.Unavailable[0].Reasons[0] = "mutated"
+	first.Unavailable[0].Packages[0].Sets[0].SetUID = "mutated"
+	first.ActiveWork.AliasHits = -1
+	again := s.FailureDiagnostics(err)
+	if again.Unavailable[0].Reasons[0] != "source_resolution_unavailable" ||
+		again.Unavailable[0].Packages[0].Sets[0].SetUID == "mutated" || again.ActiveWork.AliasHits != 8 {
+		t.Fatalf("diagnostic was not an immutable deep copy: %+v", again)
+	}
+	encoded, err := json.Marshal(again)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]json.RawMessage
+	if err = json.Unmarshal(encoded, &fields); err != nil {
+		t.Fatal(err)
+	}
+	for _, forbidden := range []string{"co_leaders", "formula_dps", "recommendation", "witness45", "score"} {
+		if _, present := fields[forbidden]; present {
+			t.Fatalf("failure diagnostic contains result field %q", forbidden)
+		}
+	}
+}
+
+func TestFailureDiagnosticsSortsAndBoundsUnavailableRows(t *testing.T) {
+	cfg, spec := sessionFixtureConfig(t, [4]int{1, 1, 1, 1})
+	w, _ := newSessionFixtureWorld(spec)
+	s, err := New(cfg, w)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	for i := 69; i >= 0; i-- {
+		key := fmt.Sprintf("tuple-%03d", i)
+		s.active.unavailable[key] = Unavailable{
+			TupleKey: key,
+			Packages: []PackageRow{
+				{WearerKey: "z-wearer", Sets: []contracts.SetRequirement{{SetUID: "z-set", Count: 2}, {SetUID: "a-set", Count: 4}}},
+				{WearerKey: "a-wearer", Sets: []contracts.SetRequirement{{SetUID: "b-set", Count: 1}}},
+			},
+			Reasons: []string{"z-reason", "a-reason"},
+		}
+	}
+	s.active.visited["visited-a"] = ""
+	s.active.visited["visited-b"] = "family"
+	s.active.aliases["family"] = map[string]Alias{"alias-a": {TupleKey: "alias-a"}, "alias-b": {TupleKey: "alias-b"}}
+	s.active.work = Work{Formula: 2, AliasHits: 5}
+
+	diagnostic := s.FailureDiagnostics(errors.New("fixture failure"))
+	if diagnostic.UnavailableTotal != 70 || diagnostic.UnavailableOmitted != 6 || len(diagnostic.Unavailable) != failureUnavailableLimit {
+		t.Fatalf("unexpected unavailable bounds: total=%d omitted=%d rows=%d", diagnostic.UnavailableTotal, diagnostic.UnavailableOmitted, len(diagnostic.Unavailable))
+	}
+	if diagnostic.Unavailable[0].TupleKey != "tuple-000" || diagnostic.Unavailable[len(diagnostic.Unavailable)-1].TupleKey != "tuple-063" {
+		t.Fatalf("unavailable rows are not sorted and bounded: %q .. %q", diagnostic.Unavailable[0].TupleKey, diagnostic.Unavailable[len(diagnostic.Unavailable)-1].TupleKey)
+	}
+	row := diagnostic.Unavailable[0]
+	if row.Reasons[0] != "a-reason" || row.Packages[0].WearerKey != "a-wearer" || row.Packages[1].Sets[0].SetUID != "a-set" {
+		t.Fatalf("nested diagnostic data is not sorted: %+v", row)
+	}
+	if diagnostic.VisitedTupleCount != 2 || diagnostic.ResolvedAliasCount != 2 || diagnostic.ActiveWork.Formula != 2 || diagnostic.ActiveWork.AliasHits != 5 {
+		t.Fatalf("counts/work not retained: %+v", diagnostic)
+	}
+
+	diagnostic.Unavailable[0].Reasons[0] = "mutated"
+	diagnostic.Unavailable[0].Packages[0].Sets[0].SetUID = "mutated"
+	again := s.FailureDiagnostics(errors.New("fixture failure"))
+	if again.Unavailable[0].Reasons[0] != "a-reason" || again.Unavailable[0].Packages[0].Sets[0].SetUID != "b-set" {
+		t.Fatalf("returned rows alias session-owned data: %+v", again.Unavailable[0])
+	}
+}
diff --git a/internal/theorysearch/formula_world.go b/internal/theorysearch/formula_world.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/formula_world.go
@@ -0,0 +1,372 @@
+package theorysearch
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/formula"
+	"genshinteamstracker/native/gcsim_optimizer/internal/mechanicpolicy"
+	"genshinteamstracker/native/gcsim_optimizer/internal/setcontext"
+	"genshinteamstracker/native/gcsim_optimizer/internal/supportimpact"
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theorypackages"
+)
+
+type formulaEntry struct {
+	program  *formula.ArtifactProgram
+	coverage supportimpact.Report
+	coords   []string
+	at       map[string]int
+	baseline []float64
+	indices  [4][10]int
+}
+type targetEntry struct {
+	family    string
+	context   string
+	codes     []string
+	failure   mechanicpolicy.Failure
+	mechanics []contracts.MechanicBoundary
+}
+
+type InvalidMechanicOperationError struct {
+	Boundaries []contracts.BoundMechanicBoundary
+}
+
+func (e *InvalidMechanicOperationError) Error() string {
+	return "Theory source invocation violates its bound engine operation signature"
+}
+
+func invalidMechanicOperation(bound []contracts.MechanicBoundary, contextKey string) error {
+	for _, boundary := range bound {
+		if boundary.Kind == contracts.MechanicInvalidOperation {
+			return &InvalidMechanicOperationError{Boundaries: []contracts.BoundMechanicBoundary{{ContextSHA256: contextKey, Boundary: boundary}}}
+		}
+	}
+	return nil
+}
+
+// MechanicResolution separates a source-model boundary from a failed engine
+// capture or invalid Theory input. FormulaWorld has no post-preparation capture
+// allowance; resolving this status never launches an extra engine call.
+type MechanicResolution struct {
+	Entry                  *Entry
+	Boundary               *mechanicpolicy.ModelUnavailableError
+	Boundaries             []contracts.BoundMechanicBoundary
+	CaptureBudgetRemaining int
+}
+
+func (w *FormulaWorld) ResolveMechanics(ctx context.Context, p [4]domain.Package) (MechanicResolution, error) {
+	entry, codes, err := w.Resolve(ctx, p)
+	if err != nil {
+		return MechanicResolution{}, err
+	}
+	if entry != nil {
+		return MechanicResolution{Entry: entry, Boundaries: w.mechanicBoundariesFor(theorypackages.Key(p))}, nil
+	}
+	kind := w.targets[theorypackages.Key(p)].failure
+	if kind == "" {
+		kind = mechanicpolicy.ModelUnavailable
+	}
+	return MechanicResolution{Boundary: mechanicpolicy.NewModelUnavailable(kind, codes), Boundaries: w.mechanicBoundariesFor(theorypackages.Key(p))}, nil
+}
+
+func (w *FormulaWorld) mechanicBoundariesFor(tuple string) []contracts.BoundMechanicBoundary {
+	known := w.targets[tuple]
+	out := make([]contracts.BoundMechanicBoundary, 0, len(known.mechanics))
+	for _, boundary := range known.mechanics {
+		out = append(out, contracts.BoundMechanicBoundary{ContextSHA256: known.context, Boundary: boundary})
+	}
+	return out
+}
+
+// CollectMechanicBoundaries reports only actually bound source failures. It is
+// read before Session.Finish closes the world; returned records own their data.
+func (w *FormulaWorld) CollectMechanicBoundaries() []contracts.BoundMechanicBoundary {
+	if w == nil {
+		return nil
+	}
+	if w.closed {
+		return append([]contracts.BoundMechanicBoundary(nil), w.closedBoundaries...)
+	}
+	out := []contracts.BoundMechanicBoundary{}
+	for _, tuple := range w.targetOrder {
+		for _, row := range w.mechanicBoundariesFor(tuple) {
+			if len(out) >= 1024 {
+				return out
+			}
+			out = append(out, row)
+		}
+	}
+	return out
+}
+
+// FormulaWorld binds only ordinary source-checked neutral views. Unsupported
+// source behavior remains unavailable; there is no schedule recapture path.
+type FormulaWorld struct {
+	req              contracts.OptimizerRequest
+	base             *setcontext.Context
+	model            *setcontext.NeutralModel
+	binding          string
+	entries          map[string]*formulaEntry
+	order            []string
+	targets          map[string]targetEntry
+	targetOrder      []string
+	closedBoundaries []contracts.BoundMechanicBoundary
+	closed           bool
+}
+
+func NewFormulaWorld(req contracts.OptimizerRequest, base *setcontext.Context, model *setcontext.NeutralModel, binding string) (*FormulaWorld, error) {
+	if base == nil || model == nil || binding == "" {
+		return nil, fmt.Errorf("missing Theory neutral universe")
+	}
+	if err := req.ValidateTheory(); err != nil {
+		return nil, err
+	}
+	raw, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	var owned contracts.OptimizerRequest
+	if err = json.Unmarshal(raw, &owned); err != nil {
+		return nil, err
+	}
+	return &FormulaWorld{req: owned, base: base, model: model, binding: binding, entries: map[string]*formulaEntry{}, targets: map[string]targetEntry{}}, nil
+}
+func (w *FormulaWorld) entry(family, context string, codes []string) *Entry {
+	e := w.entries[family]
+	if e == nil {
+		return nil
+	}
+	return &Entry{Family: family, ContextSHA256: context, Uncertainty: append([]string(nil), codes...), Objective: w.objective(e)}
+}
+func (w *FormulaWorld) remember(key string, v targetEntry) {
+	if _, ok := w.targets[key]; !ok {
+		if len(w.targetOrder) >= 4096 {
+			delete(w.targets, w.targetOrder[0])
+			w.targetOrder = w.targetOrder[1:]
+		}
+		w.targetOrder = append(w.targetOrder, key)
+	}
+	v.codes = append([]string(nil), v.codes...)
+	v.mechanics = append([]contracts.MechanicBoundary(nil), v.mechanics...)
+	w.targets[key] = v
+}
+func (w *FormulaWorld) Resolve(ctx context.Context, p [4]domain.Package) (*Entry, []string, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	if w.closed {
+		return nil, nil, fmt.Errorf("Theory world closed")
+	}
+	tuple := theorypackages.Key(p)
+	if known, ok := w.targets[tuple]; ok {
+		if known.family == "" {
+			return nil, append([]string(nil), known.codes...), nil
+		}
+		if e := w.entry(known.family, known.context, known.codes); e != nil {
+			return e, nil, nil
+		}
+	}
+	changes := map[string][]setcontext.Set{}
+	for a, wearer := range w.req.Wearers {
+		changes[wearer.WearerKey] = nil
+		for _, s := range p[a].Sets {
+			changes[wearer.WearerKey] = append(changes[wearer.WearerKey], setcontext.Set{UID: s.SetUID, Count: s.Count})
+		}
+	}
+	target, err := w.base.Replace(changes)
+	if err != nil {
+		return nil, nil, err
+	}
+	resolved, err := w.model.ResolveMechanics(target)
+	if err != nil {
+		return nil, nil, err
+	}
+	if resolved.Handle == nil {
+		codes := resolved.Boundaries
+		bound := append([]contracts.MechanicBoundary(nil), resolved.MechanicBoundaries...)
+		if invalid := invalidMechanicOperation(bound, target.Key()); invalid != nil {
+			return nil, nil, invalid
+		}
+		w.remember(tuple, targetEntry{codes: codes, context: target.Key(), mechanics: bound, failure: mechanicpolicy.ModelUnavailable})
+		return nil, append([]string(nil), codes...), nil
+	}
+	h, key, codes, err := w.model.TheoryFamily(target)
+	if err != nil {
+		return nil, nil, err
+	}
+	if h == nil {
+		return nil, nil, fmt.Errorf("Theory mechanic resolution changed within one source frame")
+	}
+	panel, err := h.SearchPanel()
+	if err != nil {
+		return nil, nil, err
+	}
+	codes = append(append([]string(nil), codes...), panel.OpaqueReasons()...)
+	coords := panel.Coordinates()
+	// The immutable session binding includes the canonical request/anchor,
+	// seeds and allocator domain. Thus equal arithmetic and coordinates also
+	// have equal baselines; aliases reuse specialization before rebuilding it.
+	frame, err := contracts.CanonicalSHA256(map[string]any{"coordinates": coords, "session_binding": w.binding})
+	if err != nil {
+		return nil, nil, err
+	}
+	// Preserve the research policy's arithmetic-key tie order in the warm bank
+	// while disambiguating every allocator/input frame.
+	family := key + ":" + frame
+	if w.entries[family] != nil {
+		w.remember(tuple, targetEntry{family: family, context: h.ContextKey(), codes: codes})
+		return w.entry(family, h.ContextKey(), codes), nil, nil
+	}
+	index, err := domain.BuildTheory(w.req, coords)
+	if err != nil {
+		return nil, nil, err
+	}
+	baseline, err := index.AssignmentStats(index.Incumbent)
+	if err != nil {
+		return nil, nil, err
+	}
+	dense := make([]float64, len(coords))
+	at := map[string]int{}
+	for i, k := range coords {
+		at[k] = i
+	}
+	var indices [4][10]int
+	statKeys := alloc.StatKeys()
+	for a, wearer := range w.req.Wearers {
+		for k, v := range baseline[a] {
+			if i, ok := at[wearer.WearerKey+"."+k]; ok {
+				dense[i] -= v
+			}
+		}
+		for j, k := range statKeys {
+			indices[a][j] = -1
+			if i, ok := at[wearer.WearerKey+"."+k]; ok {
+				indices[a][j] = i
+			}
+		}
+	}
+	if w.entries[family] == nil {
+		delta, err := index.DenseDeltas(index.Incumbent)
+		if err != nil {
+			return nil, nil, err
+		}
+		program, err := panel.ArtifactProgramForActors(delta, 0, 1, 2, 3)
+		if err != nil {
+			return nil, nil, err
+		}
+		if strings.Join(coords, "\x00") != strings.Join(program.Coordinates(), "\x00") {
+			return nil, nil, fmt.Errorf("Theory coordinate ordering changed")
+		}
+		if len(w.order) >= 768 {
+			delete(w.entries, w.order[0])
+			w.order = w.order[1:]
+		}
+		w.entries[family] = &formulaEntry{program: program, coverage: panel.SupportCoverage(), coords: coords, at: at, baseline: dense, indices: indices}
+		w.order = append(w.order, family)
+	}
+	w.remember(tuple, targetEntry{family: family, context: h.ContextKey(), codes: codes})
+	return w.entry(family, h.ContextKey(), codes), nil, nil
+}
+
+// SupportCoverage resolves only the existing immutable universe. Callers use
+// a fork owned by the response lane, so its caches and work cannot enter search.
+func (w *FormulaWorld) SupportCoverage(ctx context.Context, packages [4]domain.Package) (supportimpact.Report, error) {
+	entry, reasons, err := w.Resolve(ctx, packages)
+	if err != nil {
+		return supportimpact.Report{}, err
+	}
+	if entry == nil {
+		return supportimpact.Report{}, fmt.Errorf("Theory support coverage unavailable: %v", reasons)
+	}
+	compiled := w.entries[entry.Family]
+	if compiled == nil {
+		return supportimpact.Report{}, fmt.Errorf("Theory support coverage lost its bound family")
+	}
+	return compiled.coverage.ForParametricView(entry.Uncertainty), nil
+}
+
+func (w *FormulaWorld) objective(e *formulaEntry) alloc.Objective {
+	mainValues, statValues := alloc.MainValues(), alloc.StatValues()
+	return func(s alloc.State, want bool) (float64, [4][10]float64, error) {
+		var g [4][10]float64
+		if w.closed {
+			return 0, g, fmt.Errorf("Theory world closed")
+		}
+		dense := append([]float64(nil), e.baseline...)
+		rolls := s.Rolls()
+		for a, wearer := range w.req.Wearers {
+			for _, main := range s.Mains[a] {
+				if i, ok := e.at[wearer.WearerKey+"."+main]; ok {
+					dense[i] += mainValues[main]
+				}
+			}
+			for j, u := range rolls[a] {
+				if i := e.indices[a][j]; i >= 0 {
+					dense[i] += u * statValues[j]
+				}
+			}
+		}
+		if !want {
+			v, err := e.program.Evaluate(dense)
+			return v, g, err
+		}
+		v, gradient, _, err := e.program.ValueGradient(dense)
+		if err != nil {
+			return v, g, err
+		}
+		for a := range g {
+			for j := range g[a] {
+				if i := e.indices[a][j]; i >= 0 {
+					g[a][j] = gradient[i] * statValues[j]
+				}
+			}
+		}
+		return v, g, nil
+	}
+}
+func (w *FormulaWorld) Fork() (Resolver, error) {
+	if w == nil || w.closed {
+		return nil, fmt.Errorf("cannot fork closed Theory world")
+	}
+	n := *w
+	n.model = w.model.ForkTheory()
+	n.entries = copyMap(w.entries)
+	for k, e := range n.entries {
+		c := *e
+		c.program = e.program.ForkTheory()
+		c.coverage = e.coverage.Clone()
+		c.coords = append([]string(nil), e.coords...)
+		c.baseline = append([]float64(nil), e.baseline...)
+		c.at = copyMap(e.at)
+		n.entries[k] = &c
+	}
+	n.order = append([]string(nil), w.order...)
+	n.targets = copyMap(w.targets)
+	for k, v := range n.targets {
+		v.codes = append([]string(nil), v.codes...)
+		v.mechanics = append([]contracts.MechanicBoundary(nil), v.mechanics...)
+		n.targets[k] = v
+	}
+	n.targetOrder = append([]string(nil), w.targetOrder...)
+	n.closedBoundaries = nil
+	return &n, nil
+}
+func (w *FormulaWorld) Close() {
+	if w == nil || w.closed {
+		return
+	}
+	w.closedBoundaries = w.CollectMechanicBoundaries()
+	w.closed = true
+	w.entries = nil
+	w.targets = nil
+	w.order = nil
+	w.targetOrder = nil
+	w.base = nil
+	w.model = nil
+	w.req = contracts.OptimizerRequest{}
+}
