+func TestRuleBoundHostClaimsOnlyExactElementString(t *testing.T) {
+	v := testRule(t, `import a "github.com/genshinsim/gcsim/pkg/core/attributes"
+func Start(e a.Element, other a.AnotherEnum) []string {
+ return []string{e.String(), other.String(), other.QueueLabel()}
+}`, map[string][]byte{"pkg/core/attributes/element.go": []byte(dispatchElementSource)})
+	v.program.repository = dispatchRepository(t)
+	h := &ruleReplayHost{elementLabels: map[int]string{1: "host-element"}}
+	h.vm, v.host = v, h
+	v.readOnly = true
+	got, err := v.entry("Start", ruleTypedNumber{1, gcsimImport + "pkg/core/attributes.Element"},
+		ruleTypedNumber{2, gcsimImport + "pkg/core/attributes.AnotherEnum"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	values := ruleArray(got)
+	if len(values) != 3 || values[0] != "host-element" || values[1] != "source-enum" || values[2] != "source-queue" {
+		t.Fatalf("host ownership leaked to another source method: %#v", values)
+	}
+	// The same source method remains subject to the shared-global boundary if
+	// no replay host owns its exact receiver and signature.
+	v = testRule(t, `import a "github.com/genshinsim/gcsim/pkg/core/attributes"
+func Start(e a.Element) string { return e.String() }`,
+		map[string][]byte{"pkg/core/attributes/element.go": []byte(dispatchElementSource)})
+	v.program.repository = dispatchRepository(t)
+	if _, err := v.entry("Start", ruleTypedNumber{1, gcsimImport + "pkg/core/attributes.Element"}); err == nil || !strings.Contains(err.Error(), "engine-owned observation") {
+		t.Fatalf("unowned source global read escaped its boundary: %v", err)
+	}
+}
+
+type dispatchCountingHost struct {
+	resolves int
+	calls    int
+	unknown  bool
+	handled  bool
+}
+
+func (h *dispatchCountingHost) field(any, string) (any, bool) { return nil, false }
+func (h *dispatchCountingHost) resolveBoundSourceMethod(receiver any, name string, signature *ast.FuncType, _ *ruleEnv) (ruleNative, bool) {
+	h.resolves++
+	number, ok := receiver.(ruleTypedNumber)
+	if !ok || number.typ != gcsimImport+"pkg/counter.Number" || name != "Add" || signature == nil ||
+		signature.Params == nil || len(signature.Params.List) != 1 || signature.Results == nil || len(signature.Results.List) != 1 {
+		return ruleNative{}, false
+	}
+	param, paramOK := signature.Params.List[0].Type.(*ast.Ident)
+	result, resultOK := signature.Results.List[0].Type.(*ast.Ident)
+	if !paramOK || !resultOK || param.Name != "int" || result.Name != "int" {
+		return ruleNative{}, false
+	}
+	return ruleNative{receiver: receiver, name: name}, true
+}
+func (h *dispatchCountingHost) call(receiver any, name string, args []any) (any, bool) {
+	h.calls++
+	if !h.handled {
+		return nil, false
+	}
+	if h.unknown {
+		return ruleUnknown{"owned host value unavailable"}, true
+	}
+	return receiver.(ruleTypedNumber).value + ruleNumber(args[0]), true
+}
+
+const dispatchCountingSource = `package counter
+type Number int
+func (n Number) Add(x int) int { return 900 }
+`
+
+func dispatchCountingVM(t *testing.T, host *dispatchCountingHost) *ruleVM {
+	t.Helper()
+	v := testRule(t, `import c "github.com/genshinsim/gcsim/pkg/counter"
+func Start(x c.Number) []any {
+ visits := 0
+ choose := func() c.Number { visits++; return x }
+ arg := func() int { visits++; return 4 }
+ method := choose().Add
+ result := method(arg())
+ return []any{result, visits}
+}`, map[string][]byte{"pkg/counter/number.go": []byte(dispatchCountingSource)})
+	v.host = host
+	return v
+}
+
+func TestRuleBoundHostMethodValueAndArgumentEvaluateOnce(t *testing.T) {
+	h := &dispatchCountingHost{handled: true}
+	v := dispatchCountingVM(t, h)
+	got, err := v.entry("Start", ruleTypedNumber{3, gcsimImport + "pkg/counter.Number"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	values := ruleArray(got)
+	if len(values) != 2 || values[0] != float64(7) || values[1] != float64(2) || h.calls != 1 || h.resolves != 1 {
+		t.Fatalf("method value or arguments evaluated more than once: values=%#v calls=%d resolves=%d", values, h.calls, h.resolves)
+	}
+}
+
+func TestRuleBoundHostUnknownAndUnhandledStayBoundaries(t *testing.T) {
+	for _, host := range []*dispatchCountingHost{{handled: true, unknown: true}, {handled: false}} {
+		v := dispatchCountingVM(t, host)
+		_, err := v.entry("Start", ruleTypedNumber{3, gcsimImport + "pkg/counter.Number"})
+		if err == nil || host.calls != 1 {
+			t.Fatalf("owned host fell through to successful source method: %v calls=%d", err, host.calls)
+		}
+		if host.unknown && !strings.Contains(err.Error(), "owned host value unavailable") {
+			t.Fatalf("host unknown was not retained: %v", err)
+		}
+	}
+}
+
+func TestRuleBoundHostStillRequiresObservedInitialization(t *testing.T) {
+	v := testRule(t, `import a "github.com/genshinsim/gcsim/pkg/core/attributes"
+func Start(e a.Element) string { return e.String() }`, map[string][]byte{
+		"pkg/core/attributes/element.go": []byte(dispatchElementSource + `
+var Initialized int
+func init() { Initialized = 1 }
+`),
+	})
+	h := &ruleReplayHost{elementLabels: map[int]string{1: "host-element"}}
+	h.vm, v.host = v, h
+	if _, err := v.entry("Start", ruleTypedNumber{1, gcsimImport + "pkg/core/attributes.Element"}); err == nil || !strings.Contains(err.Error(), "engine-owned") {
+		t.Fatalf("host dispatch bypassed source init guard: %v", err)
+	}
+}
diff --git a/internal/seteffects/rule_boundary.go b/internal/seteffects/rule_boundary.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_boundary.go
@@ -0,0 +1,198 @@
+package seteffects
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"runtime"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+type ruleBoundaryError struct{ boundary contracts.MechanicBoundary }
+
+func (e ruleBoundaryError) Error() string { return e.boundary.Reason }
+
+func ruleFailKind(kind contracts.MechanicBoundaryKind, reason string) {
+	panic(ruleAbort{boundary: contracts.MechanicBoundary{Kind: kind, Reason: reason,
+		ReasonCode: diagnosticReasonCode(kind, reason), ConsumerSite: diagnosticConsumerSite()}})
+}
+
+func diagnosticConsumerSite() string {
+	var pcs [8]uintptr
+	frames := runtime.CallersFrames(pcs[:runtime.Callers(2, pcs[:])])
+	for {
+		frame, more := frames.Next()
+		if !strings.HasSuffix(frame.Function, ".ruleFail") && !strings.HasSuffix(frame.Function, ".ruleFailKind") {
+			site := fmt.Sprintf("%s:%d", filepath.Base(frame.File), frame.Line)
+			if contracts.ValidMechanicConsumerSite(site) {
+				return site
+			}
+		}
+		if !more {
+			return ""
+		}
+	}
+}
+
+// diagnosticReasonCode recognizes fixed compiler wording only. This is not
+// consulted by evaluation, routing, pruning, or cache eligibility. Unknown or
+// externally supplied errors receive one non-invented fallback category.
+func diagnosticReasonCode(kind contracts.MechanicBoundaryKind, reason string) contracts.MechanicReasonCode {
+	switch kind {
+	case contracts.MechanicAnalysisBudget:
+		return contracts.MechanicReasonAnalysisBudget
+	case contracts.MechanicScheduleChange:
+		return contracts.MechanicReasonDynamicSchedule
+	case contracts.MechanicInvalidOperation:
+		return contracts.MechanicReasonInvalidOperation
+	case contracts.MechanicUnknownOperation:
+		if strings.HasPrefix(reason, "shared package global requires engine-owned observation:") {
+			return contracts.MechanicReasonSharedGlobalState
+		}
+		return contracts.MechanicReasonUnknownOperation
+	}
+	for _, prefix := range []string{
+		"shared package global requires engine-owned observation:",
+		"append through shared package storage requires engine-owned state",
+		"mutation through shared package object requires engine-owned state",
+		"clear of unowned source storage",
+	} {
+		if strings.HasPrefix(reason, prefix) {
+			return contracts.MechanicReasonSharedGlobalState
+		}
+	}
+	for _, prefix := range []string{
+		"stat-dependent branch", "symbolic branch", "symbolic source control",
+		"source condition is not known",
+		"unmergeable source binding", "control in if initialization",
+		"unsupported labeled/fallthrough source control", "unhandled source loop control",
+	} {
+		if strings.HasPrefix(reason, prefix) {
+			return contracts.MechanicReasonSymbolicControlFlow
+		}
+	}
+	for _, prefix := range []string{
+		"division requires retained source numeric types", "unsupported source numeric operation",
+		"nonfinite source arithmetic", "source array is not known", "source number is not known",
+		"source integer outside supported range", "numeric interface implementation is unavailable",
+		"stat-dependent source operation is not modeled",
+	} {
+		if strings.HasPrefix(reason, prefix) {
+			return contracts.MechanicReasonUnsupportedArithmetic
+		}
+	}
+	for _, prefix := range []string{
+		"unsupported source conversion", "source conversion arity",
+		"rule type assertion failed", "unsupported make type", "unsupported map key",
+		"unsupported source equality", "incompatible source reference equality",
+		"incompatible source pointer equality", "unsupported source dereference",
+		"unsupported source address target", "unsupported addressed source local",
+		"unsupported local type declaration", "type assertion",
+	} {
+		if strings.HasPrefix(reason, prefix) {
+			return contracts.MechanicReasonUnsupportedType
+		}
+	}
+	if strings.HasPrefix(reason, "source dependency linking:") || strings.HasPrefix(reason, "source dependency module absent:") {
+		return contracts.MechanicReasonDependencyLink
+	}
+	for _, prefix := range []string{
+		"source map iteration", "map iteration orders callbacks",
+	} {
+		if strings.HasPrefix(reason, prefix) {
+			return contracts.MechanicReasonMapIteration
+		}
+	}
+	for _, prefix := range []string{
+		"neutral resource facts are unobserved:", "neutral resource fact is absent:",
+		"unobserved position", "resource character identity absent",
+		"event flat damage has no observed hit identity",
+		"event flat damage has no retained formula port",
+	} {
+		if strings.HasPrefix(reason, prefix) {
+			return contracts.MechanicReasonUnobservedRuntimeFact
+		}
+	}
+	if strings.HasPrefix(reason, "source call depth exhausted") || strings.HasPrefix(reason, "source dependency node budget exhausted") {
+		return contracts.MechanicReasonAnalysisBudget
+	}
+	return contracts.MechanicReasonUnclassifiedUnsupported
+}
+
+// Propagate an inner source failure without flattening its semantic category.
+func ruleRethrow(err error) {
+	var failure ruleBoundaryError
+	if errors.As(err, &failure) {
+		panic(ruleAbort{boundary: failure.boundary})
+	}
+	ruleFail(err.Error())
+}
+
+func (v *ruleVM) unknownOperation(receiver any, name string, args []any) {
+	if boundary, ok := v.operationFailure(receiver, name, args); ok {
+		if !contracts.ValidMechanicReasonCode(boundary.ReasonCode) {
+			boundary.ReasonCode = diagnosticReasonCode(boundary.Kind, boundary.Reason)
+		}
+		panic(ruleAbort{boundary: boundary})
+	}
+	b := contracts.MechanicBoundary{Kind: contracts.MechanicUnknownOperation,
+		Reason: fmt.Sprintf("unsupported source API: %v.%s", receiver, name), Operation: name,
+		ReasonCode: contracts.MechanicReasonUnknownOperation}
+	if ref, ok := receiver.(ruleRef); ok {
+		b.Receiver, b.Owner, b.OwnerKnown = ref.kind, ref.index, ref.kind == "char"
+		if b.OwnerKnown {
+			b.OwnerRole = "receiver"
+		}
+	}
+	panic(ruleAbort{boundary: b})
+}
+
+func (h *ruleReplayHost) scheduleBoundary(operation, reason string, owner int, ownerKnown bool) {
+	panic(ruleAbort{boundary: contracts.MechanicBoundary{Kind: contracts.MechanicScheduleChange,
+		Operation: operation, Reason: reason, ReasonCode: contracts.MechanicReasonDynamicSchedule, Owner: owner, OwnerKnown: ownerKnown,
+		OwnerRole:   "resource",
+		MechanicUID: h.choice.Key,
+		CallerOwner: h.choice.Owner, CallerKnown: true,
+		Frame: h.frame, Order: h.order}})
+}
+
+func (h *ruleReplayHost) observedFailure(err error) contracts.MechanicBoundary {
+	b := contracts.MechanicBoundary{Kind: contracts.MechanicUnsupportedSource, Reason: err.Error(),
+		ReasonCode: diagnosticReasonCode(contracts.MechanicUnsupportedSource, err.Error())}
+	var failure ruleBoundaryError
+	if errors.As(err, &failure) {
+		b = failure.boundary
+	}
+	if !contracts.ValidMechanicReasonCode(b.ReasonCode) {
+		b.ReasonCode = diagnosticReasonCode(b.Kind, b.Reason)
+	}
+	return h.bindFailureOrigin(b)
+}
+
+// A nested modifier query restores the ambient caller before its error reaches
+// the outer replay loop. Bind the source origin while that modifier is active,
+// and retain an already-bound inner origin across further queries/rethrows.
+func (h *ruleReplayHost) bindFailureOrigin(b contracts.MechanicBoundary) contracts.MechanicBoundary {
+	if b.MechanicUID == "" {
+		b.MechanicUID = h.choice.Key
+	}
+	if !b.CallerKnown {
+		b.CallerOwner, b.CallerKnown = h.choice.Owner, true
+		b.Frame, b.Order = h.frame, h.order
+	}
+	return b
+}
+
+func (h *ruleReplayHost) restoreQueryContext(vm *ruleVM, choice RuleChoice) {
+	failure := recover()
+	if abort, ok := failure.(ruleAbort); ok {
+		abort.boundary = h.bindFailureOrigin(abort.boundary)
+		failure = abort
+	}
+	h.vm, h.choice = vm, choice
+	if failure != nil {
+		panic(failure)
+	}
+}
