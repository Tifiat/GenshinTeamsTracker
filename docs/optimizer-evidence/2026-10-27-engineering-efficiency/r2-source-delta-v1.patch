+package search
+
+// Bounded damped discrete walk layered on candidateRun. It
+// reuses the exact package linear proposal and explores only proper blends
+// between that proposal and the current assignment when the full jump fails.
+import (
+	"context"
+	"fmt"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+const researchDampedRelinearizeMaxRounds = 5
+
+type ResearchDampedWalkCost struct {
+	Rounds               int `json:"rounds"`
+	LinearSelections     int `json:"linear_selections"`
+	LinearPoints         int `json:"linear_points"`
+	MaskTrials           int `json:"mask_trials"`
+	MaskDuplicateSkips   int `json:"mask_duplicate_skips"`
+	MaskIllegalSkips     int `json:"mask_illegal_skips"`
+	MaskBudgetSkips      int `json:"mask_budget_skips"`
+	MaskPointCalls       int `json:"mask_point_calls"`
+	MaskFullScoreCalls   int `json:"mask_full_score_calls"`
+	LinearBudgetSkips    int `json:"linear_budget_skips"`
+	LinearFullScoreCalls int `json:"linear_full_score_calls"`
+	AcceptedBlends       int `json:"accepted_blends"`
+	AcceptedLinear       int `json:"accepted_linear_points"`
+	StopNoGain           int `json:"stop_no_gain"`
+	StopRoundCap         int `json:"stop_round_cap"`
+	ExpandedPoints       int `json:"expanded_points"`
+}
+
+type ResearchDampedMaskTrial struct {
+	Mask       uint8    `json:"mask"`
+	Status     string   `json:"status"`
+	ReducedDPS *float64 `json:"reduced_dps,omitempty"`
+	FullDPS    *float64 `json:"full_dps,omitempty"`
+	Selected   bool     `json:"selected,omitempty"`
+}
+
+type ResearchDampedRound struct {
+	Round              int                       `json:"round"`
+	AnchorAssignment   domain.Assignment         `json:"anchor_assignment"`
+	LinearAssignment   domain.Assignment         `json:"linear_assignment"`
+	DifferingSlots     []int                     `json:"differing_slots"`
+	LinearStatus       string                    `json:"linear_status"`
+	LinearReducedDPS   *float64                  `json:"linear_reduced_dps,omitempty"`
+	LinearFullDPS      *float64                  `json:"linear_full_dps,omitempty"`
+	MaskTrials         []ResearchDampedMaskTrial `json:"mask_trials"`
+	SelectedMask       *uint8                    `json:"selected_mask,omitempty"`
+	AcceptedAssignment *domain.Assignment        `json:"accepted_assignment,omitempty"`
+	AcceptedFullDPS    *float64                  `json:"accepted_full_dps,omitempty"`
+	Outcome            string                    `json:"outcome"`
+}
+
+type DampedRelinearizeResult struct {
+	Incumbent            ScoredAssignment       `json:"incumbent"`
+	FullCheckedIncumbent ScoredAssignment       `json:"full_checked_incumbent"`
+	AnchorReducedDPS     float64                `json:"anchor_reduced_dps"`
+	AnchorFullCheckedDPS float64                `json:"anchor_full_checked_dps"`
+	AcceptedFullScores   []float64              `json:"accepted_full_scores"`
+	Rounds               int                    `json:"rounds"`
+	AcceptedMoves        int                    `json:"accepted_moves"`
+	ZeroGradientRounds   int                    `json:"zero_gradient_rounds"`
+	Stop                 string                 `json:"stop"`
+	Report               CandidateReport        `json:"report"`
+	WalkCost             ResearchDampedWalkCost `json:"damped_walk_cost"`
+	Trace                []ResearchDampedRound  `json:"damped_trace"`
+}
+
+func researchDampedFloat(value float64) *float64 { return &value }
+
+func researchDampedInt(value uint8) *uint8 { return &value }
+
+func researchDampedChangedSlots(old, next [5]int64) []int {
+	var slots []int
+	for slot := range old {
+		if old[slot] != next[slot] {
+			slots = append(slots, slot)
+		}
+	}
+	return slots
+}
+
+func researchDampedBlend(old, next [5]int64, slots []int, mask uint8) [5]int64 {
+	result := old
+	for bit, slot := range slots {
+		if mask&(1<<bit) != 0 {
+			result[slot] = next[slot]
+		}
+	}
+	return result
+}
+
+func researchDampedStrictlyBetter(challenger, incumbent float64) bool {
+	return challenger > incumbent
+}
+
+func researchDampedFullAssignment(anchor domain.Assignment, actor int, ids [5]int64) (domain.Assignment, error) {
+	if actor < 0 || actor >= len(anchor) {
+		return domain.Assignment{}, fmt.Errorf("damped relinearization actor out of range")
+	}
+	trial := anchor
+	trial[actor] = ids
+	return trial, nil
+}
+
+// DampedRelinearizeCandidates keeps one candidateRun for the entire
+// walk. Each round scores the full package-linear jump first. Only a failed
+// strict full-score jump admits proper old/new-slot blends, in deterministic
+// ascending slot-mask order. Every promoted assignment has a strict exact
+// full-score increase over the preceding incumbent.
+func (engine *Engine) DampedRelinearizeCandidates(
+	ctx context.Context,
+	anchor domain.Assignment,
+	actor int,
+	allowance int,
+) (DampedRelinearizeResult, error) {
+
+	result := DampedRelinearizeResult{Stop: "not_started"}
+	if ctx == nil {
+		return result, fmt.Errorf("damped relinearization requires a live context")
+	}
+	if err := ctx.Err(); err != nil {
+		result.Stop = "context_canceled"
+		return result, err
+	}
+	r, err := engine.candidateRun(ctx, anchor, actor, allowance)
+	if err != nil {
+		result.Stop = "candidate_run_error"
+		return result, err
+	}
+	incumbent := r.best
+	anchorFullDPS, err := researchRelinearizeFullScore(r, anchor)
+	if err != nil {
+		result.Stop = "anchor_full_score_error"
+		return result, err
+	}
+	fullIncumbent := ScoredAssignment{Assignment: anchor, DPS: anchorFullDPS, Source: "anchor_full_score"}
+	result.AnchorFullCheckedDPS = anchorFullDPS
+	result.FullCheckedIncumbent = fullIncumbent
+	fullScoreByActorIDs := map[[5]int64]float64{anchor[actor]: anchorFullDPS}
+	reducedScoreByActorIDs := map[[5]int64]float64{anchor[actor]: r.best.DPS}
+	r.seen[anchor[actor]] = true
+
+	for round := 0; round < researchDampedRelinearizeMaxRounds; round++ {
+		if err := ctx.Err(); err != nil {
+			result.Stop = "context_canceled"
+			return researchDampedFinish(result, r, incumbent, err)
+		}
+		if r.report.Step.Expanded >= allowance {
+			result.Stop = "expanded_cap"
+			break
+		}
+		result.Rounds++
+		result.WalkCost.Rounds++
+		trace := ResearchDampedRound{Round: round + 1, AnchorAssignment: fullIncumbent.Assignment, Outcome: "pending"}
+		weights, priorityErr := r.priorities(fullIncumbent.Assignment[actor])
+		if priorityErr != nil {
+			result.Stop = "gradient_error"
+			return researchDampedFinish(result, r, incumbent, priorityErr)
+		}
+		if researchRelinearizeZeroGradient(weights) {
+			result.ZeroGradientRounds++
+		}
+		linearIDs, found, linearErr := r.linear(weights)
+		if linearErr != nil {
+			result.Stop = "linear_assignment_error"
+			return researchDampedFinish(result, r, incumbent, linearErr)
+		}
+		if !found {
+			result.Stop = "no_legal_linear_assignment"
+			trace.LinearStatus, trace.Outcome = "unavailable", "no_legal_linear_assignment"
+			result.Trace = append(result.Trace, trace)
+			break
+		}
+		result.WalkCost.LinearSelections++
+		trace.LinearAssignment, err = researchDampedFullAssignment(fullIncumbent.Assignment, actor, linearIDs)
+		if err != nil {
+			result.Stop = "trial_assignment_error"
+			return researchDampedFinish(result, r, incumbent, err)
+		}
+		trace.DifferingSlots = researchDampedChangedSlots(fullIncumbent.Assignment[actor], linearIDs)
+		trace.MaskTrials = make([]ResearchDampedMaskTrial, 0, 30)
+
+		linearReduced := 0.0
+		linearFull := 0.0
+		linearFullOK := false
+		if cached, seen := fullScoreByActorIDs[linearIDs]; seen {
+			trace.LinearStatus = "duplicate_cached"
+			if reduced, ok := reducedScoreByActorIDs[linearIDs]; ok {
+				linearReduced = reduced
+				trace.LinearReducedDPS = researchDampedFloat(reduced)
+			}
+			linearFull, linearFullOK = cached, true
+			trace.LinearFullDPS = researchDampedFloat(cached)
+		} else if r.report.Step.Expanded >= allowance {
+			trace.LinearStatus = "budget"
+			result.WalkCost.LinearBudgetSkips++
+		} else {
+			beforeExpanded := r.report.Step.Expanded
+			result.WalkCost.LinearPoints++
+			if pointErr := r.point(linearIDs, false, false); pointErr != nil {
+				trace.LinearStatus, trace.Outcome = "point_error", "point_error"
+				result.Trace = append(result.Trace, trace)
+				result.Stop = "linear_point_error"
+				return researchDampedFinish(result, r, incumbent, pointErr)
+			}
+			if r.report.Step.Expanded == beforeExpanded {
+				trace.LinearStatus = "not_scored"
+			} else {
+				candidate := r.lastPoint
+				if candidate.Assignment != trace.LinearAssignment {
+					trace.LinearStatus, trace.Outcome = "actor_mismatch", "actor_mismatch"
+					result.Trace = append(result.Trace, trace)
+					result.Stop = "cross_actor_assignment_mismatch"
+					return researchDampedFinish(result, r, incumbent, fmt.Errorf("damped linear point changed a fixed actor"))
+				}
+				trace.LinearStatus = "scored"
+				linearReduced = candidate.DPS
+				trace.LinearReducedDPS = researchDampedFloat(candidate.DPS)
+				result.WalkCost.LinearFullScoreCalls++
+				fullDPS, scoreErr := researchRelinearizeFullScore(r, candidate.Assignment)
+				if scoreErr != nil {
+					trace.LinearStatus, trace.Outcome = "full_score_error", "full_score_error"
+					result.Trace = append(result.Trace, trace)
+					result.Stop = "linear_full_score_error"
+					return researchDampedFinish(result, r, incumbent, scoreErr)
+				}
+				result.WalkCost.ExpandedPoints++
+				linearFull, linearFullOK = fullDPS, true
+				fullScoreByActorIDs[linearIDs] = fullDPS
+				reducedScoreByActorIDs[linearIDs] = candidate.DPS
+				trace.LinearFullDPS = researchDampedFloat(fullDPS)
+			}
+		}
+
+		promoted := false
+		if linearFullOK && researchDampedStrictlyBetter(linearFull, fullIncumbent.DPS) {
+			best, _ := researchDampedFullAssignment(fullIncumbent.Assignment, actor, linearIDs)
+			bestReduced := linearReduced
+			incumbent = ScoredAssignment{Assignment: best, DPS: bestReduced, Source: "damped_linear_reduced"}
+			fullIncumbent = ScoredAssignment{Assignment: best, DPS: linearFull, Source: "damped_linear_full"}
+			result.AcceptedFullScores = append(result.AcceptedFullScores, linearFull)
+			result.AcceptedMoves++
+			result.WalkCost.AcceptedLinear++
+			result.FullCheckedIncumbent = fullIncumbent
+			trace.AcceptedAssignment = &best
+			trace.AcceptedFullDPS = researchDampedFloat(linearFull)
+			trace.Outcome = "accepted_linear"
+			promoted = true
+		}
+
+		if !promoted {
+			if len(trace.DifferingSlots) < 2 {
+				trace.Outcome = "no_proper_blend"
+			} else {
+				var bestIDs [5]int64
+				bestFull := fullIncumbent.DPS
+				bestReduced := 0.0
+				bestMask := uint8(0)
+				maskLimit := uint8(1 << len(trace.DifferingSlots))
+				for mask := uint8(1); mask+1 < maskLimit; mask++ {
+					result.WalkCost.MaskTrials++
+					trialIDs := researchDampedBlend(fullIncumbent.Assignment[actor], linearIDs, trace.DifferingSlots, mask)
+					trial := ResearchDampedMaskTrial{Mask: mask}
+					if cached, seen := fullScoreByActorIDs[trialIDs]; seen {
+						trial.Status = "duplicate_cached"
+						result.WalkCost.MaskDuplicateSkips++
+						trial.FullDPS = researchDampedFloat(cached)
+						if reduced, ok := reducedScoreByActorIDs[trialIDs]; ok {
+							trial.ReducedDPS = researchDampedFloat(reduced)
+						}
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						continue
+					}
+					if err := r.localValidator.Validate(trialIDs); err != nil {
+						trial.Status = "illegal"
+						result.WalkCost.MaskIllegalSkips++
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						continue
+					}
+					if r.report.Step.Expanded >= allowance {
+						trial.Status = "budget"
+						result.WalkCost.MaskBudgetSkips++
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						continue
+					}
+					beforeExpanded := r.report.Step.Expanded
+					result.WalkCost.MaskPointCalls++
+					if pointErr := r.point(trialIDs, false, false); pointErr != nil {
+						trial.Status = "point_error"
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						trace.Outcome = "point_error"
+						result.Trace = append(result.Trace, trace)
+						result.Stop = "mask_point_error"
+						return researchDampedFinish(result, r, incumbent, pointErr)
+					}
+					if r.report.Step.Expanded == beforeExpanded {
+						trial.Status = "not_scored"
+						result.WalkCost.MaskDuplicateSkips++
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						continue
+					}
+					candidate := r.lastPoint
+					fullAssignment, assignmentErr := researchDampedFullAssignment(fullIncumbent.Assignment, actor, trialIDs)
+					if assignmentErr != nil || candidate.Assignment != fullAssignment {
+						trial.Status = "actor_mismatch"
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						trace.Outcome = "actor_mismatch"
+						result.Trace = append(result.Trace, trace)
+						result.Stop = "cross_actor_assignment_mismatch"
+						return researchDampedFinish(result, r, incumbent, fmt.Errorf("damped mask point changed a fixed actor"))
+					}
+					trial.Status = "scored"
+					trial.ReducedDPS = researchDampedFloat(candidate.DPS)
+					reducedScoreByActorIDs[trialIDs] = candidate.DPS
+					result.WalkCost.MaskFullScoreCalls++
+					fullDPS, scoreErr := researchRelinearizeFullScore(r, candidate.Assignment)
+					if scoreErr != nil {
+						trial.Status = "full_score_error"
+						trace.MaskTrials = append(trace.MaskTrials, trial)
+						trace.Outcome = "full_score_error"
+						result.Trace = append(result.Trace, trace)
+						result.Stop = "mask_full_score_error"
+						return researchDampedFinish(result, r, incumbent, scoreErr)
+					}
+					result.WalkCost.ExpandedPoints++
+					trial.FullDPS = researchDampedFloat(fullDPS)
+					fullScoreByActorIDs[trialIDs] = fullDPS
+					if researchDampedStrictlyBetter(fullDPS, bestFull) {
+						bestIDs, bestFull, bestReduced, bestMask = trialIDs, fullDPS, candidate.DPS, mask
+					}
+					trace.MaskTrials = append(trace.MaskTrials, trial)
+				}
+				if bestMask != 0 {
+					best, _ := researchDampedFullAssignment(fullIncumbent.Assignment, actor, bestIDs)
+					trace.SelectedMask = researchDampedInt(bestMask)
+					for index := range trace.MaskTrials {
+						if trace.MaskTrials[index].Mask == bestMask {
+							trace.MaskTrials[index].Selected = true
+							break
+						}
+					}
+					trace.AcceptedAssignment = &best
+					trace.AcceptedFullDPS = researchDampedFloat(bestFull)
+					trace.Outcome = "accepted_blend"
+					incumbent = ScoredAssignment{Assignment: best, DPS: bestReduced, Source: "damped_blend_reduced"}
+					fullIncumbent = ScoredAssignment{Assignment: best, DPS: bestFull, Source: "damped_blend_full"}
+					result.AcceptedFullScores = append(result.AcceptedFullScores, bestFull)
+					result.AcceptedMoves++
+					result.WalkCost.AcceptedBlends++
+					result.FullCheckedIncumbent = fullIncumbent
+					promoted = true
+				} else if trace.Outcome == "pending" || trace.Outcome == "no_proper_blend" {
+					trace.Outcome = "no_strict_full_gain"
+				}
+			}
+		}
+		result.Trace = append(result.Trace, trace)
+		if !promoted {
+			result.Stop = "no_strict_full_gain"
+			result.WalkCost.StopNoGain++
+			break
+		}
+	}
+	if result.Stop == "not_started" {
+		result.Stop = "round_cap"
+		result.WalkCost.StopRoundCap++
+	}
+	result.WalkCost.ExpandedPoints = r.report.Step.Expanded
+	for index, score := range result.AcceptedFullScores {
+		previous := result.AnchorFullCheckedDPS
+		if index > 0 {
+			previous = result.AcceptedFullScores[index-1]
+		}
+		if !(score > previous) {
+			result.Stop = "non_monotone_full_score"
+			return researchDampedFinish(result, r, incumbent, fmt.Errorf("damped walk accepted a non-increasing exact full score"))
+		}
+	}
+	return researchDampedFinish(result, r, incumbent, nil)
+}
+
+func researchDampedFinish(result DampedRelinearizeResult, r *candidateRun, incumbent ScoredAssignment, priorErr error) (DampedRelinearizeResult, error) {
+	result.Incumbent = incumbent
+	result.AnchorReducedDPS = r.report.Step.AnchorDPS
+	var finishErr error
+	result.Report, finishErr = r.finish(nil)
+	result.WalkCost.ExpandedPoints = r.report.Step.Expanded
+	if priorErr != nil {
+		result.Report.Stop = result.Stop
+		return result, priorErr
+	}
+	if finishErr != nil {
+		result.Stop = "finish_recheck_error"
+		result.Report.Stop = result.Stop
+		return result, finishErr
+	}
+	result.Report.Stop = result.Stop
+	return result, nil
+}
diff --git a/internal/search/adaptive_relinearize.go b/internal/search/adaptive_relinearize.go
new file mode 100644
--- /dev/null
