+		solver, err := search.NewInventory(c.Index, panel, cfg)
+		if err != nil {
+			return search.CandidateReport{}, err
+		}
+		solver.ObserveCandidates(func(score search.ScoredAssignment) {
+			row := c
+			row.Score = score
+			observed = append(observed, row)
+			archive.offerGroup(group, row)
+			replay.offerGroup(group, row)
+		})
+		return solver.RefineCandidates(context.Background(), c.Score.Assignment, 0, allowance)
+	}
+	memo := newNeutralCandidateMemo(4, 100)
+	key := neutralCandidateSearchKey(index, c, cfg, 0, allowance, true)
+	if _, _, err := memo.run(context.Background(), key, work); err != nil {
+		t.Fatal(err)
+	}
+	if len(observed) < 3 {
+		t.Fatal("fixture did not observe enough distinct candidates", len(observed))
+	}
+	// Archive-only synthetic improvements evict all old scores. Every physical
+	// assignment came from the real solver above; their artificial scores test
+	// storage idempotence, not gameplay arithmetic or better-build claims.
+	for i, old := range observed[:3] {
+		row := old
+		row.Score.DPS = 1e12 + float64(i)
+		archive.offerGroup(group, row)
+		replay.offerGroup(group, row)
+	}
+	count := len(observed)
+	allowance = 4096
+	key.allowance = allowance
+	if _, reused, err := memo.run(context.Background(), key, work); err != nil || !reused || len(observed) != count {
+		t.Fatal("duplicate call unexpectedly observed candidates", reused, err)
+	}
+	for _, row := range observed {
+		replay.offerGroup(group, row)
