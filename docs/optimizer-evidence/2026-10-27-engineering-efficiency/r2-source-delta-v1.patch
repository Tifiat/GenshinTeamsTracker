+func TestSessionPracticalBandsUseOneFixedReferenceWithoutChaining(t *testing.T) {
+	cfg, spec := sessionFixtureConfig(t, [4]int{1, 1, 1, 1})
+	w, _ := newSessionFixtureWorld(spec)
