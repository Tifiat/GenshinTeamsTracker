+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/projectionmetrics"
+)
+
+func beginWholeChascaCounters(runRoot string) (func(), error) {
+	if os.Getenv("GTT_WHOLE_CHASCA_COUNTERS") == "" {
+		return func() {}, nil
+	}
+	if os.Getenv("GTT_WHOLE_CHASCA_COUNTERS") != "1" {
+		return nil, fmt.Errorf("invalid whole-search counter mode")
+	}
+	path := filepath.Join(runRoot, "whole-search-counters.json")
+	if _, err := os.Lstat(path); !os.IsNotExist(err) {
+		return nil, fmt.Errorf("whole-search counters output already exists or is unavailable")
+	}
+	projectionmetrics.StartCounters()
+	return func() {
+		report := projectionmetrics.Finish()
+		raw, err := json.Marshal(report)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, "whole-search counter export:", err)
+			return
+		}
+		file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, "whole-search counter export:", err)
+			return
+		}
+		defer file.Close()
+		if _, err = file.Write(raw); err != nil {
+			fmt.Fprintln(os.Stderr, "whole-search counter export:", err)
+		}
+	}, nil
+}
