+			if foreign.Status != "positive_on_sampled_seeds" || foreign.SampleCount != 2 || foreign.MinimumOtherDPSChange <= 0 {
+				t.Fatal("known foreign support response was screened", key, foreign)
+			}
+			if control.CaseID == "bennett-furina-c0-v1" {
+				hp := byKey["bennett.hp_percent"]
+				if hp.Status != "negative_on_sampled_seeds" || hp.SampleCount != 2 || hp.MaximumDPSChange >= 0 {
+					t.Fatal("negative HP response must remain paired", hp)
+				}
+			}
+			if control.CaseID == "barbara-furina-c0-v1" {
+				for _, stat := range []string{"hp", "hp_percent", "healing_bonus"} {
+					d := byKey["barbara."+stat]
+					if d.Status != "positive_on_sampled_seeds" || d.SampleCount != 2 || d.MinimumOtherDPSChange <= 0 {
+						t.Fatal("tiny measured support response must survive without a threshold", stat, d)
+					}
+				}
+			}
+		})
+	}
+}
