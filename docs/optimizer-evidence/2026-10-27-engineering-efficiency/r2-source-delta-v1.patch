+package allsets
+
+// Per-run adaptive damped preparation, with bounded result telemetry.
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/search"
+)
+
+type adaptiveDampedWholeState struct {
+ job string
+ file *os.File
+ methodCalls int64
+ rows int
+ errors int
+ elapsedSeconds float64
+ solverSetupSeconds float64
+ actors map[int]int
+ blocks map[int]int
+	walkCostTotals search.ResearchDampedWalkCost
+ closed bool
+}
+
+func addAdaptiveDampedWholeWalkCost(total *search.ResearchDampedWalkCost, value search.ResearchDampedWalkCost) {
+	total.Rounds += value.Rounds
+	total.LinearSelections += value.LinearSelections
+	total.LinearPoints += value.LinearPoints
+	total.MaskTrials += value.MaskTrials
+	total.MaskDuplicateSkips += value.MaskDuplicateSkips
+	total.MaskIllegalSkips += value.MaskIllegalSkips
+	total.MaskBudgetSkips += value.MaskBudgetSkips
+	total.MaskPointCalls += value.MaskPointCalls
+	total.MaskFullScoreCalls += value.MaskFullScoreCalls
+	total.LinearBudgetSkips += value.LinearBudgetSkips
+	total.LinearFullScoreCalls += value.LinearFullScoreCalls
+	total.AcceptedBlends += value.AcceptedBlends
+	total.AcceptedLinear += value.AcceptedLinear
+	total.StopNoGain += value.StopNoGain
+	total.StopRoundCap += value.StopRoundCap
+	total.ExpandedPoints += value.ExpandedPoints
+}
+
+func newAdaptiveDampedWholeState(job string) (*adaptiveDampedWholeState, error) {
+	if strings.TrimSpace(job) == "" || !filepath.IsAbs(job) {
+		return nil, fmt.Errorf("damped whole screening requires an absolute managed job")
+	}
+	path := filepath.Join(job, "adaptive-damped-whole-screening.jsonl")
+	file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL|os.O_APPEND, 0600)
+	if err != nil {
+		return nil, fmt.Errorf("create damped whole screening ledger: %w", err)
+	}
+	return &adaptiveDampedWholeState{job: job, file: file, actors: make(map[int]int), blocks: make(map[int]int)}, nil
+}
+
+func (state *adaptiveDampedWholeState) close() error {
+	if state == nil || state.file == nil || state.closed {
+		return nil
+	}
+	state.closed = true
+	return state.file.Close()
+}
+
+func adaptiveDampedWholeHas20UniqueIDs(assignment domain.Assignment) bool {
+	if len(assignment) != 4 {
+		return false
+	}
+	seen := make(map[int64]bool, 20)
+	for _, packageIDs := range assignment {
+		if len(packageIDs) != 5 {
+			return false
+		}
+		for _, id := range packageIDs {
+			if id <= 0 || seen[id] {
+				return false
+			}
+			seen[id] = true
+		}
+	}
+	return len(seen) == 20
+}
+
+func adaptiveDampedWholeScored(value search.ScoredAssignment) any {
+	if !adaptiveDampedWholeHas20UniqueIDs(value.Assignment) || math.IsNaN(value.DPS) || math.IsInf(value.DPS, 0) {
+		return nil
+	}
+	return map[string]any{
+		"formula_dps": value.DPS,
+		"assignment": value.Assignment,
+		"source": value.Source,
+	}
+}
+
+func adaptiveDampedWholePromotes(currentDPS, challengerDPS float64) bool {
+	return !math.IsNaN(currentDPS) && !math.IsInf(currentDPS, 0) &&
+		!math.IsNaN(challengerDPS) && !math.IsInf(challengerDPS, 0) && challengerDPS > currentDPS
+}
+
+func (state *adaptiveDampedWholeState) append(row map[string]any, actor, block int) error {
+	if state == nil || state.file == nil || state.closed {
+		return fmt.Errorf("damped whole screening ledger is not open")
+	}
+	raw, err := json.Marshal(row)
+	if err != nil {
+		return fmt.Errorf("encode damped whole screening row: %w", err)
+	}
+	raw = append(raw, '\n')
+	written, err := state.file.Write(raw)
+	if err != nil {
+		return fmt.Errorf("write damped whole screening row: %w", err)
+	}
+	if written != len(raw) {
+		return io.ErrShortWrite
+	}
+	state.rows++
+	state.actors[actor]++
+	state.blocks[block]++
+	if state.rows%32 == 0 || row["error"] != nil {
+		if err := state.file.Sync(); err != nil {
+			return fmt.Errorf("sync damped whole screening rows: %w", err)
+		}
+	}
+	return nil
+}
+
+func (state *adaptiveDampedWholeState) prepare(
+	ctx context.Context,
+	candidate Candidate,
+	solver *search.Engine,
+	actor int,
+	pack domain.Package,
+	block int,
+	screen search.CandidateReport,
+	solverSetupSeconds float64,
+	allowance int,
+	coordinates []string,
+) (Candidate, search.ActorStep, error) {
+	var empty search.ActorStep
+	if state == nil {
+		return candidate, empty, fmt.Errorf("damped whole screening was not initialized for the current run")
+	}
+	started := time.Now()
+	input := candidate.Score
+	contextKey := ""
+	if candidate.Context != nil {
+		contextKey = candidate.Context.Key()
+	}
+	var outcome search.DampedRelinearizeResult
+	var step search.ActorStep
+	var walkSeconds float64
+	var walkErr error
+	methodCalled := false
+	output := candidate
+	outputReason := "screen_candidate_retained"
+
+	if solver == nil || ctx == nil || candidate.Context == nil || candidate.Index == nil ||
+		actor < 0 || actor >= 4 || block < 1 || block > 8 ||
+		candidate.Packages[actor].Key() != pack.Key() ||
+		!adaptiveDampedWholeHas20UniqueIDs(input.Assignment) ||
+		math.IsNaN(input.DPS) || math.IsInf(input.DPS, 0) ||
+		math.IsNaN(solverSetupSeconds) || math.IsInf(solverSetupSeconds, 0) || solverSetupSeconds < 0 || allowance < 0 {
+		walkErr = fmt.Errorf("damped whole screening precondition failed")
+	} else {
+		state.methodCalls++
+		methodCalled = true
+		walkStarted := time.Now()
+		outcome, walkErr = solver.DampedRelinearizeCandidates(ctx, input.Assignment, actor, allowance)
+		walkSeconds = time.Since(walkStarted).Seconds()
+		step = outcome.Report.Step
+		addAdaptiveDampedWholeWalkCost(&state.walkCostTotals, outcome.WalkCost)
+		state.solverSetupSeconds += solverSetupSeconds
+		if step.Expanded < 0 || step.Expanded > allowance {
+			walkErr = fmt.Errorf("damped whole pass exceeded its existing expansion allowance")
+		}
+		best := outcome.FullCheckedIncumbent
+		if walkErr == nil {
+			if !adaptiveDampedWholeHas20UniqueIDs(best.Assignment) || math.IsNaN(best.DPS) || math.IsInf(best.DPS, 0) {
+				walkErr = fmt.Errorf("damped whole pass returned an invalid full-checked candidate")
+			} else if err := candidate.Index.ValidateAssignment(best.Assignment); err != nil {
+				walkErr = fmt.Errorf("damped whole result is not a legal global assignment: %w", err)
+			} else {
+				for fixedActor := range input.Assignment {
+					if fixedActor != actor && best.Assignment[fixedActor] != input.Assignment[fixedActor] {
+						walkErr = fmt.Errorf("damped whole pass changed fixed actor %d", fixedActor)
+						break
+					}
+				}
+				if walkErr == nil && adaptiveDampedWholePromotes(input.DPS, best.DPS) {
+					output.Score = best
+					output.Index, walkErr = candidate.Index.ForPackages(candidate.Packages, best.Assignment, coordinates)
+					if walkErr == nil {
+						outputReason = "strict_full_score_improvement"
+					}
+				}
+			}
+		}
+	}
+
+	// elapsed_seconds is the whole preparation/helper wall time, including the
+	// separately reported solver setup. walk_seconds isolates the candidateRun.
+	elapsed := solverSetupSeconds + time.Since(started).Seconds()
+	state.elapsedSeconds += elapsed
+	if walkErr != nil {
+		state.errors++
+	}
+	row := map[string]any{
+		"block": block,
+		"actor": actor,
+		"package_key": pack.Key(),
+		"context_sha256": contextKey,
+		"method_called": methodCalled,
+		"screen": map[string]any{
+			"kind": "original observed heuristic screen; retained unchanged for selector spread",
+			"low": screen.Low, "high": screen.High,
+			"samples": screen.Samples, "pair_samples": screen.PairSamples,
+		},
+		"input": map[string]any{"formula_dps": input.DPS, "assignment": input.Assignment},
+		"walk_best": adaptiveDampedWholeScored(outcome.FullCheckedIncumbent),
+		"output": map[string]any{"formula_dps": output.Score.DPS, "assignment": output.Score.Assignment},
+		"output_reason": outputReason,
+		"stop": outcome.Stop,
+		"rounds": outcome.Rounds,
+		"accepted_moves": outcome.AcceptedMoves,
+		"zero_gradient_rounds": outcome.ZeroGradientRounds,
+		"walk_cost": outcome.WalkCost,
+		"solver_setup_seconds": solverSetupSeconds,
+		"walk_seconds": walkSeconds,
+		"elapsed_seconds": elapsed,
+		"timing_scope": "shared solverFor setup plus damped helper; solver setup is already nested in original package preparation and is not incremental damping wall",
+	}
+	if walkErr != nil {
+		row["error"] = walkErr.Error()
+	}
+	if err := state.append(row, actor, block); err != nil {
+		state.errors++
+		if walkErr == nil {
+			walkErr = err
+		} else {
+			walkErr = fmt.Errorf("%w; persist screening row: %v", walkErr, err)
+		}
+	}
+	return output, step, walkErr
+}
+
+func (state *adaptiveDampedWholeState) summary() (map[string]any, error) {
+	if state == nil || state.file == nil || state.closed {
+		return nil, fmt.Errorf("damped whole screening summary has no active ledger")
+	}
+	syncErr := state.file.Sync()
+	closeErr := state.file.Close()
+	state.closed = true
+	if syncErr != nil {
+		return nil, fmt.Errorf("sync damped whole screening ledger: %w", syncErr)
+	}
+	if closeErr != nil {
+		return nil, fmt.Errorf("close damped whole screening ledger: %w", closeErr)
+	}
+	if state.rows != int(state.methodCalls) {
+		return nil, fmt.Errorf("damped method/ledger mismatch: helper calls=%d rows=%d", state.methodCalls, state.rows)
+	}
+	actorRows := make(map[string]int, len(state.actors))
+	for actor, count := range state.actors {
+		actorRows[fmt.Sprintf("%d", actor)] = count
+	}
+	blockRows := make(map[string]int, len(state.blocks))
+	for block, count := range state.blocks {
+		blockRows[fmt.Sprintf("%d", block)] = count
+	}
+	return map[string]any{
+		"schema": "adaptive_damped_whole_screening_v1",
+		"rows": state.rows,
+		"errors": state.errors,
+		"method_calls": state.methodCalls,
+		"elapsed_seconds": state.elapsedSeconds,
+		"solver_setup_seconds": state.solverSetupSeconds,
+		"walk_cost_totals": state.walkCostTotals,
+		"actors": actorRows,
+		"blocks": blockRows,
+		"rows_file": "adaptive-damped-whole-screening.jsonl",
+		"original_spread_preserved": true,
+		"formula_assignment_feeds_queue": true,
+	}, nil
+}
+
diff --git a/internal/allsets/adaptive_final_pair_whole.go b/internal/allsets/adaptive_final_pair_whole.go
new file mode 100644
--- /dev/null
+++ b/internal/allsets/adaptive_final_pair_whole.go
@@ -0,0 +1,252 @@
+package allsets
+
+// This All Sets helper records the final All Sets stabilization inputs
+// and results. It is used only by the per-run neutral All Sets policy
+// state.
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/search"
+)
+
+const adaptiveFinalPairMaxFileBytes int64 = 32 << 20
+
+type adaptiveFinalPairWholeState struct {
+	job                  string
+	planFile             *os.File
+	invocations          *os.File
+	planBytes            int64
+	invocationBytes      int64
+	planFinalistRows     int
+	planEvents           int
+	started              int
+	completed            int
+	notInvokedCount      int
+	errors               int
+	planObserved         bool
+	closed               bool
+	globalBudget         int
+	globalBeforeSnapshot int
+	localCap             int
+	finalistLimit        int
+	searchConfig         search.Config
+}
+
+func newAdaptiveFinalPairWholeState(job string) (*adaptiveFinalPairWholeState, error) {
+	if job == "" || !filepath.IsAbs(job) {
+		return nil, fmt.Errorf("final pair whole telemetry requires an absolute managed job")
+	}
+	plan, err := os.OpenFile(filepath.Join(job, "final-pair-whole-plan.jsonl"), os.O_WRONLY|os.O_CREATE|os.O_EXCL|os.O_APPEND, 0600)
+	if err != nil {
+		return nil, fmt.Errorf("create final pair whole plan: %w", err)
+	}
+	invocations, err := os.OpenFile(filepath.Join(job, "final-pair-whole-stabilization.jsonl"), os.O_WRONLY|os.O_CREATE|os.O_EXCL|os.O_APPEND, 0600)
+	if err != nil {
+		_ = plan.Close()
+		return nil, fmt.Errorf("create final pair whole invocation ledger: %w", err)
+	}
+	return &adaptiveFinalPairWholeState{job: job, planFile: plan, invocations: invocations}, nil
+}
+
+func (state *adaptiveFinalPairWholeState) append(file *os.File, current *int64, row map[string]any) error {
+	if state == nil || state.closed || file == nil {
+		return fmt.Errorf("final pair whole telemetry is not open")
+	}
+	raw, err := json.Marshal(row)
+	if err != nil {
+		state.errors++
+		return fmt.Errorf("encode final pair whole telemetry: %w", err)
+	}
+	raw = append(raw, '\n')
+	if int64(len(raw)) > adaptiveFinalPairMaxFileBytes-*current {
+		state.errors++
+		return fmt.Errorf("final pair whole telemetry file exceeds 32 MiB bound")
+	}
+	written, err := file.Write(raw)
+	if err != nil {
+		state.errors++
+		return fmt.Errorf("write final pair whole telemetry: %w", err)
+	}
+	if written != len(raw) {
+		state.errors++
+		return io.ErrShortWrite
+	}
+	if err := file.Sync(); err != nil {
+		state.errors++
+		return fmt.Errorf("sync final pair whole telemetry: %w", err)
+	}
+	*current += int64(len(raw))
+	return nil
+}
+
+func finalPairWholeCandidateIdentity(candidate Candidate) map[string]any {
+	var contextSHA any
+	var graphSHA any
+	if candidate.Context != nil {
+		contextSHA = candidate.Context.Key()
+	}
+	if candidate.Handle != nil {
+		graphSHA = candidate.Handle.GraphSHA256()
+	}
+	return map[string]any{
+		"input_assignment": candidate.Score.Assignment,
+		"input_dps":        candidate.Score.DPS,
+		"context_sha256":   contextSHA,
+		"graph_sha256":     graphSHA,
+		"packages":         candidate.Packages,
+	}
+}
+
+func (state *adaptiveFinalPairWholeState) plan(finalists []Candidate, globalBudget, globalBefore, localCap, finalistLimit int, config search.Config) error {
+	if state == nil {
+		return nil
+	}
+	if state.planObserved || globalBudget < 0 || globalBefore < 0 || localCap < 0 || finalistLimit < 0 || len(finalists) > finalistLimit {
+		return fmt.Errorf("final pair whole plan inputs are inconsistent")
+	}
+	state.planObserved = true
+	state.globalBudget, state.globalBeforeSnapshot, state.localCap = globalBudget, globalBefore, localCap
+	state.finalistLimit, state.searchConfig = finalistLimit, config
+	if err := state.append(state.planFile, &state.planBytes, map[string]any{
+		"schema": "final_pair_whole_plan_v1", "event": "snapshot", "status": "planned",
+		"finalist_count": len(finalists), "finalist_limit": finalistLimit,
+		"global_budget": globalBudget, "global_before": globalBefore, "local_cap": localCap,
+		"search_config": config,
+	}); err != nil {
+		return err
+	}
+	state.planEvents++
+	for index, finalist := range finalists {
+		row := map[string]any{"schema": "final_pair_whole_plan_v1", "event": "finalist", "status": "planned", "index": index,
+			"global_budget": state.globalBudget, "global_before": nil, "remaining_before": nil, "allowance": nil}
+		for key, value := range finalPairWholeCandidateIdentity(finalist) {
+			row[key] = value
+		}
+		if err := state.append(state.planFile, &state.planBytes, row); err != nil {
+			return err
+		}
+		state.planFinalistRows++
+		state.planEvents++
+	}
+	return nil
+}
+
+func (state *adaptiveFinalPairWholeState) notInvoked(finalists []Candidate, first, globalBefore, remaining int, reason string, cancelled bool) error {
+	if state == nil {
+		return nil
+	}
+	if first < 0 || first > len(finalists) || reason == "" {
+		return fmt.Errorf("final pair whole skipped-finalist record is invalid")
+	}
+	for index := first; index < len(finalists); index++ {
+		row := map[string]any{"schema": "final_pair_whole_plan_v1", "event": "not_invoked", "status": "not_invoked", "index": index,
+			"global_budget": state.globalBudget, "global_before": globalBefore, "remaining_budget": remaining,
+			"reason": reason, "cancelled": cancelled}
+		if err := state.append(state.planFile, &state.planBytes, row); err != nil {
+			return err
+		}
+		state.notInvokedCount++
+		state.planEvents++
+	}
+	return nil
+}
+
+func (state *adaptiveFinalPairWholeState) start(index int, candidate Candidate, globalBudget, globalBefore, remaining, allowance int) error {
+	if state == nil {
+		return nil
+	}
+	if index < 0 || globalBudget != state.globalBudget || globalBefore < 0 || remaining != globalBudget-globalBefore || allowance < 0 || allowance > remaining || allowance > state.localCap {
+		return fmt.Errorf("final pair whole invocation budget does not match its plan")
+	}
+	row := map[string]any{"schema": "final_pair_whole_stabilization_v1", "event": "started", "status": "started", "index": index,
+		"global_budget": globalBudget, "global_before": globalBefore, "remaining_before": remaining, "allowance": allowance}
+	for key, value := range finalPairWholeCandidateIdentity(candidate) {
+		row[key] = value
+	}
+	if err := state.append(state.invocations, &state.invocationBytes, row); err != nil {
+		return err
+	}
+	state.started++
+	return nil
+}
+
+func (state *adaptiveFinalPairWholeState) complete(index int, candidate Candidate, globalBudget, globalBefore, allowance, stabilizationIndex int,
+	stabilization search.Stabilization, runErr error, elapsedSeconds float64, cancelled bool) error {
+	if state == nil {
+		return nil
+	}
+	if index < 0 || globalBudget != state.globalBudget || globalBefore < 0 || allowance < 0 || stabilizationIndex != state.completed ||
+		math.IsNaN(elapsedSeconds) || math.IsInf(elapsedSeconds, 0) || elapsedSeconds < 0 {
+		return fmt.Errorf("final pair whole completion record is inconsistent")
+	}
+	globalAfter := globalBefore + stabilization.Evaluations
+	var errorValue any
+	if runErr != nil {
+		errorValue = runErr.Error()
+	}
+	row := map[string]any{"schema": "final_pair_whole_stabilization_v1", "event": "completed", "status": "completed", "index": index,
+		"stabilization_index": stabilizationIndex, "input_assignment": candidate.Score.Assignment, "input_dps": candidate.Score.DPS,
+		"context_sha256": nil, "graph_sha256": nil, "packages": candidate.Packages,
+		"global_budget": globalBudget, "global_before": globalBefore, "allowance": allowance,
+		"global_after": globalAfter, "remaining_budget": globalBudget - globalAfter,
+		"elapsed_seconds": elapsedSeconds, "cancelled": cancelled,
+		"stabilization": stabilization, "error": errorValue}
+	if candidate.Context != nil {
+		row["context_sha256"] = candidate.Context.Key()
+	}
+	if candidate.Handle != nil {
+		row["graph_sha256"] = candidate.Handle.GraphSHA256()
+	}
+	if err := state.append(state.invocations, &state.invocationBytes, row); err != nil {
+		return err
+	}
+	state.completed++
+	if runErr != nil {
+		state.errors++
+	}
+	return nil
+}
+
+func (state *adaptiveFinalPairWholeState) summary() (map[string]any, error) {
+	if state == nil {
+		return nil, nil
+	}
+	if state.closed {
+		return nil, fmt.Errorf("final pair whole telemetry summary was already closed")
+	}
+	planSyncErr := state.planFile.Sync()
+	invocationSyncErr := state.invocations.Sync()
+	planStat, planStatErr := state.planFile.Stat()
+	invocationStat, invocationStatErr := state.invocations.Stat()
+	planCloseErr := state.planFile.Close()
+	invocationCloseErr := state.invocations.Close()
+	state.closed = true
+	for _, err := range []error{planSyncErr, invocationSyncErr, planStatErr, invocationStatErr, planCloseErr, invocationCloseErr} {
+		if err != nil {
+			return nil, fmt.Errorf("final pair whole telemetry finalization failed: %w", err)
+		}
+	}
+	if planStat.Size() != state.planBytes || invocationStat.Size() != state.invocationBytes {
+		return nil, fmt.Errorf("final pair whole telemetry byte counts do not reconcile")
+	}
+	var globalBudget, globalBeforeSnapshot, localCap, finalistLimit, searchConfig any
+	if state.planObserved {
+		globalBudget, globalBeforeSnapshot, localCap, finalistLimit, searchConfig = state.globalBudget, state.globalBeforeSnapshot,
+			state.localCap, state.finalistLimit, state.searchConfig
+	}
+	return map[string]any{
+		"schema": "final_pair_whole_telemetry_v1", "plan_rows": state.planFinalistRows,
+		"plan_events": state.planEvents, "started": state.started, "completed": state.completed,
+		"not_invoked": state.notInvokedCount, "errors": state.errors,
+		"plan_file": "final-pair-whole-plan.jsonl", "invocation_file": "final-pair-whole-stabilization.jsonl",
+		"plan_bytes": state.planBytes, "invocation_bytes": state.invocationBytes,
+		"maximum_file_bytes": adaptiveFinalPairMaxFileBytes,
+		"global_budget":      globalBudget, "global_before_snapshot": globalBeforeSnapshot,
+		"local_cap": localCap, "finalist_limit": finalistLimit, "search_config": searchConfig,
+	}, nil
+}
diff --git a/internal/allsets/adaptive_formula_primary.go b/internal/allsets/adaptive_formula_primary.go
new file mode 100644
--- /dev/null
+++ b/internal/allsets/adaptive_formula_primary.go
@@ -0,0 +1,335 @@
+package allsets
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/search"
+)
+
+const (
+	formulaPrimaryMaxSecondaryPerBlock = 1
+	formulaPrimaryMaxSecondaryTotal    = 8
+)
+
+type formulaPrimaryState struct {
+	policy                       *adaptiveHybridPolicy
+	block                        int
+	formulaAnchor                Candidate
+	blockEngineIncumbent         Candidate
+	hasBlockEngineIncumbent      bool
+	primaryRefined               map[string]struct{}
+	secondaryUsed                bool
+	attempted, completed, skipped int
+	deduplicated, primaryMarks    int
+	events                        []map[string]any
+}
+
+
+type formulaPrimaryBind func([4]domain.Package, domain.Assignment, string) (Candidate, bool, error)
+type formulaPrimarySolverFor func(Candidate) (*search.Engine, error)
+type formulaPrimaryRetain func(Candidate)
+type formulaPrimaryRecord func(Candidate, string, search.ActorStep, float64)
+
+func (p *adaptiveHybridPolicy) beginFormulaBlock(anchor Candidate) {
+	if p == nil { return }
+	if p.formula == nil || p.formula.policy != p {
+		p.formula = &formulaPrimaryState{policy: p}
+	}
+	s := p.formula
+	s.block = p.block
+	s.formulaAnchor = anchor
+	s.primaryRefined = make(map[string]struct{})
+	s.secondaryUsed = false
+	s.blockEngineIncumbent = Candidate{}
+	s.hasBlockEngineIncumbent = p.HasIncumbent
+	if p.HasIncumbent {
+		s.blockEngineIncumbent = p.Incumbent
+	}
+}
+
+// Mark both the exact assignment supplied to a primary refine and every
+// primary finalist returned from that refine. Identity includes context.
+func (p *adaptiveHybridPolicy) markPrimary(candidate Candidate) {
+	if p == nil { return }
+	s := p.formula
+	if s == nil || s.policy != p || s.block != s.policy.block || candidate.Context == nil {
+		return
+	}
+	key, err := adaptiveCandidateKey(candidate)
+	if err != nil {
+		return
+	}
+	if _, exists := s.primaryRefined[key]; !exists {
+		s.primaryRefined[key] = struct{}{}
+		s.primaryMarks++
+	}
+}
+
+func (p *adaptiveHybridPolicy) secondary(
+	ctx context.Context,
+	actor, remaining, maxExpanded int,
+	bind formulaPrimaryBind,
+	solverFor formulaPrimarySolverFor,
+	retain formulaPrimaryRetain,
+	record formulaPrimaryRecord,
+) (search.ActorStep, error) {
+	var empty search.ActorStep
+	if p == nil { return empty, nil }
+	s := p.formula
+	if s == nil || s.policy != p || s.block != p.block {
+		p.beginFormulaBlock(p.blockAnchor)
+		s = p.formula
+	}
+	if s.secondaryUsed {
+		return empty, nil
+	}
+	s.secondaryUsed = true
+	if p.block > adaptiveHybridMaxBlocks {
+		return empty, researchFormulaPrimarySkip(s, "block_limit", false, nil)
+	}
+	if s.attempted >= formulaPrimaryMaxSecondaryTotal {
+		return empty, researchFormulaPrimarySkip(s, "total_secondary_limit", false, nil)
+	}
+	if !s.hasBlockEngineIncumbent {
+		return empty, researchFormulaPrimarySkip(s, "no_block_start_engine_incumbent", false, nil)
+	}
+	if remaining <= 0 || maxExpanded <= 0 {
+		return empty, researchFormulaPrimarySkip(s, "no_remaining_expansion_budget", false, nil)
+	}
+	incumbent := s.blockEngineIncumbent
+	if incumbent.Context == nil {
+		return empty, researchFormulaPrimarySkip(s, "missing_engine_incumbent_context", false, nil)
+	}
+	incumbentKey, err := adaptiveCandidateKey(incumbent)
+	if err != nil {
+		return empty, researchFormulaPrimarySkip(s, "invalid_engine_incumbent_identity", false, err)
+	}
+	if formulaKey, keyErr := adaptiveCandidateKey(s.formulaAnchor); keyErr == nil && formulaKey == incumbentKey {
+		return empty, researchFormulaPrimarySkip(s, "engine_incumbent_same_as_formula_anchor", false, nil)
+	}
+	ids, validIDs := formulaPrimaryArtifactIDs(incumbent.Score.Assignment)
+	if !validIDs {
+		return empty, researchFormulaPrimarySkip(s, "engine_incumbent_not_20_unique_artifacts", false, nil)
+	}
+	if _, duplicate := s.primaryRefined[incumbentKey]; duplicate {
+		return empty, researchFormulaPrimarySkip(s, "primary_refined_same_context_assignment", true, nil)
+	}
+	if bind == nil || solverFor == nil || retain == nil || record == nil {
+		return empty, researchFormulaPrimarySkip(s, "missing_search_callback", false, nil)
+	}
+
+	started := time.Now()
+	candidate, ok, err := bind(incumbent.Packages, incumbent.Score.Assignment, "neutral_engine_secondary")
+	if err != nil {
+		return empty, researchFormulaPrimarySkip(s, "secondary_bind_error", false, err)
+	}
+	if !ok {
+		return empty, researchFormulaPrimarySkip(s, "secondary_candidate_not_bindable", false, nil)
+	}
+	if candidate.Context == nil || candidate.Context.Key() != incumbent.Context.Key() ||
+		candidate.Score.Assignment != incumbent.Score.Assignment || !formulaPrimarySamePackages(candidate.Packages, incumbent.Packages) ||
+		!finiteAdaptive(candidate.Score.DPS) || math.Abs(candidate.Score.DPS-incumbent.Score.DPS) > 1e-7*(1+math.Abs(incumbent.Score.DPS)) {
+		return empty, researchFormulaPrimarySkip(s, "secondary_context_or_assignment_changed", true, nil)
+	}
+	candidateKey, err := adaptiveCandidateKey(candidate)
+	if err != nil {
+		return empty, researchFormulaPrimarySkip(s, "invalid_bound_secondary_identity", false, err)
+	}
+	if _, duplicate := s.primaryRefined[candidateKey]; duplicate {
+		return empty, researchFormulaPrimarySkip(s, "primary_refined_same_context_assignment", true, nil)
+	}
+	if candidate.Handle == nil || candidate.Index == nil {
+		return empty, researchFormulaPrimarySkip(s, "secondary_candidate_missing_search_state", false, nil)
+	}
+	panel, err := candidate.Handle.SearchPanel()
+	if err != nil {
+		return empty, researchFormulaPrimarySkip(s, "secondary_search_panel_error", false, err)
+	}
+	solver, err := solverFor(candidate)
+	if err != nil {
+		return empty, researchFormulaPrimarySkip(s, "secondary_solver_error", false, err)
+	}
+	allowance := min(remaining, maxExpanded)
+	if allowance <= 0 {
+		return empty, researchFormulaPrimarySkip(s, "no_remaining_expansion_budget", false, nil)
+	}
+	s.attempted++
+	if err := researchFormulaPrimaryEvent(s, map[string]any{
+		"type": "secondary_refinement_started", "block": s.block, "actor": actor,
+		"source": "block_start_engine_incumbent", "candidate": adaptiveCandidateSummary(candidate),
+		"assignment_artifact_ids": ids, "artifact_id_count": len(ids), "formula_dps": adaptiveJSONNumber(candidate.Score.DPS),
+		"context_sha256": candidate.Context.Key(), "expansion_allowance": allowance,
+	}); err != nil {
+		return empty, err
+	}
+	result, runErr := solver.RefineCandidates(ctx, candidate.Score.Assignment, actor, allowance)
+	step := result.Step
+	retained := 0
+	deduplicated := 0
+	secondarySeen := map[string]struct{}{candidateKey: {}}
+	finalists := make([]map[string]any, 0, len(step.Finalists))
+	for _, score := range step.Finalists {
+		row := candidate
+		row.Score = score
+		row.Index, err = candidate.Index.ForPackages(candidate.Packages, score.Assignment, panel.Coordinates())
+		if err != nil {
+			return step, err
+		}
+		key, keyErr := adaptiveCandidateKey(row)
+		if keyErr != nil {
+			return step, keyErr
+		}
+	rowIDs, rowIDsOK := formulaPrimaryArtifactIDs(score.Assignment)
+		if !rowIDsOK {
+			return step, fmt.Errorf("secondary finalist is not a complete 20-artifact assignment")
+		}
+		if _, duplicate := s.primaryRefined[key]; duplicate {
+			s.deduplicated++
+			deduplicated++
+			finalists = append(finalists, map[string]any{"candidate": adaptiveCandidateSummary(row), "assignment_artifact_ids": rowIDs, "retained": false, "deduplicated_primary": true})
+			continue
+		}
+		if _, duplicate := secondarySeen[key]; duplicate {
+			deduplicated++
+			finalists = append(finalists, map[string]any{"candidate": adaptiveCandidateSummary(row), "assignment_artifact_ids": rowIDs, "retained": false, "deduplicated_secondary": true})
+			continue
+		}
+		secondarySeen[key] = struct{}{}
+		retain(row)
+		retained++
+		finalists = append(finalists, map[string]any{"candidate": adaptiveCandidateSummary(row), "assignment_artifact_ids": rowIDs, "retained": true})
+	}
+	elapsed := time.Since(started).Seconds()
+	record(candidate, "neutral_engine_secondary:"+result.Stop, step, elapsed)
+	if runErr == nil {
+		s.completed++
+	}
+	event := map[string]any{
+		"type": "secondary_refinement_finished", "block": s.block, "actor": actor,
+		"source": "block_start_engine_incumbent", "candidate": adaptiveCandidateSummary(candidate),
+		"assignment_artifact_ids": ids, "artifact_id_count": len(ids), "formula_dps": adaptiveJSONNumber(candidate.Score.DPS),
+		"context_sha256": candidate.Context.Key(), "expanded": step.Expanded,
+		"returned_finalists": len(step.Finalists), "retained_finalists": retained,
+		"deduplicated_finalists": deduplicated, "finalists": finalists,
+		"elapsed_seconds": elapsed, "search_stop": result.Stop,
+	}
+	if runErr != nil {
+		event["error"] = runErr.Error()
+	}
+	if err := researchFormulaPrimaryEvent(s, event); err != nil && runErr == nil {
+		runErr = err
+	}
+	return step, runErr
+}
+
+func researchFormulaPrimarySkip(s *formulaPrimaryState, reason string, deduplicated bool, cause error) error {
+	s.skipped++
+	if deduplicated {
+		s.deduplicated++
+	}
+	event := map[string]any{"type": "secondary_refinement_skipped", "block": s.block, "reason": reason}
+	if cause != nil {
+		event["error"] = cause.Error()
+	}
+	if persistErr := researchFormulaPrimaryEvent(s, event); persistErr != nil {
+		if cause != nil {
+			return fmt.Errorf("%w; persist secondary skip event: %v", cause, persistErr)
+		}
+		return persistErr
+	}
+	return cause
+}
+
+func researchFormulaPrimaryEvent(s *formulaPrimaryState, event map[string]any) error {
+	s.events = append(s.events, event)
+	if s.policy == nil {
+		return nil
+	}
+	s.policy.Events = append(s.policy.Events, event)
+	if s.policy.job == "" {
+		return nil
+	}
+	return s.policy.persistProgress()
+}
+
+func (p *adaptiveHybridPolicy) formulaSummary() map[string]any {
+	if p == nil { return map[string]any{"attempted": 0, "completed": 0, "skipped": 0, "deduplicated": 0, "primary_marks": 0, "events": []map[string]any{}} }
+	s := p.formula
+	if s == nil {
+		return map[string]any{"attempted": 0, "completed": 0, "skipped": 0, "deduplicated": 0, "primary_marks": 0, "events": []map[string]any{}}
+	}
+	return map[string]any{
+		"attempted": s.attempted, "completed": s.completed, "skipped": s.skipped,
+		"deduplicated": s.deduplicated, "primary_marks": s.primaryMarks,
+		"max_per_block": formulaPrimaryMaxSecondaryPerBlock,
+		"max_total": formulaPrimaryMaxSecondaryTotal,
+		"events": s.events,
+	}
+}
+
+func (p *adaptiveHybridPolicy) policySummary() map[string]any {
+	base := p.summary()
+	base["secondary_refinement"] = p.formulaSummary()
+	if p.early != nil {
+		base["early_preparation"] = p.early.summary()
+	}
+	if p.damped != nil {
+		base["damped_preparation"] = p.dampedSummary
+	}
+	if p.finalPair != nil {
+		base["final_pair_completion"] = p.finalPairSummary
+	}
+	return base
+}
+
+func formulaPrimaryArtifactIDs(assignment domain.Assignment) ([]int64, bool) {
+	ids := make([]int64, 0, 20)
+	seen := make(map[int64]struct{}, 20)
+	for _, wearer := range assignment {
+		for _, id := range wearer {
+			if id <= 0 {
+				return ids, false
+			}
+			if _, exists := seen[id]; exists {
+				return ids, false
+			}
+			seen[id] = struct{}{}
+			ids = append(ids, id)
+		}
+	}
+	return ids, len(ids) == 20
+}
+
+func formulaPrimarySamePackages(a, b [4]domain.Package) bool {
+	for i := range a {
+		if a[i].Key() != b[i].Key() {
+			return false
+		}
+	}
+	return true
+}
+
+func formulaPrimaryReserve(panel *[]Candidate, protected map[domain.Assignment]bool, candidate Candidate) (Candidate, bool, error) {
+	if panel == nil || protected == nil {
+		return Candidate{}, false, fmt.Errorf("final protection requires a panel and assignment set")
+	}
+	protected[candidate.Score.Assignment] = true
+	for _, row := range *panel {
+		if row.Score.Assignment == candidate.Score.Assignment {
+			return Candidate{}, false, nil
+		}
+	}
+	for i := len(*panel) - 1; i >= 0; i-- {
+		if !protected[(*panel)[i].Score.Assignment] {
+			removed := (*panel)[i]
+			(*panel)[i] = candidate
+			return removed, true, nil
+		}
+	}
+	return Candidate{}, false, fmt.Errorf("no final slot available for protected incumbent")
+}
+
diff --git a/internal/allsets/adaptive_hybrid.go b/internal/allsets/adaptive_hybrid.go
new file mode 100644
--- /dev/null
+++ b/internal/allsets/adaptive_hybrid.go
@@ -0,0 +1,727 @@
+package allsets
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+	"genshinteamstracker/native/gcsim_optimizer/internal/setcontext"
+)
+
+const (
+	adaptiveHybridBlockCalls = 6
+	adaptiveHybridTotalCalls = 48
+	adaptiveHybridBlockMax   = 16
+	adaptiveHybridMaxBlocks  = 8
+	adaptiveHybridBudgetMS   = 40000.0
+	adaptiveHybridCallMS     = 10000
+)
+
+// AdaptivePolicyConfig is a per-invocation capability passed only by the
+// neutral-capable infinite-energy All Sets entrypoint. It is excluded from the
+// public search-config JSON and never stored in package-level state.
+type AdaptivePolicyConfig struct {
+	Request contracts.OptimizerRequest `json:"-"`
+	JobDir  string                     `json:"-"`
+}
+
+type adaptiveHybridPolicy struct {
+	request contracts.OptimizerRequest
+	base    *setcontext.Context
+	job     string
+	engine  engineclient.BoundEngine
+	seeds   [2]uint64
+
+	Calls        int
+	EngineMS     float64
+	EngineWallMS float64
+	Events       []map[string]any
+	Samples      []map[string]any
+	Incumbent    Candidate
+	HasIncumbent bool
+
+	block             int
+	blockCalls        int
+	blockAnchor       Candidate
+	hasBlockAnchor    bool
+	blockFallback     Candidate
+	hasBlockFallback  bool
+	uncertain         Candidate
+	hasUncertain      bool
+	uncertainSpread   float64
+	uncertainPriority float64
+	uncertainOrder    int
+	allow             map[*neutralProposal]bool
+	measurements      map[string]*adaptiveHybridMeasurement
+	incumbentDPS      [2]float64
+	hasIncumbentDPS   bool
+	formula           *formulaPrimaryState
+	early             *earlyPreparationState
+	damped            *adaptiveDampedWholeState
+	finalPair         *adaptiveFinalPairWholeState
+	dampedSummary     map[string]any
+	finalPairSummary  map[string]any
+}
+
+type adaptiveHybridMeasurement struct {
+	candidate Candidate
+	seedDPS   [2]float64
+	seedDone  [2]bool
+}
+
+type adaptiveHybridProgress struct {
+	Calls        int              `json:"calls"`
+	EngineMS     float64          `json:"engine_ms"`
+	EngineWallMS float64          `json:"engine_wall_ms"`
+	Events       []map[string]any `json:"events"`
+	Samples      []map[string]any `json:"samples"`
+	HasIncumbent bool             `json:"has_incumbent"`
+	Incumbent    map[string]any   `json:"incumbent,omitempty"`
+}
+
+func newAdaptiveHybridPolicy(request contracts.OptimizerRequest, base *setcontext.Context, job string) (*adaptiveHybridPolicy, error) {
+	if base == nil || base.Config() != request.Context.PreparedConfig.Text {
+		return nil, fmt.Errorf("adaptive hybrid requires the original prepared context")
+	}
+	if len(request.Stochastic.Seeds) != 2 {
+		return nil, fmt.Errorf("adaptive hybrid requires exactly two immutable ordinary seeds")
+	}
+	var seeds [2]uint64
+	for i, seed := range request.Stochastic.Seeds {
+		if seed == 0 || seed > uint64(^uint64(0)>>1) {
+			return nil, fmt.Errorf("adaptive hybrid seed %d is outside the seeded engine range", seed)
+		}
+		if i == 1 && seed == request.Stochastic.Seeds[0] {
+			return nil, fmt.Errorf("adaptive hybrid seeds must be distinct")
+		}
+		seeds[i] = seed
+	}
+	if strings.TrimSpace(job) == "" || !filepath.IsAbs(job) {
+		return nil, fmt.Errorf("adaptive hybrid requires an absolute owned job directory")
+	}
+	hasSeededOrdinary := false
+	for _, capability := range request.Engine.Capabilities {
+		if capability == engineclient.SeededOrdinaryCapability {
+			hasSeededOrdinary = true
+			break
+		}
+	}
+	if !hasSeededOrdinary {
+		return nil, fmt.Errorf("adaptive hybrid requires %s", engineclient.SeededOrdinaryCapability)
+	}
+	bound, err := engineclient.BindEngine(request)
+	if err != nil {
+		return nil, fmt.Errorf("bind adaptive hybrid ordinary engine: %w", err)
+	}
+	return &adaptiveHybridPolicy{
+		request:      request,
+		base:         base,
+		job:          job,
+		engine:       bound,
+		seeds:        seeds,
+		measurements: make(map[string]*adaptiveHybridMeasurement),
+	}, nil
+}
+
+// adaptive policy uses only a paired-seed measured winner for the next
+// formula block. Formula scoring itself remains untouched.
+func (p *adaptiveHybridPolicy) anchor(fallback Candidate) Candidate {
+	if p == nil {
+		return fallback
+	}
+	p.block++
+	p.blockCalls = 0
+	p.allow = nil
+	p.uncertain = Candidate{}
+	p.hasUncertain = false
+	p.uncertainSpread = 0
+	p.uncertainPriority = 0
+	p.uncertainOrder = 0
+	p.blockFallback = fallback
+	p.hasBlockFallback = true
+	anchor := fallback
+	if p.HasIncumbent {
+		anchor = p.Incumbent
+	}
+	p.blockAnchor = anchor
+	p.hasBlockAnchor = true
+	p.Events = append(p.Events, map[string]any{
+		"type":             "block_anchor",
+		"block":            p.block,
+		"fallback":         adaptiveCandidateSummary(fallback),
+		"anchor":           adaptiveCandidateSummary(anchor),
+		"engine_incumbent": p.HasIncumbent,
+	})
+	if p.block > adaptiveHybridMaxBlocks {
+		return fallback
+	}
+	return anchor
+}
+
+// adaptive policy keeps formula exploration broad: eight formula-ranked
+// proposals, four with the widest known screen spread, and four package-diverse
+// proposals. A missing screen is never interpreted as a zero-width screen.
+func (p *adaptiveHybridPolicy) queue(queue *neutralProposalQueue) {
+	if p == nil || queue == nil || p.block > adaptiveHybridMaxBlocks {
+		return
+	}
+	p.allow = make(map[*neutralProposal]bool, adaptiveHybridBlockMax)
+	items := make([]*neutralProposal, 0, queue.Len())
+	for _, proposal := range *queue {
+		if proposal != nil {
+			items = append(items, proposal)
+		}
+	}
+	priorityOrder(items)
+	selected := make([]*neutralProposal, 0, adaptiveHybridBlockMax)
+	selectedSet := make(map[*neutralProposal]bool, adaptiveHybridBlockMax)
+	add := func(proposal *neutralProposal) bool {
+		if proposal == nil || selectedSet[proposal] || len(selected) >= adaptiveHybridBlockMax {
+			return false
+		}
+		selected = append(selected, proposal)
+		selectedSet[proposal] = true
+		p.allow[proposal] = true
+		return true
+	}
+
+	for _, proposal := range items {
+		if len(selected) == 8 {
+			break
+		}
+		add(proposal)
+	}
+
+	spread := make([]*neutralProposal, 0, len(items))
+	for _, proposal := range items {
+		if !selectedSet[proposal] && knownScreenSpread(proposal) {
+			spread = append(spread, proposal)
+		}
+	}
+	sort.SliceStable(spread, func(i, j int) bool {
+		left, right := screenSpread(spread[i]), screenSpread(spread[j])
+		if left != right {
+			return left > right
+		}
+		return proposalPriorityBefore(spread[i], spread[j])
+	})
+	for i := 0; i < 4 && i < len(spread); i++ {
+		add(spread[i])
+	}
+
+	for len(selected) < adaptiveHybridBlockMax {
+		var best *neutralProposal
+		bestDistance := -1
+		for _, proposal := range items {
+			if selectedSet[proposal] {
+				continue
+			}
+			distance := minimumPackageDistance(proposal, selected)
+			if best == nil || distance > bestDistance ||
+				(distance == bestDistance && proposalPriorityBefore(proposal, best)) {
+				best, bestDistance = proposal, distance
+			}
+		}
+		if best == nil {
+			break
+		}
+		add(best)
+	}
+	// If fewer than four screens have usable samples, fill any remaining slots
+	// deterministically from the formula order rather than treating unknown as 0.
+	for _, proposal := range items {
+		if len(selected) >= adaptiveHybridBlockMax {
+			break
+		}
+		add(proposal)
+	}
+	p.Events = append(p.Events, map[string]any{
+		"type": "queue_selected", "block": p.block, "count": len(selected),
+		"formula": min(8, len(items)), "known_spread": min(4, len(spread)),
+		"selected": proposalSummaries(selected),
+	})
+}
+
+func (p *adaptiveHybridPolicy) allowProposal(proposal *neutralProposal, oldDefer bool) bool {
+	if p == nil || p.block > adaptiveHybridMaxBlocks {
+		return !oldDefer
+	}
+	return proposal != nil && p.allow[proposal]
+}
+
+// adaptive policy retains only the most uncertain refined challenger;
+// the paired engine check later decides whether it becomes the incumbent.
+func (p *adaptiveHybridPolicy) observed(candidate Candidate, proposal *neutralProposal) {
+	if p == nil || p.block > adaptiveHybridMaxBlocks || proposal == nil || !knownScreenSpread(proposal) {
+		return
+	}
+	spread := screenSpread(proposal)
+	if !p.hasUncertain || spread > p.uncertainSpread ||
+		(spread == p.uncertainSpread && proposalPriorityBefore(proposal, &neutralProposal{priority: p.uncertainPriority, order: p.uncertainOrder})) {
+		p.uncertain = candidate
+		p.hasUncertain = true
+		p.uncertainSpread = spread
+		p.uncertainPriority = proposal.priority
+		p.uncertainOrder = proposal.order
+		p.Events = append(p.Events, map[string]any{
+			"type": "uncertain_refined", "block": p.block,
+			"spread": spread, "candidate": adaptiveCandidateSummary(candidate),
+		})
+	}
+}
+
+// adaptive policy measures at most three unique complete builds on the two
+// original seeds. Only a paired win on both seeds can move the next block.
+func (p *adaptiveHybridPolicy) end(ctx context.Context, leader Candidate) error {
+	if p == nil {
+		return nil
+	}
+	if ctx == nil {
+		return fmt.Errorf("adaptive hybrid requires a live search context")
+	}
+	if p.block > adaptiveHybridMaxBlocks {
+		p.Events = append(p.Events, map[string]any{"type": "block_limit_reached", "block": p.block})
+		return p.persistProgress()
+	}
+	if !p.hasBlockAnchor {
+		p.blockAnchor, p.hasBlockAnchor = leader, true
+	}
+	baseline := p.blockAnchor
+	candidates := make([]Candidate, 0, 3)
+	keys := map[string]bool{}
+	for _, candidate := range []Candidate{baseline, leader} {
+		key, err := adaptiveCandidateKey(candidate)
+		if err != nil {
+			return p.finishWithError(fmt.Errorf("identify adaptive hybrid finalist: %w", err))
+		}
+		if !keys[key] {
+			keys[key] = true
+			candidates = append(candidates, candidate)
+		}
+	}
+	if p.hasUncertain {
+		key, err := adaptiveCandidateKey(p.uncertain)
+		if err != nil {
+			return p.finishWithError(fmt.Errorf("identify uncertain adaptive finalist: %w", err))
+		}
+		if !keys[key] {
+			keys[key] = true
+			candidates = append(candidates, p.uncertain)
+		}
+	}
+	if len(candidates) > 3 {
+		return p.finishWithError(fmt.Errorf("adaptive hybrid finalist limit exceeded"))
+	}
+
+	for _, candidate := range candidates {
+		measurement, complete, err := p.measurePair(ctx, candidate)
+		if err != nil {
+			return p.finishWithError(err)
+		}
+		if !complete {
+			p.Events = append(p.Events, map[string]any{"type": "block_budget_reached", "block": p.block})
+			break
+		}
+		if !p.HasIncumbent {
+			p.Incumbent = measurement.candidate
+			p.HasIncumbent = true
+			p.incumbentDPS = measurement.seedDPS
+			p.hasIncumbentDPS = true
+			p.Events = append(p.Events, map[string]any{
+				"type": "incumbent_initialized", "block": p.block,
+				"candidate": adaptiveCandidateSummary(candidate), "seed_dps": measurement.seedDPS,
+			})
+			continue
+		}
+		incumbentKey, _ := adaptiveCandidateKey(p.Incumbent)
+		candidateKey, _ := adaptiveCandidateKey(candidate)
+		if incumbentKey == candidateKey {
+			if !p.hasIncumbentDPS {
+				p.incumbentDPS = measurement.seedDPS
+				p.hasIncumbentDPS = true
+			}
+			continue
+		}
+		if p.hasIncumbentDPS && adaptivePairedWin(measurement.seedDPS, p.incumbentDPS) {
+			previous := adaptiveCandidateSummary(p.Incumbent)
+			p.Incumbent = measurement.candidate
+			p.incumbentDPS = measurement.seedDPS
+			p.Events = append(p.Events, map[string]any{
+				"type": "incumbent_promoted", "block": p.block,
+				"from": previous, "to": adaptiveCandidateSummary(candidate),
+				"seed_dps": measurement.seedDPS,
+			})
+		} else {
+			p.Events = append(p.Events, map[string]any{
+				"type": "paired_candidate_retained", "block": p.block,
+				"candidate": adaptiveCandidateSummary(candidate), "seed_dps": measurement.seedDPS,
+			})
+		}
+	}
+	p.Events = append(p.Events, map[string]any{"type": "block_complete", "block": p.block, "calls": p.blockCalls})
+	return p.persistProgress()
+}
+
+func (p *adaptiveHybridPolicy) measurePair(ctx context.Context, candidate Candidate) (*adaptiveHybridMeasurement, bool, error) {
+	key, err := adaptiveCandidateKey(candidate)
+	if err != nil {
+		return nil, false, fmt.Errorf("identify candidate: %w", err)
+	}
+	measurement := p.measurements[key]
+	if measurement == nil {
+		measurement = &adaptiveHybridMeasurement{candidate: candidate}
+		p.measurements[key] = measurement
+	}
+	if measurement.seedDone[0] && measurement.seedDone[1] {
+		return measurement, true, nil
+	}
+	prepared, err := p.prepareCandidate(candidate)
+	if err != nil {
+		return measurement, false, fmt.Errorf("prepare ordinary finalist: %w", err)
+	}
+	measurement.candidate = prepared.Candidate
+	for seedIndex, seed := range p.seeds {
+		if measurement.seedDone[seedIndex] {
+			continue
+		}
+		if err := ctx.Err(); err != nil {
+			return measurement, false, fmt.Errorf("adaptive hybrid cancelled before ordinary check: %w", err)
+		}
+		if p.Calls >= adaptiveHybridTotalCalls || p.blockCalls >= adaptiveHybridBlockCalls || p.EngineWallMS >= adaptiveHybridBudgetMS {
+			return measurement, false, nil
+		}
+		remaining := adaptiveHybridBudgetMS - p.EngineWallMS
+		timeoutMS := adaptiveHybridCallMS
+		if remaining < float64(timeoutMS) {
+			timeoutMS = int(math.Ceil(remaining))
+		}
+		if timeoutMS <= 0 {
+			return measurement, false, nil
+		}
+		p.Calls++
+		p.blockCalls++
+		p.Events = append(p.Events, map[string]any{
+			"type": "ordinary_started", "block": p.block, "call": p.Calls,
+			"seed": seed, "candidate": adaptiveCandidateSummary(candidate),
+		})
+		if err := p.persistProgress(); err != nil {
+			return measurement, false, fmt.Errorf("persist adaptive ordinary start: %w", err)
+		}
+		runDirectory := filepath.Join(p.job, "adaptive-policy-runs", adaptiveCandidateDirectory(key), strconv.FormatUint(seed, 10))
+		if err := os.MkdirAll(filepath.Dir(runDirectory), 0o700); err != nil {
+			return measurement, false, fmt.Errorf("create adaptive ordinary parent: %w", err)
+		}
+		callCtx, cancel := context.WithTimeout(ctx, time.Duration(timeoutMS)*time.Millisecond)
+		started := time.Now()
+		result, runErr := p.engine.RunOrdinarySeeded(callCtx, prepared.Text, runDirectory, int64(seed))
+		wallMS := float64(time.Since(started)) / float64(time.Millisecond)
+		cancel()
+		elapsedMS := result.ElapsedMS
+		if finiteAdaptive(elapsedMS) && elapsedMS > 0 {
+			p.EngineMS += elapsedMS
+		}
+		p.EngineWallMS += wallMS
+		sample := map[string]any{
+			"block": p.block, "call": p.Calls, "candidate": adaptiveCandidateSummary(candidate),
+			"seed": seed, "formula_dps": adaptiveJSONNumber(candidate.Score.DPS), "engine_dps": adaptiveJSONNumber(result.DPS),
+			"elapsed_ms": adaptiveJSONNumber(wallMS), "engine_elapsed_ms": adaptiveJSONNumber(result.ElapsedMS), "config_sha256": result.ConfigSHA256,
+			"engine_result_sha256":    result.EngineResultSHA256,
+			"insufficient_energy_max": adaptiveJSONNumber(result.InsufficientEnergyMax),
+		}
+		if runErr != nil {
+			sample["error"] = runErr.Error()
+		}
+		if runErr == nil {
+			runErr = validateAdaptiveOrdinaryResult(result, prepared.SHA256, seed)
+			if runErr != nil {
+				sample["validation_error"] = runErr.Error()
+			}
+		}
+		p.Samples = append(p.Samples, sample)
+		p.Events = append(p.Events, map[string]any{
+			"type": "ordinary_finished", "block": p.block, "call": p.Calls,
+			"seed": seed, "candidate": adaptiveCandidateSummary(candidate),
+			"elapsed_ms": adaptiveJSONNumber(wallMS), "engine_elapsed_ms": adaptiveJSONNumber(result.ElapsedMS), "error": adaptiveErrorText(runErr),
+		})
+		if err := p.persistProgress(); err != nil {
+			return measurement, false, fmt.Errorf("persist adaptive ordinary result: %w", err)
+		}
+		if runErr != nil {
+			return measurement, false, fmt.Errorf("adaptive ordinary seed %d failed for candidate %s: %w", seed, key, runErr)
+		}
+		measurement.seedDPS[seedIndex] = result.DPS
+		measurement.seedDone[seedIndex] = true
+	}
+	return measurement, measurement.seedDone[0] && measurement.seedDone[1], nil
+}
+
+type adaptivePreparedCandidate struct {
+	Candidate Candidate
+	Text      string
+	SHA256    string
+}
+
+func (p *adaptiveHybridPolicy) prepareCandidate(candidate Candidate) (adaptivePreparedCandidate, error) {
+	if candidate.Context == nil || candidate.Handle == nil || candidate.Index == nil {
+		return adaptivePreparedCandidate{}, fmt.Errorf("candidate is missing its complete context or inventory")
+	}
+	panel, err := candidate.Handle.SearchPanel()
+	if err != nil {
+		return adaptivePreparedCandidate{}, err
+	}
+	view, err := candidate.Index.ForPackages(candidate.Packages, candidate.Score.Assignment, panel.Coordinates())
+	if err != nil {
+		return adaptivePreparedCandidate{}, err
+	}
+	candidate.Index = view
+	renderer, err := FinalistRenderer(p.request, p.base, []Candidate{candidate})
+	if err != nil {
+		return adaptivePreparedCandidate{}, err
+	}
+	rendered, err := renderer(candidate.Score, 1, 1)
+	if err != nil {
+		return adaptivePreparedCandidate{}, err
+	}
+	return adaptivePreparedCandidate{Candidate: candidate, Text: rendered.Text, SHA256: rendered.SHA256}, nil
+}
+
+func validateAdaptiveOrdinaryResult(result engineclient.OrdinaryResult, expectedConfigSHA string, seed uint64) error {
+	if result.Iterations != 1 || result.NumberOfWorkers != 1 || result.SampleSeed != strconv.FormatUint(seed, 10) {
+		return fmt.Errorf("ordinary identity does not match one iteration, one worker and seed %d", seed)
+	}
+	if result.ConfigSHA256 != expectedConfigSHA || !result.ConfigIdentity.Matched {
+		return fmt.Errorf("ordinary config identity does not match the rendered finalist")
+	}
+	if !finiteAdaptive(result.ElapsedMS) || result.ElapsedMS < 0 {
+		return fmt.Errorf("ordinary elapsed time is invalid")
+	}
+	if !finiteAdaptive(result.DPS) || result.DPS <= 0 {
+		return fmt.Errorf("ordinary DPS is not finite and positive")
+	}
+	if !finiteAdaptive(result.InsufficientEnergyMax) || result.InsufficientEnergyMax != 0 {
+		return fmt.Errorf("ordinary finalist has nonzero or unknown insufficient energy")
+	}
+	if _, err := hex.DecodeString(result.EngineResultSHA256); err != nil || len(result.EngineResultSHA256) != 64 {
+		return fmt.Errorf("ordinary result hash is missing or malformed")
+	}
+	return nil
+}
+
+func (p *adaptiveHybridPolicy) finishWithError(err error) error {
+	p.Events = append(p.Events, map[string]any{"type": "policy_error", "block": p.block, "error": err.Error()})
+	if saveErr := p.persistProgress(); saveErr != nil {
+		return fmt.Errorf("%w; persist policy failure: %v", err, saveErr)
+	}
+	return err
+}
+
+func (p *adaptiveHybridPolicy) VerifyUnchanged() error {
+	if p == nil {
+		return nil
+	}
+	return p.engine.VerifyUnchanged()
+}
+
+func (p *adaptiveHybridPolicy) persistProgress() error {
+	var incumbent map[string]any
+	if p.HasIncumbent {
+		incumbent = adaptiveCandidateSummary(p.Incumbent)
+	}
+	progress := adaptiveHybridProgress{
+		Calls: p.Calls, EngineMS: p.EngineMS, Events: p.Events, Samples: p.Samples,
+		EngineWallMS: p.EngineWallMS, HasIncumbent: p.HasIncumbent, Incumbent: incumbent,
+	}
+	encoded, err := json.Marshal(progress)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(p.job, 0o700); err != nil {
+		return err
+	}
+	if len(encoded) > 256*1024 {
+		return fmt.Errorf("adaptive progress snapshot exceeds 256KiB")
+	}
+	path := filepath.Join(p.job, "adaptive-policy-progress.jsonl")
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	info, err := file.Stat()
+	if err != nil || info.Size()+int64(len(encoded))+1 > 32*1024*1024 {
+		file.Close()
+		return fmt.Errorf("adaptive progress journal stat/32MiB limit")
+	}
+	encoded = append(encoded, '\n')
+	if _, err = file.Write(encoded); err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	return nil
+}
+
+func (p *adaptiveHybridPolicy) summary() map[string]any {
+	if p == nil {
+		return map[string]any{"active": false, "calls": 0}
+	}
+	row := map[string]any{
+		"active": true, "calls": p.Calls, "engine_ms": p.EngineMS,
+		"engine_wall_ms": p.EngineWallMS, "events": p.Events,
+		"samples": p.Samples, "has_incumbent": p.HasIncumbent,
+	}
+	if p.HasIncumbent {
+		row["incumbent"] = adaptiveCandidateSummary(p.Incumbent)
+	}
+	return row
+}
+
+func adaptiveCandidateKey(candidate Candidate) (string, error) {
+	if candidate.Context == nil {
+		return "", fmt.Errorf("candidate context is nil")
+	}
+	if !finiteAdaptive(candidate.Score.DPS) {
+		return "", fmt.Errorf("candidate formula score is not finite")
+	}
+	return candidate.Context.Key() + ":" + fmt.Sprintf("%v", candidate.Score.Assignment), nil
+}
+
+func adaptiveCandidateDirectory(key string) string {
+	digest := sha256.Sum256([]byte(key))
+	return hex.EncodeToString(digest[:8])
+}
+
+func adaptiveCandidateSummary(candidate Candidate) map[string]any {
+	if candidate.Context == nil {
+		return map[string]any{"formula_dps": adaptiveJSONNumber(candidate.Score.DPS), "assignment": candidate.Score.Assignment}
+	}
+	return map[string]any{
+		"context_sha256": candidate.Context.Key(),
+		"formula_dps":    adaptiveJSONNumber(candidate.Score.DPS),
+		"assignment":     candidate.Score.Assignment,
+	}
+}
+
+func adaptiveJSONNumber(value float64) any {
+	if !finiteAdaptive(value) {
+		return nil
+	}
+	return value
+}
+
+func adaptiveErrorText(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
+
+func adaptivePairedWin(candidate, incumbent [2]float64) bool {
+	return adaptiveStrictWin(candidate[0], incumbent[0]) && adaptiveStrictWin(candidate[1], incumbent[1])
+}
+
+func adaptiveStrictWin(candidate, incumbent float64) bool {
+	return finiteAdaptive(candidate) && finiteAdaptive(incumbent) &&
+		candidate > incumbent+1e-7*math.Max(1, math.Abs(incumbent))
+}
+
+func finiteAdaptive(value float64) bool { return !math.IsNaN(value) && !math.IsInf(value, 0) }
+
+func priorityOrder(items []*neutralProposal) {
+	sort.SliceStable(items, func(i, j int) bool { return proposalPriorityBefore(items[i], items[j]) })
+}
+
+func proposalPriorityBefore(left, right *neutralProposal) bool {
+	leftNaN, rightNaN := math.IsNaN(left.priority), math.IsNaN(right.priority)
+	if leftNaN != rightNaN {
+		return !leftNaN
+	}
+	if left.priority != right.priority {
+		return left.priority > right.priority
+	}
+	return left.order < right.order
+}
+
+func knownScreenSpread(proposal *neutralProposal) bool {
+	return proposal != nil && proposal.screen.Samples > 0 &&
+		finiteAdaptive(proposal.screen.Low) && finiteAdaptive(proposal.screen.High) &&
+		proposal.screen.High >= proposal.screen.Low
+}
+
+func screenSpread(proposal *neutralProposal) float64 {
+	return proposal.screen.High - proposal.screen.Low
+}
+
+func proposalSummaries(proposals []*neutralProposal) []map[string]any {
+	output := make([]map[string]any, 0, len(proposals))
+	for _, proposal := range proposals {
+		spread := any(nil)
+		if knownScreenSpread(proposal) {
+			spread = screenSpread(proposal)
+		}
+		output = append(output, map[string]any{
+			"actor": proposal.actor, "package": proposal.pack.Key(),
+			"priority": adaptiveJSONNumber(proposal.priority), "order": proposal.order, "spread": spread,
+		})
+	}
+	return output
+}
+
+func packageSetCounts(proposal *neutralProposal) map[string]int {
+	counts := make(map[string]int, len(proposal.pack.Sets))
+	for _, set := range proposal.pack.Sets {
+		counts[fmt.Sprintf("%d:%s", proposal.actor, set.SetUID)] += set.Count
+	}
+	return counts
+}
+
+func packageDistance(left, right *neutralProposal) int {
+	leftCounts, rightCounts := packageSetCounts(left), packageSetCounts(right)
+	keys := make(map[string]bool, len(leftCounts)+len(rightCounts))
+	for key := range leftCounts {
+		keys[key] = true
+	}
+	for key := range rightCounts {
+		keys[key] = true
+	}
+	distance := 0
+	for key := range keys {
+		delta := leftCounts[key] - rightCounts[key]
+		if delta < 0 {
+			delta = -delta
+		}
+		distance += delta
+	}
+	return distance
+}
+
+func minimumPackageDistance(proposal *neutralProposal, selected []*neutralProposal) int {
+	if len(selected) == 0 {
+		return 0
+	}
+	minimum := int(^uint(0) >> 1)
+	for _, chosen := range selected {
+		if distance := packageDistance(proposal, chosen); distance < minimum {
+			minimum = distance
+		}
+	}
+	return minimum
+}
