+func coverageViewFixture(t *testing.T) (*Panel, *formula.ParametricProgram) {
+	t.Helper()
+	req, ir := fixtures(t)
+	panel, err := Compile(req, ir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	program, err := panel.PrepareEffectInputs(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Include every mutable report slice independently of the damage fixture.
+	panel.supportCoverage = supportimpact.Report{
+		Coordinates: []supportimpact.Coordinate{{Key: "a.em", Owner: "a", Recipients: []string{"b", "c"}}},
+		Gaps: []supportimpact.Gap{{Seed: 1, BoundaryID: "gap", NodeID: 1, Reason: "opaque",
+			Recipients: []string{"c", "d"}, Attribution: "reachable_damage"}},
+		GraphScope: "captured_graph", AdditionalUncertainty: []string{"base"},
+	}
+	return panel, program
+}
+
+func TestParametricCoverageReportsMatchEagerProjection(t *testing.T) {
+	panel, program := coverageViewFixture(t)
+	base := panel.supportCoverage.Clone()
+	for _, reasons := range [][]string{nil, {}, {"z", "base", "", "a", "z"}} {
+		view, err := panel.ParametricView(program, reasons)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got, want := view.SupportCoverage(), base.ForParametricView(reasons); !reflect.DeepEqual(got, want) {
+			t.Fatalf("view coverage changed: got %#v want %#v", got, want)
+		}
+		if !reflect.DeepEqual(panel.SupportCoverage(), base) {
+			t.Fatal("base coverage changed when constructing a view")
+		}
+	}
+}
+
+func TestParametricCoverageKeepsParentSiblingAndNestedReportsIsolated(t *testing.T) {
+	panel, program := coverageViewFixture(t)
+	base := panel.SupportCoverage()
+	reasons := []string{"first", "base", ""}
+	view, err := panel.ParametricView(program, reasons)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantView := base.ForParametricView(reasons)
+	reasons[0] = "caller_changed_input"
+	sibling, err := panel.ParametricView(program, []string{"sibling"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	nested, err := view.ParametricView(program, []string{"nested", "first", ""})
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantNested := wantView.ForParametricView([]string{"nested", "first", ""})
+	panels := []*Panel{panel, view, sibling, nested}
+	wants := []supportimpact.Report{base, wantView, base.ForParametricView([]string{"sibling"}), wantNested}
+	for _, source := range panels {
+		report := source.SupportCoverage()
+		report.Coordinates[0].Key = "changed"
+		report.Coordinates[0].Owner = "changed"
+		report.Coordinates[0].Recipients[0] = "changed"
+		report.Gaps[0].Reason = "changed"
+		report.Gaps[0].Recipients[0] = "changed"
+		report.GraphScope = "changed"
+		report.AdditionalUncertainty[0] = "changed"
+		for i, target := range panels {
+			if got := target.SupportCoverage(); !reflect.DeepEqual(got, wants[i]) {
+				t.Fatalf("public mutation escaped into panel %d: got %#v want %#v", i, got, wants[i])
+			}
+		}
+	}
+}
+
+func TestParametricCoverageConstructionDoesNotScaleWithCapturedReport(t *testing.T) {
+	small, program := coverageViewFixture(t)
+	large := *small
+	large.supportCoverage = small.supportCoverage.Clone()
+	for len(large.supportCoverage.Coordinates) < 1024 {
+		large.supportCoverage.Coordinates = append(large.supportCoverage.Coordinates, small.supportCoverage.Coordinates[0])
+		large.supportCoverage.Gaps = append(large.supportCoverage.Gaps, small.supportCoverage.Gaps[0])
+	}
+	var last *Panel
+	allocations := func(panel *Panel) float64 {
+		return testing.AllocsPerRun(20, func() {
+			var err error
+			last, err = panel.ParametricView(program, []string{"view"})
+			if err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+	smallAllocs, largeAllocs := allocations(small), allocations(&large)
+	if largeAllocs != smallAllocs {
+		t.Fatalf("coverage size changes view allocations: small=%v large=%v", smallAllocs, largeAllocs)
+	}
+	// Identity also rules out a fixed-allocation deep copy of the large slices.
+	if &last.supportCoverage.Coordinates[0] != &large.supportCoverage.Coordinates[0] ||
+		&last.supportCoverage.Gaps[0] != &large.supportCoverage.Gaps[0] {
+		t.Fatal("view copied privately immutable captured coverage")
+	}
+}
