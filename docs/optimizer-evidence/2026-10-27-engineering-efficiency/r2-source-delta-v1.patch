+func NOCharIsSpecial(k keys.Char) bool { return false }
+`),
+	})
+	v.program.repository = dispatchRepository(t)
+	h := &ruleReplayHost{}
+	character := contracts.NeutralCharacter{Key: "fixture", Facts: map[string]contracts.EventValue{}}
+	if fact != nil {
+		character.Facts["NOCharIsSpecial"] = *fact
+	}
+	h.context.Characters = []contracts.NeutralCharacter{character}
+	h.vm, v.host = v, h
+	return v
+}
