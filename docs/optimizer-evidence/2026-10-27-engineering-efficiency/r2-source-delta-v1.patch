+func TestNeutralBoundScoreMemoChangedPhysicalMainsAndValidation(t *testing.T) {
+	index, c, report := neutralCheckedBoundReport(t)
+	seed := report.Step.Finalists[0].Assignment
+	for _, actor := range []int{0, 3} {
+		memo := newNeutralBoundScoreMemo(4)
+		if err := memo.rememberCheckedReport(context.Background(), index, c, report); err != nil {
+			t.Fatal(err)
+		}
+		changed, found := seed, false
+		for _, id := range c.Index.CandidateIDsBySlot[2] {
+			trial := seed
+			trial[actor][2] = id
+			if trial != seed && c.Index.ValidateAssignment(trial) == nil {
+				changed, found = trial, true
+				break
+			}
+		}
+		if !found {
+			t.Fatal("missing legal alternative main piece", actor)
+		}
+		got, err := memo.bind(context.Background(), index, c.Context, c.Handle, c.Packages, changed, "changed_main")
+		want, other := newNeutralBoundScoreMemo(0).bind(context.Background(), index, c.Context, c.Handle, c.Packages, changed, "changed_main")
+		if err != nil || other != nil || memo.hits != 0 || memo.evaluations != 1 || !reflect.DeepEqual(got.Score, want.Score) {
+			t.Fatal("changed wearer/teammate main did not use the complete panel", actor, got.Score, want.Score, err, other)
+		}
+	}
+	memo := newNeutralBoundScoreMemo(4)
+	for _, invalid := range []domain.Assignment{
+		func() domain.Assignment { ids := seed; ids[0][2] = seed[3][2]; return ids }(),
+		func() domain.Assignment { ids := seed; ids[0][2] = seed[0][1]; return ids }(),
+		func() domain.Assignment { ids := seed; ids[0][2] = -1; return ids }(),
+	} {
