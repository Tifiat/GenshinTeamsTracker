+func TestCrashRecoveryAndCorruptPrivacyRemoval(t *testing.T) {
+	dir := t.TempDir()
+	o := sample()
+	name := identity(o) + ".json"
+	if err := os.WriteFile(filepath.Join(dir, name), []byte(`{"schema":1,"profile":"secret"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	old := filepath.Join(dir, ".mechanic-tmp-crashed")
+	if err := os.WriteFile(old, []byte("private"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	yesterday := time.Now().Add(-2 * tempMaxAge)
+	if err := os.Chtimes(old, yesterday, yesterday); err != nil {
+		t.Fatal(err)
+	}
+	active := filepath.Join(dir, ".mechanic-tmp-active")
+	if err := os.WriteFile(active, []byte("in-progress"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(old); !os.IsNotExist(err) {
+		t.Fatalf("stale temp survived: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, name)); !os.IsNotExist(err) {
+		t.Fatalf("invalid privacy record survived: %v", err)
+	}
+	if _, err := os.Stat(active); err != nil {
+		t.Fatalf("active temp removed: %v", err)
+	}
+	if st := s.Stats(); st.Evicted != 1 || st.Records != 0 {
+		t.Fatalf("recovery: %+v", st)
+	}
+}
+
+func TestConcurrentCallersMerge(t *testing.T) {
+	dir := t.TempDir()
+	a, err := Open(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := Open(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			s := a
+			if i%2 == 0 {
+				s = b
+			}
+			if err := s.Record(sample()); err != nil {
+				t.Error(err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	if r := readRecord(t, dir); r.Count != 20 {
+		t.Fatalf("lost merge: %d", r.Count)
+	}
+}
+
+func TestWindowsReplaceRetryPreservesFailure(t *testing.T) {
+	if runtime.GOOS != "windows" {
+		t.Skip("Windows file replacement semantics")
+	}
+	for _, code := range []syscall.Errno{5, 32} {
+		attempts := 0
+		waits := 0
+		err := replaceFile("temp", "record", func(string, string) error {
+			attempts++
+			if attempts < 3 {
+				return code
+			}
+			return nil
+		}, func(time.Duration) { waits++ })
+		if err != nil || attempts != 3 || waits != 2 {
+			t.Fatalf("transient code %d: attempts=%d waits=%d err=%v", code, attempts, waits, err)
+		}
+	}
+	attempts := 0
+	err := replaceFile("temp", "record", func(string, string) error { attempts++; return syscall.Errno(5) }, func(time.Duration) {})
+	if err == nil || attempts != 21 {
+		t.Fatalf("persistent access error hidden: attempts=%d err=%v", attempts, err)
+	}
+}
diff --git a/internal/mechanicpolicy/fallback.go b/internal/mechanicpolicy/fallback.go
new file mode 100644
--- /dev/null
+++ b/internal/mechanicpolicy/fallback.go
@@ -0,0 +1,185 @@
+package mechanicpolicy
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+// Failure distinguishes an unavailable mechanic model from failures that must
+// retain their ordinary error path. Callers classify errors from typed engine
+// contracts, not by matching error text.
+type Failure string
+
+const (
+	ModelUnavailable         Failure = "model_unavailable"
+	CaptureBudgetUnavailable Failure = "capture_budget_unavailable"
+	InvalidInput             Failure = "invalid_input"
+	EngineProtocol           Failure = "engine_protocol"
+	Cancelled                Failure = "cancelled"
+)
+
+type Request struct {
+	Failure                Failure
+	FastMode               bool
+	FinishedEarly          bool
+	RemainingOrdinarySlots int
+	HasLegalAnchor         bool
+	HasMeasuredAnchor      bool
+}
+
+type Decision struct {
+	Recoverable             bool   `json:"recoverable"`
+	VerifyOrdinary          bool   `json:"verify_ordinary"`
+	OrdinarySlots           int    `json:"ordinary_slots"`
+	FormulaAvailable        bool   `json:"formula_available"`
+	MeasuredAnchorAvailable bool   `json:"measured_anchor_available"`
+	SearchCoverage          string `json:"search_coverage"`
+	Reason                  string `json:"reason"`
+}
+
+// Decide is shared by Selected, All Sets, and Theory. It reserves at most one
+// existing exact-finalist slot; it never creates a budget or declares a frozen
+// formula exact. A caller must run its usual ordinary verifier for that slot.
+func Decide(req Request) Decision {
+	if req.Failure != ModelUnavailable && req.Failure != CaptureBudgetUnavailable {
+		return Decision{Reason: string(req.Failure), SearchCoverage: "not_started"}
+	}
+	decision := Decision{Recoverable: true, FormulaAvailable: false, MeasuredAnchorAvailable: req.HasMeasuredAnchor, SearchCoverage: "incomplete_model", Reason: string(req.Failure)}
+	if !req.HasLegalAnchor {
+		decision.Reason = "no_legal_anchor"
+		return decision
+	}
+	if req.HasMeasuredAnchor {
+		decision.Reason = "existing_measured_anchor"
+		return decision
+	}
+	if req.FastMode {
+		decision.Reason = "fast_mode_no_ordinary_verification"
+		return decision
+	}
+	if req.FinishedEarly {
+		decision.Reason = "finish_before_ordinary_verification"
+		return decision
+	}
+	if req.RemainingOrdinarySlots <= 0 {
+		decision.Reason = "ordinary_verification_budget_exhausted"
+		return decision
+	}
+	decision.VerifyOrdinary = true
+	decision.OrdinarySlots = 1
+	decision.Reason = "ordinary_anchor_reserved"
+	return decision
+}
+
+// ModelUnavailableError is emitted only after a valid source rule cannot bind
+// a source model. Engine/protocol/rotation/Cancel errors must not be wrapped in
+// it. Diagnostics are bounded and copied to avoid leaking mutable call state.
+type ModelUnavailableError struct {
+	Kind  Failure
+	Codes []string
+}
+
+func (e *ModelUnavailableError) Error() string {
+	if e == nil {
+		return "mechanic model unavailable"
+	}
+	return fmt.Sprintf("mechanic model unavailable (%s): %s", e.Kind, strings.Join(e.Codes, "; "))
+}
+
+func NewModelUnavailable(kind Failure, codes []string) *ModelUnavailableError {
+	if kind != ModelUnavailable && kind != CaptureBudgetUnavailable {
+		return nil
+	}
+	copyCodes := append([]string(nil), codes...)
+	sort.Strings(copyCodes)
+	if len(copyCodes) > 32 {
+		copyCodes = copyCodes[:32]
+	}
+	for i, code := range copyCodes {
+		if len(code) > 256 {
+			copyCodes[i] = code[:256]
+		}
+	}
+	return &ModelUnavailableError{Kind: kind, Codes: copyCodes}
+}
+
+func AsModelUnavailable(err error) (*ModelUnavailableError, bool) {
+	var target *ModelUnavailableError
+	if !errors.As(err, &target) || target == nil {
+		return nil, false
+	}
+	return target, true
+}
+
+type AnchorSource string
+
+const (
+	InputIncumbent         AnchorSource = "input_incumbent"
+	DeterministicInventory AnchorSource = "deterministic_inventory"
+)
+
+type NoLegalAnchorError struct{ SearchBoundReached bool }
+
+func (e *NoLegalAnchorError) Error() string {
+	if e != nil && e.SearchBoundReached {
+		return "legal real-inventory anchor not established within bounded search"
+	}
+	return "no legal full real-inventory anchor"
+}
+
+// SelectInventoryAnchor never invents an artifact or relaxes package rules.
+// The normal domain.Build path supplies a legal input incumbent. The bounded
+// deterministic search covers damaged/derived views without unbounded work.
+func SelectInventoryAnchor(index *domain.Index) (domain.Assignment, AnchorSource, error) {
+	if index == nil {
+		return domain.Assignment{}, "", &NoLegalAnchorError{}
+	}
+	if err := index.ValidateAssignment(index.Incumbent); err == nil {
+		return index.Incumbent, InputIncumbent, nil
+	}
+	var pools [5][]int64
+	for slot := 0; slot < 5; slot++ {
+		pools[slot] = append([]int64(nil), index.CandidateIDsBySlot[slot]...)
+		sort.Slice(pools[slot], func(i, j int) bool { return pools[slot][i] < pools[slot][j] })
+	}
+	var candidate domain.Assignment
+	used := map[int64]bool{}
+	visited := 0
+	boundReached := false
+	var search func(int) bool
+	search = func(position int) bool {
+		if position == 20 {
+			return index.ValidateAssignment(candidate) == nil
+		}
+		if visited >= 100000 {
+			boundReached = true
+			return false
+		}
+		actor, slot := position/5, position%5
+		for _, id := range pools[slot] {
+			if used[id] {
+				continue
+			}
+			visited++
+			if visited > 100000 {
+				boundReached = true
+				return false
+			}
+			used[id] = true
+			candidate[actor][slot] = id
+			if search(position + 1) {
+				return true
+			}
+			delete(used, id)
+		}
+		return false
+	}
+	if search(0) {
+		return candidate, DeterministicInventory, nil
+	}
+	return domain.Assignment{}, "", &NoLegalAnchorError{SearchBoundReached: boundReached}
+}
