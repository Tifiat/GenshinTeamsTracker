+
+func TestLazyDependencyModulePlanColdWarmCorruptAndCacheOff(t *testing.T) {
+	dir := t.TempDir()
+	engine := contracts.EngineBinding{ArtifactSHA256: strings.Repeat("a", 64), SourceManifestSHA256: strings.Repeat("b", 64)}
+	catalog := strings.Repeat("c", 64)
+	source := map[string][]byte{"internal/artifacts/sample/set.go": []byte(`package sample
+import deep "github.com/genshinsim/gcsim/pkg/deep"
+func Start(v int) int { f:=deep.Scale; return f(v) }
+`)}
+	const helperPath = "pkg/deep/deep.go"
+	makeRepository := func(multiplier string) *ruleRepository {
+		body := "package deep\nfunc Scale(v int) int { return v * " + multiplier + " }\n"
+		repo, err := newRuleRepository(&RuleSourceRepository{Module: "github.com/genshinsim/gcsim", Files: map[string]contracts.SourceText{helperPath: {Text: body, SHA256: contracts.TextSHA256(body)}}}, build.Default)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return repo
+	}
+	prepare := func(repo *ruleRepository, cache *RuleParseCache) (*ruleProgram, string) {
+		p, ir, origin, analysisErr, compileErr := prepareMechanicProgram(source, nil, repo, nil, engine, catalog, cache)
+		if compileErr != nil || analysisErr != nil || p == nil || ir == nil {
+			t.Fatalf("prepare %s: %v %v", origin, compileErr, analysisErr)
+		}
+		if p.modules[gcsimImport+"pkg/deep"] != nil {
+			t.Fatal("callback-only helper was eagerly linked")
+		}
+		return p, origin
+	}
+	invoke := func(p *ruleProgram, want float64) {
+		result, err := newRuleVM(p, nil, 10000).entry("Start", float64(4))
+		if err != nil || result != want {
+			t.Fatalf("lazy helper result=%v want=%v err=%v", result, want, err)
+		}
+		if p.modules[gcsimImport+"pkg/deep"] == nil {
+			t.Fatal("runtime helper was not linked")
+		}
+	}
+	repo := makeRepository("3")
+	first := NewRuleParseCache("", dir)
+	cold, origin := prepare(repo, first)
+	if origin != "source" {
+		t.Fatalf("cold root origin %s", origin)
+	}
+	invoke(cold, 12)
+	if first.MechanicIRStats().SemanticAnalyses < 2 {
+		t.Fatalf("lazy cold module was not analyzed: %+v", first.MechanicIRStats())
+	}
+	depFiles := map[string][]byte{helperPath: repo.files[helperPath]}
+	depKey, _, _, _, err := mechanicIRKeyRole(mechanicIRDependencyRole, gcsimImport+"pkg/deep", repo, nil, engine, catalog, depFiles, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, depKey+".gttir")); err != nil {
+		t.Fatalf("lazy plan was not saved: %v", err)
+	}
+	second := NewRuleParseCache("", dir)
+	warm, warmOrigin := prepare(repo, second)
+	if warmOrigin != "writable" {
+		t.Fatalf("warm root origin %s", warmOrigin)
+	}
+	invoke(warm, 12)
+	stats := second.MechanicIRStats()
+	if stats.SemanticAnalyses != 0 || stats.FreshBinds < 2 || stats.WritableHits < 2 {
+		t.Fatalf("warm lazy plan was not consumed: %+v", stats)
+	}
+	if cold.modules[gcsimImport+"pkg/deep"] == warm.modules[gcsimImport+"pkg/deep"] || cold.modules[gcsimImport+"pkg/deep"].envs[cold.modules[gcsimImport+"pkg/deep"].files[0]] == warm.modules[gcsimImport+"pkg/deep"].envs[warm.modules[gcsimImport+"pkg/deep"].files[0]] {
+		t.Fatal("warm dependency reused bound module/environment")
+	}
+	if err := os.WriteFile(filepath.Join(dir, depKey+".gttir"), []byte("corrupt"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	repaired := NewRuleParseCache("", dir)
+	third, _ := prepare(repo, repaired)
+	invoke(third, 12)
+	if repaired.MechanicIRStats().Repairs == 0 || repaired.MechanicIRStats().SemanticAnalyses == 0 {
+		t.Fatalf("corrupt dependency did not fall back: %+v", repaired.MechanicIRStats())
+	}
+	changed := NewRuleParseCache("", dir)
+	modified, _ := prepare(makeRepository("4"), changed)
+	invoke(modified, 16)
+	if changed.MechanicIRStats().SemanticAnalyses < 2 {
+		t.Fatalf("changed helper reused stale plan: %+v", changed.MechanicIRStats())
+	}
+	t.Setenv("GTT_MECHANIC_CACHE_ENABLED", "0")
+	off := NewRuleParseCache(dir, dir)
+	disabled, _ := prepare(repo, off)
+	invoke(disabled, 12)
+	if off.MechanicIRStats().SemanticAnalyses < 2 || off.MechanicIRStats().WritableHits != 0 || off.MechanicIRStats().BundledHits != 0 {
+		t.Fatalf("cache-off read disk plan: %+v", off.MechanicIRStats())
+	}
+}
+
+func TestLazyDependencyCannotBorrowEntryInitException(t *testing.T) {
+	entry := map[string][]byte{"pkg/deep/deep.go": []byte(`package deep
+import "github.com/genshinsim/gcsim/pkg/core"
+func NewSet(){}
+func init(){core.RegisterSetFunc(1,NewSet)}
+`)}
+	p, err := compileRuleProgram(entry, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The ordinary compiler sees its own entry package. A lazy dependency must
+	// clear that exemption before saving or rebinding a module plan.
+	if p.modules[p.entry].initializationUnsafe {
+		t.Fatal("fixture did not exercise entry registration exemption")
+	}
+	for _, m := range p.modules {
+		m.initializationUnsafe = false
+		for _, init := range m.initializers {
+			if !ruleInitializerInert(init) {
+				m.initializationUnsafe = true
+			}
+		}
+	}
+	if !p.modules[p.entry].initializationUnsafe {
+		t.Fatal("dependency registration gained root init exemption")
+	}
+	plan, err := buildMechanicModulePlanRole(p, mechanicIRDependencyRole)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ir := MechanicIR{Role: mechanicIRDependencyRole, Entry: p.entry, ModulePlan: &plan}
+	bound, err := bindMechanicModulePlan(ir, entry, nil, nil, nil, nil)
+	if err != nil || !bound.modules[p.entry].initializationUnsafe {
+		t.Fatalf("warm dependency init safety lost: %v", err)
+	}
+	ir.Role = mechanicIRRootRole
+	if _, err := bindMechanicModulePlan(ir, entry, nil, nil, nil, nil); err == nil {
+		t.Fatal("dependency plan rebound as root")
+	}
+}
diff --git a/internal/seteffects/mechanic_ir_plan.go b/internal/seteffects/mechanic_ir_plan.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/mechanic_ir_plan.go
@@ -0,0 +1,676 @@
+package seteffects
+
+// The module plan indexes declarations in the already validated Go AST wire.
+// It contains no AST nodes, executable closures, globals' values, or VM state.
+import (
+	"fmt"
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type mechanicExprRef struct{ File, Decl, Spec, Value int }
+type mechanicFilePlan struct {
+	Path    string            `json:"path"`
+	Imports map[string]string `json:"imports"`
+}
+type mechanicFunctionPlan struct {
+	Key           string `json:"key"`
+	File, Decl    int
+	Receiver      string `json:"receiver,omitempty"`
+	ValueReceiver bool   `json:"value_receiver,omitempty"`
+}
+type mechanicTypePlan struct {
+	Key              string `json:"key"`
+	File, Decl, Spec int
+}
+type mechanicGlobalPlan struct {
+	Key                             string `json:"key"`
+	EnvFile                         int
+	DeclFile, Decl, Spec, NameIndex int
+	Expr, Type                      mechanicExprRef
+	Constant                        bool `json:"constant"`
+	Iota                            int  `json:"iota"`
+}
+type mechanicModuleDescriptor struct {
+	Name                 string                 `json:"name"`
+	Files                []mechanicFilePlan     `json:"files"`
+	Functions            []mechanicFunctionPlan `json:"functions"`
+	Initializers         []mechanicFunctionPlan `json:"initializers"`
+	Types                []mechanicTypePlan     `json:"types"`
+	Globals              []mechanicGlobalPlan   `json:"globals"`
+	ImmutableGlobals     []string               `json:"immutable_globals,omitempty"`
+	BlankImports         []string               `json:"blank_imports"`
+	InitializationUnsafe bool                   `json:"initialization_unsafe"`
+}
+type mechanicModulePlan struct {
+	Role        string                     `json:"role"`
+	Entry       string                     `json:"entry"`
+	LinkedNodes int                        `json:"linked_nodes"`
+	Modules     []mechanicModuleDescriptor `json:"modules"`
+}
+
+func missingMechanicExprRef() mechanicExprRef {
+	return mechanicExprRef{File: -1, Decl: -1, Spec: -1, Value: -1}
+}
+func cloneMechanicImports(values map[string]string) map[string]string {
+	out := make(map[string]string, len(values))
+	for key, value := range values {
+		out[key] = value
+	}
+	return out
+}
+
+func buildMechanicModulePlan(p *ruleProgram) (mechanicModulePlan, error) {
+	return buildMechanicModulePlanRole(p, mechanicIRRootRole)
+}
+
+func buildMechanicModulePlanRole(p *ruleProgram, role string) (mechanicModulePlan, error) {
+	if p == nil || p.entry == "" {
+		return mechanicModulePlan{}, fmt.Errorf("missing source program for module plan")
+	}
+	if role != mechanicIRRootRole && role != mechanicIRDependencyRole {
+		return mechanicModulePlan{}, fmt.Errorf("invalid mechanic module plan role")
+	}
+	plan := mechanicModulePlan{Role: role, Entry: p.entry, LinkedNodes: p.linkedNodes}
+	names := make([]string, 0, len(p.modules))
+	for name := range p.modules {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	if len(names) > mechanicIRMaxNodes {
+		return plan, fmt.Errorf("module plan exceeds module budget")
+	}
+	for _, name := range names {
+		m := p.modules[name]
+		if m == nil || len(m.files) != len(m.fileNames) {
+			return plan, fmt.Errorf("module source filename mapping missing")
+		}
+		d := mechanicModuleDescriptor{Name: name, BlankImports: append([]string(nil), m.blankImports...), InitializationUnsafe: m.initializationUnsafe}
+		d.ImmutableGlobals = immutableGlobalNames(p, m)
+		m.immutableGlobals = make(map[string]bool, len(d.ImmutableGlobals))
+		for _, key := range d.ImmutableGlobals {
+			m.immutableGlobals[key] = true
+		}
+		functions := map[*ast.FuncType]mechanicFunctionPlan{}
+		types := map[ast.Expr]mechanicTypePlan{}
+		expressions := map[ast.Expr]mechanicExprRef{}
+		globalNames := map[string][4]int{}
+		envFile := map[*ruleEnv]int{}
+		for fi, f := range m.files {
+			env := m.envs[f]
+			if env == nil {
+				return plan, fmt.Errorf("module file environment missing")
+			}
+			envFile[env] = fi
+			d.Files = append(d.Files, mechanicFilePlan{Path: m.fileNames[fi], Imports: cloneMechanicImports(env.imports)})
+			for di, decl := range f.Decls {
+				switch x := decl.(type) {
+				case *ast.FuncDecl:
+					functions[x.Type] = mechanicFunctionPlan{File: fi, Decl: di}
+				case *ast.GenDecl:
+					for si, spec := range x.Specs {
+						switch s := spec.(type) {
+						case *ast.TypeSpec:
+							types[s.Type] = mechanicTypePlan{File: fi, Decl: di, Spec: si}
+						case *ast.ValueSpec:
+							for ni, id := range s.Names {
+								globalNames[id.Name] = [4]int{fi, di, si, ni}
+							}
+							if s.Type != nil {
+								expressions[s.Type] = mechanicExprRef{fi, di, si, -1}
+							}
+							for vi, expr := range s.Values {
+								expressions[expr] = mechanicExprRef{fi, di, si, vi}
+							}
+						}
+					}
+				}
+			}
+		}
+		keys := make([]string, 0, len(m.functions))
+		for key := range m.functions {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			fn := m.functions[key]
+			ref, ok := functions[fn.typ]
+			if !ok {
+				return plan, fmt.Errorf("module function declaration not indexed")
+			}
+			ref.Key, ref.Receiver, ref.ValueReceiver = key, fn.receiver, fn.valueReceiver
+			d.Functions = append(d.Functions, ref)
+		}
+		for _, fn := range m.initializers {
+			ref, ok := functions[fn.typ]
+			if !ok {
+				return plan, fmt.Errorf("module initializer not indexed")
+			}
+			d.Initializers = append(d.Initializers, ref)
+		}
+		keys = keys[:0]
+		for key := range m.types {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			ref, ok := types[m.types[key]]
+			if !ok {
+				return plan, fmt.Errorf("module type declaration not indexed")
+			}
+			ref.Key = key
+			d.Types = append(d.Types, ref)
+		}
+		keys = keys[:0]
+		for key := range m.globals {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			global := m.globals[key]
+			fi, ok := envFile[global.env]
+			if !ok {
+				return plan, fmt.Errorf("module global environment not indexed")
+			}
+			exprRef, typeRef := missingMechanicExprRef(), missingMechanicExprRef()
+			if global.expr != nil {
+				var found bool
+				exprRef, found = expressions[global.expr]
+				if !found {
+					return plan, fmt.Errorf("module global expression not indexed")
+				}
+			}
+			if global.typ != nil {
+				var found bool
+				typeRef, found = expressions[global.typ]
+				if !found {
+					return plan, fmt.Errorf("module global type not indexed")
+				}
+			}
+			nameRef, found := globalNames[key]
+			if !found {
+				return plan, fmt.Errorf("module global declaration not indexed")
+			}
+			d.Globals = append(d.Globals, mechanicGlobalPlan{Key: key, EnvFile: fi, DeclFile: nameRef[0], Decl: nameRef[1], Spec: nameRef[2], NameIndex: nameRef[3], Expr: exprRef, Type: typeRef, Constant: global.constant, Iota: global.iota})
+		}
+		plan.Modules = append(plan.Modules, d)
+	}
+	return plan, nil
+}
+
+func mechanicPlanEntry(sources map[string][]byte) (string, error) {
+	entry := ""
+	for name := range sources {
+		if path.IsAbs(name) || strings.Contains(name, "\\") || strings.Contains(name, "..") || !strings.HasSuffix(name, ".go") {
+			return "", fmt.Errorf("invalid rule source path")
+		}
+		module := gcsimImport + path.Dir(name)
+		if entry != "" && entry != module {
+			return "", fmt.Errorf("mixed rule entry packages")
+		}
+		entry = module
+	}
+	if entry == "" {
+		return "", fmt.Errorf("empty rule package")
+	}
+	return entry, nil
+}
+
+func bindMechanicModulePlan(ir MechanicIR, sources, libraries map[string][]byte, repository *ruleRepository, operations ruleOperationIndex, cache *RuleParseCache) (*ruleProgram, error) {
+	plan := ir.ModulePlan
+	if plan == nil || plan.Entry != ir.Entry || plan.Role != ir.Role || plan.Role != mechanicIRRootRole && plan.Role != mechanicIRDependencyRole || len(plan.Modules) == 0 || len(plan.Modules) > mechanicIRMaxNodes || plan.LinkedNodes < 0 || plan.LinkedNodes > maxASTNodes {
+		return nil, fmt.Errorf("mechanic module plan missing or invalid")
+	}
+	p := &ruleProgram{entry: plan.Entry, modules: map[string]*ruleModule{}, repository: repository, parseCache: cache, operations: operations, linkedNodes: plan.LinkedNodes}
+	fileSets := map[string][]*ast.File{}
+	for _, descriptor := range plan.Modules {
+		if descriptor.Name == "" || p.modules[descriptor.Name] != nil || len(descriptor.Files) == 0 || len(descriptor.Files) > 4096 {
+			return nil, fmt.Errorf("mechanic module descriptor invalid")
+		}
+		m := &ruleModule{name: descriptor.Name, envs: map[*ast.File]*ruleEnv{}, functions: map[string]*ruleFunction{}, globals: map[string]ruleGlobal{}, types: map[string]ast.Expr{}, typeEnvs: map[string]*ruleEnv{}}
+		p.modules[descriptor.Name] = m
+		for _, file := range descriptor.Files {
+			if gcsimImport+path.Dir(file.Path) != descriptor.Name {
+				return nil, fmt.Errorf("mechanic module file identity mismatch")
+			}
+			body, ok := sources[file.Path]
+			if !ok {
+				body, ok = libraries[file.Path]
+			}
+			if !ok && repository != nil {
+				body, ok = repository.files[file.Path]
+				if ok {
+					active := false
+					for _, candidate := range repository.packages[descriptor.Name] {
+						active = active || candidate == file.Path
+					}
+					if !active {
+						return nil, fmt.Errorf("mechanic module file is inactive")
+					}
+				}
+			}
+			if !ok {
+				return nil, fmt.Errorf("mechanic module source absent")
+			}
+			var f *ast.File
+			var err error
+			if cache != nil {
+				f, err = cache.loadFile(file.Path, body)
+			} else {
+				f, err = parser.ParseFile(token.NewFileSet(), file.Path, body, parser.SkipObjectResolution)
+			}
+			if err != nil {
+				return nil, err
+			}
+			imports := map[string]string{}
+			for _, imp := range f.Imports {
+				value, err := strconv.Unquote(imp.Path.Value)
+				if err != nil {
+					return nil, err
+				}
+				alias := path.Base(value)
+				if imp.Name != nil {
+					alias = imp.Name.Name
+				}
+				if alias == "." {
+					return nil, fmt.Errorf("dot import in rule")
+				}
+				if alias == "_" {
+					m.blankImports = append(m.blankImports, value)
+				}
+				imports[alias] = value
+			}
+			if len(imports) != len(file.Imports) {
+				return nil, fmt.Errorf("mechanic module import plan mismatch")
+			}
+			for alias, value := range imports {
+				if file.Imports[alias] != value {
+					return nil, fmt.Errorf("mechanic module import plan mismatch")
+				}
+			}
+			env := &ruleEnv{module: m, vars: map[string]any{}, imports: imports}
+			m.files = append(m.files, f)
+			m.fileNames = append(m.fileNames, file.Path)
+			m.envs[f] = env
+		}
+		if len(m.blankImports) != len(descriptor.BlankImports) {
+			return nil, fmt.Errorf("mechanic blank import plan mismatch")
+		}
+		for i, value := range m.blankImports {
+			if value != descriptor.BlankImports[i] {
+				return nil, fmt.Errorf("mechanic blank import plan mismatch")
+			}
+		}
+		fileSets[descriptor.Name] = m.files
+	}
+	if p.modules[p.entry] == nil {
+		return nil, fmt.Errorf("mechanic entry absent from module plan")
+	}
+	for _, descriptor := range plan.Modules {
+		m := p.modules[descriptor.Name]
+		files := fileSets[descriptor.Name]
+		functionAt := func(ref mechanicFunctionPlan) (*ruleFunction, error) {
+			if ref.File < 0 || ref.File >= len(files) || ref.Decl < 0 || ref.Decl >= len(files[ref.File].Decls) {
+				return nil, fmt.Errorf("mechanic function plan index")
+			}
+			decl, ok := files[ref.File].Decls[ref.Decl].(*ast.FuncDecl)
+			if !ok || decl.Type == nil {
+				return nil, fmt.Errorf("mechanic function plan type")
+			}
+			if ref.Key == "" {
+				if decl.Name.Name != "init" || decl.Recv != nil {
+					return nil, fmt.Errorf("mechanic initializer identity mismatch")
+				}
+			} else if decl.Recv == nil {
+				if ref.Key != decl.Name.Name || ref.Receiver != "" {
+					return nil, fmt.Errorf("mechanic function identity mismatch")
+				}
+			} else {
+				if len(decl.Recv.List) != 1 || len(decl.Recv.List[0].Names) != 1 || decl.Recv.List[0].Names[0].Name != ref.Receiver || ref.Key != ruleTypeName(decl.Recv.List[0].Type, m.envs[files[ref.File]])+"."+decl.Name.Name {
+					return nil, fmt.Errorf("mechanic method identity mismatch")
+				}
+				_, pointer := decl.Recv.List[0].Type.(*ast.StarExpr)
+				if ref.ValueReceiver == pointer {
+					return nil, fmt.Errorf("mechanic method receiver mismatch")
+				}
+			}
+			return &ruleFunction{typ: decl.Type, body: decl.Body, env: m.envs[files[ref.File]], receiver: ref.Receiver, valueReceiver: ref.ValueReceiver}, nil
+		}
+		for _, ref := range descriptor.Functions {
+			fn, err := functionAt(ref)
+			if err != nil || ref.Key == "" || m.functions[ref.Key] != nil {
+				return nil, fmt.Errorf("mechanic function plan duplicate/invalid")
+			}
+			m.functions[ref.Key] = fn
+		}
+		for _, ref := range descriptor.Initializers {
+			fn, err := functionAt(ref)
+			if err != nil {
+				return nil, err
+			}
+			m.initializers = append(m.initializers, fn)
+		}
+		initializersInSource := 0
+		for _, file := range files {
+			for _, decl := range file.Decls {
+				if fn, ok := decl.(*ast.FuncDecl); ok && fn.Recv == nil && fn.Name.Name == "init" {
+					initializersInSource++
+				}
+			}
+		}
+		if initializersInSource != len(m.initializers) {
+			return nil, fmt.Errorf("mechanic initializer plan mismatch")
+		}
+		for _, ref := range descriptor.Types {
+			if ref.File < 0 || ref.File >= len(files) || ref.Decl < 0 || ref.Decl >= len(files[ref.File].Decls) {
+				return nil, fmt.Errorf("mechanic type plan index")
+			}
+			decl, ok := files[ref.File].Decls[ref.Decl].(*ast.GenDecl)
+			if !ok || ref.Spec < 0 || ref.Spec >= len(decl.Specs) {
+				return nil, fmt.Errorf("mechanic type plan spec")
+			}
+			spec, ok := decl.Specs[ref.Spec].(*ast.TypeSpec)
+			if !ok || spec.Name.Name != ref.Key {
+				return nil, fmt.Errorf("mechanic type plan identity")
+			}
+			m.types[ref.Key] = spec.Type
+			m.typeEnvs[ref.Key] = m.envs[files[ref.File]]
+		}
+		exprAt := func(ref mechanicExprRef) (ast.Expr, error) {
+			if ref.File < 0 {
+				return nil, nil
+			}
+			if ref.File >= len(files) || ref.Decl < 0 || ref.Decl >= len(files[ref.File].Decls) {
+				return nil, fmt.Errorf("mechanic expression plan index")
+			}
+			decl, ok := files[ref.File].Decls[ref.Decl].(*ast.GenDecl)
+			if !ok || ref.Spec < 0 || ref.Spec >= len(decl.Specs) {
+				return nil, fmt.Errorf("mechanic expression plan spec")
+			}
+			spec, ok := decl.Specs[ref.Spec].(*ast.ValueSpec)
+			if !ok {
+				return nil, fmt.Errorf("mechanic expression plan declaration")
+			}
+			if ref.Value == -1 {
+				return spec.Type, nil
+			}
+			if ref.Value < 0 || ref.Value >= len(spec.Values) {
+				return nil, fmt.Errorf("mechanic expression plan value")
+			}
+			return spec.Values[ref.Value], nil
+		}
+		for _, ref := range descriptor.Globals {
+			if ref.Key == "" || m.globals[ref.Key].env != nil || ref.EnvFile < 0 || ref.EnvFile >= len(files) {
+				return nil, fmt.Errorf("mechanic global plan identity")
+			}
+			if ref.DeclFile < 0 || ref.DeclFile >= len(files) || ref.Decl < 0 || ref.Decl >= len(files[ref.DeclFile].Decls) {
+				return nil, fmt.Errorf("mechanic global declaration index")
+			}
+			decl, ok := files[ref.DeclFile].Decls[ref.Decl].(*ast.GenDecl)
+			if !ok || ref.Spec < 0 || ref.Spec >= len(decl.Specs) {
+				return nil, fmt.Errorf("mechanic global declaration spec")
+			}
+			spec, ok := decl.Specs[ref.Spec].(*ast.ValueSpec)
+			if !ok || ref.NameIndex < 0 || ref.NameIndex >= len(spec.Names) || spec.Names[ref.NameIndex].Name != ref.Key || ref.EnvFile != ref.DeclFile {
+				return nil, fmt.Errorf("mechanic global declaration identity")
+			}
+			if ref.Constant != (decl.Tok == token.CONST) || ref.Iota != ref.Spec {
+				return nil, fmt.Errorf("mechanic global declaration kind mismatch")
+			}
+			expr, err := exprAt(ref.Expr)
+			if err != nil {
+				return nil, err
+			}
+			typ, err := exprAt(ref.Type)
+			if err != nil {
+				return nil, err
+			}
+			m.globals[ref.Key] = ruleGlobal{expr: expr, typ: typ, env: m.envs[files[ref.EnvFile]], constant: ref.Constant, iota: ref.Iota}
+		}
+	}
+	for _, descriptor := range plan.Modules {
+		m := p.modules[descriptor.Name]
+		for _, fn := range m.initializers {
+			if !ruleInitializerInert(fn) && !(plan.Role == mechanicIRRootRole && m.name == p.entry && ruleEntryRegistrationOnly(fn)) {
+				m.initializationUnsafe = true
+			}
+		}
+		if m.initializationUnsafe != descriptor.InitializationUnsafe {
+			return nil, fmt.Errorf("mechanic initializer safety plan mismatch")
+		}
+		m.immutableGlobals = make(map[string]bool, len(descriptor.ImmutableGlobals))
+		for i, key := range descriptor.ImmutableGlobals {
+			if key == "" || i > 0 && descriptor.ImmutableGlobals[i-1] >= key || ast.IsExported(key) {
+				return nil, fmt.Errorf("mechanic immutable global plan order/identity mismatch")
+			}
+			g, ok := m.globals[key]
+			if !ok || g.constant || g.expr == nil || !immutableTableShape(p, g.env, g.expr) || m.initializationUnsafe || len(m.blankImports) != 0 {
+				return nil, fmt.Errorf("mechanic immutable global plan declaration mismatch")
+			}
+			m.immutableGlobals[key] = true
+		}
+	}
+	if cache != nil {
+		cache.recordMechanicFreshBind()
+	}
+	return p, nil
+}
+
+func (c *RuleParseCache) invalidateMechanicModulePlan(key string) {
+	if c == nil {
+		return
+	}
+	c.irMu.Lock()
+	delete(c.irMemory, key)
+	c.irStats.Repairs++
+	c.irMu.Unlock()
+	if c.writableDir == "" {
+		return
+	}
+	name := filepath.Join(c.writableDir, key+".gttir")
+	if info, err := os.Lstat(name); err == nil && safeRegularRuleParseCacheFile(info) {
+		_ = os.Remove(name)
+	}
+}
+
+func (c *RuleParseCache) storeMechanicModulePlan(key string, ir MechanicIR) {
+	if c == nil {
+		return
+	}
+	c.irMu.Lock()
+	c.irMemory[key] = cloneMechanicIR(ir)
+	c.irMu.Unlock()
+	if !c.mechanicCacheEnabled || c.writableDir == "" || c.writableDir == c.readOnlyBundledDir {
+		return
+	}
+	if err := writeMechanicIR(c.writableDir, key, ir); err != nil {
+		c.irMu.Lock()
+		c.irStats.Errors++
+		c.irMu.Unlock()
+		return
+	}
+	c.irMu.Lock()
+	c.irStats.Writes++
+	c.irMu.Unlock()
+	if err := cleanupMechanicIR(c.writableDir); err != nil {
+		c.irMu.Lock()
+		c.irStats.Errors++
+		c.irMu.Unlock()
+	}
+}
