+package seteffects
+
+import (
+	"runtime"
+	"runtime/debug"
+	"strings"
+	"testing"
+	"go/build"
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func TestSourceInitializationIsExplicitlyUnavailableInsteadOfZero(t *testing.T) {
+	for _,source:=range []string{
+		`var X int; func init(){X=7}; func Start()int{return X}`,
+		`var X int; func init(){X=7}; func init(){X=8}; func Start()int{return X}`,
+		`var X int; func init(){X=7; X:=2; _=X}; func Start()int{return X}`,
+		`import _ "github.com/genshinsim/gcsim/pkg/sideeffects"; func Start()int{return 1}`,
+	} {
+		v:=testRule(t,source,nil)
+		_,err:=v.entry("Start")
+		if err==nil || !strings.Contains(err.Error(),"engine-owned") { t.Fatalf("initialization silently skipped: %v",err) }
+	}
+}
+
+func TestGlobalInitializerUsesSymbolIdentityAndSharedAliasesCannotMutate(t *testing.T) {
+	v:=testRule(t,`var Values=[]float64{7}; func Start()any{return []any{Values,Values}}`,nil)
+	x,err:=v.entry("Start")
+	if err!=nil { t.Fatal(err) }
+	values:=ruleArray(x)
+	if values[0]!=values[1] { t.Fatal("global initializer was repeated under its type key instead of its symbol") }
+	for _,source:=range []string{
+		`var A=[]float64{1}; func Start(){alias:=A; alias[0]=2}`,
+		`var A=map[string]int{"x":1}; func Start(){alias:=A; alias["x"]=2}`,
+		`type Counter struct{Value int};var A=&Counter{Value:1};func Start(){alias:=A;alias.Value=2}`,
+		`func makePointer()*int{n:=1;return &n};var A=makePointer();func Start(){alias:=A;*alias=2}`,
+		`var A=func()func()int{ n:=0;return func()int{n++;return n} }();func Start()int{return A()}`,
+	} {
+		v:=testRule(t,source,nil)
+		if _,err:=v.entry("Start");err==nil { t.Fatal("mutable shared state became a wearer-local copy",source) }
+	}
+	// A genuine Go value copy may mutate its own scalar field.
+	v=testRule(t,`type Counter struct{Value int};var A=Counter{Value:1};func Start()int{local:=A;local.Value=2;return A.Value}`,nil)
+	if got,err:=v.entry("Start");err!=nil || got!=float64(1) { t.Fatal(got,err) }
+}
+
+func TestBoundBuildProfileDoesNotBorrowReleaseOrArchitectureFeatures(t *testing.T) {
+	if runtime.GOARCH!="amd64" { t.Skip("current operation profile supports amd64 explicitly") }
+	experiment:=""
+	if own,ok:=debug.ReadBuildInfo();ok { for _,s:=range own.Settings { if s.Key=="GOEXPERIMENT" { experiment=s.Value } } }
+	info:=&debug.BuildInfo{GoVersion:runtime.Version(),Settings:[]debug.BuildSetting{
+		{Key:"GOOS",Value:"windows"},{Key:"GOARCH",Value:"amd64"},{Key:"GOAMD64",Value:"v3"},{Key:"GOEXPERIMENT",Value:experiment},
+	}}
+	profile,err:=ruleBuildProfile(info)
+	if err!=nil { t.Fatal(err) }
+	if !strings.Contains(strings.Join(profile.ToolTags," "),"amd64.v3") || strings.Contains(strings.Join(profile.ToolTags," "),"amd64.v4") { t.Fatal(profile.ToolTags) }
+	info.GoVersion="go1.99.0"
+	if _,err:=ruleBuildProfile(info);err==nil { t.Fatal("unknown engine release inherited consumer release tags") }
+}
+
+func TestRepositoryDoesNotCertifyAnUnobservedGlobalFromOneReadonlyCallback(t *testing.T) {
+	v:=testRule(t,`var X=7;func Start()int{return X}`,nil)
+	profile:=build.Default
+	repository,err:=newRuleRepository(&RuleSourceRepository{Module:"github.com/genshinsim/gcsim",Files:map[string]contracts.SourceText{}},profile)
+	if err!=nil { t.Fatal(err) }
+	v.program.repository=repository
+	if _,err:=v.entry("Start");err==nil || !strings.Contains(err.Error(),"engine-owned observation") { t.Fatal("readonly callback certified shared global initialization",err) }
+}
