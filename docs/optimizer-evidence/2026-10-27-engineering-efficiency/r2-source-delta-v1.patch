+func TestMechanicIRWarmPreservesSourceSafetyBoundaries(t *testing.T) {
+	cases := []struct{ name, source, boundary string }{
+		{"multiple initializers", `package sample
+var X int
+func init() { X = 7 }
+func init() { X = 8 }
+func Start() int { return X }`, "engine-owned"},
+		{"blank import", `package sample
+import _ "github.com/genshinsim/gcsim/pkg/sideeffects"
+func Start() int { return 1 }`, "engine-owned"},
+		{"shared global mutation", `package sample
+var A = []float64{1}
+func Start() { alias := A; alias[0] = 2 }`, "engine-owned"},
+	}
+	engine := contracts.EngineBinding{ArtifactSHA256: strings.Repeat("a", 64), SourceManifestSHA256: strings.Repeat("b", 64)}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			var coldError string
+			for pass := 0; pass < 2; pass++ {
+				cache := NewRuleParseCache("", dir)
+				p, ir, origin, analysisErr, compileErr := prepareMechanicProgram(map[string][]byte{"internal/artifacts/sample/rule.go": []byte(tc.source)}, nil, nil, nil, engine, strings.Repeat("c", 64), cache)
+				if compileErr != nil || analysisErr != nil || p == nil || ir == nil {
+					t.Fatalf("pass %d prepare: %v %v", pass, analysisErr, compileErr)
+				}
+				if pass == 1 && (origin != "writable" || cache.MechanicIRStats().SemanticAnalyses != 0) {
+					t.Fatalf("pass %d did not reuse module plan: %s %#v", pass, origin, cache.MechanicIRStats())
+				}
+				_, err := newRuleVM(p, nil, 10000).entry("Start")
+				if err == nil || !strings.Contains(err.Error(), tc.boundary) {
+					t.Fatalf("pass %d boundary missing: %v", pass, err)
+				}
+				if pass == 0 {
+					coldError = err.Error()
+				} else if err.Error() != coldError {
+					t.Fatalf("boundary changed: cold %q warm %q", coldError, err)
+				}
+			}
+		})
+	}
+}
