+			{SequenceIndex: 4, CharacterIndex: 1, CharacterKey: "ordinary_actor", Kind: "burst", Source: "ordinary-burst", EnergyBefore: "60", EnergyAfter: "0", EnergyMax: "60", Amount: "60"},
