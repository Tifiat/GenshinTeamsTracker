+package setcontext
+
+import "fmt"
+
+// CaptureIntegrityError is an invalid response/binding, not an unsupported
+// mechanic. Routing must never turn it into a successful opaque/frozen result.
+type CaptureIntegrityError struct{ Err error }
+func (e *CaptureIntegrityError) Error() string { return fmt.Sprintf("capture integrity: %v",e.Err) }
+func (e *CaptureIntegrityError) Unwrap() error { return e.Err }
+
+// Only a producer with an explicit model-capability result may classify a
+// failed capture as unavailable. Ordinary engine/rotation/IO errors stay fatal.
+type CaptureUnavailableError struct{ Reason string }
+func(e *CaptureUnavailableError)Error()string{return "capture model unavailable: "+e.Reason}
+
+// WithUncertainty keeps a real target-context capture usable for proposals but
+// disables pruning and response certificates for unverified changed-item work.
+// It neither changes its numeric observations nor installs a set correction.
+func (h *Handle) WithUncertainty(reasons []string) (*Handle,error) {
+	if len(reasons)==0 { return h,nil }
+	panel,err:=h.SearchPanel()
+	if err!=nil { return nil,err }
+	view,err:=panel.CapturedUncertainView(reasons)
+	if err!=nil { return nil,err }
+	compiled:=*h.compiled
+	compiled.panel=view
+	copy:=*h
+	copy.compiled=&compiled
+	return &copy,nil
+}
