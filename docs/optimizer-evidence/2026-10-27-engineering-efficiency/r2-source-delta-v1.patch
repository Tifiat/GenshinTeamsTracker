+++ b/internal/contracts/theory_options.go
@@ -0,0 +1,85 @@
+package contracts
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+)
+
+// Constraints belong only to the virtual Theory domain. In particular they
+// never masquerade as equipped/owned artifacts or change capture's baseline.
+type TheorySearchOptions struct {
+	AllowedPackages          map[string][][]SetRequirement         `json:"allowed_packages,omitempty"`
+	MainChoices              map[string]map[string][]string        `json:"main_choices,omitempty"`
+	RollBounds               map[string]map[string]TheoryRollBound `json:"roll_bounds,omitempty"`
+	MaxPackageEvaluations    int                                   `json:"max_package_evaluations,omitempty"`
+	MaxAllocationEvaluations int                                   `json:"max_allocation_evaluations,omitempty"`
+	MaxPreviews              int                                   `json:"max_previews,omitempty"`
+	ScheduleContexts         int                                   `json:"schedule_contexts,omitempty"`
+}
+
+// Like other contract decimals, roll bounds are strings for identical Go /
+// Python request hashes (for example "18.25", never float formatting drift).
+type TheoryRollBound struct {
+	Min string `json:"min"`
+	Max string `json:"max"`
+}
+
+func (o *TheorySearchOptions) validate(wearers []Wearer) error {
+	if o == nil {
+		return nil
+	}
+	owners := map[string]bool{}
+	for _, w := range wearers {
+		owners[w.WearerKey] = true
+	}
+	for _, n := range []int{o.MaxPackageEvaluations, o.MaxAllocationEvaluations, o.MaxPreviews, o.ScheduleContexts} {
+		if n < 0 {
+			return fmt.Errorf("negative Theory work limit")
+		}
+	}
+	for owner, choices := range o.AllowedPackages {
+		if !owners[owner] || len(choices) == 0 {
+			return fmt.Errorf("invalid Theory package owner/domain %q", owner)
+		}
+		for _, p := range choices {
+			if len(p) > 2 {
+				return fmt.Errorf("Theory package must be none, 2p, 4p or 2+2")
+			}
+			for i, s := range p {
+				if s.SetUID == "" || (s.Count != 2 && s.Count != 4) || (len(p) == 2 && s.Count != 2) || (i > 0 && p[i-1].SetUID >= s.SetUID) {
+					return fmt.Errorf("noncanonical Theory package for %s", owner)
+				}
+			}
+		}
+	}
+	for owner, slots := range o.MainChoices {
+		if !owners[owner] || len(slots) == 0 {
+			return fmt.Errorf("invalid Theory main-stat owner %q", owner)
+		}
+		for slot, values := range slots {
+			if len(values) == 0 || (slot != "flower" && slot != "plume" && slot != "sands" && slot != "goblet" && slot != "circlet") {
+				return fmt.Errorf("invalid Theory main-stat domain")
+			}
+		}
+	}
+	for owner, stats := range o.RollBounds {
+		if !owners[owner] || len(stats) == 0 {
+			return fmt.Errorf("invalid Theory roll owner %q", owner)
+		}
+		for _, bounds := range stats {
+			lo, e := strconv.ParseFloat(bounds.Min, 64)
+			if e != nil {
+				return fmt.Errorf("invalid Theory roll minimum")
+			}
+			hi, e := strconv.ParseFloat(bounds.Max, 64)
+			if e != nil {
+				return fmt.Errorf("invalid Theory roll maximum")
+			}
+			if math.IsNaN(lo) || math.IsInf(lo, 0) || math.IsNaN(hi) || math.IsInf(hi, 0) || lo < 0 || hi < lo || hi > 45 {
+				return fmt.Errorf("invalid Theory roll bounds")
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/contracts/theory_options_test.go b/internal/contracts/theory_options_test.go
new file mode 100644
