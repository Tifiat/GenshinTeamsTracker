+func TestResponseCombinedUsesAllDirectionsAndKeepsFormulaInvisibleGain(t *testing.T) {
+	request, compact := searchFixtures(t)
+	alternative := request.Artifacts[4]
+	alternative.ArtifactID = 99001
+	// Healing bonus is a circlet main, never a flower substat. The toy
+	// formula observes HP%, not CD: replace the old HP% line with DEF so
+	// it truly disfavors this healing candidate instead of merely tying it.
+	alternative.MainStat = contracts.StatValue{Key: "healing_bonus", Value: "0.359"}
+	alternative.Substats = []contracts.StatValue{
+		{Key: "atk_percent", Value: "0.058"},
+		{Key: "crit_rate", Value: "0.097"},
+		{Key: "def", Value: "23.15"},
+		{Key: "em", Value: "16"},
+	}
+	request.Artifacts = append(request.Artifacts, alternative)
+	engine, indexed := combinedResponseTestEngine(t, request, compact)
+	anchor := indexed.Incumbent
+	anchorDPS, err := engine.score(anchor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	directions := []supportimpact.Direction{
+		{Owner: "actor_a", Stat: "hp_percent", Amount: 0.2, MeanDPSChange: 1, Status: "positive_on_sampled_seeds", ConfigSHA256: "hp-config"},
+		{Owner: "actor_a", Stat: "healing_bonus", Amount: 0.1, MeanDPSChange: 2, Status: "positive_on_sampled_seeds", ConfigSHA256: "heal-config"},
+	}
+	out, err := engine.ProposeCombinedResponseDirections(context.Background(), anchor, directions, 2, 1000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(out.Proposals) != 1 || out.FormulaEvaluations != 1 || out.DirectionsConsidered != 2 || out.DirectionsDeferred != 0 {
+		t.Fatalf("combined directions were not consumed as one owner model: %#v", out)
+	}
+	proposal := out.Proposals[0]
+	if proposal.Owner != "actor_a" || proposal.Candidate.Source != "measured_stat_response_combined_proposal" ||
+		proposal.Candidate.Assignment[0][4] != alternative.ArtifactID {
+		t.Fatalf("combined endpoint did not select the joint HP/healing piece: %#v", proposal)
+	}
+	if proposal.Candidate.DPS >= anchorDPS {
+		t.Fatalf("formula ranking should disfavor this formula-invisible measured proposal: anchor=%g proposal=%g", anchorDPS, proposal.Candidate.DPS)
+	}
+	if proposal.Candidate.DPS, err = engine.score(proposal.Candidate.Assignment); err != nil || proposal.Candidate.DPS >= anchorDPS {
+		t.Fatalf("proposal did not retain its original formula score: %#v %v", proposal, err)
+	}
+	if err := indexed.ValidateAssignment(proposal.Candidate.Assignment); err != nil {
+		t.Fatalf("combined endpoint is physically illegal: %v", err)
+	}
+	for actor := 1; actor < 4; actor++ {
+		if proposal.Candidate.Assignment[actor] != anchor[actor] {
+			t.Fatalf("individual endpoint changed actor %d", actor)
+		}
