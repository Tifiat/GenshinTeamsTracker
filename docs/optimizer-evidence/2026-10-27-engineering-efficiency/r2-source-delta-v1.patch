+func TestNeutralRepresentativeProjectionMatchesLegacyAtEveryPrefix(t *testing.T) {
+	events := representativeProjectionEvents()
+	groupLimits := []int{1, 2, 3, 7, 50, 101}
+	for alternatives := -1; alternatives <= contracts.MaxResultBuildsPerGroup; alternatives++ {
+		display := newResultArchive(alternatives)
+		core := newResultArchive(1)
+		for prefix, candidate := range events {
+			display.offer(candidate)
+			core.offer(candidate)
+			for _, limit := range groupLimits {
+				// This is the old stabilization rule: a separate one-row archive,
+				// followed by the same finalist chooser.
+				label := fmt.Sprintf("alternatives=%d prefix=%d groups=%d", alternatives, prefix+1, limit)
+				wantRepresentatives := core.top(limit)
+				assertRepresentativeCandidatesEqual(t, display.topRepresentatives(limit), wantRepresentatives, label+" representatives")
+				want := chooseFinalists(wantRepresentatives, limit)
+				got := neutralStabilizationFinalists(display, limit)
+				assertRepresentativeCandidatesEqual(t, got, want, label)
+			}
+		}
+		if _, exists := display.groups[packageIdentity(representativeProjectionPackages("invalid"))]; exists {
+			t.Fatalf("rejected nil-context/NaN/infinite records created a group at alternatives=%d", alternatives)
+		}
+		if alternatives == contracts.MaxResultBuildsPerGroup {
+			if got := len(display.groups[packageIdentity(representativeProjectionPackages("bulk"))]); got != contracts.MaxResultBuildsPerGroup {
+				t.Fatalf("full-boundary group retained %d rows, want %d", got, contracts.MaxResultBuildsPerGroup)
+			}
+		}
+	}
+}
