+package engineclient
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func validateNeutralHealthRoots(n *contracts.NeutralInputs, nodes irNodeLookup, ownerCount int) error {
+	if n.Ledger.Truncated && len(n.HealthRoots) != 0 { return fmt.Errorf("truncated health event ledger") }
+	if len(n.HealthRoots) > 600000 { return fmt.Errorf("health root budget exceeded") }
+	events := map[string]contracts.CombatEvent{}
+	for _, event := range n.Ledger.Events {
+		if event.HealthOperationID == "" { continue }
+		if _, exists := events[event.HealthOperationID]; exists { return fmt.Errorf("duplicate health event operation") }
+		if len(event.Arguments) != 5 || event.Arguments[0].Kind != "object" || event.Arguments[0].Type != "*github.com/genshinsim/gcsim/pkg/core/info.HealInfo" {
+			return fmt.Errorf("health event request kind mismatch")
+		}
+		target := event.Arguments[1]
+		if target.Kind != "number" || target.Type != "int" || target.Number != math.Trunc(target.Number) || target.Number < 0 || target.Number >= float64(ownerCount) { return fmt.Errorf("health event target mismatch") }
+		events[event.HealthOperationID] = event
+	}
+	seen := map[[2]string]bool{}
+	for _, root := range n.HealthRoots {
+		event, exists := events[root.OperationID]
+		_, nodeExists := nodes.get(root.NodeID)
+		key := [2]string{root.OperationID, root.Field}
+		value, err := strconv.ParseFloat(root.Observed, 64)
+		if !exists || root.OperationID == "" || root.Kind != "heal" || seen[key] || !nodeExists || root.NodeID == 0 || err != nil || math.IsNaN(value) || math.IsInf(value, 0) || root.Uncertainty == nil || (root.Bound && len(root.Uncertainty) != 0) || root.TargetIndex != int(event.Arguments[1].Number) || root.EventOrder != event.Order || root.Frame != event.Frame { return fmt.Errorf("invalid neutral health root identity") }
+		observed, ok := neutralHealthObserved(event, root.Field)
+		if !ok || math.Abs(observed-value) > 1e-9*math.Max(1, math.Max(math.Abs(value), math.Abs(observed))) { return fmt.Errorf("neutral health root witness mismatch") }
+		seen[key] = true
+	}
+	for id := range events {
+		for _, field := range []string{"input_value", "source_bonus", "raw_amount", "event_amount", "event_effective_amount", "overheal"} {
+			if !seen[[2]string{id, field}] { return fmt.Errorf("missing neutral health operand root") }
+		}
+	}
+	return nil
+}
+
+func neutralHealthObserved(event contracts.CombatEvent, field string) (float64, bool) {
+	if len(event.Arguments) != 5 { return 0, false }
+	var value contracts.EventValue
+	switch field {
+	case "input_value": value = event.Arguments[0].Fields["Src"]
+	case "source_bonus": value = event.Arguments[0].Fields["Bonus"]
+	case "raw_amount": value = event.Arguments[4]
+	case "event_amount": value = event.Arguments[2]
+	case "overheal": value = event.Arguments[3]
+	case "event_effective_amount":
+		a, ok := neutralHealthObserved(event, "event_amount"); if !ok { return 0, false }
+		b, ok := neutralHealthObserved(event, "overheal"); if !ok { return 0, false }
+		return math.Max(a-b, 0), true
+	default: return 0, false
+	}
+	return value.Number, value.Kind == "number" && value.Type == "float64" && !math.IsNaN(value.Number) && !math.IsInf(value.Number, 0)
+}
