+			first, err := s.First(ctx, s.cfg.Binding)
+			if err != nil {
+				t.Fatal(err)
+			}
+			outputCheckLiveSnapshot(t, first, s.cfg)
+			snapshots := []Snapshot{first}
+			frozen := []string{outputJSON(t, first)}
+			assertFrozen := func() {
+				t.Helper()
+				for i, snapshot := range snapshots {
+					if outputJSON(t, snapshot) != frozen[i] {
+						t.Fatalf("%s mutated publication %d nested contents", mode, i)
+					}
+				}
+			}
+			if mode == "breadth-deep-finish" || strings.HasSuffix(mode, "deep") {
+				breadth, err := s.Breadth(ctx, s.cfg.Binding)
+				if err != nil {
+					t.Fatal(err)
+				}
+				outputCheckLiveSnapshot(t, breadth, s.cfg)
+				if breadth.SnapshotVersion <= first.SnapshotVersion {
+					t.Fatal("breadth snapshot version did not increase")
+				}
+				snapshots, frozen = append(snapshots, breadth), append(frozen, outputJSON(t, breadth))
+				assertFrozen()
+			}
+			sentinel := errors.New("live output continuation failure")
+			version := s.version
+			switch mode {
+			case "breadth-deep-finish":
+				deep, err := s.Deep(ctx, s.cfg.Binding)
+				if err != nil {
+					t.Fatal(err)
+				}
+				outputCheckLiveSnapshot(t, deep, s.cfg)
+				if deep.SnapshotVersion <= snapshots[len(snapshots)-1].SnapshotVersion {
+					t.Fatal("deep snapshot version did not increase")
+				}
+				snapshots, frozen = append(snapshots, deep), append(frozen, outputJSON(t, deep))
+				assertFrozen()
+				terminal, err := s.Finish()
+				if err != nil {
+					t.Fatal(err)
+				}
+				outputCheckLiveSnapshot(t, terminal, s.cfg)
+				if !terminal.FinishedEarly || terminal.SnapshotVersion <= deep.SnapshotVersion {
+					t.Fatal("Finish did not publish a distinct terminal version")
+				}
+			case "cancel-breadth", "cancel-deep":
+				cancelled, cancel := context.WithCancel(ctx)
+				cancel()
+				var out Snapshot
+				if mode == "cancel-breadth" {
+					out, err = s.Breadth(cancelled, s.cfg.Binding)
+				} else {
+					out, err = s.Deep(cancelled, s.cfg.Binding)
+				}
+				if !errors.Is(err, context.Canceled) || out.Status == "success" || out.FinishedEarly || s.version != version {
+					t.Fatal("Cancel returned/published terminal success")
+				}
+				// Session.Finish also serves the CLI's explicit soft-Finish path.
+				// Actual Cancel-versus-soft-Finish intent is gated at the CLI seam.
+			case "failure-breadth", "failure-deep":
+				world.failResolve = sentinel
+				s.preDeep.world.(*outputLiveWorld).failResolve = sentinel
+				var out Snapshot
+				if mode == "failure-breadth" {
+					out, err = s.Breadth(ctx, s.cfg.Binding)
+				} else {
+					out, err = s.Deep(ctx, s.cfg.Binding)
+				}
+				if !errors.Is(err, sentinel) || out.Status == "success" || s.version != version {
+					t.Fatal("failed action published a successful snapshot")
+				}
+				if out, err = s.Finish(); !errors.Is(err, sentinel) || out.Status == "success" {
+					t.Fatal("fatal failure became terminal success")
+				}
+			case "binding-failure":
+				out, err := s.Deep(ctx, "changed-binding")
+				if !errors.Is(err, ErrBindingChanged) || out.Status == "success" || s.version != version {
+					t.Fatal("binding invalidation published success")
+				}
+				if out, err = s.Finish(); !errors.Is(err, ErrBindingChanged) || out.Status == "success" {
+					t.Fatal("binding invalidation became terminal success")
+				}
+			}
+			assertFrozen()
+			s.Close()
+			assertFrozen()
+			outputCheckLiveClosed(t, ledger)
+		})
+	}
+}
+
+func outputLiveOwnedFingerprint(t *testing.T, s *Session) string {
+	t.Helper()
+	witnesses, scores := map[string]alloc.State{}, map[string]float64{}
+	for family, row := range s.archive.pool {
+		witnesses[family], scores[family] = row.state, row.value
+	}
+	return outputJSON(t, struct {
+		Config      Config
+		Witnesses   map[string]alloc.State
+		Scores      map[string]float64
+		Aliases     map[string]map[string]Alias
+		Unavailable map[string]Unavailable
+		Refined     map[string]int
+		Visited     map[string]string
+	}{s.cfg, witnesses, scores, s.archive.aliases, s.archive.unavailable, s.archive.refined, s.archive.visited})
+}
+
+func outputCorruptExposedSnapshot(out *Snapshot) {
+	for _, rows := range [][]FamilyRow{out.CoLeaders, out.Pending} {
+		for i := range rows {
+			row := &rows[i]
+			row.Witness45.Mains[0][0], row.Witness45.Lines[0][0][0], row.Witness45.Upgrades[0][0][0] = "foreign-main", -1, -1
+			row.Allocations[0].WearerKey = "foreign-owner"
+			row.Allocations[0].MainStats["flower"] = "foreign-main"
+			row.Allocations[0].Substats[0].StatKey = "foreign-stat"
+			row.Allocations[0].Substats[0].RollUnits, row.Allocations[0].Substats[0].StatValue = -1, -1
+			for j := range row.Aliases {
+				alias := &row.Aliases[j]
+				alias.Packages[0].WearerKey, alias.Packages[0].Sets[0].SetUID, alias.Packages[0].Sets[0].Count = "foreign-owner", "foreign-set", 2
+				alias.ContextSHA256, alias.Uncertainty[0] = "foreign-context", "foreign-uncertainty"
+			}
+		}
+	}
+	for i := range out.Unavailable {
+		out.Unavailable[i].Packages[0].WearerKey = "foreign-owner"
+		out.Unavailable[i].Packages[0].Sets[0].SetUID = "foreign-set"
+		out.Unavailable[i].Reasons[0] = "foreign-reason"
+	}
+	out.Rules["all_found_aliases"] = false
+}
+
+func TestTheoryOutputContractLiveExposedMutationCannotReachSession(t *testing.T) {
+	s, _, ledger := newOutputLiveSession(t)
+	defer s.Close()
+	ctx := context.Background()
+	first, err := s.First(ctx, s.cfg.Binding)
+	if err != nil {
+		t.Fatal(err)
+	}
+	outputCheckLiveSnapshot(t, first, s.cfg)
+	firstBytes, owned := outputJSON(t, first), outputLiveOwnedFingerprint(t, s)
+	outputCorruptExposedSnapshot(&first)
+	if outputLiveOwnedFingerprint(t, s) != owned {
+		t.Fatal("consumer mutation reached session-owned nested data")
+	}
+	again := s.publish(false)
+	version := again.SnapshotVersion
+	again.SnapshotVersion = first.SnapshotVersion
+	if outputJSON(t, again) != firstBytes {
+		t.Fatal("consumer mutation reached a separately published snapshot")
+	}
+	again.SnapshotVersion = version
+	againBytes := outputJSON(t, again)
+	breadth, err := s.Breadth(ctx, s.cfg.Binding)
+	if err != nil {
+		t.Fatal(err)
+	}
+	outputCheckLiveSnapshot(t, breadth, s.cfg)
+	owned = outputLiveOwnedFingerprint(t, s)
+	outputCorruptExposedSnapshot(&breadth)
+	if outputLiveOwnedFingerprint(t, s) != owned {
+		t.Fatal("breadth result mutation reached session-owned nested data")
+	}
+	deep, err := s.Deep(ctx, s.cfg.Binding)
+	if err != nil {
+		t.Fatal(err)
+	}
+	outputCheckLiveSnapshot(t, deep, s.cfg)
+	deepBytes, owned := outputJSON(t, deep), outputLiveOwnedFingerprint(t, s)
+	terminal, err := s.Finish()
+	if err != nil {
+		t.Fatal(err)
+	}
+	outputCheckLiveSnapshot(t, terminal, s.cfg)
+	outputCorruptExposedSnapshot(&terminal)
+	if outputLiveOwnedFingerprint(t, s) != owned || outputJSON(t, deep) != deepBytes || outputJSON(t, again) != againBytes {
+		t.Fatal("terminal result mutation reached the archive or an earlier immutable publication")
+	}
+	outputCheckLiveClosed(t, ledger)
+}
+
+func TestTheoryOutputContractLiveConfigIsOwnedBeforeFirst(t *testing.T) {
+	cfg := outputLiveConfig()
+	ledger := &outputLiveLedger{}
+	world := &outputLiveWorld{ledger: ledger}
+	ledger.worlds = append(ledger.worlds, world)
+	s, err := New(cfg, world)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	owned := outputJSON(t, s.cfg)
+	cfg.Domains[0][0].Sets[0].SetUID = "foreign-domain"
+	cfg.Original[2].Sets[0].SetUID = "foreign-original"
+	cfg.Initial.Mains[0][0], cfg.Initial.Lines[0][0][0], cfg.Initial.Upgrades[0][0][0] = "foreign-main", -1, -1
+	if outputJSON(t, s.cfg) != owned {
+		t.Fatal("caller retained mutable session config ownership")
+	}
+	first, err := s.First(context.Background(), s.cfg.Binding)
+	if err != nil {
+		t.Fatal(err)
+	}
+	outputCheckLiveSnapshot(t, first, s.cfg)
+	s.Close()
+	outputCheckLiveClosed(t, ledger)
+}
diff --git a/internal/theorysearch/publication_refine_test.go b/internal/theorysearch/publication_refine_test.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/publication_refine_test.go
@@ -0,0 +1,137 @@
+package theorysearch
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+)
+
+// A legal fixed-package objective with a paired-main basin. Each single change
+// is worse; changing both wins. No engine, gameplay rule or archived build.
+type publicationPairWorld struct {
+	resolves    int
+	cancel      context.CancelFunc
+	evaluations int
+}
+
+func (w *publicationPairWorld) Resolve(ctx context.Context, p [4]domain.Package) (*Entry, []string, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	w.resolves++
+	family := p[0].Sets[0].SetUID
+	base := map[string]float64{"pair_a": 1000, "pair_b": 900, "pair_c": 800}[family]
+	return &Entry{Family: family, Objective: func(s alloc.State, _ bool) (float64, [4][10]float64, error) {
+		w.evaluations++
+		if w.cancel != nil && w.evaluations == 5 {
+			w.cancel()
+		}
+		goblet, circlet := s.Mains[0][3] == "def_percent", s.Mains[0][4] == "healing_bonus"
+		value := base
+		if goblet && circlet {
+			value += 100
+		} else if goblet || circlet {
+			value -= 10
+		}
+		return value, [4][10]float64{}, nil
+	}}, nil, nil
+}
+func (w *publicationPairWorld) Fork() (Resolver, error) { copy := *w; return &copy, nil }
+func (*publicationPairWorld) Close()                    {}
+
+func publicationPairFixture() (*branch, Config, *publicationPairWorld) {
+	w := &publicationPairWorld{}
+	var mains [4][5]string
+	for a := range mains {
+		mains[a] = [5]string{"hp", "atk", "atk_percent", "atk_percent", "crit_rate"}
+	}
+	initial := alloc.Seed(mains, [4][10]float64{}, 0, 45)
+	b := newBranch(w, initial)
+	cfg := Config{Initial: initial, Wearers: [4]string{"owner_a", "owner_b", "owner_c", "owner_d"}}
+	for i, family := range []string{"pair_a", "pair_b", "pair_c"} {
+		var p [4]domain.Package
+		p[0] = sessionFixturePackage(family)
+		b.offer(candidate{packages: p, state: initial, value: 1000 - float64(i)*100, family: family})
+		b.refined[family] = 2 // Earlier light/deep work must not suppress this phase.
+	}
+	return b, cfg, w
+}
+
+func TestFirstPublicationMainPairsEscapeBasinWithFixedFamilyLimit(t *testing.T) {
+	b, cfg, w := publicationPairFixture()
+	if err := b.refinePublication(context.Background(), cfg); err != nil {
+		t.Fatal(err)
+	}
+	if w.resolves != 2 || b.work.PublicationRefinements != 2 || b.work.PublicationPairCandidates <= 0 {
+		t.Fatalf("publication refinement did not retain its fixed work bound: %+v resolves=%d", b.work, w.resolves)
+	}
+	for family, want := range map[string]float64{"pair_a": 1100, "pair_b": 1000, "pair_c": 800} {
+		row := b.pool[family]
+		if row.value != want {
+			t.Fatalf("%s score=%v want=%v", family, row.value, want)
+		}
+		if err := alloc.ValidateFull45(row.state); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if b.work.Formula != w.evaluations {
+		t.Fatal("publication objective work was not counted")
+	}
+}
+
+func TestFirstPublicationRefinementHonorsCancellationAndKeepsIncumbents(t *testing.T) {
+	for _, cancelDuring := range []bool{false, true} {
+		b, cfg, w := publicationPairFixture()
+		ctx, cancel := context.WithCancel(context.Background())
+		if cancelDuring {
+			w.cancel = cancel
+		} else {
+			cancel()
+		}
+		err := b.refinePublication(ctx, cfg)
+		cancel()
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("cancelDuring=%v err=%v", cancelDuring, err)
+		}
+		if b.work.PublicationRefinements > 1 {
+			t.Fatal("cancellation admitted another family")
+		}
+		for family, minimum := range map[string]float64{"pair_a": 1000, "pair_b": 900, "pair_c": 800} {
+			if b.pool[family].value < minimum {
+				t.Fatal("cancellation lost an incumbent")
+			}
+			if err := alloc.ValidateFull45(b.pool[family].state); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
+
+func TestFirstPublicationRefinementIsWiredOnceBeforeCheckpoint(t *testing.T) {
+	cfg, spec := sessionFixtureConfig(t, [4]int{1, 1, 1, 1})
+	w, _ := newSessionFixtureWorld(spec)
+	s, err := New(cfg, w)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	if _, err = s.First(context.Background(), cfg.Binding); err != nil {
+		t.Fatal(err)
+	}
+	count := s.active.work.PublicationRefinements
+	if count != 1 || s.preDeep.work.PublicationRefinements != count {
+		t.Fatal("first publication checkpoint did not include its bounded refinement")
+	}
+	if _, err = s.First(context.Background(), cfg.Binding); err == nil {
+		t.Fatal("first publication was admitted twice")
+	}
+	if s.active.work.PublicationRefinements != count {
+		t.Fatal("rejected phase repeated refinement")
+	}
+	if _, err = s.Finish(); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/theorysearch/result.go b/internal/theorysearch/result.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/result.go
@@ -0,0 +1,194 @@
+package theorysearch
+
+import (
+	"math"
+	"math/big"
+	"sort"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theory"
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+)
+
+const ResultKind = "gtt_gcsim_optimizer_theory_result_v2"
+const PracticalBandPercent = 3.0
+const SensitivityBandPercent = 2.0
+
+type PackageRow struct {
+	WearerKey string                     `json:"wearer_key"`
+	Sets      []contracts.SetRequirement `json:"sets"`
+}
+type Alias struct {
+	TupleKey      string       `json:"tuple_key"`
+	Packages      []PackageRow `json:"packages"`
+	ContextSHA256 string       `json:"context_sha256"`
+	Uncertainty   []string     `json:"uncertainty"`
+}
+type Unavailable struct {
+	TupleKey string       `json:"tuple_key"`
+	Packages []PackageRow `json:"packages"`
+	Reasons  []string     `json:"reasons"`
+}
+type FamilyRow struct {
+	Family          string                    `json:"family"`
+	FormulaDPS      float64                   `json:"formula_dps"`
+	Witness45       alloc.State               `json:"witness45"`
+	Allocations     []theory.WearerAllocation `json:"allocations"`
+	Aliases         []Alias                   `json:"aliases"`
+	DeficitPercent  float64                   `json:"deficit_percent"`
+	RefinementLevel int                       `json:"refinement_level"`
+	Reason          string                    `json:"reason,omitempty"`
+}
+type Snapshot struct {
+	SchemaVersion            int            `json:"schema_version"`
+	SchemaKind               string         `json:"schema_kind"`
+	RequestSHA256            string         `json:"request_sha256"`
+	SessionID                string         `json:"session_id"`
+	SnapshotVersion          int64          `json:"snapshot_version"`
+	Phase                    string         `json:"phase"`
+	PolicyID                 string         `json:"policy_id"`
+	Status                   string         `json:"status"`
+	SearchStatus             string         `json:"search_status"`
+	ResponseStatus           string         `json:"response_status"`
+	FinishedEarly            bool           `json:"finished_early"`
+	ReferenceScore           float64        `json:"reference_score"`
+	PracticalBandPercent     float64        `json:"practical_band_percent"`
+	SensitivityBandPercent   float64        `json:"sensitivity_band_percent"`
+	CoLeaders                []FamilyRow    `json:"co_leaders"`
+	Pending                  []FamilyRow    `json:"pending"`
+	Unavailable              []Unavailable  `json:"unavailable"`
+	TotalFoundFamilies       int            `json:"total_found_families"`
+	TotalFoundTuples         int            `json:"total_found_tuples"`
+	FoundGroupFamilies       int            `json:"found_group_families"`
+	FoundGroupTuples         int            `json:"found_group_tuples"`
+	SensitivityGroupFamilies int            `json:"sensitivity_group_families"`
+	SensitivityGroupTuples   int            `json:"sensitivity_group_tuples"`
+	DomainTuples             string         `json:"domain_tuples"`
+	UnseenTuples             string         `json:"unseen_tuples"`
+	FullCartesianCovered     bool           `json:"full_cartesian_covered"`
+	SourceUpper              string         `json:"source_upper"`
+	OuterUpper               string         `json:"outer_upper"`
+	Work                     Work           `json:"active_branch_work"`
+	Rules                    map[string]any `json:"rules"`
+}
+
+func packageRows(p [4]domain.Package, wearers [4]string) []PackageRow {
+	rows := make([]PackageRow, 4)
+	for a := range p {
+		rows[a] = PackageRow{wearers[a], append([]contracts.SetRequirement{}, p[a].Sets...)}
+	}
+	return rows
+}
+func clonePackageRows(rows []PackageRow) []PackageRow {
+	out := make([]PackageRow, len(rows))
+	for i, r := range rows {
+		out[i] = r
+		out[i].Sets = append([]contracts.SetRequirement{}, r.Sets...)
+	}
+	return out
+}
+func cloneAlias(a Alias) Alias {
+	a.Packages = clonePackageRows(a.Packages)
+	a.Uncertainty = append([]string{}, a.Uncertainty...)
+	return a
+}
+func cloneUnavailable(u Unavailable) Unavailable {
+	u.Packages = clonePackageRows(u.Packages)
+	u.Reasons = append([]string{}, u.Reasons...)
+	return u
+}
+func allocations(s alloc.State, wearers [4]string) []theory.WearerAllocation {
+	slots := [5]string{"flower", "plume", "sands", "goblet", "circlet"}
+	keys, values := alloc.StatKeys(), alloc.StatValues()
+	rolls := s.Rolls()
+	rows := make([]theory.WearerAllocation, 4)
+	for a := range rows {
+		r := theory.WearerAllocation{WearerKey: wearers[a], MainStats: map[string]string{}, Substats: []theory.StatAllocation{}}
+		for slot, key := range s.Mains[a] {
+			r.MainStats[slots[slot]] = key
+		}
+		for j, u := range rolls[a] {
+			r.Substats = append(r.Substats, theory.StatAllocation{StatKey: keys[j], RollUnits: u, StatValue: u * values[j]})
+			r.SpentRollUnits += u
+		}
+		r.UnspentRollUnits = 45 - r.SpentRollUnits
+		rows[a] = r
+	}
+	return rows
+}
+
+// AllocationsForWitness shares the existing display projection with verified
+// full-build proposals. It changes neither search nor its numerical policy.
+func AllocationsForWitness(s alloc.State, wearers [4]string) ([]theory.WearerAllocation, error) {
+	if err := alloc.ValidateFull45(s); err != nil {
+		return nil, err
+	}
+	return allocations(s, wearers), nil
+}
+func deficit(reference, score float64) float64 {
+	if reference == 0 {
+		if score == 0 {
+			return 0
+		}
+		return 100
+	}
+	return 100 * (reference - score) / math.Abs(reference)
+}
+func (s *Session) publish(terminal bool) Snapshot {
+	s.version++
+	out := Snapshot{SchemaVersion: 2, SchemaKind: ResultKind, RequestSHA256: s.cfg.RequestSHA256, SessionID: s.cfg.SessionID,
+		SnapshotVersion: s.version, Phase: s.phase, PolicyID: PolicyID, Status: "success", SearchStatus: "partial", ResponseStatus: "formula_only",
+		PracticalBandPercent: PracticalBandPercent, SensitivityBandPercent: SensitivityBandPercent,
+		CoLeaders: []FamilyRow{}, Pending: []FamilyRow{}, Unavailable: []Unavailable{}, SourceUpper: "unbounded", OuterUpper: "unbounded"}
+	if out.Phase == "" {
+		out.Phase = "first_light"
+	}
+	out.FinishedEarly = terminal
+	out.Work = s.active.work
+	rows := sorted(s.archive.pool)
+	if len(rows) > 0 {
+		out.ReferenceScore = rows[0].value
+	}
+	for _, c := range rows {
+		r := FamilyRow{Family: c.family, FormulaDPS: c.value, Witness45: c.state, Allocations: allocations(c.state, s.cfg.Wearers),
+			DeficitPercent: deficit(out.ReferenceScore, c.value), RefinementLevel: s.archive.refined[c.family], Aliases: []Alias{}}
+		for _, a := range s.archive.aliases[c.family] {
+			r.Aliases = append(r.Aliases, cloneAlias(a))
+		}
+		sort.Slice(r.Aliases, func(i, j int) bool { return r.Aliases[i].TupleKey < r.Aliases[j].TupleKey })
+		out.TotalFoundFamilies++
+		out.TotalFoundTuples += len(r.Aliases)
+		if r.DeficitPercent <= PracticalBandPercent+1e-12 {
+			out.CoLeaders = append(out.CoLeaders, r)
+			out.FoundGroupFamilies++
+			out.FoundGroupTuples += len(r.Aliases)
+		} else {
+			r.Reason = "below_practical_band"
+			if r.RefinementLevel < 2 {
+				r.Reason = "below_practical_band_not_deeply_refined"
+			}
+			out.Pending = append(out.Pending, r)
+		}
+		if r.DeficitPercent <= SensitivityBandPercent+1e-12 {
+			out.SensitivityGroupFamilies++
+			out.SensitivityGroupTuples += len(r.Aliases)
+		}
+	}
+	for _, u := range s.archive.unavailable {
+		out.Unavailable = append(out.Unavailable, cloneUnavailable(u))
+	}
+	sort.Slice(out.Unavailable, func(i, j int) bool { return out.Unavailable[i].TupleKey < out.Unavailable[j].TupleKey })
+	total := big.NewInt(1)
+	for _, rows := range s.cfg.Domains {
+		total.Mul(total, big.NewInt(int64(len(rows))))
+	}
+	remaining := new(big.Int).Sub(total, big.NewInt(int64(len(s.archive.visited))))
+	out.DomainTuples = total.String()
+	out.UnseenTuples = remaining.String()
+	out.FullCartesianCovered = remaining.Sign() == 0
+	out.Rules = map[string]any{"budget_roll_units_per_wearer": 45, "quarter_grid": true, "all_found_aliases": true,
+		"reference_scope": "best_attained_across_found_branches", "practical_group_rank": "unordered_equivalent_group",
+		"full_search_optimality_proved": false, "final_solution_cache_enabled": false}
+	return out
+}
diff --git a/internal/theorysearch/search.go b/internal/theorysearch/search.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/search.go
@@ -0,0 +1,528 @@
+// Package theorysearch owns the resumable H-light / common-H catalog policy.
+// It publishes feasible lower witnesses, never a Cartesian optimum claim.
+package theorysearch
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"math"
+	"sort"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theorypackages"
+)
+
+const PolicyID = "theory_h_light_common_h_20261010_v1"
+
+type Entry struct {
+	Family        string
+	ContextSHA256 string
+	Uncertainty   []string
+	Objective     alloc.Objective
+}
+
+// Fork must retain exact arithmetic identity and copy all mutable evaluator,
+// route/cache, FIFO and counter state. No resolver may capture another engine
+// universe while resolving, forking, or continuing a session.
+type Resolver interface {
+	Resolve(context.Context, [4]domain.Package) (*Entry, []string, error)
+	Fork() (Resolver, error)
+	Close()
+}
+
+type Config struct {
+	Binding       string
+	RequestSHA256 string
+	SessionID     string
+	Wearers       [4]string
+	Initial       alloc.State
+	Original      [4]domain.Package
+	Domains       [4][]domain.Package
+}
+
+type candidate struct {
+	packages [4]domain.Package
+	state    alloc.State
+	value    float64
+	family   string
+}
+
+type Work struct {
+	Formula                   int `json:"formula_evaluations"`
+	Gradient                  int `json:"gradient_evaluations"`
+	AllocationAttempts        int `json:"allocation_attempts"`
+	AliasHits                 int `json:"tuple_alias_hits"`
+	CompletedPasses           int `json:"completed_catalog_passes"`
+	DeepBundles               int `json:"completed_deep_bundles"`
+	CompletedSweeps           int `json:"completed_catalog_sweeps"`
+	IndependentStarts         int `json:"independent_starts"`
+	TransferredStarts         int `json:"transferred_starts"`
+	PublicationRefinements    int `json:"publication_main_refinements"`
+	PublicationPairCandidates int `json:"publication_pair_candidates"`
+}
+
+type branch struct {
+	world       Resolver
+	initial     alloc.State
+	pool        map[string]candidate
+	aliases     map[string]map[string]Alias
+	unavailable map[string]Unavailable
+	screened    map[string]bool
+	visited     map[string]string
+	refined     map[string]int
+	bank        []candidate
+	starts      []candidate
+	work        Work
+}
+
+func newBranch(w Resolver, initial alloc.State) *branch {
+	return &branch{world: w, initial: initial, pool: map[string]candidate{},
+		aliases: map[string]map[string]Alias{}, unavailable: map[string]Unavailable{},
+		screened: map[string]bool{}, visited: map[string]string{}, refined: map[string]int{}}
+}
+func copyMap[K comparable, V any](m map[K]V) map[K]V {
+	n := make(map[K]V, len(m))
+	for k, v := range m {
+		n[k] = v
+	}
+	return n
+}
+func copyPackages(p [4]domain.Package) [4]domain.Package {
+	for a := range p {
+		p[a].Sets = append(p[a].Sets[:0:0], p[a].Sets...)
+	}
+	return p
+}
+func copyCandidate(c candidate) candidate { c.packages = copyPackages(c.packages); return c }
+func (b *branch) fork() (*branch, error) {
+	w, err := b.world.Fork()
+	if err != nil {
+		return nil, err
+	}
+	n := *b
+	n.world = w
+	n.pool = copyMap(b.pool)
+	for k, v := range n.pool {
+		n.pool[k] = copyCandidate(v)
+	}
+	n.aliases = copyMap(b.aliases)
+	for f, rows := range n.aliases {
+		n.aliases[f] = copyMap(rows)
+		for k, v := range rows {
+			n.aliases[f][k] = cloneAlias(v)
+		}
+	}
+	n.unavailable = copyMap(b.unavailable)
+	for k, v := range n.unavailable {
+		n.unavailable[k] = cloneUnavailable(v)
+	}
+	n.screened = copyMap(b.screened)
+	n.visited = copyMap(b.visited)
+	n.refined = copyMap(b.refined)
+	n.bank = append([]candidate(nil), b.bank...)
+	for i := range n.bank {
+		n.bank[i] = copyCandidate(n.bank[i])
+	}
+	n.starts = append([]candidate(nil), b.starts...)
+	for i := range n.starts {
+		n.starts[i] = copyCandidate(n.starts[i])
+	}
+	return &n, nil
+}
+func (b *branch) close() {
+	if b != nil && b.world != nil {
+		b.world.Close()
+		b.world = nil
+	}
+}
+func finite(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) }
+func sorted(pool map[string]candidate) []candidate {
+	rows := make([]candidate, 0, len(pool))
+	for _, c := range pool {
+		rows = append(rows, c)
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].value != rows[j].value {
+			return rows[i].value > rows[j].value
+		}
+		return theorypackages.Key(rows[i].packages) < theorypackages.Key(rows[j].packages)
+	})
+	return rows
+}
+func (b *branch) offer(c candidate) {
+	if !finite(c.value) || alloc.ValidateFull45(c.state) != nil {
+		return
+	}
+	if old, ok := b.pool[c.family]; ok && old.value >= c.value {
+		return
+	}
+	c = copyCandidate(c)
+	b.pool[c.family] = c
+	bank := []candidate{c}
+	for _, old := range b.bank {
+		if old.family != c.family && old.state != c.state {
+			bank = append(bank, old)
+		}
+	}
+	sort.Slice(bank, func(i, j int) bool {
+		if bank[i].value != bank[j].value {
+			return bank[i].value > bank[j].value
+		}
+		return bank[i].family < bank[j].family
+	})
+	b.bank = bank[:min(6, len(bank))]
+}
+func (b *branch) objective(ctx context.Context, e *Entry, p [4]domain.Package) alloc.Objective {
+	return func(s alloc.State, want bool) (float64, [4][10]float64, error) {
+		if err := ctx.Err(); err != nil {
+			return 0, [4][10]float64{}, err
+		}
+		b.work.Formula++
+		if want {
+			b.work.Gradient++
+		}
+		v, g, err := e.Objective(s, want)
+		if err == nil {
+			if !finite(v) {
+				return 0, g, fmt.Errorf("nonfinite Theory formula")
+			}
+			if want {
+				for _, row := range g {
+					for _, x := range row {
+						if !finite(x) {
+							return 0, g, fmt.Errorf("nonfinite Theory gradient")
+						}
+					}
+				}
+			}
+			b.offer(candidate{p, s, v, e.Family})
+		}
+		return v, g, err
+	}
+}
+func (b *branch) resolve(ctx context.Context, p [4]domain.Package, wearers [4]string) (*Entry, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	e, codes, err := b.world.Resolve(ctx, p)
+	if err != nil {
+		return nil, err
+	}
+	key := theorypackages.Key(p)
+	if e == nil {
+		if len(codes) == 0 {
+			codes = []string{"source_resolution_unavailable"}
+		}
+		b.unavailable[key] = Unavailable{TupleKey: key, Packages: packageRows(p, wearers), Reasons: append([]string(nil), codes...)}
+	} else {
+		if e.Family == "" || e.Objective == nil {
+			return nil, fmt.Errorf("incomplete Theory model entry")
+		}
+		if b.aliases[e.Family] == nil {
+			b.aliases[e.Family] = map[string]Alias{}
+		}
+		b.aliases[e.Family][key] = Alias{TupleKey: key, Packages: packageRows(p, wearers), ContextSHA256: e.ContextSHA256, Uncertainty: append([]string(nil), e.Uncertainty...)}
+	}
+	return e, nil
+}
+func fresh(initial alloc.State, g [4][10]float64) []alloc.State {
+	mains := initial.Mains
+	choices, keys, values, mainValues := alloc.MainChoices(), alloc.StatKeys(), alloc.StatValues(), alloc.MainValues()
+	for a := range mains {
+		for slot := 2; slot < 5; slot++ {
+			value := math.Inf(-1)
+			choice := mains[a][slot]
+			for _, main := range choices[slot] {
+				for j, key := range keys {
+					if main == key {
+						v := g[a][j] * mainValues[main] / values[j]
+						if v > value {
+							value, choice = v, main
+						}
+					}
+				}
+			}
+			mains[a][slot] = choice
+		}
+	}
+	if alloc.ValidateFull45(initial) != nil {
+		initial = alloc.Seed(initial.Mains, [4][10]float64{}, 0, 45)
+	}
+	return []alloc.State{initial, alloc.Seed(initial.Mains, g, 0, 45), alloc.Seed(mains, g, 0, 45)}
+}
+func seedPlan(fresh, bank []alloc.State) ([]alloc.State, int) {
+	out := []alloc.State{fresh[2]}
+	transferred := 0
+	for _, s := range bank {
+		if alloc.ValidateFull45(s) != nil {
+			continue
+		}
+		duplicate := false
+		for _, old := range out {
+			if old == s {
+				duplicate = true
+			}
+		}
+		if !duplicate {
+			out = append(out, s)
+			transferred++
+		}
+		if len(out) == 3 {
+			return out, transferred
+		}
+	}
+	for _, s := range fresh {
+		if len(out) == 3 {
+			break
+		}
+		out = append(out, s)
+	}
+	return out, transferred
+}
+func (b *branch) seeds(ctx context.Context, e *Entry, p [4]domain.Package) ([]alloc.State, error) {
+	obj := b.objective(ctx, e, p)
+	bank := append([]candidate(nil), b.bank...)
+	_, g, err := obj(b.initial, true)
+	if err != nil {
+		return nil, err
+	}
+	ranked := []candidate{}
+	for _, old := range bank {
+		if old.family == e.Family {
+			continue
+		}
+		v, _, err := obj(old.state, false)
+		if err != nil {
+			return nil, err
+		}
+		old.value = v
+		ranked = append(ranked, old)
+	}
+	sort.SliceStable(ranked, func(i, j int) bool { return ranked[i].value > ranked[j].value })
+	states := []alloc.State{}
+	for _, c := range ranked {
+		states = append(states, c.state)
+	}
+	selected, transferred := seedPlan(fresh(b.initial, g), states)
+	b.work.TransferredStarts += transferred
+	b.work.IndependentStarts += len(selected) - transferred
+	return selected, nil
+}
+func basicConfig(iterations int) alloc.Config {
+	return alloc.Config{Budget: 45, Method: "spg", MaxIterations: iterations, LineSearch: true}
+}
+func (b *branch) visit(ctx context.Context, p [4]domain.Package, wearers [4]string) (string, error) {
+	if err := ctx.Err(); err != nil {
+		return "", err
+	}
+	key := theorypackages.Key(p)
+	if family, known := b.visited[key]; known && (family == "" || b.screened[family]) {
+		b.work.AliasHits++
+		return family, nil
+	}
+	e, err := b.resolve(ctx, p, wearers)
+	if err != nil {
+		return "", err
+	}
+	if e == nil {
+		b.visited[key] = ""
+		return "", nil
+	}
+	b.visited[key] = e.Family
+	if b.screened[e.Family] {
+		return e.Family, nil
+	}
+	seeds, err := b.seeds(ctx, e, p)
+	if err != nil {
+		return e.Family, err
+	}
+	for _, s := range seeds {
+		if err := alloc.ValidateFull45(s); err != nil {
+			return e.Family, fmt.Errorf("illegal Theory search seed: %w", err)
+		}
+		b.work.AllocationAttempts++
+		if _, err = alloc.Optimize(b.objective(ctx, e, p), s, basicConfig(4)); err != nil {
+			return e.Family, err
+		}
+	}
+	b.screened[e.Family] = true
+	return e.Family, nil
+}
+func (b *branch) refine(ctx context.Context, c candidate, deep bool, wearers [4]string) error {
+	e, err := b.resolve(ctx, c.packages, wearers)
+	if err != nil || e == nil {
+		return err
+	}
+	level := 1
+	if deep {
+		level = 2
+	}
+	if b.refined[c.family] >= level {
+		return nil
+	}
+	obj := b.objective(ctx, e, c.packages)
+	if _, err = alloc.FastWhole(obj, b.pool[c.family].state, basicConfig(40), alloc.FastConfig{Passes: 1, InnerIterations: 4}); err != nil {
+		return err
+	}
+	if deep {
+		if _, err = alloc.SlotLines(obj, b.pool[c.family].state, basicConfig(40), alloc.SlotLineConfig{Passes: 1, InnerIterations: 4}); err != nil {
+			return err
+		}
+		if _, err = alloc.FastWhole(obj, b.pool[c.family].state, basicConfig(60), alloc.FastConfig{Passes: 1, InnerIterations: 6, MainPairs: true}); err != nil {
+			return err
+		}
+	}
+	b.refined[c.family] = level
+	return nil
+}
+func packageKey(p domain.Package) string { return theorypackages.Key([4]domain.Package{p}) }
+func distance(a, b [4]domain.Package) int {
+	n := 0
+	for i := range a {
+		if packageKey(a[i]) != packageKey(b[i]) {
+			n++
+		}
+	}
+	return n
+}
+func beam(pool map[string]candidate) []candidate {
+	rows := sorted(pool)
+	if len(rows) < 2 {
+		return rows
+	}
+	chosen := 1
+	for i := 2; i < min(8, len(rows)); i++ {
+		if distance(rows[i].packages, rows[0].packages) > distance(rows[chosen].packages, rows[0].packages) {
+			chosen = i
+		}
+	}
+	return []candidate{rows[0], rows[chosen]}
+}
+func initialTuples(original [4]domain.Package, domains [4][]domain.Package) [][4]domain.Package {
+	ordered := domains
+	for a, rows := range domains {
+		ordered[a] = append([]domain.Package(nil), rows...)
+		sort.Slice(ordered[a], func(i, j int) bool {
+			x := sha256.Sum256([]byte(packageKey(ordered[a][i])))
+			y := sha256.Sum256([]byte(packageKey(ordered[a][j])))
+			return string(x[:]) < string(y[:])
+		})
+	}
+	out := [][4]domain.Package{original}
+	for k := 0; k < 8; k++ {
+		p := original
+		for a := range p {
+			p[a] = ordered[a][(17+97*a+131*k)%len(ordered[a])]
+		}
+		out = append(out, p)
+	}
+	return out
+}
+func (b *branch) start(ctx context.Context, cfg Config) error {
+	families := map[string]bool{}
+	for _, p := range initialTuples(cfg.Original, cfg.Domains) {
+		f, err := b.visit(ctx, p, cfg.Wearers)
+		if err != nil {
+			return err
+		}
+		if f != "" && !families[f] {
+			families[f] = true
+			if err = b.refine(ctx, b.pool[f], false, cfg.Wearers); err != nil {
+				return err
+			}
+			b.starts = append(b.starts, b.pool[f])
+		}
+		if len(b.starts) == 2 {
+			break
+		}
+	}
+	if len(b.starts) == 0 {
+		return ErrNoResult
+	}
+	return nil
+}
+func (b *branch) pass(ctx context.Context, cfg Config, pass int) error {
+	for a := 0; a < 4; a++ {
+		anchors := beam(b.pool)
+		if pass == 0 && a == 0 {
+			anchors = b.starts
+		}
+		for _, anchor := range anchors {
+			touched := map[string]bool{}
+			for _, option := range cfg.Domains[a] {
+				p := anchor.packages
+				p[a] = option
+				f, err := b.visit(ctx, p, cfg.Wearers)
+				if err != nil {
+					return err
+				}
+				if f != "" {
+					touched[f] = true
+				}
+			}
+			b.work.CompletedSweeps++
+			local := map[string]candidate{}
+			for f := range touched {
+				if c, ok := b.pool[f]; ok {
+					local[f] = c
+				}
+			}
+			rows := sorted(local)
+			if len(rows) > 0 {
+				if err := b.refine(ctx, rows[0], false, cfg.Wearers); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	b.work.CompletedPasses = pass + 1
+	return nil
+}
+
+// Catalog screening can improve a family after its earlier light refinement.
+// Before the first publication, refine the current witnesses of the two top
+// families once. The fixed input list bounds the work even when offers update
+// the pool; the per-family light/deep stamp does not suppress this phase.
+func (b *branch) refinePublication(ctx context.Context, cfg Config) error {
+	rows := sorted(b.pool)
+	for _, selected := range rows[:min(2, len(rows))] {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		current := b.pool[selected.family]
+		e, err := b.resolve(ctx, current.packages, cfg.Wearers)
+		if err != nil || e == nil {
+			return err
+		}
+		b.work.PublicationRefinements++
+		refined, err := alloc.FastWhole(b.objective(ctx, e, current.packages), current.state,
+			basicConfig(40), alloc.FastConfig{Passes: 1, InnerIterations: 4, MainPairs: true})
+		b.work.PublicationPairCandidates += refined.PairCandidates
+		if err != nil {
+			return err
+		}
+		// objective offers every legal improvement, including interrupted work.
+		// Keep the final witness explicitly; offer never replaces a stronger one.
+		b.offer(candidate{current.packages, refined.State, refined.Value, e.Family})
+	}
+	return nil
+}
+func (b *branch) deep(ctx context.Context, cfg Config) error {
+	rows := sorted(b.pool)
+	picks := append([]candidate(nil), rows[:min(2, len(rows))]...)
+	for i := 4; i < len(rows); i++ {
+		if b.refined[rows[i].family] < 2 {
+			picks = append(picks, rows[i])
+			break
+		}
+	}
+	for _, c := range picks {
+		if err := b.refine(ctx, c, true, cfg.Wearers); err != nil {
+			return err
+		}
+	}
+	b.work.DeepBundles++
+	return nil
+}
diff --git a/internal/theorysearch/session.go b/internal/theorysearch/session.go
new file mode 100644
--- /dev/null
+++ b/internal/theorysearch/session.go
@@ -0,0 +1,192 @@
+package theorysearch
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+)
+
+var ErrNoResult = errors.New("finish_no_result: no complete legal Theory witness")
+var ErrBindingChanged = errors.New("Theory input/model/engine binding changed")
+
+// A session owns two independent live branches after first publication. The
+// archive is output-only: optional breadth discoveries never feed common-H.
+type Session struct {
+	cfg     Config
+	active  *branch
+	preDeep *branch
+	archive *branch
+	phase   string
+	version int64
+	failure error
+	closed  bool
+}
+
+func New(cfg Config, w Resolver) (*Session, error) {
+	if w == nil || cfg.Binding == "" || cfg.RequestSHA256 == "" || cfg.SessionID == "" {
+		return nil, fmt.Errorf("missing Theory session identity")
+	}
+	if err := alloc.ValidateFull45(cfg.Initial); err != nil {
+		return nil, err
+	}
+	owners := map[string]bool{}
+	for a, rows := range cfg.Domains {
+		if cfg.Wearers[a] == "" || owners[cfg.Wearers[a]] || len(rows) == 0 {
+			return nil, fmt.Errorf("invalid Theory wearer/domain")
+		}
+		owners[cfg.Wearers[a]] = true
+		keys := map[string]bool{}
+		cfg.Domains[a] = make([]domain.Package, len(rows))
+		for i, p := range rows {
+			if err := p.Validate(); err != nil {
+				return nil, err
+			}
+			if keys[p.Key()] {
+				return nil, fmt.Errorf("duplicate Theory package domain")
+			}
+			keys[p.Key()] = true
+			cfg.Domains[a][i] = copyPackages([4]domain.Package{p})[0]
+		}
+		if !keys[cfg.Original[a].Key()] {
+			return nil, fmt.Errorf("Theory original tuple outside allowed domain")
+		}
+	}
+	cfg.Original = copyPackages(cfg.Original)
+	return &Session{cfg: cfg, active: newBranch(w, cfg.Initial), archive: newBranch(nil, cfg.Initial)}, nil
+}
+func (s *Session) check(binding string, phase ...string) error {
+	if binding != s.cfg.Binding {
+		s.abort(ErrBindingChanged)
+		return ErrBindingChanged
+	}
+	if s.closed {
+		return fmt.Errorf("Theory session is closed")
+	}
+	for _, p := range phase {
+		if s.phase == p {
+			return nil
+		}
+	}
+	return fmt.Errorf("Theory action unavailable in phase %q", s.phase)
+}
+func (s *Session) absorb() {
+	if s.active == nil {
+		return
+	}
+	// Keep all legal lower witnesses and exact aliases found on either branch.
+	for f, c := range s.active.pool {
+		if old, ok := s.archive.pool[f]; !ok || c.value > old.value {
+			s.archive.pool[f] = copyCandidate(c)
+		}
+		if s.active.refined[f] > s.archive.refined[f] {
+			s.archive.refined[f] = s.active.refined[f]
+		}
+	}
+	for f, rows := range s.active.aliases {
+		if s.archive.aliases[f] == nil {
+			s.archive.aliases[f] = map[string]Alias{}
+		}
+		for k, v := range rows {
+			s.archive.aliases[f][k] = cloneAlias(v)
+		}
+	}
+	for k, v := range s.active.unavailable {
+		s.archive.unavailable[k] = cloneUnavailable(v)
+	}
+	for k, v := range s.active.visited {
+		s.archive.visited[k] = v
+	}
+}
+func (s *Session) abort(err error) {
+	s.absorb()
+	s.failure = err
+	s.Close()
+}
+func (s *Session) First(ctx context.Context, binding string) (Snapshot, error) {
+	if err := s.check(binding, ""); err != nil {
+		return Snapshot{}, err
+	}
+	if err := s.active.start(ctx, s.cfg); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	if err := s.active.pass(ctx, s.cfg, 0); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	if err := s.active.refinePublication(ctx, s.cfg); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	s.absorb()
+	checkpoint, err := s.active.fork()
+	if err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	s.preDeep = checkpoint
+	s.phase = "first_light"
+	return s.publish(false), nil
+}
+func (s *Session) Breadth(ctx context.Context, binding string) (Snapshot, error) {
+	if err := s.check(binding, "first_light"); err != nil {
+		return Snapshot{}, err
+	}
+	if err := s.active.pass(ctx, s.cfg, 1); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	s.absorb()
+	s.phase = "breadth_light"
+	return s.publish(false), nil
+}
+func (s *Session) Deep(ctx context.Context, binding string) (Snapshot, error) {
+	if err := s.check(binding, "first_light", "breadth_light"); err != nil {
+		return Snapshot{}, err
+	}
+	// Restore the full pre-deep state, including mutable resolver caches and
+	// numerical feedback. Do not restart/repeat the first catalog pass.
+	s.absorb()
+	s.active.close()
+	s.active = s.preDeep
+	s.preDeep = nil
+	if err := s.active.deep(ctx, s.cfg); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	if err := s.active.pass(ctx, s.cfg, 1); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	if err := s.active.deep(ctx, s.cfg); err != nil {
+		s.abort(err)
+		return Snapshot{}, err
+	}
+	s.absorb()
+	s.phase = "deep_baseline"
+	return s.publish(false), nil
+}
+func (s *Session) Finish() (Snapshot, error) {
+	s.absorb()
+	if s.failure != nil && !errors.Is(s.failure, context.Canceled) {
+		return Snapshot{}, s.failure
+	}
+	if len(s.archive.pool) == 0 {
+		s.Close()
+		return Snapshot{}, ErrNoResult
+	}
+	out := s.publish(true)
+	s.Close()
+	return out, nil
+}
+func (s *Session) Close() {
+	if s == nil || s.closed {
+		return
+	}
+	s.active.close()
+	s.preDeep.close()
+	s.closed = true
+}
