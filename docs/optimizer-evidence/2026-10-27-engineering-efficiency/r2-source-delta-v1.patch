+package search
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+// FinalPairCompletionActor is a compact per-actor cost and coverage ledger for
+// the All Sets final-only fringe walk. It records work performed by the
+// existing candidateRun, neighborhood gate, exact reduced point evaluator and
+// finish scorer; it is not a global-optimality certificate.
+type FinalPairCompletionActor struct {
+	Actor                       int               `json:"actor"`
+	Calls                       int               `json:"calls"`
+	FreeProduct                 int64             `json:"free_product"`
+	PoolWidths                  [5]int            `json:"pool_widths"`
+	BaseAssignment              domain.Assignment `json:"base_assignment"`
+	CandidatePairs              int64             `json:"candidate_pairs"`
+	GateAllowedPairs            int64             `json:"gate_allowed_pairs"`
+	BaseIDSkips                 int64             `json:"base_id_skips"`
+	DuplicateSkips              int64             `json:"duplicate_skips"`
+	PointCalls                  int               `json:"point_calls"`
+	Expanded                    int               `json:"expanded"`
+	PairPointExpanded           int               `json:"pair_point_expanded"`
+	InvalidAssignments          int               `json:"invalid_assignments"`
+	GatePlans                   int               `json:"gate_plans"`
+	GateFallbacks               int               `json:"gate_fallbacks"`
+	GateValidationChecks        int64             `json:"gate_validation_checks"`
+	GatePoolMetadataChecks      int64             `json:"gate_pool_metadata_checks"`
+	PartnerRepairWitnesses      int64             `json:"partner_repair_witnesses"`
+	LeftPartnerRepairWitnesses  int64             `json:"left_partner_repair_witnesses"`
+	RightPartnerRepairWitnesses int64             `json:"right_partner_repair_witnesses"`
+	CandidateRunCalls           int               `json:"candidate_run_calls"`
+	GradientCalls               int               `json:"gradient_calls"`
+	FinishCalls                 int               `json:"finish_calls"`
+	ReturnedFinalistRows        int               `json:"returned_finalist_rows"`
+	SetupSeconds                float64           `json:"setup_seconds"`
+	GuideSeconds                float64           `json:"guide_seconds"`
+	PoolSeconds                 float64           `json:"pool_seconds"`
+	GateSeconds                 float64           `json:"gate_seconds"`
+	PairPointSeconds            float64           `json:"pair_point_seconds"`
+	FinishSeconds               float64           `json:"finish_seconds"`
+	TotalSeconds                float64           `json:"total_seconds"`
+	CoverageComplete            bool              `json:"coverage_complete"`
+	Stop                        string            `json:"stop"`
+}
+
+// FinalPairCompletionSummary is attached only by the explicit All Sets final
+// entry point. Ordinary Stabilize and fixed-candidate callers leave it nil.
+type FinalPairCompletionSummary struct {
+	Schema                   string                      `json:"schema"`
+	Passes                   int                         `json:"passes"`
+	RecoveryPasses           int                         `json:"recovery_passes"`
+	NormalStabilizeSeconds   float64                     `json:"normal_stabilize_seconds"`
+	PairCompletionSeconds    float64                     `json:"pair_completion_seconds"`
+	TotalSeconds             float64                     `json:"total_seconds"`
+	PairExpanded             int                         `json:"pair_expanded"`
+	PairCoverageComplete     bool                        `json:"pair_coverage_complete"`
+	PairCoverageBase         domain.Assignment           `json:"pair_coverage_base"`
+	AcceptedSequenceOverflow bool                        `json:"accepted_sequence_overflow"`
+	Stop                     string                      `json:"stop"`
+	Actors                   [4]FinalPairCompletionActor `json:"actors"`
+	AcceptedSequence         []ScoredAssignment          `json:"accepted_sequence"`
+}
+
+// FinalPairOrientation exposes the two deterministic sides of the fringe
+// union to the All Sets contract test. Left and Right preserve their producer
+// order; the second orientation keeps only free IDs outside the left frontier.
+type ResearchFinalPairOrientation struct {
+	Left  []int64
+	Right []int64
+}
+
+// FinalPairCompletionOrientations partitions P×F ∪ F×P into two disjoint
+// rectangles: P×F and (F\P)×P. The P×P cross is therefore included exactly
+// once without assuming it was examined by an earlier neighborhood.
+func FinalPairCompletionOrientations(freeLeft, frontierLeft, freeRight, frontierRight []int64) [2]ResearchFinalPairOrientation {
+	selected := make(map[int64]struct{}, len(frontierLeft))
+	for _, id := range frontierLeft {
+		selected[id] = struct{}{}
+	}
+	outside := make([]int64, 0, len(freeLeft))
+	for _, id := range freeLeft {
+		if _, found := selected[id]; !found {
+			outside = append(outside, id)
+		}
+	}
+	return [2]ResearchFinalPairOrientation{
+		{Left: frontierLeft, Right: freeRight},
+		{Left: outside, Right: frontierRight},
+	}
+}
+
+// StabilizeFinalAllSets runs the existing N1/N2/joint stabilization unchanged.
+// Only after it reaches its stable return does it complete the P×F ∪ F×P
+// two-slot fringe for every wearer. A strict full-score gain restarts the
+// ordinary N1 path; incomplete fringe work never changes the normal
+// single-stationary result for an unchanged leader.
+func (engine *Engine) StabilizeFinalAllSets(ctx context.Context, anchor domain.Assignment, allowance int) (out Stabilization, err error) {
+	started := time.Now()
+	summary := &FinalPairCompletionSummary{
+		Schema:           "final_stagnation_pair_completion_v1",
+		AcceptedSequence: make([]ScoredAssignment, 0),
+		Stop:             "not_started",
+	}
+	for actor := range summary.Actors {
+		summary.Actors[actor] = FinalPairCompletionActor{Actor: actor, Stop: "not_started"}
+	}
+	defer func() {
+		summary.TotalSeconds = time.Since(started).Seconds()
+		out.PairCompletion = summary
+	}()
+	if allowance < 0 {
+		summary.Stop = "invalid_allowance"
+		out.Stop = "invalid_stabilization_domain"
+		return out, fmt.Errorf("invalid stabilization domain")
+	}
+	current := anchor
+	for {
+		remaining := allowance - out.Evaluations
+		if remaining < 0 {
+			remaining = 0
+		}
+		normalStarted := time.Now()
+		pass, passErr := engine.stabilize(ctx, current, remaining, func(row ScoredAssignment) {
+			appendFinalPairAccepted(summary, allowance, row)
+		})
+		summary.Passes++
+		summary.NormalStabilizeSeconds += time.Since(normalStarted).Seconds()
+		out.Leader = pass.Leader
+		out.Evaluations += pass.Evaluations
+		out.Accepted += pass.Accepted
+		out.SingleStationary = pass.SingleStationary
+		out.Stop = pass.Stop
+		if summary.AcceptedSequenceOverflow {
+			summary.Stop = "accepted_sequence_overflow"
+			return out, fmt.Errorf("accepted sequence exceeded the existing expansion allowance")
+		}
+		if passErr != nil {
+			summary.Stop = "normal_stabilize_error"
+			return out, passErr
+		}
+		if pass.Stop != "single_stationary_sampled_pairs_stable" || !pass.SingleStationary {
+			summary.Stop = "normal_stabilize_incomplete"
+			return out, nil
+		}
+		if out.Evaluations >= allowance {
+			summary.Stop = "budget_exhausted_before_fringe"
+			summary.PairCoverageComplete = false
+			out.Stop = "final_pair_completion_budget"
+			return out, nil
+		}
+		summary.PairCoverageBase = out.Leader.Assignment
+		if err = ctx.Err(); err != nil {
+			summary.Stop = "pair_fringe_cancelled_before_actor"
+			out.Stop = "final_pair_completion_cancelled"
+			return out, err
+		}
+
+		recoveryStarted := time.Now()
+		summary.RecoveryPasses++
+		cycleComplete := true
+		accepted := false
+		for actor := 0; actor < 4; actor++ {
+			actorAllowance := allowance - out.Evaluations
+			if actorAllowance <= 0 {
+				cycleComplete = false
+				summary.Actors[actor].Stop = "not_started_budget"
+				break
+			}
+			stats, best, haveBest, actorErr := engine.finalPairFringe(ctx, out.Leader.Assignment, actor, actorAllowance)
+			mergeFinalPairActorStats(&summary.Actors[actor], stats)
+			out.Evaluations += stats.Expanded
+			summary.PairExpanded += stats.Expanded
+			if haveBest && improvesDPS(best.DPS, out.Leader.DPS) {
+				out.Leader = best
+				out.Accepted++
+				out.SingleStationary = false
+				accepted = true
+				appendFinalPairAccepted(summary, allowance, best)
+			}
+			if actorErr != nil {
+				summary.PairCompletionSeconds += time.Since(recoveryStarted).Seconds()
+				summary.PairCoverageComplete = false
+				summary.Stop = "pair_completion_error"
+				out.Stop = "final_pair_completion_error"
+				return out, actorErr
+			}
+			if summary.AcceptedSequenceOverflow {
+				summary.PairCompletionSeconds += time.Since(recoveryStarted).Seconds()
+				summary.PairCoverageComplete = false
+				summary.Stop = "accepted_sequence_overflow"
+				out.Stop = "final_pair_completion_error"
+				return out, fmt.Errorf("accepted sequence exceeded the existing expansion allowance")
+			}
+			if accepted {
+				cycleComplete = false
+				break
+			}
+			if !stats.CoverageComplete {
+				cycleComplete = false
+				break
+			}
+		}
+		summary.PairCompletionSeconds += time.Since(recoveryStarted).Seconds()
+		if err = ctx.Err(); err != nil {
+			summary.PairCoverageComplete = false
+			summary.Stop = "pair_completion_cancelled_after_actor"
+			out.Stop = "final_pair_completion_cancelled"
+			return out, err
+		}
+		if accepted {
+			summary.PairCoverageComplete = false
+			summary.Stop = "accepted_gain_restart_n1"
+			if out.Evaluations >= allowance {
+				out.Stop = "stabilization_budget"
+				return out, nil
+			}
+			current = out.Leader.Assignment
+			continue
+		}
+		if cycleComplete {
+			summary.PairCoverageComplete = true
+			summary.Stop = "pair_fringe_complete_stable"
+			out.SingleStationary = true
+			out.Stop = "single_stationary_sampled_pairs_stable"
+			return out, nil
+		}
+		summary.PairCoverageComplete = false
+		summary.Stop = "pair_fringe_incomplete"
+		out.Stop = "final_pair_completion_budget"
+		return out, nil
+	}
+}
+
+func appendFinalPairAccepted(summary *FinalPairCompletionSummary, allowance int, row ScoredAssignment) {
+	if len(summary.AcceptedSequence) >= allowance {
+		summary.AcceptedSequenceOverflow = true
+		return
+	}
+	summary.AcceptedSequence = append(summary.AcceptedSequence, row)
+}
+
+func mergeFinalPairActorStats(total *FinalPairCompletionActor, next FinalPairCompletionActor) {
+	total.Calls += next.Calls
+	total.FreeProduct = next.FreeProduct
+	total.PoolWidths = next.PoolWidths
+	total.BaseAssignment = next.BaseAssignment
+	total.CandidatePairs += next.CandidatePairs
+	total.GateAllowedPairs += next.GateAllowedPairs
+	total.BaseIDSkips += next.BaseIDSkips
+	total.DuplicateSkips += next.DuplicateSkips
+	total.PointCalls += next.PointCalls
+	total.Expanded += next.Expanded
+	total.PairPointExpanded += next.PairPointExpanded
+	total.InvalidAssignments += next.InvalidAssignments
+	total.GatePlans += next.GatePlans
+	total.GateFallbacks += next.GateFallbacks
+	total.GateValidationChecks += next.GateValidationChecks
+	total.GatePoolMetadataChecks += next.GatePoolMetadataChecks
+	total.PartnerRepairWitnesses += next.PartnerRepairWitnesses
+	total.LeftPartnerRepairWitnesses += next.LeftPartnerRepairWitnesses
+	total.RightPartnerRepairWitnesses += next.RightPartnerRepairWitnesses
+	total.CandidateRunCalls += next.CandidateRunCalls
+	total.GradientCalls += next.GradientCalls
+	total.FinishCalls += next.FinishCalls
+	total.ReturnedFinalistRows += next.ReturnedFinalistRows
+	total.SetupSeconds += next.SetupSeconds
+	total.GuideSeconds += next.GuideSeconds
+	total.PoolSeconds += next.PoolSeconds
+	total.GateSeconds += next.GateSeconds
+	total.PairPointSeconds += next.PairPointSeconds
+	total.FinishSeconds += next.FinishSeconds
+	total.TotalSeconds += next.TotalSeconds
+	total.CoverageComplete = next.CoverageComplete
+	total.Stop = next.Stop
+}
+
+func (engine *Engine) finalPairFringe(ctx context.Context, anchor domain.Assignment, actor, allowance int) (stats FinalPairCompletionActor, best ScoredAssignment, haveBest bool, retErr error) {
+	started := time.Now()
+	stats.Actor, stats.Calls, stats.CandidateRunCalls = actor, 1, 1
+	stats.Stop = "running"
+	stats.BaseAssignment = anchor
+	defer func() { stats.TotalSeconds = time.Since(started).Seconds() }()
+	r, err := engine.candidateRun(ctx, anchor, actor, allowance)
+	stats.SetupSeconds = time.Since(started).Seconds()
+	if err != nil {
+		stats.Stop = "candidate_run_error"
+		return stats, best, false, err
+	}
+	free, size := r.freeInventory()
+	stats.FreeProduct = size
+	base := anchor[actor]
+	if err := ctx.Err(); err != nil {
+		stats.Stop = "cancelled_before_gradient"
+		return engine.finishFinalPairFringe(r, stats, best, false, err)
+	}
+
+	guideStarted := time.Now()
+	stats.GradientCalls++
+	weights, err := r.priorities(base)
+	stats.GuideSeconds += time.Since(guideStarted).Seconds()
+	if err != nil {
+		stats.Stop = "gradient_error"
+		return engine.finishFinalPairFringe(r, stats, best, false, err)
+	}
+
+	poolStarted := time.Now()
+	pools := r.frontierPools(actor, free, weights)
+	for slot := range free {
+		stats.PoolWidths[slot] = len(pools[slot])
+	}
+	stats.PoolSeconds += time.Since(poolStarted).Seconds()
