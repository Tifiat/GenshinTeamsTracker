+package engineclient
+
+// responseArtifactGuard is private to the response panel. Ordinary finalist
+// verification and its public binding contract are unchanged.
+type responseArtifactGuard struct {
+	mode  string
+	check func() error
+	close func() error
+}
+
+type responseArtifactGuardFactory func(BoundEngine) (responseArtifactGuard, error)
+
+func fullHashResponseArtifactGuard(bound BoundEngine) (responseArtifactGuard, error) {
+	return responseArtifactGuard{
+		mode:  "full_hash_fallback",
+		check: bound.VerifyUnchanged,
+		close: func() error { return nil },
+	}, nil
+}
