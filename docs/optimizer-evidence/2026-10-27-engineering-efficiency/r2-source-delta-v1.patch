+package seteffects
+
+import (
+	"go/ast"
+	"strings"
+	"testing"
+)
+
+func immutableProofFixture(t *testing.T, body string) (*ruleProgram, *ruleModule, map[string][]byte, map[string][]byte, *ruleRepository) {
+	t.Helper()
+	sources := map[string][]byte{"internal/artifacts/probe/set.go": []byte("package probe\n" + body)}
+	libraries := map[string][]byte{
+		"pkg/core/info/reaction.go":      []byte("package info\ntype ReactionType string\nconst ReactionTypeOverload ReactionType = \"overload\"\n"),
+		"pkg/core/attributes/element.go": []byte("package attributes\ntype Element int\nconst (Electro Element=iota;Pyro)\n"),
+	}
+	p, err := compileRuleProgram(sources, libraries)
+	if err != nil {
+		t.Fatal(err)
+	}
+	repo := &ruleRepository{files: map[string][]byte{}, packages: map[string][]string{}}
+	for name, data := range libraries {
+		repo.files[name] = data
+		module := gcsimImport + strings.TrimSuffix(name, "/"+name[strings.LastIndex(name, "/")+1:])
+		repo.packages[module] = append(repo.packages[module], name)
+	}
+	for name, data := range sources {
+		repo.files[name] = data
+	}
+	p.repository = repo
+	return p, p.modules[p.entry], sources, libraries, repo
+}
+
+func TestImmutableGlobalProofCertifiesPrivateLiteralReadOnlyTable(t *testing.T) {
+	body := `import "github.com/genshinsim/gcsim/pkg/core/info"
+import "github.com/genshinsim/gcsim/pkg/core/attributes"
+import "slices"
+var reactToElements = map[info.ReactionType][]attributes.Element{
+ info.ReactionTypeOverload: {attributes.Electro, attributes.Pyro},
+}
+func Read(react info.ReactionType, ele attributes.Element) bool {
+ elements := reactToElements[react]
+ if !slices.Contains(elements, ele) { return false }
+ for _, value := range elements { if value==ele { return true } }
+ return false
+}`
+	p, m, sources, libraries, repo := immutableProofFixture(t, body)
+	names := immutableGlobalNames(p, m)
+	if len(names) != 1 || names[0] != "reactToElements" {
+		t.Fatalf("read-only source table was not certified: %v", names)
+	}
+	for _, renamed := range []string{"anotherLiteralTable", "newReactionLookup"} {
+		renamedProgram, renamedModule, _, _, _ := immutableProofFixture(t, strings.ReplaceAll(body, "reactToElements", renamed))
+		if proof := immutableGlobalNames(renamedProgram, renamedModule); len(proof) != 1 || proof[0] != renamed {
+			t.Fatalf("equivalent source table under new name was not certified: %v", proof)
+		}
+	}
+	plan, err := buildMechanicModulePlan(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !m.immutableGlobals["reactToElements"] {
+		t.Fatal("cold rule module did not consume proof")
+	}
+	bound, err := bindMechanicModulePlan(MechanicIR{Role: mechanicIRRootRole, Entry: p.entry, ModulePlan: &plan}, sources, libraries, repo, nil, nil)
+	if err != nil || !bound.modules[p.entry].immutableGlobals["reactToElements"] {
+		t.Fatalf("warm source-bound proof was not consumed: %v", err)
+	}
+	// Cache payload tampering must not upgrade a different declaration shape.
+	for i := range plan.Modules {
+		if plan.Modules[i].Name == p.entry {
+			plan.Modules[i].ImmutableGlobals = []string{"Read"}
+		}
+	}
+	if _, err := bindMechanicModulePlan(MechanicIR{Role: mechanicIRRootRole, Entry: p.entry, ModulePlan: &plan}, sources, libraries, repo, nil, nil); err == nil {
+		t.Fatal("unverifiable immutable-global certificate accepted")
+	}
+}
+
+func TestImmutableGlobalProofRejectsEscapesWritesDynamicAndShadowedCalls(t *testing.T) {
+	cases := []string{
+		`var table=map[int][]int{1:{2}};func Read(i int) []int { alias:=table[i];return alias }`,
+		`var table=map[int][]int{1:{2}};func Read(i int) int { alias:=table[i];alias[0]=3;return 1 }`,
+		`var table=map[int][]int{1:{2}};func mutate(v []int){};func Read(i int) { alias:=table[i];mutate(alias) }`,
+		`var table=map[int][]int{1:{2}};func Read(){table[1]=[]int{3}}`,
+		`var table=map[int][]int{1:{2}};func Read(i int){alias:=table[i];append(alias,3)}`,
+		`func makeTable()map[int][]int{return map[int][]int{1:{2}}};var table=makeTable()`,
+		`type Box struct{N int};var table=map[int][]Box{1:{{N:2}}};func Read(i int){alias:=table[i];for range alias{}}`,
+		`var table=[...]string{"a"};func Expose()[]string{return table[:]}`,
+		`import "slices";var table=map[int][]int{1:{2}};func Read(i int){slices:=struct{Contains func([]int,int)bool}{};alias:=table[i];slices.Contains(alias,2)}`,
+		`var table=map[int][]int{1:{2}};func Read(i int){len:=func(v []int)int{return 0};alias:=table[i];len(alias)}`,
+		`var table=map[int][]int{1:{2}};func init(){table[1]=[]int{3}}`,
+		`import sl "slices";var table=map[int][]int{1:{2}};func Legit()bool{return sl.Contains([]int{1},1)};func Read(){sl:=struct{Contains func([]int,int)bool}{func(a []int,_ int)bool{a[0]=9;return true}};alias:=table[1];sl.Contains(alias,2)}`,
+		`var table=map[int][]int{1:{2}};func len(a []int)int{a[0]=9;return 1};func Read(){alias:=table[1];len(alias)}`,
+		`type int []byte;var table=map[string][]int{"a":{{1}}};func Read(){alias:=table["a"];for _,v:=range alias{v[0]=9}}`,
+		`var table=map[int][]int{1:{2}};func Read(){alias,ok:=table[1];if ok{alias[0]=9}}`,
+	}
+	for _, body := range cases {
+		p, m, _, _, _ := immutableProofFixture(t, body)
+		if names := immutableGlobalNames(p, m); len(names) != 0 {
+			t.Errorf("unsafe source table certified: %v in %q", names, body)
+		}
+	}
+	p, m, _, _, repo := immutableProofFixture(t, `var table=map[int][]int{1:{2}};func Read(i int){alias:=table[i];for range alias{}}`)
+	repo.files["pkg/link/link.go"] = []byte("package link\n//go:linkname foreign github.com/genshinsim/gcsim/internal/artifacts/probe.table\n")
+	if names := immutableGlobalNames(p, m); len(names) != 0 {
+		t.Fatalf("foreign linkname certified private global: %v", names)
+	}
+}
+
+func TestImmutableGlobalProofRejectsNonScalarAliases(t *testing.T) {
+	p, m, _, _, _ := immutableProofFixture(t, `type Box struct{N int};var table=map[int][]Box{1:{{N:2}}}`)
+	if immutableTableShape(p, m.globals["table"].env, m.globals["table"].expr) {
+		t.Fatal("struct slice treated as scalar")
+	}
+	if _, ok := any(m.globals["table"].expr).(*ast.CompositeLit); !ok {
+		t.Fatal("fixture did not exercise a composite literal")
+	}
+}
+
+func TestImmutableGlobalProofIncludesNeighborFileMutation(t *testing.T) {
+	_, _, sources, libraries, repo := immutableProofFixture(t, `var table=map[int][]int{1:{2}};func Read(i int){alias:=table[i];for range alias{}}`)
