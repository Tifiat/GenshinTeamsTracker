+func TestStatResponseScreensOnlyExactlyZeroFirstPairedSample(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		enabled   bool
+		teamDelta float64
+		aDelta    float64
+		bDelta    float64
+		screened  bool
+	}{
+		{name: "zero", enabled: true, screened: true},
+		{name: "first_zero_second_positive", enabled: true, screened: true},
+		{name: "positive", enabled: true, teamDelta: 2, aDelta: 2},
+		{name: "negative", enabled: true, teamDelta: -2, aDelta: -2},
+		{name: "actor_cancellation", enabled: true, aDelta: 1, bDelta: -1},
+		{name: "tiny_positive", enabled: true, teamDelta: 1e-9, aDelta: 1e-9},
+		{name: "team_nonzero", enabled: true, teamDelta: 1},
+		{name: "legacy_zero", enabled: false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			plan := StatResponsePlan{
+				Seeds:         []int64{11, 13},
+				Perturbations: []StatResponsePerturbation{{Actor: "a", Stat: "heal", Delta: .359}},
+				CallLimit:     4, ScreenZeroFirstSeed: test.enabled,
+			}
+			calls, secondPerturbedCalls := 0, 0
+			result, err := runStatResponsePlan(context.Background(), newStatResponseTestBound(t, true), statResponseTestConfig, t.TempDir(), plan,
+				func(_ context.Context, config, callDirectory string, seed int64) (OrdinaryResult, error) {
+					calls++
+					assertStatResponseRecorderBeforeCall(t, filepath.Dir(callDirectory), calls)
+					ordinary := statResponseTestResult(config, seed)
+					if calls > 2 {
+						ordinary.DPS += test.teamDelta
+						ordinary.CharacterDPS["a"] += test.aDelta
+						ordinary.CharacterDPS["b"] += test.bDelta
+						if seed == 13 {
+							secondPerturbedCalls++
+							if test.name == "first_zero_second_positive" {
+								// This response would be positive if called. Screening
+								// deliberately leaves it unknown, rather than fabricating zero.
+								ordinary.DPS += 10
+								ordinary.CharacterDPS["a"] += 10
+							}
+						}
+					}
+					return ordinary, nil
+				},
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantCalls, wantSamples, wantSkipped := 4, 2, 0
+			if test.screened {
+				wantCalls, wantSamples, wantSkipped = 3, 1, 1
+			}
+			row := result.Perturbations[0]
+			if calls != wantCalls || result.AttemptedCalls != wantCalls || result.SkippedCalls != wantSkipped ||
+				result.CallLimit != 4 || result.AttemptedCalls+result.SkippedCalls != result.CallLimit ||
+				result.ScreeningEnabled != test.enabled || row.SecondSeedScreened != test.screened || len(row.Samples) != wantSamples {
+				t.Fatalf("unexpected screened call/sample accounting: calls=%d result=%+v row=%+v", calls, result, row)
+			}
+			if !result.EngineUnchanged || !result.ProposalEvidenceOnly || len(result.Baseline) != 2 {
+				t.Fatalf("screening lost bound proposal/baseline evidence: %+v", result)
+			}
+			if test.screened && (secondPerturbedCalls != 0 || row.Samples[0].Seed != 11 || row.MeanDPSDelta != 0) {
+				t.Fatalf("screened second seed must remain unobserved: %+v", row)
+			}
+			if len(readJSONLines(t, filepath.Join(result.RunDirectory, "attempts.jsonl"))) != wantCalls ||
+				len(readJSONLines(t, filepath.Join(result.RunDirectory, "outcomes.jsonl"))) != wantCalls {
+				t.Fatal("durable call records include unattempted work or omit attempted work")
+			}
+			reservationBytes, err := os.ReadFile(filepath.Join(result.RunDirectory, "reservation.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var reservation statResponseReservation
+			if err := json.Unmarshal(reservationBytes, &reservation); err != nil {
+				t.Fatal(err)
+			}
+			if reservation.Plan.ScreenZeroFirstSeed != test.enabled || reservation.PlannedCallCount != 4 {
+				t.Fatalf("stopping rule/bound were not predeclared: %+v", reservation)
+			}
+			outcomeBytes, err := os.ReadFile(filepath.Join(result.RunDirectory, "outcome.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var outcome statResponseFinalOutcome
+			if err := json.Unmarshal(outcomeBytes, &outcome); err != nil {
+				t.Fatal(err)
+			}
+			if outcome.Status != "success" || outcome.AttemptedCalls != wantCalls || outcome.SkippedCalls != wantSkipped || outcome.CallLimit != 4 {
+				t.Fatalf("final outcome lost screening accounting: %+v", outcome)
+			}
+		})
+	}
+}
