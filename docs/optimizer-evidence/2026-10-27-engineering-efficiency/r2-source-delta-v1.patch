+			if selected[1].Assignment != secondOwnerLocal || selected[2].Assignment != secondOwnerEndpoint || deferred < 1 {
+				t.Fatal("deterministic global local/endpoint selection or deferral changed", selected, deferred)
+			}
+			// The first-owner low-formula endpoint is generated but deferred.
+			// Three rows retain two shapes, not every owner's support hypothesis.
