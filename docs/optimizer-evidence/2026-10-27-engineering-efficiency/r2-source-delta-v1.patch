+func representativeProjectionEvents() []Candidate {
+	events := []Candidate{
+		representativeProjectionCandidate("tie", 1, 75, "first-source", &energyconstraint.Feasibility{Feasible: true}),
+		representativeProjectionCandidate("tie", 1, 75, "later-source", &energyconstraint.Feasibility{Feasible: true}),
+		representativeProjectionCandidate("zero", 2, 0, "positive-zero", nil),
+		representativeProjectionCandidate("zero", 2, math.Copysign(0, -1), "negative-zero", nil),
+		representativeProjectionCandidate("improved", 3, 50, "old", nil),
+		representativeProjectionCandidate("improved", 3, 60, "improved", nil),
+		representativeProjectionCandidate("improved", 3, 55, "declined", nil),
+		representativeProjectionCandidate("energy-infeasible", 4, 1000, "infeasible", &energyconstraint.Feasibility{Feasible: false, MaximumShortage: 2.5}),
+		representativeProjectionCandidate("energy-infeasible", 9, -100, "lower-shortage", &energyconstraint.Feasibility{Feasible: false, MaximumShortage: 1.25}),
+		representativeProjectionCandidate("energy-infeasible", 10, -50, "same-shortage-higher-dps", &energyconstraint.Feasibility{Feasible: false, MaximumShortage: 1.25}),
+		representativeProjectionCandidate("energy-infeasible", 11, -1000, "became-feasible", &energyconstraint.Feasibility{Feasible: true}),
