+		})
+	if err == nil || calls != 2 || result.AttemptedCalls != 2 {
+		t.Fatalf("identity failure was accepted, retried, or not recorded: calls=%d result=%+v err=%v", calls, result, err)
+	}
+	if len(result.Baseline) != 1 || len(result.Perturbations) != 1 || len(result.Perturbations[0].Samples) != 0 {
+		t.Fatalf("mismatched perturbation was accepted as paired evidence: %+v", result)
+	}
+	outcomes := readJSONLines(t, filepath.Join(result.RunDirectory, "outcomes.jsonl"))
+	if len(outcomes) != 2 {
+		t.Fatalf("expected one durable outcome per attempted call, got %d", len(outcomes))
+	}
+	var failed statResponseCallOutcome
+	if err := json.Unmarshal([]byte(outcomes[1]), &failed); err != nil {
+		t.Fatal(err)
+	}
+	if failed.ConfigMatched || failed.ConfigIdentity.Matched || failed.ConfigIdentity.SubmittedSHA256 == "" ||
+		failed.ConfigIdentity.ExpectedSHA256 == "" || failed.ConfigIdentity.ReturnedSHA256 == "" ||
+		failed.ConfigIdentity.SubmittedBytes == 0 || failed.ConfigIdentity.ExpectedBytes == 0 || failed.ConfigIdentity.ReturnedBytes == 0 {
+		t.Fatalf("identity mismatch diagnostics are incomplete: %+v", failed)
+	}
+	if strings.Contains(outcomes[1], statResponseTestConfig) || strings.Contains(outcomes[1], "unexpected mutation") {
+		t.Fatalf("full config text leaked into identity diagnostics: %s", outcomes[1])
+	}
+}
+
+func newStatResponseTestBound(t *testing.T, capability bool) BoundEngine {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "engine.bin")
+	payload := []byte("bound-engine")
+	if err := os.WriteFile(path, payload, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(payload)
+	return BoundEngine{
+		binaryPath:           path,
+		artifactSHA256:       hex.EncodeToString(digest[:]),
+		bindingSHA256:        strings.Repeat("d", 64),
+		sourceManifestSHA256: strings.Repeat("a", 64),
+		patchManifestSHA256:  strings.Repeat("c", 64),
+		ordinarySeed:         capability,
+	}
+}
+
+func statResponseTestResult(config string, seed int64) OrdinaryResult {
+	expectedConfig, _ := expectedEngineConfigText(config)
+	dps := 100.0
+	characters := map[string]float64{"a": 70, "b": 30}
+	if strings.Contains(config, "a add stats atk=10;") {
+		dps = 110
+		characters = map[string]float64{"a": 75, "b": 35}
+	} else if strings.Contains(config, "a add stats hp%=-5;") {
+		characters = map[string]float64{"a": 69, "b": 31}
+	}
+	return OrdinaryResult{
+		Iterations:         1,
+		DPS:                dps,
+		CharacterDPS:       characters,
+		SampleSeed:         strconv.FormatInt(seed, 10),
+		ConfigFile:         expectedConfig,
+		NumberOfWorkers:    1,
+		ConfigSHA256:       digestText(config),
+		EngineResultSHA256: strings.Repeat("b", 64),
+	}
+}
+
+func assertStatResponseRecorderBeforeCall(t *testing.T, runDirectory string, expectedAttempts int) {
+	t.Helper()
+	attempts := readJSONLines(t, filepath.Join(runDirectory, "attempts.jsonl"))
+	outcomes := readJSONLines(t, filepath.Join(runDirectory, "outcomes.jsonl"))
+	if len(attempts) != expectedAttempts || len(outcomes) != expectedAttempts-1 {
+		t.Fatalf("recorder was not written around call: attempts=%d outcomes=%d", len(attempts), len(outcomes))
+	}
+}
+
+func readJSONLines(t *testing.T, path string) []string {
+	t.Helper()
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	lines := strings.Split(strings.TrimSpace(string(payload)), "\n")
+	if len(lines) == 1 && lines[0] == "" {
+		return nil
+	}
+	for index := range lines {
+		lines[index] = strings.TrimSpace(lines[index])
+	}
+	return lines
+}
