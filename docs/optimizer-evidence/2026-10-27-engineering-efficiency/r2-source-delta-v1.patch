+func TestArtifactChangedMaskErrorRecoveryAndFallbacks(t *testing.T) {
+	for _, mode := range []string{"partial", "over64", "noActive"} {
+		t.Run(mode, func(t *testing.T) {
+			dimensions, yIndex := 3, 1
+			if mode == "over64" {
+				dimensions, yIndex = 65, 64
+			}
+			b := newProgramBuilder(make([]string, dimensions))
+			x, _ := b.add(compiledNode{op: opArtifactStat, coordinate: 0})
+			y, _ := b.add(compiledNode{op: opArtifactStat, coordinate: yIndex})
+			half, _ := b.add(compiledNode{op: opConstant, value: .5})
+			zero, _ := b.add(compiledNode{op: opConstant, value: 0})
+			one, _ := b.add(compiledNode{op: opConstant, value: 1})
+			power, _ := b.add(compiledNode{op: opPower, inputs: []uint32{x, half}})
+			root, _ := b.add(compiledNode{op: opSelectLT, inputs: []uint32{y, zero, power, one}})
+			p := b.finish(root)
+			if mode == "noActive" {
+				p.active, p.dependencies, p.previous = nil, nil, nil
+				p.usedInputs = 0
+			}
+			oracle := copyArtifactScratch(p)
+			for step, pair := range [][2]float64{{4, 1}, {9, 1}, {-4, 1}, {9, 1}, {16, -1}, {9, -1}, {9, 0}} {
+				point := make([]float64, dimensions)
+				point[0], point[yIndex] = pair[0], pair[1]
+				got, err := p.Evaluate(point)
+				want, other := scanArtifactEvaluation(oracle, point)
+				if fmt.Sprint(err) != fmt.Sprint(other) || math.Float64bits(got) != math.Float64bits(want) {
+					t.Fatalf("step %d: got=%v want=%v errors=%v/%v", step, got, want, err, other)
+				}
+				if step == 2 && (err == nil || p.previousValid) {
+					t.Fatal("unused select branch error disappeared or left valid scratch")
+				}
+				if step == 2 && p.changedPlanReady {
+					t.Fatal("failed scan admitted an incomplete plan")
+				}
+				if step == 3 && (p.changedPlanReady || p.lastChangedMask != 0 || len(p.changedActive) != 0) {
+					t.Fatal("error recovery retained partial-mask admission")
+				}
+				if mode != "partial" && (p.changedActive != nil || p.dependencies != nil) {
+					t.Fatal("fallback used a partial plan")
+				}
+			}
+		})
+	}
