+++ b/internal/contracts/theory_options_test.go
@@ -0,0 +1,101 @@
+package contracts
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestEmptyTheoryOptionsRetainWireCompatibilityFence(t *testing.T) {
+	req := neutralTheoryRequest(t)
+	req.TheoryOptions = &TheorySearchOptions{}
+	payload, err := CanonicalJSON(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(payload, []byte(`"theory_options":{}`)) {
+		t.Fatal("empty new-backend fence omitted")
+	}
+	raw, expanded, err := DecodeTheoryRequest(payload)
+	if err != nil || raw.TheoryOptions == nil || expanded.TheoryOptions == nil {
+		t.Fatalf("empty Theory options lost: %v", err)
+	}
+	again, err := CanonicalJSON(raw)
+	if err != nil || !bytes.Equal(payload, again) {
+		t.Fatal("empty Theory options changed request identity")
+	}
+}
+
+func TestTheoryConstraintsSurviveWireExpansionAndIdentity(t *testing.T) {
+	req := neutralTheoryRequest(t)
+	owner := req.Wearers[0].WearerKey
+	req.TheoryOptions = &TheorySearchOptions{AllowedPackages: map[string][][]SetRequirement{owner: {{}, {{SetUID: "example", Count: 4}}}}, RollBounds: map[string]map[string]TheoryRollBound{owner: {"em": {Min: "18.25", Max: "20"}}}, MaxPackageEvaluations: 12}
+	raw, e := CanonicalJSON(req)
+	if e != nil {
+		t.Fatal(e)
+	}
+	decoded, expanded, e := DecodeTheoryRequest(raw)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if expanded.TheoryOptions.RollBounds[owner]["em"].Min != "18.25" {
+		t.Fatal("constraint lost")
+	}
+	got, e := CanonicalJSON(decoded)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if string(raw) != string(got) {
+		t.Fatal("constraint identity changed")
+	}
+	ordinary, e := DecodeRequest(readFixture(t, "request_v1.json"))
+	if e != nil {
+		t.Fatal(e)
+	}
+	ordinary.TheoryOptions = req.TheoryOptions
+	if ordinary.Validate() == nil {
+		t.Fatal("ordinary search accepted virtual constraints")
+	}
+}
+
+func TestTheoryConstraintsRejectUnknownOwnersAndInvalidBounds(t *testing.T) {
+	for _, options := range []*TheorySearchOptions{
+		{AllowedPackages: map[string][][]SetRequirement{"missing": {{}}}},
+		{MaxPackageEvaluations: -1},
+		{ScheduleContexts: -1},
+	} {
+		req := neutralTheoryRequest(t)
+		req.TheoryOptions = options
+		payload, _ := CanonicalJSON(req)
+		if _, _, e := DecodeTheoryRequest(payload); e == nil {
+			t.Fatalf("invalid options accepted: %+v", options)
+		}
+	}
+	req := neutralTheoryRequest(t)
+	owner := req.Wearers[0].WearerKey
+	for _, bound := range []TheoryRollBound{{Min: "NaN", Max: "20"}, {Min: "2", Max: "1"}, {Min: "0", Max: "Inf"}} {
+		req.TheoryOptions = &TheorySearchOptions{RollBounds: map[string]map[string]TheoryRollBound{owner: {"em": bound}}}
+		payload, _ := CanonicalJSON(req)
+		if _, _, e := DecodeTheoryRequest(payload); e == nil {
+			t.Fatalf("invalid bound accepted: %+v", bound)
+		}
+	}
+}
+
+func TestTheorySupportsNoDeadlineAndExplicitWorkPolicies(t *testing.T) {
+	req := neutralTheoryRequest(t)
+	req.Budgets.ProductTimeoutMS = 0
+	req.Budgets.DevelopmentTimeoutMS = 0
+	for _, options := range []*TheorySearchOptions{
+		{},
+		{MaxPackageEvaluations: 100001, MaxAllocationEvaluations: 10000001, MaxPreviews: 1000001, ScheduleContexts: 49},
+	} {
+		req.TheoryOptions = options
+		payload, err := CanonicalJSON(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, _, err := DecodeTheoryRequest(payload); err != nil {
+			t.Fatalf("valid explicit/no-limit policy rejected: %v", err)
+		}
+	}
+}
