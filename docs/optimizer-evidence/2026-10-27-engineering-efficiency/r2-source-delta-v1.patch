+					p := [4]domain.Package{a, b, c, d}
+					if _, visited := s.archive.visited[outputTupleKey(p)]; !visited {
+						s.archive.visited[outputTupleKey(p)] = "visited_without_lower_witness"
+					}
+				}
+			}
+		}
