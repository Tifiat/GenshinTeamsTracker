--- /dev/null
+++ b/internal/contracts/mechanic_validation.go
@@ -0,0 +1,141 @@
+package contracts
+
+import (
+	"fmt"
+	"path"
+	"reflect"
+	"strconv"
+	"strings"
+)
+
+func ValidateMechanicOperations(input MechanicOperations, engine EngineBinding) error {
+	if input.SchemaVersion != 1 || input.EngineSHA256 != engine.ArtifactSHA256 || input.SourceManifestSHA256 != engine.SourceManifestSHA256 {
+		return fmt.Errorf("mechanic operation schema or engine/source binding mismatch")
+	}
+	capable := false
+	for _, capability := range engine.Capabilities { capable = capable || capability == MechanicOperationsCapability }
+	if !capable { return fmt.Errorf("mechanic operation capability is absent") }
+	if len(input.Operations) > 8192 { return fmt.Errorf("mechanic operation count limit") }
+	seen := map[string]bool{}
+	budget:=mechanicPayloadBudget{}
+	for _, operation := range input.Operations {
+		if len(operation.Parameters)>maxMechanicArguments || len(operation.Effects)>maxMechanicEffects || len(operation.Reads)>maxMechanicResources || len(operation.Writes)>maxMechanicResources {return fmt.Errorf("mechanic operation nested limit")}
+		for _,text:=range []string{operation.Symbol,operation.Receiver,operation.Method,operation.Signature,operation.SourcePath} {if err:=budget.text(text,4096);err!=nil{return err}}
+		for _,parameter:=range operation.Parameters {if err:=budget.text(parameter.Type,1024);err!=nil{return err};if err:=budget.text(parameter.Encoding,256);err!=nil{return err}}
+		for _,effect:=range operation.Effects {if err:=budget.text(string(effect),256);err!=nil{return err}}
+		for _,effects:=range [][]MechanicResourceEffect{operation.Reads,operation.Writes}{for _,effect:=range effects{for _,text:=range []string{effect.Resource,effect.OwnerBinding,effect.Lifetime}{if err:=budget.text(text,256);err!=nil{return err}}}}
+		if operation.Symbol != operation.Receiver+"."+operation.Method || operation.Receiver == "" || operation.Method == "" || seen[operation.Symbol] || operation.Signature == "" {
+			return fmt.Errorf("invalid or duplicate mechanic operation symbol/signature")
+		}
+		seen[operation.Symbol] = true
+		if path.IsAbs(operation.SourcePath) || path.Clean(operation.SourcePath) != operation.SourcePath || strings.Contains(operation.SourcePath,"\\") || strings.HasPrefix(operation.SourcePath,"../") || !strings.HasSuffix(operation.SourcePath,".go") || !sha256Pattern.MatchString(operation.SourceSHA256) || !sha256Pattern.MatchString(operation.ClosureSHA256) {
+			return fmt.Errorf("invalid mechanic operation source identity")
+		}
+	}
+	return nil
+}
+
+func (operation MechanicOperation) HasEffect(kind MechanicEffectKind) bool {
+	for _, effect := range operation.Effects { if effect == kind { return true } }
+	return false
+}
+
+// A new effect within a supported envelope is incomplete semantics, not a
+// protocol failure and never an implicit pure operation.
+func (operation MechanicOperation) OpaqueEffects() bool {
+	if len(operation.Effects) == 0 { return true }
+	for _,parameter:=range operation.Parameters {if !parameter.Known{return true}}
+	for _, effect := range operation.Effects {
+		switch effect {
+		case MechanicEffectPure,MechanicEffectRead,MechanicEffectWrite,MechanicEffectSchedule,MechanicEffectRandom:
+		default: return true
+		}
+	}
+	for _,effects:=range [][]MechanicResourceEffect{operation.Reads,operation.Writes} {
+		for _,effect:=range effects {
+			if effect.Resource=="" || effect.Lifetime=="" || effect.OwnerBinding=="" { return true }
+			if effect.OwnerBinding!="receiver" && effect.OwnerBinding!="shared" && !strings.HasPrefix(effect.OwnerBinding,"argument:") { return true }
+			if strings.HasPrefix(effect.OwnerBinding,"argument:") {
+				index,err:=strconv.Atoi(strings.TrimPrefix(effect.OwnerBinding,"argument:"))
+				if err!=nil || index<0 || index>=len(operation.Parameters) || operation.Variadic && index==len(operation.Parameters)-1 {return true}
+			}
+		}
+	}
+	return false
+}
+
+func ValidateMechanicInvocationTrace(trace MechanicInvocationTrace) error {
+	if trace.SchemaVersion != 1 || !sha256Pattern.MatchString(trace.ContextSHA256) || !sha256Pattern.MatchString(trace.ConfigSHA256) || !sha256Pattern.MatchString(trace.MemberContentSHA256) || trace.Seed == "" || trace.TraceID == "" || len(trace.Invocations) > 4096 {
+		return fmt.Errorf("invalid mechanic invocation envelope")
+	}
+	seen := map[string]bool{}
+	budget:=mechanicPayloadBudget{}
+	if trace.Scope!="declared_operation_set" || len(trace.CoveredOperations)>8192 {return fmt.Errorf("mechanic invocation scope is unavailable")}
+	covered:=map[string]bool{}
+	for _,symbol:=range trace.CoveredOperations {if err:=budget.text(symbol,1024);err!=nil{return err};if symbol=="" || covered[symbol]{return fmt.Errorf("invalid mechanic operation coverage")};covered[symbol]=true}
+	if err:=budget.text(trace.TraceID,1024);err!=nil{return err}
+	if len(trace.MissingReasons)>128 {return fmt.Errorf("mechanic trace reason limit")}
+	for _,reason:=range trace.MissingReasons {if err:=budget.text(reason,1024);err!=nil{return err}}
+	seed,seedErr:=strconv.ParseUint(trace.Seed,10,64)
+	if seedErr!=nil || strconv.FormatUint(seed,10)!=trace.Seed { return fmt.Errorf("invalid mechanic invocation seed") }
+	last := uint64(0)
+	for _, invocation := range trace.Invocations {
+		if invocation.ID == "" || seen[invocation.ID] || invocation.Order <= last || invocation.Frame < 0 || !covered[invocation.OperationSymbol] || invocation.SourceOccurrence == "" || invocation.CallPath == "" || invocation.Receiver.Type=="" || invocation.Receiver.Resource=="" || invocation.Receiver.Instance == "" || invocation.Receiver.Lifetime == "" || invocation.ContextSHA256 != trace.ContextSHA256 || invocation.ConfigSHA256 != trace.ConfigSHA256 || invocation.Seed != trace.Seed || invocation.TraceID != trace.TraceID {
+			return fmt.Errorf("invalid or ambiguously identified mechanic invocation")
+		}
+		seen[invocation.ID],last = true,invocation.Order
+		if len(invocation.Arguments)>maxMechanicArguments || len(invocation.Before)>maxMechanicResources || len(invocation.After)>maxMechanicResources {return fmt.Errorf("mechanic invocation nested limit")}
+		for _,text:=range []string{invocation.ID,invocation.OperationSymbol,invocation.SourceOccurrence,invocation.CallPath,invocation.Receiver.Type,invocation.Receiver.Resource,invocation.Receiver.Instance,invocation.Receiver.Lifetime} {if err:=budget.text(text,1024);err!=nil{return err}}
+		for _,argument:=range invocation.Arguments {for _,text:=range []string{argument.Type,argument.Encoding,argument.Value}{if err:=budget.text(text,4096);err!=nil{return err}}}
+		for _,argument:=range invocation.Arguments {if _,err:=ValidateMechanicArgument(argument);err!=nil{return err}}
+		for _, observations := range [][]MechanicResourceObservation{invocation.Before,invocation.After} {
+			for _, observation := range observations {
+				if len(observation.ReadRoots)>1024 {return fmt.Errorf("mechanic read-root limit")}
+				for _,text:=range []string{observation.Identity.Resource,observation.Identity.Instance,observation.Identity.Lifetime,observation.Provenance,observation.SourceOccurrence}{if err:=budget.text(text,1024);err!=nil{return err}}
+				if err:=budget.value(observation.Value,0);err!=nil{return err}
+				if observation.Identity.Instance == "" || observation.Identity.Lifetime == "" || observation.Identity.Resource == "" || observation.Provenance != "observed_only" && observation.Provenance != "source_reads" || observation.Provenance == "source_reads" && (observation.SourceOccurrence == "" || len(observation.ReadRoots) == 0) {
+					return fmt.Errorf("unbound mechanic resource observation")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// JoinMechanicInvocation requires the complete invocation identity, including
+// argument values and resource lifetime. It never searches by nearest frame or
+// substitutes a neutral invocation for an absent target-context call.
+func JoinMechanicInvocation(trace MechanicInvocationTrace, expected MechanicInvocation) (*MechanicInvocation,string,error) {
+	return joinMechanicInvocation(trace,expected,false)
+}
+
+// The caller supplies the already verified compact member and its actual byte
+// digest, not a producer-declared list of acceptable root IDs.
+func JoinMechanicInvocationForMember(trace MechanicInvocationTrace, expected MechanicInvocation, member IRSeedMember, memberSHA256,contextSHA256,configSHA256 string) (*MechanicInvocation,string,error) {
+	if err:=ValidateMechanicInvocationTrace(trace);err!=nil{return nil,"",err}
+	if trace.MemberContentSHA256!=memberSHA256 || trace.ContextSHA256!=contextSHA256 || trace.ConfigSHA256!=configSHA256 || trace.Seed!=strconv.FormatUint(member.Seed,10) {return nil,"",fmt.Errorf("mechanic invocation graph binding mismatch")}
+	nodes:=make(map[uint32]bool,len(member.Nodes))
+	for _,node:=range member.Nodes{nodes[node.NodeID]=true}
+	for _,invocation:=range trace.Invocations {for _,values:=range [][]MechanicResourceObservation{invocation.Before,invocation.After}{for _,value:=range values{for _,root:=range value.ReadRoots{if !nodes[root]{return nil,"",fmt.Errorf("mechanic read-root is absent from the verified graph")}}}}}
+	return joinMechanicInvocation(trace,expected,true)
+}
+
+func joinMechanicInvocation(trace MechanicInvocationTrace, expected MechanicInvocation, rootsVerified bool) (*MechanicInvocation,string,error) {
+	if err := ValidateMechanicInvocationTrace(trace); err != nil { return nil,"",err }
+	if !trace.Complete || trace.Truncated || len(trace.MissingReasons) != 0 { return nil,"mechanic_invocation_trace_incomplete",nil }
+	if expected.ID == "" { return nil,"mechanic_invocation_identity_missing",nil }
+	for _, invocation := range trace.Invocations {
+		if invocation.ID != expected.ID { continue }
+		if !invocation.Complete { return nil,"mechanic_invocation_incomplete",nil }
+		if !rootsVerified {for _,values:=range [][]MechanicResourceObservation{invocation.Before,invocation.After}{for _,value:=range values{if value.Provenance=="source_reads" || len(value.ReadRoots)>0{return nil,"mechanic_resource_dependencies_unverified",nil}}}}
+		for _,argument:=range invocation.Arguments {
+			known,err:=ValidateMechanicArgument(argument);if err!=nil{return nil,"",err};if !known{return nil,"mechanic_invocation_argument_unmodeled",nil}
+		}
+		if invocation.OperationSymbol != expected.OperationSymbol || invocation.SourceOccurrence != expected.SourceOccurrence || invocation.CallPath != expected.CallPath || invocation.ContextSHA256 != expected.ContextSHA256 || invocation.ConfigSHA256 != expected.ConfigSHA256 || invocation.Seed != expected.Seed || invocation.TraceID != expected.TraceID || invocation.Order != expected.Order || invocation.Frame != expected.Frame || invocation.Receiver != expected.Receiver || !reflect.DeepEqual(invocation.Arguments,expected.Arguments) || invocation.CallerOwner != expected.CallerOwner || invocation.CallerKnown != expected.CallerKnown {
+			return nil,"mechanic_invocation_identity_mismatch",nil
+		}
+		copy := cloneMechanicInvocation(invocation)
+		return &copy,"",nil
+	}
+	return nil,"mechanic_invocation_not_observed",nil
+}
diff --git a/internal/contracts/mechanics.go b/internal/contracts/mechanics.go
