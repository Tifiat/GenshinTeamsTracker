+type outputFamilyWant struct {
+	score      float64
+	deficit    float64
+	refinement int
+	group      bool
+	sensitive  bool
+	reason     string
+	witness    alloc.State
+	aliases    map[string]Alias
+}
+
+type outputContractWant struct {
+	request, session, phase                string
+	version                                int64
+	terminal                               bool
+	reference                              float64
+	wearers                                [4]string
+	families                               map[string]outputFamilyWant
