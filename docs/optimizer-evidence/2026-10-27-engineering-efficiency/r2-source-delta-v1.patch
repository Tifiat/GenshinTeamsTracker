+func TestMechanicIRCorruptAndCacheOff(t *testing.T) {
+	dir := t.TempDir()
+	key := strings.Repeat("d", 64)
+	builds := 0
+	build := func() (MechanicIR, error) {
+		builds++
+		return MechanicIR{Schema: mechanicIRSchema, Compiler: mechanicIRCompiler, Entry: "example", Coverage: MechanicIRCoverage{Parse: "parsed", Link: "partial", Semantics: "partial", Runtime: "unverified"}}, nil
+	}
+	first := NewRuleParseCache("", dir)
+	if _, origin, err := first.loadMechanicIR(key, MechanicIR{Entry: "example"}, build); err != nil || origin != "source" {
+		t.Fatalf("cold: %s %v", origin, err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, key+".gttir"), []byte("corrupt"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	second := NewRuleParseCache("", dir)
+	if _, origin, err := second.loadMechanicIR(key, MechanicIR{Entry: "example"}, build); err != nil || origin != "source" {
+		t.Fatalf("corrupt fallback: %s %v", origin, err)
+	}
+	if second.MechanicIRStats().Repairs != 1 {
+		t.Fatal("corrupt entry not recorded")
+	}
+	t.Setenv("GTT_MECHANIC_CACHE_ENABLED", "0")
+	off := NewRuleParseCache(dir, dir)
+	if off.writableDir != "" || off.readOnlyBundledDir != "" {
+		t.Fatal("cache off kept disk roots")
+	}
+	if _, origin, err := off.loadMechanicIR(key, MechanicIR{Entry: "example"}, build); err != nil || origin != "source" {
+		t.Fatalf("cache off: %s %v", origin, err)
+	}
+	if builds != 3 {
+		t.Fatalf("unexpected compile count %d", builds)
+	}
+}
