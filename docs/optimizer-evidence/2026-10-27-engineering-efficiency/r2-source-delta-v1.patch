+	compact.RequestSHA256 = requestSHA
+	panel, err := evaluator.Compile(request, compact)
+	if err != nil {
+		t.Fatal(err)
+	}
+	indexed, err := domain.Build(request, panel.Coordinates())
+	if err != nil {
+		t.Fatal(err)
+	}
+	engine, err := New(indexed, panel, DefaultConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return engine, indexed
+}
