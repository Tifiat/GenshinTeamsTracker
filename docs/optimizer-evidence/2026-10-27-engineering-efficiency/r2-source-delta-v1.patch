+func TestSessionBindingFailureClosesAllForks(t *testing.T) {
+	cfg, spec := sessionFixtureConfig(t, [4]int{2, 1, 1, 1})
+	w, ledger := newSessionFixtureWorld(spec)
+	s, err := New(cfg, w)
+	if err != nil {
