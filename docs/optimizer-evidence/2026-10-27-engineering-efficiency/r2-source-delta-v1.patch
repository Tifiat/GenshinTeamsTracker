+package contracts
+
+import "regexp"
+
+var mechanicConsumerSite = regexp.MustCompile(`^rule_[a-z0-9_]+\.go:[1-9][0-9]{0,6}$`)
+
+// The site names evaluator code only, never an engine frame or an absolute path.
+func ValidMechanicConsumerSite(site string) bool {
+	return site == "" || mechanicConsumerSite.MatchString(site)
+}
+
+// MechanicBoundaryKind describes why a source evaluation stopped. Diagnostic
+// text is presentation only: neither routing nor coverage may inspect it.
+type MechanicBoundaryKind string
+
+// MechanicReasonCode is a diagnostic category only. It must never determine
+// routing, pruning, cache validity, or source coverage. Raw Reason remains an
+// in-process explanation and is never required by the frozen record store.
+type MechanicReasonCode string
+
+const (
+	MechanicUnsupportedSource MechanicBoundaryKind = "unsupported_source"
+	MechanicUnknownOperation  MechanicBoundaryKind = "unknown_operation"
+	MechanicScheduleChange    MechanicBoundaryKind = "schedule_change"
+	MechanicAnalysisBudget    MechanicBoundaryKind = "analysis_budget"
+	MechanicInvalidOperation  MechanicBoundaryKind = "invalid_operation"
+)
+
+const (
+	MechanicReasonUnclassifiedUnsupported MechanicReasonCode = "unclassified_unsupported"
+	MechanicReasonUnknownOperation        MechanicReasonCode = "unknown_operation"
+	MechanicReasonSharedGlobalState       MechanicReasonCode = "shared_global_engine_state"
+	MechanicReasonSymbolicControlFlow     MechanicReasonCode = "symbolic_control_flow"
+	MechanicReasonUnsupportedArithmetic   MechanicReasonCode = "unsupported_arithmetic"
+	MechanicReasonUnsupportedType         MechanicReasonCode = "unsupported_type_or_assertion"
+	MechanicReasonAnalysisBudget          MechanicReasonCode = "analysis_budget"
+	MechanicReasonDependencyLink          MechanicReasonCode = "dependency_link"
+	MechanicReasonMapIteration            MechanicReasonCode = "map_iteration_unproven"
+	MechanicReasonUnobservedRuntimeFact   MechanicReasonCode = "unobserved_runtime_fact"
+	MechanicReasonDynamicSchedule         MechanicReasonCode = "dynamic_schedule"
+	MechanicReasonInvalidOperation        MechanicReasonCode = "invalid_operation"
+)
+
+func ValidMechanicReasonCode(code MechanicReasonCode) bool {
+	switch code {
+	case MechanicReasonUnclassifiedUnsupported, MechanicReasonUnknownOperation,
+		MechanicReasonSharedGlobalState, MechanicReasonSymbolicControlFlow,
+		MechanicReasonUnsupportedArithmetic, MechanicReasonUnsupportedType,
+		MechanicReasonAnalysisBudget, MechanicReasonDependencyLink,
+		MechanicReasonMapIteration, MechanicReasonUnobservedRuntimeFact,
+		MechanicReasonDynamicSchedule, MechanicReasonInvalidOperation:
+		return true
+	default:
+		return false
+	}
+}
+
+// MechanicBoundary is an observation of ONE bound source execution. It must
+// never be persisted as the static coverage of a reusable mechanic program.
+// Unknown operations conservatively have no certified output-impact mask.
+type MechanicBoundary struct {
+	MechanicUID  string               `json:"mechanic_uid,omitempty"`
+	Kind         MechanicBoundaryKind `json:"kind"`
+	ReasonCode   MechanicReasonCode   `json:"reason_code,omitempty"`
+	ConsumerSite string               `json:"consumer_site,omitempty"`
+	Reason       string               `json:"reason"`
+	Operation    string               `json:"operation,omitempty"`
+	Receiver     string               `json:"receiver,omitempty"`
+	Owner        int                  `json:"owner"`
+	OwnerKnown   bool                 `json:"owner_known"`
+	OwnerRole    string               `json:"owner_role,omitempty"`
+	CallerOwner  int                  `json:"caller_owner"`
+	CallerKnown  bool                 `json:"caller_known"`
+	Frame        int                  `json:"frame"`
+	Order        uint64               `json:"order"`
+	Seed         string               `json:"seed,omitempty"`
+}
+
+// BoundMechanicBoundary keeps runtime evidence tied to its actual context.
+// A source/AST/cache identity alone cannot authorize reuse of this observation.
+type BoundMechanicBoundary struct {
+	ContextSHA256 string           `json:"context_sha256"`
+	Boundary      MechanicBoundary `json:"boundary"`
+}
diff --git a/internal/contracts/model_unavailable_result_test.go b/internal/contracts/model_unavailable_result_test.go
