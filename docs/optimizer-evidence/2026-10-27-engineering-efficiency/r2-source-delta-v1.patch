+		representativeProjectionCandidate("reentry", 7, -20, "initial-low", nil),
+		representativeProjectionCandidate("reentry", 8, 85, "late-leader", nil),
+	}
+	for i := 0; i < contracts.MaxResultBuildsPerGroup+2; i++ {
+		events = append(events, representativeProjectionCandidate("bulk", int64(1000+i), 500-float64(i), "bulk", nil))
+	}
+	invalidContext := representativeProjectionCandidate("invalid", 2000, 100, "nil-context", nil)
+	invalidContext.Context = nil
+	events = append(events,
