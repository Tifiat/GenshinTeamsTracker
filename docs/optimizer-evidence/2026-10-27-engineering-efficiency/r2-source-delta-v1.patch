+package mechanicpolicy
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestDecideOrdinaryAnchorConsumesOnlyExistingSlot(t *testing.T) {
+	request := Request{Failure: ModelUnavailable, HasLegalAnchor: true, RemainingOrdinarySlots: 3}
+	got := Decide(request)
+	if !got.Recoverable || !got.VerifyOrdinary || got.OrdinarySlots != 1 || got.FormulaAvailable || got.MeasuredAnchorAvailable {
+		t.Fatalf("ordinary policy: %#v", got)
+	}
+	for _, change := range []func(*Request){func(r *Request) { r.FastMode = true }, func(r *Request) { r.FinishedEarly = true }, func(r *Request) { r.RemainingOrdinarySlots = 0 }, func(r *Request) { r.HasMeasuredAnchor = true }} {
+		copy := request
+		change(&copy)
+		got = Decide(copy)
+		if !got.Recoverable || got.VerifyOrdinary || got.OrdinarySlots != 0 {
+			t.Fatalf("unexpected measurement: %#v", got)
+		}
+	}
+}
+
+func TestDecideDoesNotSwallowInvalidProtocolOrCancel(t *testing.T) {
+	for _, failure := range []Failure{InvalidInput, EngineProtocol, Cancelled} {
+		got := Decide(Request{Failure: failure, HasLegalAnchor: true, RemainingOrdinarySlots: 5})
+		if got.Recoverable || got.VerifyOrdinary {
+			t.Fatalf("%s became model fallback: %#v", failure, got)
+		}
+	}
+}
+
+func TestTypedModelUnavailableKeepsBoundedDiagnosticCodes(t *testing.T) {
+	code := strings.Repeat("x", 300)
+	err := NewModelUnavailable(ModelUnavailable, []string{"b", code, "a"})
+	wrapped := errors.Join(errors.New("outer"), err)
+	got, ok := AsModelUnavailable(wrapped)
+	if !ok || got.Kind != ModelUnavailable || got.Codes[0] != "a" || len(got.Codes[2]) != 256 {
+		t.Fatalf("typed source boundary: %#v %v", got, ok)
+	}
+	if NewModelUnavailable(Cancelled, nil) != nil {
+		t.Fatal("cancel classified as model unavailable")
+	}
+}
+
+func TestNoLegalAnchorIsSeparateFromMechanicError(t *testing.T) {
+	_, _, err := SelectInventoryAnchor(nil)
+	var noLegal *NoLegalAnchorError
+	if !errors.As(err, &noLegal) {
+		t.Fatalf("missing legal-build classification: %v", err)
+	}
+	if _, ok := AsModelUnavailable(err); ok {
+		t.Fatal("legal input failure became mechanic model failure")
+	}
+}
