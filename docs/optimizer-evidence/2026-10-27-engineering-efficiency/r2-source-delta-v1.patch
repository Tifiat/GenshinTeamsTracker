+
+func TestEnergyLedgerZeroCapacityFailClosed(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(*IREnergyLedger)
+	}{
+		{"negative_max", func(l *IREnergyLedger) { l.InitialStates[0].EnergyMax = "-1" }},
