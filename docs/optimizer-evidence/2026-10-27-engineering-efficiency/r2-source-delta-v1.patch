new file mode 100644
--- /dev/null
+++ b/cmd/gtt-optimizer/theory_support_response.go
@@ -0,0 +1,89 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+	"genshinteamstracker/native/gcsim_optimizer/internal/supportimpact"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theoryverify"
+)
+
+type theoryCoverageResolver func(context.Context, [4]domain.Package) (supportimpact.Report, error)
+
+// This adapter connects Theory to the same structural detector and bounded
+// ordinary-response panel used by Selected/All. It owns no gameplay rules or
+// corrected DPS. The archive invokes it once and reserves final full-build
+// measurements inside the existing lifetime finalist limit.
+func commonTheoryResponseProducer(runRoot string, coverageFor theoryCoverageResolver, run responseCheckRunner) theoryverify.ResponseProducer {
+	return func(ctx context.Context, request contracts.OptimizerRequest, anchor theoryverify.ResponseAnchor, candidate theoryverify.Candidate) (theoryverify.ResponsePanel, error) {
+		out := theoryverify.ResponsePanel{
+			AnchorCandidateSHA256: anchor.CandidateSHA256,
+			AnchorConfigSHA256:    anchor.Config.SHA256,
+			EngineArtifactSHA256:  anchor.EngineArtifactSHA256,
+			SourceManifestSHA256:  anchor.SourceManifestSHA256,
+			Binding:               anchor.Binding,
+		}
+		if coverageFor == nil || run == nil || runRoot == "" {
+			return out, fmt.Errorf("missing common Theory response context")
+		}
+		packages, err := candidate.Packages()
+		if err != nil {
+			return out, err
+		}
+		coverage, err := coverageFor(ctx, packages)
+		if err != nil {
+			return out, err
+		}
+		check, err := run(ctx, request, coverage, anchor.Config.Text, runRoot,
+			supportimpact.ResponseAllowance{MaxCalls: supportResponseCalls, Timeout: 180 * time.Second})
+		out.Status = check.Status
+		if err != nil {
+			return out, err
+		}
+		if len(check.Directions) == 0 {
+			return out, nil
+		}
+		binding := theoryResponseBinding(check.Binding)
+		if binding != anchor.Binding {
+			return out, fmt.Errorf("common Theory response belongs to another full-build anchor")
+		}
+		out.Binding = binding
+		knownForeign := coverage.KnownForeignCoordinates()
+		for _, direction := range check.Directions {
+			if theoryResponseBinding(direction.Binding) != anchor.Binding {
+				return out, fmt.Errorf("common Theory direction belongs to another full-build anchor")
+			}
+			changes := make(map[int64]float64, len(direction.SeedDPSChanges))
+			results := make(map[int64]string, len(direction.ResultSHA256BySeed))
+			for seed, value := range direction.SeedDPSChanges {
+				changes[seed] = value
+			}
+			for seed, value := range direction.ResultSHA256BySeed {
+				results[seed] = value
+			}
+			out.Directions = append(out.Directions, theoryverify.ResponseDirection{
+				Binding: binding, Owner: direction.Owner, Stat: direction.Stat, Amount: direction.Amount,
+				MeanDPSChange: direction.MeanDPSChange, MinimumDPSChange: direction.MinimumDPSChange,
+				MaximumDPSChange: direction.MaximumDPSChange, MeanOtherDPSChange: direction.MeanOtherDPSChange,
+				MinimumOtherDPSChange: direction.MinimumOtherDPSChange,
+				CrossAncestryMissing:  !knownForeign[direction.Owner+"."+direction.Stat],
+				SeedDPSChanges:        changes, Status: direction.Status, ConfigSHA256: direction.ConfigSHA256,
+				ResultSHA256BySeed: results,
+			})
+		}
+		return out, nil
+	}
+}
+
+func theoryResponseBinding(binding engineclient.StatResponseBinding) theoryverify.ResponseBinding {
+	return theoryverify.ResponseBinding{
+		AnchorConfigSHA256: binding.AnchorConfigSHA256, RequestSHA256: binding.RequestSHA256,
+		EngineArtifactSHA256: binding.EngineArtifactSHA256, EngineBindingSHA256: binding.EngineBindingSHA256,
+		EngineSourceManifestSHA256: binding.EngineSourceManifestSHA256,
+		EnginePatchManifestSHA256:  binding.EnginePatchManifestSHA256,
+	}
+}
