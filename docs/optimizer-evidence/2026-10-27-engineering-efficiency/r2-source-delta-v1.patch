diff --git a/internal/seteffects/rule_immutable_globals.go b/internal/seteffects/rule_immutable_globals.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_immutable_globals.go
@@ -0,0 +1,419 @@
+package seteffects
+
+// A Go var is not a Go constant. This narrow certificate admits only a private
+// literal table whose complete active package uses keep its backing storage
+// private and read-only. Any unrecognized syntax or alias use fails closed.
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"path"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func immutableGlobalNames(p *ruleProgram, m *ruleModule) []string {
+	if p == nil || m == nil || m.initializationUnsafe || len(m.blankImports) != 0 {
+		return nil
+	}
+	for _, f := range m.files {
+		for _, imp := range f.Imports {
+			if imp.Path.Value == `"unsafe"` || imp.Path.Value == `"reflect"` {
+				return nil
+			}
+		}
+	}
+	var names []string
+	for name, global := range m.globals {
+		if global.constant || ast.IsExported(name) || name == "_" || global.expr == nil || !immutableTableShape(p, global.env, global.expr) {
+			continue
+		}
+		if !immutableLiteral(p, global.env, global.expr) || !immutableTableUses(m, name, global.expr) {
+			continue
+		}
+		// A linker directive outside the package may name a private symbol.
+		// The repository is the verified active source closure for this engine.
+		if p.repository != nil {
+			linked := false
+			for _, body := range p.repository.files {
+				if strings.Contains(string(body), "go:linkname") && strings.Contains(string(body), name) {
+					linked = true
+					break
+				}
+			}
+			if linked {
+				continue
+			}
+		}
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// Only scalar arrays/slices and maps to scalar slices are admitted. Structs,
+// pointers, interfaces, calls, and nesting deeper than one slice are excluded.
+func immutableTableShape(p *ruleProgram, env *ruleEnv, expr ast.Expr) bool {
+	cl, ok := expr.(*ast.CompositeLit)
+	if !ok {
+		return false
+	}
+	switch typ := cl.Type.(type) {
+	case *ast.ArrayType:
+		if !immutableScalarType(p, env, typ.Elt, 0) {
+			return false
+		}
+	case *ast.MapType:
+		if !immutableScalarType(p, env, typ.Key, 0) {
+			return false
+		}
+		elt, ok := typ.Value.(*ast.ArrayType)
+		if !ok || !immutableScalarType(p, env, elt.Elt, 0) {
+			return false
+		}
+	default:
+		return false
+	}
+	return true
+}
+
+func immutableScalarType(p *ruleProgram, env *ruleEnv, expr ast.Expr, depth int) bool {
+	if depth > 8 || env == nil {
+		return false
+	}
+	switch typ := expr.(type) {
+	case *ast.Ident:
+		if body := env.module.types[typ.Name]; body != nil {
+			typeEnv := env.module.typeEnvs[typ.Name]
+			if typeEnv == nil {
+				typeEnv = env
+			}
+			return immutableScalarType(p, typeEnv, body, depth+1)
+		}
+		switch typ.Name {
+		case "bool", "string", "byte", "rune", "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr", "float32", "float64":
+			return true
+		}
+		return false
+	case *ast.SelectorExpr:
+		alias, ok := typ.X.(*ast.Ident)
+		if !ok || env.imports[alias.Name] == "" {
+			return false
+		}
+		return immutableImportedScalar(p, env.imports[alias.Name], typ.Sel.Name, depth+1)
+	}
+	return false
+}
+
+func immutableImportedScalar(p *ruleProgram, module, symbol string, depth int) bool {
+	if depth > 8 || p == nil || p.repository == nil {
+		return false
+	}
+	resolved := &ruleModule{name: module, types: map[string]ast.Expr{}, typeEnvs: map[string]*ruleEnv{}}
+	for _, fileName := range p.repository.packages[module] {
+		file, err := immutableRepositoryFile(p, fileName)
+		if err != nil {
+			return false
+		}
+		imports := map[string]string{}
+		for _, imp := range file.Imports {
+			value, err := strconv.Unquote(imp.Path.Value)
+			if err != nil {
+				return false
+			}
+			alias := path.Base(value)
+			if imp.Name != nil {
+				alias = imp.Name.Name
+			}
+			if alias == "." || alias == "_" {
+				continue
+			}
+			imports[alias] = value
+		}
+		env := &ruleEnv{module: resolved, imports: imports}
+		for _, decl := range file.Decls {
+			gen, ok := decl.(*ast.GenDecl)
+			if !ok || gen.Tok != token.TYPE {
+				continue
+			}
+			for _, spec := range gen.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				if resolved.types[typeSpec.Name.Name] != nil {
+					return false
+				}
+				resolved.types[typeSpec.Name.Name] = typeSpec.Type
+				resolved.typeEnvs[typeSpec.Name.Name] = env
+			}
+		}
+	}
+	body := resolved.types[symbol]
+	if body == nil {
+		return false
+	}
+	// Imported enums are scalar only after every active file's named types are
+	// visible; a package-level declaration named "int" shadows the predeclared
+	// type even when it lives in a neighboring source file.
+	return immutableScalarType(p, resolved.typeEnvs[symbol], body, depth+1)
+}
+
+func immutableLiteral(p *ruleProgram, env *ruleEnv, expr ast.Expr) bool {
+	switch x := expr.(type) {
+	case *ast.BasicLit:
+		return true
+	case *ast.ParenExpr:
+		return immutableLiteral(p, env, x.X)
+	case *ast.UnaryExpr:
+		return (x.Op == token.ADD || x.Op == token.SUB) && immutableLiteral(p, env, x.X)
+	case *ast.Ident:
+		if x.Name == "true" || x.Name == "false" {
+			return true
+		}
+		g, ok := env.module.globals[x.Name]
+		return ok && g.constant
+	case *ast.SelectorExpr:
+		pkg, ok := x.X.(*ast.Ident)
+		if !ok || env.imports[pkg.Name] == "" {
+			return false
+		}
+		return immutableImportedConst(p, env.imports[pkg.Name], x.Sel.Name)
+	case *ast.KeyValueExpr:
+		return immutableLiteral(p, env, x.Key) && immutableLiteral(p, env, x.Value)
+	case *ast.CompositeLit:
+		for _, item := range x.Elts {
+			if !immutableLiteral(p, env, item) {
+				return false
+			}
+		}
+		// Composite types are checked by immutableTableShape at the root;
+		// nested table elements can only be scalar slices or arrays.
+		return x.Type == nil || immutableTableShape(p, env, x) || immutableNestedScalarSlice(p, env, x.Type)
+	}
+	return false
+}
+
+func immutableNestedScalarSlice(p *ruleProgram, env *ruleEnv, expr ast.Expr) bool {
+	a, ok := expr.(*ast.ArrayType)
+	return ok && immutableScalarType(p, env, a.Elt, 0)
+}
+
+func immutableRepositoryFile(p *ruleProgram, fileName string) (*ast.File, error) {
+	body, ok := p.repository.files[fileName]
+	if !ok {
+		return nil, fmt.Errorf("immutable source file absent")
+	}
+	if p.parseCache != nil {
+		return p.parseCache.loadFile(fileName, body)
+	}
+	return parser.ParseFile(token.NewFileSet(), fileName, body, parser.SkipObjectResolution)
+}
+
+func immutableImportedConst(p *ruleProgram, module, symbol string) bool {
+	if p == nil || p.repository == nil {
+		return false
+	}
+	for _, path := range p.repository.packages[module] {
+		file, err := immutableRepositoryFile(p, path)
+		if err != nil {
+			return false
+		}
+		for _, decl := range file.Decls {
+			gen, ok := decl.(*ast.GenDecl)
+			if !ok || gen.Tok != token.CONST {
+				continue
+			}
+			for _, spec := range gen.Specs {
+				value, ok := spec.(*ast.ValueSpec)
+				if !ok {
+					continue
+				}
+				for _, name := range value.Names {
+					if name.Name == symbol {
+						return true
+					}
+				}
+			}
+		}
+	}
+	return false
+}
+
+func immutableTableUses(m *ruleModule, name string, initializer ast.Expr) bool {
+	for _, file := range m.files {
+		for _, decl := range file.Decls {
+			switch d := decl.(type) {
+			case *ast.GenDecl:
+				for _, spec := range d.Specs {
+					value, ok := spec.(*ast.ValueSpec)
+					if !ok {
+						continue
+					}
+					for _, expr := range value.Values {
+						if expr != initializer && immutableContainsName(expr, name) {
+							return false
+						}
+					}
+				}
+			case *ast.FuncDecl:
+				if d.Body != nil && !immutableFunctionUses(d, m.envs[file], name) {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+func immutableContainsName(n ast.Node, name string) bool {
+	found := false
+	ast.Inspect(n, func(node ast.Node) bool {
+		if id, ok := node.(*ast.Ident); ok && id.Name == name {
+			found = true
+		}
+		return !found
+	})
+	return found
+}
+
+func immutableFunctionUses(fn *ast.FuncDecl, env *ruleEnv, global string) bool {
+	if env == nil || env.module == nil {
+		return false
+	}
+	trustedNames := map[string]bool{"len": true}
+	for alias, imported := range env.imports {
+		if imported == "slices" {
+			trustedNames[alias] = true
+		}
+	}
+	for name := range trustedNames {
+		if env.module.functions[name] != nil || env.module.globals[name].env != nil || env.module.types[name] != nil {
+			return false
+		}
+	}
+	parents := map[ast.Node]ast.Node{}
+	stack := []ast.Node{}
+	ast.Inspect(fn, func(node ast.Node) bool {
+		if node == nil {
+			stack = stack[:len(stack)-1]
+			return true
+		}
+		if len(stack) != 0 {
+			parents[node] = stack[len(stack)-1]
+		}
+		stack = append(stack, node)
+		return true
+	})
+	// Reject shadowing without relying on SkipObjectResolution's absent object
+	// links. This is deliberately stronger than necessary.
+	shadowed := false
+	aliases := map[string]*ast.AssignStmt{}
+	ast.Inspect(fn, func(node ast.Node) bool {
+		switch x := node.(type) {
+		case *ast.Field:
+			for _, id := range x.Names {
+				if immutableShadowName(id.Name, global, trustedNames) {
+					shadowed = true
+				}
+			}
+		case *ast.AssignStmt:
+			for _, left := range x.Lhs {
+				if id, ok := left.(*ast.Ident); ok && immutableShadowName(id.Name, global, trustedNames) && x.Tok == token.DEFINE {
+					shadowed = true
+				}
+			}
+			if x.Tok == token.DEFINE && len(x.Lhs) == 1 && len(x.Rhs) == 1 {
+				id, idOK := x.Lhs[0].(*ast.Ident)
+				index, indexOK := x.Rhs[0].(*ast.IndexExpr)
+				root, rootOK := (*ast.Ident)(nil), false
+				if indexOK {
+					root, rootOK = index.X.(*ast.Ident)
+				}
+				if idOK && indexOK && rootOK && root.Name == global && id.Name != global {
+					aliases[id.Name] = x
+				}
+			}
+		case *ast.ValueSpec:
+			for _, id := range x.Names {
+				if immutableShadowName(id.Name, global, trustedNames) {
+					shadowed = true
+				}
+			}
+		case *ast.RangeStmt:
+			if x.Tok == token.DEFINE {
+				for _, target := range []ast.Expr{x.Key, x.Value} {
+					if id, ok := target.(*ast.Ident); ok && immutableShadowName(id.Name, global, trustedNames) {
+						shadowed = true
+					}
+				}
+			}
+		}
+		return true
+	})
+	if shadowed {
+		return false
+	}
+	valid := true
+	ast.Inspect(fn.Body, func(node ast.Node) bool {
+		id, ok := node.(*ast.Ident)
+		if !ok {
+			return true
+		}
+		parent := parents[id]
+		if id.Name == global {
+			index, ok := parent.(*ast.IndexExpr)
+			if !ok || index.X != id {
+				valid = false
+				return false
+			}
+			assign, ok := parents[index].(*ast.AssignStmt)
+			if !ok || len(assign.Lhs) != 1 || len(assign.Rhs) != 1 || assign.Rhs[0] != index || assign.Tok != token.DEFINE {
+				valid = false
+				return false
+			}
+			alias, ok := assign.Lhs[0].(*ast.Ident)
+			if !ok || aliases[alias.Name] != assign {
+				valid = false
+				return false
+			}
+		}
+		if origin := aliases[id.Name]; origin != nil {
+			if parent == origin && len(origin.Lhs) == 1 && origin.Lhs[0] == id {
+				return true
+			}
+			switch use := parent.(type) {
+			case *ast.RangeStmt:
+				if use.X == id {
+					return true
+				}
+			case *ast.CallExpr:
+				if len(use.Args) > 0 && use.Args[0] == id && immutableReadCall(use, env) {
+					return true
+				}
+			}
+			valid = false
+			return false
+		}
+		return true
+	})
+	return valid
+}
+
+func immutableShadowName(name, global string, trusted map[string]bool) bool {
+	return name == global || trusted[name]
+}
+
+func immutableReadCall(call *ast.CallExpr, env *ruleEnv) bool {
+	if id, ok := call.Fun.(*ast.Ident); ok {
+		return id.Name == "len"
+	}
+	selectExpr, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || selectExpr.Sel.Name != "Contains" {
+		return false
+	}
+	pkg, ok := selectExpr.X.(*ast.Ident)
+	return ok && env.imports[pkg.Name] == "slices"
+}
