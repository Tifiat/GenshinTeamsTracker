+func TestRepresentativeProjectionPreservesArchiveTieAndReplacementRows(t *testing.T) {
+	archive := newResultArchive(contracts.MaxResultBuildsPerGroup)
+	feasibleFirst := &energyconstraint.Feasibility{Feasible: true}
+	feasibleTie := &energyconstraint.Feasibility{Feasible: true}
+	tieFirst := representativeProjectionCandidate("tie", 1, 75, "first-source", feasibleFirst)
+	tieSecond := representativeProjectionCandidate("tie", 1, 75, "later-source", feasibleTie)
+	archive.offer(tieFirst)
+	archive.offer(tieSecond)
+
+	positiveZero := representativeProjectionCandidate("zero", 2, 0, "positive-zero", nil)
+	negativeZero := representativeProjectionCandidate("zero", 2, math.Copysign(0, -1), "negative-zero", nil)
+	archive.offer(positiveZero)
+	archive.offer(negativeZero)
+
+	archive.offer(representativeProjectionCandidate("improved", 3, 50, "old", nil))
+	archive.offer(representativeProjectionCandidate("improved", 3, 60, "improved", nil))
+	archive.offer(representativeProjectionCandidate("improved", 3, 55, "declined", nil))
+	archive.offer(representativeProjectionCandidate("reentry", 4, -20, "initial-low", nil))
+	archive.offer(representativeProjectionCandidate("reentry", 5, 85, "late-leader", nil))
+
+	tieRows := archive.groups[packageIdentity(representativeProjectionPackages("tie"))]
+	if len(tieRows) != 1 || tieRows[0].Score.Source != "first-source" ||
+		tieRows[0].Context != tieFirst.Context || tieRows[0].Energy != tieFirst.Energy {
+		t.Fatalf("exact ranking tie did not preserve the first source/context/energy identity: %+v", tieRows)
+	}
+	zeroRows := archive.groups[packageIdentity(representativeProjectionPackages("zero"))]
+	if len(zeroRows) != 1 || math.Float64bits(zeroRows[0].Score.DPS) != math.Float64bits(positiveZero.Score.DPS) {
+		t.Fatalf("signed-zero tie did not preserve the first DPS bits: %+v", zeroRows)
+	}
+	improvedRows := archive.groups[packageIdentity(representativeProjectionPackages("improved"))]
+	if len(improvedRows) != 1 || improvedRows[0].Score.DPS != 60 || improvedRows[0].Score.Source != "improved" {
+		t.Fatalf("same-assignment improvement/rejection changed: %+v", improvedRows)
+	}
+	reentryRows := archive.groups[packageIdentity(representativeProjectionPackages("reentry"))]
+	if len(reentryRows) != 2 || reentryRows[0].Score.DPS != 85 || reentryRows[0].Score.Source != "late-leader" {
+		t.Fatalf("late group leader did not rank ahead of its retained earlier row: %+v", reentryRows)
+	}
+}
