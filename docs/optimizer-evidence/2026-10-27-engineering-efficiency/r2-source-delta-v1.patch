new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/plan_test.go
@@ -0,0 +1,88 @@
+package supportimpact
+
+import (
+	"reflect"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+)
+
+func TestOpaquePlanIsCharacterIndependentFairAndBounded(t *testing.T) {
+	actors := []string{"d", "b", "c", "a"}
+	coverage := Report{Gaps: []Gap{{Attribution: "unattributed"}}}
+	p, err := PlanResponseCheck(coverage, actors, []uint64{11, 12}, 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !p.Required || p.Plan.CallLimit != 10 || len(p.Targets) != 4 || len(p.Deferred) != 28 {
+		t.Fatalf("unexpected plan: %#v", p)
+	}
+	for i, actor := range []string{"a", "b", "c", "d"} {
+		if p.Targets[i].Owner != actor || p.Targets[i].Stat != "atk%" {
+			t.Fatal("first wearer consumed other wearers' allowance")
+		}
+	}
+	if !reflect.DeepEqual(actors, []string{"d", "b", "c", "a"}) {
+		t.Fatal("caller ordering mutated")
+	}
+	p, err = PlanResponseCheck(coverage, actors, []uint64{11, 12}, 42)
+	if err != nil || p.Plan.CallLimit != 42 || len(p.Targets) != 20 || len(p.Deferred) != 12 || p.Deferred[0].Stat != "atk" {
+		t.Fatal("old allowance must defer every flat-stat round", p, err)
+	}
+	p, err = PlanResponseCheck(coverage, actors, []uint64{11, 12}, 64)
+	if err != nil || p.Plan.CallLimit != 58 || len(p.Targets) != 28 || len(p.Deferred) != 4 || p.Deferred[0].Stat != "def" {
+		t.Fatal("partial final owner round spent calls or hid deferred DEF", p, err)
+	}
+	p, err = PlanResponseCheck(coverage, actors, []uint64{11, 12}, 66)
+	if err != nil || p.Plan.CallLimit != 66 || len(p.Targets) != 32 || len(p.Deferred) != 0 || len(p.OmittedStats) != 11 {
+		t.Fatal("complete finite dimension plan differs", p, err)
+	}
+	p, err = PlanResponseCheck(coverage, actors, []uint64{11, 12}, 8)
+	if err != nil || p.Plan.CallLimit != 0 || len(p.Deferred) != 32 {
+		t.Fatal("partial owner round favored an alphabetical subset")
+	}
+	p, err = PlanResponseCheck(coverage, actors, []uint64{11, 12}, 3)
+	if err != nil || p.Plan.CallLimit != 0 || len(p.Deferred) != 32 {
+		t.Fatal("cannot reserve partial unpaired panel")
+	}
+	p, err = PlanResponseCheck(Report{}, actors, []uint64{11, 12}, 42)
+	if err != nil || p.Required || p.Plan.CallLimit != 0 {
+		t.Fatal("clean report allocated calls automatically")
+	}
+}
+
+func TestResponsePlanMeasuresEveryFlatStatDirectlyForEveryWearer(t *testing.T) {
+	actors := []string{"d", "b", "c", "a"}
+	coverage := Report{Gaps: []Gap{{Attribution: "unattributed"}}}
+	plan, err := PlanResponseCheck(coverage, actors, []uint64{11, 12}, 66)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantStats := []struct {
+		key   string
+		delta float64
+	}{
+		{"atk%", .466}, {"hp%", .466}, {"heal", .359}, {"em", 186.5}, {"def%", .583},
+		{"atk", 97.25}, {"hp", 1493.75}, {"def", 115.75},
+	}
+	if len(plan.Plan.Perturbations) != len(wantStats)*4 || plan.Plan.CallLimit != 2*(1+len(wantStats)*4) {
+		t.Fatalf("wrong full paired panel: %+v", plan.Plan)
+	}
+	for round, stat := range wantStats {
+		for wearer, actor := range []string{"a", "b", "c", "d"} {
+			index := round*4 + wearer
+			want := engineclient.StatResponsePerturbation{Actor: actor, Stat: stat.key, Delta: stat.delta}
+			if got := plan.Plan.Perturbations[index]; got != want {
+				t.Fatalf("round %d wearer %d: got %+v want %+v", round, wearer, got, want)
+			}
+			if got := plan.Targets[index]; got.Owner != actor || got.Stat != stat.key {
+				t.Fatalf("target %d differs from direct probe: %+v", index, got)
+			}
+		}
+	}
+	for _, stat := range plan.OmittedStats {
+		if stat == "atk" || stat == "hp" || stat == "def" {
+			t.Fatalf("directly probed flat stat marked omitted: %s", stat)
+		}
+	}
+}
diff --git a/internal/supportimpact/proposal_priority.go b/internal/supportimpact/proposal_priority.go
new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/proposal_priority.go
@@ -0,0 +1,144 @@
+package supportimpact
+
+import (
+	"fmt"
+	"math"
+	"sort"
+)
+
+// ProposalAxis is a paired local observation, including non-improving axes.
+// Its slope orders proposals only; it never corrects formula or ordinary DPS.
+type ProposalAxis struct {
+	Stat                             string
+	Amount, TotalChange, OtherChange float64
+	MissingForeign                   bool
+}
+
+// ProposalPriority keeps unknown opportunity costs in stat/shape units, never
+// invented damage units. Available distinguishes new evidence from legacy rows.
+type ProposalPriority struct {
+	Available                                 bool
+	TotalGuide, OtherGuide, MissingOtherGuide float64
+	UnmeasuredLosses, ChangedSlots            int
+}
+
+func LocalProposalPriority(axes []ProposalAxis, before, after map[string]float64, changedSlots int) (ProposalPriority, error) {
+	out := ProposalPriority{Available: true, ChangedSlots: changedSlots}
+	if changedSlots < 0 {
+		return out, fmt.Errorf("negative proposal distance")
+	}
+	type coefficient struct {
+		total, other, missing float64
+		count                 int
+	}
+	coefficients := map[string]coefficient{}
+	for _, axis := range axes {
+		if axis.Stat == "" || axis.Amount == 0 || !finiteProposal(axis.Amount) || !finiteProposal(axis.TotalChange) || !finiteProposal(axis.OtherChange) {
+			return out, fmt.Errorf("invalid local proposal axis")
+		}
+		c := coefficients[axis.Stat]
+		c.total += axis.TotalChange / axis.Amount
+		c.other += axis.OtherChange / axis.Amount
+		if axis.MissingForeign {
+			c.missing += axis.OtherChange / axis.Amount
+		}
+		c.count++
+		coefficients[axis.Stat] = c
+	}
+	keys := map[string]bool{}
+	for key := range before {
+		keys[key] = true
+	}
+	for key := range after {
+		keys[key] = true
+	}
+	ordered := make([]string, 0, len(keys))
+	for key := range keys {
+		ordered = append(ordered, key)
+	}
+	sort.Strings(ordered)
+	for _, key := range ordered {
+		if !finiteProposal(before[key]) || !finiteProposal(after[key]) {
+			return out, fmt.Errorf("nonfinite proposal stat")
+		}
+		delta := after[key] - before[key]
+		if c, measured := coefficients[key]; measured {
+			// Repeated +/- probes do not count the same stat twice. Losses keep
+			// their sign, including losses in the wearer's own damage response.
+			out.TotalGuide += delta * c.total / float64(c.count)
+			out.OtherGuide += delta * c.other / float64(c.count)
+			out.MissingOtherGuide += delta * c.missing / float64(c.count)
+		} else if delta < 0 {
+			out.UnmeasuredLosses++
+		}
+	}
+	if !finiteProposal(out.TotalGuide) || !finiteProposal(out.OtherGuide) || !finiteProposal(out.MissingOtherGuide) {
+		return out, fmt.Errorf("nonfinite local proposal guide")
+	}
+	return out, nil
+}
+
+// CompareProposalPriorities returns -1 when a should receive the scarce slot.
+// Unknown losses prefer a less disruptive witness. With no unknown loss, a
+// complete endpoint can win on the measured guide. Nothing is excluded.
+func CompareProposalPriorities(a, b ProposalPriority) int {
+	if a.Available != b.Available {
+		if a.Available {
+			return -1
+		}
+		return 1
+	}
+	if !a.Available {
+		return 0
+	}
+	if (a.TotalGuide < 0) != (b.TotalGuide < 0) {
+		if a.TotalGuide >= 0 {
+			return -1
+		}
+		return 1
+	}
+	if (a.UnmeasuredLosses == 0) != (b.UnmeasuredLosses == 0) {
+		if a.UnmeasuredLosses == 0 {
+			return -1
+		}
+		return 1
+	}
+	if a.UnmeasuredLosses > 0 || b.UnmeasuredLosses > 0 {
+		if a.ChangedSlots != b.ChangedSlots {
+			if a.ChangedSlots < b.ChangedSlots {
+				return -1
+			}
+			return 1
+		}
+		if a.UnmeasuredLosses != b.UnmeasuredLosses {
+			if a.UnmeasuredLosses < b.UnmeasuredLosses {
+				return -1
+			}
+			return 1
+		}
+	}
+	for _, pair := range [][2]float64{{a.MissingOtherGuide, b.MissingOtherGuide}, {a.TotalGuide, b.TotalGuide}, {a.OtherGuide, b.OtherGuide}} {
+		if pair[0] > pair[1] {
+			return -1
+		}
+		if pair[0] < pair[1] {
+			return 1
+		}
+	}
+	if a.ChangedSlots < b.ChangedSlots {
+		return -1
+	}
+	if a.ChangedSlots > b.ChangedSlots {
+		return 1
+	}
+	return 0
+}
+
+func ValidateProposalPriority(p ProposalPriority) error {
+	if !finiteProposal(p.TotalGuide) || !finiteProposal(p.OtherGuide) || !finiteProposal(p.MissingOtherGuide) || p.UnmeasuredLosses < 0 || p.ChangedSlots < 0 {
+		return fmt.Errorf("invalid local proposal priority")
+	}
+	return nil
+}
+
+func finiteProposal(value float64) bool { return !math.IsNaN(value) && !math.IsInf(value, 0) }
