diff --git a/internal/search/response_combined.go b/internal/search/response_combined.go
new file mode 100644
--- /dev/null
+++ b/internal/search/response_combined.go
@@ -0,0 +1,437 @@
+package search
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"sort"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/supportimpact"
+)
+
+type combinedResponseOwner struct {
+	owner        string
+	actor        int
+	directions   []supportimpact.Direction
+	coefficients map[string]float64
+	lanes        []lane
+	items        [5][]int64
+	values       map[int64]float64
+	anchorValue  float64
+	best         domain.Assignment
+	bestGain     float64
+	found        bool
+}
+
+// ProposeCombinedResponseDirections builds the best fully-scanned complete
+// legal endpoint found within the visit allowance per wearer from that
+// wearer's positive paired observations. Each observed direction contributes
+// its finite-difference coefficient meanDPSChange/Amount;
+// repeated measurements of the same stat are averaged so duplicate probes do
+// not acquire extra weight. This local linear model is proposal guidance only:
+// it assumes the measured slopes extrapolate locally and ignores stat caps,
+// uptime/global interactions, and opportunity costs in unmeasured stats on a
+// replacement artifact. It does not repair formula DPS. Returned candidates
+// therefore require ordinary full-build verification and must be admitted
+// independently of formula ranking.
+//
+// The singular Stat, ArtifactStatChange and ProbeConfigSHA256 fields on
+// ResponseProposal do not describe a multi-stat proposal, so they are left
+// empty/zero here. Owner is set for wearer endpoints and empty for a joint
+// all-wearer endpoint.
+func (engine *Engine) ProposeCombinedResponseDirections(ctx context.Context, anchor domain.Assignment,
+	directions []supportimpact.Direction, maxCandidates, maxVisits int) (ResponseProposals, error) {
+	out := ResponseProposals{Proposals: []ResponseProposal{}, RequiresOrdinaryVerification: true}
+	if maxCandidates <= 0 || maxVisits <= 0 {
+		return out, fmt.Errorf("combined response proposal budgets must be positive")
+	}
+	if err := engine.domain.ValidateAssignment(anchor); err != nil {
+		return out, err
+	}
+	if err := ctx.Err(); err != nil {
+		return out, err
+	}
+
+	owners, err := combinedResponseOwners(engine.domain, directions)
+	if err != nil {
+		return out, err
+	}
+	if len(owners) == 0 {
+		return out, nil
+	}
+	allOwnerCount := len(owners)
+
+	// Owner endpoints have priority over the optional joint endpoint. If the
+	// caller cannot reserve one slot per owner, preserve deterministic owner
+	// rounds and report the skipped directions rather than silently dropping them.
+	ownerLimit := len(owners)
+	if ownerLimit > maxCandidates {
+		ownerLimit = maxCandidates
+		out.BudgetExhausted = true
+	}
+	for _, owner := range owners[ownerLimit:] {
+		out.DirectionsDeferred += len(owner.directions)
+	}
+	owners = owners[:ownerLimit]
+
+	for i := range owners {
+		if err := ctx.Err(); err != nil {
+			return out, err
+		}
+		if len(owners[i].coefficients) == 0 {
+			continue
+		}
+		owners[i].lanes = engine.lanes(anchor, owners[i].actor)
+		itemSet := [5]map[int64]bool{}
+		for slot := range itemSet {
+			itemSet[slot] = map[int64]bool{}
+		}
+		for _, current := range owners[i].lanes {
+			for slot, pool := range current.pools {
+				for _, id := range pool {
+					itemSet[slot][id] = true
+				}
+			}
+		}
+		for slot := range owners[i].items {
+			for id := range itemSet[slot] {
+				owners[i].items[slot] = append(owners[i].items[slot], id)
+			}
+			sort.Slice(owners[i].items[slot], func(a, b int) bool { return owners[i].items[slot][a] < owners[i].items[slot][b] })
+		}
+		owners[i].values = make(map[int64]float64, combinedItemCount(&owners[i]))
+		owners[i].anchorValue, err = weightedAssignmentValue(engine.domain, anchor, owners[i].actor, owners[i].coefficients)
+		if err != nil {
+			return out, err
+		}
+	}
+
+	quotas := combinedVisitQuotas(owners, maxVisits)
+	for i := range owners {
+		owner := &owners[i]
+		itemCount := combinedItemCount(owner)
+		quota := quotas[i]
+		if itemCount == 0 {
+			out.DirectionsConsidered += len(owner.directions)
+			continue
+		}
+		if quota == 0 {
+			out.DirectionsDeferred += len(owner.directions)
+			out.BudgetExhausted = true
+			continue
+		}
+		out.DirectionsConsidered += len(owner.directions)
+		visited := 0
+		for _, ids := range owner.items {
+			for _, id := range ids {
+				if visited >= quota {
+					break
+				}
+				if err := ctx.Err(); err != nil {
+					return out, err
+				}
+				value, err := weightedArtifactValue(engine.domain, id, owner.coefficients)
+				if err != nil {
+					return out, err
+				}
+				owner.values[id] = value
+				visited++
+				out.ArtifactVisits++
+			}
+		}
+		if visited < itemCount {
+			out.DirectionsQuotaLimited += len(owner.directions)
+		}
+		if err := engine.findCombinedOwnerEndpoint(ctx, anchor, owner); err != nil {
+			return out, err
+		}
+	}
+
+	for _, owner := range owners {
+		if !owner.found {
+			continue
+		}
+		if err := ctx.Err(); err != nil {
+			return out, err
+		}
+		if engine.energy != nil {
+			feasible, err := engine.energyAssessment(owner.best)
+			if err != nil {
+				return out, err
+			}
+			if !feasible.Feasible {
+				continue
+			}
+		}
+		dps, err := engine.score(owner.best)
+		if err != nil {
+			return out, err
+		}
+		out.FormulaEvaluations++
+		out.Proposals = append(out.Proposals, ResponseProposal{
+			Candidate: ScoredAssignment{Assignment: owner.best, DPS: dps, Source: "measured_stat_response_combined_proposal"},
+			Owner:     owner.owner,
+		})
+	}
+
+	// A joint endpoint is optional and is emitted only if every positive owner
+	// produced an endpoint, a candidate slot remains, and physical uniqueness,
+	// set-package legality, and any active energy constraint all pass.
+	if len(owners) > 1 && len(owners) == allOwnerCount && len(out.Proposals) < maxCandidates {
+		joint := anchor
+		allFound := true
+		for _, owner := range owners {
+			if !owner.found {
+				allFound = false
+				break
+			}
+			joint[owner.actor] = owner.best[owner.actor]
+		}
+		if allFound && engine.domain.ValidateAssignment(joint) == nil {
+			feasible := true
+			if engine.energy != nil {
+				assessment, err := engine.energyAssessment(joint)
+				if err != nil {
+					return out, err
+				}
+				feasible = assessment.Feasible
+			}
+			if feasible {
+				if err := ctx.Err(); err != nil {
+					return out, err
+				}
+				dps, err := engine.score(joint)
+				if err != nil {
+					return out, err
+				}
+				out.FormulaEvaluations++
+				out.Proposals = append(out.Proposals, ResponseProposal{
+					Candidate: ScoredAssignment{Assignment: joint, DPS: dps, Source: "measured_stat_response_combined_proposal"},
+				})
+			}
+		}
+	}
+
+	if out.DirectionsQuotaLimited > 0 && out.ArtifactVisits >= maxVisits {
+		out.BudgetExhausted = true
+	}
+	return out, nil
+}
+
+func combinedResponseOwners(index *domain.Index, directions []supportimpact.Direction) ([]combinedResponseOwner, error) {
+	type coefficientAggregate struct {
+		sum   float64
+		count int
+	}
+	type ownerAggregate struct {
+		actor int
+		dirs  []supportimpact.Direction
+		stats map[string]coefficientAggregate
+	}
+	byOwner := map[string]*ownerAggregate{}
+	for _, direction := range directions {
+		if direction.Status != "positive_on_sampled_seeds" {
+			continue
+		}
+		if direction.Owner == "" || direction.Stat == "" || !finiteResponseValue(direction.Amount) || direction.Amount == 0 ||
+			!finiteResponseValue(direction.MeanDPSChange) || direction.MeanDPSChange <= 0 {
+			return nil, fmt.Errorf("invalid positive paired response direction")
+		}
+		actor := -1
+		for i, wearer := range index.Wearers {
+			if wearer.WearerKey == direction.Owner {
+				actor = i
+				break
+			}
+		}
+		if actor < 0 {
+			return nil, fmt.Errorf("response direction owner is outside the team")
+		}
+		coefficient := direction.MeanDPSChange / direction.Amount
+		if !finiteResponseValue(coefficient) || coefficient == 0 {
+			return nil, fmt.Errorf("response direction has an invalid finite-difference coefficient")
+		}
+		row := byOwner[direction.Owner]
+		if row == nil {
+			row = &ownerAggregate{actor: actor, dirs: []supportimpact.Direction{}, stats: map[string]coefficientAggregate{}}
+			byOwner[direction.Owner] = row
+		} else if row.actor != actor {
+			return nil, fmt.Errorf("response owner identity is ambiguous")
+		}
+		stat := row.stats[direction.Stat]
+		stat.sum += coefficient
+		if !finiteResponseValue(stat.sum) {
+			return nil, fmt.Errorf("combined response coefficients overflow")
+		}
+		stat.count++
+		row.stats[direction.Stat] = stat
+		row.dirs = append(row.dirs, direction)
+	}
+
+	owners := make([]combinedResponseOwner, 0, len(byOwner))
+	for owner, aggregate := range byOwner {
+		coefficients := make(map[string]float64, len(aggregate.stats))
+		for stat, value := range aggregate.stats {
+			coefficient := value.sum / float64(value.count)
+			if !finiteResponseValue(coefficient) {
+				return nil, fmt.Errorf("combined response coefficient for %s.%s is invalid", owner, stat)
+			}
+			if coefficient != 0 {
+				coefficients[stat] = coefficient
+			}
+		}
+		sort.Slice(aggregate.dirs, func(i, j int) bool {
+			if aggregate.dirs[i].Stat != aggregate.dirs[j].Stat {
+				return aggregate.dirs[i].Stat < aggregate.dirs[j].Stat
+			}
+			return aggregate.dirs[i].Amount < aggregate.dirs[j].Amount
+		})
+		owners = append(owners, combinedResponseOwner{owner: owner, actor: aggregate.actor,
+			directions: aggregate.dirs, coefficients: coefficients, values: map[int64]float64{}})
+	}
+	sort.Slice(owners, func(i, j int) bool { return owners[i].owner < owners[j].owner })
+	return owners, nil
+}
+
+func (engine *Engine) findCombinedOwnerEndpoint(ctx context.Context, anchor domain.Assignment, owner *combinedResponseOwner) error {
+	if owner == nil || len(owner.lanes) == 0 {
+		return nil
+	}
+	for _, current := range owner.lanes {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		trial := anchor
+		modelValue := 0.0
+		complete := true
+		for slot, pool := range current.pools {
+			bestID := int64(0)
+			bestValue := math.Inf(-1)
+			for _, id := range pool {
+				value, exists := owner.values[id]
+				if !exists {
+					complete = false
+					break
+				}
+				if value > bestValue || value == bestValue && (id == anchor[owner.actor][slot] || bestID != anchor[owner.actor][slot] && id < bestID) {
+					bestID, bestValue = id, value
+				}
+			}
+			if !complete || bestID == 0 {
+				complete = false
+				break
+			}
+			trial[owner.actor][slot] = bestID
+			modelValue += bestValue
+			if !finiteResponseValue(modelValue) {
+				return fmt.Errorf("combined response objective overflowed")
+			}
+		}
+		if !complete || trial == anchor || engine.domain.ValidateAssignment(trial) != nil {
+			continue
+		}
+		gain := modelValue - owner.anchorValue
+		if !finiteResponseValue(gain) || gain <= 0 {
+			continue
+		}
+		if engine.energy != nil {
+			assessment, err := engine.energyAssessment(trial)
+			if err != nil {
+				return err
+			}
+			if !assessment.Feasible {
+				continue
+			}
+		}
+		if !owner.found || gain > owner.bestGain || gain == owner.bestGain && assignmentLess(trial, owner.best) {
+			owner.best, owner.bestGain, owner.found = trial, gain, true
+		}
+	}
+	return nil
+}
+
+func combinedVisitQuotas(owners []combinedResponseOwner, maxVisits int) []int {
+	quotas := make([]int, len(owners))
+	remaining := maxVisits
+	for remaining > 0 {
+		active := 0
+		for i := range owners {
+			if quotas[i] < combinedItemCount(&owners[i]) {
+				active++
+			}
+		}
+		if active == 0 {
+			break
+		}
+		progress := false
+		for i := range owners {
+			if remaining == 0 {
+				break
+			}
+			if quotas[i] >= combinedItemCount(&owners[i]) {
+				continue
+			}
+			quotas[i]++
+			remaining--
+			progress = true
+		}
+		if !progress {
+			break
+		}
+	}
+	return quotas
+}
+
+func combinedItemCount(owner *combinedResponseOwner) int {
+	count := 0
+	for _, ids := range owner.items {
+		count += len(ids)
+	}
+	return count
+}
+
+func weightedArtifactValue(index *domain.Index, artifactID int64, coefficients map[string]float64) (float64, error) {
+	keys := sortedCoefficientKeys(coefficients)
+	total := 0.0
+	for _, key := range keys {
+		value, err := index.ArtifactStat(artifactID, key)
+		if err != nil {
+			return 0, err
+		}
+		term := coefficients[key] * value
+		if !finiteResponseValue(term) || !finiteResponseValue(total+term) {
+			return 0, fmt.Errorf("combined artifact response value overflowed")
+		}
+		total += term
+	}
+	return total, nil
+}
+
+func weightedAssignmentValue(index *domain.Index, assignment domain.Assignment, actor int, coefficients map[string]float64) (float64, error) {
+	keys := sortedCoefficientKeys(coefficients)
+	total := 0.0
+	for _, key := range keys {
+		value, err := index.AssignmentStat(assignment, actor, key)
+		if err != nil {
+			return 0, err
+		}
+		term := coefficients[key] * value
+		if !finiteResponseValue(term) || !finiteResponseValue(total+term) {
+			return 0, fmt.Errorf("combined assignment response value overflowed")
+		}
+		total += term
+	}
+	return total, nil
+}
+
+func sortedCoefficientKeys(coefficients map[string]float64) []string {
+	keys := make([]string, 0, len(coefficients))
+	for key := range coefficients {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func finiteResponseValue(value float64) bool { return !math.IsNaN(value) && !math.IsInf(value, 0) }
