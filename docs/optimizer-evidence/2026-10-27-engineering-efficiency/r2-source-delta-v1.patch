+func TestNeutralRepresentativeSnapshotIsDetachedAndStable(t *testing.T) {
+	events := []Candidate{
+		representativeProjectionCandidate("snapshot-a", 1, 100, "a-best", nil),
+		representativeProjectionCandidate("snapshot-a", 2, 95, "a-alternative", nil),
+		representativeProjectionCandidate("snapshot-b", 3, 90, "b-best", nil),
+		representativeProjectionCandidate("snapshot-c", 4, 80, "c-best", nil),
