+package engineclient
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func responseGuardTestPlan() StatResponsePlan {
+	return StatResponsePlan{Seeds: []int64{5}, Perturbations: []StatResponsePerturbation{{Actor: "a", Stat: "atk", Delta: 1}}, CallLimit: 2}
+}
+
+func TestResponseArtifactGuardPlanChecksAndPublication(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	checks, calls, closes := 0, 0, 0
+	held := false
+	acquire := func(BoundEngine) (responseArtifactGuard, error) {
+		held = true
+		return responseArtifactGuard{mode: "test_lease", check: func() error {
+			if !held {
+				t.Fatal("identity check after release")
+			}
+			checks++
+			return nil
+		}, close: func() error {
+			closes++
+			held = false
+			return nil
+		}}, nil
+	}
+	result, err := runStatResponsePlanWithGuard(context.Background(), bound, statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(_ context.Context, config, _ string, seed int64) (OrdinaryResult, error) {
+			if !held {
+				t.Fatal("runner without lease")
+			}
+			calls++
+			return statResponseTestResult(config, seed), nil
+		}, acquire)
+	if err != nil || calls != 2 || checks != 6 || closes != 1 || held || !result.EngineUnchanged ||
+		result.ArtifactGuardChecks != 6 || result.ArtifactFullHashes != 2 || result.ArtifactGuardMode != "test_lease" {
+		t.Fatalf("guard lifecycle/counts: result=%+v calls=%d checks=%d closes=%d held=%t err=%v", result, calls, checks, closes, held, err)
+	}
+	var final statResponseFinalOutcome
+	data, err := os.ReadFile(filepath.Join(result.RunDirectory, "outcome.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &final); err != nil {
+		t.Fatal(err)
+	}
+	if final.Status != "success" || final.ArtifactFullHashes != 2 || final.ArtifactGuardChecks != 6 {
+		t.Fatalf("wrong retained outcome: %+v", final)
+	}
+	var reservation statResponseReservation
+	data, err = os.ReadFile(filepath.Join(result.RunDirectory, "reservation.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, &reservation); err != nil {
+		t.Fatal(err)
+	}
+	if reservation.ArtifactGuardMode != "test_lease" {
+		t.Fatalf("mode not reserved: %+v", reservation)
+	}
+}
+
+func TestResponseArtifactGuardFallbackKeepsOriginalHashCounts(t *testing.T) {
+	result, err := runStatResponsePlanWithGuard(context.Background(), newStatResponseTestBound(t, true), statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(_ context.Context, config, _ string, seed int64) (OrdinaryResult, error) {
+			return statResponseTestResult(config, seed), nil
+		}, fullHashResponseArtifactGuard)
+	if err != nil || result.ArtifactGuardMode != "full_hash_fallback" || result.ArtifactGuardChecks != 4 || result.ArtifactFullHashes != 6 {
+		t.Fatalf("fallback changed stage+per-call hash counts: %+v err=%v", result, err)
+	}
+}
+
+func TestResponseArtifactGuardReleasesOnEarlyAndRunnerFailures(t *testing.T) {
+	for _, failure := range []string{"initial_hash", "managed_root", "identity", "runner", "cancelled"} {
+		t.Run(failure, func(t *testing.T) {
+			bound := newStatResponseTestBound(t, true)
+			root := t.TempDir()
+			if failure == "initial_hash" {
+				bound.artifactSHA256 = strings.Repeat("0", 64)
+			}
+			if failure == "managed_root" {
+				root = filepath.Join(root, "missing")
+			}
+			closed, checks, calls := 0, 0, 0
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			acquire := func(BoundEngine) (responseArtifactGuard, error) {
+				return responseArtifactGuard{mode: "test_lease", check: func() error {
+					checks++
+					if failure == "identity" {
+						return errors.New("identity drift")
+					}
+					return nil
+				}, close: func() error { closed++; return nil }}, nil
+			}
+			result, err := runStatResponsePlanWithGuard(ctx, bound, statResponseTestConfig, root, responseGuardTestPlan(),
+				func(ctx context.Context, _ string, _ string, _ int64) (OrdinaryResult, error) {
+					calls++
+					if failure == "cancelled" {
+						cancel()
+						return OrdinaryResult{}, ctx.Err()
+					}
+					return OrdinaryResult{}, errors.New("runner failure")
+				}, acquire)
+			if err == nil || closed != 1 || checks == 0 || calls > 1 {
+				t.Fatalf("release failure: %+v closes=%d calls=%d err=%v", result, closed, calls, err)
+			}
+			if failure != "runner" && failure != "cancelled" && calls != 0 {
+				t.Fatalf("early failure reached runner: %d", calls)
+			}
+		})
+	}
+}
+
+func TestResponseArtifactGuardAcquisitionFailureBeforeReservation(t *testing.T) {
+	root := t.TempDir()
+	calls := 0
+	result, err := runStatResponsePlanWithGuard(context.Background(), newStatResponseTestBound(t, true), statResponseTestConfig, root, responseGuardTestPlan(),
+		func(context.Context, string, string, int64) (OrdinaryResult, error) {
+			calls++
+			return OrdinaryResult{}, nil
+		},
+		func(BoundEngine) (responseArtifactGuard, error) {
+			return responseArtifactGuard{}, errors.New("lease conflict")
+		})
+	entries, readErr := os.ReadDir(root)
+	if err == nil || calls != 0 || result.AttemptedCalls != 0 || result.RunDirectory != "" || readErr != nil || len(entries) != 0 {
+		t.Fatalf("acquisition failure reserved/called: %+v calls=%d entries=%d err=%v read=%v", result, calls, len(entries), err, readErr)
+	}
+}
+
+func TestResponseArtifactGuardFinalHashAndCloseFailuresJoin(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	checks, closes := 0, 0
+	result, err := runStatResponsePlanWithGuard(context.Background(), bound, statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(_ context.Context, config, _ string, seed int64) (OrdinaryResult, error) {
+			return statResponseTestResult(config, seed), nil
+		},
+		func(BoundEngine) (responseArtifactGuard, error) {
+			return responseArtifactGuard{mode: "test_lease", check: func() error {
+				checks++
+				if checks == 6 {
+					return os.WriteFile(bound.binaryPath, []byte("tampered before final hash"), 0o600)
+				}
+				return nil
+			}, close: func() error { closes++; return errors.New("controlled close failure") }}, nil
+		})
+	if err == nil || !strings.Contains(err.Error(), "changed during stat-response stage") || !strings.Contains(err.Error(), "controlled close failure") || closes != 1 || result.EngineUnchanged {
+		t.Fatalf("final errors not joined: %+v closes=%d err=%v", result, closes, err)
+	}
+	data, readErr := os.ReadFile(filepath.Join(result.RunDirectory, "outcome.json"))
+	if readErr != nil {
+		t.Fatal(readErr)
+	}
+	var final statResponseFinalOutcome
+	if err := json.Unmarshal(data, &final); err != nil {
+		t.Fatal(err)
+	}
+	if final.Status != "failed" || !strings.Contains(final.Error, "controlled close failure") {
+		t.Fatalf("published success before close: %+v", final)
+	}
+}
+
+func TestResponseArtifactGuardCloseFailureAlonePreventsSuccess(t *testing.T) {
+	result, err := runStatResponsePlanWithGuard(context.Background(), newStatResponseTestBound(t, true), statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(_ context.Context, config, _ string, seed int64) (OrdinaryResult, error) {
+			return statResponseTestResult(config, seed), nil
+		},
+		func(BoundEngine) (responseArtifactGuard, error) {
+			return responseArtifactGuard{mode: "test_lease", check: func() error { return nil }, close: func() error { return errors.New("close failure") }}, nil
+		})
+	if err == nil || !result.EngineUnchanged || !strings.Contains(err.Error(), "close failure") {
+		t.Fatalf("close failure accepted: %+v err=%v", result, err)
+	}
+}
+
+func TestResponseArtifactGuardLegacyOutcomeDefaults(t *testing.T) {
+	var final statResponseFinalOutcome
+	if err := json.Unmarshal([]byte(`{"schema_version":1,"status":"success","engine_unchanged":true}`), &final); err != nil {
+		t.Fatal(err)
+	}
+	if final.ArtifactGuardMode != "" || final.ArtifactGuardChecks != 0 || final.ArtifactFullHashes != 0 || !final.EngineUnchanged {
+		t.Fatalf("legacy defaults changed: %+v", final)
+	}
+}
diff --git a/internal/engineclient/response_artifact_guard_windows.go b/internal/engineclient/response_artifact_guard_windows.go
new file mode 100644
--- /dev/null
+++ b/internal/engineclient/response_artifact_guard_windows.go
@@ -0,0 +1,158 @@
+//go:build windows
+
+package engineclient
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"unsafe"
+)
+
+var responseKernel32 = syscall.NewLazyDLL("kernel32.dll")
+var responseGetDriveType = responseKernel32.NewProc("GetDriveTypeW")
+var responseGetVolumeInformation = responseKernel32.NewProc("GetVolumeInformationW")
+
+// Only a canonical drive-absolute, fixed local NTFS path is eligible. UNC,
+// device, relative, reparse and unproven filesystem paths keep the old full
+// hashes. Attribute/eligibility errors are not silently treated as support.
+func responseLeasePathEligible(path string) (bool, error) {
+	if len(path) < 3 || path[1] != ':' || path[2] != '\\' ||
+		!((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) ||
+		filepath.Clean(path) != path || strings.Contains(path[2:], ":") {
+		return false, nil
+	}
+	root, err := syscall.UTF16PtrFromString(path[:3])
+	if err != nil {
+		return false, err
+	}
+	driveType, _, _ := responseGetDriveType.Call(uintptr(unsafe.Pointer(root)))
+	if driveType != 3 { // DRIVE_FIXED; remote/unknown drives are unsupported.
+		return false, nil
+	}
+	var filesystem [32]uint16
+	ok, _, _ := responseGetVolumeInformation.Call(uintptr(unsafe.Pointer(root)), 0, 0, 0, 0, 0,
+		uintptr(unsafe.Pointer(&filesystem[0])), uintptr(len(filesystem)))
+	if ok == 0 || syscall.UTF16ToString(filesystem[:]) != "NTFS" {
+		return false, nil
+	}
+	return responseLeasePathComponents(path)
+}
+
+func responseLeasePathComponents(path string) (bool, error) {
+	for current := path; ; current = filepath.Dir(current) {
+		name, err := syscall.UTF16PtrFromString(current)
+		if err != nil {
+			return false, err
+		}
+		attributes, err := syscall.GetFileAttributes(name)
+		if err != nil {
+			return false, err
+		}
+		if attributes&syscall.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+			return false, nil
+		}
+		if current == path && attributes&syscall.FILE_ATTRIBUTE_DIRECTORY != 0 {
+			return false, nil
+		}
+		parent := filepath.Dir(current)
+		if parent == current {
+			return true, nil
+		}
+	}
+}
+
+func openResponseArtifactReadLease(path string) (syscall.Handle, error) {
+	name, err := syscall.UTF16PtrFromString(path)
+	if err != nil {
+		return syscall.InvalidHandle, err
+	}
+	// No WRITE/DELETE sharing: rejects existing writers/write mappings and
+	// prevents leaf writes, deletion and rename through aliases. Nil security
+	// attributes keep this handle noninheritable by the ordinary child.
+	return syscall.CreateFile(name, syscall.GENERIC_READ, syscall.FILE_SHARE_READ, nil,
+		syscall.OPEN_EXISTING, syscall.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+}
+
+func responseArtifactInformation(handle syscall.Handle) (syscall.ByHandleFileInformation, error) {
+	var info syscall.ByHandleFileInformation
+	if err := syscall.GetFileInformationByHandle(handle, &info); err != nil {
+		return info, err
+	}
+	kind, err := syscall.GetFileType(handle)
+	if err != nil {
+		return info, err
+	}
+	if kind != syscall.FILE_TYPE_DISK || info.FileAttributes&(syscall.FILE_ATTRIBUTE_REPARSE_POINT|syscall.FILE_ATTRIBUTE_DIRECTORY) != 0 ||
+		(info.FileIndexHigh == 0 && info.FileIndexLow == 0) {
+		return info, errors.New("response artifact is not a regular identifiable disk file")
+	}
+	return info, nil
+}
+
+func sameResponseArtifactInformation(a, b syscall.ByHandleFileInformation) bool {
+	// LastAccessTime is deliberately excluded: reading can change it. No file
+	// contents or hash are read here. Other metadata drift fails closed.
+	return a.VolumeSerialNumber == b.VolumeSerialNumber && a.FileIndexHigh == b.FileIndexHigh && a.FileIndexLow == b.FileIndexLow &&
+		a.FileSizeHigh == b.FileSizeHigh && a.FileSizeLow == b.FileSizeLow && a.LastWriteTime == b.LastWriteTime &&
+		a.CreationTime == b.CreationTime && a.FileAttributes == b.FileAttributes && a.NumberOfLinks == b.NumberOfLinks
+}
+
+func acquireResponseArtifactGuard(bound BoundEngine) (responseArtifactGuard, error) {
+	eligible, err := responseLeasePathEligible(bound.binaryPath)
+	if err != nil {
+		return responseArtifactGuard{}, fmt.Errorf("inspect response artifact path: %w", err)
+	}
+	if !eligible {
+		return fullHashResponseArtifactGuard(bound)
+	}
+	handle, err := openResponseArtifactReadLease(bound.binaryPath)
+	if err != nil {
+		// An acquisition conflict is a failure BEFORE any attempt, never a
+		// downgrade to the less expensive/less restrictive interpretation.
+		return responseArtifactGuard{}, fmt.Errorf("acquire response artifact read lease: %w", err)
+	}
+	baseline, err := responseArtifactInformation(handle)
+	if err != nil {
+		return responseArtifactGuard{}, errors.Join(err, syscall.CloseHandle(handle))
+	}
+	closed := false
+	guard := responseArtifactGuard{mode: "windows_read_lease"}
+	guard.close = func() error {
+		if closed {
+			return nil
+		}
+		closed = true
+		return syscall.CloseHandle(handle)
+	}
+	guard.check = func() error {
+		if closed {
+			return errors.New("response artifact read lease is closed")
+		}
+		// No ancestor locks. Like the previous pre/post full hashes this is NOT
+		// a transactional namespace sandbox: transient parent rebinding restored
+		// between checks remains outside the observed contract. Persistent path
+		// rebinding/reparse or metadata changes are rejected before/after calls.
+		eligible, err := responseLeasePathComponents(bound.binaryPath)
+		if err != nil || !eligible {
+			return errors.Join(errors.New("response artifact path changed or became unsupported"), err)
+		}
+		leased, err := responseArtifactInformation(handle)
+		if err != nil || !sameResponseArtifactInformation(baseline, leased) {
+			return errors.Join(errors.New("leased response artifact identity or metadata changed"), err)
+		}
+		current, err := openResponseArtifactReadLease(bound.binaryPath)
+		if err != nil {
+			return fmt.Errorf("reopen response artifact path: %w", err)
+		}
+		info, infoErr := responseArtifactInformation(current)
+		closeErr := syscall.CloseHandle(current)
+		if infoErr == nil && !sameResponseArtifactInformation(baseline, info) {
+			infoErr = errors.New("response artifact path no longer identifies the leased file")
+		}
+		return errors.Join(infoErr, closeErr)
+	}
+	return guard, nil
+}
diff --git a/internal/engineclient/response_artifact_guard_windows_test.go b/internal/engineclient/response_artifact_guard_windows_test.go
new file mode 100644
--- /dev/null
+++ b/internal/engineclient/response_artifact_guard_windows_test.go
@@ -0,0 +1,412 @@
+//go:build windows
+
+package engineclient
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+// The Python adapter serializes actual engine paths using as_posix(). A
+// native-only synthetic BoundEngine bypassed that boundary in older tests.
+func TestResponseArtifactGuardWindowsProductionWirePathUsesReadLease(t *testing.T) {
+	fixture := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, fixture)
+	request := contracts.OptimizerRequest{Engine: contracts.EngineBinding{
+		BinaryPath: filepath.ToSlash(fixture.binaryPath), ArtifactSHA256: fixture.artifactSHA256,
+		BindingSHA256: fixture.bindingSHA256, SourceManifestSHA256: fixture.sourceManifestSHA256,
+		PatchManifestSHA256: fixture.patchManifestSHA256, Capabilities: []string{ordinarySeedCapability},
+	}}
+	wirePath := request.Engine.BinaryPath
+	bound, err := BindEngine(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bound.binaryPath != fixture.binaryPath || request.Engine.BinaryPath != wirePath {
+		t.Fatal("native path normalization changed the wire request or bound a different path")
+	}
+	result, err := runStatResponsePlan(context.Background(), bound, statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(_ context.Context, config, runDirectory string, seed int64) (OrdinaryResult, error) {
+			return statResponseTestResult(config, seed), nil
+		})
+	if err != nil || result.ArtifactGuardMode != "windows_read_lease" || result.ArtifactFullHashes != 2 ||
+		result.AttemptedCalls != 2 || !result.EngineUnchanged {
+		t.Fatalf("production wire path fell back to per-call full hashes: %+v err=%v", result, err)
+	}
+}
+
+func requireResponseLeaseTestPath(t *testing.T, bound BoundEngine) {
+	t.Helper()
+	eligible, err := responseLeasePathEligible(bound.binaryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !eligible {
+		t.Skip("synthetic file is not on an eligible local non-reparse NTFS path")
+	}
+}
+
+func TestResponseArtifactGuardWindowsBlocksMutationsAndReleases(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, bound)
+	alias := filepath.Join(filepath.Dir(bound.binaryPath), "alias.bin")
+	if err := os.Link(bound.binaryPath, alias); err != nil {
+		t.Fatal(err)
+	}
+	guard, err := acquireResponseArtifactGuard(bound)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.close()
+	if guard.mode != "windows_read_lease" {
+		t.Fatalf("unexpected mode %s", guard.mode)
+	}
+	for name, mutate := range map[string]func() error{
+		"write":          func() error { return os.WriteFile(bound.binaryPath, []byte("tampered"), 0o600) },
+		"truncate":       func() error { return os.Truncate(bound.binaryPath, 0) },
+		"delete":         func() error { return os.Remove(bound.binaryPath) },
+		"rename":         func() error { return os.Rename(bound.binaryPath, bound.binaryPath+".renamed") },
+		"hardlink_write": func() error { return os.WriteFile(alias, []byte("tampered"), 0o600) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			if err := mutate(); err == nil {
+				t.Fatal("mutation succeeded while read lease held")
+			}
+		})
+	}
+	// Ancestor writes are not locked: ordinary isolated configs/ledgers can be
+	// created beside the artifact while its leaf alone is protected.
+	if err := os.Mkdir(filepath.Join(filepath.Dir(bound.binaryPath), "ordinary-run"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(filepath.Dir(bound.binaryPath), "ordinary-run", "config.txt"), []byte("config"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := guard.check(); err != nil {
+		t.Fatal(err)
+	}
+	if err := guard.close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(bound.binaryPath, []byte("released"), 0o600); err != nil {
+		t.Fatalf("write still blocked after release: %v", err)
+	}
+	if err := os.Rename(bound.binaryPath, bound.binaryPath+".renamed"); err != nil {
+		t.Fatalf("rename still blocked after release: %v", err)
+	}
+	if err := guard.check(); err == nil {
+		t.Fatal("closed lease accepted identity check")
+	}
+}
+
+func TestResponseArtifactGuardWindowsExistingWriterOrMappingStopsBeforeAttempt(t *testing.T) {
+	for _, mapping := range []bool{false, true} {
+		name := "writer"
+		if mapping {
+			name = "write_mapping_after_writer_close"
+		}
+		t.Run(name, func(t *testing.T) {
+			bound := newStatResponseTestBound(t, true)
+			requireResponseLeaseTestPath(t, bound)
+			path, err := syscall.UTF16PtrFromString(bound.binaryPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			writer, err := syscall.CreateFile(path, syscall.GENERIC_READ|syscall.GENERIC_WRITE,
+				syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE|syscall.FILE_SHARE_DELETE, nil, syscall.OPEN_EXISTING, 0, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mapping {
+				section, err := syscall.CreateFileMapping(writer, nil, syscall.PAGE_READWRITE, 0, 0, nil)
+				if err != nil {
+					syscall.CloseHandle(writer)
+					t.Fatal(err)
+				}
+				view, err := syscall.MapViewOfFile(section, syscall.FILE_MAP_WRITE, 0, 0, 0)
+				if err != nil {
+					syscall.CloseHandle(section)
+					syscall.CloseHandle(writer)
+					t.Fatal(err)
+				}
+				defer syscall.CloseHandle(section)
+				defer syscall.UnmapViewOfFile(view)
+				if err := syscall.CloseHandle(writer); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				defer syscall.CloseHandle(writer)
+			}
+			root := t.TempDir()
+			calls := 0
+			result, err := runStatResponsePlan(context.Background(), bound, statResponseTestConfig, root, responseGuardTestPlan(),
+				func(context.Context, string, string, int64) (OrdinaryResult, error) {
+					calls++
+					return OrdinaryResult{}, nil
+				})
+			entries, readErr := os.ReadDir(root)
+			if err == nil || calls != 0 || result.AttemptedCalls != 0 || result.RunDirectory != "" || readErr != nil || len(entries) != 0 {
+				t.Fatalf("conflict downgraded/reserved/called: %+v calls=%d entries=%d err=%v read=%v", result, calls, len(entries), err, readErr)
+			}
+		})
+	}
+}
+
+func TestResponseArtifactGuardWindowsBlockedWriteFailsPanelWithoutFalseTamper(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, bound)
+	calls := 0
+	result, err := runStatResponsePlan(context.Background(), bound, statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(context.Context, string, string, int64) (OrdinaryResult, error) {
+			calls++
+			writeErr := os.WriteFile(bound.binaryPath, []byte("tampered"), 0o600)
+			if writeErr == nil {
+				t.Fatal("fast lease did not block runner write")
+			}
+			return OrdinaryResult{}, writeErr
+		})
+	if err == nil || calls != 1 || result.AttemptedCalls != 1 || !result.EngineUnchanged || result.ArtifactGuardMode != "windows_read_lease" || result.ArtifactFullHashes != 2 {
+		t.Fatalf("blocked write incorrectly accepted or reported tamper: %+v calls=%d err=%v", result, calls, err)
+	}
+	if err := os.WriteFile(bound.binaryPath, []byte("released"), 0o600); err != nil {
+		t.Fatalf("failure leaked lease: %v", err)
+	}
+}
+
+func TestResponseArtifactGuardWindowsCancelledRunnerReleases(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, bound)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result, err := runStatResponsePlan(ctx, bound, statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(ctx context.Context, _ string, _ string, _ int64) (OrdinaryResult, error) {
+			cancel()
+			return OrdinaryResult{}, ctx.Err()
+		})
+	if err == nil || result.AttemptedCalls != 1 || !result.EngineUnchanged {
+		t.Fatalf("cancellation accepted: %+v err=%v", result, err)
+	}
+	if err := os.WriteFile(bound.binaryPath, []byte("released"), 0o600); err != nil {
+		t.Fatalf("cancellation leaked lease: %v", err)
+	}
+}
+
+func TestResponseArtifactGuardWindowsSuccessfulPanelUsesTwoFullHashes(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, bound)
+	result, err := runStatResponsePlan(context.Background(), bound, statResponseTestConfig, t.TempDir(), responseGuardTestPlan(),
+		func(_ context.Context, config, runDirectory string, seed int64) (OrdinaryResult, error) {
+			if err := os.MkdirAll(runDirectory, 0o700); err != nil {
+				return OrdinaryResult{}, err
+			}
+			if err := os.WriteFile(filepath.Join(runDirectory, "config.txt"), []byte(config), 0o600); err != nil {
+				return OrdinaryResult{}, err
+			}
+			return statResponseTestResult(config, seed), nil
+		})
+	if err != nil || result.AttemptedCalls != 2 || result.ArtifactGuardMode != "windows_read_lease" || result.ArtifactFullHashes != 2 || result.ArtifactGuardChecks != 6 || !result.EngineUnchanged {
+		t.Fatalf("fast panel checks/identity: %+v err=%v", result, err)
+	}
+	if err := os.WriteFile(bound.binaryPath, []byte("released"), 0o600); err != nil {
+		t.Fatalf("success leaked lease: %v", err)
+	}
+}
+
+func TestResponseArtifactGuardWindowsInformationRejectsDifferentFileID(t *testing.T) {
+	a := syscall.ByHandleFileInformation{VolumeSerialNumber: 1, FileIndexLow: 2, FileSizeLow: 12}
+	b := a
+	b.FileIndexLow++
+	if sameResponseArtifactInformation(a, b) {
+		t.Fatal("different same-size file ID accepted")
+	}
+	b = a
+	b.VolumeSerialNumber++
+	if sameResponseArtifactInformation(a, b) {
+		t.Fatal("different volume accepted")
+	}
+	b = a
+	b.LastAccessTime.LowDateTime++
+	if !sameResponseArtifactInformation(a, b) {
+		t.Fatal("read-only last-access drift rejected")
+	}
+}
+
+func TestResponseArtifactGuardWindowsPathRebindDetected(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	parent := filepath.Join(t.TempDir(), "parent")
+	if err := os.Mkdir(parent, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(bound.binaryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bound.binaryPath = filepath.Join(parent, "engine.bin")
+	if err := os.WriteFile(bound.binaryPath, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	requireResponseLeaseTestPath(t, bound)
+	guard, err := acquireResponseArtifactGuard(bound)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.close()
+	moved := parent + "-moved"
+	if err := os.Rename(parent, moved); err != nil {
+		// Some Windows filesystems also prohibit the ancestor rename. That is
+		// stronger than required; still verify the protected path is unchanged.
+		if err := guard.check(); err != nil {
+			t.Fatal(err)
+		}
+		return
+	}
+	defer func() { guard.close(); os.RemoveAll(parent); os.Rename(moved, parent) }()
+	if err := os.Mkdir(parent, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(bound.binaryPath, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// Same bytes are insufficient: this is a DIFFERENT file identity.
+	if err := guard.check(); err == nil {
+		t.Fatal("same-content path replacement accepted")
+	}
+}
+
+func TestResponseArtifactGuardWindowsMetadataDriftDetected(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, bound)
+	guard, err := acquireResponseArtifactGuard(bound)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.close()
+	path, err := syscall.UTF16PtrFromString(bound.binaryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle, err := syscall.CreateFile(path, syscall.FILE_WRITE_ATTRIBUTES, syscall.FILE_SHARE_READ, nil, syscall.OPEN_EXISTING, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer syscall.CloseHandle(handle)
+	var info syscall.ByHandleFileInformation
+	if err := syscall.GetFileInformationByHandle(handle, &info); err != nil {
+		t.Fatal(err)
+	}
+	changed := info.LastWriteTime
+	changed.HighDateTime++
+	if err := syscall.SetFileTime(handle, nil, nil, &changed); err != nil {
+		t.Fatal(err)
+	}
+	if err := guard.check(); err == nil {
+		t.Fatal("attribute-only timestamp drift accepted")
+	}
+}
+
+func TestResponseArtifactGuardWindowsUnsupportedPathsAndReparseFallback(t *testing.T) {
+	for _, path := range []string{`relative.bin`, `C:relative.bin`, `\\server\share\engine.bin`, `\\?\C:\engine.bin`, `C:\parent\..\engine.bin`, `C:\engine.bin:stream`} {
+		eligible, err := responseLeasePathEligible(path)
+		if err != nil || eligible {
+			t.Fatalf("unsupported path %q accepted: eligible=%t err=%v", path, eligible, err)
+		}
+	}
+	bound := newStatResponseTestBound(t, true)
+	link := filepath.Join(t.TempDir(), "link.bin")
+	if err := os.Symlink(bound.binaryPath, link); err != nil {
+		if errors.Is(err, syscall.ERROR_PRIVILEGE_NOT_HELD) {
+			t.Skip("symlink privilege unavailable; lexical fallback assertions completed")
+		}
+		t.Fatal(err)
+	}
+	bound.binaryPath = link
+	guard, err := acquireResponseArtifactGuard(bound)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.close()
+	if guard.mode != "full_hash_fallback" {
+		t.Fatalf("reparse path did not retain old checks: %s", guard.mode)
+	}
+	if err := guard.check(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestResponseArtifactGuardWindowsReadHandleNoninheritable(t *testing.T) {
+	bound := newStatResponseTestBound(t, true)
+	requireResponseLeaseTestPath(t, bound)
+	handle, err := openResponseArtifactReadLease(bound.binaryPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer syscall.CloseHandle(handle)
+	var flags uint32
+	ok, _, callErr := responseKernel32.NewProc("GetHandleInformation").Call(uintptr(handle), uintptr(unsafe.Pointer(&flags)))
+	if ok == 0 {
+		t.Fatal(callErr)
+	}
+	if flags&syscall.HANDLE_FLAG_INHERIT != 0 {
+		t.Fatal("read lease may leak into ordinary child")
+	}
+}
+
+func TestResponseArtifactGuardWindowsLaunchHelper(t *testing.T) {
+	if os.Getenv("GTT_RESPONSE_ARTIFACT_HELPER") == "known-marker-only" {
+		fmt.Println("response-artifact-helper-ok")
+		return
+	}
+	// Copy this already-built test binary into the owned fixture directory.
+	// Exactly one helper process, not a bound engine/GCSIM simulation, proves
+	// that CreateProcess can launch the executable while its read lease is held.
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	source, err := os.Open(executable)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer source.Close()
+	path := filepath.Join(t.TempDir(), "response-helper.test.exe")
+	target, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o700)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, copyErr := io.Copy(target, source)
+	closeErr := target.Close()
+	if err := errors.Join(copyErr, closeErr); err != nil {
+		t.Fatal(err)
+	}
+	bound := BoundEngine{binaryPath: path}
+	requireResponseLeaseTestPath(t, bound)
+	guard, err := acquireResponseArtifactGuard(bound)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer guard.close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	command := exec.CommandContext(ctx, path, "-test.run=^TestResponseArtifactGuardWindowsLaunchHelper$")
+	command.Env = append(os.Environ(), "GTT_RESPONSE_ARTIFACT_HELPER=known-marker-only")
+	output, err := command.CombinedOutput()
+	t.Log("helper_process_calls=1 engine_calls=0")
+	if err != nil || !strings.Contains(string(output), "response-artifact-helper-ok") {
+		t.Fatalf("leased test helper launch failed: %v output=%q", err, output)
+	}
+	if err := guard.check(); err != nil {
+		t.Fatal(err)
+	}
+}
