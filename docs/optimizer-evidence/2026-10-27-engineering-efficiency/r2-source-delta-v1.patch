+}
diff --git a/internal/contracts/mechanic_arguments.go b/internal/contracts/mechanic_arguments.go
new file mode 100644
--- /dev/null
+++ b/internal/contracts/mechanic_arguments.go
@@ -0,0 +1,47 @@
+package contracts
+
+import (
+	"encoding/hex"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+func MechanicBuiltinParameter(name string) (MechanicParameter,bool) {
+	p:=MechanicParameter{Type:name,Known:true}
+	switch name {
+	case "int","int64":p.Encoding="integer";p.Bits=64;p.Signed=true
+	case "uint","uint64","uintptr":p.Encoding="integer";p.Bits=64
+	case "int8","int16","int32":p.Encoding="integer";p.Bits,_=strconv.Atoi(strings.TrimPrefix(name,"int"));p.Signed=true
+	case "uint8","uint16","uint32":p.Encoding="integer";p.Bits,_=strconv.Atoi(strings.TrimPrefix(name,"uint"))
+	case "byte":p.Type="uint8";p.Encoding="integer";p.Bits=8
+	case "rune":p.Type="int32";p.Encoding="integer";p.Bits=32;p.Signed=true
+	case "float32":p.Encoding="float_bits";p.Bits=32
+	case "float64":p.Encoding="float_bits";p.Bits=64
+	case "bool":p.Encoding="boolean"
+	case "string":p.Encoding="string"
+	default:return MechanicParameter{Type:name},false
+	}
+	return p,true
+}
+
+// A valid encoding is not a proof of its source type. The operation binder
+// separately compares this metadata with the verified declaration/aliases.
+func ValidateMechanicArgument(argument MechanicArgument) (bool,error) {
+	if argument.Type=="" {return false,fmt.Errorf("mechanic argument type is absent")}
+	if builtin,ok:=MechanicBuiltinParameter(argument.Type);ok {
+		if builtin.Encoding!=argument.Encoding || builtin.Bits!=argument.Bits || builtin.Signed!=argument.Signed {return false,fmt.Errorf("mechanic argument contradicts its supported type")}
+	}
+	switch argument.Encoding {
+	case "integer":
+		if argument.Bits!=8 && argument.Bits!=16 && argument.Bits!=32 && argument.Bits!=64 {return false,fmt.Errorf("invalid mechanic integer width")}
+		if argument.Signed {value,err:=strconv.ParseInt(argument.Value,10,argument.Bits);if err!=nil || strconv.FormatInt(value,10)!=argument.Value{return false,fmt.Errorf("noncanonical mechanic integer")}} else {value,err:=strconv.ParseUint(argument.Value,10,argument.Bits);if err!=nil || strconv.FormatUint(value,10)!=argument.Value{return false,fmt.Errorf("noncanonical mechanic unsigned integer")}}
+	case "float_bits":
+		if argument.Bits!=32 && argument.Bits!=64 || len(argument.Value)!=argument.Bits/4 || strings.ToLower(argument.Value)!=argument.Value || argument.Signed {return false,fmt.Errorf("invalid mechanic float encoding")}
+		if _,err:=hex.DecodeString(argument.Value);err!=nil{return false,fmt.Errorf("invalid mechanic float bits")}
+	case "boolean":if argument.Value!="true" && argument.Value!="false" || argument.Bits!=0 || argument.Signed{return false,fmt.Errorf("invalid mechanic boolean")}
+	case "string":if argument.Bits!=0 || argument.Signed{return false,fmt.Errorf("invalid mechanic string metadata")}
+	default:return false,nil
+	}
+	return true,nil
+}
diff --git a/internal/contracts/mechanic_limits.go b/internal/contracts/mechanic_limits.go
new file mode 100644
--- /dev/null
+++ b/internal/contracts/mechanic_limits.go
@@ -0,0 +1,43 @@
+package contracts
+
+import "fmt"
+
+const maxMechanicArguments = 64
+const maxMechanicResources = 128
+const maxMechanicEffects = 32
+const maxMechanicPayloadBytes = 8 << 20
+const maxMechanicValueNodes = 262144
+
+type mechanicPayloadBudget struct{ bytes,nodes int }
+
+func (b *mechanicPayloadBudget) text(value string,limit int) error {
+	b.bytes+=len(value)
+	if len(value)>limit || b.bytes>maxMechanicPayloadBytes { return fmt.Errorf("mechanic payload text/byte limit") }
+	return nil
+}
+
+func (b *mechanicPayloadBudget) value(value EventValue,depth int) error {
+	b.nodes++
+	if depth>16 || b.nodes>maxMechanicValueNodes || len(value.Fields)>128 || len(value.Items)>1024 { return fmt.Errorf("mechanic payload value limit") }
+	for _,text:=range []string{value.Kind,value.Type,value.Text} { if err:=b.text(text,4096);err!=nil{return err} }
+	for key,item:=range value.Fields { if err:=b.text(key,256);err!=nil{return err};if err:=b.value(item,depth+1);err!=nil{return err} }
+	for _,item:=range value.Items {if err:=b.value(item,depth+1);err!=nil{return err}}
+	return nil
+}
+
+func cloneMechanicValue(value EventValue) EventValue {
+	if value.Fields!=nil { fields:=make(map[string]EventValue,len(value.Fields));for key,item:=range value.Fields{fields[key]=cloneMechanicValue(item)};value.Fields=fields }
+	if value.Items!=nil {items:=make([]EventValue,len(value.Items));for i,item:=range value.Items{items[i]=cloneMechanicValue(item)};value.Items=items}
+	return value
+}
+
+func cloneMechanicInvocation(value MechanicInvocation) MechanicInvocation {
+	if value.Arguments!=nil {args:=make([]MechanicArgument,len(value.Arguments));copy(args,value.Arguments);value.Arguments=args}
+	clone:=func(input []MechanicResourceObservation)[]MechanicResourceObservation{
+		if input==nil{return nil};out:=make([]MechanicResourceObservation,len(input));copy(out,input)
+		for i:=range out {out[i].Value=cloneMechanicValue(out[i].Value);if input[i].ReadRoots!=nil{out[i].ReadRoots=append([]uint32{},input[i].ReadRoots...)}}
+		return out
+	}
+	value.Before,value.After=clone(value.Before),clone(value.After)
+	return value
+}
diff --git a/internal/contracts/mechanic_operations.go b/internal/contracts/mechanic_operations.go
new file mode 100644
--- /dev/null
+++ b/internal/contracts/mechanic_operations.go
@@ -0,0 +1,119 @@
+package contracts
+
+// The operation ABI declares effects of verified engine symbols. It contains no
+// current HP/cooldown/RNG values and never certifies execution of a branch.
+const MechanicOperationsCapability = "gtt_mechanic_operations_v1"
+
+type MechanicEffectKind string
+
+const (
+	MechanicEffectPure MechanicEffectKind = "pure"
+	MechanicEffectRead MechanicEffectKind = "read"
+	MechanicEffectWrite MechanicEffectKind = "write"
+	MechanicEffectSchedule MechanicEffectKind = "schedule"
+	MechanicEffectRandom MechanicEffectKind = "random"
+	MechanicEffectOpaque MechanicEffectKind = "opaque"
+)
+
+type MechanicResourceEffect struct {
+	Resource string `json:"resource"`
+	// receiver, explicit argument, or unknown; never guessed from a callback.
+	OwnerBinding string `json:"owner_binding"`
+	Lifetime string `json:"lifetime"`
+}
+
+type MechanicOperation struct {
+	BuildProfileSHA256 string `json:"build_profile_sha256,omitempty"`
+	Symbol string `json:"symbol"`
+	Receiver string `json:"receiver"`
+	Method string `json:"method"`
+	Signature string `json:"signature"`
+	SourcePath string `json:"source_path"`
+	SourceSHA256 string `json:"source_sha256"`
+	ClosureSHA256 string `json:"closure_sha256"`
+	Parameters []MechanicParameter `json:"parameters"`
+	Variadic bool `json:"variadic"`
+	Reads []MechanicResourceEffect `json:"reads"`
+	Writes []MechanicResourceEffect `json:"writes"`
+	Effects []MechanicEffectKind `json:"effects"`
+}
+
+type MechanicParameter struct {
+	Type string `json:"type"`
+	Encoding string `json:"encoding"`
+	Bits int `json:"bits,omitempty"`
+	Signed bool `json:"signed,omitempty"`
+	Known bool `json:"known"`
+}
+
+// These are actual observations, not the portable mechanic representation.
+type MechanicResourceIdentity struct {
+	Type string `json:"type"`
+	Resource string `json:"resource"`
+	Instance string `json:"instance"`
+	Lifetime string `json:"lifetime"`
+	Owner int `json:"owner"`
+	OwnerKnown bool `json:"owner_known"`
+}
+
+type MechanicResourceObservation struct {
+	Identity MechanicResourceIdentity `json:"identity"`
+	Version uint64 `json:"version"`
+	Value EventValue `json:"value"`
+	// observed_only cannot be constant-folded into a counterfactual dependency.
+	Provenance string `json:"provenance"`
+	SourceOccurrence string `json:"source_occurrence"`
+	ReadRoots []uint32 `json:"read_roots,omitempty"`
+}
+
+type MechanicInvocation struct {
+	ID string `json:"id"`
+	OperationSymbol string `json:"operation_symbol"`
+	SourceOccurrence string `json:"source_occurrence"`
+	CallPath string `json:"call_path"`
+	ContextSHA256 string `json:"context_sha256"`
+	ConfigSHA256 string `json:"config_sha256"`
+	Seed string `json:"seed"`
+	TraceID string `json:"trace_id"`
+	Order uint64 `json:"order"`
+	Frame int `json:"frame"`
+	Receiver MechanicResourceIdentity `json:"receiver"`
+	Arguments []MechanicArgument `json:"arguments"`
+	CallerOwner int `json:"caller_owner"`
+	CallerKnown bool `json:"caller_known"`
+	Before []MechanicResourceObservation `json:"before"`
+	After []MechanicResourceObservation `json:"after"`
+	Complete bool `json:"complete"`
+}
+
+// Numeric encodings retain exact bits (including signed zero) rather than
+// relying on JSON float formatting or a lossy generic argument snapshot.
+type MechanicArgument struct {
+	Type string `json:"type"`
+	Encoding string `json:"encoding"`
+	Value string `json:"value"`
+	Bits int `json:"bits,omitempty"`
+	Signed bool `json:"signed,omitempty"`
+}
+
+type MechanicInvocationTrace struct {
+	Scope string `json:"scope"`
+	CoveredOperations []string `json:"covered_operations"`
+	MemberContentSHA256 string `json:"member_content_sha256"`
+	SchemaVersion int `json:"schema_version"`
+	ContextSHA256 string `json:"context_sha256"`
+	ConfigSHA256 string `json:"config_sha256"`
+	Seed string `json:"seed"`
+	TraceID string `json:"trace_id"`
+	Complete bool `json:"complete"`
+	Truncated bool `json:"truncated"`
+	MissingReasons []string `json:"missing_reasons,omitempty"`
+	Invocations []MechanicInvocation `json:"invocations"`
+}
+
+type MechanicOperations struct {
+	SchemaVersion int `json:"schema_version"`
+	EngineSHA256 string `json:"engine_sha256"`
+	SourceManifestSHA256 string `json:"source_manifest_sha256"`
+	Operations []MechanicOperation `json:"operations"`
+}
