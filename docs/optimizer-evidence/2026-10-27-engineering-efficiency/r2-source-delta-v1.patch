+	"testing"
+)
+
+func TestR2GroupedProductRetainsActualMixedIterations(t *testing.T) {
+	request, compact := productFixtures(t)
+	compactSHA, e := contracts.CanonicalSHA256(compact)
+	if e != nil {
+		t.Fatal(e)
+	}
+	request = withResultOptionsAndEnergyPolicy(t, request, contracts.ResultOptions{SetGroupLimit: 1, BuildsPerGroup: 2})
+	request = addArtifactVariants(t, request, 2, func(int, contracts.Artifact) string { return "shared_set" })
+	leader := oneSwapAssignment(request, 1, 1)
+	other := oneSwapAssignment(request, 1, 2)
+	winner := finalists.MeasuredCandidate{Assignment: leader, FormulaDPS: 100, MeasuredDPS: 110, StandardError: 1, FormulaResidualDPS: 10, Iterations: 500, AssignmentSHA256: strings.Repeat("7", 64), EngineResultSHA256: strings.Repeat("8", 64)}
+	alternate := finalists.MeasuredCandidate{Assignment: other, FormulaDPS: 99, MeasuredDPS: 80, StandardError: 2, FormulaResidualDPS: -19, Iterations: 100, AssignmentSHA256: strings.Repeat("9", 64), EngineResultSHA256: strings.Repeat("a", 64)}
+	verification := &finalists.VerificationResult{Candidates: []finalists.MeasuredCandidate{winner, alternate}, Winner: winner, Iterations: 0}
+	result, e := buildGroupedProductResult(request, compactSHA, "", nil, nil, []search.ScoredAssignment{{Assignment: leader, DPS: 100}, {Assignment: other, DPS: 99}}, verification, "synthetic-r2-debug.json")
+	if e != nil {
+		t.Fatal(e)
+	}
+	if result.Measured == nil || result.Measured.Iterations != 500 || len(result.Candidates) != 2 || result.Candidates[0].Measured.Iterations != 500 || result.Candidates[1].Measured.Iterations != 100 || result.Candidates[1].Measured.StandardError != "2" {
+		t.Fatalf("mixed iterations lost: %+v", result)
+	}
+	if path := os.Getenv("GTT_R2_UI_FIXTURE"); path != "" {
+		raw, e := json.Marshal(map[string]any{"request": request, "wrapper": map[string]any{"mode": "all_sets", "product_result": result, "verification": verification}})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = os.WriteFile(path, raw, 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+}
diff --git a/cmd/gtt-optimizer/response_selection.go b/cmd/gtt-optimizer/response_selection.go
new file mode 100644
--- /dev/null
+++ b/cmd/gtt-optimizer/response_selection.go
@@ -0,0 +1,149 @@
+package main
+
+import (
+	"fmt"
+	"math"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/search"
+)
+
+// selectResponseReservations builds the complete ordinary-verification panel
+// within the result options already selected by the user. The anchor remains
+// first, response proposals consume available slots before formula-ranked
+// rows, and response proposals are never sorted by their formula score.
+//
+// Response checks use the anchor's set context. Therefore a response proposal
+// with a different canonical set package is deferred; All Sets formula rows
+// may still occupy their own package groups within the configured limits.
+func selectResponseReservations(
+	request contracts.OptimizerRequest,
+	candidates, response []search.ScoredAssignment,
+	allSets bool,
+) ([]search.ScoredAssignment, int, error) {
+	if err := request.Validate(); err != nil {
+		return nil, 0, fmt.Errorf("validate response finalist request: %w", err)
+	}
+	if len(candidates) == 0 {
+		return nil, 0, fmt.Errorf("response finalist selection requires an anchor candidate")
+	}
+
+	options := request.EffectiveResultOptions()
+	perGroup := options.BuildsPerGroup
+	groupLimit := 1
+	totalLimit := perGroup
+	if allSets {
+		groupLimit = options.SetGroupLimit
+		maxInt := int(^uint(0) >> 1)
+		if groupLimit <= 0 || perGroup <= 0 || groupLimit > maxInt/perGroup {
+			return nil, 0, fmt.Errorf("All Sets exact finalist budget overflows")
+		}
+		totalLimit = groupLimit * perGroup
+	}
+	if perGroup <= 0 || groupLimit <= 0 || totalLimit <= 0 {
+		return nil, 0, fmt.Errorf("response finalist limits must be positive")
+	}
+
+	artifacts := make(map[int64]contracts.Artifact, len(request.Artifacts))
+	for _, artifact := range request.Artifacts {
+		artifacts[artifact.ArtifactID] = artifact
+	}
+	groupOf := func(row search.ScoredAssignment, label string) (string, error) {
+		if math.IsNaN(row.DPS) || math.IsInf(row.DPS, 0) || row.DPS < 0 {
+			return "", fmt.Errorf("%s DPS must be finite and non-negative", label)
+		}
+		group, err := canonicalProductGroupKey(request, artifacts, row.Assignment)
+		if err != nil {
+			return "", fmt.Errorf("%s assignment: %w", label, err)
+		}
+		return group, nil
+	}
+
+	// Validate every input up front, including rows which will fall outside the
+	// configured panel. This prevents truncation from hiding malformed or
+	// foreign assignments.
+	candidateGroups := make([]string, len(candidates))
+	for i, row := range candidates {
+		group, err := groupOf(row, fmt.Sprintf("candidate %d", i+1))
+		if err != nil {
+			return nil, 0, err
+		}
+		candidateGroups[i] = group
+	}
+	responseGroups := make([]string, len(response))
+	for i, row := range response {
+		group, err := groupOf(row, fmt.Sprintf("response proposal %d", i+1))
+		if err != nil {
+			return nil, 0, err
+		}
+		responseGroups[i] = group
+	}
+	anchorGroup := candidateGroups[0]
+
+	capacity := len(candidates)
+	if capacity > totalLimit {
+		capacity = totalLimit
+	}
+	if remaining := totalLimit - capacity; len(response) < remaining {
+		capacity += len(response)
+	} else {
+		capacity = totalLimit
+	}
+	selected := make([]search.ScoredAssignment, 0, capacity)
+	selectedSet := make(map[domain.Assignment]struct{}, capacity)
+	groupCounts := make(map[string]int, groupLimit)
+	add := func(row search.ScoredAssignment, group string) bool {
+		if len(selected) >= totalLimit {
+			return false
+		}
+		count, exists := groupCounts[group]
+		if count >= perGroup || !exists && len(groupCounts) >= groupLimit {
+			return false
+		}
+		selected = append(selected, row)
+		selectedSet[row.Assignment] = struct{}{}
+		groupCounts[group] = count + 1
+		return true
+	}
+
+	// candidates[0] is the exact full-build anchor used to produce the response
+	// evidence, so it is always the first verification row.
+	if !add(candidates[0], anchorGroup) {
+		return nil, 0, fmt.Errorf("response finalist budget cannot retain its anchor")
+	}
+
+	seenResponse := make(map[domain.Assignment]struct{}, len(response))
+	for i, row := range response {
+		if _, duplicate := seenResponse[row.Assignment]; duplicate {
+			continue
+		}
+		seenResponse[row.Assignment] = struct{}{}
+		if _, alreadySelected := selectedSet[row.Assignment]; alreadySelected {
+			continue
+		}
+		if responseGroups[i] != anchorGroup {
+			continue
+		}
+		add(row, responseGroups[i])
+	}
+
+	for i := 1; i < len(candidates); i++ {
+		row, group := candidates[i], candidateGroups[i]
+		if _, duplicate := selectedSet[row.Assignment]; duplicate {
+			continue
+		}
+		if !allSets && group != anchorGroup {
+			return nil, 0, fmt.Errorf("Selected finalist %d differs from the anchor set group", i+1)
+		}
+		add(row, group)
+	}
+
+	deferred := 0
+	for assignment := range seenResponse {
+		if _, retained := selectedSet[assignment]; !retained {
+			deferred++
+		}
+	}
+	return selected, deferred, nil
+}
diff --git a/cmd/gtt-optimizer/response_selection_test.go b/cmd/gtt-optimizer/response_selection_test.go
