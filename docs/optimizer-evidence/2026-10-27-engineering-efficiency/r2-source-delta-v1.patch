+	}
+	warnings := strings.Join(responseWarnings(inventoryResponseReceipt{Status: "completed_proposal_only",
+		Coverage: panel.SupportCoverage(), Check: &supportimpact.ResponseCheck{Directions: directions},
+		Combined: combined, Individual: individual, DeferredFinalists: deferred}), " ")
+	if !strings.Contains(warnings, "support_response_challenger_unverified_exact_limit") ||
+		!strings.Contains(warnings, "support_response_proposals_limited") {
+		t.Fatal("single-alternative best-effort boundary was hidden", warnings)
+	}
+}
+
+func TestResponseRetainedXianyunEndpointReachesThreeRowPanel(t *testing.T) {
+	_, filename, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("resolve retained public request")
+	}
+	path := filepath.Join(filepath.Dir(filename), "..", "..", "..", "..", "docs", "optimizer-evidence",
+		"2026-10-12-support-impact", "xianyun-plunge-c0-v1", "prepare", "request.json")
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if contracts.TextSHA256(string(payload)) != "fa2238c338dbf7af0f02d7954021eb300f209d206e25856bfb843f2a4f69054f" {
+		t.Fatal("retained public request changed; review the fixture rather than recapturing")
+	}
+	request, err := contracts.DecodeRequest(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Keep only twenty actual formula-anchor pieces and four pieces from the
+	// historical response winner. No lost runtime IR or character formula is
+	// reconstructed. The compiler below uses the same explicitly synthetic toy
+	// graph as the other test, observing CD and remaining blind to ATK support.
+	anchorAssignment := domain.Assignment{{2, 13, 24, 83, 244}, {5, 308, 322, 378, 539},
+		{300, 605, 616, 672, 822}, {6, 15, 27, 160, 823}}
+	endpoint := anchorAssignment
+	endpoint[1] = [5]int64{4, 309, 322, 385, 513}
+	keep := map[int64]bool{}
+	for actor := range anchorAssignment {
+		for slot, id := range anchorAssignment[actor] {
+			keep[id], keep[endpoint[actor][slot]] = true, true
+			request.Wearers[actor].CurrentArtifacts[slot].ArtifactID = id
+		}
+	}
+	pieces := []contracts.Artifact{}
+	for _, artifact := range request.Artifacts {
+		if keep[artifact.ArtifactID] {
+			pieces = append(pieces, artifact)
+		}
+	}
+	request.Artifacts = pieces
+	request.ResultOptions = &contracts.ResultOptions{SetGroupLimit: 1, BuildsPerGroup: 3}
+	if len(pieces) != 24 {
+		t.Fatal("retained fixture must be reduced to exactly twenty plus four pieces", len(pieces))
+	}
+	_, compact := productFixtures(t)
+	panel, index := responseShapeTestPanel(t, request, compact, 1)
+	if index.Incumbent != anchorAssignment {
+		t.Fatal("reduced public fixture lost the exact anchor")
+	}
+	owner := request.Wearers[1].WearerKey
+	// Replay only the retained five-axis panel. The extra flat-stat probes in
+	// newer panels are not invented from a percent response or a role preset.
+	directions := []supportimpact.Direction{{Owner: owner, Stat: "atk_percent", Amount: .466,
+		MeanDPSChange: 3352.4216239054367, MeanOtherDPSChange: 2593.005337509414,
+		MinimumOtherDPSChange: 2593.005337509414, Status: "positive_on_sampled_seeds"}}
+	for _, axis := range []struct {
+		stat   string
+		amount float64
+	}{{"def_percent", .583}, {"em", 186.5}, {"healing_bonus", .359}, {"hp_percent", .466}} {
+		directions = append(directions, supportimpact.Direction{Owner: owner, Stat: axis.stat, Amount: axis.amount,
+			Status: "inconclusive_local_response"})
+	}
+	anchor, ordered, combined, _ := responseShapeTestProposals(t, index, panel, directions)
+	if len(combined.Proposals) != 1 || combined.Proposals[0].Candidate.Assignment != endpoint {
+		t.Fatal("retained ATK endpoint is no longer generated", combined)
+	}
+	before, _ := index.AssignmentStats(anchorAssignment)
+	after, _ := index.AssignmentStats(endpoint)
+	if math.Abs(after[1]["atk_percent"]-before[1]["atk_percent"]-1.3984) > 1e-12 ||
+		after[1]["crit_rate"] >= before[1]["crit_rate"] || after[1]["crit_damage"] >= before[1]["crit_damage"] {
+		t.Fatal("retained endpoint no longer has its measured-gain/unknown-cost shape")
+	}
+	for _, allSets := range []bool{false, true} {
+		selected, _, err := selectResponseReservations(request, []search.ScoredAssignment{anchor}, ordered, allSets)
+		if err != nil || len(selected) != 3 || selected[0] != anchor || selected[2].Assignment != endpoint {
+			t.Fatal("retained support endpoint lost the existing third row", selected, err)
+		}
+		responseShapeTestAssertPair(t, index, panel, anchorAssignment, selected[1:])
+		if selected[2].DPS >= anchor.DPS {
+			t.Fatal("toy formula must not become the response ranking authority")
+		}
+	}
+}
+
+func responseShapeTestPanel(t *testing.T, request contracts.OptimizerRequest, compact contracts.CompactIR, actor int) (*evaluator.Panel, *domain.Index) {
+	t.Helper()
+	actors := make([]string, len(request.Wearers))
+	for i, wearer := range request.Wearers {
+		actors[i] = wearer.WearerKey
+	}
+	coordinate := actors[actor] + ".crit_damage"
+	for i := range compact.Members {
+		compact.Members[i].Seed = request.Stochastic.Seeds[i]
+		compact.Members[i].Nodes[1].Coordinate = coordinate
+		compact.Members[i].Channels[0].ActorKey = actors[actor]
+		compact.Members[i].Channels[0].ResponseCoordinates = []string{coordinate}
+	}
+	panel, err := evaluator.CompileMembers(actors, request.Stochastic.Seeds, compact.Members)
+	if err != nil {
+		t.Fatal(err)
+	}
+	index, err := domain.Build(request, panel.Coordinates())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return panel, index
+}
+
+func responseShapeTestProposals(t *testing.T, index *domain.Index, panel *evaluator.Panel,
+	directions []supportimpact.Direction) (search.ScoredAssignment, []search.ScoredAssignment, search.ResponseProposals, search.ResponseProposals) {
+	t.Helper()
+	engine, err := search.NewInventory(index, panel, search.DefaultConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	anchor := search.ScoredAssignment{Assignment: index.Incumbent, DPS: responseShapeTestScore(t, index, panel, index.Incumbent), Source: "test_anchor"}
+	combined, err := engine.ProposeCombinedResponseDirections(context.Background(), anchor.Assignment, directions, 5, supportResponseVisitLimit/2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	individual, err := engine.ProposeResponseDirections(context.Background(), anchor.Assignment, directions, 8, supportResponseVisitLimit/2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if combined.FormulaEvaluations > 5 || individual.FormulaEvaluations > 8 ||
+		combined.ArtifactVisits+individual.ArtifactVisits > supportResponseVisitLimit {
+		t.Fatal("existing proposal work allowance expanded", combined, individual)
+	}
+	seen := map[domain.Assignment]bool{anchor.Assignment: true}
+	rows := []search.ScoredAssignment{}
+	for _, proposal := range append(append([]search.ResponseProposal{}, combined.Proposals...), individual.Proposals...) {
+		if !seen[proposal.Candidate.Assignment] {
+			seen[proposal.Candidate.Assignment] = true
+			rows = append(rows, proposal.Candidate)
+		}
+	}
+	ordered, err := prioritizeResponseReservations(index, anchor.Assignment, rows, directions, panel.SupportCoverage())
+	if err != nil || len(ordered) < 2 {
+		t.Fatal("eligible complementary proposals missing", ordered, err)
+	}
+	for _, row := range ordered {
+		if row.DPS != responseShapeTestScore(t, index, panel, row.Assignment) {
+			t.Fatal("proposal priority overwrote original model DPS", row)
+		}
+	}
+	if index.Incumbent != anchor.Assignment {
+		t.Fatal("proposal generation changed the incumbent")
+	}
+	return anchor, ordered, combined, individual
+}
+
+func responseShapeTestAssertPair(t *testing.T, index *domain.Index, panel *evaluator.Panel, anchor domain.Assignment, rows []search.ScoredAssignment) {
+	t.Helper()
+	local, endpoint := false, false
+	for _, row := range rows {
+		if err := index.ValidateAssignment(row.Assignment); err != nil {
+			t.Fatal("selected full build is illegal", err)
+		}
+		distance := 0
+		for actor := range anchor {
+			for slot := range anchor[actor] {
+				if row.Assignment[actor][slot] != anchor[actor][slot] {
+					distance++
+				}
+			}
+		}
+		local = local || distance == 1
+		endpoint = endpoint || distance > 1
+		if row.DPS != responseShapeTestScore(t, index, panel, row.Assignment) {
+			t.Fatal("selected full build lost its model score")
+		}
+	}
+	if len(rows) != 2 || !local || !endpoint {
+		t.Fatal("three-row panel failed to preserve eligible complementary shapes", rows)
+	}
+}
+
+func responseShapeTestScore(t *testing.T, index *domain.Index, panel *evaluator.Panel, assignment domain.Assignment) float64 {
+	t.Helper()
+	deltas, err := index.DenseDeltas(assignment)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dps, err := panel.EvaluateDPS(deltas)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return dps
+}
