+func TestFormulaWorldMechanicResolutionKeepsTypedUnavailableWithoutCapture(t *testing.T) {
+	var packages [4]domain.Package
+	key := theorypackages.Key(packages)
+	w := &FormulaWorld{targets: map[string]targetEntry{key: {codes: []string{"unknown_operation"}, context: strings.Repeat("a", 64), mechanics: []contracts.MechanicBoundary{{Kind: contracts.MechanicUnknownOperation, Operation: "pkg.Type.Call"}}, failure: mechanicpolicy.ModelUnavailable}}, targetOrder: []string{key}, entries: map[string]*formulaEntry{}}
+	resolution, err := w.ResolveMechanics(context.Background(), packages)
+	if err != nil || resolution.Entry != nil || resolution.Boundary == nil || resolution.Boundary.Kind != mechanicpolicy.ModelUnavailable || resolution.CaptureBudgetRemaining != 0 || len(resolution.Boundaries) != 1 {
+		t.Fatalf("typed no-capture result: %#v %v", resolution, err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = w.ResolveMechanics(ctx, packages)
+	if err != context.Canceled {
+		t.Fatalf("cancel became model fallback: %v", err)
+	}
+	if got := w.CollectMechanicBoundaries(); len(got) != 1 || got[0].ContextSHA256 != strings.Repeat("a", 64) {
+		t.Fatalf("bound evidence lost: %#v", got)
+	}
+	w.Close()
+	if got := w.CollectMechanicBoundaries(); len(got) != 1 || got[0].Boundary.Operation != "pkg.Type.Call" {
+		t.Fatalf("failed First discarded bound evidence: %#v", got)
+	}
+}
