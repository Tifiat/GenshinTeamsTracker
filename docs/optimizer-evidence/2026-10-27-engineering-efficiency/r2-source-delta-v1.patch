+package formula
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"testing"
+)
+
+// Frozen pre-plan evaluator: the same inline arithmetic and validation, but
+// every partial evaluation scans active and checks each dependency mask. Keep
+// it independent of the plan cache for both correctness and fair benchmarks.
+func scanArtifactEvaluation(p *ArtifactProgram, delta []float64) (float64, error) {
+	if p == nil || len(delta) != len(p.coordinates) {
+		return 0, fmt.Errorf("artifact program coordinate mismatch")
+	}
+	for _, v := range delta {
+		if !isFinite(v) {
+			return 0, fmt.Errorf("nonfinite artifact input")
+		}
+	}
+	p.prepareDependencies()
+	changed := ^uint64(0)
+	if p.previousValid && p.dependencies != nil {
+		changed = 0
+		for i, value := range delta {
+			if math.Float64bits(value) != math.Float64bits(p.previous[i]) {
+				changed |= uint64(1) << uint(i)
+			}
+		}
+		if changed&p.usedInputs == 0 {
+			copy(p.previous, delta)
+			return p.values[p.root], nil
+		}
+	}
+	p.previousValid = false
+	partial := p.dependencies != nil && changed&p.usedInputs != p.usedInputs
+	evaluate := func(i uint32) error {
+		n := &p.nodes[i]
+		var value float64
+		switch n.op {
+		case opArtifactStat:
+			p.values[i] = delta[n.coordinate]
+			return nil
+		case opAdd:
+			for _, input := range n.inputs {
+				value += p.values[input]
+			}
+		case opMultiply:
+			value = 1
+			for _, input := range n.inputs {
+				value *= p.values[input]
+			}
+		default:
+			v, err := evaluateConstantNode(n, p.values)
+			if err != nil {
+				return err
+			}
+			p.values[i] = v
+			return nil
+		}
+		if !isFinite(value) {
+			return fmt.Errorf("produced a non-finite value")
+		}
+		p.values[i] = value
+		return nil
+	}
+	if p.active == nil {
+		for i := range p.nodes {
+			if err := evaluate(uint32(i)); err != nil {
+				return 0, err
+			}
+		}
+	} else {
+		for _, i := range p.active {
+			if partial && p.dependencies[i]&changed == 0 {
+				continue
+			}
+			if err := evaluate(i); err != nil {
+				return 0, err
+			}
+		}
+	}
+	v := p.values[p.root]
+	if !isFinite(v) {
+		return 0, fmt.Errorf("nonfinite artifact program result")
+	}
+	if p.dependencies != nil {
+		copy(p.previous, delta)
+		p.previousValid = true
+	}
+	return v, nil
+}
+
+func changedMaskFixture(t testing.TB, blocks int) *ArtifactProgram {
+	t.Helper()
+	b := newProgramBuilder([]string{"a.atk", "b.hp", "c.crit", "a.unused"})
+	add := func(n compiledNode) uint32 {
+		id, err := b.add(n)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return id
+	}
+	roots := make([]uint32, 3)
+	for i := range roots {
+		roots[i] = add(compiledNode{op: opArtifactStat, coordinate: i})
+	}
+	for block := 0; block < blocks; block++ {
+		c := add(compiledNode{op: opConstant, value: 1 + float64(block)/1024})
+		scale := add(compiledNode{op: opConstant, value: .5})
+		for i := range roots {
+			sum := add(compiledNode{op: opAdd, inputs: []uint32{roots[i], c}})
+			roots[i] = add(compiledNode{op: opMultiply, inputs: []uint32{sum, scale}})
+		}
+	}
+	return b.finish(add(compiledNode{op: opAdd, inputs: roots}))
+}
+
+func TestArtifactChangedMaskExactSequenceAndOrder(t *testing.T) {
+	fast := changedMaskFixture(t, 4)
+	scan, full := copyArtifactScratch(fast), copyArtifactScratch(fast)
+	points := [][]float64{
+		{2, 3, 4, 0}, {3, 3, 4, 0}, {4, 3, 4, 0}, // first/full, scan, build
+		{4, 3, 4, 1}, {4, 5, 4, 1}, {4, 5, 4, 1}, // unused, different mask, equal
+		{math.Copysign(0, -1), 5, 4, 1}, {0, 5, 4, 1},
+		{math.SmallestNonzeroFloat64, 5, 4, 1},
+		{0, 5, 4, math.NaN()}, {0, 5, 4, 1},
+		{2, 3, 4, 0}, {2, 3, 6, 0}, {2, 3, 7, 0},
+	}
+	for step, point := range points {
+		got, err := fast.Evaluate(point)
+		want, scanErr := scanArtifactEvaluation(scan, point)
+		fullValue, fullErr := referenceArtifactSweep(full, point)
+		if fmt.Sprint(err) != fmt.Sprint(scanErr) || fmt.Sprint(err) != fmt.Sprint(fullErr) ||
+			math.Float64bits(got) != math.Float64bits(want) || math.Float64bits(got) != math.Float64bits(fullValue) {
+			t.Fatalf("step %d: got=%v scan=%v full=%v errors=%v/%v/%v", step, got, want, fullValue, err, scanErr, fullErr)
+		}
+		if step == 0 && fast.changedActive != nil {
+			t.Fatal("first evaluation used a partial plan")
+		}
+		if cap(fast.changedActive) > len(fast.active) {
+			t.Fatal("plan exceeded one active list")
+		}
+		if fast.changedPlanReady {
+			wantOrder := []uint32{}
+			for _, i := range fast.active {
+				if fast.dependencies[i]&fast.lastChangedMask != 0 {
+					wantOrder = append(wantOrder, i)
+				}
+			}
+			if !reflect.DeepEqual(fast.changedActive, wantOrder) {
+				t.Fatalf("plan reordered nodes: %v want=%v", fast.changedActive, wantOrder)
+			}
+		}
+	}
+	if _, err := fast.Evaluate([]float64{1}); err == nil {
+		t.Fatal("cached plan bypassed coordinate validation")
+	}
+}
+
+func TestArtifactChangedMaskRepeatAdmission(t *testing.T) {
+	p := changedMaskFixture(t, 4)
+	oracle := copyArtifactScratch(p)
+	evaluate := func(point []float64) {
+		t.Helper()
+		got, err := p.Evaluate(point)
+		want, other := scanArtifactEvaluation(oracle, point)
+		if fmt.Sprint(err) != fmt.Sprint(other) || math.Float64bits(got) != math.Float64bits(want) {
+			t.Fatalf("got=%v want=%v errors=%v/%v", got, want, err, other)
+		}
+	}
+	for _, point := range [][]float64{{2, 3, 4, 0}, {3, 3, 4, 0}, {3, 5, 4, 0}, {4, 5, 4, 0}, {4, 6, 4, 0}} {
+		evaluate(point)
+		if p.changedActive != nil || p.changedPlanReady {
+			t.Fatal("alternating masks materialized a plan")
+		}
+	}
+	evaluate([]float64{4, 7, 4, 0})
+	if !p.changedPlanReady || p.lastChangedMask != 2 || len(p.changedActive) == 0 {
+		t.Fatal("repeated mask did not admit a plan")
+	}
+	order := append([]uint32(nil), p.changedActive...)
+	storage := &p.changedActive[0]
+	evaluate([]float64{4, 8, 4, 0})
+	if !p.changedPlanReady || &p.changedActive[0] != storage || !reflect.DeepEqual(p.changedActive, order) {
+		t.Fatal("repeated mask did not retain its ordered plan")
+	}
+	for _, point := range [][]float64{{5, 8, 4, 0}, {5, 9, 4, 0}, {6, 9, 4, 0}} {
+		evaluate(point)
+		if p.changedPlanReady || len(p.changedActive) != 0 || cap(p.changedActive) > len(p.active) ||
+			&p.changedActive[:cap(p.changedActive)][0] != storage {
+			t.Fatal("new mask materialized a plan or replaced bounded storage")
+		}
+	}
+	evaluate([]float64{7, 10, 5, 0})
+	if p.lastChangedMask != 0 || p.changedPlanReady || len(p.changedActive) != 0 {
+		t.Fatal("full evaluation retained partial-mask admission")
+	}
