+func TestMechanicIRDeepHelperWarmAndSourceInvalidation(t *testing.T) {
+	repositorySource := func(multiplier int) *RuleSourceRepository {
+		text := `package deep
+type Worker struct{}
+func (w Worker) Apply(v int) int { return v * MULTIPLIER }
+func Scale(v int) int { if v > 0 { return Worker{}.Apply(v) }; return 0 }
+const MULTIPLIER = ` + string(rune('0'+multiplier))
+		return &RuleSourceRepository{Module: "github.com/genshinsim/gcsim", Files: map[string]contracts.SourceText{"pkg/deep/deep.go": {Text: text, SHA256: contracts.TextSHA256(text)}}}
+	}
+	source := map[string][]byte{"internal/artifacts/example/rule.go": []byte(`package example
+import nested "github.com/genshinsim/gcsim/pkg/deep"
+func Start(v int) int { return nested.Scale(v) }
+`)}
+	engine := contracts.EngineBinding{ArtifactSHA256: strings.Repeat("a", 64), SourceManifestSHA256: strings.Repeat("b", 64)}
+	dir := t.TempDir()
+	compile := func(multiplier int, cache *RuleParseCache) (MechanicIR, string, string) {
+		repo, err := newRuleRepository(repositorySource(multiplier), build.Default)
+		if err != nil {
+			t.Fatal(err)
+		}
+		p, err := compileRuleProgramCached(source, nil, cache)
+		if err != nil {
+			t.Fatal(err)
+		}
+		p.repository, p.parseCache = repo, cache
+		key, closure, profile, abi, err := mechanicIRKey(p.entry, repo, nil, engine, strings.Repeat("c", 64), source, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ir, origin, err := cache.loadMechanicIR(key, MechanicIR{Entry: p.entry, SourceClosureSHA256: closure, BuildProfileSHA256: profile, OperationABISHA256: abi}, func() (MechanicIR, error) { return buildMechanicIR(p, repo, nil, closure, profile, abi) })
+		if err != nil {
+			t.Fatal(err)
+		}
+		return ir, origin, key
+	}
+	cold, origin, key := compile(3, NewRuleParseCache("", dir))
+	if origin != "source" || cold.Coverage.Link != "linked" || len(cold.Guards) == 0 {
+		t.Fatalf("cold IR incomplete: %s %#v", origin, cold)
+	}
+	method := false
+	for _, symbol := range cold.Symbols {
+		method = method || strings.HasSuffix(symbol, ".Worker.Apply")
+	}
+	if !method {
+		t.Fatal("helper method was not in source graph")
+	}
+	if _, err := os.Stat(filepath.Join(dir, key+".gttir")); err != nil {
+		t.Fatal(err)
+	}
+	warm, origin, _ := compile(3, NewRuleParseCache("", dir))
+	if origin != "writable" || len(warm.Calls) != len(cold.Calls) || warm.SourceClosureSHA256 != cold.SourceClosureSHA256 {
+		t.Fatalf("warm mismatch: %s %#v", origin, warm)
+	}
+	changed, origin, changedKey := compile(4, NewRuleParseCache("", dir))
+	if origin != "source" || changedKey == key || changed.SourceClosureSHA256 == cold.SourceClosureSHA256 {
+		t.Fatal("deep helper did not invalidate IR")
+	}
+}
