+package search
+
+// Bounded gradient relinearization for a complete candidate run. It reuses
+// candidateRun's legal package assignment, exact reduced evaluator, observers,
+// and finalist rechecks. A zero discrete gradient is only a stop
+// condition for this walk; it is not a bound on nonlinear candidates.
+import (
+	"context"
+	"fmt"
+	"math"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+// ResearchCandidateCost records the existing candidate route's expensive
+// work by actor and selected package. This is diagnostic-only telemetry used
+// by the accepted bounded adaptive helpers.
+type ResearchCandidateCost struct {
+	CandidateRuns             int64 `json:"candidate_runs"`
+	InitialProgramCalls       int64 `json:"initial_program_calls"`
+	InitialProgramNanos       int64 `json:"initial_program_nanos"`
+	PointProgramCalls         int64 `json:"point_program_calls"`
+	PointProgramNanos         int64 `json:"point_program_nanos"`
+	FinishScoreCalls          int64 `json:"finish_score_calls"`
+	FinishScoreNanos          int64 `json:"finish_score_nanos"`
+	WalkPointFullScoreCalls   int64 `json:"walk_point_full_score_calls"`
+	WalkPointFullScoreNanos   int64 `json:"walk_point_full_score_nanos"`
+	ValueGradientCalls        int64 `json:"value_gradient_calls"`
+	ValueGradientNanos        int64 `json:"value_gradient_nanos"`
+	LinearAssignmentCalls     int64 `json:"linear_assignment_calls"`
+	LinearAssignmentNanos     int64 `json:"linear_assignment_nanos"`
+	LinearPlanCalls           int64 `json:"linear_plan_calls"`
+	LinearPlanNanos           int64 `json:"linear_plan_nanos"`
+	LinearPlanAssignmentCalls int64 `json:"linear_plan_assignment_calls"`
+	LinearPlanAssignmentNanos int64 `json:"linear_plan_assignment_nanos"`
+}
+
+func researchCandidateCostKey(actor int, packageKey string) string {
+	return fmt.Sprintf("%d:%s", actor, packageKey)
+}
+
+func researchCandidateMetricKey(engine *Engine, actor int) string {
+	if engine == nil || engine.domain == nil || actor < 0 || actor >= len(engine.domain.Wearers) {
+		return ""
+	}
+	return researchCandidateCostKey(actor, (domain.Package{Sets: engine.domain.Wearers[actor].SelectedSets}).Key())
+}
+
+func researchCandidateMetric(engine *Engine, actor int) *ResearchCandidateCost {
+	key := researchCandidateMetricKey(engine, actor)
+	if key == "" || engine == nil {
+		return nil
+	}
+	if engine.candidateMetrics == nil {
+		engine.candidateMetrics = make(map[string]*ResearchCandidateCost)
+	}
+	value := engine.candidateMetrics[key]
+	if value == nil {
+		value = &ResearchCandidateCost{}
+		engine.candidateMetrics[key] = value
+	}
+	return value
+}
+
+// ResearchCandidateCostFor returns this engine's actor/package telemetry.
+// Search engines are owned by one serial coordinator run; no process-global
+// counters or cross-request state is shared.
+func (engine *Engine) ResearchCandidateCostFor(actor int, packageKey string) ResearchCandidateCost {
+	if engine == nil || engine.candidateMetrics == nil {
+		return ResearchCandidateCost{}
+	}
+	value := engine.candidateMetrics[researchCandidateCostKey(actor, packageKey)]
+	if value == nil {
+		return ResearchCandidateCost{}
+	}
+	return *value
+}
+
+const researchRelinearizeMaxRounds = 5
+
+type RelinearizeResult struct {
+	Incumbent            ScoredAssignment   `json:"incumbent"`
+	FullCheckedIncumbent ScoredAssignment   `json:"full_checked_incumbent"`
+	AnchorReducedDPS     float64            `json:"anchor_reduced_dps"`
+	AnchorFullCheckedDPS float64            `json:"anchor_full_checked_dps"`
+	Points               []ScoredAssignment `json:"points"`
+	FullCheckedPoints    []ScoredAssignment `json:"full_checked_points"`
+	AcceptedFullScores   []float64          `json:"accepted_full_scores"`
+	Rounds               int                `json:"rounds"`
+	AcceptedMoves        int                `json:"accepted_moves"`
+	ZeroGradientRounds   int                `json:"zero_gradient_rounds"`
+	Stop                 string             `json:"stop"`
+	Report               CandidateReport    `json:"report"`
+}
+
+func researchRelinearizeZeroGradient(priorities map[int64]float64) bool {
+	for _, value := range priorities {
+		if value != 0 || math.IsNaN(value) {
+			return false
+		}
+	}
+	return true
+}
+
+func researchRelinearizePromotes(currentFullDPS, challengerFullDPS float64) bool {
+	return challengerFullDPS > currentFullDPS
+}
+
+func researchRelinearizeTrial(anchor domain.Assignment, actor int, ids [5]int64) (domain.Assignment, error) {
+	if actor < 0 || actor >= len(anchor) {
+		return domain.Assignment{}, fmt.Errorf("relinearization actor out of range")
+	}
+	trial := anchor
+	trial[actor] = ids
+	return trial, nil
+}
+
+// RelinearizeCandidates follows at most five current-gradient legal
+// linear assignments. Only an exact strict DPS increase becomes the next
+// gradient anchor; ties retain the earlier incumbent even if finalist ordering
+// later prefers another equal-DPS assignment.
+func (engine *Engine) RelinearizeCandidates(ctx context.Context, anchor domain.Assignment, actor, allowance int) (RelinearizeResult, error) {
+
+	result := RelinearizeResult{Stop: "not_started"}
+	if ctx == nil {
+		return result, fmt.Errorf("relinearization requires a live context")
+	}
+	if err := ctx.Err(); err != nil {
+		result.Stop = "context_canceled"
+		return result, err
+	}
+	r, err := engine.candidateRun(ctx, anchor, actor, allowance)
+	if err != nil {
+		result.Stop = "candidate_run_error"
+		return result, err
+	}
+	incumbent := r.best
+	result.Incumbent = incumbent
+	anchorDPS, err := researchRelinearizeFullScore(r, r.anchor)
+	if err != nil {
+		result.Stop = "anchor_full_score_error"
+		return result, err
+	}
+	result.AnchorFullCheckedDPS = anchorDPS
+	fullIncumbent := ScoredAssignment{Assignment: r.anchor, DPS: anchorDPS, Source: "anchor_full_score"}
+	result.FullCheckedIncumbent = fullIncumbent
+	r.seen[anchor[actor]] = true
+	linearPoints := make([]ScoredAssignment, 0, researchRelinearizeMaxRounds)
+
+	for round := 0; round < researchRelinearizeMaxRounds; round++ {
+		if err := ctx.Err(); err != nil {
+			result.Stop = "context_canceled"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), err
+		}
+		if r.report.Step.Expanded >= allowance {
+			result.Stop = "expanded_cap"
+			break
+		}
+		result.Rounds++
+		weights, err := r.priorities(incumbent.Assignment[actor])
+		if err != nil {
+			result.Stop = "gradient_error"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), err
+		}
+		if researchRelinearizeZeroGradient(weights) {
+			// Zero gradient is diagnostic only. Still try the legal linear choice
+			// and exact point score; it is not a global certificate.
+			result.ZeroGradientRounds++
+		}
+		ids, found, err := r.linear(weights)
+		if err != nil {
+			result.Stop = "linear_assignment_error"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), err
+		}
+		if !found {
+			result.Stop = "no_legal_linear_assignment"
+			break
+		}
+		if r.seen[ids] {
+			result.Stop = "repeated_assignment"
+			break
+		}
+		beforeExpanded := r.report.Step.Expanded
+		if err := r.point(ids, false, false); err != nil {
+			result.Stop = "point_error"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), err
+		}
+		if r.report.Step.Expanded == beforeExpanded {
+			result.Stop = "linear_point_not_scored"
+			break
+		}
+		trial, err := researchRelinearizeTrial(r.anchor, actor, ids)
+		if err != nil {
+			result.Stop = "trial_assignment_error"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), err
+		}
+		candidate := r.lastPoint
+		if candidate.Assignment != trial {
+			result.Stop = "cross_actor_assignment_mismatch"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), fmt.Errorf("relinearization changed assignment outside the selected actor")
+		}
+		linearPoints = append(linearPoints, candidate)
+		fullDPS, err := researchRelinearizeFullScore(r, candidate.Assignment)
+		if err != nil {
+			result.Stop = "point_full_score_error"
+			return researchRelinearizeResultFromRun(result, r, incumbent, linearPoints), err
+		}
+		checked := candidate
+		checked.DPS = fullDPS
+		checked.Source = "linear_point_full_score"
+		result.FullCheckedPoints = append(result.FullCheckedPoints, checked)
+		if fullDPS > result.FullCheckedIncumbent.DPS {
+			result.FullCheckedIncumbent = checked
+		}
+		if !researchRelinearizePromotes(fullIncumbent.DPS, checked.DPS) {
+			result.Stop = "no_strict_full_improvement"
+			break
+		}
+		incumbent = candidate
+		fullIncumbent = checked
+		result.AcceptedFullScores = append(result.AcceptedFullScores, fullDPS)
+		result.AcceptedMoves++
+	}
+
+	if result.Stop == "not_started" {
+		result.Stop = "round_cap"
+	}
+	if result.Stop == "" {
+		result.Stop = "round_cap"
+	}
+	return researchRelinearizeFinish(result, r, incumbent, linearPoints)
+}
+
+func researchRelinearizeResultFromRun(result RelinearizeResult, r *candidateRun, incumbent ScoredAssignment, points []ScoredAssignment) RelinearizeResult {
+	result.Incumbent = incumbent
+	result.AnchorReducedDPS = r.report.Step.AnchorDPS
+	result.Points = append([]ScoredAssignment(nil), points...)
+	result.Report = r.report
+	return result
+}
+
+func researchRelinearizeFullScore(r *candidateRun, assignment domain.Assignment) (float64, error) {
+	return r.engine.score(assignment)
+}
+
+func researchRelinearizeFinish(result RelinearizeResult, r *candidateRun, incumbent ScoredAssignment, points []ScoredAssignment) (RelinearizeResult, error) {
+	result = researchRelinearizeResultFromRun(result, r, incumbent, points)
+
+	// Preserve the normal finalist merge/recheck pass separately from the
+	// direct checks performed before promotion, which cover points even if
+	// finalist retention later trims one.
+	report, err := r.finish(nil)
+	result.Report = report
+	result.Incumbent = incumbent
+	if err != nil {
+		result.Stop = "finish_recheck_error"
+		return result, err
+	}
+	return result, nil
+}
diff --git a/internal/search/candidate_dot_priorities_test.go b/internal/search/candidate_dot_priorities_test.go
new file mode 100644
--- /dev/null
+++ b/internal/search/candidate_dot_priorities_test.go
@@ -0,0 +1,326 @@
+package search
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/evaluator"
+)
+
+func legacyCandidateDotPriorities(vectors map[int64][]float64, weights []float64) map[int64]float64 {
+	priority := make(map[int64]float64, len(vectors))
+	for id, vector := range vectors {
+		for j, weight := range weights {
+			priority[id] += weight * vector[j]
+		}
+	}
+	return priority
+}
+
+func assertCandidateDotPrioritiesEqual(t *testing.T, got, want map[int64]float64) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("priority key count differs: got %d, want %d", len(got), len(want))
+	}
+	for id, wantValue := range want {
+		gotValue, ok := got[id]
+		if !ok {
+			t.Fatalf("priority key %d is missing", id)
+		}
+		if math.Float64bits(gotValue) != math.Float64bits(wantValue) {
+			t.Fatalf("priority[%d] bits differ: got %016x, want %016x", id, math.Float64bits(gotValue), math.Float64bits(wantValue))
+		}
+	}
+}
+
+func sameCandidateFloatBits(left, right []float64) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for i := range left {
+		if math.Float64bits(left[i]) != math.Float64bits(right[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func TestCandidateDotPrioritiesMatchesLegacyBits(t *testing.T) {
+	negativeZero := math.Copysign(0, -1)
+	cases := []struct {
+		name    string
+		vectors map[int64][]float64
+		weights []float64
+	}{
+		{
+			name: "empty_dimensions_keep_empty_map",
+			vectors: map[int64][]float64{
+				41: {},
+				7:  {0, 1, -1},
+			},
+			weights: nil,
+		},
+		{
+			name: "non_nil_empty_weights_keep_empty_map",
+			vectors: map[int64][]float64{
+				41: {},
+				7:  {0, 1, -1},
+			},
+			weights: []float64{},
+		},
+		{
+			name: "signed_zero_and_zero_weights",
+			vectors: map[int64][]float64{
+				90: {negativeZero, 1, 0, negativeZero},
+				3:  {negativeZero, 1, 0, negativeZero}, // repeated vector under another physical ID
+				61: {0, negativeZero, negativeZero, 1},
+			},
+			weights: []float64{1, negativeZero, 0, -1},
+		},
+		{
+			name: "cancellation_and_large_small_terms",
+			vectors: map[int64][]float64{
+				8: {1e16, 1, -1e16, 1, 0},
+				2: {1, -1e16, 1e16, -1, 0},
+				5: {0, 0, 0, 0, 0},
+			},
+			weights: []float64{1, 1, 1, 1, 0},
+		},
+		{
+			name: "negative_and_unused_zero_dimensions",
+			vectors: map[int64][]float64{
+				72: {2, -3, 4, 8, 0, 0},
+				11: {-2, 3, -4, -8, 0, 0},
+				99: {0, 0, 0, 0, 0, 0},
+			},
+			weights: []float64{-2, 0, 0.5, -1, 0, 0},
+		},
+		{
+			// These dimensions intentionally mix wearer-local and foreign-support
+			// coordinates. The helper must include every dimension without filtering.
+			name: "all_synthetic_support_dimensions",
+			vectors: map[int64][]float64{
+				501: {4, -2, 0.5, 3, 0, -1},
+				108: {4, -2, 0.5, 3, 0, -1}, // exact repeat, different ID
+				37:  {-1, 5, 2, 0, 7, 3},
+			},
+			weights: []float64{0.25, -0.75, 2, 0, 1.5, -0.5},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := candidateDotPriorities(tc.vectors, tc.weights)
+			want := legacyCandidateDotPriorities(tc.vectors, tc.weights)
+			assertCandidateDotPrioritiesEqual(t, got, want)
+			if len(tc.weights) == 0 && got == nil {
+				t.Fatal("zero-dimensional result must be an allocated empty map")
+			}
+		})
+	}
+
+	// A deterministic sweep varies dimensions, exact
+	// repeats, zero vectors, negative values, and zero-weight coordinates.
+	for seed := 1; seed <= 9; seed++ {
+		dimension := seed + 2
+		weights := make([]float64, dimension)
+		for j := range weights {
+			value := (seed*7+j*11)%17 - 8
+			if (seed+j)%5 == 0 {
+				weights[j] = 0
+			} else {
+				weights[j] = float64(value) / float64(j+1)
+			}
+		}
+		vectors := make(map[int64][]float64, 17)
+		for item := 0; item < 17; item++ {
+			vector := make([]float64, dimension)
+			if item%7 != 0 {
+				for j := range vector {
+					value := (seed*13+item*5+j*3)%29 - 14
+					vector[j] = float64(value) / float64(j+1)
+				}
+			}
+			if item%5 == 4 {
+				copy(vector, vectors[int64(100+item-1)])
+			}
+			vectors[int64(100+item)] = vector
+		}
+		got := candidateDotPriorities(vectors, weights)
+		want := legacyCandidateDotPriorities(vectors, weights)
+		assertCandidateDotPrioritiesEqual(t, got, want)
+	}
+}
+
+func TestCandidateRunPrioritiesMatchLegacyAndPreserveTies(t *testing.T) {
+	req, ir := searchFixtures(t)
+	nextID := int64(1)
+	for _, artifact := range req.Artifacts {
+		if artifact.ArtifactID >= nextID {
+			nextID = artifact.ArtifactID + 1
+		}
+	}
+	cloneGroups := make([][3]int64, 0, 5)
+	sourceCount := min(5, len(req.Artifacts))
+	for sourceIndex := 0; sourceIndex < sourceCount; sourceIndex++ {
+		source := req.Artifacts[sourceIndex]
+		group := [3]int64{source.ArtifactID}
+		for cloneIndex := 1; cloneIndex < len(group); cloneIndex++ {
+			clone := source
+			clone.ArtifactID = nextID
+			nextID++
+			clone.Substats = append([]contracts.StatValue(nil), source.Substats...)
+			req.Artifacts = append(req.Artifacts, clone)
+			group[cloneIndex] = clone.ArtifactID
+		}
+		cloneGroups = append(cloneGroups, group)
+	}
+	var err error
+	ir.RequestSHA256, err = contracts.CanonicalSHA256(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	panel, err := evaluator.Compile(req, ir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	index, err := domain.Build(req, panel.Coordinates())
+	if err != nil {
+		t.Fatal(err)
+	}
+	engine, err := NewInventory(index, panel, DefaultConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	run, err := engine.candidateRun(context.Background(), index.Incumbent, 0, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	beforeGuides := run.report.Step.GuideEvaluations
+	got, err := run.priorities(index.Incumbent[run.actor])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if run.report.Step.GuideEvaluations != beforeGuides+1 {
+		t.Fatalf("guide count changed by %d, want exactly one", run.report.Step.GuideEvaluations-beforeGuides)
+	}
+	_, weights, _, err := run.program.ValueGradient(run.x)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := legacyCandidateDotPriorities(run.vectors, weights)
+	assertCandidateDotPrioritiesEqual(t, got, want)
+
+	gotIDs, gotFound, err := run.linear(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantIDs, wantFound, err := run.linear(want)
+	if err != nil || gotFound != wantFound || gotIDs != wantIDs {
+		t.Fatalf("linear assignment changed: got %v/%v, want %v/%v (err %v)", gotIDs, gotFound, wantIDs, wantFound, err)
+	}
+
+	tieFound := false
+	for _, group := range cloneGroups {
+		for i := 0; i < len(group); i++ {
+			for j := i + 1; j < len(group); j++ {
+				left, leftOK := run.vectors[group[i]]
+				right, rightOK := run.vectors[group[j]]
+				if !leftOK || !rightOK || run.used[group[i]] || run.used[group[j]] {
+					continue
+				}
+				if sameCandidateFloatBits(left, right) && math.Float64bits(got[group[i]]) == math.Float64bits(got[group[j]]) {
+					tieFound = true
+				}
+			}
+		}
+	}
+	if !tieFound {
+		t.Fatal("fixture did not retain an available exact-vector priority tie")
+	}
+
+	// All-zero weights force PackageLinearAssignment through physical-ID ties.
+	zeroWeights := make([]float64, len(run.x))
+	zeroGot := candidateDotPriorities(run.vectors, zeroWeights)
+	zeroWant := legacyCandidateDotPriorities(run.vectors, zeroWeights)
+	assertCandidateDotPrioritiesEqual(t, zeroGot, zeroWant)
+	selected, found, err := run.linear(zeroGot)
+	if err != nil || !found {
+		t.Fatalf("zero-priority linear assignment: found=%v err=%v", found, err)
+	}
+	legacySelected, legacyFound, err := run.linear(zeroWant)
+	if err != nil || !legacyFound || selected != legacySelected {
+		t.Fatalf("zero-priority tie assignment changed: got %v/%v, want %v/%v (err %v)", selected, found, legacySelected, legacyFound, err)
+	}
+	for slot, selectedID := range selected {
+		selectedUID := ""
+		selectedFound := false
+		for _, artifact := range index.Artifacts {
+			if artifact.ArtifactID == selectedID {
+				selectedUID = artifact.SetUID
+				selectedFound = true
+				break
+			}
+		}
+		if !selectedFound {
+			t.Fatalf("selected artifact %d is missing", selectedID)
+		}
+		lowest := selectedID
+		for _, artifact := range index.Artifacts {
+			if artifact.SlotIndex != slot || artifact.SetUID != selectedUID || run.used[artifact.ArtifactID] {
+				continue
+			}
+			candidatePriority := zeroGot[artifact.ArtifactID] // absent map entries read as the same zero used by the selector
+			if math.Float64bits(candidatePriority) == math.Float64bits(zeroGot[selectedID]) && artifact.ArtifactID < lowest {
+				lowest = artifact.ArtifactID
+			}
+		}
+		if selectedID != lowest {
+			t.Fatalf("slot %d did not keep the smallest tied physical ID: got %d, want %d", slot, selectedID, lowest)
+		}
+	}
+}
+
+var candidateDotPrioritiesBenchSink map[int64]float64
+
+func BenchmarkCandidateDotPriorities(b *testing.B) {
+	for _, size := range []int{64, 1024} {
+		n := size
+		vectors := make(map[int64][]float64, n)
+		for item := 0; item < n; item++ {
+			vector := make([]float64, 20)
+			if item%31 != 0 {
+				for j := range vector {
+					vector[j] = float64((item*7+j*13)%41-20) / float64(j+1)
+				}
+			}
+			if item%8 == 7 {
+				copy(vector, vectors[int64(item)])
+			}
+			vectors[int64(item+1)] = vector
+		}
+		weights := make([]float64, 20)
+		for j := range weights {
+			weights[j] = float64((j*11)%23-11) / float64(j+1)
+		}
+
+		b.Run(fmt.Sprintf("N=%d/production_helper", n), func(b *testing.B) {
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				candidateDotPrioritiesBenchSink = candidateDotPriorities(vectors, weights)
+			}
+		})
+		b.Run(fmt.Sprintf("N=%d/legacy_map_updates", n), func(b *testing.B) {
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				candidateDotPrioritiesBenchSink = legacyCandidateDotPriorities(vectors, weights)
+			}
+		})
+	}
+}
