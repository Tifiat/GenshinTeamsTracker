@@ -0,0 +1,45 @@
+package engineclient
+
+import "genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+
+// irNodeLookup borrows one immutable member only for the current validation.
+// The production decoder already validates contiguous IDs. Rechecking that
+// inexpensive invariant here keeps direct package callers' legacy map behavior
+// without trusting an unchecked dense index or allocating another node table.
+type irNodeLookup struct {
+	nodes []contracts.IRNode
+	dense bool
+}
+
+func newIRNodeLookup(nodes []contracts.IRNode) irNodeLookup {
+	lookup := irNodeLookup{nodes: nodes, dense: true}
+	for i, node := range nodes {
+		if uint64(node.NodeID) != uint64(i)+1 {
+			lookup.dense = false
+			break
+		}
+	}
+	return lookup
+}
+
+func (lookup irNodeLookup) get(id uint32) (contracts.IRNode, bool) {
+	if lookup.dense {
+		if id == 0 || uint64(id) > uint64(len(lookup.nodes)) {
+			return contracts.IRNode{}, false
+		}
+		return lookup.nodes[id-1], true
+	}
+	// Unvalidated private callers previously populated a map in slice order.
+	// Reverse lookup preserves sparse/zero IDs and duplicate last-write wins.
+	for i := len(lookup.nodes) - 1; i >= 0; i-- {
+		if lookup.nodes[i].NodeID == id {
+			return lookup.nodes[i], true
+		}
+	}
+	return contracts.IRNode{}, false
+}
+
+func (lookup irNodeLookup) contains(id uint32) bool {
+	_, found := lookup.get(id)
+	return found
+}
