+package main
+
+import (
+ "context"
+ "encoding/json"
+ "os"
+ "path/filepath"
+ "genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+ "genshinteamstracker/native/gcsim_optimizer/internal/domain"
+ "genshinteamstracker/native/gcsim_optimizer/internal/mechanicpolicy"
+ "genshinteamstracker/native/gcsim_optimizer/internal/seteffects"
+)
+
+// A model gap is a successful, explicitly incomplete product outcome only when
+// a legal physical build remains. No placeholder formula leaves this boundary.
+func writeInventoryMechanicFallback(ctx context.Context,req contracts.OptimizerRequest,modelErr error,finished bool,runRoot string,sources *seteffects.SourceCatalog,boundaries []contracts.BoundMechanicBoundary)error{
+ if _,ok:=mechanicpolicy.AsModelUnavailable(modelErr);!ok{return modelErr}
+ index,err:=domain.Build(req,nil);if err!=nil{return err}
+ options:=req.EffectiveResultOptions()
+ remaining:=options.SetGroupLimit*options.BuildsPerGroup
+ if req.Finalists.MaxCandidates>0{remaining=min(remaining,req.Finalists.MaxCandidates)}
+ plan,err:=prepareMechanicFallback(req,index,modelErr,finished,remaining,false);if err!=nil{return err}
+ measured,err:=verifyMechanicFallback(ctx,req,index,plan,runRoot);if err!=nil{return err}
+ product,err:=inventoryMechanicFallbackProduct(req,plan,measured,filepath.Join(runRoot,"mechanic-fallback-result.json"));if err!=nil{return err}
+ wrapper:=map[string]any{"mode":"all_sets","product_result":product,"mechanic_fallback":plan,"measured_anchor":measured,"mechanics":sources.MechanicReport(boundaries)}
+ payload,err:=json.MarshalIndent(wrapper,"","  ");if err!=nil{return err}
+ if err=os.WriteFile(filepath.Join(runRoot,"mechanic-fallback-result.json"),append(payload,'\n'),0600);err!=nil{return err}
+ return json.NewEncoder(os.Stdout).Encode(wrapper)
+}
+
+func inventoryMechanicFallbackProduct(req contracts.OptimizerRequest,plan MechanicFallbackPlan,measured *MeasuredOnlyMechanicAnchor,receipt string)(contracts.OptimizerResult,error){
+ sha,err:=contracts.CanonicalSHA256(req);if err!=nil{return contracts.OptimizerResult{},err}
+	fallbackSHA,err:=contracts.CanonicalSHA256(plan);if err!=nil{return contracts.OptimizerResult{},err}
+ assignments:=productAssignments(req,plan.Anchor)
+ product:=contracts.OptimizerResult{SchemaVersion:contracts.SchemaVersion,SchemaKind:contracts.ResultSchemaKind,RequestSHA256:sha,
+  Status:"success",RankingBasis:"unavailable",ModelAccuracy:"unavailable",SearchCoverage:"incomplete_model",MechanicFallbackSHA256:fallbackSHA,Winner:assignments,
+  Candidates:[]contracts.RankedCandidateResult{{Rank:1,Artifacts:assignments}},DebugReceiptPath:receipt,
+  Warnings:[]string{"mechanic_model_unavailable","mechanic_search_incomplete"}}
+ if measured!=nil{
+  product.RankingBasis="gcsim";product.Measured=&contracts.MeasuredResult{Iterations:measured.Iterations,DPS:decimalText(measured.MeasuredDPS),StandardError:decimalText(measured.StandardError),EngineResultSHA256:measured.EngineResultSHA256}
+  product.Candidates[0].Measured=product.Measured
+ }else{product.Warnings=append(product.Warnings,"mechanic_measured_anchor_unavailable")}
+ product.Warnings=uniqueSortedTokens(product.Warnings)
+ return product,product.Validate()
+}
