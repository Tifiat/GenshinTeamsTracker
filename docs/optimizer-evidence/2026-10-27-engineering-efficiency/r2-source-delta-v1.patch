+
+// ProbeStatResponses runs the predeclared baseline and perturbation calls on
+// the exact bound engine. Engines without the explicit seeded-ordinary
+// capability are rejected before creating a reservation or making any call.
+func ProbeStatResponses(ctx context.Context, bound BoundEngine, preparedConfig, managedRunRoot string, plan StatResponsePlan) (StatResponseResult, error) {
+	return runStatResponsePlan(ctx, bound, preparedConfig, managedRunRoot, plan,
+		func(ctx context.Context, configText, runDirectory string, seed int64) (OrdinaryResult, error) {
+			return bound.RunOrdinarySeeded(ctx, configText, runDirectory, seed)
+		},
+	)
+}
+
+func runStatResponsePlan(ctx context.Context, bound BoundEngine, preparedConfig, managedRunRoot string, plan StatResponsePlan, runner ordinarySeedRunner) (out StatResponseResult, retErr error) {
+	return runStatResponsePlanWithGuard(ctx, bound, preparedConfig, managedRunRoot, plan, runner, acquireResponseArtifactGuard)
+}
+
+func runStatResponsePlanWithGuard(ctx context.Context, bound BoundEngine, preparedConfig, managedRunRoot string, plan StatResponsePlan, runner ordinarySeedRunner, acquire responseArtifactGuardFactory) (out StatResponseResult, retErr error) {
+	out.ProposalEvidenceOnly = true
+	plan = cloneStatResponsePlan(plan)
+	out.Binding = StatResponseBinding{
+		AnchorConfigSHA256:         digestText(preparedConfig),
+		RequestSHA256:              plan.RequestSHA256,
+		EngineArtifactSHA256:       bound.artifactSHA256,
+		EngineBindingSHA256:        bound.bindingSHA256,
+		EngineSourceManifestSHA256: bound.sourceManifestSHA256,
+		EnginePatchManifestSHA256:  bound.patchManifestSHA256,
+	}
+	if !bound.ordinarySeed {
+		return out, fmt.Errorf("bound engine lacks %s", ordinarySeedCapability)
+	}
+	if runner == nil {
+		return out, errors.New("ordinary stat-response runner is required")
+	}
+	if len(plan.Seeds) > maxStatResponseCalls || len(plan.Perturbations) > maxStatResponseCalls-1 {
+		return out, fmt.Errorf("stat-response plan exceeds %d calls", maxStatResponseCalls)
+	}
+	if err := validateStatResponseConfig(preparedConfig); err != nil {
+		return out, err
+	}
+	plannedCalls, err := validateStatResponsePlan(plan)
+	if err != nil {
+		return out, err
+	}
+	out.ScreeningEnabled = plan.ScreenZeroFirstSeed
+	preparedSHA := digestText(preparedConfig)
+	out.PreparedConfigSHA256 = preparedSHA
+	if out.Binding.AnchorConfigSHA256 != preparedSHA {
+		return out, errors.New("stat-response anchor identity mismatch")
+	}
+
+	probeConfig, err := renderStatResponseConfig(preparedConfig, 1, 1)
+	if err != nil {
+		return out, fmt.Errorf("prepare ordinary stat-response config: %w", err)
+	}
+	out.ProbeConfigSHA256 = digestText(probeConfig)
+	perturbedConfigs, err := validateAndRenderPerturbations(probeConfig, plan.Perturbations)
+	if err != nil {
+		return out, err
+	}
+	out.CallLimit = plan.CallLimit
+	out.Baseline = make([]StatResponseSample, 0, len(plan.Seeds))
+	out.Perturbations = make([]StatResponsePerturbationResult, len(plan.Perturbations))
+	for index, perturbation := range plan.Perturbations {
+		out.Perturbations[index] = StatResponsePerturbationResult{
+			Perturbation: perturbation,
+			ConfigSHA256: digestText(perturbedConfigs[index]),
+			Samples:      make([]StatResponseSample, 0, len(plan.Seeds)),
+		}
+	}
+	guard, err := acquire(bound)
+	if err != nil {
+		return out, err
+	}
+	out.ArtifactGuardMode = guard.mode
+	fullHash := func() error {
+		out.ArtifactFullHashes++
+		return bound.VerifyUnchanged()
+	}
+	check := func() error {
+		out.ArtifactGuardChecks++
+		if guard.mode == "full_hash_fallback" {
+			out.ArtifactFullHashes++
+		}
+		return guard.check()
+	}
+	// Install immediately: initial verification, managed-root and reservation
+	// failures must release too. Final identity/full SHA checks happen WHILE
+	// the lease is held. Close errors prevent successful publication.
+	defer func() {
+		var identityErr error
+		if guard.mode != "full_hash_fallback" {
+			identityErr = check()
+		}
+		verifyErr := fullHash()
+		out.EngineUnchanged = verifyErr == nil
+		if identityErr != nil {
+			retErr = joinProbeError(retErr, fmt.Errorf("response artifact final identity: %w", identityErr))
+		}
+		if verifyErr != nil {
+			retErr = joinProbeError(retErr, fmt.Errorf("bound engine changed during stat-response stage: %w", verifyErr))
+		}
+		if closeErr := guard.close(); closeErr != nil {
+			retErr = joinProbeError(retErr, fmt.Errorf("release response artifact guard: %w", closeErr))
+		}
+		if out.RunDirectory == "" {
+			return
+		}
+		final := statResponseFinalOutcome{
+			SchemaVersion: 1, FinishedUTC: time.Now().UTC(), Status: "success",
+			AttemptedCalls: out.AttemptedCalls, SkippedCalls: out.SkippedCalls, CallLimit: out.CallLimit,
+			EngineUnchanged: out.EngineUnchanged, ArtifactGuardMode: out.ArtifactGuardMode,
+			ArtifactGuardChecks: out.ArtifactGuardChecks, ArtifactFullHashes: out.ArtifactFullHashes,
+		}
+		if retErr != nil {
+			final.Status = "failed"
+			final.Error = boundedError(retErr.Error(), maxStatResponseErrorMessage)
+		}
+		if err := writeJSONExclusive(filepath.Join(out.RunDirectory, "outcome.json"), final); err != nil {
+			retErr = joinProbeError(retErr, fmt.Errorf("write stat-response outcome: %w", err))
+		}
+	}()
+	if err := fullHash(); err != nil {
+		return out, fmt.Errorf("verify bound engine before stat-response reservation: %w", err)
+	}
+	if guard.mode != "full_hash_fallback" {
+		if err := check(); err != nil {
+			return out, fmt.Errorf("verify response artifact identity before reservation: %w", err)
+		}
+	}
+	root, err := requireManagedRunRoot(managedRunRoot)
+	if err != nil {
+		return out, err
+	}
+	runDirectory, err := os.MkdirTemp(root, "stat-response-")
+	if err != nil {
+		return out, fmt.Errorf("create isolated stat-response run directory: %w", err)
+	}
+	out.RunDirectory = runDirectory
+	reservation := statResponseReservation{
+		SchemaVersion:         1,
+		CreatedUTC:            time.Now().UTC(),
+		Binding:               out.Binding,
+		PreparedConfigSHA256:  preparedSHA,
+		ProbeConfigSHA256:     out.ProbeConfigSHA256,
+		CandidateConfigSHA256: candidateConfigHashes(probeConfig, perturbedConfigs),
+		EngineBinaryPath:      bound.binaryPath,
+		EngineArtifactSHA256:  bound.artifactSHA256,
+		SourceManifestSHA256:  bound.sourceManifestSHA256,
+		RequiredCapability:    ordinarySeedCapability,
+		Plan:                  plan,
+		PlannedCallCount:      plannedCalls,
+		ArtifactGuardMode:     out.ArtifactGuardMode,
+	}
+	if err := writeJSONExclusive(filepath.Join(runDirectory, "reservation.json"), reservation); err != nil {
+		return out, fmt.Errorf("write stat-response reservation: %w", err)
+	}
+	baselineBySeed := make(map[int64]StatResponseSample, len(plan.Seeds))
+	for _, seed := range plan.Seeds {
+		result, err := runStatResponseCallChecked(ctx, check, runDirectory, runner, out.AttemptedCalls+1, "baseline", "", "", 0, seed, probeConfig)
+		if result.attempt > out.AttemptedCalls {
+			out.AttemptedCalls = result.attempt
+		}
+		if err != nil {
+			return out, err
+		}
+		sample := sampleFromOrdinary(seed, result.result, nil)
+		out.Baseline = append(out.Baseline, sample)
+		baselineBySeed[seed] = sample
+	}
+	for index, perturbation := range plan.Perturbations {
+		for seedIndex, seed := range plan.Seeds {
+			result, err := runStatResponseCallChecked(ctx, check, runDirectory, runner, out.AttemptedCalls+1, "perturbation", perturbation.Actor, perturbation.Stat, perturbation.Delta, seed, perturbedConfigs[index])
+			if result.attempt > out.AttemptedCalls {
+				out.AttemptedCalls = result.attempt
+			}
+			if err != nil {
+				return out, err
+			}
+			base, ok := baselineBySeed[seed]
+			if !ok {
+				return out, fmt.Errorf("baseline seed %d is missing", seed)
+			}
+			sample, err := pairedSample(seed, base, result.result)
+			if err != nil {
+				return out, err
+			}
+			out.Perturbations[index].Samples = append(out.Perturbations[index].Samples, sample)
+			if plan.ScreenZeroFirstSeed && seedIndex == 0 && zeroStatResponse(sample) {
+				if err := ctx.Err(); err != nil {
+					return out, err
+				}
+				out.Perturbations[index].SecondSeedScreened = true
+				out.SkippedCalls++
+				break
+			}
+		}
+		if err := summarizePerturbation(&out.Perturbations[index]); err != nil {
+			return out, err
+		}
+	}
+	if out.AttemptedCalls+out.SkippedCalls != out.CallLimit {
+		return out, errors.New("stat-response completed call accounting mismatch")
+	}
+	return out, nil
+}
+
+func zeroStatResponse(sample StatResponseSample) bool {
+	if sample.DPSDelta != 0 || len(sample.CharacterDPSDelta) == 0 {
+		return false
+	}
+	for _, delta := range sample.CharacterDPSDelta {
+		if delta != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+type statResponseCallResult struct {
+	attempt int
+	result  OrdinaryResult
+}
+
+func runStatResponseCall(ctx context.Context, bound BoundEngine, runDirectory string, runner ordinarySeedRunner, attempt int, kind, actor, stat string, delta float64, seed int64, configText string) (statResponseCallResult, error) {
+	// Retain the original full-hash contract for direct callers and component
+	// benchmarks. Only a complete response-plan lifetime can substitute a lease.
+	return runStatResponseCallChecked(ctx, bound.VerifyUnchanged, runDirectory, runner, attempt, kind, actor, stat, delta, seed, configText)
+}
+
+func runStatResponseCallChecked(ctx context.Context, check func() error, runDirectory string, runner ordinarySeedRunner, attempt int, kind, actor, stat string, delta float64, seed int64, configText string) (statResponseCallResult, error) {
+	configSHA := digestText(configText)
+	if err := check(); err != nil {
+		return statResponseCallResult{}, fmt.Errorf("verify bound engine before call %d: %w", attempt, err)
+	}
+	call := statResponseCallRecord{Attempt: attempt, Kind: kind, Actor: actor, Stat: stat, Delta: delta, Seed: seed, ConfigSHA256: configSHA}
+	if err := appendJSONLineSync(filepath.Join(runDirectory, "attempts.jsonl"), call); err != nil {
+		return statResponseCallResult{}, fmt.Errorf("record stat-response attempt %d before call: %w", attempt, err)
+	}
+	callResult := statResponseCallResult{attempt: attempt}
+	callDirectory := filepath.Join(runDirectory, fmt.Sprintf("call-%06d", attempt))
+	ordinary, runErr := runner(ctx, configText, callDirectory, seed)
+	callResult.result = ordinary
+	engineErr := check()
+	identity, identityErr := configIdentityDiagnostics(configText, ordinary.ConfigFile)
+	if identityErr != nil {
+		runErr = joinProbeError(runErr, fmt.Errorf("stat-response config identity: %w", identityErr))
+	}
+	validationErr := validateSeededOrdinaryResult(ordinary, configText, seed)
+	if runErr == nil && validationErr != nil {
+		runErr = validationErr
+	}
+	if engineErr != nil {
+		runErr = joinProbeError(runErr, fmt.Errorf("bound engine changed after call %d: %w", attempt, engineErr))
+	}
+	configMatched := identityErr == nil && identity.Matched && ordinary.ConfigSHA256 == identity.SubmittedSHA256
+	outcome := statResponseCallOutcome{
+		Attempt:               attempt,
+		Seed:                  seed,
+		ConfigSHA256:          configSHA,
+		ConfigIdentity:        identity,
+		ResultSHA256:          ordinary.EngineResultSHA256,
+		SampleSeed:            ordinary.SampleSeed,
+		ConfigMatched:         configMatched,
+		Iterations:            ordinary.Iterations,
+		DPS:                   ordinary.DPS,
+		StandardDeviation:     ordinary.StandardDeviation,
+		StandardError:         ordinary.StandardError,
+		ElapsedMS:             ordinary.ElapsedMS,
+		InsufficientEnergyMax: ordinary.InsufficientEnergyMax,
+		CharacterDPS:          ordinary.CharacterDPS,
+		NumberOfWorkers:       ordinary.NumberOfWorkers,
+	}
+	if runErr != nil {
+		outcome.Error = boundedError(runErr.Error(), maxStatResponseErrorMessage)
+	}
+	if recordErr := appendJSONLineSync(filepath.Join(runDirectory, "outcomes.jsonl"), outcome); recordErr != nil {
+		runErr = joinProbeError(runErr, fmt.Errorf("record stat-response outcome %d: %w", attempt, recordErr))
+	}
+	if runErr != nil {
+		return callResult, fmt.Errorf("stat-response %s call %d failed: %w", kind, attempt, runErr)
+	}
+	return callResult, nil
+}
+
+func validateSeededOrdinaryResult(result OrdinaryResult, configText string, seed int64) error {
+	if err := validateSeededOrdinaryIdentity(result, configText, seed); err != nil {
+		return err
+	}
+	if !finiteNonnegative(result.DPS) || !finiteNonnegative(result.StandardDeviation) || !finiteNonnegative(result.StandardError) || !finiteNonnegative(result.ElapsedMS) || !finiteNonnegative(result.InsufficientEnergyMax) {
+		return fmt.Errorf("ordinary response contains invalid DPS, error, elapsed, or energy values")
+	}
+	if _, err := hex.DecodeString(result.EngineResultSHA256); err != nil || len(result.EngineResultSHA256) != 64 {
+		return fmt.Errorf("ordinary response result digest is invalid")
+	}
+	if len(result.CharacterDPS) == 0 {
+		return fmt.Errorf("ordinary response lacks character DPS")
+	}
+	for name, dps := range result.CharacterDPS {
+		if strings.TrimSpace(name) == "" || strings.TrimSpace(name) != name || !finiteNonnegative(dps) {
+			return fmt.Errorf("ordinary response has invalid character DPS")
+		}
+	}
+	return nil
+}
+
+func sampleFromOrdinary(seed int64, result OrdinaryResult, base *StatResponseSample) StatResponseSample {
+	sample := StatResponseSample{
+		Seed:                  seed,
+		SampleSeed:            result.SampleSeed,
+		Iterations:            result.Iterations,
+		DPS:                   result.DPS,
+		StandardDeviation:     result.StandardDeviation,
+		StandardError:         result.StandardError,
+		ElapsedMS:             result.ElapsedMS,
+		CharacterDPS:          cloneDPSMap(result.CharacterDPS),
+		ConfigSHA256:          result.ConfigSHA256,
+		EngineResultSHA256:    result.EngineResultSHA256,
+		InsufficientEnergyMax: result.InsufficientEnergyMax,
+	}
+	if base != nil {
+		sample.DPSDelta = result.DPS - base.DPS
+		sample.CharacterDPSDelta = make(map[string]float64, len(result.CharacterDPS))
+		for name, dps := range result.CharacterDPS {
+			sample.CharacterDPSDelta[name] = dps - base.CharacterDPS[name]
+		}
+	}
+	return sample
+}
+
+func pairedSample(seed int64, base StatResponseSample, result OrdinaryResult) (StatResponseSample, error) {
+	if len(base.CharacterDPS) == 0 || len(result.CharacterDPS) != len(base.CharacterDPS) {
+		return StatResponseSample{}, fmt.Errorf("ordinary response character DPS counts are ambiguous for seed %d", seed)
+	}
+	for name := range base.CharacterDPS {
+		if _, ok := result.CharacterDPS[name]; !ok {
+			return StatResponseSample{}, fmt.Errorf("ordinary response character set changed for seed %d", seed)
+		}
+	}
+	sample := sampleFromOrdinary(seed, result, &base)
+	if !finiteSigned(sample.DPSDelta) {
+		return StatResponseSample{}, fmt.Errorf("ordinary response DPS delta is non-finite for seed %d", seed)
+	}
+	for _, delta := range sample.CharacterDPSDelta {
+		if !finiteSigned(delta) {
+			return StatResponseSample{}, fmt.Errorf("ordinary response character DPS delta is non-finite for seed %d", seed)
+		}
+	}
+	return sample, nil
+}
+
+func summarizePerturbation(result *StatResponsePerturbationResult) error {
+	if result == nil || len(result.Samples) == 0 {
+		return errors.New("ordinary response perturbation has no samples")
+	}
+	characterTotals := make(map[string]float64)
+	dpsTotal := 0.0
+	for _, sample := range result.Samples {
+		dpsTotal += sample.DPSDelta
+		if !finiteSigned(dpsTotal) {
+			return errors.New("ordinary response DPS mean overflowed")
+		}
+		for name, delta := range sample.CharacterDPSDelta {
+			characterTotals[name] += delta
+			if !finiteSigned(characterTotals[name]) {
+				return fmt.Errorf("ordinary response character DPS mean overflowed for %q", name)
+			}
+		}
+	}
+	count := float64(len(result.Samples))
+	result.MeanDPSDelta = dpsTotal / count
+	result.MeanCharacterDPSDelta = make(map[string]float64, len(characterTotals))
+	for name, total := range characterTotals {
+		result.MeanCharacterDPSDelta[name] = total / count
+	}
+	return nil
+}
+
+func validateStatResponsePlan(plan StatResponsePlan) (int, error) {
+	if plan.RequestSHA256 != "" {
+		digest, err := hex.DecodeString(plan.RequestSHA256)
+		if err != nil || len(digest) != sha256.Size || hex.EncodeToString(digest) != plan.RequestSHA256 {
+			return 0, errors.New("stat-response request SHA-256 is invalid")
+		}
+	}
+	if len(plan.Seeds) == 0 || len(plan.Perturbations) == 0 {
+		return 0, errors.New("stat-response plan requires seeds and perturbations")
+	}
+	if plan.ScreenZeroFirstSeed && len(plan.Seeds) != 2 {
+		return 0, errors.New("zero-first-seed screening requires exactly two seeds")
+	}
+	if len(plan.Perturbations) > maxStatResponseCalls-1 {
+		return 0, fmt.Errorf("stat-response plan exceeds %d perturbations", maxStatResponseCalls-1)
+	}
+	factor := 1 + len(plan.Perturbations)
+	if len(plan.Seeds) > maxStatResponseCalls/factor {
+		return 0, fmt.Errorf("stat-response plan exceeds %d calls", maxStatResponseCalls)
+	}
+	seenSeeds := make(map[int64]bool, len(plan.Seeds))
+	for _, seed := range plan.Seeds {
+		if seed <= 0 || seenSeeds[seed] {
+			return 0, errors.New("stat-response seeds must be unique positive int64 values")
+		}
+		seenSeeds[seed] = true
+	}
+	seenPerturbations := make(map[string]bool, len(plan.Perturbations))
+	for _, perturbation := range plan.Perturbations {
+		if len(perturbation.Actor) == 0 || len(perturbation.Actor) > maxStatResponseActorName || !configActorName.MatchString(perturbation.Actor) {
+			return 0, fmt.Errorf("invalid stat-response actor %q", perturbation.Actor)
+		}
+		if len(perturbation.Stat) == 0 || len(perturbation.Stat) > maxStatResponseStatName || !statName.MatchString(perturbation.Stat) || !knownResponseStats[perturbation.Stat] {
+			return 0, fmt.Errorf("unsupported stat-response stat %q", perturbation.Stat)
+		}
+		if math.IsNaN(perturbation.Delta) || math.IsInf(perturbation.Delta, 0) || perturbation.Delta == 0 {
+			return 0, fmt.Errorf("stat-response delta for %s.%s must be finite and nonzero", perturbation.Actor, perturbation.Stat)
+		}
+		if plan.ScreenZeroFirstSeed && perturbation.Delta < 0 {
+			return 0, errors.New("zero-first-seed screening requires positive perturbation deltas")
+		}
+		key := perturbation.Actor + "\x00" + perturbation.Stat + "\x00" + strconv.FormatFloat(perturbation.Delta, 'g', -1, 64)
+		if seenPerturbations[key] {
+			return 0, fmt.Errorf("duplicate stat-response perturbation %s.%s %+g", perturbation.Actor, perturbation.Stat, perturbation.Delta)
+		}
+		seenPerturbations[key] = true
+	}
+	planned := len(plan.Seeds) * (1 + len(plan.Perturbations))
+	if planned <= 0 || planned > maxStatResponseCalls || plan.CallLimit != planned {
+		return 0, fmt.Errorf("stat-response call limit %d must exactly equal the fixed plan size %d (maximum %d)", plan.CallLimit, planned, maxStatResponseCalls)
+	}
+	return planned, nil
+}
+
+func validateAndRenderPerturbations(baseConfig string, perturbations []StatResponsePerturbation) ([]string, error) {
+	declaredActors := make(map[string]int)
+	statsByActor := make(map[string][]string)
+	for _, line := range splitConfigLines(baseConfig) {
+		trimmed := strings.TrimSpace(line.content)
+		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
+			continue
+		}
+		if match := charDeclaration.FindStringSubmatch(line.content); match != nil {
+			declaredActors[match[1]]++
+		}
+		if match := statsDeclaration.FindStringSubmatch(line.content); match != nil {
+			statsByActor[match[1]] = append(statsByActor[match[1]], match[2])
+		}
+	}
+	configs := make([]string, len(perturbations))
+	for index, perturbation := range perturbations {
+		if declaredActors[perturbation.Actor] != 1 {
+			return nil, fmt.Errorf("stat-response actor %q is unknown or ambiguous", perturbation.Actor)
+		}
+		rows := statsByActor[perturbation.Actor]
+		if len(rows) == 0 {
+			return nil, fmt.Errorf("stat-response actor %q has no existing stats declaration", perturbation.Actor)
+		}
+		for _, row := range rows {
+			if _, err := parseStatsInput(row, perturbation.Actor, perturbation.Stat); err != nil {
+				return nil, err
+			}
+		}
+		if isFlatInput(perturbation.Stat) {
+			current := 0.0
+			for _, row := range rows {
+				value, err := parseStatsInput(row, perturbation.Actor, perturbation.Stat)
+				if err != nil {
+					return nil, err
+				}
+				current += value
+			}
+			if !finiteSigned(current+perturbation.Delta) || current+perturbation.Delta < 0 {
+				return nil, fmt.Errorf("stat-response delta makes %s.%s flat input negative", perturbation.Actor, perturbation.Stat)
+			}
+		}
+		configs[index] = appendStatResponseRow(baseConfig, perturbation)
+	}
+	return configs, nil
+}
+
+func renderStatResponseConfig(preparedConfig string, iterations, workers int) (string, error) {
+	if iterations != 1 || workers != 1 {
+		return "", errors.New("stat-response diagnostics require one iteration and one worker")
+	}
+	lines := splitConfigLines(preparedConfig)
+	optionsIndexes := make([]int, 0, 1)
+	for index, line := range lines {
+		trimmed := strings.TrimLeft(line.content, " \t")
+		if strings.HasPrefix(trimmed, "options") && (len(trimmed) == len("options") || trimmed[len("options")] == ' ' || trimmed[len("options")] == '\t' || trimmed[len("options")] == ';') {
+			optionsIndexes = append(optionsIndexes, index)
+		}
+	}
+	if len(optionsIndexes) != 1 {
+		return "", fmt.Errorf("prepared config must contain exactly one options line; found %d", len(optionsIndexes))
+	}
+	index := optionsIndexes[0]
+	line := lines[index]
+	updated, err := normalizeOptionsLine(line.content)
+	if err != nil {
+		return "", err
+	}
+	var builder strings.Builder
+	for lineIndex, current := range lines {
+		if lineIndex == index {
+			builder.WriteString(updated)
+		} else {
+			builder.WriteString(current.content)
+		}
+		builder.WriteString(current.ending)
+	}
+	return builder.String(), nil
+}
+
+func normalizeOptionsLine(line string) (string, error) {
+	leading := len(line) - len(strings.TrimLeft(line, " \t"))
+	if !strings.HasPrefix(line[leading:], "options") {
+		return "", errors.New("malformed options line")
+	}
+	keywordEnd := leading + len("options")
+	if keywordEnd < len(line) && line[keywordEnd] != ' ' && line[keywordEnd] != '\t' && line[keywordEnd] != ';' {
+		return "", errors.New("malformed options keyword")
+	}
+	semicolon := strings.IndexByte(line[keywordEnd:], ';')
+	if semicolon < 0 {
+		return "", errors.New("options line is missing a semicolon")
+	}
+	semicolon += keywordEnd
+	remainder := strings.TrimSpace(line[semicolon+1:])
+	if remainder != "" && !strings.HasPrefix(remainder, "#") {
+		return "", errors.New("unexpected content after options semicolon")
+	}
+	body := line[keywordEnd:semicolon]
+	tokenIndexes := regexp.MustCompile(`\S+`).FindAllStringIndex(body, -1)
+	seen := make(map[string]bool)
+	targets := map[string]bool{"iteration": false, "workers": false}
+	var replacements []textReplacement
+	for _, span := range tokenIndexes {
+		token := body[span[0]:span[1]]
+		if strings.HasPrefix(token, "#") {
+			return "", errors.New("options comments must follow the semicolon")
+		}
+		equals := strings.IndexByte(token, '=')
+		if equals <= 0 || equals == len(token)-1 || strings.Count(token, "=") != 1 {
+			return "", fmt.Errorf("malformed options token %q", token)
+		}
+		key, value := token[:equals], token[equals+1:]
+		if !optionName.MatchString(key) {
+			return "", fmt.Errorf("malformed options key %q", key)
+		}
+		lowerKey := strings.ToLower(key)
+		if seen[lowerKey] {
+			return "", fmt.Errorf("duplicate options key %q", key)
+		}
+		seen[lowerKey] = true
+		if lowerKey == "seed" {
+			return "", errors.New("seed must be supplied through the bound ordinary-seed capability, not config options")
+		}
+		if lowerKey == "iteration" || lowerKey == "workers" {
+			parsed, err := strconv.Atoi(value)
+			if err != nil || parsed <= 0 {
+				return "", fmt.Errorf("options %s must be a positive integer", lowerKey)
+			}
+			targets[lowerKey] = true
+			replacements = append(replacements, textReplacement{start: span[0] + equals + 1, end: span[1], value: "1"})
+		}
+	}
+	updatedBody := applyTextReplacements(body, replacements)
+	var missing []string
+	if !targets["iteration"] {
+		missing = append(missing, "iteration=1")
+	}
+	if !targets["workers"] {
+		missing = append(missing, "workers=1")
+	}
+	if len(missing) > 0 {
+		if updatedBody != "" && !strings.HasSuffix(updatedBody, " ") && !strings.HasSuffix(updatedBody, "\t") {
+			updatedBody += " "
+		}
+		updatedBody += strings.Join(missing, " ")
+	}
+	return line[:keywordEnd] + updatedBody + line[semicolon:], nil
+}
+
+type textReplacement struct {
+	start int
+	end   int
+	value string
+}
+
+func applyTextReplacements(source string, replacements []textReplacement) string {
+	if len(replacements) == 0 {
+		return source
+	}
+	var builder strings.Builder
+	last := 0
+	for _, replacement := range replacements {
+		builder.WriteString(source[last:replacement.start])
+		builder.WriteString(replacement.value)
+		last = replacement.end
+	}
+	builder.WriteString(source[last:])
+	return builder.String()
+}
+
+func parseStatsInput(row, actor, requestedStat string) (float64, error) {
+	total := 0.0
+	seen := make(map[string]bool)
+	for _, token := range strings.Fields(row) {
+		equals := strings.IndexByte(token, '=')
+		if equals <= 0 || equals == len(token)-1 || strings.Count(token, "=") != 1 {
+			return 0, fmt.Errorf("malformed existing stats row for actor %q", actor)
+		}
+		key, rawValue := token[:equals], token[equals+1:]
+		if !statName.MatchString(key) || seen[key] {
+			return 0, fmt.Errorf("ambiguous existing stats row for actor %q", actor)
+		}
+		seen[key] = true
+		value, err := strconv.ParseFloat(rawValue, 64)
+		if err != nil || math.IsNaN(value) || math.IsInf(value, 0) {
+			return 0, fmt.Errorf("invalid existing stats value for actor %q", actor)
+		}
+		if key == requestedStat {
+			total += value
+			if !finiteSigned(total) {
+				return 0, fmt.Errorf("existing stats overflow for actor %q", actor)
+			}
+		}
+	}
+	return total, nil
+}
+
+func appendStatResponseRow(config string, perturbation StatResponsePerturbation) string {
+	lines := splitConfigLines(config)
+	lastStats := -1
+	for index, line := range lines {
+		match := statsDeclaration.FindStringSubmatch(line.content)
+		if match != nil && match[1] == perturbation.Actor {
+			lastStats = index
+		}
+	}
+	if lastStats < 0 {
+		return config
+	}
+	line := lines[lastStats]
+	row := fmt.Sprintf("%s add stats %s=%s;", perturbation.Actor, perturbation.Stat, strconv.FormatFloat(perturbation.Delta, 'g', -1, 64))
+	var insertion string
+	if line.ending != "" {
+		insertion = row + line.ending
+	} else {
+		insertion = lineSeparator(config) + row
+	}
+	position := line.start + len(line.content) + len(line.ending)
+	return config[:position] + insertion + config[position:]
+}
+
+func validateStatResponseConfig(config string) error {
+	if len(config) == 0 || len(config) > maxStatResponseConfigBytes {
+		return fmt.Errorf("prepared config size must be between 1 and %d bytes", maxStatResponseConfigBytes)
+	}
+	if _, err := expectedEngineConfigText(config); err != nil {
+		return fmt.Errorf("prepared config cannot be bound to exact engine identity: %w", err)
+	}
+	return nil
+}
+
+func cloneStatResponsePlan(plan StatResponsePlan) StatResponsePlan {
+	cloned := StatResponsePlan{
+		RequestSHA256:       plan.RequestSHA256,
+		Seeds:               append([]int64(nil), plan.Seeds...),
+		Perturbations:       append([]StatResponsePerturbation(nil), plan.Perturbations...),
+		CallLimit:           plan.CallLimit,
+		ScreenZeroFirstSeed: plan.ScreenZeroFirstSeed,
+	}
+	return cloned
+}
+
+func splitConfigLines(config string) []configLine {
+	lines := make([]configLine, 0, strings.Count(config, "\n")+1)
+	for start := 0; start < len(config); {
+		end := strings.IndexByte(config[start:], '\n')
+		if end < 0 {
+			lines = append(lines, configLine{start: start, content: config[start:]})
+			break
+		}
+		end += start
+		contentEnd := end
+		ending := "\n"
+		if contentEnd > start && config[contentEnd-1] == '\r' {
+			contentEnd--
+			ending = "\r\n"
+		}
+		lines = append(lines, configLine{start: start, content: config[start:contentEnd], ending: ending})
+		start = end + 1
+	}
+	if len(config) == 0 {
+		return nil
+	}
+	if strings.HasSuffix(config, "\n") {
+		lines = append(lines, configLine{start: len(config)})
+	}
+	return lines
+}
+
+func lineSeparator(config string) string {
+	if strings.Contains(config, "\r\n") {
+		return "\r\n"
+	}
+	return "\n"
+}
+
+func requireManagedRunRoot(root string) (string, error) {
+	if strings.TrimSpace(root) == "" {
+		return "", errors.New("caller-owned managed run root is required")
+	}
+	absolute, err := filepath.Abs(root)
+	if err != nil {
+		return "", fmt.Errorf("resolve managed run root: %w", err)
+	}
+	info, err := os.Stat(absolute)
+	if err != nil {
+		return "", fmt.Errorf("read managed run root: %w", err)
+	}
+	if !info.IsDir() {
+		return "", errors.New("managed run root must be a directory")
+	}
+	return absolute, nil
+}
+
+func writeJSONExclusive(path string, value any) error {
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	encoder := json.NewEncoder(file)
+	encoder.SetEscapeHTML(false)
+	encodeErr := encoder.Encode(value)
+	syncErr := file.Sync()
+	closeErr := file.Close()
+	return errors.Join(encodeErr, syncErr, closeErr)
+}
+
+func appendJSONLineSync(path string, value any) error {
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	encoder := json.NewEncoder(file)
+	encoder.SetEscapeHTML(false)
+	encodeErr := encoder.Encode(value)
+	syncErr := file.Sync()
+	closeErr := file.Close()
+	return errors.Join(encodeErr, syncErr, closeErr)
+}
+
+func digestText(text string) string {
+	digest := sha256.Sum256([]byte(text))
+	return hex.EncodeToString(digest[:])
+}
+
+func candidateConfigHashes(baseline string, candidates []string) []string {
+	hashes := make([]string, 1, len(candidates)+1)
+	hashes[0] = digestText(baseline)
+	for _, candidate := range candidates {
+		hashes = append(hashes, digestText(candidate))
+	}
+	return hashes
+}
+
+func cloneDPSMap(source map[string]float64) map[string]float64 {
+	if source == nil {
+		return nil
+	}
+	clone := make(map[string]float64, len(source))
+	for name, dps := range source {
+		clone[name] = dps
+	}
+	return clone
+}
+
+func finiteNonnegative(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0) && value >= 0
+}
+
+func finiteSigned(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func isFlatInput(stat string) bool {
+	return stat == "hp" || stat == "atk" || stat == "def"
+}
+
+func boundedError(message string, limit int) string {
+	if len(message) <= limit {
+		return message
+	}
+	return message[:limit] + "..."
+}
+
+func joinProbeError(first, second error) error {
+	if first == nil {
+		return second
+	}
+	return errors.Join(first, second)
+}
