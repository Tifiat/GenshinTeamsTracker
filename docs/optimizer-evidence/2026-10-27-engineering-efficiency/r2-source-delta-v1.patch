+	if err := prepared.Request.Validate(); err != nil {
+		t.Fatalf("prepared request is invalid: %v", err)
+	}
+	if prepared.OriginalConfigSHA256 != contracts.TextSHA256(configText) || prepared.PreparedConfigSHA256 != prepared.Request.Context.PreparedConfig.SHA256 {
+		t.Fatal("prepared config hashes do not match their exact source text")
+	}
+	if prepared.DeclarationOrder != [4]string{"actor_d", "actor_b", "actor_a", "actor_c"} {
+		t.Fatalf("source declaration order changed: %v", prepared.DeclarationOrder)
+	}
+	wantRequestOrder := []string{"actor_a", "actor_b", "actor_c", "actor_d"}
+	for index, wearer := range prepared.Request.Wearers {
+		if wearer.WearerKey != wantRequestOrder[index] {
+			t.Fatalf("request wearer order = %v, want %v", wearerKeys(prepared.Request), wantRequestOrder)
+		}
+	}
+	if got, want := prepared.Request.Context.Rotation.Text, "actor_d skill;\nactor_a burst;\n"; got != want {
+		t.Fatalf("rotation tail changed: %q want %q", got, want)
+	}
+	if prepared.Request.Budgets.ProductTimeoutMS != 0 || prepared.Request.Budgets.DevelopmentTimeoutMS != 0 ||
+		prepared.Request.ResultOptions == nil || prepared.Request.ResultOptions.FastMode {
+		t.Fatal("synthetic request must have explicit non-fast options and no product timeout")
+	}
+	if prepared.Request.Stochastic.Seeds[0] != 101 || prepared.Request.Stochastic.Seeds[1] != 202 {
+		t.Fatalf("seed panel was rewritten: %v", prepared.Request.Stochastic.Seeds)
+	}
+
+	configOut := prepared.Request.Context.PreparedConfig.Text
+	if got := countLinePrefix(configOut, "options "); got != 1 {
+		t.Fatalf("rendered config has %d options rows, want one", got)
+	}
+	optionLine := lineWithPrefix(configOut, "options ")
+	if !strings.Contains(optionLine, "ignore_burst_energy=true") || !strings.Contains(optionLine, "iteration=1") || !strings.Contains(optionLine, "workers=1") {
+		t.Fatalf("ordinary anchor options are not bounded infinite-energy n=1/workers=1: %q", optionLine)
+	}
+	for _, actor := range wantRequestOrder {
+		if got := countLinePrefix(configOut, actor+" add stats "); got != 1 {
+			t.Fatalf("%s has %d rendered stats rows, want one", actor, got)
+		}
+		statsLine := lineWithPrefix(configOut, actor+" add stats ")
+		fields := strings.Fields(strings.TrimSuffix(strings.TrimPrefix(statsLine, actor+" add stats "), ";"))
+		keys := map[string]bool{}
+		for _, field := range fields {
+			key, _, ok := strings.Cut(field, "=")
+			if !ok || keys[key] {
+				t.Fatalf("%s anchor stats row has malformed or duplicate stat %q", actor, field)
+			}
+			keys[key] = true
+		}
+	}
+	if got := countLinePrefix(configOut, "actor_a add set="); got != 2 {
+		t.Fatalf("2+2+1 actor has %d active set rows, want exactly two", got)
+	}
+	if strings.Contains(configOut, `actor_a add set="set_flex"`) {
+		t.Fatal("single-piece flex set row left an obsolete set declaration")
+	}
+	if got := strings.Count(configOut, "actor_d char "); got != 1 || strings.Index(configOut, "actor_d char ") > strings.Index(configOut, "actor_b char ") {
