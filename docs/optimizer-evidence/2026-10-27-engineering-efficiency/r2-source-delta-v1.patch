+func TestCompileZeroCapacityResourceFeasibilityUnavailable(t *testing.T) {
+	index, err := domain.Build(energyRequest(t), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, withBurst := range []bool{false, true} {
+		t.Run(fmt.Sprintf("burst_%t", withBurst), func(t *testing.T) {
+			ledger := &contracts.IREnergyLedger{Events: []contracts.IREnergyEvent{}, UncertaintyCodes: []string{}}
+			for actor, wearer := range index.Wearers {
+				state := contracts.IREnergyCharacterState{CharacterIndex: actor, CharacterKey: wearer.WearerKey, Energy: "60", EnergyMax: "60"}
+				if actor == 0 {
+					state.Energy, state.EnergyMax = "0", "0"
+				}
+				ledger.InitialStates = append(ledger.InitialStates, state)
+			}
+			if withBurst {
+				ledger.Events = append(ledger.Events, contracts.IREnergyEvent{CharacterIndex: 0, CharacterKey: index.Wearers[0].WearerKey,
+					Kind: "burst", Source: "synthetic-burst", EnergyBefore: "0", EnergyAfter: "0", EnergyMax: "0", Amount: "0"})
+			}
+			model, err := Compile(index, []contracts.IRSeedMember{{EnergyLedger: ledger}})
+			if model != nil || err == nil || !strings.Contains(err.Error(), "finite_energy_resource_feasibility_unavailable") {
+				t.Fatalf("zero ordinary-energy capacity must not prove cost-free resource feasibility: model=%#v error=%v", model, err)
+			}
+		})
+	}
+}
+
+func TestCompileRejectsInvalidOrdinaryEnergyBounds(t *testing.T) {
+	index, err := domain.Build(energyRequest(t), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, bounds := range [][2]string{{"1", "0"}, {"-1", "60"}, {"0", "-1"}, {"0", "NaN"}, {"0", "+Inf"}, {"61", "60"}} {
+		t.Run(bounds[0]+"_of_"+bounds[1], func(t *testing.T) {
+			ledger := &contracts.IREnergyLedger{Events: []contracts.IREnergyEvent{}, UncertaintyCodes: []string{}}
+			for actor, wearer := range index.Wearers {
+				ledger.InitialStates = append(ledger.InitialStates, contracts.IREnergyCharacterState{
+					CharacterIndex: actor, CharacterKey: wearer.WearerKey, Energy: "60", EnergyMax: "60"})
+			}
+			ledger.InitialStates[0].Energy, ledger.InitialStates[0].EnergyMax = bounds[0], bounds[1]
+			if model, err := Compile(index, []contracts.IRSeedMember{{EnergyLedger: ledger}}); err == nil || model != nil {
+				t.Fatalf("invalid ordinary-energy bounds accepted: model=%#v error=%v", model, err)
+			}
+		})
+	}
+}
+
+func energyRequest(t *testing.T) contracts.OptimizerRequest {
+	t.Helper()
+	_, filename, _, _ := runtime.Caller(0)
+	path := filepath.Join(filepath.Dir(filename), "..", "..", "..", "..", "tests", "fixtures", "gcsim_optimizer_go_v1", "request_v1.json")
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request, err := contracts.DecodeRequest(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return request
+}
+
+func decimalText(value float64) string {
+	return fmt.Sprintf("%.12g", value)
+}
