+package main
+
+import (
+ "context"
+ "encoding/json"
+ "genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+ "genshinteamstracker/native/gcsim_optimizer/internal/seteffects"
+)
+
+type mechanicSourceKey struct{}
+
+func marshalMechanicReceipt(payload any,report map[string]any)([]byte,error){
+ raw,err:=json.Marshal(payload);if err!=nil{return nil,err}
+ var fields map[string]json.RawMessage
+ if err=json.Unmarshal(raw,&fields);err!=nil{return nil,err}
+ fields["mechanics"],err=json.Marshal(report);if err!=nil{return nil,err}
+ return json.MarshalIndent(fields,"","  ")
+}
+
+// Selected shares the immutable compiler/cache. Its existing full-set capture
+// remains its bound formula; static discovery is never an execution proof.
+func prepareSelectedMechanicSources(ctx context.Context,req contracts.OptimizerRequest)(*seteffects.SourceCatalog,error){
+ sourcePath,_:=ctx.Value(mechanicSourceKey{}).(string)
+ if sourcePath==""{return nil,nil} // historical saved-panel tools
+ bundle,err:=readSourceBundle(sourcePath);if err!=nil{return nil,err}
+ current:=map[int64]bool{}
+ for _,wearer:=range req.Wearers{for _,artifact:=range wearer.CurrentArtifacts{current[artifact.ArtifactID]=true}}
+ artifacts:=[]contracts.Artifact{}
+ for _,artifact:=range req.Artifacts{if current[artifact.ArtifactID]{artifacts=append(artifacts,artifact)}}
+ return seteffects.CompileSourceBundleCached(bundle,req.Engine,bundle.CatalogSHA256,artifacts,true,configuredRuleCache())
+}
diff --git a/cmd/gtt-optimizer/mechanic_theory.go b/cmd/gtt-optimizer/mechanic_theory.go
new file mode 100644
--- /dev/null
+++ b/cmd/gtt-optimizer/mechanic_theory.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/finalists"
+	"genshinteamstracker/native/gcsim_optimizer/internal/mechanicpolicy"
+	"genshinteamstracker/native/gcsim_optimizer/internal/seteffects"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theory"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theorypackages"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theorysearch"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theoryverify"
+)
+
+const theoryMeasuredFallbackKind = "gtt_gcsim_optimizer_theory_measured_fallback_v1"
+
+// This terminal branch has no formula candidate. The ordinary anchor is
+// measured once from a validated Witness45 and concrete allowed packages.
+// Its distinct schema prevents a synthetic zero from entering formula UI.
+type theoryMeasuredFallbackResult struct {
+	SchemaVersion  int                            `json:"schema_version"`
+	SchemaKind     string                         `json:"schema_kind"`
+	Status         string                         `json:"status"`
+	RequestSHA256  string                         `json:"request_sha256"`
+	ModelAccuracy  string                         `json:"model_accuracy"`
+	SearchCoverage string                         `json:"search_coverage"`
+	OrdinaryPolicy map[string]any                 `json:"ordinary_policy"`
+	MeasuredAnchor *MeasuredOnlyFullBuildAnchor   `json:"measured_anchor"`
+	Packages       []theorysearch.PackageRow      `json:"packages"`
+	Allocations    []theory.WearerAllocation      `json:"allocations"`
+	SearchFailure  theorysearch.FailureDiagnostic `json:"search_failure"`
+	MechanicReport map[string]any                 `json:"mechanic_report"`
+	Warnings       []string                       `json:"warnings"`
+}
+
+func theoryFallbackCodes(diagnostic theorysearch.FailureDiagnostic, boundary *mechanicpolicy.ModelUnavailableError) []string {
+	seen := map[string]bool{}
+	out := []string{}
+	if boundary != nil {
+		for _, code := range boundary.Codes {
+			if code == "" || seen[code] {
+				continue
+			}
+			seen[code] = true
+			out = append(out, code)
+			if len(out) >= 32 {
+				return out
+			}
+		}
+	}
+	for _, row := range diagnostic.Unavailable {
+		for _, code := range row.Reasons {
+			if code == "" || seen[code] {
+				continue
+			}
+			seen[code] = true
+			out = append(out, code)
+			if len(out) >= 32 {
+				return out
+			}
+		}
+	}
+	return out
+}
+
+func theoryFallbackCandidate(cfg theorysearch.Config, frameSHA, contextSHA string, codes []string) (finalists.FullBuildCandidate, error) {
+	rows := make([]theorysearch.PackageRow, 4)
+	for actor, pack := range cfg.Original {
+		if err := pack.Validate(); err != nil {
+			return finalists.FullBuildCandidate{}, err
+		}
+		rows[actor] = theorysearch.PackageRow{WearerKey: cfg.Wearers[actor], Sets: append([]contracts.SetRequirement(nil), pack.Sets...)}
+	}
+	alias := theorysearch.Alias{TupleKey: theorypackages.Key(cfg.Original), Packages: rows, ContextSHA256: contextSHA, Uncertainty: append([]string(nil), codes...)}
+	origin := finalists.FullBuildOrigin{Kind: "mechanic_model_unavailable", Phase: "initial", Family: "unavailable", ContextSHA256: contextSHA, DiagnosticCodes: append([]string(nil), codes...)}
+	internal, err := theoryverify.NewCandidate(frameSHA, cfg.Initial, alias, 0, []finalists.FullBuildOrigin{origin}, 0)
+	if err != nil {
+		return finalists.FullBuildCandidate{}, err
+	}
+	return internal.Build, nil
+}
+
+func theoryMeasuredFallback(ctx context.Context, raw contracts.OptimizerRequest, cfg theorysearch.Config, policy theoryverify.Policy, archive *theoryverify.Archive, renderer finalists.FullBuildRenderer, sources *seteffects.SourceCatalog, diagnostic theorysearch.FailureDiagnostic, boundary *mechanicpolicy.ModelUnavailableError, bound []contracts.BoundMechanicBoundary, runRoot string, finishedEarly bool) (theoryMeasuredFallbackResult, error) {
+	var out theoryMeasuredFallbackResult
+	if diagnostic.UnavailableTotal <= 0 || diagnostic.ResolvedAliasCount != 0 || boundary == nil || boundary.Kind != mechanicpolicy.ModelUnavailable || archive == nil || renderer == nil || sources == nil {
+		return out, fmt.Errorf("Theory measured fallback requires an all-unavailable source model")
+	}
+	if err := ctx.Err(); err != nil {
+		return out, err
+	}
+	codes := theoryFallbackCodes(diagnostic, boundary)
+	allocations, allocationErr := theorysearch.AllocationsForWitness(cfg.Initial, cfg.Wearers)
+	if allocationErr != nil {
+		return out, allocationErr
+	}
+	packages := make([]theorysearch.PackageRow, 4)
+	for actor, pack := range cfg.Original {
+		packages[actor] = theorysearch.PackageRow{WearerKey: cfg.Wearers[actor], Sets: append([]contracts.SetRequirement(nil), pack.Sets...)}
+	}
+	decision := mechanicpolicy.Decide(mechanicpolicy.Request{Failure: mechanicpolicy.ModelUnavailable, FastMode: raw.EffectiveResultOptions().FastMode, FinishedEarly: finishedEarly, RemainingOrdinarySlots: policy.Limit, HasLegalAnchor: true})
+	out = theoryMeasuredFallbackResult{SchemaVersion: 1, SchemaKind: theoryMeasuredFallbackKind, Status: "partial", RequestSHA256: cfg.RequestSHA256, ModelAccuracy: "unavailable", SearchCoverage: decision.SearchCoverage,
+		Packages: packages, Allocations: allocations,
+		OrdinaryPolicy: map[string]any{"limit": policy.Limit, "iterations": policy.Iterations, "spent_slots": 0, "decision": decision.Reason},
+		SearchFailure:  diagnostic, MechanicReport: sources.MechanicReport(bound), Warnings: []string{"mechanic_model_unavailable", "theory_search_incomplete"}}
+	if !decision.VerifyOrdinary {
+		out.Warnings = append(out.Warnings, "measured_anchor_unavailable")
+		return out, nil
+	}
+	build, err := theoryFallbackCandidate(cfg, archive.FrameSHA256(), raw.Context.ContextSHA256, codes)
+	if err != nil {
+		return out, err
+	}
+	measured, err := verifyFullBuildMechanicFallback(ctx, raw, decision, build, renderer, runRoot, policy.Iterations, codes)
+	if err != nil {
+		return out, err
+	}
+	if measured == nil {
+		return out, errors.New("Theory ordinary anchor was reserved but not measured")
+	}
+	out.MeasuredAnchor = measured
+	out.OrdinaryPolicy["spent_slots"] = 1
+	return out, nil
+}
