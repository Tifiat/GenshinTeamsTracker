+package supportimpact
+
+import (
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+)
+
+func zeroScreenFixture() engineclient.StatResponseResult {
+	r := responseFixture()
+	r.ScreeningEnabled, r.SkippedCalls, r.AttemptedCalls = true, 1, 3
+	row := &r.Perturbations[0]
+	row.SecondSeedScreened = true
+	row.Samples = row.Samples[:1]
+	row.Samples[0].DPS = r.Baseline[0].DPS
+	row.Samples[0].CharacterDPS = map[string]float64{"a": 10, "b": 60, "c": 20, "d": 10}
+	return r
+}
+
+func TestScreenedDirectionKeepsOnlyActualFirstSeed(t *testing.T) {
+	r := zeroScreenFixture()
+	d, err := DirectionsFromResponses([]string{"a", "b", "c", "d"}, r)
+	if err != nil || len(d) != 1 || d[0].Status != "screened_zero_first_seed" || d[0].SampleCount != 1 || len(d[0].SeedDPSChanges) != 1 {
+		t.Fatal("one observed zero was fabricated as a pair or discarded", d, err)
+	}
+	if _, exists := d[0].SeedDPSChanges[12]; exists {
+		t.Fatal("unobserved second seed was manufactured")
+	}
+}
+
+func TestScreeningConsumerRejectsForgedEarlyStops(t *testing.T) {
+	for name, mutate := range map[string]func(*engineclient.StatResponseResult){
+		"not enabled":   func(r *engineclient.StatResponseResult) { r.ScreeningEnabled = false },
+		"wrong count":   func(r *engineclient.StatResponseResult) { r.AttemptedCalls-- },
+		"wrong skipped": func(r *engineclient.StatResponseResult) { r.SkippedCalls++; r.AttemptedCalls-- },
+		"zero calls":    func(r *engineclient.StatResponseResult) { r.AttemptedCalls = 0; r.SkippedCalls = 4 },
+		"wrong seed": func(r *engineclient.StatResponseResult) {
+			r.Perturbations[0].Samples[0].Seed = 12
+			r.Perturbations[0].Samples[0].SampleSeed = "12"
+		},
+		"team nonzero": func(r *engineclient.StatResponseResult) { r.Perturbations[0].Samples[0].DPS++ },
+		"foreign cancellation": func(r *engineclient.StatResponseResult) {
+			r.Perturbations[0].Samples[0].CharacterDPS["a"]--
+			r.Perturbations[0].Samples[0].CharacterDPS["b"]++
+		},
+		"negative perturbation": func(r *engineclient.StatResponseResult) { r.Perturbations[0].Perturbation.Delta = -.2 },
+	} {
+		t.Run(name, func(t *testing.T) {
+			r := zeroScreenFixture()
+			mutate(&r)
+			if _, err := DirectionsFromResponses([]string{"a", "b", "c", "d"}, r); err == nil {
+				t.Fatal("invalid sparse response was accepted")
+			}
+		})
+	}
+}
diff --git a/internal/theoryalloc/allocation_test.go b/internal/theoryalloc/allocation_test.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/allocation_test.go
@@ -0,0 +1,202 @@
+package theoryalloc_test
+
+import (
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+)
+
+func witnessMains() [4][5]string {
+	return [4][5]string{
+		{"hp", "atk", "em", "pyro_damage_bonus", "crit_rate"},
+		{"hp", "atk", "atk_percent", "hydro_damage_bonus", "crit_damage"},
+		{"hp", "atk", "energy_recharge", "electro_damage_bonus", "healing_bonus"},
+		{"hp", "atk", "hp_percent", "physical_damage_bonus", "def_percent"},
+	}
+}
+
+func positiveGradient() [4][10]float64 {
+	var gradient [4][10]float64
+	for actor := range gradient {
+		for stat := range gradient[actor] {
+			gradient[actor][stat] = float64(stat + 1)
+		}
+	}
+	return gradient
+}
+
+func TestSeedFull45WitnessesRetainTwentyInitialAndTwentyFiveUpgradeUnits(t *testing.T) {
+	keys := theoryalloc.StatKeys()
+	for _, variant := range []int{0, 1} {
+		state := theoryalloc.Seed(witnessMains(), positiveGradient(), variant, 45)
+		if err := theoryalloc.ValidateFull45(state); err != nil {
+			t.Fatalf("variant %d: %v", variant, err)
+		}
+		rolls := state.Rolls()
+		for actor := range state.Lines {
+			initial, upgrades, total := 0, 0.0, 0.0
+			for slot, lines := range state.Lines[actor] {
+				seen := map[int]bool{}
+				for line, stat := range lines {
+					if seen[stat] || keys[stat] == state.Mains[actor][slot] {
+						t.Fatalf("variant %d actor %d slot %d has illegal initial lines", variant, actor, slot)
+					}
+					seen[stat] = true
+					initial++
+					upgrades += state.Upgrades[actor][slot][line]
+				}
+			}
+			for _, amount := range rolls[actor] {
+				total += amount
+			}
+			if initial != 20 || upgrades != 25 || total != 45 {
+				t.Fatalf("variant %d actor %d: initial %d upgrades %g total %g", variant, actor, initial, upgrades, total)
+			}
+		}
+	}
+}
+
+func TestPublicationRejectsMissingUpgradesWhileSolverBudgetRemainsAnUpperBound(t *testing.T) {
+	state := theoryalloc.Seed(witnessMains(), positiveGradient(), 0, 45)
+	state.Upgrades[2][3][1] -= .25
+	if err := state.Validate(45, true); err != nil {
+		t.Fatalf("valid underfilled solver witness was rejected: %v", err)
+	}
+	if err := theoryalloc.ValidateFull45(state); err == nil || !strings.Contains(err.Error(), "actor 2") {
+		t.Fatalf("underfilled actor was accepted for publication: %v", err)
+	}
+	initialOnly := theoryalloc.Seed(witnessMains(), positiveGradient(), 0, 20)
+	if err := initialOnly.Validate(45, true); err != nil {
+		t.Fatalf("unused upgrade budget must remain legal: %v", err)
+	}
+	if err := theoryalloc.ValidateFull45(initialOnly); err == nil {
+		t.Fatal("initial-only witness was accepted for publication")
+	}
+}
+
+func TestValidationRejectsIllegalSlotAndUpgradeWitnesses(t *testing.T) {
+	base := theoryalloc.Seed(witnessMains(), positiveGradient(), 0, 45)
+	cases := []struct {
+		name   string
+		mutate func(*theoryalloc.State)
+		budget float64
+		want   string
+	}{
+		{"duplicate_line", func(s *theoryalloc.State) { s.Lines[0][0][1] = s.Lines[0][0][0] }, 45, "duplicate or main-matching"},
+		{"main_collision", func(s *theoryalloc.State) { s.Lines[0][0][0] = 8 }, 45, "duplicate or main-matching"},
+		{"illegal_main", func(s *theoryalloc.State) { s.Mains[0][0] = "atk" }, 45, "illegal main"},
+		{"missing_initial_line", func(s *theoryalloc.State) { s.Lines[1][2][3] = -1 }, 45, "invalid stat index"},
+		{"unknown_line", func(s *theoryalloc.State) { s.Lines[1][2][3] = 10 }, 45, "invalid stat index"},
+		{"negative_upgrade", func(s *theoryalloc.State) { s.Upgrades[1][2][3] = -.25 }, 45, "invalid upgrade"},
+		{"missing_upgrade_value", func(s *theoryalloc.State) { s.Upgrades[1][2][3] = math.NaN() }, 45, "invalid upgrade"},
+		{"infinite_upgrade", func(s *theoryalloc.State) { s.Upgrades[1][2][3] = math.Inf(1) }, 45, "invalid upgrade"},
+		{"off_quarter_grid", func(s *theoryalloc.State) { s.Upgrades[1][2][3] = .1 }, 45, "off the quarter grid"},
+		{"slot_overflow", func(s *theoryalloc.State) { s.Upgrades[1][2][3] += .25 }, 45, "exceeds five upgrades"},
+		{"actor_budget_overflow", func(*theoryalloc.State) {}, 44.75, "exceeds budget"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			candidate := base
+			tc.mutate(&candidate)
+			err := candidate.Validate(tc.budget, true)
+			if err == nil || !strings.Contains(err.Error(), tc.want) {
+				t.Fatalf("Validate returned %v; want %q", err, tc.want)
+			}
+			if err := theoryalloc.ValidateFull45(candidate); tc.budget == 45 && err == nil {
+				t.Fatal("illegal solver witness was accepted for publication")
+			}
+		})
+	}
+}
+
+func TestRuleAccessorsPreservePinnedValuesAndCannotMutateAllocatorRules(t *testing.T) {
+	wantKeys := [10]string{"atk", "atk_percent", "crit_damage", "crit_rate", "def", "def_percent", "em", "energy_recharge", "hp", "hp_percent"}
+	wantValues := [10]float64{19.45, .0583, .0777, .0389, 23.15, .0729, 23.31, .0648, 298.75, .0583}
+	wantMains := map[string]float64{
+		"hp": 4780, "atk": 311, "hp_percent": .466, "atk_percent": .466,
+		"def_percent": .583, "em": 186.5, "energy_recharge": .518,
+		"crit_rate": .311, "crit_damage": .622, "pyro_damage_bonus": .466,
+		"hydro_damage_bonus": .466, "electro_damage_bonus": .466,
+		"cryo_damage_bonus": .466, "anemo_damage_bonus": .466,
+		"geo_damage_bonus": .466, "dendro_damage_bonus": .466,
+		"physical_damage_bonus": .583, "healing_bonus": .359,
+	}
+	keys, values := theoryalloc.StatKeys(), theoryalloc.StatValues()
+	mains, choices := theoryalloc.MainValues(), theoryalloc.MainChoices()
+	if keys != wantKeys || values != wantValues || !reflect.DeepEqual(mains, wantMains) {
+		t.Fatal("pinned coordinate order or numeric rule values changed")
+	}
+	wantChoices := [5][]string{
+		{"hp"}, {"atk"},
+		{"atk_percent", "def_percent", "em", "energy_recharge", "hp_percent"},
+		{"anemo_damage_bonus", "atk_percent", "cryo_damage_bonus", "def_percent", "dendro_damage_bonus", "electro_damage_bonus", "em", "geo_damage_bonus", "hp_percent", "hydro_damage_bonus", "physical_damage_bonus", "pyro_damage_bonus"},
+		{"atk_percent", "crit_damage", "crit_rate", "def_percent", "em", "healing_bonus", "hp_percent"},
+	}
+	if !reflect.DeepEqual(choices, wantChoices) {
+		t.Fatal("pinned main choices or their traversal order changed")
+	}
+	keys[0], values[0] = "other", -1
+	mains["hp"] = -1
+	delete(mains, "atk")
+	choices[0][0] = "atk"
+	choices[3][0] = "other"
+	if theoryalloc.StatKeys() != wantKeys || theoryalloc.StatValues() != wantValues ||
+		!reflect.DeepEqual(theoryalloc.MainValues(), wantMains) || !reflect.DeepEqual(theoryalloc.MainChoices(), wantChoices) {
+		t.Fatal("consumer mutation changed allocator rules")
+	}
+	if err := theoryalloc.ValidateFull45(theoryalloc.Seed(witnessMains(), positiveGradient(), 0, 45)); err != nil {
+		t.Fatalf("consumer mutation affected a legal witness: %v", err)
+	}
+}
+
+func TestExtractedLinearAllocationMatchesFullBudgetOracle(t *testing.T) {
+	var mains [4][5]string
+	for actor := range mains {
+		mains[actor] = [5]string{"hp", "atk", "atk_percent", "pyro_damage_bonus", "crit_rate"}
+	}
+	weights := positiveGradient()
+	start := theoryalloc.Seed(mains, weights, 0, 20)
+	// The pinned seed has [9,7,6,5] on flower and [9,8,7,6] elsewhere.
+	// Its weighted base is 167 per actor. Stat 9 appears in all five slots,
+	// so all 25 upgrades can reach weight 10: the independent maximum is 417.
+	want := start
+	for actor := range want.Upgrades {
+		for slot := range want.Upgrades[actor] {
+			want.Upgrades[actor][slot][0] = 5
+		}
+	}
+	wantRolls := [10]float64{0, 0, 0, 0, 0, 1, 5, 5, 4, 30}
+	objective := func(state theoryalloc.State, _ bool) (float64, [4][10]float64, error) {
+		value := 0.0
+		for actor, rolls := range state.Rolls() {
+			for stat, amount := range rolls {
+				value += weights[actor][stat] * amount
+			}
+		}
+		return value, weights, nil
+	}
+	for _, method := range []string{"fixed", "spg"} {
+		t.Run(method, func(t *testing.T) {
+			result, err := theoryalloc.Optimize(objective, start, theoryalloc.Config{
+				Budget: 45, Method: method, MaxIterations: 80, LineSearch: true, Polish: true,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := theoryalloc.ValidateFull45(result.State); err != nil {
+				t.Fatal(err)
+			}
+			if result.State != want || result.Value != 4*417 {
+				t.Fatalf("full-budget allocation differs from oracle: value %g, state %+v", result.Value, result.State)
+			}
+			for actor, rolls := range result.State.Rolls() {
+				if rolls != wantRolls {
+					t.Fatalf("actor %d rolls %v; want %v", actor, rolls, wantRolls)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/theoryalloc/fast.go b/internal/theoryalloc/fast.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/fast.go
@@ -0,0 +1,242 @@
+package theoryalloc
+
+import (
+	"fmt"
+	"math"
+)
+
+// FastConfig bounds a fixed-bonus whole-build heuristic. Zero Passes means
+// two main sweeps and zero InnerIterations means eight SPG steps per layout.
+// MainPairs and LinePasses are optional, more expensive neighborhoods.
+type FastConfig struct {
+	Passes          int
+	InnerIterations int
+	MainPairs       bool
+	LinePasses      int
+}
+
+type FastResult struct {
+	State                State
+	Value                float64
+	ContinuousValue      float64
+	Evaluations          int
+	OptimizeCalls        int
+	SeedLayouts          int
+	SingleMainCandidates int
+	PairCandidates       int
+	LineCandidates       int
+	AcceptedSingleMains  int
+	AcceptedMainPairs    int
+	AcceptedLines        int
+	MainPasses           int
+	Stop                 string
+}
+
+// FastWhole performs Gauss-Seidel main sweeps on one fixed-bonus objective.
+// Every legal sands/goblet/circlet alternative is compared after bounded
+// all-actor upgrade optimization, both warm and with one actor's independently
+// reseeded lines. Optional paired-main and line neighborhoods also compare
+// optimized feasible witnesses. No finite neighborhood certifies a global
+// optimum, and different fixed set bonuses require separate calls.
+func FastWhole(obj Objective, start State, cfg Config, search FastConfig) (FastResult, error) {
+	var out FastResult
+	if obj == nil {
+		return out, fmt.Errorf("nil objective")
+	}
+	var err error
+	cfg, err = normalizedConfig(cfg)
+	if err != nil {
+		return out, err
+	}
+	if cfg.Method != "spg" {
+		return out, fmt.Errorf("fast whole-build search requires spg")
+	}
+	if err := start.Validate(cfg.Budget, true); err != nil {
+		return out, err
+	}
+	if search.Passes < 0 || search.Passes > 2 || search.InnerIterations < 0 || search.LinePasses < 0 || search.LinePasses > 2 {
+		return out, fmt.Errorf("fast search permits at most two main and line passes")
+	}
+	if search.Passes == 0 {
+		search.Passes = 2
+	}
+	if search.InnerIterations == 0 {
+		search.InnerIterations = 8
+	}
+	inner := cfg
+	inner.MaxIterations = search.InnerIterations
+	inner.Polish = false
+	counted := func(state State, needGradient bool) (float64, [4][10]float64, error) {
+		out.Evaluations++
+		return obj(state, needGradient)
+	}
+	initial, _, err := counted(start, false)
+	if err != nil {
+		return out, err
+	}
+	if !finite(initial) {
+		return out, fmt.Errorf("non-finite initial objective")
+	}
+	out.State, out.Value, out.ContinuousValue = start, initial, initial
+	run := func(state State, local Config) (Result, error) {
+		out.OptimizeCalls++
+		r, runErr := Optimize(counted, state, local)
+		if runErr == nil {
+			out.ContinuousValue = math.Max(out.ContinuousValue, r.ContinuousValue)
+		}
+		return r, runErr
+	}
+	initialRun, err := run(start, inner)
+	if err != nil {
+		out.Stop = "objective_error"
+		return out, err
+	}
+	if quarterBetter(initialRun.Value, out.Value) {
+		out.State, out.Value = initialRun.State, initialRun.Value
+	}
+	_, gradient, err := counted(out.State, true)
+	if err != nil {
+		out.Stop = "objective_error"
+		return out, err
+	}
+	seed := Seed(out.State.Mains, gradient, 0, cfg.Budget)
+	if seed != out.State {
+		out.SeedLayouts++
+		r, runErr := run(seed, inner)
+		if runErr != nil {
+			out.Stop = "objective_error"
+			return out, runErr
+		}
+		if quarterBetter(r.Value, out.Value) {
+			out.State, out.Value = r.State, r.Value
+		}
+	}
+	mainStable := false
+	for pass := 0; pass < search.Passes; pass++ {
+		out.MainPasses++
+		changed := false
+		for actor := range out.State.Mains {
+			for slot := 2; slot < 5; slot++ {
+				anchor := out.State
+				bestState, bestValue := anchor, out.Value
+				_, anchorGradient, gradErr := counted(anchor, true)
+				if gradErr != nil {
+					out.Stop = "objective_error"
+					return out, gradErr
+				}
+				for _, main := range mainChoices[slot] {
+					if main == anchor.Mains[actor][slot] {
+						continue
+					}
+					out.SingleMainCandidates++
+					candidate := ReplaceMain(anchor, actor, slot, main, anchorGradient, cfg.Budget)
+					warm, runErr := run(candidate, inner)
+					if runErr != nil {
+						out.Stop = "objective_error"
+						return out, runErr
+					}
+					candidateState, candidateValue := warm.State, warm.Value
+					_, candidateGradient, gradErr := counted(warm.State, true)
+					if gradErr != nil {
+						out.Stop = "objective_error"
+						return out, gradErr
+					}
+					independent := Seed(warm.State.Mains, candidateGradient, 0, cfg.Budget)
+					reseeded := warm.State
+					reseeded.Lines[actor] = independent.Lines[actor]
+					reseeded.Upgrades[actor] = independent.Upgrades[actor]
+					if reseeded != warm.State {
+						out.SeedLayouts++
+						alternative, altErr := run(reseeded, inner)
+						if altErr != nil {
+							out.Stop = "objective_error"
+							return out, altErr
+						}
+						if quarterBetter(alternative.Value, candidateValue) {
+							candidateState, candidateValue = alternative.State, alternative.Value
+						}
+					}
+					if quarterBetter(candidateValue, bestValue) {
+						bestState, bestValue = candidateState, candidateValue
+					}
+				}
+				if quarterBetter(bestValue, out.Value) {
+					out.State, out.Value = bestState, bestValue
+					out.AcceptedSingleMains++
+					changed = true
+				}
+			}
+		}
+		if !changed {
+			mainStable = true
+			break
+		}
+	}
+	if search.MainPairs {
+		pairCfg := inner
+		pairCfg.MaxIterations = 4
+		for actor := range out.State.Mains {
+			var actors [4]bool
+			actors[actor] = true
+			pair, pairErr := jointOptimize(counted, out.State, pairCfg, jointConfig{
+				Actors: actors, MaxPasses: 1, InnerIterations: 4,
+				DisableIndependentSeeds: true, DisableSingleMains: true, DisableLines: true,
+			})
+			if pairErr != nil {
+				out.Stop = "objective_error"
+				return out, pairErr
+			}
+			out.OptimizeCalls += pair.OptimizeCalls
+			out.PairCandidates += pair.JointMainCandidates
+			out.ContinuousValue = math.Max(out.ContinuousValue, pair.ContinuousValue)
+			if quarterBetter(pair.Value, out.Value) {
+				out.State, out.Value = pair.State, pair.Value
+				out.AcceptedMainPairs += pair.AcceptedMainPairs
+			}
+		}
+	}
+	if search.LinePasses > 0 {
+		lineIterations := search.InnerIterations
+		if lineIterations < 4 {
+			lineIterations = 4
+		}
+		if lineIterations > 8 {
+			lineIterations = 8
+		}
+		lines, lineErr := jointOptimize(counted, out.State, inner, jointConfig{
+			MaxPasses: search.LinePasses, InnerIterations: lineIterations,
+			DisableIndependentSeeds: true, DisableSingleMains: true, DisableMainPairs: true,
+		})
+		if lineErr != nil {
+			out.Stop = "objective_error"
+			return out, lineErr
+		}
+		out.OptimizeCalls += lines.OptimizeCalls
+		out.LineCandidates += lines.LineCandidates
+		out.ContinuousValue = math.Max(out.ContinuousValue, lines.ContinuousValue)
+		if quarterBetter(lines.Value, out.Value) {
+			out.State, out.Value = lines.State, lines.Value
+			out.AcceptedLines += lines.AcceptedLines
+		}
+	}
+	finalCfg := cfg
+	finalCfg.Polish = true
+	final, err := run(out.State, finalCfg)
+	if err != nil {
+		out.Stop = "objective_error"
+		return out, err
+	}
+	if quarterBetter(final.Value, out.Value) {
+		out.State, out.Value = final.State, final.Value
+	}
+	if err := out.State.Validate(cfg.Budget, true); err != nil {
+		out.Stop = "invalid_final_state"
+		return out, err
+	}
+	if mainStable {
+		out.Stop = "main_stable_bounded_neighborhood"
+	} else {
+		out.Stop = "main_pass_cap_bounded_neighborhood"
+	}
+	return out, nil
+}
diff --git a/internal/theoryalloc/joint.go b/internal/theoryalloc/joint.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/joint.go
@@ -0,0 +1,352 @@
+package theoryalloc
+
+import (
+	"fmt"
+	"math"
+)
+
+// jointConfig bounds a local whole-build search under one fixed objective
+// (including its fixed set bonus). A zero Actors mask permits all four actors;
+// otherwise only selected actors may change mains or lines. Upgrade searches
+// still respond to all four actors' gradients.
+type jointConfig struct {
+	Actors                  [4]bool
+	MaxPasses               int // zero defaults to two complete neighborhood passes
+	InnerIterations         int // zero defaults to 16 upgrade steps per layout
+	MaxMainPairs            int // zero evaluates all goblet/circlet pairs per pass
+	MaxLineCandidates       int // zero evaluates all one-line replacements per pass
+	DisableIndependentSeeds bool
+	DisableSingleMains      bool
+	DisableMainPairs        bool
+	DisableLines            bool
+}
+
+// jointResult counts actual work, including rejected layouts and independent
+// starts. Candidate counts are layouts evaluated after a bounded Optimize call;
+// eligible counts include layouts skipped by an explicit candidate cap.
+// ContinuousValue is the best relaxation score seen, possibly on a different
+// layout from the returned feasible quarter-grid State.
+type jointResult struct {
+	State                State
+	Value                float64
+	ContinuousValue      float64
+	Evaluations          int
+	OptimizeCalls        int
+	SeedLayouts          int
+	SingleMainCandidates int
+	MainPairEligible     int
+	JointMainCandidates  int
+	TruncatedMainPairs   int
+	LineEligible         int
+	LineCandidates       int
+	TruncatedLines       int
+	AcceptedMoves        int
+	AcceptedSingleMains  int
+	AcceptedMainPairs    int
+	AcceptedLines        int
+	Passes               int
+	Stop                 string
+}
+
+type jointMainPair struct {
+	actor           int
+	goblet, circlet string
+}
+
+type jointLineChange struct {
+	actor, slot, line, stat int
+}
+
+type jointWinner struct {
+	state State
+	value float64
+	kind  string
+}
+
+// jointOptimize searches legal main/line neighborhoods while Optimize handles
+// all actors' upgrades for every admitted layout. No candidate is removed by a
+// frozen gradient or its unoptimized score. Main alternatives use a warm start
+// plus two independent gradient-seeded line layouts unless disabled. The finite
+// neighborhoods, pass limits, and optional candidate caps are heuristic; this
+// does not prove a global optimum or a physical artifact roll-tier build.
+func jointOptimize(obj Objective, start State, cfg Config, search jointConfig) (jointResult, error) {
+	var out jointResult
+	if obj == nil {
+		return out, fmt.Errorf("nil objective")
+	}
+	var err error
+	cfg, err = normalizedConfig(cfg)
+	if err != nil {
+		return out, err
+	}
+	if err := start.Validate(cfg.Budget, false); err != nil {
+		return out, err
+	}
+	if search.MaxPasses < 0 || search.InnerIterations < 0 || search.MaxMainPairs < 0 || search.MaxLineCandidates < 0 {
+		return out, fmt.Errorf("negative joint search limit")
+	}
+	if search.MaxPasses == 0 {
+		search.MaxPasses = 2
+	}
+	if search.InnerIterations == 0 {
+		search.InnerIterations = 16
+	}
+	inner := cfg
+	inner.MaxIterations = search.InnerIterations
+	selected := search.Actors
+	if selected == [4]bool{} {
+		selected = [4]bool{true, true, true, true}
+	}
+	counted := func(state State, needGradient bool) (float64, [4][10]float64, error) {
+		out.Evaluations++
+		return obj(state, needGradient)
+	}
+	checked := counter{objective: counted}
+	continuousSeen := false
+	run := func(candidate State) (Result, error) {
+		out.OptimizeCalls++
+		r, runErr := Optimize(counted, candidate, inner)
+		if runErr == nil && (!continuousSeen || r.ContinuousValue > out.ContinuousValue) {
+			out.ContinuousValue = r.ContinuousValue
+			continuousSeen = true
+		}
+		return r, runErr
+	}
+	finish := func(winner jointWinner, stop string) jointResult {
+		out.State, out.Value, out.Stop = winner.state, winner.value, stop
+		return out
+	}
+	first, err := run(start)
+	if err != nil {
+		out.Stop = "objective_error"
+		return out, err
+	}
+	best := jointWinner{state: first.State, value: first.Value}
+	if err := best.state.Validate(cfg.Budget, true); err != nil {
+		return finish(best, "invalid_initial_result"), err
+	}
+	// Seed both line-selection patterns independently of the warm allocation.
+	// Only selected actors receive new line layouts; every Optimize call can
+	// still rebalance upgrades for the full team.
+	if !search.DisableIndependentSeeds {
+		_, gradient, gradErr := checked.evaluate(best.state, true)
+		if gradErr != nil {
+			return finish(best, "objective_error"), gradErr
+		}
+		seen := map[State]bool{best.state: true}
+		for variant := 0; variant < 2; variant++ {
+			seed := Seed(best.state.Mains, gradient, variant, cfg.Budget)
+			candidate := best.state
+			for actor := range selected {
+				if selected[actor] {
+					candidate.Lines[actor] = seed.Lines[actor]
+					candidate.Upgrades[actor] = seed.Upgrades[actor]
+				}
+			}
+			if seen[candidate] {
+				continue
+			}
+			seen[candidate] = true
+			out.SeedLayouts++
+			r, runErr := run(candidate)
+			if runErr != nil {
+				return finish(best, "objective_error"), runErr
+			}
+			if jointBetter(r.Value, best.value) {
+				best = jointWinner{state: r.State, value: r.Value, kind: "seed"}
+			}
+		}
+	}
+	truncated := false
+	for pass := 0; pass < search.MaxPasses; pass++ {
+		out.Passes++
+		anchor := best
+		winner := anchor
+		_, gradient, gradErr := checked.evaluate(anchor.state, true)
+		if gradErr != nil {
+			return finish(best, "objective_error"), gradErr
+		}
+		admit := func(candidate State, kind string, mainActor int) error {
+			r, runErr := run(candidate)
+			if runErr != nil {
+				return runErr
+			}
+			candidateBest := r
+			if mainActor >= 0 && !search.DisableIndependentSeeds {
+				_, candidateGradient, gradientErr := checked.evaluate(candidate, true)
+				if gradientErr != nil {
+					return gradientErr
+				}
+				seen := map[State]bool{candidate: true}
+				for variant := 0; variant < 2; variant++ {
+					seed := Seed(candidate.Mains, candidateGradient, variant, cfg.Budget)
+					independent := candidate
+					independent.Lines[mainActor] = seed.Lines[mainActor]
+					independent.Upgrades[mainActor] = seed.Upgrades[mainActor]
+					if seen[independent] {
+						continue
+					}
+					seen[independent] = true
+					out.SeedLayouts++
+					alternative, altErr := run(independent)
+					if altErr != nil {
+						return altErr
+					}
+					if jointBetter(alternative.Value, candidateBest.Value) {
+						candidateBest = alternative
+					}
+				}
+			}
+			if jointBetter(candidateBest.Value, winner.value) {
+				winner = jointWinner{state: candidateBest.State, value: candidateBest.Value, kind: kind}
+			}
+			return nil
+		}
+		if !search.DisableSingleMains {
+			for actor := range selected {
+				if !selected[actor] {
+					continue
+				}
+				for slot := 2; slot < 5; slot++ {
+					for _, main := range mainChoices[slot] {
+						if main == anchor.state.Mains[actor][slot] {
+							continue
+						}
+						out.SingleMainCandidates++
+						candidate := ReplaceMain(anchor.state, actor, slot, main, gradient, cfg.Budget)
+						if err := admit(candidate, "single_main", actor); err != nil {
+							return finish(best, "objective_error"), err
+						}
+					}
+				}
+			}
+		}
+		if !search.DisableMainPairs {
+			pairs := jointMainPairs(anchor.state, selected)
+			out.MainPairEligible += len(pairs)
+			if search.MaxMainPairs > 0 && len(pairs) > search.MaxMainPairs {
+				out.TruncatedMainPairs += len(pairs) - search.MaxMainPairs
+				pairs = pairs[:search.MaxMainPairs]
+				truncated = true
+			}
+			for _, pair := range pairs {
+				out.JointMainCandidates++
+				candidate := ReplaceMain(anchor.state, pair.actor, 3, pair.goblet, gradient, cfg.Budget)
+				candidate = ReplaceMain(candidate, pair.actor, 4, pair.circlet, gradient, cfg.Budget)
+				if err := admit(candidate, "main_pair", pair.actor); err != nil {
+					return finish(best, "objective_error"), err
+				}
+			}
+		}
+		if !search.DisableLines {
+			lines := jointLineChanges(anchor.state, selected)
+			out.LineEligible += len(lines)
+			if search.MaxLineCandidates > 0 && len(lines) > search.MaxLineCandidates {
+				out.TruncatedLines += len(lines) - search.MaxLineCandidates
+				lines = lines[:search.MaxLineCandidates]
+				truncated = true
+			}
+			for _, change := range lines {
+				out.LineCandidates++
+				candidate := anchor.state
+				candidate.Lines[change.actor][change.slot][change.line] = change.stat
+				if err := admit(candidate, "line", -1); err != nil {
+					return finish(best, "objective_error"), err
+				}
+			}
+		}
+		if !jointBetter(winner.value, anchor.value) {
+			if truncated {
+				return finish(best, "candidate_cap"), nil
+			}
+			return finish(best, "neighborhood_stable"), nil
+		}
+		best = winner
+		out.AcceptedMoves++
+		switch winner.kind {
+		case "single_main":
+			out.AcceptedSingleMains++
+		case "main_pair":
+			out.AcceptedMainPairs++
+		case "line":
+			out.AcceptedLines++
+		}
+	}
+	if truncated {
+		return finish(best, "pass_cap_candidate_cap"), nil
+	}
+	return finish(best, "pass_cap"), nil
+}
+
+func jointBetter(value, incumbent float64) bool {
+	return value > incumbent+1e-10*(1+math.Abs(incumbent))
+}
+
+func jointMainPairs(state State, selected [4]bool) []jointMainPair {
+	var perActor [4][]jointMainPair
+	depth := 0
+	for actor := range selected {
+		if !selected[actor] {
+			continue
+		}
+		for _, goblet := range mainChoices[3] {
+			if goblet == state.Mains[actor][3] {
+				continue
+			}
+			for _, circlet := range mainChoices[4] {
+				if circlet == state.Mains[actor][4] {
+					continue
+				}
+				perActor[actor] = append(perActor[actor], jointMainPair{actor: actor, goblet: goblet, circlet: circlet})
+			}
+		}
+		if len(perActor[actor]) > depth {
+			depth = len(perActor[actor])
+		}
+	}
+	ordered := make([]jointMainPair, 0, depth*4)
+	for i := 0; i < depth; i++ {
+		for actor := range perActor {
+			if i < len(perActor[actor]) {
+				ordered = append(ordered, perActor[actor][i])
+			}
+		}
+	}
+	return ordered
+}
+
+func jointLineChanges(state State, selected [4]bool) []jointLineChange {
+	var perActor [4][]jointLineChange
+	depth := 0
+	for actor := range selected {
+		if !selected[actor] {
+			continue
+		}
+		for slot := range state.Lines[actor] {
+			present := [10]bool{}
+			for _, stat := range state.Lines[actor][slot] {
+				present[stat] = true
+			}
+			for line := range state.Lines[actor][slot] {
+				for stat := range statKeys {
+					if present[stat] || statKeys[stat] == state.Mains[actor][slot] {
+						continue
+					}
+					perActor[actor] = append(perActor[actor], jointLineChange{actor: actor, slot: slot, line: line, stat: stat})
+				}
+			}
+		}
+		if len(perActor[actor]) > depth {
+			depth = len(perActor[actor])
+		}
+	}
+	ordered := make([]jointLineChange, 0, depth*4)
+	for i := 0; i < depth; i++ {
+		for actor := range perActor {
+			if i < len(perActor[actor]) {
+				ordered = append(ordered, perActor[actor][i])
+			}
+		}
+	}
+	return ordered
+}
diff --git a/internal/theoryalloc/kernel.go b/internal/theoryalloc/kernel.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/kernel.go
@@ -0,0 +1,323 @@
+// Package theoryalloc searches idealized legal artifact allocations. A
+// feasible state is a quarter-unit witness, not a physical roll-tier build.
+package theoryalloc
+
+import (
+	"fmt"
+	"math"
+	"sort"
+)
+
+// statKeys and statValues use the native theory solver's substat keys and maximum
+// roll values in alphabetical order. Objective gradients are in roll units,
+// before multiplying by statValues.
+var statKeys = [10]string{
+	"atk", "atk_percent", "crit_damage", "crit_rate", "def",
+	"def_percent", "em", "energy_recharge", "hp", "hp_percent",
+}
+
+var statValues = [10]float64{
+	19.45, .0583, .0777, .0389, 23.15,
+	.0729, 23.31, .0648, 298.75, .0583,
+}
+
+var mainValues = map[string]float64{
+	"hp": 4780, "atk": 311, "hp_percent": .466, "atk_percent": .466,
+	"def_percent": .583, "em": 186.5, "energy_recharge": .518,
+	"crit_rate": .311, "crit_damage": .622, "pyro_damage_bonus": .466,
+	"hydro_damage_bonus": .466, "electro_damage_bonus": .466,
+	"cryo_damage_bonus": .466, "anemo_damage_bonus": .466,
+	"geo_damage_bonus": .466, "dendro_damage_bonus": .466,
+	"physical_damage_bonus": .583, "healing_bonus": .359,
+}
+
+// mainChoices are flower, plume, sands, goblet, and circlet, respectively.
+var mainChoices = [5][]string{
+	{"hp"},
+	{"atk"},
+	{"atk_percent", "def_percent", "em", "energy_recharge", "hp_percent"},
+	{"anemo_damage_bonus", "atk_percent", "cryo_damage_bonus", "def_percent", "dendro_damage_bonus", "electro_damage_bonus", "em", "geo_damage_bonus", "hp_percent", "hydro_damage_bonus", "physical_damage_bonus", "pyro_damage_bonus"},
+	{"atk_percent", "crit_damage", "crit_rate", "def_percent", "em", "healing_bonus", "hp_percent"},
+}
+
+// Each slot has four distinct substat lines. Every line starts with one
+// maximum-value roll, and Upgrades are additional nonnegative roll units.
+type State struct {
+	Mains    [4][5]string
+	Lines    [4][5][4]int
+	Upgrades [4][5][4]float64
+}
+
+func (s State) Clone() State { return s }
+
+func (s State) Rolls() [4][10]float64 {
+	var rolls [4][10]float64
+	for actor := range s.Lines {
+		for slot := range s.Lines[actor] {
+			for line, stat := range s.Lines[actor][slot] {
+				if stat >= 0 && stat < len(statKeys) {
+					rolls[actor][stat] += 1 + s.Upgrades[actor][slot][line]
+				}
+			}
+		}
+	}
+	return rolls
+}
+
+// Validate checks the idealized feasible domain. Grid requires upgrades on the
+// quarter-unit lattice; base line rolls are always one unit each. Budget must
+// be in [20,45]. It is an upper bound, so unprofitable upgrades may stay unused.
+func (s State) Validate(budget float64, grid bool) error {
+	if !finite(budget) || budget < 20 || budget > 45 {
+		return fmt.Errorf("budget must be finite and in [20,45]")
+	}
+	for actor := range s.Mains {
+		actorExtra := 0.0
+		for slot := range s.Mains[actor] {
+			main := s.Mains[actor][slot]
+			if !validMain(slot, main) {
+				return fmt.Errorf("actor %d slot %d has illegal main %q", actor, slot, main)
+			}
+			seen := [10]bool{}
+			slotExtra := 0.0
+			for line, stat := range s.Lines[actor][slot] {
+				if stat < 0 || stat >= len(statKeys) {
+					return fmt.Errorf("actor %d slot %d line %d has invalid stat index %d", actor, slot, line, stat)
+				}
+				if seen[stat] || statKeys[stat] == main {
+					return fmt.Errorf("actor %d slot %d has duplicate or main-matching line %q", actor, slot, statKeys[stat])
+				}
+				seen[stat] = true
+				u := s.Upgrades[actor][slot][line]
+				if !finite(u) || u < -1e-9 {
+					return fmt.Errorf("actor %d slot %d line %d has invalid upgrade %g", actor, slot, line, u)
+				}
+				if grid && math.Abs(u*4-math.Round(u*4)) > 1e-8 {
+					return fmt.Errorf("actor %d slot %d line %d is off the quarter grid", actor, slot, line)
+				}
+				slotExtra += u
+			}
+			if slotExtra > 5+1e-8 {
+				return fmt.Errorf("actor %d slot %d exceeds five upgrades", actor, slot)
+			}
+			actorExtra += slotExtra
+		}
+		if actorExtra > budget-20+1e-8 {
+			return fmt.Errorf("actor %d exceeds budget %g", actor, budget)
+		}
+	}
+	return nil
+}
+
+func finite(x float64) bool { return !math.IsNaN(x) && !math.IsInf(x, 0) }
+
+func validMain(slot int, main string) bool {
+	if slot < 0 || slot >= len(mainChoices) {
+		return false
+	}
+	for _, choice := range mainChoices[slot] {
+		if choice == main {
+			return true
+		}
+	}
+	return false
+}
+
+func normalizedBudget(budget float64) float64 {
+	// Zero is a documented shorthand for the normal 45-roll theory budget.
+	if budget == 0 {
+		return 45
+	}
+	return budget
+}
+
+// Seed fixes the given legal mains and selects four eligible lines per slot.
+// Variant zero takes the highest-gradient lines and spreads upgrades evenly;
+// variant one balances line diversity within each actor and spends positive
+// gradient upgrades greedily. Neither variant searches main choices.
+func Seed(mains [4][5]string, gradient [4][10]float64, variant int, budget float64) State {
+	budget = normalizedBudget(budget)
+	state := State{Mains: mains}
+	for actor := range mains {
+		used := [10]int{}
+		for slot := range mains[actor] {
+			candidates := make([]int, 0, len(statKeys))
+			for stat := range statKeys {
+				if statKeys[stat] != mains[actor][slot] {
+					candidates = append(candidates, stat)
+				}
+			}
+			sort.SliceStable(candidates, func(i, j int) bool {
+				a, b := candidates[i], candidates[j]
+				if variant == 1 && used[a] != used[b] {
+					return used[a] < used[b]
+				}
+				if gradient[actor][a] != gradient[actor][b] {
+					return gradient[actor][a] > gradient[actor][b]
+				}
+				return a < b
+			})
+			for line := range state.Lines[actor][slot] {
+				state.Lines[actor][slot][line] = candidates[line]
+				used[candidates[line]]++
+			}
+		}
+		extra := math.Max(0, math.Min(25, budget-20))
+		if variant != 1 {
+			for slot := range state.Upgrades[actor] {
+				for line := range state.Upgrades[actor][slot] {
+					state.Upgrades[actor][slot][line] = extra / 20
+				}
+			}
+			continue
+		}
+		type coordinate struct{ slot, line, stat int }
+		coords := make([]coordinate, 0, 20)
+		for slot := range state.Lines[actor] {
+			for line, stat := range state.Lines[actor][slot] {
+				coords = append(coords, coordinate{slot, line, stat})
+			}
+		}
+		sort.SliceStable(coords, func(i, j int) bool {
+			a, b := coords[i], coords[j]
+			if gradient[actor][a.stat] != gradient[actor][b.stat] {
+				return gradient[actor][a.stat] > gradient[actor][b.stat]
+			}
+			if a.slot != b.slot {
+				return a.slot < b.slot
+			}
+			return a.line < b.line
+		})
+		for _, c := range coords {
+			if extra <= 0 || gradient[actor][c.stat] <= 0 {
+				break
+			}
+			slotExtra := 0.0
+			for _, u := range state.Upgrades[actor][c.slot] {
+				slotExtra += u
+			}
+			allocation := math.Min(extra, 5-slotExtra)
+			state.Upgrades[actor][c.slot][c.line] = allocation
+			extra -= allocation
+		}
+	}
+	return state
+}
+
+// ReplaceMain changes one legal main, repairs any line that now matches it,
+// and projects upgrades back into the slot and actor budget constraints.
+// Invalid actor, slot, or main requests return the original state unchanged.
+func ReplaceMain(state State, actor, slot int, main string, gradient [4][10]float64, budget float64) State {
+	if actor < 0 || actor >= 4 || !validMain(slot, main) {
+		return state
+	}
+	state.Mains[actor][slot] = main
+	used := [10]bool{}
+	for _, stat := range state.Lines[actor][slot] {
+		if stat >= 0 && stat < len(statKeys) && statKeys[stat] != main {
+			used[stat] = true
+		}
+	}
+	for line, stat := range state.Lines[actor][slot] {
+		if stat >= 0 && stat < len(statKeys) && statKeys[stat] != main {
+			continue
+		}
+		best := -1
+		for candidate := range statKeys {
+			if statKeys[candidate] == main || used[candidate] {
+				continue
+			}
+			if best < 0 || gradient[actor][candidate] > gradient[actor][best] {
+				best = candidate
+			}
+		}
+		if best >= 0 {
+			state.Lines[actor][slot][line] = best
+			used[best] = true
+		}
+	}
+	projectState(&state, normalizedBudget(budget))
+	return state
+}
+
+// projectState is the exact Euclidean projection for each actor's upgrade
+// coordinates onto x>=0, each slot sum<=5, and the actor sum<=budget-20.
+func projectState(state *State, budget float64) {
+	cap := math.Max(0, math.Min(25, budget-20))
+	for actor := range state.Upgrades {
+		v := state.Upgrades[actor]
+		state.Upgrades[actor] = projectActor(v, cap)
+	}
+}
+
+func projectActor(v [5][4]float64, cap float64) [5][4]float64 {
+	if cap <= 0 {
+		return [5][4]float64{}
+	}
+	projectAt := func(lambda float64) ([5][4]float64, float64) {
+		var out [5][4]float64
+		total := 0.0
+		for slot := range v {
+			shifted := v[slot]
+			for line := range shifted {
+				shifted[line] -= lambda
+			}
+			out[slot] = projectSlot(shifted)
+			for _, u := range out[slot] {
+				total += u
+			}
+		}
+		return out, total
+	}
+	out, total := projectAt(0)
+	if total <= cap+1e-12 {
+		return out
+	}
+	hi := 0.0
+	for slot := range v {
+		for _, u := range v[slot] {
+			if u > hi {
+				hi = u
+			}
+		}
+	}
+	lo := 0.0
+	for i := 0; i < 80; i++ {
+		mid := (lo + hi) / 2
+		_, total = projectAt(mid)
+		if total > cap {
+			lo = mid
+		} else {
+			hi = mid
+		}
+	}
+	out, _ = projectAt(hi)
+	return out
+}
+
+func projectSlot(v [4]float64) [4]float64 {
+	out := v
+	total := 0.0
+	for i := range out {
+		out[i] = math.Max(0, out[i])
+		total += out[i]
+	}
+	if total <= 5 {
+		return out
+	}
+	sorted := v
+	sort.Slice(sorted[:], func(i, j int) bool { return sorted[i] > sorted[j] })
+	prefix := 0.0
+	theta := 0.0
+	for i, value := range sorted {
+		prefix += value
+		candidate := (prefix - 5) / float64(i+1)
+		if value > candidate {
+			theta = candidate
+		}
+	}
+	for i := range out {
+		out[i] = math.Max(0, v[i]-theta)
+	}
+	return out
+}
diff --git a/internal/theoryalloc/optimize.go b/internal/theoryalloc/optimize.go
new file mode 100644
--- /dev/null
+++ b/internal/theoryalloc/optimize.go
@@ -0,0 +1,474 @@
+package theoryalloc
+
+import (
+	"fmt"
+	"math"
+	"sort"
+)
+
+// Objective returns a score and, when requested, its gradient with respect to
+// total maximum-value roll units for each actor and statKeys coordinate.
+type Objective func(State, bool) (float64, [4][10]float64, error)
+
+type Config struct {
+	Budget        float64 // zero defaults to 45; otherwise [20,45]
+	Method        string  // "spg" (default) or "fixed"
+	MaxIterations int     // zero defaults to 80
+	GridEachStep  bool    // round every proposal before evaluation
+	LineSearch    bool    // monotone Armijo backtracking for SPG
+	Polish        bool    // actual-objective quarter-transfer repair at the end
+}
+
+type Result struct {
+	State           State
+	Value           float64
+	Evaluations     int
+	Iterations      int
+	Stop            string
+	ContinuousValue float64
+}
+
+type counter struct {
+	objective   Objective
+	evaluations int
+}
+
+func (c *counter) evaluate(state State, gradient bool) (float64, [4][10]float64, error) {
+	c.evaluations++
+	value, g, err := c.objective(state, gradient)
+	if err != nil {
+		return 0, g, err
+	}
+	if !finite(value) {
+		return 0, g, fmt.Errorf("objective returned non-finite value")
+	}
+	if gradient {
+		for actor := range g {
+			for stat, component := range g[actor] {
+				if !finite(component) {
+					return 0, g, fmt.Errorf("objective gradient actor %d stat %d is non-finite", actor, stat)
+				}
+			}
+		}
+	}
+	return value, g, nil
+}
+
+func normalizedConfig(cfg Config) (Config, error) {
+	cfg.Budget = normalizedBudget(cfg.Budget)
+	if !finite(cfg.Budget) || cfg.Budget < 20 || cfg.Budget > 45 {
+		return cfg, fmt.Errorf("budget must be finite and in [20,45]")
+	}
+	if cfg.Method == "" {
+		cfg.Method = "spg"
+	}
+	if cfg.Method != "spg" && cfg.Method != "fixed" {
+		return cfg, fmt.Errorf("unknown optimization method %q", cfg.Method)
+	}
+	if cfg.MaxIterations < 0 {
+		return cfg, fmt.Errorf("negative iteration limit")
+	}
+	if cfg.MaxIterations == 0 {
+		cfg.MaxIterations = 80
+	}
+	return cfg, nil
+}
+
+// Optimize changes only upgrades while keeping mains and four line identities
+// fixed. It searches a continuous relaxation and returns one feasible quarter
+// witness, with the pre-rounding best score in ContinuousValue. Stop labels
+// describe this local search, never a global optimum.
+func Optimize(obj Objective, state State, cfg Config) (Result, error) {
+	var result Result
+	if obj == nil {
+		return result, fmt.Errorf("nil objective")
+	}
+	var err error
+	cfg, err = normalizedConfig(cfg)
+	if err != nil {
+		return result, err
+	}
+	if err := state.Validate(cfg.Budget, false); err != nil {
+		return result, err
+	}
+	input := state
+	inputOnGrid := state.Validate(cfg.Budget, true) == nil
+	c := counter{objective: obj}
+	value, gradient, err := c.evaluate(state, true)
+	if err != nil {
+		return result, err
+	}
+	inputValue := value
+	if cfg.GridEachStep {
+		quarter := roundQuarter(state, gradient, cfg.Budget)
+		if quarter != state {
+			state = quarter
+			value, gradient, err = c.evaluate(state, true)
+			if err != nil {
+				return result, err
+			}
+		}
+	}
+	best, bestValue, bestGradient := state, value, gradient
+	step := initialStep(state, gradient)
+	stop := "iteration_cap"
+	iterations := 0
+	for ; iterations < cfg.MaxIterations; iterations++ {
+		var next State
+		var nextValue float64
+		accepted := false
+		stationary := false
+		if cfg.Method == "fixed" {
+			next, nextValue, accepted, stationary, err = fixedStep(&c, state, value, gradient, cfg)
+		} else {
+			next, nextValue, accepted, stationary, err = spectralStep(&c, state, value, gradient, step, cfg)
+		}
+		if err != nil {
+			return Result{State: best, Value: bestValue, Evaluations: c.evaluations, Iterations: iterations, Stop: "objective_error", ContinuousValue: bestValue}, err
+		}
+		if !accepted {
+			if stationary {
+				stop = "stationarity"
+			} else if cfg.GridEachStep {
+				stop = "grid_stalled"
+			} else {
+				stop = "step_stalled"
+			}
+			break
+		}
+		nextValue, nextGradient, evalErr := c.evaluate(next, true)
+		if evalErr != nil {
+			return Result{State: best, Value: bestValue, Evaluations: c.evaluations, Iterations: iterations, Stop: "objective_error", ContinuousValue: bestValue}, evalErr
+		}
+		if nextValue > bestValue {
+			best, bestValue, bestGradient = next, nextValue, nextGradient
+		}
+		if cfg.Method == "spg" {
+			step = spectralScale(state, next, gradient, nextGradient, step)
+		}
+		state, value, gradient = next, nextValue, nextGradient
+	}
+	if iterations == cfg.MaxIterations {
+		stop = "iteration_cap"
+	}
+	quarter := roundQuarter(best, bestGradient, cfg.Budget)
+	quarterValue := bestValue
+	if quarter != best {
+		quarterValue, _, err = c.evaluate(quarter, false)
+		if err != nil {
+			return Result{State: best, Value: bestValue, Evaluations: c.evaluations, Iterations: iterations, Stop: "objective_error", ContinuousValue: bestValue}, err
+		}
+	}
+	if cfg.Polish {
+		quarter, quarterValue, err = polishQuarter(&c, quarter, quarterValue, cfg.Budget)
+		if err != nil {
+			return Result{State: quarter, Value: quarterValue, Evaluations: c.evaluations, Iterations: iterations, Stop: "objective_error", ContinuousValue: bestValue}, err
+		}
+	}
+	if inputOnGrid && inputValue > quarterValue {
+		quarter, quarterValue = input, inputValue
+	}
+	if err := quarter.Validate(cfg.Budget, true); err != nil {
+		return Result{State: quarter, Value: quarterValue, Evaluations: c.evaluations, Iterations: iterations, Stop: "invalid_final_state", ContinuousValue: bestValue}, err
+	}
+	result = Result{State: quarter, Value: quarterValue, Evaluations: c.evaluations, Iterations: iterations, Stop: stop, ContinuousValue: bestValue}
+	return result, nil
+}
+
+func initialStep(state State, g [4][10]float64) float64 {
+	maxComponent := 0.0
+	for actor := range state.Lines {
+		for slot := range state.Lines[actor] {
+			for _, stat := range state.Lines[actor][slot] {
+				maxComponent = math.Max(maxComponent, math.Abs(g[actor][stat]))
+			}
+		}
+	}
+	if maxComponent == 0 {
+		return 1
+	}
+	return 1 / maxComponent
+}
+
+func proposal(state State, g [4][10]float64, step float64, cfg Config) State {
+	next := state
+	for actor := range next.Upgrades {
+		for slot := range next.Upgrades[actor] {
+			for line := range next.Upgrades[actor][slot] {
+				stat := next.Lines[actor][slot][line]
+				next.Upgrades[actor][slot][line] += step * g[actor][stat]
+			}
+		}
+	}
+	projectState(&next, cfg.Budget)
+	if cfg.GridEachStep {
+		next = roundQuarter(next, g, cfg.Budget)
+	}
+	return next
+}
+
+func difference(state, next State, g [4][10]float64) (norm2, predicted float64) {
+	for actor := range state.Upgrades {
+		for slot := range state.Upgrades[actor] {
+			for line, old := range state.Upgrades[actor][slot] {
+				d := next.Upgrades[actor][slot][line] - old
+				norm2 += d * d
+				predicted += g[actor][state.Lines[actor][slot][line]] * d
+			}
+		}
+	}
+	return norm2, predicted
+}
+
+func fixedStep(c *counter, state State, value float64, g [4][10]float64, cfg Config) (State, float64, bool, bool, error) {
+	normSquared := 0.0
+	for actor := range state.Lines {
+		for slot := range state.Lines[actor] {
+			for _, stat := range state.Lines[actor][slot] {
+				component := g[actor][stat]
+				normSquared += component * component
+			}
+		}
+	}
+	if normSquared == 0 {
+		return state, value, false, true, nil
+	}
+	norm := math.Sqrt(normSquared)
+	best, bestValue := state, value
+	projectedMovement := 0.0
+	for _, length := range [4]float64{.25, 1, 4, 16} {
+		candidate := proposal(state, g, length/norm, cfg)
+		norm2, predicted := difference(state, candidate, g)
+		projectedMovement = math.Max(projectedMovement, norm2)
+		if norm2 < 1e-18 {
+			continue
+		}
+		candidateValue, _, err := c.evaluate(candidate, false)
+		if err != nil {
+			return state, value, false, false, err
+		}
+		if cfg.LineSearch && candidateValue < value+1e-4*predicted {
+			continue
+		}
+		if candidateValue > bestValue+1e-12*(1+math.Abs(bestValue)) {
+			best, bestValue = candidate, candidateValue
+		}
+	}
+	return best, bestValue, best != state, projectedMovement < 1e-14, nil
+}
+
+func spectralStep(c *counter, state State, value float64, g [4][10]float64, step float64, cfg Config) (State, float64, bool, bool, error) {
+	continuousCfg := cfg
+	continuousCfg.GridEachStep = false
+	base := proposal(state, g, initialStep(state, g), continuousCfg)
+	baseMovement, _ := difference(state, base, g)
+	if baseMovement < 1e-14 {
+		return state, value, false, true, nil
+	}
+	limit := 1
+	if cfg.LineSearch {
+		limit = 24
+	}
+	for trial := 0; trial < limit; trial++ {
+		candidate := proposal(state, g, step, cfg)
+		norm2, predicted := difference(state, candidate, g)
+		if norm2 < 1e-18 {
+			if cfg.GridEachStep {
+				step *= 2
+				continue
+			}
+			step *= .5
+			continue
+		}
+		candidateValue, _, err := c.evaluate(candidate, false)
+		if err != nil {
+			return state, value, false, false, err
+		}
+		threshold := value + 1e-12*(1+math.Abs(value))
+		if cfg.LineSearch {
+			threshold = math.Max(threshold, value+1e-4*predicted)
+		}
+		if candidateValue > threshold {
+			return candidate, candidateValue, true, false, nil
+		}
+		step *= .5
+	}
+	return state, value, false, false, nil
+}
+
+func spectralScale(old, next State, oldG, nextG [4][10]float64, previous float64) float64 {
+	ss, sy := 0.0, 0.0
+	for actor := range old.Upgrades {
+		for slot := range old.Upgrades[actor] {
+			for line, u := range old.Upgrades[actor][slot] {
+				stat := old.Lines[actor][slot][line]
+				d := next.Upgrades[actor][slot][line] - u
+				ss += d * d
+				sy += d * (nextG[actor][stat] - oldG[actor][stat])
+			}
+		}
+	}
+	if ss < 1e-18 {
+		return previous
+	}
+	if math.Abs(sy) < 1e-16 {
+		return math.Min(previous*2, 16*initialStep(next, nextG))
+	}
+	return math.Max(1e-12, math.Min(1e12, ss/math.Abs(sy)))
+}
+
+func roundQuarter(state State, g [4][10]float64, budget float64) State {
+	quarter := state
+	maxActorUnits := int(math.Floor((budget-20)*4 + 1e-9))
+	for actor := range quarter.Upgrades {
+		original := state.Upgrades[actor]
+		originalTotal := 0.0
+		used := 0
+		slotUsed := [5]int{}
+		deficit := [10]float64{}
+		for slot := range quarter.Upgrades[actor] {
+			for line, u := range quarter.Upgrades[actor][slot] {
+				originalTotal += u
+				units := int(math.Floor(math.Max(0, u)*4 + 1e-9))
+				quarter.Upgrades[actor][slot][line] = float64(units) / 4
+				deficit[quarter.Lines[actor][slot][line]] += u - quarter.Upgrades[actor][slot][line]
+				used += units
+				slotUsed[slot] += units
+			}
+		}
+		target := int(math.Round(originalTotal * 4))
+		if target > maxActorUnits {
+			target = maxActorUnits
+		}
+		for used < target {
+			bestSlot, bestLine := -1, -1
+			bestDeficit := math.Inf(-1)
+			bestGradient := math.Inf(-1)
+			bestRemainder := math.Inf(-1)
+			for slot := range quarter.Lines[actor] {
+				if slotUsed[slot] >= 20 {
+					continue
+				}
+				for line, stat := range quarter.Lines[actor][slot] {
+					component := g[actor][stat]
+					remainder := original[slot][line] - quarter.Upgrades[actor][slot][line]
+					if bestSlot < 0 || deficit[stat] > bestDeficit+1e-12 ||
+						(math.Abs(deficit[stat]-bestDeficit) <= 1e-12 &&
+							(component > bestGradient+1e-12 ||
+								(math.Abs(component-bestGradient) <= 1e-12 && remainder > bestRemainder+1e-12))) {
+						bestDeficit = deficit[stat]
+						bestGradient = component
+						bestRemainder = remainder
+						bestSlot, bestLine = slot, line
+					}
+				}
+			}
+			if bestSlot < 0 {
+				break
+			}
+			quarter.Upgrades[actor][bestSlot][bestLine] += .25
+			deficit[quarter.Lines[actor][bestSlot][bestLine]] -= .25
+			slotUsed[bestSlot]++
+			used++
+		}
+	}
+	return quarter
+}
+
+type quarterTransfer struct {
+	actor, fromSlot, fromLine, toSlot, toLine int
+	predicted                                 float64
+}
+
+// polishQuarter searches bounded same-actor quarter transfers and single-unit
+// additions/removals. Gradient ranking keeps this repair cheap; actual scores
+// decide every accepted move.
+func polishQuarter(c *counter, state State, value, budget float64) (State, float64, error) {
+	const (
+		maxRounds    = 3
+		maxProposals = 96
+	)
+	for round := 0; round < maxRounds; round++ {
+		_, gradient, err := c.evaluate(state, true)
+		if err != nil {
+			return state, value, err
+		}
+		proposals := make([]quarterTransfer, 0, 1600)
+		for actor := range state.Upgrades {
+			actorTotal := 0.0
+			var slotSums [5]float64
+			for slot := range state.Upgrades[actor] {
+				for _, u := range state.Upgrades[actor][slot] {
+					slotSums[slot] += u
+					actorTotal += u
+				}
+			}
+			if actorTotal+.25 <= budget-20+1e-9 {
+				for toSlot := range state.Upgrades[actor] {
+					if slotSums[toSlot]+.25 > 5+1e-9 {
+						continue
+					}
+					for toLine, stat := range state.Lines[actor][toSlot] {
+						proposals = append(proposals, quarterTransfer{
+							actor: actor, fromSlot: -1, toSlot: toSlot,
+							toLine: toLine, predicted: gradient[actor][stat],
+						})
+					}
+				}
+			}
+			for fromSlot := range state.Upgrades[actor] {
+				for fromLine, from := range state.Upgrades[actor][fromSlot] {
+					if from < .25-1e-9 {
+						continue
+					}
+					fromStat := state.Lines[actor][fromSlot][fromLine]
+					proposals = append(proposals, quarterTransfer{
+						actor: actor, fromSlot: fromSlot, fromLine: fromLine,
+						toSlot: -1, predicted: -gradient[actor][fromStat],
+					})
+					for toSlot := range state.Upgrades[actor] {
+						if toSlot != fromSlot && slotSums[toSlot]+.25 > 5+1e-9 {
+							continue
+						}
+						for toLine, toStat := range state.Lines[actor][toSlot] {
+							if fromSlot == toSlot && fromLine == toLine || fromStat == toStat {
+								continue
+							}
+							proposals = append(proposals, quarterTransfer{
+								actor: actor, fromSlot: fromSlot, fromLine: fromLine,
+								toSlot: toSlot, toLine: toLine,
+								predicted: gradient[actor][toStat] - gradient[actor][fromStat],
+							})
+						}
+					}
+				}
+			}
+		}
+		sort.SliceStable(proposals, func(i, j int) bool { return proposals[i].predicted > proposals[j].predicted })
+		if len(proposals) > maxProposals {
+			proposals = proposals[:maxProposals]
+		}
+		best, bestValue := state, value
+		for _, move := range proposals {
+			candidate := state
+			if move.fromSlot >= 0 {
+				candidate.Upgrades[move.actor][move.fromSlot][move.fromLine] -= .25
+			}
+			if move.toSlot >= 0 {
+				candidate.Upgrades[move.actor][move.toSlot][move.toLine] += .25
+			}
+			candidateValue, _, err := c.evaluate(candidate, false)
+			if err != nil {
+				return state, value, err
+			}
+			if candidateValue > bestValue+1e-12*(1+math.Abs(bestValue)) {
+				best, bestValue = candidate, candidateValue
+			}
+		}
+		if best == state {
+			break
+		}
+		state, value = best, bestValue
+	}
+	return state, value, state.Validate(budget, true)
+}
