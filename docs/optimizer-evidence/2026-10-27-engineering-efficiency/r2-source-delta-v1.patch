+
+const typedHealBoundary = "neutral heal amount has no bound health-operation expression"
+
+func TestRuleTypedUnknownAssertionsAndCopies(t *testing.T) {
+	vm := testRule(t, `
+type Box struct { amount float64 }
+func carry(x float64) float64 { return x }
+func Start(x any, relevant bool) any {
+ amount := x.(float64)
+ var copied float64 = carry(amount)
+ a := Box{amount: copied}
+ b := a
+ if !relevant { return b.amount }
+ return b.amount > 0
+}`, nil)
+	for _, observed := range []float64{0, 5000} {
+		u := unboundRuleNumber(ruleTypedNumber{observed, "float64"}, typedHealBoundary)
+		got, err := vm.entry("Start", u, false)
+		if err != nil || got != (ruleTypedUnknown{typedHealBoundary, "float64"}) {
+			t.Fatalf("assertion/copy lost opaque type: got=%#v err=%v", got, err)
+		}
+		if _, err := vm.entry("Start", u, true); err == nil || !strings.Contains(err.Error(), typedHealBoundary) {
+			t.Fatalf("copied unbound amount became a condition: %v", err)
+		}
+	}
+}
+
+func TestRuleTypedUnknownRequiresWireType(t *testing.T) {
+	vm := testRule(t, `func Start(x any) bool { _ = x.(float64); return true }`, nil)
+	for _, value := range []any{
+		float64(0), ruleTypedNumber{0, ""}, ruleTypedNumber{math.NaN(), "float64"},
+		ruleTypedNumber{math.Inf(1), "float64"}, ruleUnknown{"missing value"},
+	} {
+		u := unboundRuleNumber(value, typedHealBoundary)
+		if _, ok := u.(ruleUnknown); !ok {
+			t.Fatalf("unproved numeric type was inferred: %#v", u)
+		}
+		if _, err := vm.entry("Start", u); err == nil || !strings.Contains(err.Error(), typedHealBoundary) {
+			t.Fatalf("untyped assertion became known: %v", err)
+		}
+	}
+	for _, typ := range []string{"int", "sample.NamedFloat"} {
+		if _, err := vm.entry("Start", ruleTypedUnknown{typedHealBoundary, typ}); err == nil || !strings.Contains(err.Error(), "type assertion failed") {
+			t.Fatalf("distinct dynamic type %q matched float64: %v", typ, err)
+		}
+	}
+}
+
+func TestRuleTypedUnknownCommaOKZero(t *testing.T) {
+	vm := testRule(t, `
+func box(x any) any { return x }
+func Start(x any) []any {
+ n, ok := x.(int)
+ boxed := box(n)
+ _, isInt := boxed.(int)
+ _, isFloat := boxed.(float64)
+ text, textOK := x.(string)
+ flag, flagOK := x.(bool)
+ original, anyOK := x.(any)
+ return []any{n, ok, isInt, isFloat, text, textOK, flag, flagOK, original, anyOK}
+}`, nil)
+	unknown := ruleTypedUnknown{typedHealBoundary, "float64"}
+	got, err := vm.entry("Start", unknown)
+	want := []any{ruleTypedNumber{0, "int"}, false, true, false, "", false, false, false, unknown, true}
+	if err != nil || !reflect.DeepEqual(ruleArray(got), want) {
+		t.Fatalf("failed assertion did not produce typed Go zero: got=%#v err=%v", got, err)
+	}
+	matched := testRule(t, `func Start(x any) []any { n, ok := x.(float64); return []any{n, ok} }`, nil)
+	got, err = matched.entry("Start", unknown)
+	if err != nil || !reflect.DeepEqual(ruleArray(got), []any{unknown, true}) {
+		t.Fatalf("matching comma-ok consumed the number: got=%#v err=%v", got, err)
+	}
+	if _, err := vm.entry("Start", ruleUnknown{typedHealBoundary}); err == nil {
+		t.Fatal("generic unknown became a known failed assertion")
+	}
+}
+
+func TestRuleTypedUnknownConsumptionFails(t *testing.T) {
+	for _, body := range []string{
+		`return x.(float64) + 1`,
+		`return x.(float64) * 0`,
+		`return x.(float64) - x.(float64)`,
+		`return math.Abs(x.(float64))`,
+		`return float64(x.(float64))`,
+		`return int(x.(float64))`,
+		`return x == nil`,
+		`return nil == x`,
+		`return x == x`,
+		`return x.(float64) != 0`,
+		`return x.(float64) + s`,
+		`return s * x.(float64)`,
+		`return x.(float64) < s`,
+		`if s <= x.(float64) { return 1 }; return 1`,
+	} {
+		t.Run(body, func(t *testing.T) {
+			vm := testRule(t, `import "math"; func Start(x any, s float64) any { `+body+` }`, nil)
+			_, err := vm.entry("Start", ruleTypedUnknown{typedHealBoundary, "float64"}, &RuleScalar{Operation: "constant", Value: 1})
+			if err == nil || !strings.Contains(err.Error(), typedHealBoundary) {
+				t.Fatalf("unbound numeric use escaped its boundary: %v", err)
+			}
+		})
+	}
+}
+
+func TestRuleTypedUnknownDoesNotMatchPointer(t *testing.T) {
+	commaOK := testRule(t, `func Start(x any) bool { p, ok := x.(*float64); return !ok && p == nil }`, nil)
+	single := testRule(t, `func Start(x any) bool { _ = x.(*float64); return true }`, nil)
+	for _, value := range []any{ruleTypedUnknown{typedHealBoundary, "float64"}, ruleTypedNumber{0, "float64"}} {
+		if got, err := commaOK.entry("Start", value); err != nil || got != true {
+			t.Fatalf("numeric type matched a pointer: got=%v err=%v", got, err)
+		}
+		if _, err := single.entry("Start", value); err == nil || !strings.Contains(err.Error(), "type assertion failed") {
+			t.Fatalf("single pointer assertion succeeded: %v", err)
+		}
+	}
+}
+
+func TestRuleTypedUnknownInterfaceAssertions(t *testing.T) {
+	unknown := ruleTypedUnknown{typedHealBoundary, "float64"}
+	for _, target := range []string{"interface{}", "any"} {
+		t.Run(target, func(t *testing.T) {
+			// This exact guard must reach the unbound number, never return zero
+			// because an empty-interface assertion was incorrectly made false.
+			consumer := testRule(t, `func Start(x any) float64 { _,ok:=x.(`+target+`); if !ok{return 0}; return x.(float64)+1 }`, nil)
+			if _, err := consumer.entry("Start", unknown); err == nil || !strings.Contains(err.Error(), typedHealBoundary) {
+				t.Fatalf("empty-interface guard hid unknown consumption: %v", err)
+			}
+			guard := testRule(t, `func Start(x any) float64 { _,ok:=x.(`+target+`); if !ok{return 0}; return 7 }`, nil)
+			if got, err := guard.entry("Start", unknown); err != nil || got != float64(7) {
+				t.Fatalf("type-only empty-interface guard rejected: got=%v err=%v", got, err)
+			}
+			if _, err := guard.entry("Start", ruleUnknown{typedHealBoundary}); err == nil {
+				t.Fatal("generic unknown matched an empty interface")
+			}
+			carrier := testRule(t, `func Start(x any) any { value := x.(`+target+`); return value.(float64) }`, nil)
+			if got, err := carrier.entry("Start", unknown); err != nil || got != unknown {
+				t.Fatalf("interface assertion lost opaque dynamic type: got=%#v err=%v", got, err)
+			}
+		})
+	}
+	for _, target := range []string{"interface{ Mark() }", "Named", "Empty", "error"} {
+		t.Run(target, func(t *testing.T) {
+			vm := testRule(t, `type Named interface{ Mark() }; type Empty interface{}
+func Start(x any) float64 { _,ok:=x.(`+target+`); if !ok{return 0}; return x.(float64)+1 }`, nil)
+			if got, err := vm.entry("Start", unknown); err == nil || !strings.Contains(err.Error(), typedHealBoundary) {
+				t.Fatalf("unproved interface relation became a known result: got=%v err=%v", got, err)
+			}
+		})
+	}
+}
+
+func typedGuardHealEvent() contracts.CombatEvent {
+	event := targetGuardHealEvent()
+	event.Arguments[1].Type = "int"
+	for i := 2; i < len(event.Arguments); i++ {
+		event.Arguments[i].Type = "float64"
+	}
+	for _, name := range []string{"Caller", "Src", "Bonus"} {
+		value := event.Arguments[0].Fields[name]
+		value.Type = "float64"
+		if name == "Caller" {
+			value.Type = "int"
+		}
+		event.Arguments[0].Fields[name] = value
+	}
+	return event
+}
+
+// Capture-free reductions of the source callback order: the amount assertions
+// precede known identity guards. These are not health-expression certificates.
+func TestRuleTypedHealAssertionBeforeGuard(t *testing.T) {
+	for _, tc := range []struct {
+		name, body               string
+		active, owner, recipient int
+		amount, overheal         float64
+		boundary                 bool
+	}{
+		{"inactive", "mh", 2, 1, 1, 5000, 0, false},
+		{"other recipient", "mh", 1, 1, 2, 5000, 0, false},
+		{"active", "mh", 1, 1, 1, 5000, 0, true},
+		{"zero", "mh", 1, 1, 1, 0, 0, true},
+		{"full overheal", "mh", 1, 1, 1, 5000, 5000, true},
+		{"other caller", "song", 1, 2, 1, 5000, 0, false},
+		{"own caller", "song", 1, 1, 1, 5000, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			body := `
+ index := args[1].(int)
+ amount := args[2].(float64)
+ overheal := args[3].(float64)
+ if active != owner { return prior }
+ if index != owner { return prior }
+ if amount <= 0 { return prior }
+ if math.Abs(amount-overheal) <= 1e-9 { return prior }
+ return prior + 1`
+			if tc.body == "song" {
+				body = `src := args[0].(*info.HealInfo); amount := args[4].(float64); if src.Caller != owner { return prior }; return prior + amount`
+			}
+			vm := testRule(t, `import (
+ "math"
+ e "github.com/genshinsim/gcsim/pkg/core/event"
+ "github.com/genshinsim/gcsim/pkg/core/info"
+)
+func Start(active, owner int, prior float64) any { _ = e.OnHeal; return func(args ...any) float64 { `+body+` } }`, map[string][]byte{
+				"pkg/core/event/event.go": []byte("package event; const OnHeal = 7"),
+				"pkg/core/info/heal.go":   []byte("package info; type HealInfo struct { Caller int; Src, Bonus float64 }"),
+			})
+			callback, err := vm.entry("Start", float64(tc.active), float64(tc.owner), float64(7))
+			if err != nil {
+				t.Fatal(err)
+			}
+			host := &ruleReplayHost{vm: vm, symbolic: true, uncertainty: map[string]bool{}}
+			event := typedGuardHealEvent()
+			event.Arguments[1].Number = float64(tc.recipient)
+			event.Arguments[2].Number, event.Arguments[3].Number = tc.amount, tc.overheal
+			args := make([]any, len(event.Arguments))
+			for i, value := range event.Arguments {
+				args[i] = host.wire(value)
+			}
+			got, err := ruleTry(func() any { return host.invokeEvent(ruleSubscription{vm: vm, fn: callback}, event, args) })
+			if tc.boundary {
+				if err == nil || !strings.Contains(err.Error(), typedHealBoundary) {
+					t.Fatalf("active heal became known: got=%v err=%v", got, err)
+				}
+			} else if err != nil || got != float64(7) {
+				t.Fatalf("irrelevant heal changed prior state: got=%v err=%v", got, err)
+			}
+		})
