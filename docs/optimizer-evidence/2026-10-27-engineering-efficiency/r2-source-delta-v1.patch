+		{"raw", "return args[4].(float64) > 0", true, "neutral heal amount"},
+		{"source", "return args[0].(*info.HealInfo).Src > 0", true, "neutral heal source operand"},
+		{"bonus", "return args[0].(*info.HealInfo).Bonus > 0", true, "neutral heal source operand"},
+		{"event identity", "return args[0].(*info.HealInfo).Caller == 1 && args[1].(int) == 1", true, ""},
+		{"unused amount", "if args[1].(int) != 3 { return true }; return args[4].(float64) > 0", true, ""},
+		{"ordinary observed replay", "return args[4].(float64) > 0", false, ""},
+	}
+	for _, check := range checks {
+		t.Run(check.name, func(t *testing.T) {
+			vm := testRule(t, `import (
+ e "github.com/genshinsim/gcsim/pkg/core/event"
+ "github.com/genshinsim/gcsim/pkg/core/info"
+)
+func Callback() any { _ = e.OnHeal; return func(args ...any) bool { `+check.expression+` } }`, map[string][]byte{
+				"pkg/core/event/event.go": []byte("package event; const OnHeal = 7"),
+				"pkg/core/info/heal.go":   []byte("package info; type HealInfo struct { Caller int; Src, Bonus float64 }"),
+			})
+			callback, err := vm.entry("Callback")
+			if err != nil {
+				t.Fatal(err)
+			}
+			host := &ruleReplayHost{vm: vm, symbolic: check.symbolic, uncertainty: map[string]bool{}}
+			number := func(value float64) contracts.EventValue {
+				return contracts.EventValue{Kind: "number", Number: value}
+			}
+			info := host.wire(contracts.EventValue{Kind: "object", Type: "*" + gcsimImport + "pkg/core/info.HealInfo", Fields: map[string]contracts.EventValue{
+				"Caller": number(1), "Src": number(10), "Bonus": number(.15),
+			}})
+			value, err := ruleTry(func() any {
+				return host.invokeEvent(ruleSubscription{vm: vm, fn: callback}, contracts.CombatEvent{Event: 7}, []any{
+					info, float64(1), float64(11.5), float64(0), float64(11.5),
+				})
+			})
+			if check.unknown != "" {
+				if err == nil || !strings.Contains(err.Error(), check.unknown) {
+					t.Fatalf("consumed unbound heal operand accepted: value=%v err=%v", value, err)
+				}
+			} else if err != nil || value != true {
+				t.Fatalf("independent identity/ordinary replay rejected: value=%v err=%v", value, err)
+			}
+			if !host.uncertainty["set_activation_heal_amount_frozen_to_observed_build"] {
+				t.Fatal("observed heal uncertainty provenance lost")
+			}
+		})
+	}
+}
diff --git a/internal/seteffects/theory_target_guard_test.go b/internal/seteffects/theory_target_guard_test.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/theory_target_guard_test.go
@@ -0,0 +1,271 @@
+package seteffects
+
+import (
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func targetGuardHealEvent() contracts.CombatEvent {
+	number := func(value float64) contracts.EventValue {
+		return contracts.EventValue{Kind: "number", Number: value}
+	}
+	return contracts.CombatEvent{
+		Order: 100, EndOrder: 101, Frame: 10, Active: 1, Event: 7,
+		Arguments: []contracts.EventValue{
+			{Kind: "object", Type: "*" + gcsimImport + "pkg/core/info.HealInfo", Fields: map[string]contracts.EventValue{
+				"Caller": number(1), "Src": number(10), "Bonus": number(.15),
+				"Nested": {Kind: "array", Items: []contracts.EventValue{number(3)}},
+			}},
+			number(1), number(5000), number(0), number(5000),
+		},
+	}
+}
+
+func TestRuleEmitUsesOwnedHealArgumentsAcrossSubscriptions(t *testing.T) {
+	for _, symbolic := range []bool{false, true} {
+		t.Run(map[bool]string{false: "ordinary", true: "symbolic"}[symbolic], func(t *testing.T) {
+			vm := testRule(t, `import (
+	e "github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+func Start(events any, symbolic bool) any {
+	accepted := false
+	var first, second any
+	events.Subscribe(e.OnHeal, func(args ...any) {
+		// Rebind the caller/recipient arguments and mutate fresh nested values.
+		// Event objects and arrays are intentionally read-only in this VM.
+		first = args[0]
+		args[0] = nil
+		args[1] = 99
+		nested := make([][]int, 1)
+		nested[0] = make([]int, 1)
+		nested[0][0] = 99
+		args[2] = nested
+		object := map[int]int{0: 1}
+		object[0] = 99
+		args[3] = object
+	}, "mutator")
+	events.Subscribe(e.OnHeal, func(args ...any) {
+		payload := args[0].(*info.HealInfo)
+		second = args[0]
+		accepted = payload.Caller == 1 && payload.Nested[0] == 3 && args[1].(float64) == 1
+		if !symbolic {
+			accepted = accepted && args[2].(float64) == 5000 && args[3].(float64) == 0 && args[4].(float64) == 5000
+		}
+	}, "reader")
+	return func() []any { return []any{accepted, first, second} }
+}`, map[string][]byte{
+				"pkg/core/event/event.go": []byte("package event; const OnHeal = 7"),
+				"pkg/core/info/heal.go":   []byte("package info; type HealInfo struct { Caller int; Src, Bonus float64; Nested []int }"),
+			})
+			host := &ruleReplayHost{
+				subs: map[int][]ruleSubscription{}, uncertainty: map[string]bool{}, symbolic: symbolic,
+			}
+			vm.host, host.vm = host, vm
+			accepted, err := vm.entry("Start", ruleRef{kind: "events"}, symbolic)
+			if err != nil {
+				t.Fatal(err)
+			}
+			event, original := targetGuardHealEvent(), targetGuardHealEvent()
+			if err := host.emit(event); err != nil {
+				t.Fatal(err)
+			}
+			result, err := ruleTry(func() any { return vm.invoke(accepted, nil) })
+			if err != nil {
+				t.Fatal(err)
+			}
+			captured := ruleArray(result)
+			if len(captured) != 3 || captured[0] != true {
+				t.Fatalf("second subscription saw leaked event values: captured=%v", captured)
+			}
+			first, firstOK := captured[1].(*ruleObject)
+			second, secondOK := captured[2].(*ruleObject)
+			if !firstOK || !secondOK || first == second || first.fields == nil || second.fields == nil {
+				t.Fatalf("subscriptions did not receive separate event objects: %T %T", captured[1], captured[2])
+			}
+			firstNested, firstNestedOK := first.fields["Nested"].(*ruleSlice)
+			secondNested, secondNestedOK := second.fields["Nested"].(*ruleSlice)
+			if !firstNestedOK || !secondNestedOK || firstNested == secondNested {
+				t.Fatalf("subscriptions did not receive separate nested arrays: %T %T", first.fields["Nested"], second.fields["Nested"])
+			}
+			// Mutating the first callback's captured graph through the Go test
+			// internals cannot affect the second callback's independent wire value.
+			first.fields["Caller"] = float64(99)
+			firstNested.values[0] = float64(99)
+			if ruleNumber(second.fields["Caller"]) != 1 || ruleNumber(secondNested.values[0]) != 3 {
+				t.Fatal("a mutation to one subscription's captured event leaked to another")
+			}
+			if !reflect.DeepEqual(event, original) {
+				t.Fatalf("callback changed the caller-owned CombatEvent: got=%+v want=%+v", event, original)
+			}
+			if !host.uncertainty["set_activation_heal_amount_frozen_to_observed_build"] {
+				t.Fatal("heal replay uncertainty provenance was not retained")
+			}
+		})
+	}
+}
+
+func TestRuleEmitRejectsObservedHealPayloadMutation(t *testing.T) {
+	for _, mutation := range []struct {
+		name, expression, boundary string
+	}{
+		{"object field", `args[0].(*info.HealInfo).Caller = 9`, "event payload mutation"},
+		{"nested slice", `args[0].(*info.HealInfo).Nested[0] = 9`, "event stat mutation needs a bound output expression"},
+	} {
+		t.Run(mutation.name, func(t *testing.T) {
+			vm := testRule(t, `import (
+	e "github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+func Start(events any) any {
+	secondRan := false
+	events.Subscribe(e.OnHeal, func(args ...any) { `+mutation.expression+` }, "mutator")
+	events.Subscribe(e.OnHeal, func(args ...any) { secondRan = true }, "reader")
+	return func() bool { return secondRan }
+}`, map[string][]byte{
+				"pkg/core/event/event.go": []byte("package event; const OnHeal = 7"),
+				"pkg/core/info/heal.go":   []byte("package info; type HealInfo struct { Caller int; Src, Bonus float64; Nested []int }"),
+			})
+			host := &ruleReplayHost{subs: map[int][]ruleSubscription{}, uncertainty: map[string]bool{}}
+			vm.host, host.vm = host, vm
+			secondRan, err := vm.entry("Start", ruleRef{kind: "events"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			event, original := targetGuardHealEvent(), targetGuardHealEvent()
+			err = host.emit(event)
+			if err == nil || !strings.Contains(err.Error(), mutation.boundary) {
+				t.Fatalf("observed payload mutation was not rejected: %v", err)
+			}
+			result, invokeErr := ruleTry(func() any { return vm.invoke(secondRan, nil) })
+			if invokeErr != nil || result != false {
+				t.Fatalf("later subscriber ran after rejected mutation: result=%v err=%v", result, invokeErr)
+			}
+			if !reflect.DeepEqual(event, original) {
+				t.Fatalf("rejected callback changed the caller-owned CombatEvent: got=%+v want=%+v", event, original)
+			}
+		})
+	}
+}
+
+func TestRuleActiveHealGuardOrdinaryAndSymbolicContracts(t *testing.T) {
+	catalog := activeRuleCatalog(t)
+	number := func(value float64) contracts.EventValue {
+		return contracts.EventValue{Kind: "number", Number: value}
+	}
+	onHeal := int(ruleTestConstant(t, catalog, "pkg/core/event", "OnHeal"))
+	onEnemyHit := int(ruleTestConstant(t, catalog, "pkg/core/event", "OnEnemyHit"))
+
+	t.Run("Marechaussee", func(t *testing.T) {
+		makeInputs := func() *contracts.NeutralInputs {
+			n := ruleTestNeutral()
+			n.World.States[0].Facts = ruleResourceFacts()
+			n.Hitlag = &contracts.NeutralHitlagLedger{Complete: true}
+			n.Ledger.Events = []contracts.CombatEvent{{
+				Order: 100, EndOrder: 101, Frame: 10, Active: 1, Event: onHeal,
+				Arguments: []contracts.EventValue{{Kind: "nil"}, number(1), number(5000), number(0), number(5000)},
+			}}
+			return n
+		}
+		choice := []RuleChoice{{Owner: 1, Key: "marechausseehunter", Pieces: 4}}
+		query := []RuleQuery{{Order: 200, Frame: 20, Active: 1, Owner: 1, Kind: "stat", Stat: "cr", Mode: "stat"}}
+		observed := catalog.ReplayNeutralRules(makeInputs(), choice, query)
+		if observed.Boundary != "" || len(observed.Values) != 1 || !observed.Values[0].Known || math.Abs(observed.Values[0].Value-.12) > 1e-12 {
+			t.Fatalf("ordinary observed source replay changed the .12 value: %+v", observed)
+		}
+		symbolic := catalog.CompileNeutralRules(makeInputs(), choice, query)
+		if !strings.Contains(symbolic.Boundary, "neutral heal amount has no bound health-operation expression") {
+			t.Fatalf("symbolic heal amount was not rejected at the explicit health boundary: %+v", symbolic)
+		}
+	})
+
+	t.Run("Song", func(t *testing.T) {
+		makeInputs := func() *contracts.NeutralInputs {
+			n := ruleTestNeutral()
+			n.World.States[0].Facts = ruleResourceFacts()
+			attackInfo := ruleTestAttack(1,
+				ruleTestConstant(t, catalog, "pkg/core/attacks", "AttackTagNormal"),
+				ruleTestConstant(t, catalog, "pkg/core/attributes", "Physical"))
+			attackInfo.Fields["FlatDmg"] = number(17)
+			attack := contracts.EventValue{Kind: "object", Type: "*" + gcsimImport + "pkg/core/info.AttackEvent", Fields: map[string]contracts.EventValue{
+				"Info": attackInfo, "HitID": number(7),
+			}}
+			healInfo := contracts.EventValue{Kind: "object", Type: "*" + gcsimImport + "pkg/core/info.HealInfo", Fields: map[string]contracts.EventValue{
+				"Caller": number(1),
+			}}
+			n.Ledger.Events = []contracts.CombatEvent{
+				{Order: 100, EndOrder: 101, Frame: 10, Active: 1, Event: onHeal,
+					Arguments: []contracts.EventValue{healInfo, number(1), number(5000), number(5000), number(10000)}},
+				{Order: 3900, EndOrder: 3901, Frame: 390, Active: 1, Event: onEnemyHit,
+					Arguments: []contracts.EventValue{{Kind: "nil"}, attack}},
+			}
+			return n
+		}
+		choice := []RuleChoice{{Owner: 1, Key: "songofdayspast", Pieces: 4}}
+		query := []RuleQuery{{Order: 4000, Frame: 400, Active: 1, Owner: 1, Kind: "flat_event", Stat: "FlatDmg", HitID: 7}}
+		observed := catalog.ReplayNeutralRules(makeInputs(), choice, query)
+		if observed.Boundary != "" || len(observed.Values) != 1 || !observed.Values[0].Known || observed.Values[0].Value != 800 {
+			t.Fatalf("ordinary observed source replay changed the 800 value: %+v", observed)
+		}
+		symbolic := catalog.CompileNeutralRules(makeInputs(), choice, query)
+		if !strings.Contains(symbolic.Boundary, "neutral heal amount has no bound health-operation expression") {
+			t.Fatalf("symbolic heal amount was not rejected at the explicit health boundary: %+v", symbolic)
+		}
+	})
+}
+
+// Replays the eight preserved rule_health_boundary_test.go cases without
+// taking that old uncommitted fixture as a target source prerequisite.
+func TestRuleTargetHealOperandsRequireBinding(t *testing.T) {
+	for _, tc := range []struct {
+		name, body string
+		symbolic   bool
+		boundary   string
+	}{
+		{"raw", "return args[4].(float64) > 0", true, "neutral heal amount"},
+		{"received", "return args[2].(float64) > 0", true, "neutral heal amount"},
+		{"overheal", "return args[3].(float64) > 0", true, "neutral heal amount"},
+		{"source", "return args[0].(*info.HealInfo).Src > 0", true, "neutral heal source operand"},
+		{"bonus", "return args[0].(*info.HealInfo).Bonus > 0", true, "neutral heal source operand"},
+		{"identity only", "return args[0].(*info.HealInfo).Caller == 1 && args[1].(int) == 1", true, ""},
+		{"irrelevant recipient", "if args[1].(int) != 3 { return true }; return args[4].(float64) > 0", true, ""},
+		{"observed diagnostic", "return args[4].(float64) > 0", false, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			vm := testRule(t, `import (
+	e "github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+func Start() any { _ = e.OnHeal; return func(args ...any) bool { `+tc.body+` } }`, map[string][]byte{
+				"pkg/core/event/event.go": []byte("package event; const OnHeal = 7; const OnEnemyHit = 8"),
+				"pkg/core/info/heal.go":   []byte("package info; type HealInfo struct { Caller int; Src, Bonus float64 }"),
+			})
+			callback, err := vm.entry("Start")
+			if err != nil {
+				t.Fatal(err)
+			}
+			host := &ruleReplayHost{vm: vm, symbolic: tc.symbolic, uncertainty: map[string]bool{}}
+			number := func(value float64) contracts.EventValue {
+				return contracts.EventValue{Kind: "number", Number: value}
+			}
+			payload := host.wire(contracts.EventValue{Kind: "object", Type: "*" + gcsimImport + "pkg/core/info.HealInfo", Fields: map[string]contracts.EventValue{
+				"Caller": number(1), "Src": number(10), "Bonus": number(.15),
+			}})
+			value, err := ruleTry(func() any {
+				return host.invokeEvent(ruleSubscription{vm: vm, fn: callback}, contracts.CombatEvent{Event: 7},
+					[]any{payload, float64(1), float64(11.5), float64(0), float64(11.5)})
+			})
+			if tc.boundary != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.boundary) {
+					t.Fatalf("unbound heal operand became a counterfactual value: value=%v err=%v", value, err)
+				}
+			} else if err != nil || value != true {
+				t.Fatalf("identity/observed diagnostic branch was rejected: value=%v err=%v", value, err)
+			}
+		})
+	}
+}
diff --git a/internal/supportfixture/fixture.go b/internal/supportfixture/fixture.go
new file mode 100644
--- /dev/null
+++ b/internal/supportfixture/fixture.go
@@ -0,0 +1,352 @@
+// Package supportfixture creates finite, public, synthetic optimizer inputs.
+// It is test/experiment scaffolding only: actor keys are opaque labels and no
+// character roles, profiles, equipment, or DPS values are inferred here.
+package supportfixture
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+)
+
+var stableToken = regexp.MustCompile(`^[a-z0-9][a-z0-9_.:/-]*$`)
+
+var slots = [5]string{"flower", "plume", "sands", "goblet", "circlet"}
+
+const (
+	balancedTemplate = "balanced"
+	critTemplate     = "crit"
+)
+
+// WearerSpec contains only public synthetic case inputs. Element is a
+// canonical element token (for example "pyro" or "physical"). SetUID is a
+// convenience for a uniform five-piece set declaration. SlotSetUIDs permits
+// exact caller-supplied set declarations for each slot, including 2+2+1
+// controls; when used, all five values must be present and SetUID must be empty.
+type WearerSpec struct {
+	WearerKey   string
+	Element     string
+	SetUID      string
+	SlotSetUIDs [5]string
+}
+
+// Config is deliberately limited to the four actor/element/set declarations.
+type Config struct {
+	Wearers [4]WearerSpec
+}
+
+// Fixture is a deterministic physical inventory and its declared full45
+// anchor. WearerKeys are in canonical sorted order; CandidateIDsByWearer and
+// Anchor's actor indexes follow that same order. Every physical copy has one
+// unique ID, even when two actors receive otherwise identical pieces.
+type Fixture struct {
+	WearerKeys           [4]string
+	SlotSetUIDsByWearer  [4][5]string
+	Artifacts            []contracts.Artifact
+	CandidateIDsByWearer [4][]int64
+	Anchor               domain.Assignment
+	AnchorState          theoryalloc.State
+}
+
+type substatTemplate struct {
+	kind     string
+	lines    [4]int
+	upgrades [4]float64
+}
+
+type pieceIdentity struct {
+	Slot     string                `json:"slot"`
+	SetUID   string                `json:"set_uid"`
+	Rarity   int                   `json:"rarity"`
+	Level    int                   `json:"level"`
+	MainStat contracts.StatValue   `json:"main_stat"`
+	Substats []contracts.StatValue `json:"substats"`
+}
+
+// Generate emits one public synthetic pool per wearer. For every slot it
+// covers all production legal mains, then a balanced template, a crit template
+// and one five-upgrade endpoint for each physical substat not matching main.
+// The declared anchor uses HP/ATK/ATK%/element/CD mains and equal 1.25-roll
+// upgrades across its four substats on each piece. No score or optimum is
+// fabricated.
+func Generate(config Config) (Fixture, error) {
+	var out Fixture
+	specs := append([]WearerSpec(nil), config.Wearers[:]...)
+	sort.Slice(specs, func(i, j int) bool { return specs[i].WearerKey < specs[j].WearerKey })
+
+	choices := theoryalloc.MainChoices()
+	statKeys := theoryalloc.StatKeys()
+	statValues := theoryalloc.StatValues()
+	mainValues := theoryalloc.MainValues()
+	for actor, spec := range specs {
+		if !stableToken.MatchString(spec.WearerKey) {
+			return out, fmt.Errorf("wearer %d key must be a stable lowercase token", actor)
+		}
+		if actor > 0 && specs[actor-1].WearerKey == spec.WearerKey {
+			return out, fmt.Errorf("wearer keys must be distinct")
+		}
+		setUIDs, err := declaredSetUIDs(spec)
+		if err != nil {
+			return out, fmt.Errorf("wearer %s: %w", spec.WearerKey, err)
+		}
+		out.WearerKeys[actor] = spec.WearerKey
+		out.SlotSetUIDsByWearer[actor] = setUIDs
+	}
+
+	nextID := int64(1)
+	for actor, spec := range specs {
+		anchorMains, err := declaredAnchorMains(spec.Element, choices)
+		if err != nil {
+			return Fixture{}, fmt.Errorf("wearer %s: %w", spec.WearerKey, err)
+		}
+		out.AnchorState.Mains[actor] = anchorMains
+		seenPieces := make(map[string]int64)
+
+		for slot, legalMains := range choices {
+			for _, main := range legalMains {
+				if _, exists := mainValues[main]; !exists {
+					return Fixture{}, fmt.Errorf("production main %q has no value", main)
+				}
+				templates, err := makeTemplates(main, statKeys)
+				if err != nil {
+					return Fixture{}, fmt.Errorf("slot %s main %s: %w", slots[slot], main, err)
+				}
+				for _, template := range templates {
+					artifact, identity, err := makeArtifact(nextID, slots[slot], out.SlotSetUIDsByWearer[actor][slot], main,
+						template, mainValues, statKeys, statValues)
+					if err != nil {
+						return Fixture{}, fmt.Errorf("wearer %s slot %s: %w", spec.WearerKey, slots[slot], err)
+					}
+					identityJSON, err := contracts.CanonicalJSON(identity)
+					if err != nil {
+						return Fixture{}, fmt.Errorf("encode synthetic piece identity: %w", err)
+					}
+					identityKey := string(identityJSON)
+					id, exists := seenPieces[identityKey]
+					if !exists {
+						if nextID <= 0 {
+							return Fixture{}, fmt.Errorf("synthetic artifact ID space exhausted")
+						}
+						id = nextID
+						artifact.ArtifactID = id
+						nextID++
+						seenPieces[identityKey] = id
+						out.Artifacts = append(out.Artifacts, artifact)
+						out.CandidateIDsByWearer[actor] = append(out.CandidateIDsByWearer[actor], id)
+					}
+					if main == anchorMains[slot] && template.kind == balancedTemplate {
+						out.Anchor[actor][slot] = id
+						for line, stat := range template.lines {
+							out.AnchorState.Lines[actor][slot][line] = stat
+							out.AnchorState.Upgrades[actor][slot][line] = template.upgrades[line]
+						}
+					}
+				}
+			}
+		}
+	}
+	if err := theoryalloc.ValidateFull45(out.AnchorState); err != nil {
+		return Fixture{}, fmt.Errorf("generated anchor is not a legal full45 witness: %w", err)
+	}
+	for actor := range out.Anchor {
+		for slot, id := range out.Anchor[actor] {
+			if id <= 0 {
+				return Fixture{}, fmt.Errorf("anchor is missing wearer %s slot %s", out.WearerKeys[actor], slots[slot])
+			}
+		}
+	}
+	return out, nil
+}
+
+func declaredSetUIDs(spec WearerSpec) ([5]string, error) {
+	var setUIDs [5]string
+	explicit := false
+	for _, setUID := range spec.SlotSetUIDs {
+		explicit = explicit || setUID != ""
+	}
+	if explicit {
+		if spec.SetUID != "" {
+			return setUIDs, fmt.Errorf("use either uniform set UID or exact slot set UIDs, not both")
+		}
+		for slot, setUID := range spec.SlotSetUIDs {
+			if !stableToken.MatchString(setUID) {
+				return [5]string{}, fmt.Errorf("slot %s set UID must be a stable lowercase token", slots[slot])
+			}
+		}
+		return spec.SlotSetUIDs, nil
+	}
+	if !stableToken.MatchString(spec.SetUID) {
+		return setUIDs, fmt.Errorf("set UID must be a stable lowercase token")
+	}
+	for slot := range setUIDs {
+		setUIDs[slot] = spec.SetUID
+	}
+	return setUIDs, nil
+}
+
+func declaredAnchorMains(element string, choices [5][]string) ([5]string, error) {
+	element = strings.ToLower(strings.TrimSpace(element))
+	elementMain := element + "_damage_bonus"
+	anchor := [5]string{"hp", "atk", "atk_percent", elementMain, "crit_damage"}
+	for slot, main := range anchor {
+		legal := false
+		for _, choice := range choices[slot] {
+			if choice == main {
+				legal = true
+				break
+			}
+		}
+		if !legal {
+			return [5]string{}, fmt.Errorf("anchor main %q is not a production-legal main for slot %s", main, slots[slot])
+		}
+	}
+	return anchor, nil
+}
+
+func makeTemplates(main string, keys [10]string) ([]substatTemplate, error) {
+	eligible := make([]int, 0, len(keys))
+	keyIndex := make(map[string]int, len(keys))
+	for index, key := range keys {
+		keyIndex[key] = index
+		if key != main {
+			eligible = append(eligible, index)
+		}
+	}
+	if len(eligible) < 4 {
+		return nil, fmt.Errorf("fewer than four legal substats remain")
+	}
+
+	balanced := substatTemplate{kind: balancedTemplate}
+	copy(balanced.lines[:], eligible[:4])
+	for line := range balanced.upgrades {
+		balanced.upgrades[line] = 1.25
+	}
+
+	critLines := make([]int, 0, 4)
+	for _, key := range []string{"crit_damage", "crit_rate"} {
+		if index, exists := keyIndex[key]; exists && key != main {
+			critLines = append(critLines, index)
+		}
+	}
+	for _, index := range eligible {
+		if len(critLines) == 4 {
+			break
+		}
+		if !containsLine(critLines, index) {
+			critLines = append(critLines, index)
+		}
+	}
+	sort.Ints(critLines)
+	crit := substatTemplate{kind: critTemplate}
+	copy(crit.lines[:], critLines)
+	critLineCount := 0
+	for _, index := range critLines {
+		if keys[index] == "crit_damage" || keys[index] == "crit_rate" {
+			critLineCount++
+		}
+	}
+	if critLineCount == 2 {
+		for line, index := range critLines {
+			if keys[index] == "crit_damage" || keys[index] == "crit_rate" {
+				crit.upgrades[line] = 2.5
+			}
+		}
+	} else {
+		allocated := false
+		filler := []int{}
+		for line, index := range critLines {
+			if !allocated && (keys[index] == "crit_damage" || keys[index] == "crit_rate") {
+				crit.upgrades[line] = 2.5
+				allocated = true
+			} else {
+				filler = append(filler, line)
+			}
+		}
+		if !allocated || len(filler) != 3 {
+			return nil, fmt.Errorf("could not form the generic crit template")
+		}
+		crit.upgrades[filler[0]] = 1
+		crit.upgrades[filler[1]] = .75
+		crit.upgrades[filler[2]] = .75
+	}
+
+	out := []substatTemplate{balanced, crit}
+	for _, target := range eligible {
+		lines := []int{target}
+		for _, candidate := range eligible {
+			if candidate == target || len(lines) == 4 {
+				continue
+			}
+			lines = append(lines, candidate)
+		}
+		sort.Ints(lines)
+		endpoint := substatTemplate{kind: "endpoint"}
+		copy(endpoint.lines[:], lines)
+		for line, index := range endpoint.lines {
+			if index == target {
+				endpoint.upgrades[line] = 5
+			}
+		}
+		out = append(out, endpoint)
+	}
+	return out, nil
+}
+
+func containsLine(values []int, wanted int) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func makeArtifact(id int64, slot, setUID, main string, template substatTemplate,
+	mainValues map[string]float64, keys [10]string, values [10]float64,
+) (contracts.Artifact, pieceIdentity, error) {
+	var artifact contracts.Artifact
+	mainValue, exists := mainValues[main]
+	if !exists || !finitePositive(mainValue) {
+		return artifact, pieceIdentity{}, fmt.Errorf("missing finite main value for %q", main)
+	}
+	artifact = contracts.Artifact{
+		ArtifactID: id,
+		Slot:       slot,
+		SetUID:     setUID,
+		Rarity:     5,
+		Level:      20,
+		MainStat:   contracts.StatValue{Key: main, Value: decimal(mainValue)},
+		Substats:   make([]contracts.StatValue, 0, 4),
+	}
+	for line, statIndex := range template.lines {
+		if statIndex < 0 || statIndex >= len(keys) || keys[statIndex] == main || !finiteNonnegative(template.upgrades[line]) {
+			return contracts.Artifact{}, pieceIdentity{}, fmt.Errorf("invalid generated substat template")
+		}
+		value := values[statIndex] * (1 + template.upgrades[line])
+		if !finitePositive(values[statIndex]) || !finitePositive(value) {
+			return contracts.Artifact{}, pieceIdentity{}, fmt.Errorf("invalid generated value for substat %q", keys[statIndex])
+		}
+		artifact.Substats = append(artifact.Substats, contracts.StatValue{Key: keys[statIndex], Value: decimal(value)})
+	}
+	sort.Slice(artifact.Substats, func(i, j int) bool { return artifact.Substats[i].Key < artifact.Substats[j].Key })
+	identity := pieceIdentity{Slot: slot, SetUID: setUID, Rarity: 5, Level: 20,
+		MainStat: artifact.MainStat, Substats: append([]contracts.StatValue(nil), artifact.Substats...)}
+	return artifact, identity, nil
+}
+
+func decimal(value float64) string { return strconv.FormatFloat(value, 'f', -1, 64) }
+
+func finitePositive(value float64) bool {
+	return value > 0 && !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func finiteNonnegative(value float64) bool {
+	return value >= 0 && !math.IsNaN(value) && !math.IsInf(value, 0)
+}
