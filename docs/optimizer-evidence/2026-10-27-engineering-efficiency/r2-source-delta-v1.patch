+func TestFormulaWorldSupportCoverageIsDetachedAcrossResponseForks(t *testing.T) {
+	world, _, family := compiledTheoryWorld(t, false)
+	defer world.Close()
+	packages := [4]domain.Package{}
+	world.targets[theorypackages.Key(packages)] = targetEntry{family: family, context: "fixture-context", codes: []string{"opaque_fixture"}}
+	world.entries[family].coverage = supportimpact.Report{Coordinates: []supportimpact.Coordinate{
+		{Key: "actor_a.hp", Owner: "actor_a", Recipients: []string{"actor_b"}},
+	}}
+	coverage, err := world.SupportCoverage(context.Background(), packages)
+	if err != nil || !coverage.NeedsResponseCheck() || coverage.GraphScope != "neutral_reference_only" {
+		t.Fatal("parametric uncertainty lost from response coverage", coverage, err)
+	}
+	coverage.Coordinates[0].Recipients[0] = "changed"
+	fork, err := world.Fork()
+	if err != nil {
+		t.Fatal(err)
+	}
+	branch := fork.(*FormulaWorld)
+	defer branch.Close()
+	branch.entries[family].coverage.Coordinates[0].Recipients[0] = "fork_changed"
+	again, err := world.SupportCoverage(context.Background(), packages)
+	if err != nil || again.Coordinates[0].Recipients[0] != "actor_b" {
+		t.Fatal("response coverage mutation entered the search branch", again, err)
+	}
+	world.Close()
+	if _, err := world.SupportCoverage(context.Background(), packages); err == nil {
+		t.Fatal("closed universe still supplies response coverage")
+	}
+}
