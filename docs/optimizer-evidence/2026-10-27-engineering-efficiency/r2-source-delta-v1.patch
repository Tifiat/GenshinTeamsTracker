+// prepareMechanicProgram consumes the saved symbol plan before ordinary source
+// compilation. The two errors distinguish an unusable rule from optional IR
+// analysis failure; the latter never makes a valid gameplay rule unavailable.
+func prepareMechanicProgram(sources, libraries map[string][]byte, repository *ruleRepository, operations ruleOperationIndex, engine contracts.EngineBinding, catalogSHA string, cache *RuleParseCache) (*ruleProgram, *MechanicIR, string, error, error) {
+	entry, entryErr := mechanicPlanEntry(sources)
+	var compileContext *mechanicCompileContext
+	compile := func() (*ruleProgram, error) {
+		before := RuleParseCacheStats{}
+		if cache != nil {
+			before = cache.Stats()
+		}
+		p, err := compileRuleProgramCached(sources, libraries, cache)
+		if err != nil && cache != nil {
+			after := cache.Stats()
+			if after.WritableHits > before.WritableHits || after.BundledHits > before.BundledHits {
+				fresh := make(map[string][]byte, len(sources)+len(libraries))
+				for name, body := range sources {
+					fresh[name] = body
+				}
+				for name, body := range libraries {
+					fresh[name] = body
+				}
+				_ = cache.invalidateSources(fresh)
+				p, err = compileRuleProgramCached(sources, libraries, cache)
+			}
+		}
+		if p != nil {
+			p.repository, p.parseCache, p.operations = repository, cache, operations
+			p.mechanicContext = compileContext
+		}
+		return p, err
+	}
+	if entryErr != nil {
+		p, err := compile()
+		return p, nil, "", nil, err
+	}
+	key, closure, profile, abi, keyErr := mechanicIRKey(entry, repository, operations, engine, catalogSHA, sources, libraries)
+	if keyErr != nil {
+		p, err := compile()
+		return p, nil, "", keyErr, err
+	}
+	boundEngine := engine
+	boundEngine.Capabilities = append([]string(nil), engine.Capabilities...)
+	compileContext = &mechanicCompileContext{Engine: boundEngine, CatalogSHA256: catalogSHA, SourceClosureSHA256: closure, BuildProfileSHA256: profile, OperationABISHA256: abi}
+	expected := MechanicIR{Role: mechanicIRRootRole, Entry: entry, SourceClosureSHA256: closure, BuildProfileSHA256: profile, OperationABISHA256: abi}
+	var cold *ruleProgram
+	build := func() (MechanicIR, error) {
+		var err error
+		cold, err = compile()
+		if err != nil {
+			return MechanicIR{}, err
+		}
+		return buildMechanicIR(cold, repository, operations, closure, profile, abi)
+	}
+	ir, origin, err := cache.loadMechanicIR(key, expected, build)
+	if err != nil {
+		if cold != nil {
+			return cold, nil, "source", err, nil
+		}
+		return nil, nil, "", nil, err
+	}
+	if cold != nil {
+		return cold, &ir, origin, nil, nil
+	}
+	bound, bindErr := bindMechanicModulePlan(ir, sources, libraries, repository, operations, cache)
+	if bindErr == nil {
+		bound.mechanicContext = compileContext
+		return bound, &ir, origin, nil, nil
+	}
+	cache.invalidateMechanicModulePlan(key)
+	cold, err = compile()
+	if err != nil {
+		return nil, nil, "", nil, err
+	}
+	ir, err = buildMechanicIR(cold, repository, operations, closure, profile, abi)
+	if err != nil {
+		return cold, nil, "source", err, nil
+	}
+	cache.storeMechanicModulePlan(key, ir)
+	return cold, &ir, "source", nil, nil
+}
+
+// A lazy dependency is a source package, never an entry set. Its saved plan
+// contains declaration indices only; each caller receives a newly bound module
+// and its own VM globals. In particular, dependency init cannot inherit the
+// entry package's NewSet registration exception.
+func prepareMechanicDependency(files map[string][]byte, repository *ruleRepository, operations ruleOperationIndex, context *mechanicCompileContext, cache *RuleParseCache) (*ruleProgram, error) {
+	compile := func() (*ruleProgram, error) {
+		before := RuleParseCacheStats{}
+		if cache != nil {
+			before = cache.Stats()
+		}
+		p, err := compileRuleProgramCached(files, nil, cache)
+		if err != nil && cache != nil {
+			after := cache.Stats()
+			if after.WritableHits > before.WritableHits || after.BundledHits > before.BundledHits {
+				_ = cache.invalidateSources(files)
+				p, err = compileRuleProgramCached(files, nil, cache)
+			}
+		}
+		if err != nil {
+			return nil, err
+		}
+		p.repository, p.parseCache, p.operations, p.mechanicContext = repository, cache, operations, context
+		for _, module := range p.modules {
+			module.initializationUnsafe = false
+			for _, init := range module.initializers {
+				if !ruleInitializerInert(init) {
+					module.initializationUnsafe = true
+				}
+			}
+		}
+		return p, nil
+	}
+	if context == nil || repository == nil || context.SourceClosureSHA256=="" || context.BuildProfileSHA256=="" || context.OperationABISHA256=="" || context.Engine.ArtifactSHA256=="" || context.Engine.SourceManifestSHA256=="" || context.CatalogSHA256=="" {
+		return compile()
+	}
+	entry, err := mechanicPlanEntry(files)
+	if err != nil {
+		return compile()
+	}
+	key, closure, profile, abi, err := mechanicIRKeyRole(mechanicIRDependencyRole, entry, repository, operations, context.Engine, context.CatalogSHA256, files, nil)
+	if err != nil || profile != context.BuildProfileSHA256 || abi != context.OperationABISHA256 {
+		return compile()
+	}
+	expected := MechanicIR{Role: mechanicIRDependencyRole, Entry: entry, SourceClosureSHA256: closure, BuildProfileSHA256: profile, OperationABISHA256: abi}
+	var cold *ruleProgram
+	build := func() (MechanicIR, error) {
+		var err error
+		cold, err = compile()
+		if err != nil {
+			return MechanicIR{}, err
+		}
+		plan, err := buildMechanicModulePlanRole(cold, mechanicIRDependencyRole)
+		if err != nil {
+			return MechanicIR{}, err
+		}
+		return MechanicIR{Schema: mechanicIRSchema, Compiler: mechanicIRCompiler, Role: mechanicIRDependencyRole, Entry: entry, SourceClosureSHA256: closure, BuildProfileSHA256: profile, OperationABISHA256: abi, ModulePlan: &plan, Coverage: MechanicIRCoverage{Parse: "parsed", Link: "linked", Semantics: "partial", Runtime: "unverified"}}, nil
+	}
+	ir, _, err := cache.loadMechanicIR(key, expected, build)
+	if err != nil {
+		if cold != nil {
+			return cold, nil
+		}
+		return nil, err
+	}
+	if cold != nil {
+		return cold, nil
+	}
+	bound, bindErr := bindMechanicModulePlan(ir, files, nil, repository, operations, cache)
+	if bindErr == nil {
+		bound.mechanicContext = context
+		return bound, nil
+	}
+	cache.invalidateMechanicModulePlan(key)
+	cold, err = compile()
+	if err != nil {
+		return nil, err
+	}
+	plan, err := buildMechanicModulePlanRole(cold, mechanicIRDependencyRole)
+	if err != nil {
+		return cold, nil
+	}
+	ir.ModulePlan = &plan
+	cache.storeMechanicModulePlan(key, ir)
+	return cold, nil
+}
