+func TestMechanicIRCleanupRemovesOrphanOnly(t *testing.T) {
+	dir := t.TempDir()
+	key := strings.Repeat("e", 64)
+	orphan := filepath.Join(dir, ".tmp-"+key+"-old.gttir")
+	recent := filepath.Join(dir, ".tmp-"+key+"-recent.gttir")
+	foreign := filepath.Join(dir, "unrelated.gttir")
+	for _, name := range []string{orphan, recent, foreign} {
+		if err := os.WriteFile(name, []byte("x"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	old := time.Now().Add(-2 * ruleParseCacheOrphanAge)
+	if err := os.Chtimes(orphan, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if err := cleanupMechanicIR(dir); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(orphan); !os.IsNotExist(err) {
+		t.Fatalf("orphan remains: %v", err)
+	}
+	for _, name := range []string{recent, foreign} {
+		if _, err := os.Stat(name); err != nil {
+			t.Fatalf("removed live/foreign file %q: %v", name, err)
+		}
+	}
+}
