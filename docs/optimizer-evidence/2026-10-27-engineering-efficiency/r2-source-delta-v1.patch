+func earlyAppendReason(row *earlyPreparationRowState, reason string) {
+	for _, old := range row.row.Reasons {
+		if old == reason {
+			return
+		}
+	}
+	row.row.Reasons = append(row.row.Reasons, reason)
+}
+
+func earlyPreparationCeilDiv(n, d int) int {
+	if n <= 0 {
+		return 0
+	}
+	return (n + d - 1) / d
+}
+
+// The pure selector has no score/evaluator dependency and uses only the
+// supplied current-block proxy priorities. Priority errors are mandatory,
+// fail-closed admissions; no heuristic exclusion is called proven.
+func selectEarlyPreparation(feasible []domain.Package, current domain.Package, proxies map[string]float64, priorityErrors map[string]string) (*earlyPreparationBlock, error) {
+	block := &earlyPreparationBlock{feasible: append([]domain.Package(nil), feasible...), byKey: map[string]*earlyPreparationRowState{}}
+	if len(feasible) == 0 {
+		block.initialDone = true
+		block.summary.Status = "empty_catalog"
+		return block, nil
+	}
+	currentKey := current.Key()
+	for _, pack := range feasible {
+		key := pack.Key()
+		if key == "" {
+			return nil, fmt.Errorf("early_preparation_empty_package_key")
+		}
+		if _, exists := block.byKey[key]; exists {
+			return nil, fmt.Errorf("early_preparation_duplicate_package_key: %s", key)
+		}
+		row := &earlyPreparationRowState{pack: pack}
+		row.row = earlyPreparationLedgerRow{
+			Schema: earlyPreparationSchema, PackageKey: key, Package: pack,
+			Category: earlyPreparationCategory(pack),
+			Reasons:  []string{}, Decision: "not_prepared_unknown",
+			PreparationStatus: "not_attempted_unknown",
+		}
+		if v, ok := proxies[key]; ok && !math.IsNaN(v) && !math.IsInf(v, 0) {
+			row.proxy, row.hasProxy = v, true
+			value := v
+			row.row.ProxyPriority = &value
+		}
+		row.row.PriorityError = priorityErrors[key]
+		block.rows = append(block.rows, row)
+		block.byKey[key] = row
+		if row.row.Category == "two_plus_two" {
+			block.summary.TwoPlusTwoPackages++
+		}
+		if row.row.Category == "none" || row.row.Category == "two_piece" || row.row.Category == "four_piece" {
+			row.initial = true
+			earlyAppendReason(row, "mandatory_package_category")
+		}
+		if row.row.Category == "unexpected_fail_closed" {
+			row.initial = true
+			earlyAppendReason(row, "unexpected_package_category_fail_closed")
+		}
+		if key == currentKey {
+			row.initial = true
+			earlyAppendReason(row, "current_package_mandatory")
+		}
+		if row.row.PriorityError != "" {
+			row.initial = true
+			earlyAppendReason(row, "priority_or_fixed_reservation_error_fail_closed")
+		}
+		if row.row.Category == "two_plus_two" && !row.hasProxy && row.row.PriorityError == "" {
+			row.initial = true
+			row.row.PriorityError = "missing_or_nonfinite_priority_fail_closed"
+			earlyAppendReason(row, "priority_or_fixed_reservation_error_fail_closed")
+		}
+	}
+	if _, ok := block.byKey[currentKey]; !ok {
+		// The current package is not silently replaced by a guessed package.
+		for _, row := range block.rows {
+			row.initial = true
+			earlyAppendReason(row, "current_package_missing_fail_closed_full_catalog")
+		}
+		block.fallback = true
+	}
+
+	type ranked struct{ row *earlyPreparationRowState }
+	var rankedPairs []ranked
+	for _, row := range block.rows {
+		if row.row.Category == "two_plus_two" && row.hasProxy && row.row.PriorityError == "" {
+			rankedPairs = append(rankedPairs, ranked{row: row})
+		}
+	}
+	sort.SliceStable(rankedPairs, func(i, j int) bool {
+		if rankedPairs[i].row.proxy != rankedPairs[j].row.proxy {
+			return rankedPairs[i].row.proxy > rankedPairs[j].row.proxy
+		}
+		return rankedPairs[i].row.row.PackageKey < rankedPairs[j].row.row.PackageKey
+	})
+	for rank, item := range rankedPairs {
+		value := rank + 1
+		item.row.row.Rank = &value
+	}
+	block.summary.FeasiblePackages = len(block.rows)
+	for _, row := range block.rows {
+		if row.initial {
+			block.summary.MandatoryPackages++
+		}
+	}
+
+	if block.fallback {
+		for _, row := range block.rows {
+			row.initial = true
+			row.row.InitialAdmitted = true
+			row.row.SelectedForPreparation = true
+			row.row.Decision = "selector_fail_closed_admitted"
+			block.order = append(block.order, row.pack)
+		}
+		block.summary.MandatoryPackages = len(block.rows)
+		block.summary.InitiallyAdmittedPackages = len(block.order)
+		block.summary.Status = "fail_closed_full_catalog"
+		return block, nil
+	}
+
+	selected := map[string]bool{}
+	appendPass := func(pass string, wanted map[string]bool) {
+		for _, candidate := range block.rows {
+			key := candidate.row.PackageKey
+			if !wanted[key] {
+				continue
+			}
+			earlyAppendReason(candidate, pass)
+			if selected[key] {
+				continue
+			}
+			selected[key] = true
+			candidate.initial = true
+			candidate.row.InitialAdmitted = true
+			candidate.row.SelectedForPreparation = true
+			candidate.row.Decision = "admitted_pending"
+		}
+	}
+	mandatory := map[string]bool{}
+	for _, row := range block.rows {
+		if row.initial {
+			mandatory[row.row.PackageKey] = true
+		}
+	}
+	appendPass("mandatory_catalog_pass", mandatory)
+
+	pairCount := block.summary.TwoPlusTwoPackages
+	topCount := earlyPreparationCeilDiv(pairCount, 4)
+	top := map[string]bool{}
+	for i := 0; i < topCount && i < len(rankedPairs); i++ {
+		top[rankedPairs[i].row.row.PackageKey] = true
+	}
+	appendPass("top_quartile_proxy_rank", top)
+	block.summary.TopQuartilePackages = len(top)
+
+	uidCandidates := map[string]*earlyPreparationRowState{}
+	for _, item := range rankedPairs {
+		for _, set := range item.row.pack.Sets {
+			if _, exists := uidCandidates[set.SetUID]; !exists {
+				uidCandidates[set.SetUID] = item.row
+			}
+		}
+	}
+	uidKeys := make([]string, 0, len(uidCandidates))
+	for uid := range uidCandidates {
+		uidKeys = append(uidKeys, uid)
+	}
+	sort.Strings(uidKeys)
+	representatives := map[string]bool{}
+	for _, uid := range uidKeys {
+		representatives[uidCandidates[uid].row.PackageKey] = true
+	}
+	representativeAdmissionStart := len(selected)
+	appendPass("best_ranked_constituent_uid_representative", representatives)
+	// Count only packages newly admitted by this pass; a UID represented by an
+	// earlier mandatory/top pick needs no second admission.
+	block.summary.SetRepresentativePackages = len(selected) - representativeAdmissionStart
+
+	var tail []*earlyPreparationRowState
+	for _, item := range rankedPairs {
+		if !selected[item.row.row.PackageKey] {
+			tail = append(tail, item.row)
+		}
+	}
+	midpointCount := earlyPreparationCeilDiv(pairCount, 8)
+	if midpointCount > len(tail) {
+		midpointCount = len(tail)
+	}
+	midpoints := map[string]bool{}
+	for i := 0; i < midpointCount; i++ {
+		// One deterministic midpoint from each equal-sized tail stratum.
+		// This is exploration, never a bound.
+		index := ((2*i + 1) * len(tail)) / (2 * midpointCount)
+		if index >= len(tail) {
+			index = len(tail) - 1
+		}
+		if index >= 0 {
+			midpoints[tail[index].row.PackageKey] = true
+		}
+	}
+	appendPass("unconditional_rank_stratified_tail_midpoint", midpoints)
+	block.summary.MidpointPackages = len(midpoints)
+	// Selection passes determine membership and reasons only. Preserve the
+	// feasible-catalog traversal order for every admitted package.
+	for _, candidate := range block.rows {
+		if selected[candidate.row.PackageKey] {
+			block.order = append(block.order, candidate.pack)
+		}
+	}
+	block.summary.InitiallyAdmittedPackages = len(block.order)
+	block.summary.Status = "initial_admission_planned"
+	return block, nil
+}
+
+func earlyPreparationFailClosedBlock(cycle, actor int, anchor Candidate, feasible []domain.Package, reason string, selectorSeconds float64) *earlyPreparationBlock {
+	block := &earlyPreparationBlock{cycle: cycle, actor: actor, anchor: anchor, feasible: append([]domain.Package(nil), feasible...), byKey: map[string]*earlyPreparationRowState{}, fallback: true}
+	block.summary.Cycle, block.summary.Actor = cycle, actor
+	block.summary.FeasiblePackages = len(feasible)
+	block.summary.SelectorSeconds = selectorSeconds
+	block.summary.FailClosedReason = reason
+	block.summary.Status = "fail_closed_full_catalog"
+	for _, pack := range feasible {
+		key := pack.Key()
+		row := &earlyPreparationRowState{pack: pack, initial: true}
+		row.row = earlyPreparationLedgerRow{Schema: earlyPreparationSchema, Cycle: cycle, Actor: actor,
+			AnchorAssignment: anchor.Score.Assignment, AnchorFormulaDPS: anchor.Score.DPS,
+			PackageKey: key, Package: pack, Category: earlyPreparationCategory(pack),
+			Reasons: []string{"selector_error_fail_closed_full_catalog"}, PriorityError: reason,
+			InitialAdmitted: true, SelectedForPreparation: true, Decision: "selector_fail_closed_admitted",
+			PreparationStatus: "not_attempted_unknown"}
+		block.rows = append(block.rows, row)
+		block.byKey[key] = row
+		block.order = append(block.order, pack)
+		if row.row.Category == "two_plus_two" {
+			block.summary.TwoPlusTwoPackages++
+		}
+	}
+	block.summary.MandatoryPackages = len(feasible)
+	block.summary.InitiallyAdmittedPackages = len(feasible)
+	return block
+}
+
+func (state *earlyPreparationState) block(ctx context.Context, anchor Candidate, cycle, actor int, feasible []domain.Package) (*earlyPreparationBlock, error) {
+	if state == nil {
+		return nil, fmt.Errorf("early_preparation_admission_begin_required")
+	}
+	started := time.Now()
+	rawPriorityCalls, artifactPriorityCalls, indexRebinds := 0, 0, 0
+	var rawPriorityFormulaPoints *int
+	packagePriorityCalls, packagePriorityErrors := 0, 0
+	var rawPrioritySeconds, artifactLinearPrioritySeconds, packagePriorityDPSeconds float64
+	failClosed := func(reason string) (*earlyPreparationBlock, error) {
+		plan := earlyPreparationFailClosedBlock(cycle, actor, anchor, feasible, reason, time.Since(started).Seconds())
+		plan.summary.RawPriorityCalls = rawPriorityCalls
+		plan.summary.RawPriorityFormulaEvalPoints = rawPriorityFormulaPoints
+		plan.summary.RawPrioritySeconds = rawPrioritySeconds
+		plan.summary.ArtifactLinearPriorityCalls = artifactPriorityCalls
+		plan.summary.ArtifactLinearPrioritySeconds = artifactLinearPrioritySeconds
+		plan.summary.IndexRebinds = indexRebinds
+		plan.summary.PackagePriorityDPCalls = packagePriorityCalls
+		plan.summary.PackagePriorityDPSeconds = packagePriorityDPSeconds
+		plan.summary.PackagePriorityErrors = packagePriorityErrors
+		state.blocks = append(state.blocks, plan)
+		return plan, nil
+	}
+	if anchor.Handle == nil || anchor.Index == nil {
+		return failClosed("anchor_handle_or_index_unavailable")
+	}
+	panel, err := anchor.Handle.SearchPanel()
+	if err != nil {
+		return failClosed("anchor_search_panel_unavailable: " + err.Error())
+	}
+	// Rebind to this current team and formula coordinate list. No guide is
+	// reused across an actor, cycle or accepted leader change.
+	indexRebinds++
+	index, err := anchor.Index.ForPackages(anchor.Packages, anchor.Score.Assignment, panel.Coordinates())
+	if err != nil {
+		return failClosed("current_anchor_index_rebind_failed: " + err.Error())
+	}
+	rawPriorityCalls++
+	rawPriorityStarted := time.Now()
+	weights, _, err := rawPriorities(ctx, index, panel)
+	rawPrioritySeconds = time.Since(rawPriorityStarted).Seconds()
+	if err != nil {
+		return failClosed("raw_priorities_unavailable: " + err.Error())
+	}
+	points := len(weights) + 1 // rawPriorities is one baseline plus one point per coordinate.
+	rawPriorityFormulaPoints = &points
+	artifactPriorityCalls++
+	artifactLinearStarted := time.Now()
+	linear, err := index.ArtifactLinearPriorities(actor, weights)
+	artifactLinearPrioritySeconds = time.Since(artifactLinearStarted).Seconds()
+	if err != nil {
+		return failClosed("artifact_linear_priorities_unavailable: " + err.Error())
+	}
+	occupied := map[int64]bool{}
+	for wearer, ids := range anchor.Score.Assignment {
+		if wearer == actor {
+			continue
+		}
+		for _, id := range ids {
+			occupied[id] = true
+		}
+	}
+	proxies, priorityErrors := map[string]float64{}, map[string]string{}
+	packagePriorityStarted := time.Now()
+	for _, pack := range feasible {
+		if earlyPreparationCategory(pack) != "two_plus_two" {
+			continue
+		}
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			packagePriorityDPSeconds = time.Since(packagePriorityStarted).Seconds()
+			return failClosed("package_priority_cancelled_fail_closed: " + ctxErr.Error())
+		}
+		packagePriorityCalls++
+		priority, priorityErr := index.PackagePriority(pack, linear, occupied)
+		if priorityErr != nil {
+			packagePriorityErrors++
+			priorityErrors[pack.Key()] = "fixed_reservation_or_priority_error: " + priorityErr.Error()
+			continue
+		}
+		if math.IsNaN(priority) || math.IsInf(priority, 0) {
+			packagePriorityErrors++
+			priorityErrors[pack.Key()] = "nonfinite_package_priority_fail_closed"
+			continue
+		}
+		proxies[pack.Key()] = priority
+	}
+	packagePriorityDPSeconds = time.Since(packagePriorityStarted).Seconds()
+	plan, err := selectEarlyPreparation(feasible, anchor.Packages[actor], proxies, priorityErrors)
+	if err != nil {
+		return failClosed("selector_input_invalid: " + err.Error())
+	}
+	plan.cycle, plan.actor, plan.anchor = cycle, actor, anchor
+	plan.summary.Cycle, plan.summary.Actor = cycle, actor
+	plan.summary.RawPriorityCalls = rawPriorityCalls
+	plan.summary.RawPriorityFormulaEvalPoints = rawPriorityFormulaPoints
+	plan.summary.RawPrioritySeconds = rawPrioritySeconds
+	plan.summary.ArtifactLinearPriorityCalls = artifactPriorityCalls
+	plan.summary.ArtifactLinearPrioritySeconds = artifactLinearPrioritySeconds
+	plan.summary.PackagePriorityDPCalls = packagePriorityCalls
+	plan.summary.PackagePriorityDPSeconds = packagePriorityDPSeconds
+	plan.summary.PackagePriorityErrors = packagePriorityErrors
+	plan.summary.IndexRebinds = indexRebinds
+	plan.summary.SelectorSeconds = time.Since(started).Seconds()
+	for _, row := range plan.rows {
+		row.row.Cycle, row.row.Actor = cycle, actor
+		row.row.AnchorAssignment = anchor.Score.Assignment
+		row.row.AnchorFormulaDPS = anchor.Score.DPS
+	}
+	if len(plan.order) == 0 && len(feasible) > 0 {
+		return failClosed("selector_planned_empty_order")
+	}
+	if len(feasible) == 0 {
+		plan.initialDone = true
+		plan.summary.Status = "empty_catalog"
+	}
+	state.blocks = append(state.blocks, plan)
+	return plan, nil
+}
+
+func (block *earlyPreparationBlock) recordPrepare(pack domain.Package, candidate Candidate, ok, reservationDeferred, rescued bool, prepareErr error) {
+	if block == nil {
+		return
+	}
+	row := block.byKey[pack.Key()]
+	if row == nil {
+		return
+	}
+	row.prepared = true
+	row.rescued = rescued
+	row.row.PrepareAttempted = true
+	row.row.Rescue = rescued
+	block.summary.PrepareAttempts++
+	if rescued {
+		block.summary.RescueAttempts++
+	}
+	if prepareErr != nil {
+		row.row.PreparationStatus = "error"
+		row.row.PreparationError = prepareErr.Error()
+		return
+	}
+	if reservationDeferred {
+		row.row.PreparationStatus = "reservation_deferred"
+		block.summary.ReservationDeferred++
+		return
+	}
+	if !ok {
+		row.row.PreparationStatus = "model_unavailable"
+		block.summary.ModelUnavailable++
+		return
+	}
+	block.summary.Prepared++
+	row.row.PreparationStatus = "prepared"
+	if math.IsNaN(candidate.Score.DPS) || math.IsInf(candidate.Score.DPS, 0) {
+		row.row.PreparationStatus = "prepared_score_unknown"
+		return
+	}
+	dps := candidate.Score.DPS
+	strictGain := dps > block.anchor.Score.DPS
+	row.row.CandidateFormulaDPS = &dps
+	row.row.StrictExactGain = &strictGain
+	if strictGain && !rescued {
+		block.exactGain = true
+	}
+}
+
+func (block *earlyPreparationBlock) completeInitialAdmission() []domain.Package {
+	if block == nil || block.initialDone {
+		return nil
+	}
+	block.initialDone = true
+	if block.fallback {
+		return nil
+	}
+	gain := block.exactGain
+	block.summary.ExactAdmittedGain = &gain
+	if block.exactGain {
+		for _, row := range block.rows {
+			if row.initial {
+				continue
+			}
+			row.row.Decision = "early_preparation_heuristic_deferred"
+			row.row.PreparationStatus = "not_prepared_unknown"
+			block.summary.HeuristicDeferred++
+		}
+		block.summary.Status = "gain_with_heuristic_deferred_unknown"
+		return nil
+	}
+	block.summary.FullRescueStarted = true
+	block.summary.Status = "full_rescue_in_progress"
+	var rescue []domain.Package
+	for _, row := range block.rows { // original feasible catalog order
+		if row.initial {
+			continue
+		}
+		row.rescued = true
+		row.row.Rescue = true
+		row.row.SelectedForPreparation = true
+		row.row.Decision = "full_rescue_pending"
+		row.row.PreparationStatus = "not_attempted_unknown"
+		earlyAppendReason(row, "full_catalog_rescue_after_no_admitted_exact_gain")
+		rescue = append(rescue, row.pack)
+	}
+	block.summary.FullRescuePackages = len(rescue)
+	return rescue
+}
+
+func (block *earlyPreparationBlock) finishBlock() {
+	if block == nil {
+		return
+	}
+	block.blockDone = true
+	if !block.initialDone {
+		block.summary.Status = "partial_initial_admission_unknown"
+		return
+	}
+	if block.fallback {
+		block.summary.Status = "complete_fail_closed_full_catalog"
+		return
+	}
+	if block.summary.FullRescueStarted {
+		attempted := 0
+		for _, row := range block.rows {
+			if row.rescued && row.prepared {
+				attempted++
+			}
+		}
+		block.summary.FullRescueCompleted = attempted == block.summary.FullRescuePackages
+		if block.summary.FullRescueCompleted {
+			block.summary.Status = "complete_full_rescue"
+		} else {
+			block.summary.Status = "partial_full_rescue_unknown"
+		}
+		return
+	}
+	if len(block.feasible) == 0 {
+		block.summary.Status = "empty_catalog"
+		return
+	}
+	block.summary.Status = "complete_heuristic_deferral"
+}
+
+func (state *earlyPreparationState) summary() map[string]any {
+	if state == nil {
+		return map[string]any{"schema": earlyPreparationSchema, "enabled": false, "status": "not_started"}
+	}
+	summary := earlyPreparationStateSummary{Schema: earlyPreparationSchema, Enabled: true,
+		Status: "complete", LedgerFile: earlyPreparationLedgerName, LedgerSHA256: state.ledgerSHA256}
+	for _, block := range state.blocks {
+		b := block.summary
+		for _, row := range block.rows {
+			if !row.prepared {
+				b.UnresolvedNotAttempted++
+			}
+		}
+		summary.BlocksStarted++
+		summary.SelectorSeconds += b.SelectorSeconds
+		summary.RawPrioritySeconds += b.RawPrioritySeconds
+		summary.ArtifactLinearPrioritySeconds += b.ArtifactLinearPrioritySeconds
+		summary.PackagePriorityDPSeconds += b.PackagePriorityDPSeconds
+		summary.IndexRebinds += b.IndexRebinds
+		summary.RawPriorityCalls += b.RawPriorityCalls
+		if b.RawPriorityFormulaEvalPoints == nil && b.RawPriorityCalls > 0 {
+			summary.RawPriorityFormulaUnknown++
+		} else if b.RawPriorityFormulaEvalPoints != nil {
+			summary.RawPriorityFormulaPoints += *b.RawPriorityFormulaEvalPoints
+		}
+		summary.ArtifactLinearCalls += b.ArtifactLinearPriorityCalls
+		summary.PackagePriorityDPCalls += b.PackagePriorityDPCalls
+		summary.PackagePriorityErrors += b.PackagePriorityErrors
+		summary.PrepareAttempts += b.PrepareAttempts
+		summary.Prepared += b.Prepared
+		summary.ReservationDeferred += b.ReservationDeferred
+		summary.ModelUnavailable += b.ModelUnavailable
+		if b.FullRescueStarted {
+			summary.RescueBlocks++
+		}
+		summary.RescueAttempts += b.RescueAttempts
+		summary.HeuristicDeferred += b.HeuristicDeferred
+		summary.UnresolvedNotAttempted += b.UnresolvedNotAttempted
+		summary.Blocks = append(summary.Blocks, b)
+		if !block.blockDone {
+			summary.Status = "partial_or_error_unknown"
+		}
+	}
+	rows := 0
+	for _, block := range state.blocks {
+		rows += len(block.rows)
+	}
+	summary.LedgerRows = rows
+	return map[string]any{
+		"schema": summary.Schema, "enabled": summary.Enabled, "status": summary.Status,
+		"ledger_file": summary.LedgerFile, "ledger_rows": summary.LedgerRows, "ledger_sha256": summary.LedgerSHA256,
+		"blocks_started": summary.BlocksStarted, "selector_seconds": summary.SelectorSeconds,
+		"raw_priority_seconds":                summary.RawPrioritySeconds,
+		"artifact_linear_priority_seconds":    summary.ArtifactLinearPrioritySeconds,
+		"package_priority_dp_seconds":         summary.PackagePriorityDPSeconds,
+		"raw_priority_calls":                  summary.RawPriorityCalls,
+		"raw_priority_formula_points":         summary.RawPriorityFormulaPoints,
+		"raw_priority_formula_unknown_blocks": summary.RawPriorityFormulaUnknown,
+		"index_rebinds":                       summary.IndexRebinds,
+		"artifact_linear_priority_calls":      summary.ArtifactLinearCalls,
+		"package_priority_dp_calls":           summary.PackagePriorityDPCalls,
+		"package_priority_errors":             summary.PackagePriorityErrors,
+		"prepare_attempts":                    summary.PrepareAttempts, "prepared": summary.Prepared,
+		"reservation_deferred": summary.ReservationDeferred, "model_unavailable": summary.ModelUnavailable,
+		"full_rescue_blocks": summary.RescueBlocks, "full_rescue_prepare_attempts": summary.RescueAttempts,
+		"heuristic_deferred": summary.HeuristicDeferred, "unresolved_not_attempted": summary.UnresolvedNotAttempted,
+		"blocks": summary.Blocks,
+	}
+}
+
+func (state *earlyPreparationState) flush() error {
+	if state == nil || state.flushed {
+		return nil
+	}
+	var buffer bytes.Buffer
+	encoder := json.NewEncoder(&buffer)
+	encoder.SetEscapeHTML(false)
+	for _, block := range state.blocks {
+		for _, row := range block.rows {
+			if err := encoder.Encode(row.row); err != nil {
+				return fmt.Errorf("early_preparation_ledger_encode: %w", err)
+			}
+		}
+	}
+	if buffer.Len() > earlyPreparationLedgerLimit {
+		return fmt.Errorf("early_preparation_ledger_limit_exceeded: %d", buffer.Len())
+	}
+	path := filepath.Join(state.job, earlyPreparationLedgerName)
+	if old, err := os.ReadFile(path); err == nil {
+		if !bytes.Equal(old, buffer.Bytes()) {
+			return fmt.Errorf("early_preparation_existing_ledger_mismatch")
+		}
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("early_preparation_ledger_readback: %w", err)
+	} else {
+		file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			return fmt.Errorf("early_preparation_ledger_create: %w", err)
+		}
+		if _, err := file.Write(buffer.Bytes()); err != nil {
+			_ = file.Close()
+			return fmt.Errorf("early_preparation_ledger_write: %w", err)
+		}
+		if err := file.Sync(); err != nil {
+			_ = file.Close()
+			return fmt.Errorf("early_preparation_ledger_sync: %w", err)
+		}
+		if err := file.Close(); err != nil {
+			return fmt.Errorf("early_preparation_ledger_close: %w", err)
+		}
+		readback, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(readback, buffer.Bytes()) {
+			return fmt.Errorf("early_preparation_ledger_readback_mismatch")
+		}
+	}
+	sum := sha256.Sum256(buffer.Bytes())
+	state.ledgerSHA256 = hex.EncodeToString(sum[:])
+	state.flushed = true
+	return nil
+}
