+)
+
+func TestRunResponseCheckDoesNotBindOrProbeWhenNotRequired(t *testing.T) {
+	request := responseCheckRequest(t)
+	bindCalls, probeCalls := 0, 0
+	restore := installResponseCheckSeams(
+		func(contracts.OptimizerRequest) (engineclient.BoundEngine, error) {
+			bindCalls++
+			return engineclient.BoundEngine{}, nil
+		},
+		func(context.Context, engineclient.BoundEngine, string, string, engineclient.StatResponsePlan) (engineclient.StatResponseResult, error) {
+			probeCalls++
+			return engineclient.StatResponseResult{}, nil
+		},
+	)
+	defer restore()
+
+	check, err := RunResponseCheck(context.Background(), request, Report{}, "full build\n", t.TempDir(), ResponseAllowance{MaxCalls: 20, Timeout: time.Second})
+	if err != nil || check.Status != "not_required" || check.Evidence != nil || bindCalls != 0 || probeCalls != 0 {
+		t.Fatalf("clean graph implied a probe or a completeness result: check=%+v bind=%d probe=%d err=%v", check, bindCalls, probeCalls, err)
+	}
+}
+
+func TestRunResponseCheckPlansFirstSeedPairAndBindsExactAnchor(t *testing.T) {
+	request := responseCheckRequest(t)
+	request.Stochastic.Seeds = []uint64{101, 202, 303}
+	coverage := Report{Coordinates: []Coordinate{{Key: "actor_a.atk_percent", Owner: "actor_a", Recipients: []string{}}}}
+	anchor := "# exact full-build anchor\nactor_a char lvl=90/90;\n"
+	bindCalls, probeCalls := 0, 0
+	var seenPlan engineclient.StatResponsePlan
+	restore := installResponseCheckSeams(
+		func(got contracts.OptimizerRequest) (engineclient.BoundEngine, error) {
+			bindCalls++
+			if !reflect.DeepEqual(got.Engine, request.Engine) {
+				t.Fatal("binder received a different engine binding")
+			}
+			return engineclient.BoundEngine{}, nil
+		},
+		func(ctx context.Context, _ engineclient.BoundEngine, config, _ string, plan engineclient.StatResponsePlan) (engineclient.StatResponseResult, error) {
+			probeCalls++
+			seenPlan = plan
+			if _, ok := ctx.Deadline(); !ok {
+				t.Fatal("probe context has no deadline")
+			}
+			return responseCheckEvidence(request, config, plan), nil
+		},
+	)
+	defer restore()
+
+	check, err := RunResponseCheck(context.Background(), request, coverage, anchor, t.TempDir(), ResponseAllowance{MaxCalls: 16, Timeout: 3 * time.Second})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if check.Status != "completed_proposal_only" || check.Evidence == nil || len(check.Directions) != len(seenPlan.Perturbations) || bindCalls != 1 || probeCalls != 1 {
+		t.Fatalf("unexpected response check: status=%q directions=%d bind=%d probe=%d", check.Status, len(check.Directions), bindCalls, probeCalls)
+	}
+	if len(check.SelectedSeeds) != 2 || check.SelectedSeeds[0] != 101 || check.SelectedSeeds[1] != 202 || len(seenPlan.Seeds) != 2 || seenPlan.Seeds[0] != 101 || seenPlan.Seeds[1] != 202 {
+		t.Fatalf("selected seeds were reordered or widened: selected=%v plan=%v", check.SelectedSeeds, seenPlan.Seeds)
+	}
+	requestSHA, _ := contracts.CanonicalSHA256(request)
+	wantBinding := engineclient.StatResponseBinding{
+		AnchorConfigSHA256: contracts.TextSHA256(anchor), RequestSHA256: requestSHA,
+		EngineArtifactSHA256: request.Engine.ArtifactSHA256, EngineBindingSHA256: request.Engine.BindingSHA256,
+		EngineSourceManifestSHA256: request.Engine.SourceManifestSHA256, EnginePatchManifestSHA256: request.Engine.PatchManifestSHA256,
+	}
+	if check.Binding != wantBinding || check.Evidence.Binding != wantBinding || seenPlan.RequestSHA256 != requestSHA {
+		t.Fatalf("response evidence was not bound to request/anchor/engine: binding=%+v evidence=%+v plan=%+v", check.Binding, check.Evidence.Binding, seenPlan)
+	}
+}
+
+func TestRunResponseCheckValidatesRawTheoryWithoutChangingIdentity(t *testing.T) {
+	request := rawTheoryResponseCheckRequest(t)
+	request.Stochastic.Seeds = []uint64{101, 202, 303}
+	rawBytes, err := contracts.CanonicalJSON(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decodedRaw, expanded, err := contracts.DecodeTheoryRequest(rawBytes)
+	if err != nil {
+		t.Fatalf("canonical raw Theory wire request failed decode/expansion: %v", err)
+	}
+	if !reflect.DeepEqual(request, decodedRaw) {
+		t.Fatal("canonical Theory decode changed the raw wire request")
+	}
+	request = decodedRaw
+	rawSHA, err := contracts.CanonicalSHA256(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := expanded.ValidateTheory(); err != nil {
+		t.Fatalf("expanded Theory request is not strictly valid: %v", err)
+	}
+	expandedBytes, err := contracts.CanonicalJSON(expanded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expandedSHA, err := contracts.CanonicalSHA256(expanded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rawSHA == expandedSHA {
+		t.Fatal("raw wire Theory and expanded private-inventory requests share an identity")
+	}
+
+	coverage := Report{Gaps: []Gap{{Attribution: "unattributed"}}}
+	anchor := "# exact raw Theory anchor\nactor_a char lvl=90/90;\n"
+	managedRoot := t.TempDir()
+	expectedRequest := request
+	expectedSHA := rawSHA
+	bindCalls, probeCalls := 0, 0
+	var seenPlan engineclient.StatResponsePlan
+	restore := installResponseCheckSeams(
+		func(got contracts.OptimizerRequest) (engineclient.BoundEngine, error) {
+			bindCalls++
+			gotSHA, hashErr := contracts.CanonicalSHA256(got)
+			if hashErr != nil || gotSHA != expectedSHA || !reflect.DeepEqual(got, expectedRequest) {
+				t.Fatalf("binder received a normalized or changed Theory request: sha=%q err=%v", gotSHA, hashErr)
+			}
+			if !reflect.DeepEqual(got.Engine, expectedRequest.Engine) ||
+				!reflect.DeepEqual(got.Stochastic, expectedRequest.Stochastic) ||
+				!reflect.DeepEqual(got.TheoryOptions, expectedRequest.TheoryOptions) {
+				t.Fatal("engine, seed policy, or Theory declaration changed before binding")
+			}
+			return engineclient.BoundEngine{}, nil
+		},
+		func(_ context.Context, _ engineclient.BoundEngine, config, root string, plan engineclient.StatResponsePlan) (engineclient.StatResponseResult, error) {
+			probeCalls++
+			seenPlan = plan
+			if config != anchor || root != managedRoot || plan.RequestSHA256 != expectedSHA {
+				t.Fatalf("probe lost exact anchor/request identity: config=%q root=%q plan=%+v", config, root, plan)
+			}
+			actors := make(map[string]bool, len(expectedRequest.Wearers))
+			for _, wearer := range expectedRequest.Wearers {
+				actors[wearer.WearerKey] = true
+			}
+			for _, perturbation := range plan.Perturbations {
+				if !actors[perturbation.Actor] {
+					t.Fatalf("response plan used an actor outside the unchanged Theory request: %+v", perturbation)
+				}
+			}
+			if len(plan.Seeds) != 2 || plan.Seeds[0] != 101 || plan.Seeds[1] != 202 {
+				t.Fatalf("response panel changed the selected seed pair: %v", plan.Seeds)
+			}
+			return responseCheckEvidence(expectedRequest, config, plan), nil
+		},
+	)
+	defer restore()
+
+	rawCheck, err := RunResponseCheck(context.Background(), request, coverage, anchor, managedRoot,
+		ResponseAllowance{MaxCalls: 16, Timeout: time.Second})
+	if err != nil || rawCheck.Status != "completed_proposal_only" {
+		t.Fatalf("canonical raw Theory request failed the shared response check: check=%+v err=%v", rawCheck, err)
+	}
+	if rawCheck.Binding.RequestSHA256 != rawSHA || rawCheck.Evidence == nil ||
+		rawCheck.Evidence.Binding.RequestSHA256 != rawSHA || seenPlan.RequestSHA256 != rawSHA {
+		t.Fatalf("response identity used the expanded request instead of raw Theory wire bytes: %+v", rawCheck)
+	}
+	if len(rawCheck.SelectedSeeds) != 2 || rawCheck.SelectedSeeds[0] != 101 || rawCheck.SelectedSeeds[1] != 202 {
+		t.Fatalf("raw Theory response check changed selected seeds: %v", rawCheck.SelectedSeeds)
+	}
+	afterRawBytes, err := contracts.CanonicalJSON(request)
+	if err != nil || !bytes.Equal(rawBytes, afterRawBytes) {
+		t.Fatalf("raw Theory input was mutated: canonical err=%v", err)
+	}
+
+	// Already-expanded Theory stays on the strict ValidateTheory path and binds
+	// its distinct in-memory request identity rather than the raw wire identity.
+	expectedRequest = expanded
+	expectedSHA = expandedSHA
+	expandedCheck, err := RunResponseCheck(context.Background(), expanded, coverage, anchor, managedRoot,
+		ResponseAllowance{MaxCalls: 16, Timeout: time.Second})
+	if err != nil || expandedCheck.Status != "completed_proposal_only" {
+		t.Fatalf("expanded Theory request failed strict response validation: check=%+v err=%v", expandedCheck, err)
+	}
+	if expandedCheck.Binding.RequestSHA256 != expandedSHA || expandedCheck.Evidence == nil ||
+		expandedCheck.Evidence.Binding.RequestSHA256 != expandedSHA || seenPlan.RequestSHA256 != expandedSHA {
+		t.Fatalf("expanded Theory request did not retain its distinct identity: %+v", expandedCheck)
+	}
+	afterExpandedBytes, err := contracts.CanonicalJSON(expanded)
+	if err != nil || !bytes.Equal(expandedBytes, afterExpandedBytes) {
+		t.Fatalf("expanded Theory input was mutated: canonical err=%v", err)
+	}
+	if bindCalls != 2 || probeCalls != 2 {
+		t.Fatalf("expected one fake bind/probe per raw and expanded request: bind=%d probe=%d", bindCalls, probeCalls)
+	}
+}
+
+func TestRunResponseCheckRejectsInvalidRawTheoryBeforeBinding(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		mutate func(*contracts.OptimizerRequest)
+	}{
+		{
+			name: "noncanonical baseline",
+			mutate: func(request *contracts.OptimizerRequest) {
+				request.Wearers[0].TheoryBaseline.MainStats[3].Key = "hydro_dmg_percent"
+			},
+		},
+		{
+			name: "owned current artifact claim",
+			mutate: func(request *contracts.OptimizerRequest) {
+				wearer := request.Wearers[0]
+				request.Wearers[0].CurrentArtifacts = []contracts.ArtifactAssignment{{
+					WearerKey: wearer.WearerKey, Slot: "flower", ArtifactID: 1,
+				}}
+			},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			request := rawTheoryResponseCheckRequest(t)
+			test.mutate(&request)
+			bindCalls, probeCalls := 0, 0
+			restore := installResponseCheckSeams(
+				func(contracts.OptimizerRequest) (engineclient.BoundEngine, error) {
+					bindCalls++
+					return engineclient.BoundEngine{}, nil
+				},
+				func(context.Context, engineclient.BoundEngine, string, string, engineclient.StatResponsePlan) (engineclient.StatResponseResult, error) {
+					probeCalls++
+					return engineclient.StatResponseResult{}, nil
+				},
+			)
+			defer restore()
+
+			check, err := RunResponseCheck(context.Background(), request,
+				Report{Gaps: []Gap{{Attribution: "unattributed"}}}, "exact anchor", t.TempDir(),
+				ResponseAllowance{MaxCalls: 16, Timeout: time.Second})
+			if err == nil || bindCalls != 0 || probeCalls != 0 {
+				t.Fatalf("invalid raw Theory input reached binding/probing: check=%+v bind=%d probe=%d err=%v", check, bindCalls, probeCalls, err)
+			}
+		})
+	}
+}
+
+func TestRunResponseCheckOnlyEmitsDirectlyProbedFlatDirections(t *testing.T) {
+	request := responseCheckRequest(t)
+	coverage := Report{Gaps: []Gap{{Attribution: "unattributed"}}}
+	probeCalls := 0
+	restore := installResponseCheckSeams(
+		func(contracts.OptimizerRequest) (engineclient.BoundEngine, error) {
+			return engineclient.BoundEngine{}, nil
+		},
+		func(_ context.Context, _ engineclient.BoundEngine, config, _ string, plan engineclient.StatResponsePlan) (engineclient.StatResponseResult, error) {
+			probeCalls++
+			return responseCheckEvidence(request, config, plan), nil
+		},
+	)
+	defer restore()
+	for _, test := range []struct {
+		allowance int
+		wantCalls int
+		wantFlat  bool
+	}{
+		{42, 42, false},
+		{66, 66, true},
+	} {
