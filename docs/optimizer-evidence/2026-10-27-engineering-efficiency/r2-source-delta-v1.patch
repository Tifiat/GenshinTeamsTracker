+		memo.entries[neutralBoundScoreIdentity(index, c.Context, c.Handle, invalid)] = 1
+		if _, err := memo.bind(context.Background(), index, c.Context, c.Handle, c.Packages, invalid, "invalid"); err == nil || memo.hits != 0 || memo.evaluations != 0 {
+			t.Fatal("cached identity bypassed physical validation", memo.hits, memo.evaluations, err)
