@@ -0,0 +1,618 @@
+package supportfixture
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/finalists"
+)
+
+var (
+	requestActorLine     = regexp.MustCompile(`^([a-z][a-z0-9_]*)[ \t]+char\b[^;]*;[ \t]*$`)
+	requestWeaponLine    = regexp.MustCompile(`^([a-z][a-z0-9_]*)[ \t]+add[ \t]+weapon[ \t]*=[ \t]*"([a-z][a-z0-9_]*)"[^;]*;[ \t]*$`)
+	requestStatsLine     = regexp.MustCompile(`^([a-z][a-z0-9_]*)[ \t]+add[ \t]+stats\b[^;]*;[ \t]*$`)
+	requestSetLine       = regexp.MustCompile(`^([a-z][a-z0-9_]*)[ \t]+add[ \t]+set="([a-z][a-z0-9_]*)"[ \t]+count=([1-5]);[ \t]*$`)
+	requestOptionsLine   = regexp.MustCompile(`^options[ \t]+([^;]*);[ \t]*$`)
+	requestTargetLine    = regexp.MustCompile(`^target[ \t]+[^;]*;[ \t]*$`)
+	requestActiveLine    = regexp.MustCompile(`^active[ \t]+([a-z][a-z0-9_]*)[ \t]*;[ \t]*$`)
+	requestOptionKey     = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)
+	requestSetMention    = regexp.MustCompile(`\badd[ \t]+set\b`)
+	requestStatsMention  = regexp.MustCompile(`\badd[ \t]+stats\b`)
+	requestWeaponMention = regexp.MustCompile(`\badd[ \t]+weapon\b`)
+)
+
+// Prepared is a capture-free, test/experiment-only optimizer request. The
+// canonical request wearer order is in Request; DeclarationOrder records the
+// unchanged order of the four source character declarations.
+type Prepared struct {
+	Request              contracts.OptimizerRequest
+	Fixture              Fixture
+	DeclarationOrder     [4]string
+	OriginalConfigSHA256 string
+	PreparedConfigSHA256 string
+}
+
+// PrepareRequest generates a public synthetic inventory and binds it to a
+// source config without reading an account database or opening the engine.
+// Only stats/set/options rows are rendered; character declarations, weapons,
+// target, active declaration, and rotation tail remain inherited from source.
+func PrepareRequest(configText string, config Config, binding contracts.EngineBinding,
+	seeds []uint64, options contracts.ResultOptions,
+) (Prepared, error) {
+	var out Prepared
+	if configText == "" {
+		return out, fmt.Errorf("source config must not be empty")
+	}
+	if len(seeds) != 2 || seeds[0] == 0 || seeds[1] == 0 || seeds[0] >= seeds[1] || seeds[1] > uint64(1<<63-1) {
+		return out, fmt.Errorf("exactly two positive, sorted, distinct int64-range seeds are required")
+	}
+	if options.FastMode || options.ExpandedLimits {
+		return out, fmt.Errorf("support fixture requires explicit non-fast result options")
+	}
+	if err := validateCanonicalEngineBinding(binding); err != nil {
+		return out, err
+	}
+
+	fixture, err := Generate(config)
+	if err != nil {
+		return out, err
+	}
+	lines, crlf, err := splitSourceLines(configText)
+	if err != nil {
+		return out, err
+	}
+	parsed, err := parseSourceConfig(lines)
+	if err != nil {
+		return out, err
+	}
+	if err := validateSourceRoster(parsed, fixture.WearerKeys); err != nil {
+		return out, err
+	}
+	if err := validateSourceSets(parsed, fixture); err != nil {
+		return out, err
+	}
+	rotation := strings.Join(rawLinesAfter(lines, parsed.activeLine), "\n")
+	if strings.TrimSpace(rotation) == "" {
+		return out, fmt.Errorf("source config has no rotation tail after active declaration")
+	}
+	configText, err = normalizeSourceRows(lines, parsed, fixture, crlf)
+	if err != nil {
+		return out, err
+	}
+
+	request, err := buildRequest(configText, parsed, fixture, binding, seeds, options, rotation)
+	if err != nil {
+		return out, err
+	}
+	index, err := domain.Build(request, nil)
+	if err != nil {
+		return out, fmt.Errorf("validate synthetic anchor request: %w", err)
+	}
+	rendered, err := finalists.RenderConfig(request, index, fixture.Anchor, 1, 1)
+	if err != nil {
+		return out, fmt.Errorf("render declared full45 anchor: %w", err)
+	}
+	preparedText := rendered.Text
+	if crlf {
+		preparedText = strings.ReplaceAll(strings.ReplaceAll(preparedText, "\r\n", "\n"), "\n", "\r\n")
+	}
+	if err := bindRunContext(&request, preparedText, rotation, parsed.targetText, seeds); err != nil {
+		return out, err
+	}
+	if err := request.Validate(); err != nil {
+		return out, fmt.Errorf("validate prepared synthetic request: %w", err)
+	}
+	if _, err := domain.Build(request, nil); err != nil {
+		return out, fmt.Errorf("validate prepared synthetic inventory: %w", err)
+	}
+
+	out = Prepared{
+		Request:              request,
+		Fixture:              fixture,
+		DeclarationOrder:     parsed.actorOrder,
+		OriginalConfigSHA256: contracts.TextSHA256(strings.Join(rawLines(lines), "\n")),
+		PreparedConfigSHA256: request.Context.PreparedConfig.SHA256,
+	}
+	return out, nil
+}
+
+type sourceLine struct {
+	raw     string
+	content string
+}
+
+type sourceSetRow struct {
+	line  int
+	uid   string
+	count int
+}
+
+type parsedSource struct {
+	actorOrder  [4]string
+	actors      map[string]bool
+	weapons     map[string]string
+	stats       map[string][]int
+	sets        map[string][]sourceSetRow
+	activeLine  int
+	activeActor string
+	targetText  string
+}
+
+func splitSourceLines(text string) ([]sourceLine, bool, error) {
+	hasCRLF := strings.Contains(text, "\r\n")
+	withoutCRLF := strings.ReplaceAll(text, "\r\n", "")
+	if hasCRLF && strings.Contains(withoutCRLF, "\n") {
+		return nil, false, fmt.Errorf("mixed source line endings are unsupported")
+	}
+	if !hasCRLF && strings.Contains(text, "\r") {
+		return nil, false, fmt.Errorf("bare carriage returns are unsupported")
+	}
+	raw := strings.Split(text, "\n")
+	lines := make([]sourceLine, len(raw))
+	for i, row := range raw {
+		content := row
+		if hasCRLF {
+			content = strings.TrimSuffix(content, "\r")
+		}
+		lines[i] = sourceLine{raw: row, content: content}
+	}
+	return lines, hasCRLF, nil
+}
+
+func parseSourceConfig(lines []sourceLine) (parsedSource, error) {
+	parsed := parsedSource{
+		actors: map[string]bool{}, weapons: map[string]string{},
+		stats: map[string][]int{}, sets: map[string][]sourceSetRow{}, activeLine: -1,
+	}
+	declared := make([]string, 0, 4)
+	targetCount, optionsCount := 0, 0
+	for lineIndex, source := range lines {
+		line := strings.TrimSpace(source.content)
+		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, "//") {
+			continue
+		}
+		if match := requestActorLine.FindStringSubmatch(line); match != nil {
+			actor := match[1]
+			if parsed.actors[actor] {
+				return parsed, fmt.Errorf("duplicate source character declaration %q", actor)
+			}
+			parsed.actors[actor] = true
+			declared = append(declared, actor)
+			continue
+		}
+		if strings.Contains(line, " char") {
+			return parsed, fmt.Errorf("malformed source character declaration at line %d", lineIndex+1)
+		}
+		if match := requestWeaponLine.FindStringSubmatch(line); match != nil {
+			actor, weapon := match[1], match[2]
+			if _, exists := parsed.weapons[actor]; exists {
+				return parsed, fmt.Errorf("duplicate source weapon declaration for %q", actor)
+			}
+			parsed.weapons[actor] = weapon
+			continue
+		}
+		if requestWeaponMention.MatchString(line) {
+			return parsed, fmt.Errorf("malformed source weapon declaration at line %d", lineIndex+1)
+		}
+		if match := requestStatsLine.FindStringSubmatch(line); match != nil {
+			parsed.stats[match[1]] = append(parsed.stats[match[1]], lineIndex)
+			continue
+		}
+		if requestStatsMention.MatchString(line) {
+			return parsed, fmt.Errorf("malformed source stats row at line %d", lineIndex+1)
+		}
+		if match := requestSetLine.FindStringSubmatch(line); match != nil {
+			count, _ := strconv.Atoi(match[3])
+			parsed.sets[match[1]] = append(parsed.sets[match[1]], sourceSetRow{line: lineIndex, uid: match[2], count: count})
+			continue
+		}
+		if requestSetMention.MatchString(line) {
+			return parsed, fmt.Errorf("malformed or parameterized source set row at line %d", lineIndex+1)
+		}
+		if match := requestOptionsLine.FindStringSubmatch(line); match != nil {
+			optionsCount++
+			if optionsCount > 1 {
+				return parsed, fmt.Errorf("source config contains multiple options rows")
+			}
+			if err := validateInfiniteOptions(match[1]); err != nil {
+				return parsed, err
+			}
+			continue
+		}
+		if strings.HasPrefix(line, "options") {
+			return parsed, fmt.Errorf("malformed source options row at line %d", lineIndex+1)
+		}
+		if requestTargetLine.MatchString(line) {
+			targetCount++
+			if targetCount > 1 {
+				return parsed, fmt.Errorf("source config must contain exactly one target")
+			}
+			parsed.targetText = source.content
+			continue
+		}
+		if strings.HasPrefix(line, "target") {
+			return parsed, fmt.Errorf("malformed source target row at line %d", lineIndex+1)
+		}
+		if match := requestActiveLine.FindStringSubmatch(line); match != nil {
+			if parsed.activeLine >= 0 {
+				return parsed, fmt.Errorf("source config must contain exactly one active actor")
+			}
+			parsed.activeLine = lineIndex
+			parsed.activeActor = match[1]
+			continue
+		}
+		if strings.HasPrefix(line, "active") {
+			return parsed, fmt.Errorf("malformed active declaration at line %d", lineIndex+1)
+		}
+	}
+	if len(declared) != 4 {
+		return parsed, fmt.Errorf("source config must declare exactly four characters")
+	}
+	copy(parsed.actorOrder[:], declared)
+	if optionsCount != 1 {
+		return parsed, fmt.Errorf("source config must contain exactly one options row")
+	}
+	if targetCount != 1 || parsed.targetText == "" {
+		return parsed, fmt.Errorf("source config must contain exactly one target")
+	}
+	if parsed.activeLine < 0 || parsed.activeActor == "" {
+		return parsed, fmt.Errorf("source config must contain exactly one active actor")
+	}
+	if actorAt(parsed.actorOrder, parsed.activeActor) < 0 {
+		return parsed, fmt.Errorf("active actor %q is not one of the four source characters", parsed.activeActor)
+	}
+	targetLine := -1
+	for i, source := range lines {
+		if strings.TrimSpace(source.content) == strings.TrimSpace(parsed.targetText) {
+			targetLine = i
+			break
+		}
+	}
+	if targetLine < 0 || targetLine >= parsed.activeLine {
+		return parsed, fmt.Errorf("target declaration must precede the active/rotation tail")
+	}
+	return parsed, nil
+}
+
+func actorAt(actors [4]string, wanted string) int {
+	for i, actor := range actors {
+		if actor == wanted {
+			return i
+		}
+	}
+	return -1
+}
+
+func validateInfiniteOptions(body string) error {
+	seen := map[string]string{}
+	for _, token := range strings.Fields(body) {
+		key, value, found := strings.Cut(token, "=")
+		if !found || !requestOptionKey.MatchString(key) || value == "" || strings.Contains(value, "=") {
+			return fmt.Errorf("malformed source option %q", token)
+		}
+		if _, duplicate := seen[key]; duplicate {
+			return fmt.Errorf("duplicate source option %q", key)
+		}
+		seen[key] = value
+	}
+	if seen["ignore_burst_energy"] != "true" {
+		return fmt.Errorf("source config must explicitly enable infinite energy")
+	}
+	for _, key := range []string{"iteration", "workers"} {
+		if value, exists := seen[key]; exists {
+			parsed, err := strconv.Atoi(value)
+			if err != nil || parsed <= 0 {
+				return fmt.Errorf("source option %s must be a positive integer", key)
+			}
+		}
+	}
+	return nil
+}
+
+func validateSourceRoster(parsed parsedSource, wearerKeys [4]string) error {
+	want := map[string]bool{}
+	for _, key := range wearerKeys {
+		if want[key] {
+			return fmt.Errorf("synthetic wearer keys must be distinct")
+		}
+		want[key] = true
+	}
+	if len(parsed.actors) != len(want) {
+		return fmt.Errorf("source actor declarations do not match the four synthetic wearers")
+	}
+	for actor := range parsed.actors {
+		if !want[actor] {
+			return fmt.Errorf("foreign source actor declaration %q", actor)
+		}
+	}
+	for actor := range want {
+		weapon, exists := parsed.weapons[actor]
+		if !exists {
+			return fmt.Errorf("source config is missing a weapon declaration for %q", actor)
+		}
+		if !stableToken.MatchString(weapon) {
+			return fmt.Errorf("source weapon key for %q is invalid", actor)
+		}
+		if _, exists := parsed.stats[actor]; !exists {
+			return fmt.Errorf("source config is missing a provisional stats row for %q", actor)
+		}
+	}
+	for actor := range parsed.weapons {
+		if !want[actor] {
+			return fmt.Errorf("foreign source weapon declaration %q", actor)
+		}
+	}
+	for actor := range parsed.stats {
+		if !want[actor] {
+			return fmt.Errorf("foreign source stats declaration %q", actor)
+		}
+	}
+	for actor := range parsed.sets {
+		if !want[actor] {
+			return fmt.Errorf("foreign source set declaration %q", actor)
+		}
+	}
+	return nil
+}
+
+func requirementsForSlots(slotUIDs [5]string) ([]contracts.SetRequirement, map[string]int, error) {
+	counts := map[string]int{}
+	for _, uid := range slotUIDs {
+		if !stableToken.MatchString(uid) {
+			return nil, nil, fmt.Errorf("slot set declaration contains an invalid UID")
+		}
+		counts[uid]++
+	}
+	active := make([]string, 0, 2)
+	for uid, count := range counts {
+		if count >= 2 {
+			active = append(active, uid)
+		}
+	}
+	sort.Strings(active)
+	if len(active) == 1 && counts[active[0]] >= 4 {
+		return []contracts.SetRequirement{{SetUID: active[0], Count: 4}}, counts, nil
+	}
+	if len(active) == 2 {
+		return []contracts.SetRequirement{{SetUID: active[0], Count: 2}, {SetUID: active[1], Count: 2}}, counts, nil
+	}
+	return nil, nil, fmt.Errorf("slot set declaration must form a 4p or 2+2 package")
+}
+
+func validateSourceSets(parsed parsedSource, fixture Fixture) error {
+	for actor, wearerKey := range fixture.WearerKeys {
+		requirements, slotCounts, err := requirementsForSlots(fixture.SlotSetUIDsByWearer[actor])
+		if err != nil {
+			return fmt.Errorf("wearer %s: %w", wearerKey, err)
+		}
+		rows := parsed.sets[wearerKey]
+		byUID := map[string]int{}
+		for _, row := range rows {
+			if _, duplicate := byUID[row.uid]; duplicate {
+				return fmt.Errorf("duplicate source set row for %s/%s", wearerKey, row.uid)
+			}
+			byUID[row.uid] = row.count
+			actualCount, known := slotCounts[row.uid]
+			if !known {
+				return fmt.Errorf("source config declares an undeclared set %s for %s", row.uid, wearerKey)
+			}
+			wantCount := actualCount
+			for _, requirement := range requirements {
+				if requirement.SetUID == row.uid {
+					wantCount = requirement.Count
+					break
+				}
+			}
+			if row.count != wantCount && row.count != actualCount {
+				return fmt.Errorf("source set row %s/%s has count %d, want bonus or declared piece count %d/%d", wearerKey, row.uid, row.count, wantCount, actualCount)
+			}
+		}
+		for _, requirement := range requirements {
+			if _, exists := byUID[requirement.SetUID]; !exists {
+				return fmt.Errorf("source config is missing active set row %s/%s", wearerKey, requirement.SetUID)
+			}
+		}
+		for uid, count := range slotCounts {
+			if count == 1 {
+				if rowCount, exists := byUID[uid]; exists && rowCount != 1 {
+					return fmt.Errorf("source flex set row %s/%s must have count 1", wearerKey, uid)
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func normalizeSourceRows(lines []sourceLine, parsed parsedSource, fixture Fixture, crlf bool) (string, error) {
+	for actor, indexes := range parsed.stats {
+		if len(indexes) == 0 {
+			return "", fmt.Errorf("missing provisional stats row for %s", actor)
+		}
+	}
+	activeRequirements := map[string]map[string]int{}
+	for actor, wearerKey := range fixture.WearerKeys {
+		requirements, _, err := requirementsForSlots(fixture.SlotSetUIDsByWearer[actor])
+		if err != nil {
+			return "", err
+		}
+		activeRequirements[wearerKey] = map[string]int{}
+		for _, requirement := range requirements {
+			activeRequirements[wearerKey][requirement.SetUID] = requirement.Count
+		}
+	}
+	setRowsByLine := map[int]string{}
+	setLineIndexes := map[int]bool{}
+	for actor, rows := range parsed.sets {
+		for _, row := range rows {
+			setLineIndexes[row.line] = true
+			if count, active := activeRequirements[actor][row.uid]; active {
+				setRowsByLine[row.line] = fmt.Sprintf(`%s add set="%s" count=%d;`, actor, row.uid, count)
+			}
+		}
+	}
+
+	firstStatLine := map[int]bool{}
+	duplicateStatLine := map[int]bool{}
+	for actor, indexes := range parsed.stats {
+		firstStatLine[indexes[0]] = true
+		for _, duplicate := range indexes[1:] {
+			duplicateStatLine[duplicate] = true
+		}
+		_ = actor
+	}
+	generatedEnding := ""
+	if crlf {
+		generatedEnding = "\r"
+	}
+	var output []string
+	for i, line := range lines {
+		if setLineIndexes[i] {
+			if replacement, active := setRowsByLine[i]; active {
+				output = append(output, replacement+generatedEnding)
+			}
+			continue
+		}
+		if firstStatLine[i] {
+			output = append(output, line.raw)
+			continue
+		}
+		if duplicateStatLine[i] {
+			continue
+		}
+		output = append(output, line.raw)
+	}
+	return strings.Join(output, "\n"), nil
+}
+
+func rawLinesAfter(lines []sourceLine, line int) []string {
+	if line < 0 || line+1 >= len(lines) {
+		return nil
+	}
+	rows := make([]string, 0, len(lines)-line-1)
+	for _, source := range lines[line+1:] {
+		rows = append(rows, source.raw)
+	}
+	return rows
+}
+
+func rawLines(lines []sourceLine) []string {
+	rows := make([]string, len(lines))
+	for i, line := range lines {
+		rows[i] = line.raw
+	}
+	return rows
+}
+
+func buildRequest(configText string, parsed parsedSource, fixture Fixture, binding contracts.EngineBinding,
+	seeds []uint64, options contracts.ResultOptions, rotation string,
+) (contracts.OptimizerRequest, error) {
+	request := contracts.OptimizerRequest{
+		SchemaVersion: contracts.SchemaVersion,
+		SchemaKind:    contracts.RequestSchemaKind,
+		StrategyID:    contracts.StrategyID,
+		Engine:        binding,
+		Artifacts:     append([]contracts.Artifact(nil), fixture.Artifacts...),
+		Stochastic: contracts.StochasticPolicy{
+			Mode:  "equal_weight_fixed_panel_v1",
+			Seeds: append([]uint64(nil), seeds...),
+		},
+		Budgets:       contracts.TimeBudgets{ProductTimeoutMS: 0, DevelopmentTimeoutMS: 0},
+		Cancellation:  contracts.CancellationPolicy{Mode: "process_interrupt_v1"},
+		ResultOptions: &options,
+	}
+	request.Wearers = make([]contracts.Wearer, 0, 4)
+	usesPackages := false
+	for actor, wearerKey := range fixture.WearerKeys {
+		requirements, _, err := requirementsForSlots(fixture.SlotSetUIDsByWearer[actor])
+		if err != nil {
+			return request, fmt.Errorf("wearer %s: %w", wearerKey, err)
+		}
+		wearer := contracts.Wearer{
+			WearerKey:        wearerKey,
+			WeaponKey:        parsed.weapons[wearerKey],
+			CurrentArtifacts: make([]contracts.ArtifactAssignment, 0, 5),
+		}
+		if len(requirements) == 1 {
+			wearer.SelectedSetUID = requirements[0].SetUID
+		} else {
+			wearer.SelectedSets = requirements
+			usesPackages = true
+		}
+		for slot, artifactID := range fixture.Anchor[actor] {
+			wearer.CurrentArtifacts = append(wearer.CurrentArtifacts, contracts.ArtifactAssignment{
+				WearerKey: wearerKey, Slot: slots[slot], ArtifactID: artifactID,
+			})
+		}
+		request.Wearers = append(request.Wearers, wearer)
+	}
+	request.Legality = contracts.LegalityPolicy{
+		FixedFourPiece:                   !usesPackages,
+		FixedSetPackages:                 usesPackages,
+		MaxOffSetPiecesPerWearer:         1,
+		GloballyUniqueArtifactIDs:        true,
+		DefaultMinimumRarity:             5,
+		AuthorizedLowerRarityArtifactIDs: []int64{},
+	}
+	if err := bindRunContext(&request, configText, rotation, parsed.targetText, seeds); err != nil {
+		return request, err
+	}
+	if err := request.Validate(); err != nil {
+		return request, fmt.Errorf("validate synthetic source request: %w", err)
+	}
+	return request, nil
+}
+
+func bindRunContext(request *contracts.OptimizerRequest, configText, rotation, target string, seeds []uint64) error {
+	request.Context.PreparedConfig = contracts.SourceText{Text: configText, SHA256: contracts.TextSHA256(configText)}
+	request.Context.Rotation = contracts.SourceText{Text: rotation, SHA256: contracts.TextSHA256(rotation)}
+	request.Context.Target = contracts.SourceText{Text: target, SHA256: contracts.TextSHA256(target)}
+	identity, err := contracts.CanonicalSHA256(struct {
+		PreparedConfigSHA256 string `json:"prepared_config_sha256"`
+		RotationSHA256       string `json:"rotation_sha256"`
+		TargetSHA256         string `json:"target_sha256"`
+	}{request.Context.PreparedConfig.SHA256, request.Context.Rotation.SHA256, request.Context.Target.SHA256})
+	if err != nil {
+		return err
+	}
+	request.Context.ContextSHA256 = identity
+	traceIdentity, err := contracts.CanonicalSHA256(struct {
+		Kind                string   `json:"kind"`
+		EngineBindingSHA256 string   `json:"engine_binding_sha256"`
+		PreparedConfig      string   `json:"prepared_config_sha256"`
+		Rotation            string   `json:"rotation_sha256"`
+		Target              string   `json:"target_sha256"`
+		Seeds               []uint64 `json:"seeds"`
+		InfiniteEnergy      bool     `json:"ignore_burst_energy"`
+	}{"gtt.support_fixture.trace_context.v1", request.Engine.BindingSHA256,
+		request.Context.PreparedConfig.SHA256, request.Context.Rotation.SHA256,
+		request.Context.Target.SHA256, append([]uint64(nil), seeds...), true})
+	if err != nil {
+		return err
+	}
+	request.Context.TraceContextSHA256 = traceIdentity
+	return nil
+}
+
+func validateCanonicalEngineBinding(binding contracts.EngineBinding) error {
+	if strings.TrimSpace(binding.BinaryPath) == "" {
+		return fmt.Errorf("engine binding path must be nonempty")
+	}
+	want, err := contracts.CanonicalSHA256(struct {
+		Kind                 string `json:"kind"`
+		ArtifactSHA256       string `json:"artifact_sha256"`
+		SourceManifestSHA256 string `json:"source_manifest_sha256"`
+		PatchManifestSHA256  string `json:"patch_manifest_sha256"`
+	}{"gtt.standalone_engine_binding.v1", binding.ArtifactSHA256, binding.SourceManifestSHA256, binding.PatchManifestSHA256})
+	if err != nil {
+		return err
+	}
+	if binding.BindingSHA256 != want {
+		return fmt.Errorf("engine binding SHA256 does not match its exact artifact/source/patch identities")
+	}
+	return nil
+}
