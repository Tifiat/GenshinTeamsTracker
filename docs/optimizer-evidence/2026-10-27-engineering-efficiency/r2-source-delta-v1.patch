+func TestMechanicIRWarmBindsPlanWithoutSemanticAnalysis(t *testing.T) {
+	dir := t.TempDir()
+	engine := contracts.EngineBinding{ArtifactSHA256: strings.Repeat("a", 64), SourceManifestSHA256: strings.Repeat("b", 64)}
+	source := map[string][]byte{"internal/artifacts/example/rule.go": []byte(`package example
+import deep "github.com/genshinsim/gcsim/pkg/deep"
+func Start(v int) int { return deep.Scale(v) }
+`)}
+	compile := func(multiplier string, cache *RuleParseCache) (*ruleProgram, string, MechanicIRCacheStats) {
+		body := "package deep\ntype Worker struct{}\nconst (First int = iota; Second)\nfunc (w Worker) Apply(v int) int { return v * " + multiplier + " + Second }\nfunc Scale(v int) int { return Worker{}.Apply(v) }\n"
+		repo, err := newRuleRepository(&RuleSourceRepository{Module: "github.com/genshinsim/gcsim", Files: map[string]contracts.SourceText{"pkg/deep/deep.go": {Text: body, SHA256: contracts.TextSHA256(body)}}}, build.Default)
+		if err != nil {
+			t.Fatal(err)
+		}
+		p, ir, origin, analysisErr, compileErr := prepareMechanicProgram(source, nil, repo, nil, engine, strings.Repeat("c", 64), cache)
+		if compileErr != nil || analysisErr != nil || ir == nil || p == nil {
+			t.Fatalf("prepare: %s %#v %v %v", origin, ir, analysisErr, compileErr)
+		}
+		v := newRuleVM(p, nil, 10000)
+		value, err := v.entry("Start", float64(3))
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := float64(10)
+		if multiplier == "4" {
+			want = 13
+		}
+		if value != want {
+			t.Fatalf("helper result %v, want %v", value, want)
+		}
+		return p, origin, cache.MechanicIRStats()
+	}
+	_, cold, coldStats := compile("3", NewRuleParseCache("", dir))
+	if cold != "source" || coldStats.SemanticAnalyses == 0 || coldStats.FreshBinds != 0 {
+		t.Fatalf("cold compiler did not analyze: %s %#v", cold, coldStats)
+	}
+	_, warm, warmStats := compile("3", NewRuleParseCache("", dir))
+	if warm != "writable" || warmStats.SemanticAnalyses != 0 || warmStats.FreshBinds != 1 {
+		t.Fatalf("warm did not bind saved plan: %s %#v", warm, warmStats)
+	}
+	_, changed, changedStats := compile("4", NewRuleParseCache("", dir))
+	if changed != "source" || changedStats.SemanticAnalyses == 0 {
+		t.Fatalf("deep helper did not invalidate: %s %#v", changed, changedStats)
+	}
+	t.Setenv("GTT_MECHANIC_CACHE_ENABLED", "0")
+	_, off, offStats := compile("3", NewRuleParseCache(dir, dir))
+	if off != "source" || offStats.SemanticAnalyses == 0 || offStats.FreshBinds != 0 {
+		t.Fatalf("cache-off skipped source analysis: %s %#v", off, offStats)
+	}
+}
