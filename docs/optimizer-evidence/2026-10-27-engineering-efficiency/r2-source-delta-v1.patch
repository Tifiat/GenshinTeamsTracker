+			}
+		}
+	}
+	if !foundEndpoint || combined.FormulaEvaluations > 5 || individual.FormulaEvaluations > 8 {
+		t.Fatal("independent endpoint disappeared or proposal quota expanded", combined, individual)
+	}
+	// The no-loss second-owner alternative can legitimately lead. The policy
+	// promises complementary global shapes, not a pair belonging to one owner.
+	secondOwnerLocal := anchor.Assignment
+	secondOwnerLocal[1][0] = distractor.ArtifactID
+	secondOwnerEndpoint := secondOwnerLocal
+	secondOwnerEndpoint[1][4] = circlet.ArtifactID // legal off-piece, not an owner/role hint
+	generatedSecondOwnerEndpoint := false
