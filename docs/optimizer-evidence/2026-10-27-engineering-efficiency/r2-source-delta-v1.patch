new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/proposal_priority_test.go
@@ -0,0 +1,54 @@
+package supportimpact
+
+import "testing"
+
+func TestLocalProposalGuideIncludesOwnLossAndAveragesRepeatedAxes(t *testing.T) {
+	axes := []ProposalAxis{
+		{Stat: "hp_percent", Amount: .2, TotalChange: 20, OtherChange: 20, MissingForeign: true},
+		{Stat: "hp_percent", Amount: -.2, TotalChange: -20, OtherChange: -20, MissingForeign: true},
+		{Stat: "atk_percent", Amount: .2, TotalChange: 40},
+	}
+	p, err := LocalProposalPriority(axes, map[string]float64{"atk_percent": .4}, map[string]float64{"hp_percent": .2, "atk_percent": .2}, 1)
+	if err != nil || p.TotalGuide != -20 || p.OtherGuide != 20 || p.MissingOtherGuide != 20 || p.UnmeasuredLosses != 0 {
+		t.Fatalf("lost signed opportunity cost or duplicated +/- weight: %+v %v", p, err)
+	}
+}
+
+func TestLocalProposalUnknownLossUsesShapeWithoutInventingDamage(t *testing.T) {
+	axes := []ProposalAxis{{Stat: "hp_percent", Amount: .2, TotalChange: 20}}
+	before := map[string]float64{"crit_rate": .3}
+	local, _ := LocalProposalPriority(axes, before, map[string]float64{"hp_percent": .2, "crit_rate": .2}, 1)
+	endpoint, _ := LocalProposalPriority(axes, before, map[string]float64{"hp_percent": 1, "crit_rate": .1}, 5)
+	if local.TotalGuide != 20 || endpoint.TotalGuide != 100 || local.UnmeasuredLosses != 1 || CompareProposalPriorities(local, endpoint) >= 0 {
+		t.Fatal("unknown crit loss became fake DPS or crowded out local shape", local, endpoint)
+	}
+	clear, _ := LocalProposalPriority(axes, before, map[string]float64{"hp_percent": 1, "crit_rate": .3}, 5)
+	if CompareProposalPriorities(clear, local) >= 0 {
+		t.Fatal("clear complete endpoint was permanently starved", clear, local)
+	}
+}
+
+func TestLocalProposalNegativeGuideCannotOutrankPositiveMissingEscape(t *testing.T) {
+	negative := ProposalPriority{Available: true, TotalGuide: -1, MissingOtherGuide: 100}
+	positive := ProposalPriority{Available: true, TotalGuide: 1}
+	if CompareProposalPriorities(negative, positive) <= 0 {
+		t.Fatal("foreign gain hid measured own loss")
+	}
+}
+
+func TestLocalProposalLegacyZeroMetadataAndOrdering(t *testing.T) {
+	legacy := ProposalPriority{}
+	if CompareProposalPriorities(legacy, legacy) != 0 || ValidateProposalPriority(legacy) != nil {
+		t.Fatal("legacy zero metadata became evidence")
+	}
+	rows := []ProposalPriority{legacy, {Available: true, TotalGuide: -1}, {Available: true, TotalGuide: 2, ChangedSlots: 1}, {Available: true, TotalGuide: 10, UnmeasuredLosses: 1, ChangedSlots: 5}}
+	for _, a := range rows {
+		for _, b := range rows {
+			for _, c := range rows {
+				if CompareProposalPriorities(a, b) < 0 && CompareProposalPriorities(b, c) < 0 && CompareProposalPriorities(a, c) >= 0 {
+					t.Fatal("nontransitive proposal ordering")
+				}
+			}
+		}
+	}
+}
diff --git a/internal/supportimpact/run.go b/internal/supportimpact/run.go
new file mode 100644
--- /dev/null
+++ b/internal/supportimpact/run.go
@@ -0,0 +1,233 @@
+package supportimpact
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/engineclient"
+)
+
+const maxResponseCheckCalls = 128
+
+// ResponseAllowance is an explicit local ceiling for one fixed response
+// panel. A zero-call allowance is valid and is reported as unprobed when the
+// structural graph says a check is needed.
+type ResponseAllowance struct {
+	MaxCalls int
+	Timeout  time.Duration
+}
+
+// ResponseCheck holds either a no-probe structural status or one bounded
+// ordinary-response panel. Directions remain proposal evidence; this result
+// is never a formula correction, cap certificate, or finalist verification.
+type ResponseCheck struct {
+	Plan          ResponsePlan                     `json:"plan"`
+	SelectedSeeds []int64                          `json:"selected_seeds"`
+	Binding       engineclient.StatResponseBinding `json:"binding"`
+	Evidence      *engineclient.StatResponseResult `json:"evidence,omitempty"`
+	Directions    []Direction                      `json:"directions"`
+	Status        string                           `json:"status"`
+	ElapsedMS     float64                          `json:"elapsed_ms"`
+}
+
+type responseEngineBinder func(contracts.OptimizerRequest) (engineclient.BoundEngine, error)
+type responseProbeRunner func(context.Context, engineclient.BoundEngine, string, string, engineclient.StatResponsePlan) (engineclient.StatResponseResult, error)
+
+// These package-private seams let unit tests exercise policy and partial
+// failure handling without starting an engine process.
+var bindResponseEngine responseEngineBinder = engineclient.BindEngine
+var probeResponseStatInputs responseProbeRunner = engineclient.ProbeStatResponses
+
+// RunResponseCheck is the shared, capture-independent bridge from structural
+// gaps to a predeclared ordinary simulator panel with exact-zero early stops.
+// It performs no capture, retries, widening, candidate reranking, or fallback. Mode
+// callers decide whether invoking this helper is authorized for their path.
+func RunResponseCheck(
+	ctx context.Context,
+	request contracts.OptimizerRequest,
+	coverage Report,
+	exactAnchorConfig string,
+	managedRoot string,
+	allowance ResponseAllowance,
+) (check ResponseCheck, retErr error) {
+	started := time.Now()
+	check.Directions = []Direction{}
+	defer func() { check.ElapsedMS = float64(time.Since(started)) / float64(time.Millisecond) }()
+	if ctx == nil {
+		return check, errors.New("response check requires a context")
+	}
+	if allowance.MaxCalls < 0 || allowance.MaxCalls > maxResponseCheckCalls || allowance.Timeout <= 0 {
+		return check, fmt.Errorf("response check requires 0..%d calls and a positive timeout", maxResponseCheckCalls)
+	}
+	boundedCtx, cancel := context.WithTimeout(ctx, allowance.Timeout)
+	defer cancel()
+	if exactAnchorConfig == "" {
+		return check, errors.New("response check requires the exact full-build anchor config")
+	}
+	if request.Legality.TheorySearch {
+		if len(request.Artifacts) == 0 {
+			// The wire Theory request deliberately carries a non-owned baseline,
+			// not inventory artifacts. Expand only for strict validation; keep the
+			// original request for request identity, binding, and actor order.
+			_, retErr = request.ExpandTheoryBaselines()
+		} else {
+			// An already-expanded Theory request still uses the strict contract.
+			retErr = request.ValidateTheory()
+		}
+	} else {
+		retErr = request.Validate()
+	}
+	if retErr != nil {
+		return check, fmt.Errorf("validate response-check request: %w", retErr)
+	}
+	actors := make([]string, 0, len(request.Wearers))
+	for _, wearer := range request.Wearers {
+		actors = append(actors, wearer.WearerKey)
+	}
+	check.SelectedSeeds = firstResponseSeeds(request.Stochastic.Seeds)
+	if len(check.SelectedSeeds) < 2 {
+		if !coverage.NeedsResponseCheck() {
+			check.Plan = emptyResponsePlan(false, check.SelectedSeeds)
+			check.Status = "not_required"
+			return check, nil
+		}
+		check.Plan = emptyResponsePlan(true, check.SelectedSeeds)
+		check.Status = "unprobed_insufficient_seeds"
+		return check, nil
+	}
+	selectedSeeds := []uint64{uint64(check.SelectedSeeds[0]), uint64(check.SelectedSeeds[1])}
+	check.Plan, retErr = PlanResponseCheck(coverage, actors, selectedSeeds, allowance.MaxCalls)
+	if retErr != nil {
+		check.Status = "failed"
+		return check, fmt.Errorf("plan bounded response check: %w", retErr)
+	}
+	if !check.Plan.Required {
+		check.Status = "not_required"
+		return check, nil
+	}
+	if check.Plan.Plan.CallLimit == 0 || len(check.Plan.Plan.Perturbations) == 0 {
+		check.Status = "unprobed_zero_plan"
+		return check, nil
+	}
+	requestSHA, err := contracts.CanonicalSHA256(request)
+	if err != nil {
+		check.Status = "failed"
+		return check, fmt.Errorf("identify response-check request: %w", err)
+	}
+	check.Plan.Plan.RequestSHA256 = requestSHA
+	expectedBinding := engineclient.StatResponseBinding{
+		AnchorConfigSHA256:         contracts.TextSHA256(exactAnchorConfig),
+		RequestSHA256:              requestSHA,
+		EngineArtifactSHA256:       request.Engine.ArtifactSHA256,
+		EngineBindingSHA256:        request.Engine.BindingSHA256,
+		EngineSourceManifestSHA256: request.Engine.SourceManifestSHA256,
+		EnginePatchManifestSHA256:  request.Engine.PatchManifestSHA256,
+	}
+	bound, err := bindResponseEngine(request)
+	if err != nil {
+		check.Status = "failed"
+		return check, fmt.Errorf("bind response-check engine: %w", err)
+	}
+	check.Binding = expectedBinding
+	if err := boundedCtx.Err(); err != nil {
+		check.Status = "failed"
+		return check, fmt.Errorf("response check canceled before seeded capability check: %w", err)
+	}
+	if !hasEngineCapability(request.Engine.Capabilities, engineclient.SeededOrdinaryCapability) {
+		// Seeded ordinary calls are an optional diagnostic capability. Older
+		// rollback engines can still verify complete finalists through the normal
+		// ordinary path; do not fail the product run or substitute random seeds.
+		check.Status = "unprobed_seeded_ordinary_unavailable"
+		return check, nil
+	}
+	evidence, probeErr := probeResponseStatInputs(boundedCtx, bound, exactAnchorConfig, managedRoot, check.Plan.Plan)
+	check.Evidence = &evidence
+	check.Binding = evidence.Binding
+	if evidence.Binding != expectedBinding || evidence.PreparedConfigSHA256 != expectedBinding.AnchorConfigSHA256 {
+		identityErr := errors.New("stat-response evidence is bound to a different request, anchor, or engine")
+		if probeErr != nil {
+			probeErr = errors.Join(probeErr, identityErr)
+		} else {
+			probeErr = identityErr
+		}
+	}
+	if probeErr != nil {
+		check.Status = "failed"
+		return check, fmt.Errorf("run bounded response check: %w", probeErr)
+	}
+	if evidence.ScreeningEnabled != check.Plan.Plan.ScreenZeroFirstSeed ||
+		evidence.AttemptedCalls+evidence.SkippedCalls != evidence.CallLimit ||
+		evidence.CallLimit != check.Plan.Plan.CallLimit {
+		check.Status = "failed"
+		return check, errors.New("stat-response evidence has incomplete or inconsistent call accounting")
+	}
+	if len(evidence.Perturbations) != len(check.Plan.Plan.Perturbations) {
+		check.Status = "failed"
+		return check, errors.New("stat-response evidence does not match the fixed perturbation plan")
+	}
+	for index, row := range evidence.Perturbations {
+		if row.Perturbation != check.Plan.Plan.Perturbations[index] {
+			check.Status = "failed"
+			return check, errors.New("stat-response perturbation differs from the fixed plan")
+		}
+	}
+	if len(evidence.Baseline) != len(check.SelectedSeeds) {
+		check.Status = "failed"
+		return check, errors.New("stat-response evidence does not contain the complete selected seed pair")
+	}
+	for index, sample := range evidence.Baseline {
+		if sample.Seed != check.SelectedSeeds[index] || sample.ConfigSHA256 != evidence.ProbeConfigSHA256 {
+			check.Status = "failed"
+			return check, errors.New("stat-response baseline seed or ordinary config binding mismatch")
+		}
+	}
+	check.Directions, err = DirectionsFromResponses(actors, evidence)
+	if err != nil {
+		check.Status = "failed"
+		return check, fmt.Errorf("interpret bounded response evidence: %w", err)
+	}
+	check.Status = "completed_proposal_only"
+	return check, nil
+}
+
+func hasEngineCapability(capabilities []string, required string) bool {
+	for _, capability := range capabilities {
+		if capability == required {
+			return true
+		}
+	}
+	return false
+}
+
+func firstResponseSeeds(seeds []uint64) []int64 {
+	out := make([]int64, 0, 2)
+	seen := make(map[uint64]bool, 2)
+	for _, seed := range seeds {
+		if seed == 0 || seed > uint64(^uint64(0)>>1) || seen[seed] {
+			continue
+		}
+		seen[seed] = true
+		out = append(out, int64(seed))
+		if len(out) == 2 {
+			break
+		}
+	}
+	return out
+}
+
+func emptyResponsePlan(required bool, seeds []int64) ResponsePlan {
+	return ResponsePlan{
+		Required: required,
+		Plan: engineclient.StatResponsePlan{
+			Seeds:         append([]int64{}, seeds...),
+			Perturbations: []engineclient.StatResponsePerturbation{},
+		},
+		Targets:      []ProbeTarget{},
+		Deferred:     []ProbeTarget{},
+		OmittedStats: []string{},
+		Scope:        "bounded_local_support_stat_subset_not_completeness",
+	}
+}
