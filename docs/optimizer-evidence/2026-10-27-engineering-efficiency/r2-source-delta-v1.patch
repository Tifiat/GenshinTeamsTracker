+package seteffects
+
+import (
+	"go/build"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func TestRuleRepositoryLoadsNewNestedHelpersAndPreservesVMIsolation(t *testing.T) {
+	files := map[string]string{
+		"pkg/newhelpers/outer.go": `package newhelpers
+import inner "github.com/genshinsim/gcsim/pkg/newinner"
+type Worker struct{}
+func (w Worker) Apply(n int) int { return inner.Scale(n) }
+func Run(n int) int { return Worker{}.Apply(n) }
+`,
+		"pkg/newinner/windows.go": "//go:build windows\n\npackage newinner\nfunc Scale(n int) int { return n*3 }",
+		"pkg/newinner/unix.go": "//go:build !windows\n\npackage newinner\nfunc Scale(n int) int { return n*100 }",
+	}
+	input := &RuleSourceRepository{Module:"github.com/genshinsim/gcsim",Files:map[string]contracts.SourceText{}}
+	for name,text := range files { input.Files[name] = contracts.SourceText{Text:text,SHA256:contracts.TextSHA256(text)} }
+	profile := build.Default
+	profile.GOOS,profile.GOARCH = "windows","amd64"
+	repository,err := newRuleRepository(input,profile)
+	if err != nil { t.Fatal(err) }
+	p,err := compileRuleProgram(map[string][]byte{"internal/artifacts/new/rule.go":[]byte(`package sample
+import helper "github.com/genshinsim/gcsim/pkg/newhelpers"
+func Start() func() int {
+  calls := 0
+  return func() int { calls++; return helper.Run(2)+calls }
+}
+`)},nil)
+	if err != nil { t.Fatal(err) }
+	p.repository = repository
+	for run := 0; run < 2; run++ {
+		// Invocation-local closures are not shared by the parsed program.
+		v := newRuleVM(p,nil,10000)
+		fn,err := v.entry("Start")
+		if err != nil { t.Fatal(err) }
+		got,err := ruleTry(func()any{return v.invoke(fn,nil)})
+		if err != nil || got != float64(7) { t.Fatalf("new helper resolution: %v %v",got,err) }
+		got,err = ruleTry(func()any{return v.invoke(fn,nil)})
+		if err != nil || got != float64(8) { t.Fatalf("local closure state lost: %v %v",got,err) }
+	}
+}
+
+func TestRuleRepositoryDoesNotInventWearerLocalPackageGlobals(t *testing.T) {
+	v := testRule(t, `var calls int
+func Start() int { calls++; return calls }`, nil)
+	_,err := v.entry("Start")
+	if err == nil { t.Fatal("shared package mutation was silently treated as wearer-local state") }
+}
+
+func TestRuleRepositoryRejectsChangedSourceAndUnsafePaths(t *testing.T) {
+	for _,name := range []string{"../outside.go","/absolute.go","pkg/a/../../outside.go","pkg/a\\outside.go"} {
+		_,err := newRuleRepository(&RuleSourceRepository{Module:"github.com/genshinsim/gcsim",Files:map[string]contracts.SourceText{name:{Text:"package a",SHA256:contracts.TextSHA256("package a")}}},build.Default)
+		if err == nil { t.Fatal("accepted unbound source path",name) }
+	}
+	_,err := newRuleRepository(&RuleSourceRepository{Module:"github.com/genshinsim/gcsim",Files:map[string]contracts.SourceText{"pkg/a/a.go":{Text:"package changed",SHA256:contracts.TextSHA256("package original")}}},build.Default)
+	if err == nil { t.Fatal("accepted a stale source body") }
+}
