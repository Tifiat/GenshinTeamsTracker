+	circlet.MainStat = contracts.StatValue{Key: "hp_percent", Value: "0.466"}
+	circlet.Substats = append([]contracts.StatValue{}, circlet.Substats...)
+	for i := range circlet.Substats {
+		if circlet.Substats[i].Key == "hp_percent" {
+			circlet.Substats[i] = contracts.StatValue{Key: "crit_damage", Value: "0.124"}
+		}
+	}
+	sort.Slice(circlet.Substats, func(i, j int) bool { return circlet.Substats[i].Key < circlet.Substats[j].Key })
+	distractor := request.Artifacts[5]
+	distractor.ArtifactID = 99006
+	distractor.Substats = append([]contracts.StatValue{}, distractor.Substats...)
+	for i := range distractor.Substats {
+		if distractor.Substats[i].Key == "hp_percent" {
+			distractor.Substats[i].Value = "0.147"
+		}
+	}
+	request.Artifacts = append(request.Artifacts, flower, circlet, distractor)
+	panel, index := responseShapeTestPanel(t, request, compact, 0)
+	directions := []supportimpact.Direction{
+		{Owner: request.Wearers[0].WearerKey, Stat: "hp_percent", Amount: .2, MeanDPSChange: 20,
+			MeanOtherDPSChange: 20, MinimumOtherDPSChange: 19, Status: "positive_on_sampled_seeds"},
+		{Owner: request.Wearers[1].WearerKey, Stat: "hp_percent", Amount: .2, MeanDPSChange: .1,
+			Status: "positive_on_sampled_seeds"},
+	}
+	anchor, ordered, combined, individual := responseShapeTestProposals(t, index, panel, directions)
+	endpoint := anchor.Assignment
+	endpoint[0][0], endpoint[0][4] = flower.ArtifactID, circlet.ArtifactID
+	foundEndpoint := false
+	for _, row := range ordered {
+		if row.Assignment == endpoint {
+			foundEndpoint = true
+			if row.DPS >= anchor.DPS {
