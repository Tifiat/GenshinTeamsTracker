+
+// MechanicFallbackPlan carries a real full-build anchor and an explicit model
+// gap. It is not a formula candidate and must not enter formula pruning.
+type MechanicFallbackPlan struct {
+	Decision        mechanicpolicy.Decision     `json:"decision"`
+	Anchor          domain.Assignment           `json:"anchor"`
+	AnchorSource    mechanicpolicy.AnchorSource `json:"anchor_source"`
+	DiagnosticCodes []string                    `json:"diagnostic_codes,omitempty"`
+}
+
+// MeasuredOnlyMechanicAnchor has no formula field to accidentally serialize a
+// placeholder zero as a valid fast estimate. It records the actual ordinary
+// sample count and engine result identity.
+type MeasuredOnlyMechanicAnchor struct {
+	Assignment         domain.Assignment           `json:"assignment"`
+	AnchorSource       mechanicpolicy.AnchorSource `json:"anchor_source"`
+	MeasuredDPS        float64                     `json:"measured_dps"`
+	StandardDeviation  float64                     `json:"standard_deviation"`
+	StandardError      float64                     `json:"standard_error"`
+	Iterations         int                         `json:"iterations"`
+	ConfigSHA256       string                      `json:"config_sha256"`
+	EngineResultSHA256 string                      `json:"engine_result_sha256"`
+	ModelAccuracy      string                      `json:"model_accuracy"`
+	SearchCoverage     string                      `json:"search_coverage"`
+	DiagnosticCodes    []string                    `json:"diagnostic_codes,omitempty"`
+}
+
+// prepareMechanicFallback accepts only typed source-model unavailability. A
+// protocol, invalid rotation, ordinary energy failure, or Cancel is returned
+// unchanged. remainingSlots is the caller's existing finalist capacity.
+func prepareMechanicFallback(request contracts.OptimizerRequest, index *domain.Index, modelErr error, finishedEarly bool, remainingSlots int, hasMeasuredAnchor bool) (MechanicFallbackPlan, error) {
+	var plan MechanicFallbackPlan
+	if modelErr == nil {
+		return plan, fmt.Errorf("missing typed mechanic model failure")
+	}
+	unavailable, ok := mechanicpolicy.AsModelUnavailable(modelErr)
+	if !ok {
+		return plan, modelErr
+	}
+	anchor, source, err := mechanicpolicy.SelectInventoryAnchor(index)
+	if err != nil {
+		return plan, err
+	}
+	plan.Anchor, plan.AnchorSource = anchor, source
+	plan.DiagnosticCodes = append([]string(nil), unavailable.Codes...)
+	plan.Decision = mechanicpolicy.Decide(mechanicpolicy.Request{
+		Failure: unavailable.Kind, FastMode: request.EffectiveResultOptions().FastMode,
+		FinishedEarly: finishedEarly, RemainingOrdinarySlots: remainingSlots,
+		HasLegalAnchor: true, HasMeasuredAnchor: hasMeasuredAnchor,
+	})
+	return plan, nil
+}
+
+type MeasuredOnlyFullBuildAnchor struct {
+	BuildIdentity      json.RawMessage `json:"build_identity"`
+	MeasuredDPS        float64         `json:"measured_dps"`
+	StandardDeviation  *float64        `json:"standard_deviation"`
+	StandardError      *float64        `json:"standard_error"`
+	Iterations         int             `json:"iterations"`
+	ConfigSHA256       string          `json:"config_sha256"`
+	EngineResultSHA256 string          `json:"engine_result_sha256"`
+	ModelAccuracy      string          `json:"model_accuracy"`
+	SearchCoverage     string          `json:"search_coverage"`
+	DiagnosticCodes    []string        `json:"diagnostic_codes,omitempty"`
+}
+
+// Theory can supply a complete legal Witness45 build and its existing ordinary
+// renderer here. The policy never manufactures a Theory build from an
+// unavailable source model or treats an incomplete witness as legal.
+func verifyFullBuildMechanicFallback(ctx context.Context, request contracts.OptimizerRequest, decision mechanicpolicy.Decision, candidate finalists.FullBuildCandidate, render finalists.FullBuildRenderer, runRoot string, iterations int, codes []string) (*MeasuredOnlyFullBuildAnchor, error) {
+	if !decision.Recoverable {
+		return nil, fmt.Errorf("mechanic model failure is not recoverable")
+	}
+	if !decision.VerifyOrdinary {
+		return nil, nil
+	}
+	if decision.OrdinarySlots != 1 || len(candidate.BuildIdentity) == 0 || render == nil || iterations <= 0 {
+		return nil, fmt.Errorf("missing complete ordinary fallback build")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	candidate.FormulaDPS = 0 // legacy verifier field; no formula enters the result.
+	verified, err := finalists.VerifyFullBuildsWithRenderer(ctx, request, []finalists.FullBuildCandidate{candidate}, render, filepath.Join(runRoot, "mechanic-full-anchor"), iterations, 1, 4, nil)
+	if err != nil {
+		return nil, err
+	}
+	if len(verified.Measurements) != 1 || verified.Iterations != iterations || verified.Measurements[0].Iterations != iterations {
+		return nil, fmt.Errorf("ordinary full-build mechanic anchor verification identity mismatch")
+	}
+	row := verified.Measurements[0]
+	return &MeasuredOnlyFullBuildAnchor{BuildIdentity: append(json.RawMessage(nil), row.BuildIdentity...), MeasuredDPS: row.MeasuredDPS, StandardDeviation: row.StandardDeviation, StandardError: row.StandardError, Iterations: row.Iterations, ConfigSHA256: row.ConfigSHA256, EngineResultSHA256: row.EngineResultSHA256, ModelAccuracy: "unavailable", SearchCoverage: decision.SearchCoverage, DiagnosticCodes: append([]string(nil), codes...)}, nil
+}
+
+type mechanicFallbackVerifier func(context.Context, contracts.OptimizerRequest, *domain.Index, []search.ScoredAssignment, string, int, int, int) (finalists.VerificationResult, error)
+
+func verifyMechanicFallback(ctx context.Context, request contracts.OptimizerRequest, index *domain.Index, plan MechanicFallbackPlan, runRoot string) (*MeasuredOnlyMechanicAnchor, error) {
+	return verifyMechanicFallbackWith(ctx, request, index, plan, runRoot, finalists.Verify)
+}
+
+func verifyMechanicFallbackWith(ctx context.Context, request contracts.OptimizerRequest, index *domain.Index, plan MechanicFallbackPlan, runRoot string, verify mechanicFallbackVerifier) (*MeasuredOnlyMechanicAnchor, error) {
+	if !plan.Decision.Recoverable {
+		return nil, fmt.Errorf("mechanic model failure is not recoverable")
+	}
+	if !plan.Decision.VerifyOrdinary {
+		return nil, nil
+	}
+	if plan.Decision.OrdinarySlots != 1 || verify == nil {
+		return nil, fmt.Errorf("invalid ordinary mechanic anchor reservation")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if index == nil {
+		return nil, &mechanicpolicy.NoLegalAnchorError{}
+	}
+	if err := index.ValidateAssignment(plan.Anchor); err != nil {
+		return nil, fmt.Errorf("mechanic anchor is not a legal physical build: %w", err)
+	}
+	// Verify's legacy candidate shape requires a finite numeric formula input.
+	// The placeholder is never exposed, ranked against another candidate, or
+	// used for a bound; this wrapper returns only the actual ordinary result.
+	candidate := search.ScoredAssignment{Assignment: plan.Anchor, Source: "mechanic_fallback_anchor"}
+	verified, err := verify(ctx, request, index, []search.ScoredAssignment{candidate}, filepath.Join(runRoot, "mechanic-anchor-n500"), 500, 4, 1)
+	if err != nil {
+		return nil, err
+	}
+	if len(verified.Candidates) != 1 || verified.Iterations != 500 || verified.Candidates[0].Assignment != plan.Anchor || verified.Candidates[0].Iterations != 500 {
+		return nil, fmt.Errorf("ordinary mechanic anchor verification identity mismatch")
+	}
+	row := verified.Candidates[0]
+	return &MeasuredOnlyMechanicAnchor{
+		Assignment: plan.Anchor, AnchorSource: plan.AnchorSource, MeasuredDPS: row.MeasuredDPS,
+		StandardDeviation: row.StandardDeviation, StandardError: row.StandardError,
+		Iterations: row.Iterations, ConfigSHA256: row.ConfigSHA256, EngineResultSHA256: row.EngineResultSHA256,
+		ModelAccuracy: "unavailable", SearchCoverage: plan.Decision.SearchCoverage,
+		DiagnosticCodes: append([]string(nil), plan.DiagnosticCodes...),
+	}, nil
+}
