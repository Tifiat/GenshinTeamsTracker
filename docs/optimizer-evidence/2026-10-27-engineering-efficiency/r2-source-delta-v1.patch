+func earlyPreparationCategory(pack domain.Package) string {
+	switch {
+	case len(pack.Sets) == 0:
+		return "none"
+	case len(pack.Sets) == 1 && pack.Sets[0].Count == 2:
+		return "two_piece"
+	case len(pack.Sets) == 1 && pack.Sets[0].Count == 4:
+		return "four_piece"
+	case len(pack.Sets) == 2 && pack.Sets[0].Count == 2 && pack.Sets[1].Count == 2:
+		return "two_plus_two"
+	default:
+		return "unexpected_fail_closed"
+	}
+}
