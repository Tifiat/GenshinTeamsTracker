+func neutralCandidateMemoFixture(t *testing.T) (*domain.Index, Candidate, search.Config) {
+	t.Helper()
+	index, base, _, provider, cfg := coordinatorFixture(t)
+	session, err := setcontext.NewSession(provider, len(base.Seeds()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle, err := session.Resolve(context.Background(), base, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	panel, err := handle.SearchPanel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var packs [4]domain.Package
+	for actor, wearer := range index.Wearers {
+		packs[actor] = domain.Package{Sets: wearer.SelectedSets}
+	}
+	view, err := index.ForPackages(packs, index.Incumbent, panel.Coordinates())
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := Candidate{Context: base, Handle: handle, Index: view, Packages: packs,
+		Score: search.ScoredAssignment{Assignment: index.Incumbent}}
+	return index, c, cfg.Search
+}
