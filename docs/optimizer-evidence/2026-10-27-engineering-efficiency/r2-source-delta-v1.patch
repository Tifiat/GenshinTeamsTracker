+
+func dispatchRepository(t *testing.T) *ruleRepository {
+	t.Helper()
+	repository, err := newRuleRepository(&RuleSourceRepository{
+		Module: "github.com/genshinsim/gcsim", Files: map[string]contracts.SourceText{},
+	}, build.Default)
+	if err != nil {
+		t.Fatal(err)
+	}
