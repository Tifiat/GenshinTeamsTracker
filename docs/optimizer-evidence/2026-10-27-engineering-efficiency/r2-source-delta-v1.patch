+package search
+
+import (
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+func TestResearchCandidateMetricsAreEngineLocal(t *testing.T) {
+	selected := []contracts.SetRequirement{{SetUID: "set-a", Count: 2}}
+	index := &domain.Index{}
+	index.Wearers[0].SelectedSets = selected
+	first := &Engine{domain: index}
+	second := &Engine{domain: index}
+
+	metric := researchCandidateMetric(first, 0)
+	if metric == nil {
+		t.Fatal("candidate metric was not initialized for a valid engine actor")
+	}
+	metric.CandidateRuns = 3
+	metric.PointProgramCalls = 7
+
+	packageKey := (domain.Package{Sets: selected}).Key()
+	if got := first.ResearchCandidateCostFor(0, packageKey); got.CandidateRuns != 3 || got.PointProgramCalls != 7 {
+		t.Fatalf("first engine telemetry = %+v, want its own recorded counts", got)
+	}
+	if got := second.ResearchCandidateCostFor(0, packageKey); got != (ResearchCandidateCost{}) {
+		t.Fatalf("second engine inherited telemetry from first engine: %+v", got)
+	}
+}
diff --git a/internal/search/response_candidates.go b/internal/search/response_candidates.go
new file mode 100644
--- /dev/null
+++ b/internal/search/response_candidates.go
@@ -0,0 +1,279 @@
+package search
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"sort"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/supportimpact"
+)
+
+type ResponseProposal struct {
+	Candidate          ScoredAssignment `json:"candidate"`
+	Owner              string           `json:"owner"`
+	Stat               string           `json:"stat"`
+	ArtifactStatChange float64          `json:"artifact_stat_change"`
+	ProbeConfigSHA256  string           `json:"probe_config_sha256"`
+	Shape              string           `json:"proposal_shape,omitempty"`
+}
+
+type ResponseProposals struct {
+	Proposals                    []ResponseProposal `json:"proposals"`
+	ArtifactVisits               int                `json:"artifact_visits"`
+	FormulaEvaluations           int                `json:"formula_evaluations"`
+	DirectionsConsidered         int                `json:"directions_considered"`
+	DirectionsDeferred           int                `json:"directions_deferred"`
+	DirectionsQuotaLimited       int                `json:"directions_quota_limited"`
+	BudgetExhausted              bool               `json:"budget_exhausted"`
+	RequiresOrdinaryVerification bool               `json:"requires_ordinary_verification"`
+}
+
+// ProposeResponseDirections is shared by Selected and All Sets inventory
+// search. It generates legal alternatives in observed improving directions
+// without requiring the broken formula to rank them highly. Its candidates
+// MUST be reserved a verification lane; merging them into a formula top-K
+// would recreate the defect this escape lane addresses.
+//
+// This function does not change an incumbent, run a simulation or invent a
+// repaired DPS objective. Each DPS field remains the original formula score.
+// The probe is local evidence only: an endpoint can exceed a cap or trade away
+// another useful stat, which is why ordinary full-build verification decides.
+func (engine *Engine) ProposeResponseDirections(ctx context.Context, anchor domain.Assignment,
+	directions []supportimpact.Direction, maxCandidates, maxVisits int) (ResponseProposals, error) {
+	out := ResponseProposals{Proposals: []ResponseProposal{}, RequiresOrdinaryVerification: true}
+	if maxCandidates <= 0 || maxVisits <= 0 {
+		return out, fmt.Errorf("response proposal budgets must be positive")
+	}
+	if err := engine.domain.ValidateAssignment(anchor); err != nil {
+		return out, err
+	}
+	seen := map[domain.Assignment]bool{anchor: true}
+	anchorStats, err := engine.domain.AssignmentStats(anchor)
+	if err != nil {
+		return out, err
+	}
+	knownForeign := engine.panel.SupportCoverage().KnownForeignCoordinates()
+	eligible := responseDirectionRounds(directions)
+	for directionIndex, direction := range eligible {
+		if err := ctx.Err(); err != nil {
+			return out, err
+		}
+		if direction.Stat == "" || direction.Amount == 0 || math.IsNaN(direction.Amount) || math.IsInf(direction.Amount, 0) {
+			return out, fmt.Errorf("invalid measured response direction")
+		}
+		actor := -1
+		for i, wearer := range engine.domain.Wearers {
+			if wearer.WearerKey == direction.Owner {
+				actor = i
+				break
+			}
+		}
+		if actor < 0 {
+			return out, fmt.Errorf("response direction owner is outside the team")
+		}
+		remainingDirections := len(eligible) - directionIndex
+		remainingCandidates := maxCandidates - len(out.Proposals)
+		remainingVisits := maxVisits - out.ArtifactVisits
+		if remainingCandidates <= 0 || remainingVisits <= 0 {
+			out.BudgetExhausted = true
+			out.DirectionsDeferred += remainingDirections
+			break
+		}
+		out.DirectionsConsidered++
+		candidateLimit := len(out.Proposals) + (remainingCandidates+remainingDirections-1)/remainingDirections
+		visitLimit := out.ArtifactVisits + (remainingVisits+remainingDirections-1)/remainingDirections
+		sign := math.Copysign(1, direction.Amount)
+		startStat, err := engine.domain.AssignmentStat(anchor, actor, direction.Stat)
+		if err != nil {
+			return out, err
+		}
+		axes := []supportimpact.ProposalAxis{}
+		for _, measured := range directions {
+			if measured.Owner == direction.Owner {
+				axes = append(axes, supportimpact.ProposalAxis{Stat: measured.Stat, Amount: measured.Amount,
+					TotalChange: measured.MeanDPSChange, OtherChange: measured.MeanOtherDPSChange,
+					MissingForeign: measured.MinimumOtherDPSChange > 0 && !knownForeign[measured.Owner+"."+measured.Stat]})
+			}
+		}
+		priorities := map[domain.Assignment]supportimpact.ProposalPriority{}
+		priorityFor := func(candidate domain.Assignment) (supportimpact.ProposalPriority, error) {
+			if p, found := priorities[candidate]; found {
+				return p, nil
+			}
+			stats, e := engine.domain.AssignmentStats(candidate)
+			if e != nil {
+				return supportimpact.ProposalPriority{}, e
+			}
+			distance := 0
+			for slot := range anchor[actor] {
+				if candidate[actor][slot] != anchor[actor][slot] {
+					distance++
+				}
+			}
+			p, e := supportimpact.LocalProposalPriority(axes, anchorStats[actor], stats[actor], distance)
+			if e == nil {
+				priorities[candidate] = p
+			}
+			return p, e
+		}
+	directionLanes:
+		for _, current := range engine.lanes(anchor, actor) {
+			trial := anchor
+			var bestLocal domain.Assignment
+			var bestLocalPriority supportimpact.ProposalPriority
+			foundLocal := false
+			for slot, pool := range current.pools {
+				best, bestValue := int64(0), math.Inf(-1)
+				anchorValue, e := engine.domain.ArtifactStat(anchor[actor][slot], direction.Stat)
+				if e != nil {
+					return out, e
+				}
+				anchorValue *= sign
+				for _, id := range pool {
+					if err := ctx.Err(); err != nil {
+						return out, err
+					}
+					if out.ArtifactVisits >= visitLimit {
+						out.DirectionsQuotaLimited++
+						out.BudgetExhausted = out.ArtifactVisits >= maxVisits || len(out.Proposals) >= maxCandidates
+						break directionLanes
+					}
+					out.ArtifactVisits++
+					value, err := engine.domain.ArtifactStat(id, direction.Stat)
+					if err != nil {
+						return out, err
+					}
+					value *= sign
+					// Keep a low-disruption witness from ALL improving pieces in
+					// the same visit. Maximum target stat alone can erase crit or
+					// bonus utility before isolated proposals are even constructed.
+					if value > anchorValue {
+						candidate := anchor
+						candidate[actor][slot] = id
+						if engine.domain.ValidateAssignment(candidate) == nil {
+							p, e := priorityFor(candidate)
+							if e != nil {
+								return out, e
+							}
+							if !foundLocal || supportimpact.CompareProposalPriorities(p, bestLocalPriority) < 0 ||
+								supportimpact.CompareProposalPriorities(p, bestLocalPriority) == 0 && assignmentLess(candidate, bestLocal) {
+								bestLocal, bestLocalPriority, foundLocal = candidate, p, true
+							}
+						}
+					}
+					if value > bestValue || value == bestValue && (id == anchor[actor][slot] || best != anchor[actor][slot] && id < best) {
+						best, bestValue = id, value
+					}
+				}
+				trial[actor][slot] = best
+			}
+			// Isolated slots start from the anchor; a sands/goblet/circlet change
+			// must not inherit unrelated flower/feather losses. The combined lane
+			// also retains complete endpoints, and this lane orders both shapes
+			// by the same signed local observations and visible unknown losses.
+			trials := []domain.Assignment{trial}
+			if foundLocal {
+				trials = append(trials, bestLocal)
+			}
+			for slot := 0; slot < 5; slot++ {
+				partial := anchor
+				partial[actor][slot] = trial[actor][slot]
+				trials = append(trials, partial)
+			}
+			legal := trials[:0]
+			for _, candidate := range trials {
+				if seen[candidate] || engine.domain.ValidateAssignment(candidate) != nil {
+					continue
+				}
+				_, e := priorityFor(candidate)
+				if e != nil {
+					return out, e
+				}
+				legal = append(legal, candidate)
+			}
+			sort.SliceStable(legal, func(i, j int) bool {
+				return supportimpact.CompareProposalPriorities(priorities[legal[i]], priorities[legal[j]]) < 0
+			})
+			for _, partial := range legal {
+				if seen[partial] || engine.domain.ValidateAssignment(partial) != nil {
+					continue
+				}
+				value, err := engine.domain.AssignmentStat(partial, actor, direction.Stat)
+				if err != nil {
+					return out, err
+				}
+				if (value-startStat)*sign <= 0 {
+					continue
+				}
+				if len(out.Proposals) >= candidateLimit {
+					out.DirectionsQuotaLimited++
+					out.BudgetExhausted = out.ArtifactVisits >= maxVisits || len(out.Proposals) >= maxCandidates
+					break directionLanes
+				}
+				dps, err := engine.score(partial)
+				if err != nil {
+					return out, err
+				}
+				out.FormulaEvaluations++
+				seen[partial] = true
+				out.Proposals = append(out.Proposals, ResponseProposal{
+					Candidate: ScoredAssignment{Assignment: partial, DPS: dps, Source: "measured_stat_response_proposal"},
+					Owner:     direction.Owner, Stat: direction.Stat, ArtifactStatChange: value - startStat,
+					ProbeConfigSHA256: direction.ConfigSHA256,
+					Shape:             responseProposalShape(priorities[partial].ChangedSlots),
+				})
+			}
+		}
+	}
+	return out, nil
+}
+
+func responseProposalShape(changedSlots int) string {
+	if changedSlots == 1 {
+		return "isolated_slot"
+	}
+	return "complete_endpoint"
+}
+
+func responseDirectionRounds(directions []supportimpact.Direction) []supportimpact.Direction {
+	byOwner := map[string][]supportimpact.Direction{}
+	for _, d := range directions {
+		if d.Status == "positive_on_sampled_seeds" {
+			byOwner[d.Owner] = append(byOwner[d.Owner], d)
+		}
+	}
+	owners := make([]string, 0, len(byOwner))
+	for owner := range byOwner {
+		owners = append(owners, owner)
+	}
+	sort.Strings(owners)
+	for owner, rows := range byOwner {
+		sort.SliceStable(rows, func(i, j int) bool {
+			foreignI := rows[i].MinimumOtherDPSChange > 0
+			foreignJ := rows[j].MinimumOtherDPSChange > 0
+			if foreignI != foreignJ {
+				return foreignI
+			}
+			if rows[i].Stat != rows[j].Stat {
+				return rows[i].Stat < rows[j].Stat
+			}
+			return rows[i].Amount < rows[j].Amount
+		})
+		byOwner[owner] = rows
+	}
+	result := []supportimpact.Direction{}
+	for round := 0; ; round++ {
+		added := false
+		for _, owner := range owners {
+			if round < len(byOwner[owner]) {
+				result = append(result, byOwner[owner][round])
+				added = true
+			}
+		}
+		if !added {
+			return result
+		}
+	}
+}
diff --git a/internal/search/response_candidates_test.go b/internal/search/response_candidates_test.go
new file mode 100644
--- /dev/null
+++ b/internal/search/response_candidates_test.go
@@ -0,0 +1,307 @@
+package search
+
+import (
+	"context"
+	"reflect"
+	"sort"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+	"genshinteamstracker/native/gcsim_optimizer/internal/evaluator"
+	"genshinteamstracker/native/gcsim_optimizer/internal/supportimpact"
+)
+
+func TestResponseDirectionRoundsPrioritizeForeignEvidenceWithinFairOwners(t *testing.T) {
+	// The support-owner values replay retained Barbara paired directions from
+	// docs/optimizer-evidence/2026-10-12-support-impact/barbara-furina-c0-v1.
+	directions := []supportimpact.Direction{
+		{Owner: "a", Stat: "atk", Amount: 97.25, MeanDPSChange: 216.31308722805989, Status: "positive_on_sampled_seeds"},
+		{Owner: "a", Stat: "healing_bonus", Amount: 0.359, MeanDPSChange: 21.507161283283494, MeanOtherDPSChange: 16.67706827073721, MinimumOtherDPSChange: 14.615375929638049, Status: "positive_on_sampled_seeds"},
+		{Owner: "a", Stat: "hp_percent", Amount: 0.466, MeanDPSChange: 13.252782139890769, MeanOtherDPSChange: 10.97123680224945, MinimumOtherDPSChange: 5.076056571076151, Status: "positive_on_sampled_seeds"},
+		{Owner: "b", Stat: "atk", Status: "positive_on_sampled_seeds"},
+		{Owner: "b", Stat: "healing_bonus", MinimumOtherDPSChange: 1, Status: "positive_on_sampled_seeds"},
+		{Owner: "c", Stat: "atk", Status: "positive_on_sampled_seeds"},
+		{Owner: "d", Stat: "atk", Status: "positive_on_sampled_seeds"},
+		{Owner: "a", Stat: "def", MinimumOtherDPSChange: 100, Status: "inconclusive_local_response"},
+	}
+	want := []string{"a.healing_bonus", "b.healing_bonus", "c.atk", "d.atk", "a.hp_percent", "b.atk", "a.atk"}
+	check := func(rows []supportimpact.Direction) {
+		t.Helper()
+		got := make([]string, 0, len(rows))
+		for _, row := range responseDirectionRounds(rows) {
+			got = append(got, row.Owner+"."+row.Stat)
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Fatalf("foreign-first owner rounds changed: got %v, want %v", got, want)
+		}
+	}
+	check(directions)
+	for i, j := 0, len(directions)-1; i < j; i, j = i+1, j-1 {
+		directions[i], directions[j] = directions[j], directions[i]
+	}
+	check(directions)
+}
+
+func TestResponseLaneRetainsFormulaInvisibleStatForBothInventoryModes(t *testing.T) {
+	request, compact := searchFixtures(t)
+	alternative := request.Artifacts[0]
+	alternative.ArtifactID = 99001
+	alternative.Substats = []contracts.StatValue{{Key: "hp_percent", Value: "0.4"}}
+	request.Artifacts = append(request.Artifacts, alternative)
+	sha, err := contracts.CanonicalSHA256(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	compact.RequestSHA256 = sha
+	panel, err := evaluator.Compile(request, compact)
+	if err != nil {
+		t.Fatal(err)
+	}
+	indexed, err := domain.Build(request, panel.Coordinates())
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := indexed.Wearers[0].WearerKey
+	for _, inventory := range []bool{false, true} {
+		factory := New
+		if inventory {
+			factory = NewInventory
+		}
+		engine, err := factory(indexed, panel, DefaultConfig())
+		if err != nil {
+			t.Fatal(err)
+		}
+		directions := []supportimpact.Direction{{Owner: owner, Stat: "hp_percent", Amount: 0.2, Status: "positive_on_sampled_seeds", ConfigSHA256: "probe"}}
+		before := indexed.Incumbent
+		out, err := engine.ProposeResponseDirections(context.Background(), before, directions, 8, 10000)
+		if err != nil {
+			t.Fatal(err)
+		}
+		found := false
+		for _, row := range out.Proposals {
+			if err := indexed.ValidateAssignment(row.Candidate.Assignment); err != nil {
+				t.Fatal(err)
+			}
+			if row.Candidate.Assignment[0][0] == alternative.ArtifactID {
+				found = true
+			}
+			for actor := 1; actor < 4; actor++ {
+				if row.Candidate.Assignment[actor] != before[actor] {
+					t.Fatal("another wearer changed")
+				}
+			}
+			dps, err := engine.score(row.Candidate.Assignment)
+			if err != nil || row.Candidate.DPS != dps {
+				t.Fatal("probe response forged a corrected formula score")
+			}
+		}
+		if !found || !out.RequiresOrdinaryVerification || indexed.Incumbent != before {
+			t.Fatalf("support proposal lost or auto accepted: %#v", out)
+		}
+		out, err = engine.ProposeResponseDirections(context.Background(), before, directions, 1, 1)
+		if err != nil || !out.BudgetExhausted || out.ArtifactVisits != 1 || out.FormulaEvaluations != 0 {
+			t.Fatalf("budget escaped: %#v %v", out, err)
+		}
+		directions[0].Status = "inconclusive_local_response"
+		out, err = engine.ProposeResponseDirections(context.Background(), before, directions, 8, 10000)
+		if err != nil || len(out.Proposals) != 0 || out.ArtifactVisits != 0 {
+			t.Fatal("uncertain response became an improving direction")
+		}
+	}
+}
