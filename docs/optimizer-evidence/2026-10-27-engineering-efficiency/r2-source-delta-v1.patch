@@ -0,0 +1,56 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/domain"
+)
+
+func sessionDomainFixture() (contracts.OptimizerRequest, []domain.Package) {
+	req := contracts.OptimizerRequest{Wearers: []contracts.Wearer{{WearerKey: "north"}, {WearerKey: "east"}, {WearerKey: "south"}, {WearerKey: "west"}}}
+	rows := []domain.Package{{Sets: []contracts.SetRequirement{{SetUID: "a", Count: 4}}}, {}}
+	return req, rows
+}
+
+func TestTheorySessionDomainsKeepDefaultAndExplicitOrder(t *testing.T) {
+	req, packages := sessionDomainFixture()
+	domains, err := theorySessionAllowedDomains(req, packages)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, rows := range domains {
+		if !reflect.DeepEqual(rows, packages) {
+			t.Fatal("default catalog changed")
+		}
+	}
+	req.TheoryOptions = &contracts.TheorySearchOptions{AllowedPackages: map[string][][]contracts.SetRequirement{
+		"east": {{}, {{SetUID: "a", Count: 4}}}, "west": {{{SetUID: "a", Count: 4}}},
+	}}
+	domains, err = theorySessionAllowedDomains(req, packages)
+	if err != nil || domains[1][0].Key() != "none" || domains[1][1].Key() != "a:4" || len(domains[3]) != 1 || domains[3][0].Key() != "a:4" {
+		t.Fatalf("explicit package order/domain changed: %v %v", domains, err)
+	}
+	if !reflect.DeepEqual(domains[0], packages) || !reflect.DeepEqual(domains[2], packages) {
+		t.Fatal("one wearer's override changed another wearer")
+	}
+}
+
+func TestTheorySessionDomainsRejectInvalidBeforeCapture(t *testing.T) {
+	req, packages := sessionDomainFixture()
+	for name, allowed := range map[string]map[string][][]contracts.SetRequirement{
+		"duplicate": {"east": {{}, {}}},
+		"empty":     {"east": {}},
+		"owner":     {"foreign": {{}}},
+		"catalog":   {"east": {{{SetUID: "missing", Count: 4}}}},
+		"package":   {"east": {{{SetUID: "a", Count: 3}}}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			req.TheoryOptions = &contracts.TheorySearchOptions{AllowedPackages: allowed}
+			if _, err := theorySessionAllowedDomains(req, packages); err == nil {
+				t.Fatal("invalid domain accepted before engine preparation")
+			}
+		})
+	}
+}
diff --git a/cmd/gtt-optimizer/theory_session_test.go b/cmd/gtt-optimizer/theory_session_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/gtt-optimizer/theory_session_test.go
@@ -0,0 +1,188 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/searchcontrol"
+	"genshinteamstracker/native/gcsim_optimizer/internal/seteffects"
+	alloc "genshinteamstracker/native/gcsim_optimizer/internal/theoryalloc"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theorysearch"
+	"genshinteamstracker/native/gcsim_optimizer/internal/theoryverify"
+)
+
+func TestTheoryCommandRequiresDisplayedVersionAndIdentity(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "command.json")
+	current := theorysearch.Snapshot{SessionID: "one", RequestSHA256: strings.Repeat("a", 64), SnapshotVersion: 3}
+	command := theoryCommand{SchemaKind: "gtt_theory_session_command_v1", SessionID: "one", RequestSHA256: current.RequestSHA256, SnapshotVersion: 3, Sequence: 1, Action: "breadth"}
+	write := func(c theoryCommand) {
+		t.Helper()
+		data, e := json.Marshal(c)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = os.WriteFile(path, data, 0600); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if _, ready, e := readTheoryCommand(path, current, 0); e != nil || ready {
+		t.Fatal(ready, e)
+	}
+	write(command)
+	if got, ready, e := readTheoryCommand(path, current, 0); e != nil || !ready || got.Action != "breadth" {
+		t.Fatal(got, ready, e)
+	}
+	if _, ready, e := readTheoryCommand(path, current, 1); e != nil || ready {
+		t.Fatal("replayed command", ready, e)
+	}
+	for _, change := range []func(*theoryCommand){func(c *theoryCommand) { c.SessionID = "two" }, func(c *theoryCommand) { c.RequestSHA256 = strings.Repeat("b", 64) }, func(c *theoryCommand) { c.SnapshotVersion = 2 }, func(c *theoryCommand) { c.Sequence = 2 }, func(c *theoryCommand) { c.Action = "automatic" }} {
+		c := command
+		change(&c)
+		write(c)
