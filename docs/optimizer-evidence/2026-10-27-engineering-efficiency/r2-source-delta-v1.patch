+			if out.Boundary != "" || len(out.Values) != len(queries) {
+				t.Fatalf("irrelevant source heal rejected: %+v", out)
+			}
+			for i, value := range out.Values {
+				want := 0.0
+				if tc.drain && i == 0 {
+					want = .12
+				}
+				if !value.Known || math.Abs(value.Value-want) > 1e-12 {
+					t.Fatalf("source state/expiry changed: %+v want=%v", value, want)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/seteffects/rule_world_views.go b/internal/seteffects/rule_world_views.go
new file mode 100644
--- /dev/null
+++ b/internal/seteffects/rule_world_views.go
@@ -0,0 +1,49 @@
+package seteffects
+
+import (
+ "sync"
+ "genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+// Owned by one immutable neutral member. Only converted world baselines are
+// retained, never a replay VM, modifier, callback, task, health root or query
+// override. Public ad-hoc replay retains its host-local single-entry cache.
+// The containing binding already has mutable run-local preparation caches.
+type ruleWorldCache struct {
+	mu sync.Mutex
+	world *contracts.NeutralWorldLedger
+	views map[int]ruleWorldView
+	units int
+}
+
+const ruleWorldCacheEntries = 8192
+const ruleWorldCacheUnits = 262144 // bounds retained view + modifier + target slots
+
+func (c *ruleWorldCache) lookup(world *contracts.NeutralWorldLedger, index int) (ruleWorldView, bool) {
+	if c == nil || c.world != world { return ruleWorldView{}, false }
+	c.mu.Lock(); defer c.mu.Unlock()
+	v, ok := c.views[index]
+	return v, ok
+}
+
+func (c *ruleWorldCache) remember(v ruleWorldView) {
+	if c == nil || c.world != v.world || !v.valid { return }
+	c.mu.Lock(); defer c.mu.Unlock()
+	if _, ok := c.views[v.index]; ok { return }
+	units := 1 + len(v.state) + len(v.targets)
+	if len(c.views) >= ruleWorldCacheEntries || units > ruleWorldCacheUnits-c.units { return }
+	if c.views == nil { c.views = map[int]ruleWorldView{} }
+	c.views[v.index] = v
+	c.units += units
+}
+
+// This opt-in is only for a one-way capture transfer into the owning neutral
+// model. Borrowed public bindings remain uncached across replays and continue
+// to observe caller changes between calls. This does not make the binding's
+// other mutable preparation caches concurrent.
+func (b *NeutralBinding) EnableOwnedWorldViewReuse() {
+	for i := range b.members {
+		m := &b.members[i]
+		if m.worldCache == nil { m.worldCache = &ruleWorldCache{world:m.neutral.World} }
+	}
+}
