+func (ledger IREnergyLedger) validate(field string) error {
+	if len(ledger.InitialStates) < 1 || len(ledger.InitialStates) > 4 || ledger.Events == nil || ledger.UncertaintyCodes == nil {
+		return fmt.Errorf("%s must contain one to four initial states and array fields", field)
+	}
+	keys := make([]string, len(ledger.InitialStates))
+	maximums := make([]*big.Rat, len(ledger.InitialStates))
+	seenKeys := make(map[string]bool, len(ledger.InitialStates))
+	for index, state := range ledger.InitialStates {
+		row := fmt.Sprintf("%s.initial_states[%d]", field, index)
+		if state.CharacterIndex != index {
+			return fmt.Errorf("%s.character_index must match array order", row)
+		}
+		if err := validateToken(row+".character_key", state.CharacterKey); err != nil {
+			return err
+		}
+		if seenKeys[state.CharacterKey] {
+			return fmt.Errorf("%s repeats a character key", row)
+		}
+		seenKeys[state.CharacterKey] = true
+		if err := validateNonNegativeDecimal(row+".energy", state.Energy); err != nil {
+			return err
+		}
+		if err := validateNonNegativeDecimal(row+".energy_max", state.EnergyMax); err != nil {
+			return err
+		}
+		current, _ := new(big.Rat).SetString(state.Energy)
+		maximum, _ := new(big.Rat).SetString(state.EnergyMax)
+		if current.Cmp(maximum) > 0 {
+			return fmt.Errorf("%s energy bounds are invalid", row)
+		}
+		keys[index] = state.CharacterKey
+		maximums[index] = maximum
+	}
+	lastFrame := -1
+	for index, event := range ledger.Events {
+		row := fmt.Sprintf("%s.events[%d]", field, index)
+		if event.SequenceIndex != index || event.Frame < lastFrame || event.Frame < 0 ||
+			event.CharacterIndex < 0 || event.CharacterIndex >= len(keys) ||
+			event.CharacterKey != keys[event.CharacterIndex] {
+			return fmt.Errorf("%s identity or order is invalid", row)
+		}
+		if err := validateToken(row+".source", event.Source); err != nil {
+			return err
+		}
+		for name, value := range map[string]string{
+			"energy_before": event.EnergyBefore, "energy_after": event.EnergyAfter,
+			"energy_max": event.EnergyMax,
+		} {
+			if err := validateNonNegativeDecimal(row+"."+name, value); err != nil {
+				return err
+			}
+		}
+		if err := validateDecimal(row+".amount", event.Amount); err != nil {
+			return err
+		}
+		maximum, _ := new(big.Rat).SetString(event.EnergyMax)
+		before, _ := new(big.Rat).SetString(event.EnergyBefore)
+		after, _ := new(big.Rat).SetString(event.EnergyAfter)
+		if maximum.Cmp(maximums[event.CharacterIndex]) != 0 || before.Cmp(maximum) > 0 || after.Cmp(maximum) > 0 {
+			return fmt.Errorf("%s energy bounds differ from the actor capacity", row)
+		}
+		amount, _ := new(big.Rat).SetString(event.Amount)
+		switch event.Kind {
+		case "particle":
+			if amount.Sign() < 0 {
+				return fmt.Errorf("%s particle amount must not be negative", row)
+			}
+			if event.RawAtER100 == nil || event.ObservedER == nil || event.OnField == nil {
+				return fmt.Errorf("%s particle scaling fields are required", row)
+			}
+			if err := validateNonNegativeDecimal(row+".raw_at_er_100", *event.RawAtER100); err != nil {
+				return err
+			}
+			if err := validateNonNegativeDecimal(row+".observed_er", *event.ObservedER); err != nil {
+				return err
+			}
+		case "flat":
+			if event.RawAtER100 != nil || event.ObservedER != nil || event.OnField != nil {
+				return fmt.Errorf("%s flat event carries particle fields", row)
+			}
+		case "burst":
+			if event.RawAtER100 != nil || event.ObservedER != nil || event.OnField != nil {
+				return fmt.Errorf("%s burst event carries particle fields", row)
+			}
+			if amount.Sign() < 0 || (maximum.Sign() == 0 && amount.Sign() != 0) ||
+				(maximum.Sign() > 0 && amount.Sign() == 0) {
+				return fmt.Errorf("%s burst cost must match the ordinary-energy capacity", row)
+			}
+		default:
+			return fmt.Errorf("%s.kind is unsupported", row)
+		}
+		lastFrame = event.Frame
+	}
+	return validateSortedUniqueStrings(field+".uncertainty_codes", ledger.UncertaintyCodes)
+}
+
+func (node IRNode) validate(memberField string, prior map[uint32]struct{}) error {
+	field := fmt.Sprintf("%s.nodes[%d]", memberField, node.NodeID-1)
+	if node.Inputs == nil {
+		return fmt.Errorf("%s.inputs must be an array", field)
+	}
+	allowed := map[string]bool{
+		"constant": true, "artifact_stat": true, "add": true, "multiply": true,
+		"min": true, "max": true, "power": true, "opaque_frozen": true,
+		"select_lt": true,
+	}
+	if !allowed[node.Operation] {
+		return fmt.Errorf("%s.operation is unsupported", field)
+	}
+	for index, input := range node.Inputs {
+		if _, ok := prior[input.NodeID]; !ok {
+			return fmt.Errorf("%s.inputs[%d] must reference an earlier node", field, index)
+		}
+		if err := validateToken(fmt.Sprintf("%s.inputs[%d].relation", field, index), input.Relation); err != nil {
+			return err
+		}
+	}
+	switch node.Operation {
+	case "constant", "opaque_frozen":
+		if len(node.Inputs) != 0 || node.Coordinate != "" {
+			return fmt.Errorf("%s constant/opaque node has invalid inputs or coordinate", field)
+		}
+		return validateDecimal(field+".value", node.Value)
+	case "artifact_stat":
+		if len(node.Inputs) != 0 || node.Value != "" {
+			return fmt.Errorf("%s artifact_stat has invalid inputs or value", field)
+		}
+		return validateToken(field+".coordinate", node.Coordinate)
+	case "power":
+		if len(node.Inputs) != 2 || node.Value != "" || node.Coordinate != "" {
+			return fmt.Errorf("%s power must contain exactly two inputs", field)
+		}
+	case "select_lt":
+		if len(node.Inputs) != 4 || node.Value != "" || node.Coordinate != "" {
+			return fmt.Errorf("%s select_lt must contain left, right, true, false inputs", field)
+		}
+	default:
+		if len(node.Inputs) < 2 || node.Value != "" || node.Coordinate != "" {
+			return fmt.Errorf("%s aggregate operation must contain at least two inputs", field)
+		}
+		for index := 1; index < len(node.Inputs); index++ {
+			if node.Inputs[index-1].NodeID >= node.Inputs[index].NodeID {
+				return fmt.Errorf("%s commutative inputs must be sorted and unique", field)
+			}
+		}
+	}
+	return nil
+}
+
+func (progress ProgressRecord) Validate() error {
+	if err := validateHeader(progress.SchemaVersion, progress.SchemaKind, ProgressSchemaKind); err != nil {
+		return err
+	}
+	if err := validateSHA256("request_sha256", progress.RequestSHA256, false); err != nil {
+		return err
+	}
+	allowedStages := map[string]bool{
+		"preparing_sources": true, "capturing_schedule": true, "preparing_replacements": true,
+		"validating_request": true, "loading_evidence": true, "compiling_formula": true,
+		"searching": true, "validating_finalists": true, "simulating_finalists": true,
+		"finalizing": true, "completed": true, "cancelled": true, "failed": true,
+	}
+	if !allowedStages[progress.Stage] {
+		return fmt.Errorf("unsupported progress stage %q", progress.Stage)
+	}
+	if progress.Sequence < 0 || progress.CompletedWork < 0 || progress.TotalWork < 0 || progress.ElapsedMS < 0 {
+		return fmt.Errorf("progress counters must be non-negative")
+	}
+	if progress.TotalWork > 0 && progress.CompletedWork > progress.TotalWork {
+		return fmt.Errorf("completed_work exceeds total_work")
+	}
+	return validateSHA256("cache_identity_sha256", progress.CacheIdentitySHA256, true)
+}
+
+func (result OptimizerResult) Validate() error {
+	if len(result.Candidates) > MaxResultRows {
+		return fmt.Errorf("candidates exceed the 5050-row technical output limit")
+	}
+	if err := validateHeader(result.SchemaVersion, result.SchemaKind, ResultSchemaKind); err != nil {
+		return err
+	}
+	if err := validateSHA256("request_sha256", result.RequestSHA256, false); err != nil {
+		return err
+	}
+	if result.Warnings == nil {
+		return fmt.Errorf("warnings must be an array")
+	}
+	if err := validateSortedUniqueStrings("warnings", result.Warnings); err != nil {
+		return err
+	}
+	if result.Status != "success" && (result.ModelAccuracy != "" || result.SearchCoverage != "" || result.MechanicFallbackSHA256 != "") {
+		return fmt.Errorf("non-success result cannot claim model accuracy, search coverage, or mechanic fallback")
+	}
+	switch result.Status {
+	case "success":
+		return result.validateSuccess()
+	case "cancelled":
+		if len(result.Winner) != 0 || len(result.Candidates) != 0 || result.Measured != nil || result.Energy != nil || result.Error != nil || result.FormulaDPS != "" || result.FormulaResidual != "" {
+			return fmt.Errorf("cancelled result must not contain winner, measured result, error, or formula result")
+		}
+	case "failed":
+		if result.Error == nil {
+			return fmt.Errorf("failed result requires error")
+		}
+		if err := validateToken("error.code", result.Error.Code); err != nil {
+			return err
+		}
+		if result.Error.Message == "" || len(result.Winner) != 0 || len(result.Candidates) != 0 || result.Measured != nil || result.Energy != nil || result.FormulaDPS != "" || result.FormulaResidual != "" {
+			return fmt.Errorf("failed result has invalid payload")
+		}
+	default:
+		return fmt.Errorf("unsupported result status %q", result.Status)
+	}
+	return nil
+}
+
+func (result OptimizerResult) validateSuccess() error {
+	if err := validateResultArtifacts("winner", result.Winner); err != nil {
+		return err
+	}
+	if result.ModelAccuracy != "" || result.SearchCoverage != "" {
+		if result.CompactIRSHA256 != "" || result.SetContextPanelSHA256 != "" {
+			return fmt.Errorf("unavailable model cannot claim compact IR or set-context panel identity")
+		}
+		if err := validateSHA256("mechanic_fallback_sha256", result.MechanicFallbackSHA256, false); err != nil {
+			return err
+		}
+		return result.validateUnavailableModelSuccess()
+	}
+	if result.MechanicFallbackSHA256 != "" {
+		return fmt.Errorf("normal result cannot claim mechanic fallback identity")
+	}
+	if (result.CompactIRSHA256 == "") == (result.SetContextPanelSHA256 == "") {
+		return fmt.Errorf("success requires exactly one compact IR or set-context panel identity")
+	}
+	if result.CompactIRSHA256 != "" {
+		if err := validateSHA256("compact_ir_sha256", result.CompactIRSHA256, false); err != nil {
+			return err
+		}
+	}
+	if result.SetContextPanelSHA256 != "" {
+		if err := validateSHA256("set_context_panel_sha256", result.SetContextPanelSHA256, false); err != nil {
+			return err
+		}
+	}
+	rankingBasis := result.RankingBasis
+	if rankingBasis == "" {
+		rankingBasis = "gcsim"
+	}
+	if rankingBasis != "gcsim" && rankingBasis != "formula" {
+		return fmt.Errorf("ranking_basis must be gcsim or formula")
+	}
+	if len(result.Candidates) > 0 {
+		seenAssignments := make(map[[20]ArtifactAssignment]struct{}, len(result.Candidates))
+		for index, candidate := range result.Candidates {
+			field := fmt.Sprintf("candidates[%d]", index)
+			if candidate.Rank != index+1 {
+				return fmt.Errorf("%s rank must match product order", field)
+			}
+			if err := validateResultArtifacts(field+".artifacts", candidate.Artifacts); err != nil {
+				return err
+			}
+			if err := validateNonNegativeDecimal(field+".formula_dps", candidate.FormulaDPS); err != nil {
+				return err
+			}
+			if rankingBasis == "formula" {
+				if candidate.Measured != nil || candidate.FormulaResidual != "" {
+					return fmt.Errorf("%s formula-only candidate must not contain measured or residual results", field)
+				}
+			} else {
+				if err := validateDecimal(field+".formula_residual", candidate.FormulaResidual); err != nil {
+					return err
+				}
+				if err := validateMeasuredResult(field+".measured", candidate.Measured); err != nil {
+					return err
+				}
+			}
+			var identity [20]ArtifactAssignment
+			copy(identity[:], candidate.Artifacts)
+			if _, exists := seenAssignments[identity]; exists {
+				return fmt.Errorf("candidates must not repeat artifact assignments")
+			}
+			seenAssignments[identity] = struct{}{}
+		}
+		if err := validateCandidateOrdering(result.Candidates, rankingBasis); err != nil {
+			return err
+		}
+		first := result.Candidates[0]
+		if !sameArtifactAssignments(first.Artifacts, result.Winner) ||
+			first.FormulaDPS != result.FormulaDPS ||
+			first.FormulaResidual != result.FormulaResidual {
+			return fmt.Errorf("first ranked candidate must be the product winner")
+		}
+		if rankingBasis == "gcsim" && (first.Measured == nil || result.Measured == nil || *first.Measured != *result.Measured) {
+			return fmt.Errorf("first ranked candidate must contain the product winner measurement")
+		}
+	}
+	if err := validateNonNegativeDecimal("formula_dps", result.FormulaDPS); err != nil {
+		return err
+	}
+	if rankingBasis == "formula" {
+		if result.Measured != nil || result.FormulaResidual != "" {
+			return fmt.Errorf("formula-only result must not contain measured or residual results")
+		}
+		if !containsResultWarning(result.Warnings, "formula_only_unverified") {
+			return fmt.Errorf("formula-only result requires formula_only_unverified warning")
+		}
+		if result.Energy != nil {
+			if err := result.Energy.validate("energy"); err != nil {
+				return err
+			}
+		}
+	} else {
+		if err := validateDecimal("formula_residual", result.FormulaResidual); err != nil {
+			return err
+		}
+		if err := validateMeasuredResult("measured", result.Measured); err != nil {
+			return err
+		}
+		if result.Energy != nil {
+			if err := result.Energy.validate("energy"); err != nil {
+				return err
+			}
+		}
+	}
+	if result.DebugReceiptPath == "" || result.Error != nil {
+		return fmt.Errorf("successful result requires debug receipt and no error")
+	}
+	return nil
+}
+
+func (result OptimizerResult) validateUnavailableModelSuccess() error {
+	if result.ModelAccuracy != "unavailable" || result.SearchCoverage != "incomplete_model" {
+		return fmt.Errorf("model_accuracy and search_coverage require unavailable/incomplete_model together")
+	}
+	if result.RankingBasis != "gcsim" && result.RankingBasis != "unavailable" {
+		return fmt.Errorf("unavailable model requires explicit gcsim or unavailable ranking_basis")
+	}
+	if len(result.Candidates) != 1 {
+		return fmt.Errorf("unavailable model requires exactly one legal candidate")
+	}
+	candidate := result.Candidates[0]
+	if candidate.Rank != 1 {
+		return fmt.Errorf("unavailable model candidate rank must be one")
+	}
+	if err := validateResultArtifacts("candidates[0].artifacts", candidate.Artifacts); err != nil {
+		return err
+	}
+	if !sameArtifactAssignments(candidate.Artifacts, result.Winner) {
+		return fmt.Errorf("unavailable model candidate must match winner")
+	}
+	if result.FormulaDPS != "" || result.FormulaResidual != "" || candidate.FormulaDPS != "" || candidate.FormulaResidual != "" {
+		return fmt.Errorf("unavailable model cannot claim formula DPS or residual")
+	}
+	if candidate.SetGroupKey == "" {
+		if candidate.SetGroupRank != 0 || candidate.AlternativeRank != 0 {
+			return fmt.Errorf("unavailable model candidate has incomplete set-group metadata")
+		}
+	} else {
+		if err := validateToken("candidates[0].set_group_key", candidate.SetGroupKey); err != nil {
+			return err
+		}
+		if candidate.SetGroupRank != 1 || candidate.AlternativeRank != 1 {
+			return fmt.Errorf("unavailable model candidate set-group ranks must be one")
+		}
+	}
+	for _, code := range []string{"mechanic_model_unavailable", "mechanic_search_incomplete"} {
+		if !containsResultWarning(result.Warnings, code) {
+			return fmt.Errorf("unavailable model requires %s warning", code)
+		}
+	}
+	if result.RankingBasis == "gcsim" {
+		if err := validateMeasuredResult("measured", result.Measured); err != nil {
+			return err
+		}
+		if result.Measured.Iterations != 500 || candidate.Measured == nil || *candidate.Measured != *result.Measured {
+			return fmt.Errorf("unavailable model measured anchor requires matching n=500 candidate")
+		}
+		if containsResultWarning(result.Warnings, "mechanic_measured_anchor_unavailable") {
+			return fmt.Errorf("measured anchor cannot claim unavailable measurement")
+		}
+	} else {
+		if result.Measured != nil || candidate.Measured != nil {
+			return fmt.Errorf("unavailable ranking basis cannot contain a measurement")
+		}
+		if !containsResultWarning(result.Warnings, "mechanic_measured_anchor_unavailable") {
+			return fmt.Errorf("unavailable ranking basis requires mechanic_measured_anchor_unavailable warning")
+		}
+	}
+	if result.Energy != nil {
+		if err := result.Energy.validate("energy"); err != nil {
+			return err
+		}
+	}
+	if result.DebugReceiptPath == "" || result.Error != nil {
+		return fmt.Errorf("successful result requires debug receipt and no error")
+	}
+	return nil
+}
+
+func validateMeasuredResult(field string, measured *MeasuredResult) error {
+	if measured == nil || measured.Iterations <= 0 {
+		return fmt.Errorf("%s requires measured iterations", field)
+	}
+	if err := validateNonNegativeDecimal(field+".dps", measured.DPS); err != nil {
+		return err
+	}
+	if err := validateNonNegativeDecimal(field+".standard_error", measured.StandardError); err != nil {
+		return err
+	}
+	return validateSHA256(field+".engine_result_sha256", measured.EngineResultSHA256, false)
+}
+
+func containsResultWarning(warnings []string, wanted string) bool {
+	index := sort.SearchStrings(warnings, wanted)
+	return index < len(warnings) && warnings[index] == wanted
+}
+
+func validateCandidateOrdering(candidates []RankedCandidateResult, rankingBasis string) error {
+	grouped := false
+	for _, candidate := range candidates {
+		if candidate.SetGroupKey != "" || candidate.SetGroupRank != 0 || candidate.AlternativeRank != 0 {
+			grouped = true
+			break
+		}
+	}
+	if !grouped {
+		for index := 1; index < len(candidates); index++ {
+			previous, _ := candidateRankingScore(candidates[index-1], rankingBasis)
+			current, _ := candidateRankingScore(candidates[index], rankingBasis)
+			if previous.Cmp(current) < 0 {
+				return fmt.Errorf("candidates must be globally sorted by descending %s DPS", rankingBasis)
+			}
+		}
+		return nil
+	}
+
+	seenGroups := make(map[string]bool)
+	groupRank := 0
+	groupKey := ""
+	groupAlternativeRank := 0
+	var previousGroupScore *big.Rat
+	previousGroupKey := ""
+	var previousAlternativeScore *big.Rat
+	var previousAlternative []ArtifactAssignment
+	for index, candidate := range candidates {
+		field := fmt.Sprintf("candidates[%d]", index)
+		if candidate.SetGroupKey == "" || candidate.SetGroupRank <= 0 || candidate.AlternativeRank <= 0 {
+			return fmt.Errorf("%s has incomplete set-group metadata", field)
+		}
+		if candidate.SetGroupRank > MaxResultGroups || candidate.AlternativeRank > MaxResultBuildsPerGroup {
+			return fmt.Errorf("%s set-group/alternative ranks exceed technical limits %d/%d", field, MaxResultGroups, MaxResultBuildsPerGroup)
+		}
+		score, _ := candidateRankingScore(candidate, rankingBasis)
+		if index == 0 || candidate.SetGroupKey != groupKey {
+			if seenGroups[candidate.SetGroupKey] {
+				return fmt.Errorf("candidate set groups must be contiguous")
+			}
+			if candidate.SetGroupRank != groupRank+1 || candidate.AlternativeRank != 1 {
+				return fmt.Errorf("%s set-group and alternative ranks must be contiguous", field)
+			}
+			if previousGroupScore != nil {
+				if previousGroupScore.Cmp(score) < 0 || (previousGroupScore.Cmp(score) == 0 && previousGroupKey >= candidate.SetGroupKey) {
+					return fmt.Errorf("set groups must be sorted by descending %s DPS and canonical key", rankingBasis)
+				}
+			}
+			seenGroups[candidate.SetGroupKey] = true
+			groupRank = candidate.SetGroupRank
+			groupKey = candidate.SetGroupKey
+			groupAlternativeRank = 1
+			previousGroupScore = score
+			previousGroupKey = candidate.SetGroupKey
+			previousAlternativeScore = score
+			previousAlternative = candidate.Artifacts
+			continue
+		}
+		if candidate.SetGroupRank != groupRank || candidate.AlternativeRank != groupAlternativeRank+1 {
+			return fmt.Errorf("%s set-group and alternative ranks must be contiguous", field)
+		}
+		if previousAlternativeScore.Cmp(score) < 0 ||
+			(previousAlternativeScore.Cmp(score) == 0 && compareResultAssignments(previousAlternative, candidate.Artifacts) > 0) {
+			return fmt.Errorf("set-group alternatives must be sorted by descending %s DPS and artifact IDs", rankingBasis)
+		}
+		groupAlternativeRank = candidate.AlternativeRank
+		previousAlternativeScore = score
+		previousAlternative = candidate.Artifacts
+	}
+	return nil
+}
+
+func candidateRankingScore(candidate RankedCandidateResult, rankingBasis string) (*big.Rat, error) {
+	text := candidate.FormulaDPS
+	if rankingBasis == "gcsim" {
+		if candidate.Measured == nil {
+			return nil, fmt.Errorf("candidate is missing measured ranking score")
+		}
+		text = candidate.Measured.DPS
+	}
+	score, ok := new(big.Rat).SetString(text)
+	if !ok {
+		return nil, fmt.Errorf("candidate ranking score is not a finite decimal")
+	}
+	return score, nil
+}
+
+func compareResultAssignments(left, right []ArtifactAssignment) int {
+	for index := range left {
+		if left[index].ArtifactID < right[index].ArtifactID {
+			return -1
+		}
+		if left[index].ArtifactID > right[index].ArtifactID {
+			return 1
+		}
+	}
+	return 0
+}
+
+func (result EnergyResult) validate(field string) error {
+	if err := validateNonNegativeDecimal(field+".maximum_shortage", result.MaximumShortage); err != nil {
+		return err
+	}
+	if len(result.Wearers) != 4 {
+		return fmt.Errorf("%s must contain four wearers", field)
+	}
+	seen := map[string]bool{}
+	for index, wearer := range result.Wearers {
+		row := fmt.Sprintf("%s.wearers[%d]", field, index)
+		if err := validateToken(row+".wearer_key", wearer.WearerKey); err != nil {
+			return err
+		}
+		if seen[wearer.WearerKey] {
+			return fmt.Errorf("%s repeats wearer", row)
+		}
+		seen[wearer.WearerKey] = true
+		for name, value := range map[string]string{
+			"artifact_er": wearer.ArtifactER, "required_artifact_er": wearer.RequiredArtifactER,
+			"maximum_shortage": wearer.MaximumShortage,
+		} {
+			if err := validateNonNegativeDecimal(row+"."+name, value); err != nil {
+				return err
+			}
+		}
+		if err := validateDecimal(row+".artifact_er_margin", wearer.Margin); err != nil {
+			return err
+		}
+		if wearer.BurstDeadlines < 0 || wearer.Sources == nil || wearer.UncertaintyCodes == nil {
+			return fmt.Errorf("%s has invalid energy detail arrays or counters", row)
+		}
+		if err := validateSortedUniqueStrings(row+".uncertainty_codes", wearer.UncertaintyCodes); err != nil {
+			return err
+		}
+		for sourceIndex, source := range wearer.Sources {
+			sourceField := fmt.Sprintf("%s.sources[%d]", row, sourceIndex)
+			if err := validateToken(sourceField+".source", source.Source); err != nil {
+				return err
+			}
+			if err := validateNonNegativeDecimal(sourceField+".particle_raw_at_er_100", source.ParticleRaw); err != nil {
+				return err
+			}
+			if err := validateDecimal(sourceField+".flat_observed", source.FlatObserved); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func validateResultArtifacts(field string, assignments []ArtifactAssignment) error {
+	if len(assignments) != 20 {
+		return fmt.Errorf("%s must contain twenty assignments", field)
+	}
+	used := make(map[int64]struct{}, 20)
+	perWearer := make(map[string]int)
+	for index, assignment := range assignments {
+		if err := validateToken(fmt.Sprintf("%s[%d].wearer_key", field, index), assignment.WearerKey); err != nil {
+			return err
+		}
+		if !validSlot(assignment.Slot) || assignment.ArtifactID <= 0 {
+			return fmt.Errorf("%s[%d] has invalid slot or artifact_id", field, index)
+		}
+		if index > 0 && compareAssignments(assignments[index-1], assignment) >= 0 {
+			return fmt.Errorf("%s must be strictly sorted by wearer and canonical slot", field)
+		}
+		if _, exists := used[assignment.ArtifactID]; exists {
+			return fmt.Errorf("%s repeats artifact_id %d", field, assignment.ArtifactID)
+		}
+		used[assignment.ArtifactID] = struct{}{}
+		perWearer[assignment.WearerKey]++
+	}
+	if len(perWearer) != 4 {
+		return fmt.Errorf("%s must contain four wearers", field)
+	}
+	for wearer, count := range perWearer {
+		if count != 5 {
+			return fmt.Errorf("%s wearer %s must contain five artifacts", field, wearer)
+		}
+	}
+	return nil
+}
+
+func sameArtifactAssignments(left, right []ArtifactAssignment) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if left[index] != right[index] {
+			return false
+		}
+	}
+	return true
+}
+
+func SortedAssignments(assignments []ArtifactAssignment) bool {
+	return sort.SliceIsSorted(assignments, func(left, right int) bool {
+		return compareAssignments(assignments[left], assignments[right]) < 0
+	})
+}
