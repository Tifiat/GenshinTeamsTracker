+func responseCheckEvidence(request contracts.OptimizerRequest, anchor string, plan engineclient.StatResponsePlan) engineclient.StatResponseResult {
+	requestSHA, _ := contracts.CanonicalSHA256(request)
+	result := engineclient.StatResponseResult{
+		Binding: engineclient.StatResponseBinding{
+			AnchorConfigSHA256: contracts.TextSHA256(anchor), RequestSHA256: requestSHA,
+			EngineArtifactSHA256: request.Engine.ArtifactSHA256, EngineBindingSHA256: request.Engine.BindingSHA256,
+			EngineSourceManifestSHA256: request.Engine.SourceManifestSHA256, EnginePatchManifestSHA256: request.Engine.PatchManifestSHA256,
+		},
+		PreparedConfigSHA256: contracts.TextSHA256(anchor), ProbeConfigSHA256: contracts.TextSHA256("probe config"),
+		CallLimit: plan.CallLimit, AttemptedCalls: plan.CallLimit, EngineUnchanged: true, ProposalEvidenceOnly: true,
+		ScreeningEnabled: plan.ScreenZeroFirstSeed,
+		Baseline:         []engineclient.StatResponseSample{}, Perturbations: []engineclient.StatResponsePerturbationResult{},
+	}
+	for _, seed := range plan.Seeds {
+		result.Baseline = append(result.Baseline, engineclient.StatResponseSample{
+			Seed: seed, SampleSeed: strconv.FormatInt(seed, 10), Iterations: 1, DPS: 100,
+			ConfigSHA256: result.ProbeConfigSHA256, EngineResultSHA256: stringsRepeat("a", 64),
+			CharacterDPS: map[string]float64{"actor_a": 40, "actor_b": 30, "actor_c": 20, "actor_d": 10},
+		})
+	}
+	for index, perturbation := range plan.Perturbations {
+		row := engineclient.StatResponsePerturbationResult{Perturbation: perturbation, ConfigSHA256: contracts.TextSHA256("perturbed config " + strconv.Itoa(index)), Samples: []engineclient.StatResponseSample{}}
+		for _, seed := range plan.Seeds {
+			characters := map[string]float64{"actor_a": 40, "actor_b": 30, "actor_c": 20, "actor_d": 10}
+			characters[perturbation.Actor] += float64(index + 1)
+			row.Samples = append(row.Samples, engineclient.StatResponseSample{
+				Seed: seed, SampleSeed: strconv.FormatInt(seed, 10), Iterations: 1, DPS: 100 + float64(index+1),
+				ConfigSHA256: row.ConfigSHA256, EngineResultSHA256: stringsRepeat("b", 64), CharacterDPS: characters,
+			})
+		}
+		result.Perturbations = append(result.Perturbations, row)
+	}
+	return result
+}
+
+func stringsRepeat(value string, count int) string {
+	return strings.Repeat(value, count)
+}
