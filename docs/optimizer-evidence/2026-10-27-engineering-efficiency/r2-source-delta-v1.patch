+++ b/internal/seteffects/rule_boundary_test.go
@@ -0,0 +1,184 @@
+package seteffects
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+)
+
+func TestMechanicFailureRetainsCategoryAcrossNestedSourceCalls(t *testing.T) {
+	h := &ruleReplayHost{choice: RuleChoice{Owner: 2}, frame: 120, order: 27}
+	_, inner := ruleTry(func() any {
+		h.scheduleBoundary("test_operation", "presentation without a routing keyword", 2, true)
+		return nil
+	})
+	_, outer := ruleTry(func() any { ruleRethrow(inner); return nil })
+	b := h.observedFailure(outer)
+	if b.Kind != contracts.MechanicScheduleChange || b.Operation != "test_operation" || !b.OwnerKnown || b.Owner != 2 || b.Frame != 120 || b.Order != 27 {
+		t.Fatalf("nested failure lost its bound operation: %+v", b)
+	}
+	if b.ReasonCode != contracts.MechanicReasonDynamicSchedule {
+		t.Fatalf("nested failure lost diagnostic category: %+v", b)
+	}
+	// A diagnostic that quotes an operation category cannot acquire semantics.
+	b = h.observedFailure(errors.New("example schedule_change: text only"))
+	if b.Kind == contracts.MechanicScheduleChange {
+		t.Fatal("text was promoted to a timing effect")
+	}
+	if b.ReasonCode != contracts.MechanicReasonUnclassifiedUnsupported {
+		t.Fatalf("arbitrary text became a technical cause: %+v", b)
+	}
+	if b.OwnerKnown || !b.CallerKnown || b.CallerOwner != 2 {
+		t.Fatal("callback ownership became a certificate of affected resource ownership")
+	}
+}
+
+func TestUnknownHostOperationAndAnalysisBudgetRemainDistinct(t *testing.T) {
+	vm := newRuleVM(nil, nil, 10)
+	_, err := ruleTry(func() any {
+		return vm.invoke(ruleNative{receiver: ruleRef{kind: "char", index: 3}, name: "NewEngineOperation"}, nil)
+	})
+	h := &ruleReplayHost{choice: RuleChoice{Owner: 1}, frame: 45, order: 9}
+	b := h.observedFailure(err)
+	if b.Kind != contracts.MechanicUnknownOperation || b.Operation != "NewEngineOperation" || b.Receiver != "char" || b.Owner != 3 || !b.OwnerKnown || b.Frame != 45 {
+		t.Fatalf("unknown host operation lost provenance: %+v", b)
+	}
+	if b.ReasonCode != contracts.MechanicReasonUnknownOperation {
+		t.Fatalf("unknown host operation lost diagnostic cause: %+v", b)
+	}
+	if !b.CallerKnown || b.CallerOwner != 1 {
+		t.Fatalf("cross-owner receiver overwrote the source caller: %+v", b)
+	}
+	vm.remaining = 0
+	_, err = ruleTry(func() any { vm.tick(); return nil })
+	if b = h.observedFailure(err); b.Kind != contracts.MechanicAnalysisBudget {
+		t.Fatalf("budget became a permanent unsupported operation: %+v", b)
+	}
+	if b.ReasonCode != contracts.MechanicReasonAnalysisBudget {
+		t.Fatalf("budget lost diagnostic cause: %+v", b)
+	}
+}
+
+func TestModifierFailureRetainsOriginBeforeAmbientContextRestoration(t *testing.T) {
+	v := testRule(t, `func Start(c any) any { return func() float64 { return c.FutureCounter() } }`, nil)
+	previous := newRuleVM(nil, nil, 10)
+	h := &ruleReplayHost{vm: previous, choice: RuleChoice{Owner: 2, Key: "unrelated_last_constructor"},
+		frame: 120, order: 27, stateComplete: true, context: ruleTestNeutral().Context}
+	v.host = h
+	fn, err := v.entry("Start", ruleRef{kind: "char", index: 3})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.mods = []replayMod{{kind: "heal_bonus", owner: 3, target: -1, expiry: -1,
+		vm: v, choice: RuleChoice{Owner: 1, Key: "actual_modifier"},
+		object: &ruleObject{fields: map[string]any{"Amount": fn}}}}
+	_, err = ruleTry(func() any { return h.query(RuleQuery{Kind: "heal_bonus", Owner: 3}) })
+	if err == nil {
+		t.Fatal("unknown operation was silently evaluated")
+	}
+	b := h.observedFailure(err)
+	if b.MechanicUID != "actual_modifier" || !b.CallerKnown || b.CallerOwner != 1 ||
+		b.Operation != "FutureCounter" || !b.OwnerKnown || b.Owner != 3 || b.Frame != 120 || b.Order != 27 {
+		t.Fatalf("modifier origin was replaced by ambient context: %+v", b)
+	}
+	if h.vm != previous || h.choice.Key != "unrelated_last_constructor" {
+		t.Fatal("query context did not restore")
+	}
+	h.frame, h.order = 999, 999
+	_, wrapped := ruleTry(func() any { ruleRethrow(err); return nil })
+	if got := h.observedFailure(wrapped); got.MechanicUID != b.MechanicUID || got.CallerOwner != b.CallerOwner || got.Frame != b.Frame || got.Order != b.Order {
+		t.Fatalf("rethrown origin changed: %+v", got)
+	}
+}
+
+func TestEventFailurePreservesTypedNestedBoundary(t *testing.T) {
+	v := testRule(t, `func Start(c any) any { return func() { c.FutureCounter() } }`, nil)
+	h := &ruleReplayHost{frame: 120, order: 27, context: ruleTestNeutral().Context}
+	v.host = h
+	fn, err := v.entry("Start", ruleRef{kind: "char", index: 3})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.subs = map[int][]ruleSubscription{1: {{vm: v, fn: fn, choice: RuleChoice{Owner: 1, Key: "actual_callback"}}}}
+	err = h.emit(contracts.CombatEvent{Event: 1})
+	if err == nil {
+		t.Fatal("unknown callback operation was silently evaluated")
+	}
+	b := h.observedFailure(err)
+	if b.Kind != contracts.MechanicUnknownOperation || b.MechanicUID != "actual_callback" ||
+		b.Operation != "FutureCounter" || !b.OwnerKnown || b.Owner != 3 || !b.CallerKnown || b.CallerOwner != 1 {
+		t.Fatalf("event wrapper flattened the typed origin: %+v", b)
+	}
+}
+
+func TestDiagnosticReasonCodeRecognizesOnlyFixedCompilerPrefixes(t *testing.T) {
+	cases := []struct {
+		reason string
+		want   contracts.MechanicReasonCode
+	}{
+		{"shared package global requires engine-owned observation: pkg.Symbol", contracts.MechanicReasonSharedGlobalState},
+		{"stat-dependent branch changes nonnumeric source behavior", contracts.MechanicReasonSymbolicControlFlow},
+		{"source condition is not known", contracts.MechanicReasonSymbolicControlFlow},
+		{"source number is not known", contracts.MechanicReasonUnsupportedArithmetic},
+		{"rule type assertion failed", contracts.MechanicReasonUnsupportedType},
+		{"source dependency module absent: pkg", contracts.MechanicReasonDependencyLink},
+		{"source map iteration is unproven", contracts.MechanicReasonMapIteration},
+		{"source call depth exhausted", contracts.MechanicReasonAnalysisBudget},
+		{"private profile shared package global requires engine-owned observation: pkg.Symbol", contracts.MechanicReasonUnclassifiedUnsupported},
+	}
+	for _, tc := range cases {
+		if got := diagnosticReasonCode(contracts.MechanicUnsupportedSource, tc.reason); got != tc.want {
+			t.Errorf("reason %q: got %s, want %s", tc.reason, got, tc.want)
+		}
+	}
+}
+
+func TestDiagnosticConsumerSiteUsesOnlyStaticBasenameAndLine(t *testing.T) {
+	_, err := ruleTry(func() any { ruleFail("private value without a known compiler prefix"); return nil })
+	var boundary ruleBoundaryError
+	if !errors.As(err, &boundary) {
+		t.Fatal(err)
+	}
+	site := boundary.boundary.ConsumerSite
+	if site == "" || !contracts.ValidMechanicConsumerSite(site) || strings.ContainsAny(site, "/\\") {
+		t.Fatalf("invalid evaluator static site: %q", site)
+	}
+	if boundary.boundary.ReasonCode != contracts.MechanicReasonUnclassifiedUnsupported {
+		t.Fatal(boundary.boundary)
+	}
+	if code := diagnosticReasonCode(contracts.MechanicUnknownOperation, "shared package global requires engine-owned observation: pkg.Symbol"); code != contracts.MechanicReasonSharedGlobalState {
+		t.Fatal(code)
+	}
+}
+
+func TestMechanicReportAggregatesTechnicalCauseWithoutRawReason(t *testing.T) {
+	t.Setenv("GTT_FROZEN_MECHANICS_DIR", "")
+	c := &SourceCatalog{mechanicSources: map[string]mechanicDiagnosticSource{
+		"set_example": {file: "internal/example/set.go", closure: strings.Repeat("a", 64)},
+	}}
+	boundaries := []contracts.BoundMechanicBoundary{
+		{Boundary: contracts.MechanicBoundary{MechanicUID: "set_example", Kind: contracts.MechanicUnsupportedSource,
+			ReasonCode: contracts.MechanicReasonSharedGlobalState, Reason: "private profile text", Operation: "pkg.global_read"}},
+		{Boundary: contracts.MechanicBoundary{MechanicUID: "set_example", Kind: contracts.MechanicUnsupportedSource,
+			ReasonCode: contracts.MechanicReasonSharedGlobalState, Reason: "different private text", Operation: "pkg.global_read"}},
+		{Boundary: contracts.MechanicBoundary{MechanicUID: "set_example", Kind: contracts.MechanicUnsupportedSource,
+			Reason: "private profile text", Operation: "pkg.global_read"}},
+	}
+	report := c.MechanicReport(boundaries)
+	groupReport := report["reason_codes"].(map[string]any)
+	groups := groupReport["groups"].([]map[string]any)
+	if len(groups) != 2 || groups[0]["count"] != 2 || groups[0]["reason_code"] != string(contracts.MechanicReasonSharedGlobalState) ||
+		groups[1]["reason_code"] != string(contracts.MechanicReasonUnclassifiedUnsupported) {
+		t.Fatalf("unexpected cause groups: %+v", groups)
+	}
+	data, err := json.Marshal(report)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(data), "private profile text") || strings.Contains(string(data), "different private text") {
+		t.Fatalf("raw reason leaked into report: %s", data)
+	}
+}
