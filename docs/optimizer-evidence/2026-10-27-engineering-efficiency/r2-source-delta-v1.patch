+	// A screened row has only its actual first-seed sample. Its means summarize
+	// that observation; no second-seed response or global zero is inferred.
+	SecondSeedScreened bool `json:"second_seed_screened,omitempty"`
+}
+
+// StatResponseResult is immutable evidence from one predeclared, bounded proposal
+// probe. RunDirectory is isolated under the caller-owned managed root; the
