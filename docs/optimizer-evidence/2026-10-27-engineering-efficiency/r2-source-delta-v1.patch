--- /dev/null
+++ b/internal/contracts/model_unavailable_result_test.go
@@ -0,0 +1,122 @@
+package contracts
+
+import (
+	"sort"
+	"strings"
+	"testing"
+)
+
+func unavailableModelResult(t *testing.T, measured bool) OptimizerResult {
+	t.Helper()
+	result, err := DecodeResult(readFixture(t, "result_v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	result.ModelAccuracy = "unavailable"
+	result.SearchCoverage = "incomplete_model"
+	result.CompactIRSHA256 = ""
+	result.SetContextPanelSHA256 = ""
+	fallback := map[string]any{
+		"schema_version": 1,
+		"policy":         "legal_anchor",
+		"winner":         result.Winner,
+		"measured":       measured,
+	}
+	result.MechanicFallbackSHA256, err = CanonicalSHA256(fallback)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result.FormulaDPS = ""
+	result.FormulaResidual = ""
+	result.Warnings = append(result.Warnings, "mechanic_model_unavailable", "mechanic_search_incomplete")
+	candidate := RankedCandidateResult{Rank: 1, Artifacts: append([]ArtifactAssignment(nil), result.Winner...)}
+	if measured {
+		result.RankingBasis = "gcsim"
+		result.Measured.Iterations = 500
+		candidate.Measured = result.Measured
+	} else {
+		result.RankingBasis = "unavailable"
+		result.Measured = nil
+		result.Warnings = append(result.Warnings, "mechanic_measured_anchor_unavailable")
+	}
+	result.Candidates = []RankedCandidateResult{candidate}
+	sort.Strings(result.Warnings)
+	return result
+}
+
+func TestUnavailableModelResultContract(t *testing.T) {
+	for _, measured := range []bool{true, false} {
+		result := unavailableModelResult(t, measured)
+		if err := result.Validate(); err != nil {
+			t.Fatalf("valid unavailable model measured=%t: %v", measured, err)
+		}
+		encoded, err := CanonicalJSON(result)
+		if err != nil {
+			t.Fatal(err)
+		}
+		decoded, err := DecodeResult(encoded)
+		if err != nil || decoded.ModelAccuracy != "unavailable" || decoded.SearchCoverage != "incomplete_model" || decoded.MechanicFallbackSHA256 != result.MechanicFallbackSHA256 {
+			t.Fatalf("unavailable status did not round-trip: %+v, %v", decoded, err)
+		}
+	}
+
+	legacy, err := DecodeResult(readFixture(t, "result_v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := CanonicalJSON(legacy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(encoded), "model_accuracy") || strings.Contains(string(encoded), "search_coverage") || strings.Contains(string(encoded), "mechanic_fallback_sha256") {
+		t.Fatal("old result unexpectedly gained optional status fields")
+	}
+	legacy.MechanicFallbackSHA256 = strings.Repeat("a", 64)
+	if err := legacy.Validate(); err == nil {
+		t.Fatal("normal result accepted mechanic fallback identity")
+	}
+	legacy.MechanicFallbackSHA256 = ""
+	legacy.FormulaDPS = ""
+	if err := legacy.Validate(); err == nil {
+		t.Fatal("normal result still requires formula DPS")
+	}
+}
+
+func TestUnavailableModelRejectsAmbiguousOrNumericClaims(t *testing.T) {
+	tests := map[string]func(*OptimizerResult){
+		"missing coverage":   func(r *OptimizerResult) { r.SearchCoverage = "" },
+		"missing fallback":   func(r *OptimizerResult) { r.MechanicFallbackSHA256 = "" },
+		"invalid fallback":   func(r *OptimizerResult) { r.MechanicFallbackSHA256 = "A" + r.MechanicFallbackSHA256[1:] },
+		"mixed compact":      func(r *OptimizerResult) { r.CompactIRSHA256 = strings.Repeat("a", 64) },
+		"mixed set panel":    func(r *OptimizerResult) { r.SetContextPanelSHA256 = strings.Repeat("b", 64) },
+		"wrong accuracy":     func(r *OptimizerResult) { r.ModelAccuracy = "approximate" },
+		"wrong basis":        func(r *OptimizerResult) { r.RankingBasis = "formula" },
+		"numeric formula":    func(r *OptimizerResult) { r.FormulaDPS = "0" },
+		"candidate formula":  func(r *OptimizerResult) { r.Candidates[0].FormulaDPS = "0" },
+		"wrong sample count": func(r *OptimizerResult) { r.Measured.Iterations = 1 },
+		"missing candidate":  func(r *OptimizerResult) { r.Candidates = nil },
+		"different winner":   func(r *OptimizerResult) { r.Candidates[0].Artifacts[0].ArtifactID++ },
+		"missing warning": func(r *OptimizerResult) {
+			for i, warning := range r.Warnings {
+				if warning == "mechanic_search_incomplete" {
+					r.Warnings = append(r.Warnings[:i], r.Warnings[i+1:]...)
+					break
+				}
+			}
+		},
+	}
+	for name, mutate := range tests {
+		t.Run(name, func(t *testing.T) {
+			result := unavailableModelResult(t, true)
+			mutate(&result)
+			if err := result.Validate(); err == nil {
+				t.Fatal("invalid unavailable model result passed")
+			}
+		})
+	}
+	noMeasurement := unavailableModelResult(t, false)
+	noMeasurement.Candidates[0].Measured = &MeasuredResult{Iterations: 500}
+	if err := noMeasurement.Validate(); err == nil {
+		t.Fatal("unavailable score accepted measurement")
+	}
+}
