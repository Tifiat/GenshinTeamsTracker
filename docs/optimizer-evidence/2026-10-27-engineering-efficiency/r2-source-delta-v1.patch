+// Reuse completed calls, not sampled convergence claims. Every non-allowance
+// input and the original logical expansion charge are retained; a hit changes
+// no search limit, queue decision or coverage label. Reports retain no programs.
+const neutralCandidateMemoEntries = 4096
+const neutralCandidateMemoFinalists = 32768
+
+type neutralCandidateKey struct {
+	inventory            *domain.Index
+	contextSHA, graphSHA string
+	packages             [4]string
+	assignment           domain.Assignment
+	config               search.Config
+	route                setcontext.Route
+	actor, allowance     int
+	refine               bool
+	allowanceIndependent bool // Internal tag; never part of a requested key.
+}
+
+type neutralCandidateMemo struct {
+	entries             map[neutralCandidateKey]search.CandidateReport
+	order               []neutralCandidateKey
+	maxEntries, maxRows int
+	rows                int
+}
+
+func newNeutralCandidateMemo(maxEntries, maxRows int) *neutralCandidateMemo {
+	return &neutralCandidateMemo{entries: map[neutralCandidateKey]search.CandidateReport{}, maxEntries: maxEntries, maxRows: maxRows}
+}
+
+func neutralCandidateSearchKey(inventory *domain.Index, c Candidate, config search.Config, actor, allowance int, refine bool) neutralCandidateKey {
+	key := neutralCandidateKey{inventory: inventory, contextSHA: c.Context.Key(), graphSHA: c.Handle.GraphSHA256(),
+		assignment: c.Score.Assignment, config: config, route: c.Handle.Route(), actor: actor, allowance: allowance, refine: refine}
+	for i, pack := range c.Packages {
+		key.packages[i] = pack.Key()
+	}
+	return key
+}
+
+func cloneNeutralCandidateReport(report search.CandidateReport) search.CandidateReport {
+	report.Step.Finalists = append([]search.ScoredAssignment(nil), report.Step.Finalists...)
+	return report
+}
+
+func (key neutralCandidateKey) completedAllowanceKey() neutralCandidateKey {
+	key.allowance = 0
+	key.allowanceIndependent = true
+	return key
+}
+
+func (key neutralCandidateKey) admitsCompletedAllowance(expanded int) bool {
+	// Strict inequality proves that neither point nor loop budget checks cut
+	// off work. Refine also branches on raw pool size <= min(4096, allowance),
+	// so both its original and requesting allowances must preserve that branch.
+	// Stop/Exhaustive alone cannot prove this: stability can follow a cutoff,
+	// and invalid assignments make Expanded smaller than the raw pool size.
+	return expanded >= 0 && expanded < key.allowance && (!key.refine || key.allowance >= 4096)
+}
+
+func (memo *neutralCandidateMemo) run(ctx context.Context, key neutralCandidateKey, work func() (search.CandidateReport, error)) (search.CandidateReport, bool, error) {
+	if err := ctx.Err(); err != nil {
+		return search.CandidateReport{}, false, err
+	}
+	if prior, ok := memo.entries[key]; ok {
+		return cloneNeutralCandidateReport(prior), true, nil
+	}
+	completedKey := key.completedAllowanceKey()
+	if prior, ok := memo.entries[completedKey]; ok && key.admitsCompletedAllowance(prior.Step.Expanded) {
+		return cloneNeutralCandidateReport(prior), true, nil
+	}
+	report, err := work()
+	if err != nil || ctx.Err() != nil || memo.maxEntries <= 0 || len(report.Step.Finalists) > memo.maxRows {
+		return report, false, err
+	}
+	if key.admitsCompletedAllowance(report.Step.Expanded) {
+		// Store one report under a tagged key, not one alias per allowance.
+		// It owns exactly the same entry/finalist budget and FIFO lifetime.
+		if _, known := memo.entries[completedKey]; !known {
+			key = completedKey
+		}
+	}
+	for len(memo.entries) >= memo.maxEntries || memo.rows+len(report.Step.Finalists) > memo.maxRows {
+		old := memo.order[0]
+		memo.order[0] = neutralCandidateKey{}
+		memo.order = memo.order[1:]
+		memo.rows -= len(memo.entries[old].Step.Finalists)
+		delete(memo.entries, old)
+	}
+	memo.entries[key] = cloneNeutralCandidateReport(report)
+	memo.order = append(memo.order, key)
+	memo.rows += len(report.Step.Finalists)
+	return report, false, nil
+}
+
+// Only successful candidate-search reports may populate this run-local memo.
+// Their first row was already checked and rescored by candidateRun.finish using
+// the complete team panel, including cross-owner support dependencies. Never
+// populate it from Candidate.Score, queue priorities or caller-supplied DPS.
+const neutralBoundScoreMemoEntries = 4096
+
+type neutralBoundScoreKey struct {
+	inventory            *domain.Index
+	contextSHA, graphSHA string
+	assignment           domain.Assignment
+	route                setcontext.Route
+}
+
+type neutralBoundScoreMemo struct {
+	entries           map[neutralBoundScoreKey]float64
+	order             []neutralBoundScoreKey
+	next, maxEntries  int
+	hits, evaluations int
+}
+
+func newNeutralBoundScoreMemo(maxEntries int) *neutralBoundScoreMemo {
+	return &neutralBoundScoreMemo{entries: map[neutralBoundScoreKey]float64{}, maxEntries: maxEntries}
+}
+
+func neutralBoundScoreIdentity(inventory *domain.Index, target *setcontext.Context, handle *setcontext.Handle, assignment domain.Assignment) neutralBoundScoreKey {
+	return neutralBoundScoreKey{inventory: inventory, contextSHA: target.Key(), graphSHA: handle.GraphSHA256(),
+		assignment: assignment, route: handle.Route()}
+}
+
+func (memo *neutralBoundScoreMemo) rememberCheckedReport(ctx context.Context, inventory *domain.Index, c Candidate, report search.CandidateReport) error {
+	if ctx.Err() != nil || memo.maxEntries <= 0 || len(report.Step.Finalists) == 0 {
+		return nil
+	}
+	if c.Context == nil || c.Handle == nil {
+		return fmt.Errorf("missing checked neutral score context")
+	}
+	if _, err := c.Handle.SearchPanel(); err != nil {
+		return err
+	}
+	if c.Handle.ContextKey() != c.Context.Key() {
+		return fmt.Errorf("checked neutral score context mismatch")
+	}
+	row := report.Step.Finalists[0]
+	if math.IsNaN(row.DPS) || math.IsInf(row.DPS, 0) {
+		return fmt.Errorf("nonfinite checked neutral score")
+	}
+	key := neutralBoundScoreIdentity(inventory, c.Context, c.Handle, row.Assignment)
+	if prior, known := memo.entries[key]; known {
+		if math.Float64bits(prior) != math.Float64bits(row.DPS) {
+			return fmt.Errorf("checked neutral score changed for identical binding")
+		}
+		return nil
+	}
+	if len(memo.order) == memo.maxEntries {
+		delete(memo.entries, memo.order[memo.next])
+		memo.order[memo.next] = key
+		memo.next = (memo.next + 1) % memo.maxEntries
+	} else {
+		memo.order = append(memo.order, key)
+	}
+	memo.entries[key] = row.DPS
+	return nil
+}
+
+// Context resolution remains with the coordinator. Every bind still constructs
+// and physically validates its package view/dense inputs before a score lookup;
+// a hit replaces only a duplicate full-panel EvaluateDPS call.
+func (memo *neutralBoundScoreMemo) bind(ctx context.Context, inventory *domain.Index, target *setcontext.Context, handle *setcontext.Handle, packs [4]domain.Package, seed domain.Assignment, lane string) (Candidate, error) {
+	if err := ctx.Err(); err != nil {
+		return Candidate{}, err
+	}
+	panel, err := handle.SearchPanel()
+	if err != nil {
+		return Candidate{}, err
+	}
+	if target == nil || handle.ContextKey() != target.Key() {
+		return Candidate{}, fmt.Errorf("neutral bound score context mismatch")
+	}
+	view, err := inventory.ForPackages(packs, seed, panel.Coordinates())
+	if err != nil {
+		return Candidate{}, err
+	}
+	dense, err := view.DenseDeltas(seed)
+	if err != nil {
+		return Candidate{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return Candidate{}, err
+	}
+	key := neutralBoundScoreIdentity(inventory, target, handle, seed)
+	dps, reused := memo.entries[key]
+	if !reused {
+		memo.evaluations++
+		dps, err = panel.EvaluateDPS(dense)
+		if err != nil {
+			return Candidate{}, err
+		}
+	}
+	if math.IsNaN(dps) || math.IsInf(dps, 0) {
+		return Candidate{}, fmt.Errorf("nonfinite neutral bound score")
+	}
+	if reused {
+		memo.hits++
+	}
+	return Candidate{Score: search.ScoredAssignment{Assignment: seed, DPS: dps, Source: lane},
+		Context: target, Handle: handle, Index: view, Packages: packs, ModelUncertain:len(panel.OpaqueReasons())>0}, nil
 }
 
