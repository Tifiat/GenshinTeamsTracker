+// This transformation uses only absolute saved ordinary values. In particular
+// it does not reuse the scheduler's predicate or cached DPSDelta summaries.
+func replayScreenedControl(t *testing.T, original engineclient.StatResponseResult) engineclient.StatResponseResult {
+	t.Helper()
+	raw, err := json.Marshal(original)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out engineclient.StatResponseResult
+	if err := json.Unmarshal(raw, &out); err != nil {
+		t.Fatal(err)
+	}
+	out.ScreeningEnabled = true
+	out.AttemptedCalls = len(out.Baseline)
+	baselines := map[int64]engineclient.StatResponseSample{}
+	for _, base := range out.Baseline {
+		baselines[base.Seed] = base
+	}
+	for i := range out.Perturbations {
+		row := &out.Perturbations[i]
+		if len(row.Samples) != 2 {
+			t.Fatal("original retained panel must contain a complete pair")
+		}
+		first, base := row.Samples[0], baselines[row.Samples[0].Seed]
+		zero := first.DPS == base.DPS
+		for actor, dps := range base.CharacterDPS {
+			zero = zero && first.CharacterDPS[actor] == dps
+		}
+		if zero {
+			// The omitted historical value is known here; assert that this replay
+			// preserves the measured zero means, without pretending it was rerun.
+			second := row.Samples[1]
+			secondBase := baselines[second.Seed]
+			if second.DPS != secondBase.DPS || !reflect.DeepEqual(second.CharacterDPS, secondBase.CharacterDPS) {
+				t.Fatal("this fixture cannot claim unchanged means for a second-seed-only response")
+			}
+			row.Samples = row.Samples[:1]
+			row.SecondSeedScreened = true
+			out.SkippedCalls++
+		}
+		out.AttemptedCalls += len(row.Samples)
+	}
+	return out
+}
