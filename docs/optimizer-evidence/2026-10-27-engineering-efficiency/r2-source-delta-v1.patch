+package allsets
+
+import (
+	"testing"
+
+	energyconstraint "genshinteamstracker/native/gcsim_optimizer/internal/energy"
+)
+
+func TestUncertainRegionSurvivesExistingGroupAndFinalistQuotas(t *testing.T) {
+	index, base, _, _, _ := coordinatorFixture(t)
+	leader := archiveCandidate(index, base, archiveFourPiece("known_a"), index.Incumbent, 300)
+	second := archiveCandidate(index, base, archiveFourPiece("known_b"), archiveAssignmentWithCopy(index, 0), 200)
+	uncertain := archiveCandidate(index, base, archiveFourPiece("unknown_c"), archiveAssignmentWithCopy(index, 1), 5)
+	uncertain.ModelUncertain = true // structured panel coverage, not score text
+	pool := []Candidate{leader, second, uncertain}
+
+	finalists, omitted := chooseFinalistsWithCoverage(pool, 2)
+	if len(finalists) != 2 || finalists[0].Score.Assignment != leader.Score.Assignment ||
+		finalists[1].Score.Assignment != uncertain.Score.Assignment || !finalists[1].ModelUncertain || omitted != 0 {
+		t.Fatalf("finalist quota starved uncertain group: %+v omitted=%d", finalists, omitted)
+	}
+
+	archive := newResultArchive(1)
+	for _, c := range pool {
+		archive.offer(c)
+	}
+	shown, omitted := archive.topWithCoverage(2)
+	if len(shown) != 2 || shown[0].Score.Assignment != leader.Score.Assignment ||
+		shown[1].Score.Assignment != uncertain.Score.Assignment || !shown[1].ModelUncertain || omitted != 0 {
+		t.Fatalf("group quota starved uncertain group: %+v omitted=%d", shown, omitted)
+	}
+	if shown[1].Handle != nil || shown[1].Index != nil {
+		t.Fatal("archive retained heavyweight bound state")
+	}
+	bound := archiveCandidate(index, base, uncertain.Packages, uncertain.Score.Assignment, uncertain.Score.DPS)
+	bound = retainArchivedUncertainty(bound, shown[1])
+	if !bound.ModelUncertain || bound.Index == nil {
+		t.Fatal("cache hydration lost archived uncertainty")
+	}
+}
+
+func TestUncertainAlternativeUsesOnlyExistingPerGroupSlot(t *testing.T) {
+	index, base, _, _, _ := coordinatorFixture(t)
+	packs := archiveFourPiece("same_group")
+	leader := archiveCandidate(index, base, packs, index.Incumbent, 100)
+	strongerKnown := archiveCandidate(index, base, packs, archiveAssignmentWithCopy(index, 0), 90)
+	uncertain := archiveCandidate(index, base, packs, archiveAssignmentWithCopy(index, 1), 1)
+	uncertain.ModelUncertain = true
+	archive := newResultArchive(2)
+	archive.offer(leader)
+	archive.offer(strongerKnown)
+	archive.offer(uncertain)
+	rows := archive.groups[packageIdentity(packs)]
+	if len(rows) != 2 || rows[0].Score.Assignment != leader.Score.Assignment ||
+		rows[1].Score.Assignment != uncertain.Score.Assignment || !rows[1].ModelUncertain {
+		t.Fatalf("per-group uncertainty retention: %+v", rows)
+	}
+	if _, omitted := archive.topWithCoverage(1); omitted != 0 {
+		t.Fatalf("retained uncertain alternative reported omitted: %d", omitted)
+	}
+}
+
+func TestOneSlotReportsOmittedUncertainGroup(t *testing.T) {
+	index, base, _, _, _ := coordinatorFixture(t)
+	leader := archiveCandidate(index, base, archiveFourPiece("known"), index.Incumbent, 100)
+	uncertain := archiveCandidate(index, base, archiveFourPiece("unknown"), archiveAssignmentWithCopy(index, 0), 1)
+	uncertain.ModelUncertain = true
+	selected, omitted := chooseFinalistsWithCoverage([]Candidate{leader, uncertain}, 1)
+	if len(selected) != 1 || selected[0].Score.Assignment != leader.Score.Assignment || omitted != 1 {
+		t.Fatalf("one finalist slot hid uncertainty: %+v omitted=%d", selected, omitted)
+	}
+	archive := newResultArchive(1)
+	archive.offer(leader)
+	archive.offer(uncertain)
+	shown, omitted := archive.topWithCoverage(1)
+	if len(shown) != 1 || shown[0].Score.Assignment != leader.Score.Assignment || omitted != 1 {
+		t.Fatalf("one group slot hid uncertainty: %+v omitted=%d", shown, omitted)
+	}
+}
+
+func TestKnownOnlyOrderingAndEnergyGateStayUnchanged(t *testing.T) {
+	index, base, _, _, _ := coordinatorFixture(t)
+	leader := archiveCandidate(index, base, archiveFourPiece("known_a"), index.Incumbent, 100)
+	second := archiveCandidate(index, base, archiveFourPiece("known_b"), archiveAssignmentWithCopy(index, 0), 90)
+	third := archiveCandidate(index, base, archiveFourPiece("known_c"), archiveAssignmentWithCopy(index, 1), 80)
+	selected, omitted := chooseFinalistsWithCoverage([]Candidate{third, leader, second}, 2)
+	if len(selected) != 2 || selected[0].Score.Assignment != leader.Score.Assignment ||
+		selected[1].Score.Assignment != second.Score.Assignment || omitted != 0 {
+		t.Fatalf("known-only finalist behavior changed: %+v omitted=%d", selected, omitted)
+	}
+	archive := newResultArchive(1)
+	for _, c := range []Candidate{third, leader, second} {
+		archive.offer(c)
+	}
+	shown, omitted := archive.topWithCoverage(2)
+	if len(shown) != 2 || shown[0].Score.Assignment != leader.Score.Assignment ||
+		shown[1].Score.Assignment != second.Score.Assignment || omitted != 0 {
+		t.Fatalf("known-only archive behavior changed: %+v omitted=%d", shown, omitted)
+	}
+	leader.Energy = &energyconstraint.Feasibility{Feasible: true}
+	uncertainInfeasible := third
+	uncertainInfeasible.ModelUncertain = true
+	uncertainInfeasible.Energy = &energyconstraint.Feasibility{Feasible: false}
+	selected, omitted = chooseFinalistsWithCoverage([]Candidate{leader, uncertainInfeasible}, 2)
+	if len(selected) != 1 || selected[0].Score.Assignment != leader.Score.Assignment || omitted != 0 {
+		t.Fatalf("infeasible uncertainty bypassed energy gate: %+v omitted=%d", selected, omitted)
+	}
+}
