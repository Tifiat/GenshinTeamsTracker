+}
+
+func representativeProjectionPackages(group string) [4]domain.Package {
+	var packs [4]domain.Package
+	for actor := range packs {
+		packs[actor] = domain.Package{Sets: []contracts.SetRequirement{{SetUID: group, Count: 4}}}
+	}
+	return packs
+}
+
+// Zero-value Context/Handle/Model pointers and one-slot assignments are storage tokens only;
+// these fixtures make no claim about legal assignments or captured engine contexts.
+func representativeProjectionCandidate(group string, id int64, dps float64, source string, energy *energyconstraint.Feasibility) Candidate {
+	var assignment domain.Assignment
+	assignment[0][0] = id
+	return Candidate{
+		Score:       search.ScoredAssignment{Assignment: assignment, DPS: dps, Source: source},
+		Context:     &setcontext.Context{},
+		Handle:      &setcontext.Handle{},
+		Index:       &domain.Index{},
+		Packages:    representativeProjectionPackages(group),
+		Energy:      energy,
+		EnergyModel: &energyconstraint.Model{},
+	}
+}
+
+func assertRepresentativeCandidatesEqual(t *testing.T, got, want []Candidate, label string) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("%s: got %d candidates, want %d", label, len(got), len(want))
+	}
+	for i := range got {
+		left, right := got[i], want[i]
+		if left.Score.Assignment != right.Score.Assignment ||
+			left.Score.Source != right.Score.Source ||
+			math.Float64bits(left.Score.DPS) != math.Float64bits(right.Score.DPS) {
+			t.Fatalf("%s candidate %d score differs: got=%+v want=%+v", label, i, left.Score, right.Score)
+		}
+		if left.Context != right.Context || left.Handle != right.Handle || left.Index != right.Index {
+			t.Fatalf("%s candidate %d context/handle/index identity differs", label, i)
+		}
+		if left.Handle != nil || left.Index != nil {
+			t.Fatalf("%s candidate %d retained handle/index instead of stripped archive values", label, i)
+		}
+		if left.Energy != right.Energy || !reflect.DeepEqual(left.Energy, right.Energy) ||
+			left.EnergyModel != right.EnergyModel || !reflect.DeepEqual(left.EnergyModel, right.EnergyModel) {
+			t.Fatalf("%s candidate %d energy/model identity or contents differ", label, i)
+		}
+		if !reflect.DeepEqual(left.Packages, right.Packages) {
+			t.Fatalf("%s candidate %d package identity differs: got=%+v want=%+v", label, i, left.Packages, right.Packages)
+		}
+		if left.Energy != nil && math.Float64bits(left.Energy.MaximumShortage) != math.Float64bits(right.Energy.MaximumShortage) {
+			t.Fatalf("%s candidate %d energy shortage bits differ", label, i)
+		}
+	}
+}
+
+var representativeProjectionBenchmarkSink []Candidate
+
+func BenchmarkResultArchiveRepresentativeProjection(b *testing.B) {
+	events, groupKeys := representativeProjectionBenchmarkEvents()
+	for _, alternatives := range []int{1, 2, 7, 50, 101} {
+		alternatives := alternatives
+		b.Run(fmt.Sprintf("legacy_dual/K_%d", alternatives), func(b *testing.B) {
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				display := newResultArchive(alternatives)
+				core := newResultArchive(1)
+				for i, candidate := range events {
+					key := groupKeys[i]
+					display.offerGroup(key, candidate)
+					core.offerGroup(key, candidate)
+				}
+				representativeProjectionBenchmarkSink = chooseFinalists(core.top(7), 7)
+			}
+		})
+		b.Run(fmt.Sprintf("single_archive/K_%d", alternatives), func(b *testing.B) {
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				display := newResultArchive(alternatives)
+				for i, candidate := range events {
+					display.offerGroup(groupKeys[i], candidate)
+				}
+				representativeProjectionBenchmarkSink = neutralStabilizationFinalists(display, 7)
+			}
+		})
+	}
+}
+
+func representativeProjectionBenchmarkEvents() ([]Candidate, []string) {
+	const eventCount, groupCount = 4096, 32
+	var packages [groupCount][4]domain.Package
+	for group := range packages {
+		packages[group] = representativeProjectionPackages(fmt.Sprintf("benchmark-%02d", group))
+	}
+	ctx := &setcontext.Context{}
+	events := make([]Candidate, eventCount)
+	groupKeys := make([]string, eventCount)
+	for i := range events {
+		group := i % groupCount
+		groupKeys[i] = packageIdentity(packages[group])
+		var assignment domain.Assignment
+		assignment[0][0] = int64(i + 1)
+		events[i] = Candidate{
+			Score:    search.ScoredAssignment{Assignment: assignment, DPS: float64((i*7919)%eventCount), Source: "benchmark"},
+			Context:  ctx,
+			Packages: packages[group],
+		}
+	}
+	return events, groupKeys
+}
