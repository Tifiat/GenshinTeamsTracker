+		}
+		return solver.RefineCandidates(context.Background(), c.Score.Assignment, 0, allowance)
+	}
+	memo := newNeutralCandidateMemo(4, 100)
+	key := neutralCandidateSearchKey(index, c, cfg, 0, 8192, true)
+	full, _, err := memo.run(context.Background(), key, func() (search.CandidateReport, error) { return solve(key.allowance) })
+	if err != nil {
