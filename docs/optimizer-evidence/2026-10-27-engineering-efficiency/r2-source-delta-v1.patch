+package seteffects
+
+import (
+	"os"
+	"regexp"
+	"sort"
+	"strings"
+
+	"genshinteamstracker/native/gcsim_optimizer/internal/contracts"
+	"genshinteamstracker/native/gcsim_optimizer/internal/mechanicdiagnostics"
+)
+
+type mechanicDiagnosticSource struct{ file, closure string }
+
+var staticDiagnosticID = regexp.MustCompile(`^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$`)
+
+func (c *SourceCatalog) rememberMechanicSource(key string, sources map[string][]byte, repository *ruleRepository) {
+	names := make([]string, 0, len(sources))
+	hashes := map[string]string{}
+	for name, body := range sources {
+		names = append(names, name)
+		hashes[name] = contracts.TextSHA256(string(body))
+	}
+	sort.Strings(names)
+	if len(names) == 0 {
+		return
+	}
+	closure, _ := contracts.CanonicalSHA256(hashes)
+	if repository != nil {
+		closure = repository.sourceFingerprint
+	}
+	if c.mechanicSources == nil {
+		c.mechanicSources = map[string]mechanicDiagnosticSource{}
+	}
+	c.mechanicSources[key] = mechanicDiagnosticSource{names[0], closure}
+}
+
+type reasonGroupKey struct{ uid, code, operation, site string }
+
+func staticOperation(value string) string {
+	if n := strings.LastIndex(value, "."); n >= 0 {
+		value = value[n+1:]
+	}
+	if staticDiagnosticID.MatchString(value) {
+		return value
+	}
+	return ""
+}
+
+// MechanicReport keeps source coverage separate from bound failures. ReasonCode
+// is diagnostic only; raw Reason never enters a frozen record or this report.
+func (c *SourceCatalog) MechanicReport(boundaries []contracts.BoundMechanicBoundary) map[string]any {
+	if c == nil {
+		return map[string]any{"available": false}
+	}
+	coverage := []map[string]any{}
+	for _, row := range c.Sets {
+		item := map[string]any{"mechanic": "set." + row.Key, "parse": "not_prepared", "link": "not_prepared", "semantics": "unknown", "runtime": "unverified"}
+		if row.MechanicIR != nil {
+			item["parse"] = row.MechanicIR.Coverage.Parse
+			item["link"] = row.MechanicIR.Coverage.Link
+			item["semantics"] = row.MechanicIR.Coverage.Semantics
+			item["runtime"] = row.MechanicIR.Coverage.Runtime
+			item["origin"] = row.MechanicIROrigin
+			item["unresolved_count"] = len(row.MechanicIR.Unresolved)
+		} else if row.RuleUnresolved != "" {
+			item["semantics"] = "unavailable"
+		}
+		coverage = append(coverage, item)
+	}
+	report := map[string]any{
+		"cache_enabled": os.Getenv("GTT_MECHANIC_CACHE_ENABLED") != "0",
+		"ir_cache":      c.CurrentMechanicIRCacheStats(), "ast_cache": c.CurrentParseCacheStats(),
+		"static_coverage": coverage, "bound_boundary_count": len(boundaries),
+	}
+
+	groups := map[reasonGroupKey]int{}
+	unmatched := 0
+	for _, bound := range boundaries {
+		b := bound.Boundary
+		if _, ok := c.mechanicSources[b.MechanicUID]; !ok || !staticDiagnosticID.MatchString(b.MechanicUID) {
+			unmatched++
+			continue
+		}
+		code := b.ReasonCode
+		if !contracts.ValidMechanicReasonCode(code) {
+			code = diagnosticReasonCode(b.Kind, b.Reason)
+		}
+		site := b.ConsumerSite
+		if !contracts.ValidMechanicConsumerSite(site) {
+			site = ""
+		}
+		groups[reasonGroupKey{b.MechanicUID, string(code), staticOperation(b.Operation), site}]++
+	}
+	keys := make([]reasonGroupKey, 0, len(groups))
+	for key := range groups {
+		keys = append(keys, key)
+	}
+	sort.Slice(keys, func(i, j int) bool {
+		if groups[keys[i]] != groups[keys[j]] {
+			return groups[keys[i]] > groups[keys[j]]
+		}
+		if keys[i].uid != keys[j].uid {
+			return keys[i].uid < keys[j].uid
+		}
+		if keys[i].code != keys[j].code {
+			return keys[i].code < keys[j].code
+		}
+		if keys[i].operation != keys[j].operation {
+			return keys[i].operation < keys[j].operation
+		}
+		return keys[i].site < keys[j].site
+	})
+	const maxGroups = 64
+	rows := make([]map[string]any, 0, min(len(keys), maxGroups))
+	overflow := 0
+	for i, key := range keys {
+		if i >= maxGroups {
+			overflow += groups[key]
+			continue
+		}
+		rows = append(rows, map[string]any{"mechanic_uid": key.uid, "reason_code": key.code, "operation": key.operation, "consumer_site": key.site, "count": groups[key]})
+	}
+	report["reason_codes"] = map[string]any{"groups": rows, "unique_groups_overflow": max(0, len(keys)-maxGroups),
+		"observations_overflow": overflow, "unmatched_static_identity": unmatched}
+
+	root := os.Getenv("GTT_FROZEN_MECHANICS_DIR")
+	if root == "" {
+		report["diagnostics_status"] = "not_configured"
+		return report
+	}
+	store, err := mechanicdiagnostics.Open(root)
+	if err != nil {
+		report["diagnostics_status"] = "unavailable"
+		return report
+	}
+	for _, bound := range boundaries {
+		b := bound.Boundary
+		if b.Kind == contracts.MechanicInvalidOperation || !staticDiagnosticID.MatchString(b.MechanicUID) {
+			continue
+		}
+		source, ok := c.mechanicSources[b.MechanicUID]
+		if !ok {
+			continue
+		}
+		code := b.ReasonCode
+		if !contracts.ValidMechanicReasonCode(code) {
+			code = diagnosticReasonCode(b.Kind, b.Reason)
+		}
+		_ = store.Record(mechanicdiagnostics.Observation{
+			EngineID: c.EngineSHA256, CompilerID: mechanicIRCompiler, MechanicID: "set." + b.MechanicUID,
+			ClosureSHA256: source.closure,
+			Source:        mechanicdiagnostics.SourceFrame{Path: source.file, Symbol: "source_file"},
+			Kind:          string(b.Kind), Operation: staticOperation(b.Operation), ReasonCode: code,
+			ConsumerSite: b.ConsumerSite,
+			Fallback:     "frozen", Influence: "unknown",
+		})
+	}
+	report["frozen_store"] = store.Stats()
+	report["unmatched_static_identity"] = unmatched
+	return report
+}
