+pairLoop:
+	for a := 0; a < 5; a++ {
+		for b := a + 1; b < 5; b++ {
+			orientations := FinalPairCompletionOrientations(free[a], pools[a], free[b], pools[b])
+			for _, side := range orientations {
+				if err := ctx.Err(); err != nil {
+					stats.Stop = "cancelled_during_fringe"
+					return engine.finishFinalPairFringe(r, stats, best, false, err)
+				}
+				poolA, poolB := side.Left, side.Right
+				stats.CandidatePairs += int64(len(poolA)) * int64(len(poolB))
+				var gatePools [5][]int64
+				gatePools[a], gatePools[b] = poolA, poolB
+				gateStarted := time.Now()
+				stats.GatePlans++
+				gate, gateErr := r.prepareNeighborhood(base, gatePools)
+				stats.GateSeconds += time.Since(gateStarted).Seconds()
+				if gateErr != nil {
+					stats.Stop = "gate_cancelled"
+					return engine.finishFinalPairFringe(r, stats, best, false, gateErr)
+				}
+				var gateA [][]int64
+				if gate != nil {
+					gateA = gate.Pairs[a][b]
+					stats.GateValidationChecks += int64(gate.ValidationChecks)
+					stats.GatePoolMetadataChecks += int64(gate.PoolMetadataChecks)
+				} else {
+					stats.GateFallbacks++
+				}
+				for positionA, idA := range poolA {
+					var allowedB []int64
+					if gate == nil {
+						allowedB = poolB
+					} else if positionA < len(gateA) {
+						allowedB = gateA[positionA]
+					}
+					for _, idB := range allowedB {
+						stats.GateAllowedPairs++
+						if idA == base[a] || idB == base[b] {
+							stats.BaseIDSkips++
+							continue
+						}
+						trial := base
+						trial[a], trial[b] = idA, idB
+						if r.seen[trial] {
+							stats.DuplicateSkips++
+							continue
+						}
+						if gate != nil {
+							leftValid := positionA < len(gate.Single[a]) && gate.Single[a][positionA]
+							rightValid := false
+							for positionB, candidate := range poolB {
+								if candidate == idB && positionB < len(gate.Single[b]) {
+									rightValid = gate.Single[b][positionB]
+									break
+								}
+							}
+							if !leftValid || !rightValid {
+								stats.PartnerRepairWitnesses++
+								if !leftValid && rightValid {
+									stats.LeftPartnerRepairWitnesses++
+								} else if leftValid && !rightValid {
+									stats.RightPartnerRepairWitnesses++
+								}
+							}
+						}
+						if r.report.Step.Expanded >= allowance {
+							stats.Stop = "allowance_exhausted"
+							complete = false
+							break pairLoop
+						}
+						before := r.report.Step.Expanded
+						pointStarted := time.Now()
+						stats.PointCalls++
+						err = r.point(trial, false, true)
+						stats.PairPointSeconds += time.Since(pointStarted).Seconds()
+						stats.PairPointExpanded += r.report.Step.Expanded - before
+						if err != nil {
+							stats.Stop = "pair_point_error"
+							return engine.finishFinalPairFringe(r, stats, best, false, err)
+						}
+					}
+					if !complete {
+						break pairLoop
+					}
+				}
+				if !complete {
+					break pairLoop
+				}
+			}
+			if !complete {
+				break pairLoop
+			}
+		}
+	}
+	if complete {
+		if err := ctx.Err(); err != nil {
+			stats.Stop = "cancelled_after_fringe"
+			return engine.finishFinalPairFringe(r, stats, best, false, err)
+		}
+	}
+	stats.Expanded = r.report.Step.Expanded
+	stats.InvalidAssignments = r.report.Step.InvalidAssignments
+	stats.CoverageComplete = complete
+	if complete {
+		stats.Stop = "pair_fringe_complete"
+	}
+	return engine.finishFinalPairFringe(r, stats, best, false, nil)
+}
+
+func (engine *Engine) finishFinalPairFringe(r *candidateRun, stats FinalPairCompletionActor, best ScoredAssignment, haveBest bool, workErr error) (FinalPairCompletionActor, ScoredAssignment, bool, error) {
+	if r == nil {
+		stats.Stop = "candidate_run_unavailable"
+		return stats, best, haveBest, workErr
+	}
+	stats.FinishCalls++
+	finishStarted := time.Now()
+	report, finishErr := r.finish(workErr)
+	stats.FinishSeconds += time.Since(finishStarted).Seconds()
+	stats.Expanded = report.Step.Expanded
+	stats.InvalidAssignments = report.Step.InvalidAssignments
+	stats.ReturnedFinalistRows = len(report.Step.Finalists)
+	if len(report.Step.Finalists) > 0 {
+		for _, row := range report.Step.Finalists {
+			if !haveBest || engine.betterScored(row, best) {
+				best, haveBest = row, true
+			}
+		}
+	}
+	if finishErr != nil {
+		stats.CoverageComplete = false
+		if stats.Stop == "running" || stats.Stop == "pair_fringe_complete" {
+			stats.Stop = "finish_error"
+		}
+		return stats, best, haveBest, finishErr
+	}
+	return stats, best, haveBest, nil
+}
