--- /dev/null
+++ b/internal/seteffects/rule_shared_state.go
@@ -0,0 +1,96 @@
+package seteffects
+
+import (
+	"go/ast"
+	"go/token"
+)
+
+// Initializers are not silently executed in wearer-local VMs. Only proven
+// local validation and the existing source-entry registration seam are inert
+// for mechanic replay. Other initialization requires authoritative engine state.
+func ruleInitializerInert(fn *ruleFunction) bool {
+	locals := map[string]bool{"_":true}
+	for _,stmt := range fn.body.List {
+		inert := true
+		ast.Inspect(stmt,func(n ast.Node)bool {
+			switch n := n.(type) {
+			case *ast.FuncLit,*ast.BlockStmt,*ast.GoStmt,*ast.DeferStmt,*ast.SendStmt: inert=false
+			case *ast.CallExpr:
+				id,ok := n.Fun.(*ast.Ident); if !ok { inert=false; break }
+				_,global := fn.env.module.globals[id.Name]
+				if locals[id.Name] || global || fn.env.module.functions[id.Name] != nil { inert=false; break }
+				switch id.Name { case "int","int32","int64","uint32","uint64","float64","float32","string","bool","len": default: inert=false }
+			}
+			return inert
+		})
+		if !inert { return false }
+		switch stmt := stmt.(type) {
+		case *ast.DeclStmt:
+			decl,ok:=stmt.Decl.(*ast.GenDecl); if !ok { return false }
+			for _,spec:=range decl.Specs { if value,ok:=spec.(*ast.ValueSpec);ok { for _,id:=range value.Names { locals[id.Name]=true } } }
+		case *ast.AssignStmt:
+			for _,lhs:=range stmt.Lhs { id,ok:=lhs.(*ast.Ident);if !ok || stmt.Tok!=token.DEFINE && !locals[id.Name] { return false } }
+			if stmt.Tok==token.DEFINE { for _,lhs:=range stmt.Lhs { locals[lhs.(*ast.Ident).Name]=true } }
+		case *ast.IncDecStmt:
+			id,ok:=stmt.X.(*ast.Ident);if !ok || !locals[id.Name] { return false }
+		case *ast.ReturnStmt:
+		default:return false
+		}
+	}
+	return true
+}
+
+func ruleEntryRegistrationOnly(fn *ruleFunction) bool {
+	if len(fn.body.List) == 0 { return true }
+	for _,stmt := range fn.body.List {
+		expr,ok := stmt.(*ast.ExprStmt); if !ok { return false }
+		call,ok := expr.X.(*ast.CallExpr); if !ok || len(call.Args) != 2 { return false }
+		selector,ok := call.Fun.(*ast.SelectorExpr); if !ok || selector.Sel.Name != "RegisterSetFunc" { return false }
+		pkg,ok := selector.X.(*ast.Ident); if !ok || fn.env.imports[pkg.Name] != gcsimImport+"pkg/core" { return false }
+		entry,ok := call.Args[1].(*ast.Ident); if !ok || entry.Name != "NewSet" { return false }
+	}
+	return true
+}
+
+func (v *ruleVM) requireObservedInitialization(m *ruleModule) {
+	if m==nil { ruleFail("source module identity is unavailable") }
+	if len(m.blankImports)>0 { ruleFail("blank import requires engine-owned initialization: "+m.name) }
+	if m.initializationUnsafe { ruleFail("package initialization requires engine-owned state: "+m.name) }
+}
+
+func (v *ruleVM) shared(value any) bool {
+	switch value.(type) {
+	case *ruleSlice,*ruleMap,*ruleObject,*ruleFunction,*ruleCell:
+		return v.sharedValues[value]
+	case rulePointer: return v.shared(value.(rulePointer).object)
+	}
+	return false
+}
+
+// Tag all aliases before publishing a cached global value. Copies of scalar or
+// struct values remain local, but containers, pointers and closure environments
+// cannot become an invented private copy of shared engine package state.
+func (v *ruleVM) retainGlobal(value any) {
+	if v.sharedValues == nil { v.sharedValues=map[any]bool{}; v.sharedScopes=map[*ruleEnv]bool{} }
+	work:=[]any{value}
+	for len(work)>0 {
+		x:=work[len(work)-1]; work=work[:len(work)-1]
+		if v.shared(x) { continue }
+		switch x:=x.(type) {
+		case *ruleSlice:
+			v.sharedValues[x]=true; work=append(work,x.values...)
+		case *ruleMap:
+			v.sharedValues[x]=true; for _,item:=range x.values { work=append(work,item) }
+		case *ruleObject:
+			v.sharedValues[x]=true; for _,item:=range x.fields { work=append(work,item) }
+		case rulePointer: work=append(work,x.object)
+		case *ruleCell: v.sharedValues[x]=true; work=append(work,x.value)
+		case *ruleFunction:
+			v.sharedValues[x]=true
+			for env:=x.env;env!=nil;env=env.parent {
+				v.sharedScopes[env]=true; for _,item:=range env.vars { work=append(work,item) }
+			}
+		}
+		if len(v.sharedValues)>16384 || len(work)>16384 { ruleFail("shared source state graph budget") }
+	}
+}
