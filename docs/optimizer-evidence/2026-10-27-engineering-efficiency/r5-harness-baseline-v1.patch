+                        LIMITS["round_seconds"], {"GTT_DENSE_OUTPUT":str(path)})
+                    row[arm] = json.loads(read(path))
+                    if row[arm]["gomaxprocs"] != 1: raise ValueError("dense_worker_drift")
+                record["rounds"].append(row)
+                export()
+            record["summary"] = summary(record["rounds"])
+            if read(binding) != initial_binding: raise ValueError("dense_binding_drift")
