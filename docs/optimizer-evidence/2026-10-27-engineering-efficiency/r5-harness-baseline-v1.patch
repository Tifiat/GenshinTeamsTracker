+def _accepted_v8_images() -> dict[str, bytes]:
+    manifest_raw = _bounded(ACCEPTED_ARCHIVE / "manifest.json")
+    if sha(manifest_raw) != ACCEPTED_ARCHIVE_MANIFEST_SHA:
+        raise ValueError("uptake_accepted_archive_manifest_changed")
+    manifest = json.loads(manifest_raw)
+    if (manifest.get("schema") != "health_unified_accepted_v8_native_v1"
+            or manifest.get("v8_freeze_sha256") != V8_FREEZE_SHA
+            or manifest.get("preimages_manifest_sha256") != sha(_bounded(PREIMAGES))
+            or manifest.get("image_count") != 351):
+        raise ValueError("uptake_accepted_archive_identity_changed")
+    frozen = json.loads(_bounded(V8_FREEZE))["frozen_plan"]["native_images"]
+    if set(manifest.get("images", {})) != set(frozen):
+        raise ValueError("uptake_accepted_archive_files_changed")
+    images = {}
+    compressed_total = 0
+    raw_total = 0
+    for relative, item in manifest["images"].items():
+        archived = (ROOT / item["archive_path"]).resolve(strict=True)
+        if not archived.is_relative_to(ACCEPTED_ARCHIVE.resolve()) or archived.name != Path(relative).name + ".gz":
+            raise ValueError("uptake_accepted_archive_path_invalid")
+        packed = _bounded(archived)
+        if len(packed) != item["gzip_bytes"] or sha(packed) != item["gzip_sha256"]:
+            raise ValueError("uptake_accepted_archive_gzip_changed")
+        raw = gzip.decompress(packed)
+        if len(raw) != item["raw_bytes"] or sha(raw) != item["raw_sha256"] or sha(raw) != frozen[relative]:
+            raise ValueError("uptake_accepted_archive_raw_changed")
+        images[relative] = raw
+        compressed_total += len(packed)
+        raw_total += len(raw)
+    if compressed_total != manifest["gzip_bytes_total"] or raw_total != manifest["raw_bytes_total"]:
+        raise ValueError("uptake_accepted_archive_totals_changed")
+    if len(images) != 351 or {name: sha(raw) for name, raw in images.items()} != frozen:
+        raise ValueError("uptake_accepted_v8_native_images_changed")
+    return images
