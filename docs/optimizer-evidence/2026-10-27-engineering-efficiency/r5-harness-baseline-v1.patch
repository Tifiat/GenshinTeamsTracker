+def _frozen_record(raw: bytes, name: str) -> dict:
+    """Export only the owning mechanicdiagnostics.FrozenRecord v2 shape.
+
+    Static categories/paths only. In particular Reason, profiles, requests and
+    runtime owners/frames are rejected, never copied into this release archive.
+    Bounds/identity match internal/mechanicdiagnostics/store.go, not a VM model.
+    """
+    if not _FROZEN_NAME.fullmatch(name) or len(raw)>16*1024:raise ValueError("frozen record bounds")
+    value=json.loads(raw)
+    required=set(("schema","engine_id","compiler_id","mechanic_id","closure_sha256","source","kind","operation",
+                  "output_mask","reason_code","fallback","influence","first_seen","last_seen","count"))
+    if not isinstance(value,dict) or not required.issubset(value) or set(value)-required-{"call_stack","consumer_site"}:raise ValueError("frozen record fields")
+    if type(value['schema']) is not int or value['schema']!=2:raise ValueError("frozen record schema")
+    if any(not isinstance(value[k],str) or not _FROZEN_ID.fullmatch(value[k]) for k in ('engine_id','compiler_id','mechanic_id')):raise ValueError("frozen identity")
+    if not isinstance(value['closure_sha256'],str) or not re.fullmatch('[0-9a-f]{64}',value['closure_sha256']):raise ValueError("frozen closure")
+    def frame(item):
+        if not isinstance(item,dict) or set(item)!={'path','symbol'}:return False
+        path,symbol=item['path'],item['symbol']
+        return (isinstance(path,str) and len(path)<=256 and path.endswith('.go') and path.startswith(('pkg/','internal/'))
+            and all(_FROZEN_ID.fullmatch(p) for p in path.split('/')) and isinstance(symbol,str) and _FROZEN_ID.fullmatch(symbol))
+    stack=value.get('call_stack',[])
+    if not frame(value['source']) or not isinstance(stack,list) or len(stack)>12 or any(not frame(f) for f in stack):raise ValueError("frozen source frames")
+    if value['kind'] not in button._BOUNDARY_KINDS or value['reason_code'] not in _FROZEN_REASONS:raise ValueError("frozen category")
+    operation=value['operation'];site=value.get('consumer_site','')
+    if not isinstance(operation,str) or (operation and not _FROZEN_ID.fullmatch(operation)):raise ValueError("frozen operation")
+    if not isinstance(site,str) or (site and not re.fullmatch(r'rule_[a-z0-9_]+\.go:[1-9][0-9]{0,6}',site)):raise ValueError("frozen consumer site")
+    if value['fallback'] not in ('frozen','source_replay','full_simulation','excluded') or value['influence'] not in ('unknown','proven_affects_output','proven_no_effect','conservative'):raise ValueError("frozen policy")
+    if value['output_mask'] is not None and (type(value['output_mask']) is not int or not 0<=value['output_mask']<1<<64):raise ValueError("frozen mask")
+    if type(value['count']) is not int or not 0<value['count']<1<<64:raise ValueError("frozen count")
+    first=datetime.fromisoformat(value['first_seen'].replace('Z','+00:00'));last=datetime.fromisoformat(value['last_seen'].replace('Z','+00:00'))
+    zero=datetime.min.replace(tzinfo=timezone.utc)
+    if first.tzinfo is None or last.tzinfo is None or first==zero or last==zero or first>last:raise ValueError("frozen timestamps")
+    identity='\0'.join((value['mechanic_id'],value['closure_sha256'],value['source']['path'],value['source']['symbol'],value['kind'],operation,value['reason_code'],site))
+    if hashlib.sha256(identity.encode()).hexdigest()+'.json'!=name:raise ValueError("frozen logical identity")
+    return value
