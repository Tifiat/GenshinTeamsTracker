+        else:
+            debug_bytes = size
+    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
+        debug = {}
+    product = debug.get("product_result") if isinstance(debug.get("product_result"), dict) else result
+    capture.update(_provider_timing_summary(debug, validated_seeds))
+    if (
+        os.environ.get("GTT_MVP_POLISH_MODE") == "selected"
