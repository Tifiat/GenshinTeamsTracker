+                if remaining < maximum:
+                    raise TimeoutError("profile_full_phase_budget_unavailable")
+                record["stage"] = label
+                save()
+                result = k.gate.owned._run_owned(args, command_kind=label, env=env,
+                    log_path=job / (label + ".log"), timeout_seconds=maximum)
+                record.setdefault("commands", {})[label] = result
+                save()
+                if not k.gate.command_passed(result):
+                    raise ValueError("profile_owned_command_failed")
+            record["build_launches"] = 1
+            command([str(k.gate.owned.GO_EXE), "-C", str(k.NATIVE), "test", "-c", "-p=1", "-mod=readonly", "-buildvcs=false", "-overlay=" + str(overlay_path), "-o", str(binary), "./internal/allsets"], "profile-build", LIMITS["build_seconds"])
+            record["binary_sha256"] = k.sha(binary.read_bytes())
+            names = plan["contract_names"]
+            command([str(binary), "-test.run=^(" + "|".join(names) + ")$", "-test.v", "-test.parallel=1", "-test.timeout=30s"], "profile-contracts", LIMITS["contracts_seconds"])
+            retained.local_pair._verify_named_tests(read_bounded(job / "profile-contracts.log").decode(), names)
+            if source_plan() != plan or k.protected() != before or k.old.native_map() != native:
+                raise ValueError("profile_pre_run_source_drift")
