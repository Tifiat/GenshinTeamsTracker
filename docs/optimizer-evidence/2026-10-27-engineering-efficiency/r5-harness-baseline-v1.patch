+def observation_view(chasca, record, save):
+    """Case-private views propagate saved_width -> actual renderer runner hooks."""
+    from run_workspace.gcsim import optimizer_process_lifetime as lifetime
+    from tools.experiments.gcsim.mvp_polish import navia_exact_job_idle as idle
+    require(os.name == "nt" and Path(lifetime.__file__).resolve() == (
+                ROOT / "run_workspace/gcsim/optimizer_process_lifetime.py").resolve()
+            and Path(idle.__file__).resolve() == (ROOT / IDLE_FRAGMENT).resolve()
+            and sha(Path(lifetime.__file__).read_bytes()) == LIFETIME_SHA
+            and sha(Path(idle.__file__).read_bytes()) == IDLE_SHA, "navia_observation_source_drift")
+    runner = chasca.gate.owned._run_owned
+    require(Path(runner.__code__.co_filename).resolve() == (
+                ROOT / "tools/experiments/gcsim/mvp_polish/run_render_diagnostic.py").resolve()
+            and runner.__globals__["start_optimizer_process"] is lifetime.start_optimizer_process
+            and runner.__globals__["close_optimizer_process_lifetime"] is lifetime.close_optimizer_process_lifetime,
+            "navia_actual_runner_hooks_required")
+    owned = SimpleNamespace(**vars(chasca.gate.owned))
+    owned._run_owned = observed_runner(runner, process_type=lifetime.WindowsJobProcess,
+        observe=idle.observe_job_idle, record=record, save=save)
+    managed = SimpleNamespace(**vars(chasca.gate.managed))
+    original_remove = managed.remove_owned_job
+    def remove(job, root):
+        if (record.get("owned_cleanup_latch") is not True or record.get("owned_process_pending")
+                or not record.get("owned_job_observations")
+                or record.get("status") not in ("compile_guards_passed", "exact_pair_quality_exported")):
+            record["owned_cleanup_retained"] = "exact_job_or_command_acceptance_unconfirmed"
+            save()
+            raise ValueError("navia_exact_job_cleanup_not_released")
+        return original_remove(job, root)
+    managed.remove_owned_job = remove
+    gate = SimpleNamespace(**{**vars(chasca.gate), "owned": owned, "managed": managed})
+    gate.run_owned_body = function_view(chasca.gate.run_owned_body, managed=managed)
+    width = SimpleNamespace(**vars(chasca.width))
+    width._run_owned = function_view(chasca.width._run_owned, gate=gate)
+    return SimpleNamespace(**{**vars(chasca), "gate": gate, "width": width,
+        "snapshot": function_view(chasca.snapshot, gate=gate),
+        "run_phase": function_view(chasca.run_phase, width=width),
+        "lifecycle_services": function_view(chasca.lifecycle_services, gate=gate)})
