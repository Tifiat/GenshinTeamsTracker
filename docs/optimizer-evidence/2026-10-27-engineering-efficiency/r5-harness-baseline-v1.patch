+def difference_paths(left, right, path=""):
+    """Values never leave here; only schema-safe field/index paths are retained."""
+    if type(left) is dict and type(right) is dict:
+        for key in sorted(left.keys() | right.keys()):
+            gate.require(type(key) is str and re.fullmatch("[A-Za-z_][A-Za-z_0-9]{0,79}", key), "unsafe_difference_key")
+            child = path + ("." if path else "") + key
+            if key not in left or key not in right:
+                yield child + ".__presence__"
+            else:
+                yield from difference_paths(left[key], right[key], child)
+    elif type(left) is list and type(right) is list:
+        if len(left) != len(right):
+            yield path + ".__length__"
+        for i, (a, b) in enumerate(zip(left, right)):
+            yield from difference_paths(a, b, path + "[" + str(i) + "]")
+    elif type(left) is not type(right) or left != right:
+        yield path
+
+
+def compare(left, right, keys):
+    a, b = semantic({key: left[key] for key in keys}), semantic({key: right[key] for key in keys})
+    paths = list(difference_paths(a, b))
+    return {"equal": not paths, "per_key": {key: {"baseline_sha256": gate.digest(a[key]),
+        "candidate_sha256": gate.digest(b[key]), "equal": a[key] == b[key]} for key in keys},
+        "difference_count": len(paths), "difference_paths": paths[:LIMITS["difference_paths"]],
+        "all_difference_paths_sha256": gate.digest(paths), "difference_paths_truncated": len(paths) > LIMITS["difference_paths"]}
