+                        and record["remaining_managed_jobs"] == 0 and not record["optimizer_processes_remaining"]
+                        and record.get("cleanup_status") == "confirmed" and record["whole_wall_seconds"] <= LIMITS["whole_seconds"])
+                if not good:
+                    record["status"] = "failed"
