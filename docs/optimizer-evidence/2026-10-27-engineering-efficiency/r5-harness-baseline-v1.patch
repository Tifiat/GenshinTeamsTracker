+def retire_frozen_records(output: Path, *, now=None):
+    manifest=json.loads((output/'frozen-mechanics-manifest.json').read_bytes());archive=output/'frozen-mechanics.zip'
+    if manifest.get('owner')!='cache-team-matrix-20261025-frozen':raise ValueError('frozen release owner mismatch')
+    if (now or datetime.now(timezone.utc))<datetime.fromisoformat(manifest['expires_at_utc']):raise ValueError('frozen release retention not expired')
+    button.assert_unlinked(archive)
+    if button._sha(archive)!=manifest['archive_sha256']:raise ValueError('frozen release archive changed')
+    archive.unlink()
