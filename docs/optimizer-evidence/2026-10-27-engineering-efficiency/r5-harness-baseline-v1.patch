+"""Owned-job adapter for the four existing unified health regression cases.
+
+Preparation uses the existing fixture producers. Selected executes the real
+installed Selected session with a frozen prepared wire; the engine binding is
+the only cross-arm wire substitution. This module does nothing on import.
+"""
+from __future__ import annotations
+
+import argparse
+from collections import deque
+from copy import deepcopy
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(ROOT))
+STORE = ROOT / "data/gcsim/engines"
+CONSUMER = ROOT / "native/gcsim_optimizer/gtt-optimizer.exe"
+CONSUMER_SHA = "564d791d1263289fc7af3186b647b8fdce8da6c0489e13ce7259bda06ad6d394"
+CONTROL_ENGINE_SHA = "05979bf399f042b3e90de5e273ad49cd3aba37d1b067caeb5fe704fc47e67e93"
+NAVIA_REQUEST = ROOT / "data/profiles/57b730eff7544d0eb4e9f74ecb8fc2fa/data/gcsim/optimizer-go-runs/selected-20261018-003545-a61ac5d0/request.json"
+NAVIA_REQUEST_SHA = "a32315db85adf80306fbb02ed73550eb3c639cd1fb726adfe3c9655c32051183"
+CASES = {"chasca": (600, "all_sets", 3, 3), "navia": (597, "selected", 1, 3),
+         "burgeon": (98, "selected", 1, 2), "overload": (98, "selected", 1, 2)}
+SEEDS = [742031889, 742031890]
+READ_LIMIT = 96 << 20
+
+
+def sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def canonical(value) -> bytes:
+    from run_workspace.gcsim.optimizer_go_contracts import canonical_json_bytes
+    return canonical_json_bytes(value)
+
+
+def read(path: Path, limit: int = READ_LIMIT) -> bytes:
+    size = path.stat().st_size
+    if size > limit:
+        raise ValueError("unified_case_input_too_large")
+    with path.open("rb") as stream:
+        raw = stream.read(limit + 1)
+    if len(raw) != size or path.stat().st_size != size:
+        raise ValueError("unified_case_input_changed")
+    return raw
+
+
+def write_once(path: Path, value) -> None:
+    raw = canonical(value)
+    with path.open("xb") as stream:
+        stream.write(raw)
+        stream.flush()
+        os.fsync(stream.fileno())
+    if read(path) != raw:
+        raise ValueError("unified_case_write_readback_failed")
+
+
+def owned_job(path: Path) -> Path:
+    from tools import managed_optimizer_experiment as managed
+    managed.assert_unlinked(path)
+    job = path.resolve(strict=True)
+    if job.parent != managed.MANAGED_ROOT.resolve(strict=True) or not job.name.startswith("job-"):
+        raise ValueError("unified_case_requires_existing_owned_job")
+    return job
+
+
+def binding_input(job: Path, path: Path, arm: str) -> dict:
+    from tools import managed_optimizer_experiment as managed
+    managed.assert_unlinked(path)
+    path = path.resolve(strict=True)
+    if not path.is_relative_to(job):
+        raise ValueError("unified_case_binding_outside_job")
+    binding = json.loads(read(path, 1 << 20))
+    fields = {"binary_path", "artifact_sha256", "binding_sha256", "source_manifest_sha256",
+              "patch_manifest_sha256", "capabilities"}
+    if type(binding) is not dict or set(binding) != fields:
+        raise ValueError("unified_case_binding_shape")
+    binary = Path(binding["binary_path"]).resolve(strict=True)
+    if not binary.is_relative_to(job) and not binary.is_relative_to(STORE.resolve(strict=True)):
+        raise ValueError("unified_case_engine_outside_allowed_roots")
+    if sha(read(binary)) != binding["artifact_sha256"]:
+        raise ValueError("unified_case_engine_hash_changed")
+    expected = sha(canonical({"kind": "gtt.standalone_engine_binding.v1",
+                              "artifact_sha256": binding["artifact_sha256"],
+                              "source_manifest_sha256": binding["source_manifest_sha256"],
+                              "patch_manifest_sha256": binding["patch_manifest_sha256"]}))
+    if binding["binding_sha256"] != expected:
+        raise ValueError("unified_case_binding_digest")
+    if arm == "control":
+        control = json.loads(read(job / "control/request.json", 4 << 20))["engine"]
+        if control != binding or binding["artifact_sha256"] != CONTROL_ENGINE_SHA:
+            raise ValueError("unified_case_control_binding_changed")
+    return binding
+
+
+def _make_base(job: Path, case: str, root: Path) -> tuple[dict, dict]:
+    """Create one fixture, under the currently installed engine, once per case."""
+    from run_workspace.gcsim.optimizer_go_contracts import canonical_sha256
+    if case == "navia":
+        raw = read(NAVIA_REQUEST, 4 << 20)
+        if sha(raw) != NAVIA_REQUEST_SHA:
+            raise ValueError("unified_case_saved_navia_request_changed")
+        wire = json.loads(raw)
+        return wire, {"source": "retained_selected_request", "path": str(NAVIA_REQUEST),
+                      "raw_sha256": sha(raw), "account_database_opened": False}
+
+    from run_workspace.gcsim.optimizer_engine_context import load_active_gcsim_optimizer_engine_context
+    from run_workspace.gcsim.optimizer_go_inputs import prepare_optimizer_inputs
+    from run_workspace.gcsim.optimizer_go_requests import GcsimOptimizerGoRequest
+    engine = load_active_gcsim_optimizer_engine_context()
+    if engine.artifact_sha256 != CONTROL_ENGINE_SHA:
+        raise ValueError("unified_case_installed_engine_changed")
+    fixture_root = root / "fixture"
+    fixture_root.mkdir()
+    if case == "chasca":
+        from tools.experiments.gcsim.chasca_regression import fixture
+        from tools.experiments.gcsim.mvp_polish.navia_exact_pair import function_view
+        spec = json.loads(read(fixture.SPEC_PATH, 1 << 20))
+        spec.update(engine_id=engine.engine_id, engine_artifact_sha256=engine.artifact_sha256)
+        spec_path = root / "fixture-spec.json"
+        write_once(spec_path, spec)
+        db, team, metadata = function_view(fixture.create_fixture, SPEC_PATH=spec_path)(fixture_root, STORE)
+        rotation = spec["rotation"]
+        provenance = {"source": "existing_public_chasca_600_fixture", "metadata": metadata,
+                      "spec_path": str(fixture.SPEC_PATH), "private_spec_sha256": sha(read(spec_path))}
+    else:
+        from tools.experiments.gcsim.mvp_polish import case_data, fixture_admission
+        key = {"burgeon": "burgeon_thoma", "overload": "overload_chevreuse"}[case]
+        db, team, rotation, metadata = case_data.create_archetype_fixture(fixture_root, key, store_dir=STORE)
+        admitted = fixture_admission.compact_fixture_admission(fixture_admission.admit_fixture(
+            db, case_data.load_case(key), team, rotation, metadata, owned_root=fixture_root))
+        if admitted.get("status") != "passed" or admitted.get("artifact_count") != 98:
+            raise ValueError("unified_case_public_fixture_not_admitted")
+        provenance = {"source": "existing_public_archetype_fixture", "case_id": key,
+                      "metadata": metadata, "fixture_admission": admitted}
+    _, mode, groups, builds = CASES[case]
+    request = GcsimOptimizerGoRequest(str(db), team, 0, rotation, infinite_energy_enabled=True,
+        set_group_limit=groups, builds_per_group=builds, fast_mode=False, expanded_limits=False,
+        engine_store_dir=str(STORE), expected_engine_id=engine.engine_id,
+        optimizer_binary_path=str(CONSUMER), run_root=str(root / "unused-preparation-runs"),
+        seeds=tuple(SEEDS), product_timeout_ms=0)
+    prepared = root / "base-prepared"
+    prepared.mkdir()
+    result = prepare_optimizer_inputs(request, prepared, mode=mode)
+    wire = result["request"]
+    provenance["base_canonical_request_sha256"] = canonical_sha256(wire)
+    return wire, provenance
+
+
+def prepare(job: Path, case: str, arm: str, binding: dict) -> dict:
+    root = job / "cases" / case
+    root.mkdir(parents=True, exist_ok=True)
+    base_path = root / "base-request.json"
+    fixture_path = root / "fixture-receipt.json"
+    if base_path.exists():
+        base = json.loads(read(base_path, 4 << 20))
+        fixture = json.loads(read(fixture_path, 4 << 20))
+        if fixture.get("base_request_sha256") != sha(read(base_path)):
+            raise ValueError("unified_case_fixture_base_changed")
+    else:
+        base, provenance = _make_base(job, case, root)
+        if len(base["artifacts"]) != CASES[case][0] or base["stochastic"]["seeds"] != SEEDS:
+            raise ValueError("unified_case_inventory_or_seed_changed")
+        write_once(base_path, base)
+        fixture = {"schema": "health_unified_fixture_v1", "success": True, "case_key": case,
+                   "mode": CASES[case][1], "artifact_count": len(base["artifacts"]),
+                   "seeds": SEEDS, "base_request_sha256": sha(read(base_path)),
+                   "artifact_inventory_sha256": sha(canonical(base["artifacts"])),
+                   "provenance": provenance, "preparation_engine_calls": 0,
+                   "trace_context_semantics": "Retained opaque fixture identity; only engine is replaced. Fresh request and compact engine-binding hashes distinguish arms."}
+        write_once(fixture_path, fixture)
+    directory = root / arm
+    directory.mkdir()
+    wire = deepcopy(base)
+    wire["engine"] = binding
+    comparison = deepcopy(wire)
+    comparison["engine"] = base["engine"]
+    if comparison != base:
+        raise ValueError("unified_case_non_engine_input_changed")
+    write_once(directory / "request.json", wire)
+    write_once(directory / "fixture-receipt.json", {**fixture, "arm": arm,
+        "request_sha256": sha(canonical(wire)), "engine_binding_sha256": binding["binding_sha256"]})
+    from run_workspace.gcsim.optimizer_go_all_sources import prepare_all_set_effect_sources
+    engine_root = Path(binding["binary_path"]).resolve().parent.parent
+    sources = prepare_all_set_effect_sources(engine_root, binding, include_neutral_rules=True)
+    write_once(directory / "set-sources.json", sources)
+    entry = {"request_path": str(directory / "request.json"), "request_sha256": sha(read(directory / "request.json")),
+             "set_sources_path": str(directory / "set-sources.json"), "set_sources_sha256": sha(read(directory / "set-sources.json")),
+             "fixture_receipt_path": str(directory / "fixture-receipt.json"),
+             "fixture_receipt_sha256": sha(read(directory / "fixture-receipt.json")),
+             "engine_binding_sha256": binding["binding_sha256"]}
+    manifest_path = root / "case-manifest.json"
+    manifest = json.loads(read(manifest_path, 4 << 20)) if manifest_path.exists() else {
+        "schema": "health_unified_case_manifest_v1", "success": True, "case_key": case,
+        "mode": CASES[case][1], "artifact_count": len(base["artifacts"]),
+        "fixture_receipt_path": str(fixture_path), "fixture_receipt_sha256": sha(read(fixture_path)), "arms": {}}
+    if arm in manifest["arms"] or manifest.get("fixture_receipt_sha256") != sha(read(fixture_path)):
+        raise ValueError("unified_case_manifest_repeat_or_drift")
+    manifest["arms"][arm] = entry
+    temporary = root / "case-manifest.pending.json"
+    write_once(temporary, manifest)
+    os.replace(temporary, manifest_path)
+    if read(manifest_path) != canonical(manifest):
+        raise ValueError("unified_case_manifest_readback")
+    if arm == "control" and not (root / "request.json").exists():
+        write_once(root / "request.json", wire)
+    return manifest
+
+
+def _seconds(value):
+    return value / 1000 if type(value) in (int, float) and math.isfinite(value) and value >= 0 else None
+
+
+def _is_sha256(value) -> bool:
+    return (type(value) is str and len(value) == 64
+            and all(character in "0123456789abcdef" for character in value))
+
+
+def selected_verification_cohort(run_dir: Path, native: dict) -> tuple[list[dict], list[dict]]:
+    """Join only the verifier's final-n500 cohort to its exact config/result pairs."""
+    verification = native.get("verification")
+    if type(verification) is not dict or verification.get("iterations") != 500:
+        raise ValueError("unified_case_selected_verification_invalid")
+    cohort = deepcopy(verification.get("candidates"))
+    waves = deepcopy(verification.get("waves"))
+    if type(cohort) is not list or not 1 <= len(cohort) <= 9 or type(waves) is not list or not waves:
+        raise ValueError("unified_case_selected_cohort_missing")
+
+    workers_by_rank = {}
+    wave_rows = []
+    wave_indexes = set()
+    for wave in waves:
+        if type(wave) is not dict:
+            raise ValueError("unified_case_selected_wave_invalid")
+        index = wave.get("index")
+        start_rank = wave.get("start_rank")
+        candidate_count = wave.get("candidate_count")
+        workers = wave.get("workers")
+        parallelism = wave.get("parallelism")
+        if (type(index) is not int or index < 1 or index in wave_indexes
+                or type(start_rank) is not int or start_rank < 1
+                or type(candidate_count) is not int or candidate_count < 1
+                or type(workers) is not int or workers < 1
+                or type(parallelism) is not int or not 1 <= parallelism <= workers):
+            raise ValueError("unified_case_selected_wave_invalid")
+        wave_indexes.add(index)
+        wave_rows.append(wave)
+        for rank in range(start_rank, start_rank + candidate_count):
+            if rank in workers_by_rank:
+                raise ValueError("unified_case_selected_wave_rank_overlap")
+            workers_by_rank[rank] = wave
+
+    ranks = []
+    for row in cohort:
+        if type(row) is not dict:
+            raise ValueError("unified_case_selected_candidate_invalid")
+        rank = row.get("rank")
+        if type(rank) is not int or rank < 1:
+            raise ValueError("unified_case_selected_candidate_rank_invalid")
+        ranks.append(rank)
+    if (len(set(ranks)) != len(ranks) or sorted(ranks) != list(range(1, len(cohort) + 1))
+            or set(workers_by_rank) != set(ranks)):
+        raise ValueError("unified_case_selected_wave_cohort_mismatch")
+
+    run_dir = run_dir.resolve(strict=True)
+    final_root = run_dir / "verification" / "final-n500"
+    if not final_root.is_dir() or not final_root.resolve(strict=True).is_relative_to(run_dir):
+        raise ValueError("unified_case_selected_final_cohort_missing")
+    configs = sorted(final_root.rglob("config.txt"))
+    results = sorted(final_root.rglob("result.json"))
+    config_dirs = {path.parent for path in configs}
+    result_dirs = {path.parent for path in results}
+    if (len(configs) != len(cohort) or len(results) != len(cohort)
+            or len(config_dirs) != len(configs) or result_dirs != config_dirs):
+        raise ValueError("unified_case_selected_final_pair_count_invalid")
+
+    by_config = {}
+    result_by_dir = {path.parent: path for path in results}
+    for config in configs:
+        digest = sha(read(config))
+        if digest in by_config:
+            raise ValueError("unified_case_duplicate_final_config")
+        by_config[digest] = config
+
+    for row in cohort:
+        assignment = row.get("assignment")
+        if (type(assignment) is not list or len(assignment) != 4
+                or any(type(actor) is not list or len(actor) != 5 for actor in assignment)
+                or any(type(identifier) is not int for actor in assignment for identifier in actor)
+                or len({identifier for actor in assignment for identifier in actor}) != 20
+                or type(row.get("iterations")) is not int or row["iterations"] != 500
+                or not _is_sha256(row.get("assignment_sha256"))
+                or row["assignment_sha256"] != sha(canonical(assignment))
+                or not _is_sha256(row.get("config_sha256"))
+                or not _is_sha256(row.get("engine_result_sha256"))
+                or type(row.get("source")) is not str or not row["source"]):
+            raise ValueError("unified_case_invalid_full_build_cohort")
+        config = by_config.get(row["config_sha256"])
+        if config is None:
+            raise ValueError("unified_case_cohort_config_missing")
+        raw_config = read(config)
+        raw_result = result_by_dir[config.parent]
+        raw_result_bytes = read(raw_result)
+        if sha(raw_result_bytes) != row["engine_result_sha256"]:
+            raise ValueError("unified_case_cohort_result_hash_mismatch")
+        result = json.loads(raw_result_bytes)
+        embedded_config = result.get("config_file")
+        if (type(embedded_config) is not str
+                or embedded_config.encode("utf-8") not in (raw_config, raw_config + b"\n")):
+            raise ValueError("unified_case_cohort_result_config_mismatch")
+        wave = workers_by_rank[row["rank"]]
+        simulator_settings = result.get("simulator_settings")
+        if (type(simulator_settings) is not dict
+                or type(simulator_settings.get("iterations")) is not int
+                or simulator_settings["iterations"] != 500
+                or type(simulator_settings.get("number_of_workers")) is not int
+                or simulator_settings["number_of_workers"] != wave["workers"]):
+            raise ValueError("unified_case_cohort_worker_mismatch")
+        row.update(config_path=str(config), result_path=str(raw_result),
+                   verification_wave_index=wave["index"],
+                   verification_workers=wave["workers"],
+                   verification_parallelism=wave["parallelism"])
+    return cohort, wave_rows
+
+
+def collect_saved_selected(job: Path, case: str, arm: str, binding: dict, run_dir: Path,
+                           archive_provenance: dict) -> dict:
+    """Derive a Selected result from a retained successful wrapper without rerunning it."""
+    job = owned_job(job)
+    if case != "navia" or arm != "control":
+        raise ValueError("unified_case_archive_collection_scope")
+    directory = job / "cases" / case / arm
+    result_path = directory / "selected-result.json"
+    if result_path.exists():
+        raise FileExistsError("unified_case_selected_repeat")
+    run_dir = run_dir.resolve(strict=True)
+    expected_runs = (directory / "runs").resolve(strict=True)
+    if run_dir.parent != expected_runs:
+        raise ValueError("unified_case_archive_run_outside_owned_case")
+
+    required = {"v5_result_sha256", "v5_audit_sha256", "source_wrapper_sha256", "source_run_dir",
+                "source_request_sha256", "source_set_sources_sha256", "source_selected_result_sha256",
+                "source_selected_result_path", "source_files"}
+    if type(archive_provenance) is not dict or set(archive_provenance) != required:
+        raise ValueError("unified_case_archive_provenance_shape")
+    for key in ("v5_result_sha256", "v5_audit_sha256", "source_wrapper_sha256", "source_request_sha256",
+                "source_set_sources_sha256", "source_selected_result_sha256"):
+        if not _is_sha256(archive_provenance.get(key)):
+            raise ValueError("unified_case_archive_provenance_digest")
+    source_failure_path = Path(archive_provenance["source_selected_result_path"])
+    if source_failure_path.is_absolute():
+        raise ValueError("unified_case_archive_failure_path_invalid")
+    source_failure_path = (job / source_failure_path).resolve(strict=True)
+    if not source_failure_path.is_relative_to(job):
+        raise ValueError("unified_case_archive_failure_path_invalid")
+    source_failure_raw = read(source_failure_path, 4 << 20)
+    if sha(source_failure_raw) != archive_provenance["source_selected_result_sha256"]:
+        raise ValueError("unified_case_archive_failure_digest_mismatch")
+    source_failure = json.loads(source_failure_raw)
+    if (type(source_failure) is not dict or source_failure.get("schema") != "health_unified_selected_v1"
+            or source_failure.get("success") is not False or source_failure.get("case_key") != case
+            or source_failure.get("arm") != arm
+            or source_failure.get("error") != "unified_case_verification_file_cap"
+            or source_failure.get("request_sha256") != archive_provenance["source_request_sha256"]
+            or source_failure.get("engine_binding_sha256") != binding.get("binding_sha256")
+            or source_failure.get("installed_consumer_sha256") != CONSUMER_SHA
+            or source_failure.get("run_dir") != archive_provenance["source_run_dir"]
+            or source_failure.get("optimizer_wrapper_sha256") != archive_provenance["source_wrapper_sha256"]
+            or Path(archive_provenance["source_run_dir"]).name != run_dir.name):
+        raise ValueError("unified_case_archive_failure_link_mismatch")
+
+    request_raw = read(directory / "request.json", 4 << 20)
+    sources_raw = read(directory / "set-sources.json", 16 << 20)
+    if (sha(request_raw) != archive_provenance["source_request_sha256"]
+            or sha(sources_raw) != archive_provenance["source_set_sources_sha256"]
+            or json.loads(request_raw).get("engine") != binding
+            or binding.get("artifact_sha256") != CONTROL_ENGINE_SHA):
+        raise ValueError("unified_case_archive_current_input_mismatch")
+
+    source_files = archive_provenance.get("source_files")
+    if type(source_files) is not dict or not source_files:
+        raise ValueError("unified_case_archive_source_files_shape")
+    for name, digest in source_files.items():
+        relative = Path(name)
+        if (type(name) is not str or relative.is_absolute() or ".." in relative.parts
+                or not _is_sha256(digest)):
+            raise ValueError("unified_case_archive_source_file_entry_invalid")
+        path = (run_dir / relative).resolve(strict=True)
+        if not path.is_relative_to(run_dir) or sha(read(path)) != digest:
+            raise ValueError("unified_case_archive_source_file_digest_mismatch")
+    wrapper = run_dir / "optimizer-output.json"
+    expected_source_files = {"optimizer-output.json"}
+    for config in (run_dir / "verification" / "final-n500").rglob("config.txt"):
+        expected_source_files.add(config.relative_to(run_dir).as_posix())
+        expected_source_files.add((config.parent / "result.json").relative_to(run_dir).as_posix())
+    if (set(source_files) != expected_source_files
+            or source_files.get("optimizer-output.json") != archive_provenance["source_wrapper_sha256"]):
+        raise ValueError("unified_case_archive_source_file_set_mismatch")
+    wrapper_raw = read(wrapper)
+    native = json.loads(wrapper_raw)
+    cohort, waves = selected_verification_cohort(run_dir, native)
+    if not 1 <= len(cohort) <= CASES[case][3]:
+        raise ValueError("unified_case_selected_cohort_missing")
+
+    adapter_timings = source_failure.get("adapter_timings")
+    if (type(adapter_timings) is not dict or adapter_timings.get("terminal_status") != "success"
+            or adapter_timings.get("mode") != "selected"):
+        raise ValueError("unified_case_archive_adapter_not_successful")
+    started = time.monotonic()
+    output = {
+        "schema": "health_unified_selected_v1", "success": True, "case_key": case, "arm": arm,
+        "run_dir": str(run_dir), "request_sha256": sha(request_raw),
+        "engine_binding_sha256": binding["binding_sha256"],
+        "installed_consumer_sha256": CONSUMER_SHA,
+        "optimizer_wrapper_path": str(wrapper), "optimizer_wrapper_sha256": sha(wrapper_raw),
+        "collection_source": "archived_optimizer_output",
+        "source_provenance": {
+            "v5_result_sha256": archive_provenance["v5_result_sha256"],
+            "v5_audit_sha256": archive_provenance["v5_audit_sha256"],
+            "source_failure_result_path": str(source_failure_path),
+            "source_failure_result_sha256": sha(source_failure_raw),
+            "source_failure": {"error_class": source_failure.get("error_class"),
+                               "error": source_failure.get("error"),
+                               "success": source_failure.get("success")},
+            "source_wrapper_sha256": archive_provenance["source_wrapper_sha256"],
+            "source_wrapper_path": source_failure.get("optimizer_wrapper_path"),
+            "source_run_dir": archive_provenance["source_run_dir"],
+            "source_request_sha256": archive_provenance["source_request_sha256"],
+            "source_set_sources_sha256": archive_provenance["source_set_sources_sha256"],
+            "source_files": dict(sorted(source_files.items())),
+            "source_timings": {key: source_failure.get(key) for key in
+                               ("setup_seconds", "search_seconds", "verification_seconds",
+                                "native_total_seconds", "whole_headless_seconds", "adapter_timings",
+                                "progress", "session_attempts")},
+        },
+        "source_run_dir": archive_provenance["source_run_dir"],
+        "source_optimizer_wrapper_sha256": archive_provenance["source_wrapper_sha256"],
+        "setup_seconds": source_failure.get("setup_seconds"),
+        "search_seconds": source_failure.get("search_seconds"),
+        "verification_seconds": source_failure.get("verification_seconds"),
+        "native_total_seconds": source_failure.get("native_total_seconds"),
+        "whole_headless_seconds": source_failure.get("whole_headless_seconds"),
+        "adapter_timings": adapter_timings,
+        "progress": source_failure.get("progress"), "session_attempts": source_failure.get("session_attempts"),
+        "verification_waves": waves, "cohort": cohort, "product_result": native.get("product_result"),
+        "coverage": "installed Selected consumer/shared scalar kernel with this engine; AllSets-only algorithms not applicable",
+        "timing_semantics": "native compile/search/verification and source headless wall are copied from the successful V5 session; this offline collection adds no simulation work",
+        "collection_seconds": None,
+    }
+    output["collection_seconds"] = time.monotonic() - started
+    write_once(result_path, output)
+    return output
+
+
+def selected(job: Path, case: str, arm: str, binding: dict) -> dict:
+    if case == "chasca":
+        raise ValueError("unified_chasca_is_prepare_only")
+    directory = job / "cases" / case / arm
+    result_path = directory / "selected-result.json"
+    if result_path.exists():
+        raise FileExistsError("unified_case_selected_repeat")
+    started = time.monotonic()
+    output = {"schema": "health_unified_selected_v1", "success": False, "case_key": case, "arm": arm,
+              "run_dir": None, "request_sha256": None, "engine_binding_sha256": binding["binding_sha256"],
+              "installed_consumer_sha256": CONSUMER_SHA, "setup_seconds": None, "search_seconds": None,
+              "verification_seconds": None, "whole_headless_seconds": None,
+              "cleanup_status": "parent_owned_retained_until_export", "session_attempts": 0,
+              "coverage": "installed Selected consumer/shared scalar kernel with this engine; AllSets-only algorithms not applicable"}
+    try:
+        wire_raw = read(directory / "request.json", 4 << 20)
+        wire = json.loads(wire_raw)
+        if wire["engine"] != binding or sha(read(CONSUMER)) != CONSUMER_SHA:
