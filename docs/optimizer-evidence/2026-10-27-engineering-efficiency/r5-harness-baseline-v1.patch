+"""Guarded public-data fixtures and one-case real offscreen button test.
+
+The numerical test is disabled in ordinary suites. It is activated only by the
+managed MVP runner with one explicit case/mode/lease and has both a bounded
+product timeout and an outer process-tree watchdog. Other tests never execute a
+worker or numeric backend.
+"""
+from __future__ import annotations
+
+from contextlib import closing, contextmanager
+import copy
+from dataclasses import replace
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+import tempfile
+import threading
+import time
+import unittest
+from unittest.mock import MagicMock, Mock, patch
+
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+from PySide6.QtCore import QObject, QThread, Slot
+
+from run_workspace.gcsim.engine_store import (
+    DEFAULT_GCSIM_ENGINE_STORE_DIR,
+    GcsimEngineStore,
+)
+from run_workspace.gcsim.optimizer_engine_context import load_active_gcsim_optimizer_engine_context
+from run_workspace.gcsim.optimizer_go_all import GcsimOptimizerGoAllSetsRequest
+from run_workspace.gcsim.optimizer_go_requests import DEFAULT_OPTIMIZER_BINARY
+from run_workspace.gcsim.optimizer_go_contracts import canonical_sha256
+from run_workspace.gcsim.optimizer_go_selected import GcsimOptimizerGoSelectedRequest
+from run_workspace.gcsim.optimizer_go_theory import GcsimOptimizerGoTheoryRequest
+from run_workspace.gcsim.artifact_investment_rules import (
+    ARTIFACT_MAIN_STAT_SLOTS,
+    FIVE_STAR_SUBSTAT_ROLL_RULES,
+    LEGAL_FIVE_STAR_MAIN_STATS_BY_SLOT,
+)
+from run_workspace.gcsim.optimizer_theory_presentation import (
+    GO_TO_CONFIG_STAT,
+    THEORY_STAT_KEYS,
+    _MEASUREMENT_KIND,
+    _candidate_sha256,
+    validate_theory_family,
+)
+from run_workspace.gcsim.settings import GcsimOptimizerSettings
+from tests.ui.gcsim_browser.test_optimizer_button_backend import ButtonHarness, _APP
+from tools.experiments.gcsim.mvp_polish.case_data import (
+    ROOT,
+    _display_substat_total,
+    _substat_templates,
+    button_mode_policy,
+    case_review_policy,
+    create_archetype_fixture,
+    load_case,
+)
+from tools.experiments.gcsim.mvp_polish.support_response_projection import project_support_response
+from tools.experiments.gcsim.mvp_polish.fixture_admission import SCHEMA as FIXTURE_ADMISSION_SCHEMA, FixtureAdmissionError, admit_fixture
+from tools.experiments.gcsim.mvp_polish.run_case import (
+    PROCESS_CAP_BY_MODE,
+    PRODUCT_TIMEOUT_MS,
+    SUMMARY_SCHEMA,
+    _compact_child_receipt,
+    _compact_neutral_model_stats,
+    _compact_theory_family,
+    run_managed_case,
+)
+from tests.run_workspace.gcsim.theory_output_fixture import no_verified_snapshot, output_snapshot, snapshot_with_rows
+from ui.app_shell import AppShell
+from ui.gcsim_browser.run_worker import GcsimBrowserSelectedOptimizerWorker
+
+
+_TEST_THREAD_JOIN_TIMEOUT_MS = 15_000
+_UNJOINED_TEST_THREADS: list[tuple[object, object, object]] = []
+_PROVIDER_TIMING_ROW_LIMIT = 98
+
+
+def _is_lower_sha256(value: object) -> bool:
+    return (
+        isinstance(value, str)
+        and len(value) == 64
+        and all(character in "0123456789abcdef" for character in value)
+    )
+
+
+def _validated_seed_schedule(request: dict) -> list[int] | None:
+    seeds = (request.get("stochastic") or {}).get("seeds")
+    if not isinstance(seeds, list) or len(seeds) < 2:
+        return None
+    if any(type(seed) is not int or not 0 <= seed <= (2**64 - 1) for seed in seeds):
+        return None
+    if any(left >= right for left, right in zip(seeds, seeds[1:])):
+        return None
+    return seeds
+
+
+def _create_admitted_fixture(root, case, *, store_dir):
+    db_path, team, rotation, metadata = create_archetype_fixture(root, case.case_id, store_dir=store_dir)
+    admission = admit_fixture(db_path, case, team, rotation, metadata, owned_root=root)
+    return db_path, team, rotation, metadata, admission
+
+
+def _validate_expected_fixture_sha256(metadata: dict, expected: str) -> None:
+    """An optional orchestration pin must reject drift before the button exists."""
+    if expected and (
+        not _is_lower_sha256(expected) or metadata.get("fixture_sha256") != expected
+    ):
+        raise ValueError("synthetic_fixture_sha256_mismatch")
+
+
+def _provider_timing_summary(debug: dict, seeds: list[int] | None) -> dict:
+    raw_rows = debug.get("provider_timings")
+    if "provider_timings" not in debug:
+        result = {"provider_timing_status": "missing"}
+    elif not isinstance(raw_rows, list):
+        result = {"provider_timing_status": "invalid"}
+    else:
+        search_algorithm = debug.get("search_algorithm")
+        neutral_route = search_algorithm == "neutral_event_effects"
+        rows = []
+        invalid_rows = 0
+        for index, raw in enumerate(raw_rows[:_PROVIDER_TIMING_ROW_LIMIT]):
+            if not isinstance(raw, dict):
+                invalid_rows += 1
+                continue
+            context_sha256 = raw.get("context_sha256")
+            seed = raw.get("seed")
+            process_ms = raw.get("process_ms")
+            decode_ms = raw.get("decode_ms")
+            result_sha256 = raw.get("result_sha256")
+            if (
+                not _is_lower_sha256(context_sha256)
+                or type(seed) is not int
+                or not 0 <= seed <= (2**64 - 1)
+                or type(process_ms) not in (int, float)
+                or not 0 <= process_ms < float("inf")
+                or type(decode_ms) not in (int, float)
+                or not 0 <= decode_ms < float("inf")
+                or not isinstance(result_sha256, str)
+                or (result_sha256 != "" and not _is_lower_sha256(result_sha256))
+            ):
+                invalid_rows += 1
+                continue
+            if seeds is None or seed not in seeds:
+                phase = "unverified"
+            elif neutral_route and index < len(seeds):
+                phase = "initial_neutral" if seed == seeds[index] else "unverified"
+            elif neutral_route:
+                phase = "schedule_context"
+            elif search_algorithm == "context_capture":
+                phase = "context_capture"
+            else:
+                phase = "unverified"
+            row = {
+                "provider_call_index": index,
+                "context_sha256": context_sha256,
+                "seed": seed,
+                "process_ms": process_ms,
+                "decode_ms": decode_ms,
+                "result_status": "hash_present" if result_sha256 else "hash_absent",
+                "capture_phase": phase,
+            }
+            if result_sha256:
+                row["result_sha256"] = result_sha256
+            rows.append(row)
+
+        row_limit_exceeded = len(raw_rows) > _PROVIDER_TIMING_ROW_LIMIT
+        result = {
+            "provider_timing_status": (
+                "over_limit" if row_limit_exceeded else "invalid_rows" if invalid_rows else "available"
+            ),
+            "provider_timing_row_count": len(raw_rows),
+            "provider_timing_valid_row_count": len(rows),
+            "provider_timing_invalid_row_count": invalid_rows,
+            "provider_timing_rows": rows,
+        }
+        if row_limit_exceeded:
+            result["provider_timing_rows_truncated"] = True
+
+    boundaries = debug.get("effect_boundaries")
+    if debug.get("search_algorithm") == "neutral_event_effects" and isinstance(boundaries, list):
+        outcomes = []
+        prefixes = (
+            ("schedule_capture_changed_item_timing_unverified:", "capture_resolved"),
+            ("schedule_capture_failed:", "capture_failed"),
+            ("schedule_capture_context_budget_exhausted:", "budget_exhausted"),
+        )
+        for boundary in boundaries:
+            if not isinstance(boundary, str):
+                continue
+            for prefix, outcome in prefixes:
+                if not boundary.startswith(prefix):
+                    continue
+                context_sha256 = boundary[len(prefix):].split(":", 1)[0]
+                if _is_lower_sha256(context_sha256):
+                    outcomes.append({"context_sha256": context_sha256, "outcome": outcome})
+                    if len(outcomes) > _PROVIDER_TIMING_ROW_LIMIT:
+                        break
+                break
+            if len(outcomes) > _PROVIDER_TIMING_ROW_LIMIT:
+                break
+        result["schedule_context_outcomes"] = outcomes[:_PROVIDER_TIMING_ROW_LIMIT]
+        if len(outcomes) > _PROVIDER_TIMING_ROW_LIMIT:
+            result["schedule_context_outcomes_truncated"] = True
+    return result
+
+
+def _engine_store_path() -> Path:
+    return Path(os.environ.get("GTT_OPTIMIZER_BUTTON_ENGINE_STORE") or DEFAULT_GCSIM_ENGINE_STORE_DIR)
+
+
+def _active_engine_available() -> bool:
+    try:
+        return GcsimEngineStore(_engine_store_path()).get_active_engine() is not None
+    except (OSError, ValueError, RuntimeError):
+        return False
+
+
+_POST_RUN_CONTRACT_ERROR_CODE = "post_run_contract_failed"
+
+
+def _validate_real_button_summary(
+    summary: dict,
+    *,
+    expected_artifact_count: int | None,
+    expected_rotation_sha256: str,
+    expected_engine_artifact_sha256: str | None,
+    mode: str,
+    process_cap: int,
+) -> dict[str, object]:
+    """Return only stable contract codes; never copy raw exception text/paths."""
+    failures: list[str] = []
+    if summary.get("status") != "success":
+        failures.append("summary_not_success")
+        return {
+            "status": "failed",
+            "error_code": _POST_RUN_CONTRACT_ERROR_CODE,
+            "failed_checks": failures,
+        }
+    guard = summary.get("process_guard")
+    if not isinstance(guard, dict):
+        guard = {}
+    if guard.get("one_button_click") is not True:
+        failures.append("one_button_click_missing")
+    launched = guard.get("launched")
+    if isinstance(launched, bool) or not isinstance(launched, int) or launched < 0:
+        failures.append("process_cap_invalid")
+    elif launched > process_cap:
+        failures.append("process_cap_exceeded")
+
+    joined = summary.get("config_join")
+    if not isinstance(joined, dict):
+        joined = {}
+    if joined.get("rotation_source_sha256") != expected_rotation_sha256:
+        failures.append("rotation_source_hash_mismatch")
+    if joined.get("button_signal_rotation_sha256") != expected_rotation_sha256:
+        failures.append("button_signal_rotation_hash_mismatch")
+    if joined.get("request_hash_join_match") is not True:
+        failures.append("request_hash_join_failed")
+    if not isinstance(expected_engine_artifact_sha256, str) or not expected_engine_artifact_sha256:
+        failures.append("engine_artifact_reference_missing")
+    elif joined.get("engine_artifact_sha256") != expected_engine_artifact_sha256:
+        failures.append("engine_artifact_hash_mismatch")
+
+    inventory = summary.get("inventory")
+    if not isinstance(inventory, dict):
+        inventory = {}
+    actual_artifact_count = inventory.get("artifact_domain_count")
+    if expected_artifact_count is None or isinstance(actual_artifact_count, bool) or not isinstance(actual_artifact_count, int):
+        failures.append("artifact_domain_count_missing")
+    elif actual_artifact_count != expected_artifact_count:
+        failures.append("artifact_domain_count_mismatch")
+
+    if mode == "theory":
+        if guard.get("theory_finish_button_clicked") is not True:
+            failures.append("theory_finish_not_clicked")
+        ready_count = guard.get("theory_first_ready_verification_count")
+        if isinstance(ready_count, bool) or not isinstance(ready_count, int) or ready_count <= 0:
+            failures.append("theory_first_ready_missing")
+        if (
+            guard.get("theory_first_ready_event_stage") not in ("searching", "first_light")
+            or guard.get("theory_first_ready_phase") != "first_light"
+            or guard.get("theory_first_ready_finalizing_before") is not True
+            or guard.get("theory_first_ready_finalizing_after") is not False
+            or guard.get("theory_first_ready_finish_enabled") is not True
+        ):
+            failures.append("theory_first_ready_controls_invalid")
+        if guard.get("theory_session_finish_requested") is not True:
+            failures.append("theory_finish_not_requested")
+        result_summary = summary.get("result_summary")
+        terminal = result_summary.get("theory_snapshot") if isinstance(result_summary, dict) else None
+        terminal = terminal if isinstance(terminal, dict) else {}
+        retention = terminal.get("verified_row_retention")
+        verified_count = retention.get("retained_count") if isinstance(retention, dict) else None
+        verification = terminal.get("verification")
+        if (
+            terminal.get("status") != "success"
+            or terminal.get("response_status") != "ordinary_verified"
+            or terminal.get("phase") != "first_light"
+            or not isinstance(verification, dict) or verification.get("in_progress") is not False
+            or type(verified_count) is not int or verified_count < 1
+            or retention.get("status") != "complete"
+            or retention.get("verified_count_matches_publication") is not True
+        ):
+            failures.append("theory_terminal_unverified")
+        if terminal.get("finished_early") is not True:
+            failures.append("theory_terminal_not_finished_early")
+
+    return {
+        "status": "failed" if failures else "passed",
+        "error_code": _POST_RUN_CONTRACT_ERROR_CODE if failures else "",
+        "failed_checks": failures[:16],
+    }
+
+
+def _record_real_button_contract(
+    summary: dict,
+    *,
+    expected_artifact_count: int | None,
+    expected_rotation_sha256: str,
+    expected_engine_artifact_sha256: str | None,
+    mode: str,
+    process_cap: int,
+) -> dict[str, object]:
+    validation = _validate_real_button_summary(
+        summary,
+        expected_artifact_count=expected_artifact_count,
+        expected_rotation_sha256=expected_rotation_sha256,
+        expected_engine_artifact_sha256=expected_engine_artifact_sha256,
+        mode=mode,
+        process_cap=process_cap,
+    )
+    summary["contract_validation"] = validation
+    if validation["status"] == "failed" and summary.get("status") == "success":
+        summary["status"] = "failed"
+        errors = summary.get("errors")
+        if not isinstance(errors, dict) or not errors.get("code"):
+            summary["errors"] = {"code": _POST_RUN_CONTRACT_ERROR_CODE, "class": ""}
+    return validation
+
+
+def _post_finalize_failure_reason(summary: dict) -> str:
+    """Return a stable test-failure string when teardown invalidates a run."""
+    if summary.get("status") == "success":
+        guard = summary.get("process_guard")
+        if summary.get("mode") == "theory" and (
+            not isinstance(guard, dict) or guard.get("worker_thread_joined") is not True
+        ):
+            return "real_button_terminal_summary_failed:worker_thread_join_failed"
+        return ""
+    errors = summary.get("errors")
+    error_code = errors.get("code") if isinstance(errors, dict) else None
+    safe_codes = {
+        "worker_thread_join_failed",
+        "harness_teardown_failed",
+        "harness_shutdown_failed",
+        "process_receipt_failed",
+        "real_button_test_exception",
+        "backend_returned_failure",
+        "post_run_contract_failed",
+        "not_started",
+    }
+    if isinstance(error_code, str) and error_code in safe_codes:
+        return f"real_button_terminal_summary_failed:{error_code}"
+    return "real_button_terminal_summary_failed"
+
+
+def _initial_backend_failure_code(payload: dict) -> str:
+    if payload.get("success") is True:
+        return ""
+    code = payload.get("error_code")
+    return str(code) if isinstance(code, str) and code else "real_button_failed"
+
+
+def _retain_first_theory_publication(summary: dict, harness) -> None:
+    if harness is None or harness.first_theory_ready_projection is None:
+        return
+    result_summary = summary.get("result_summary")
+    if not isinstance(result_summary, dict):
+        result_summary = {}
+        summary["result_summary"] = result_summary
+    result_summary["theory_first_ready_snapshot"] = harness.first_theory_ready_projection
+    result_summary["theory_first_ready_elapsed_ms"] = harness.first_theory_ready_elapsed_ms
+    result_summary["theory_first_ready_projection_ms"] = harness.first_theory_ready_projection_ms
+
+
+def _theory_lifecycle_guard(harness, payload: dict) -> dict:
+    controls = harness.first_theory_ready_controls if harness is not None else None
+    controls = controls if isinstance(controls, dict) else {}
+    timings = payload.get("adapter_timings")
+    # The shared session finally block records its actual Finish event here.
+    # A clicked button, missing timings or truthy non-bool is not an acknowledgement.
+    requested = timings.get("finish_requested") if isinstance(timings, dict) else None
+    return {
+        "theory_first_ready_event_stage": controls.get("event_stage"),
+        "theory_first_ready_finalizing_before": controls.get("finalizing_before"),
+        "theory_first_ready_finalizing_after": controls.get("finalizing_after"),
+        "theory_first_ready_finish_enabled": controls.get("finish_enabled"),
+        "theory_session_finish_requested": requested if type(requested) is bool else None,
+    }
+
+
+class _TheoryProgressBridge(QObject):
+    """Route worker progress into the GUI thread before touching widgets."""
+
+    def __init__(self, parent: QObject, callback):
+        super().__init__(parent)
+        self._callback = callback
+
+    @Slot(dict)
+    def forward(self, event: dict) -> None:
+        self._callback(event)
+
+
+class ArchetypeButtonHarness(ButtonHarness):
+    """The existing real AppShell launch/finish harness, with Theory routing."""
+
+    def __init__(self, db_path, team, paths):
+        super().__init__(db_path, team, paths)
+        self.progress_events: list[tuple[float, str]] = []
+        self.submitted_rotation_texts: list[str] = []
+        self.output_render_elapsed_ms = 0
+        self.mode = ""
+        self.first_theory_ready_snapshot: dict | None = None
+        self.first_theory_ready_projection: dict | None = None
+        self.first_theory_ready_elapsed_ms: int | None = None
+        self.first_theory_ready_projection_ms: int | None = None
+        self.first_theory_ready_controls: dict | None = None
+        self.button_click_started_at: float | None = None
+        self.progress_receiver_thread_ids: list[int] = []
+        self.finish_button_clicked = False
+        self.finish_button_error: str | None = None
+        self.finish_button_click_elapsed_ms: int | None = None
+        self.workspace.optimizer_theory_requested.connect(
+            lambda index, rotation: AppShell._on_gcsim_optimizer_requested(
+                self, index, rotation, mode="theory"
+            )
+        )
+        self.workspace.optimizer_finish_requested.connect(
+            lambda: AppShell._on_gcsim_optimizer_finish_requested(self)
+        )
+        self.workspace.set_optimizer_theory_available(True)
+        self.workspace.set_optimizer_all_sets_available(True)
+        self._original_progress_callback = self.workspace.update_optimizer_progress
+
+        def track_progress(event):
+            self.progress_receiver_thread_ids.append(threading.get_ident())
+            stage = str(event.get("stage") or "unknown")
+            self.progress_events.append((time.monotonic(), stage))
+            previous_snapshot = self.workspace._optimizer_theory_snapshot
+            finalizing_before = self.workspace._optimizer_finalizing
+            self._original_progress_callback(event)
+            snapshot = self.workspace._optimizer_theory_snapshot
+            if (
+                self.mode == "theory" and self.workspace._optimizer_mode == "theory"
+                and self.first_theory_ready_snapshot is None
+                and isinstance(event.get("theory_snapshot"), dict)
+                and stage in {"searching", "first_light", "breadth_light", "deep_baseline"}
+                and snapshot is not previous_snapshot
+                and self.workspace._optimizer_theory_terminal_payload is None
+                and _theory_snapshot_ready(snapshot)
+            ):
+                self.first_theory_ready_snapshot = copy.deepcopy(snapshot)
+                self.first_theory_ready_controls = {
+                    "event_stage": stage,
+                    "finalizing_before": finalizing_before,
+                    "finalizing_after": self.workspace._optimizer_finalizing,
+                    "finish_enabled": self.workspace.optimizer_finish_button.isEnabled(),
+                }
+                if self.button_click_started_at is not None:
+                    self.first_theory_ready_elapsed_ms = round(
+                        (time.monotonic() - self.button_click_started_at) * 1000
+                    )
+                # Preserve the first measured publication before any Finish
+                # control check or action can fail. Only this bounded detached
+                # projection is retained for the receipt.
+                projection_started = time.monotonic()
+                self.first_theory_ready_projection = _theory_publication_summary(
+                    snapshot,
+                    elapsed_ms_from_button_click=self.first_theory_ready_elapsed_ms,
+                )
+                self.first_theory_ready_projection_ms = round(
+                    (time.monotonic() - projection_started) * 1000
+                )
+                finish_button = self.workspace.optimizer_finish_button
+                if not finish_button.isEnabled():
+                    self.finish_button_error = "finish_button_disabled_at_first_verified_snapshot"
+                    return
+                click_started = time.monotonic()
+                finish_button.click()
+                self.finish_button_clicked = True
+                self.finish_button_click_elapsed_ms = round((time.monotonic() - click_started) * 1000)
+
+        self._track_progress = track_progress
+        self._theory_progress_bridge = _TheoryProgressBridge(self.workspace, track_progress)
+        # AppShell keeps its normal signal connection. The receiver is a bound
+        # QObject slot with GUI-thread affinity, not a free Python closure.
+        self.workspace.update_optimizer_progress = self._theory_progress_bridge.forward
+
+    def shutdown_for_test(self, *, wait_ms: int = _TEST_THREAD_JOIN_TIMEOUT_MS) -> bool:
+        """Cancel and join the owned AppShell worker before Qt teardown.
+
+        A failed or exceptional join keeps the harness, worker, and QThread
+        strongly referenced. The managed child writes its failure receipt and
+        exits without running QObject destructors against a live QThread.
+        """
+        worker = self._gcsim_browser_run_worker
+        thread = self._gcsim_browser_run_thread
+        if thread is None:
+            return True
+        try:
+            if not thread.isRunning():
+                return True
+            joined = AppShell._shutdown_gcsim_run(self, wait_ms=wait_ms)
+            terminated = not thread.isRunning()
+            if joined and terminated:
+                return True
+        except Exception:
+            pass
+        _UNJOINED_TEST_THREADS.append((self, worker, thread))
+        return False
+
+    def _on_gcsim_optimizer_selected_finished(self, payload):
+        started = time.monotonic()
+        super()._on_gcsim_optimizer_selected_finished(payload)
+        if self.mode == "theory":
+            # Use the same normalized terminal verdict that the production UI
+            # accepted; stale/empty native success cannot become a gate success.
+            terminal = self.workspace._optimizer_theory_terminal_payload
+            if isinstance(terminal, dict):
+                self.payloads[-1] = copy.deepcopy(terminal)
+        self.output_render_elapsed_ms = round((time.monotonic() - started) * 1000)
+
+    def click_one_mode(self, mode: str, rotation: str, *, watchdog_ms: int):
+        if self._gcsim_browser_run_thread is not None:
+            raise AssertionError("MVP case harness permits exactly one optimizer click")
+        self.payloads.clear()
+        self.mode = mode
+        self.workspace.rotation_editor.setPlainText(rotation)
+        signal = getattr(self.workspace, f"optimizer_{mode}_requested")
+        signal.connect(lambda _index, text: self.submitted_rotation_texts.append(text))
+        button = getattr(self.workspace, f"optimizer_{mode}_button")
+        if not button.isEnabled():
+            raise AssertionError(f"The {mode} button is unavailable for the prepared fixture")
+        started = time.monotonic()
+        policy = button_mode_policy(mode)
+        settings = GcsimOptimizerSettings(
+            policy["set_group_limit"],
+            policy["builds_per_group"],
+            policy["fast_mode"],
+            policy["expanded_limits"],
+        )
+        with patch(
+            "ui.app_shell.effective_gcsim_optimizer_settings",
+            return_value=settings,
+        ):
+            self.button_click_started_at = time.monotonic()
+            button.click()
+            deadline = started + watchdog_ms / 1000
+            while not self.payloads or self._gcsim_browser_run_thread is not None:
+                _APP.processEvents()
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("real button worker exceeded its finite test watchdog")
+                time.sleep(0.005)
+        self.last_elapsed_ms = round((time.monotonic() - started) * 1000)
+        if len(self.payloads) != 1:
+            raise AssertionError(f"One click returned {len(self.payloads)} terminal payloads")
+        return self.payloads[0]
+
