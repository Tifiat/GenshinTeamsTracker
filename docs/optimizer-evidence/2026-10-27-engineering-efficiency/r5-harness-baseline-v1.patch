+                        if name == "ordinary_measurement"
+                        else (
+                            "status", "configured_call_limit", "attempted_engine_calls",
+                            "skipped_engine_calls", "selected_seed_count", "evidence_source",
+                        )
+                    )
+                    filtered[name] = {
+                        key: filtered[name][key]
+                        for key in allowed
+                        if key in filtered[name]
+                    }
+                    if name == "support_response" and "numeric_evidence" in raw.get(name, {}):
+                        filtered[name]["numeric_evidence"] = project_support_response(
+                            raw[name]["numeric_evidence"]
+                        )
+        result[section] = filtered
+    raw_progress = value.get("progress")
+    if isinstance(raw_progress, Mapping) and "progress" not in result:
+        result["progress"] = {"clock_kind": str(raw_progress.get("clock_kind") or "")[:120], "stages": {}}
+    return result
+
+
+def _compact_assignments(value: Any) -> list[dict[str, Any]]:
+    if not isinstance(value, list):
+        return []
+    output = []
+    for row in value[:20]:
+        if not isinstance(row, Mapping):
+            continue
+        item = {
+            key: row[key]
+            for key in ("wearer_key", "slot", "artifact_id", "set_uid")
+            if key in row and isinstance(row[key], (str, int))
+        }
+        main = row.get("main_stat")
+        if isinstance(main, Mapping):
+            item["main_stat"] = {
+                key: main[key]
+                for key in ("key", "value")
+                if key in main and isinstance(main[key], (str, int, float))
+            }
+        substats = row.get("substats")
+        if isinstance(substats, list):
+            item["substats"] = [
+                {
+                    key: substat[key]
+                    for key in ("key", "value")
+                    if key in substat and isinstance(substat[key], (str, int, float))
+                }
+                for substat in substats[:4]
+                if isinstance(substat, Mapping)
+            ]
+        output.append(item)
+    return output
+
+
+def _compact_packages(value: Any) -> list[dict[str, Any]]:
+    if not isinstance(value, list):
+        return []
+    return [
+        {
+            "wearer_key": package.get("wearer_key") if isinstance(package.get("wearer_key"), str) else "",
+            "sets": [
+                {
+                    key: set_row[key]
+                    for key in ("set_uid", "count")
+                    if key in set_row and isinstance(set_row[key], (str, int))
+                }
+                for set_row in package.get("sets", ())[:4]
+                if isinstance(set_row, Mapping)
+            ],
+        }
+        for package in value[:4]
+        if isinstance(package, Mapping)
+    ]
+
+
+def _compact_theory_codes(value: list[Any]) -> list[str]:
+    # Keep every small public diagnostic, including repeated reasons. Reject
+    # path/config-like payloads rather than truncating them into apparent codes.
+    return [
+        code for code in value
+        if isinstance(code, str) and 0 < len(code) <= 600
+        and all(character.isascii() and (character.isalnum() or character in "_:.=+,-[]()") for character in code)
+    ]
+
+
+def _compact_theory_witness(value: Mapping[str, Any]) -> dict[str, Any]:
+    result = {}
+    for key in ("Mains", "Lines", "Upgrades"):
+        actors = value.get(key)
+        if not isinstance(actors, list):
+            continue
+        result[key] = [
+            [
+                slot if isinstance(slot, str) else [
+                    number for number in slot[:4]
+                    if type(number) is int or (key == "Upgrades" and type(number) is float)
+                ]
+                for slot in actor[:5]
+                if (key == "Mains" and isinstance(slot, str)) or (key != "Mains" and isinstance(slot, list))
+            ]
+            for actor in actors[:4]
+            if isinstance(actor, list)
+        ]
+    return result
+
+
+def _compact_theory_measurement(value: Mapping[str, Any]) -> dict[str, Any]:
+    result = {
+        key: value[key]
+        for key in (
+            "candidate_sha256", "frame_sha256", "config_sha256", "engine_result_sha256",
+            "engine_artifact_sha256", "source_manifest_sha256", "formula_dps",
+            "measured_dps", "standard_deviation", "standard_error", "iterations",
+            "ignore_burst_energy",
+        )
+        if key in value and (isinstance(value[key], (str, int, float, bool)) or value[key] is None)
+    }
+    identity = value.get("build_identity")
+    if isinstance(identity, Mapping):
+        result["build_identity"] = {
+            **({"kind": identity["kind"]} if isinstance(identity.get("kind"), str) else {}),
+            **({"packages": _compact_packages(identity["packages"])} if isinstance(identity.get("packages"), list) else {}),
+            **({"witness45": _compact_theory_witness(identity["witness45"])} if isinstance(identity.get("witness45"), Mapping) else {}),
+        }
+    origins = value.get("origins")
+    if isinstance(origins, list):
+        result["origins"] = [
+            {
+                **{
+                    key: origin[key]
+                    for key in ("kind", "phase", "family", "context_sha256")
+                    if isinstance(origin.get(key), str)
+                },
+                **({"diagnostic_codes": _compact_theory_codes(origin["diagnostic_codes"])}
+                   if isinstance(origin.get("diagnostic_codes"), list) else {}),
+            }
+            for origin in origins
+            if isinstance(origin, Mapping)
+        ]
+    return result
+
+
+def _compact_theory_family(value: Mapping[str, Any]) -> dict[str, Any]:
+    result = {
+        key: value[key]
+        for key in ("family", "formula_dps", "deficit_percent", "refinement_level", "reason")
+        if key in value and isinstance(value[key], (str, int, float, bool))
+    }
+    measurement = value.get("measurement")
+    if isinstance(measurement, Mapping):
+        result["measurement"] = _compact_theory_measurement(measurement)
+    aliases = value.get("aliases")
+    if isinstance(aliases, list):
+        result["aliases"] = [
+            {
+                **{
+                    key: alias[key]
+                    for key in ("tuple_key", "context_sha256")
+                    if key in alias and isinstance(alias[key], str)
+                },
+                **({"uncertainty": _compact_theory_codes(alias["uncertainty"])}
+                   if isinstance(alias.get("uncertainty"), list) else {}),
+                **({"packages": _compact_packages(alias["packages"])}
+                   if isinstance(alias.get("packages"), list) else {}),
+            }
+            for alias in aliases
+            if isinstance(alias, Mapping)
+        ]
+    allocations = value.get("allocations")
+    if isinstance(allocations, list):
+        result["allocations"] = [
+            {
+                "wearer_key": allocation.get("wearer_key") if isinstance(allocation.get("wearer_key"), str) else "",
+                "main_stats": {
+                    str(slot)[:24]: str(stat)[:80]
+                    for slot, stat in list((allocation.get("main_stats") or {}).items())[:5]
+                } if isinstance(allocation.get("main_stats"), Mapping) else {},
+                "substats": [
+                    {
+                        key: stat[key]
+                        for key in ("stat_key", "roll_units", "stat_value")
+                        if key in stat and isinstance(stat[key], (str, int, float))
+                    }
+                    for stat in allocation.get("substats", ())[:10]
+                    if isinstance(stat, Mapping)
+                ],
+                **{
+                    key: allocation[key]
+                    for key in ("spent_roll_units", "unspent_roll_units")
+                    if key in allocation and isinstance(allocation[key], (int, float))
+                },
+            }
+            for allocation in allocations[:4]
+            if isinstance(allocation, Mapping)
+        ]
+    witness = value.get("witness45")
+    if isinstance(witness, Mapping):
+        result["witness45"] = _compact_theory_witness(witness)
+    return result
+
+
+def _compact_theory_snapshot(value: Mapping[str, Any], *, include_rows: bool = False) -> dict[str, Any]:
+    scalar_fields = (
+        "snapshot_version", "publication_version", "phase", "status", "response_status",
+        "reference_score", "practical_band_percent", "sensitivity_band_percent",
+        "found_group_families", "found_group_tuples", "sensitivity_group_families",
+        "sensitivity_group_tuples", "total_found_families", "total_found_tuples",
+        "domain_tuples", "unseen_tuples", "full_cartesian_covered", "unavailable_count",
+    )
+    result = {
+        key: value[key]
+        for key in scalar_fields
+        if key in value and isinstance(value[key], (str, int, float, bool))
+    }
+    if type(value.get("finished_early")) is bool:
+        result["finished_early"] = value["finished_early"]
+    verification = value.get("verification")
+    if isinstance(verification, Mapping):
+        fields = (
+            "policy_id", "limit", "iterations", "attempted_count", "completed_count",
+            "failed_count", "energy_rejected_count", "candidate_count", "unverified_count",
+            "omitted_count", "remaining_budget", "in_progress", "response_lane_reserve",
+            "response_lane_attempted_count",
+        )
+        result["verification"] = {
+            key: verification[key]
+            for key in fields
+            if key in verification and isinstance(verification[key], (str, int, float, bool))
+        }
+    support = value.get("support_stats")
+    if isinstance(support, Mapping):
+        result["support_stats"] = {
+            key: support[key]
+            for key in (
+                "producer_status", "response_lane_reserve", "response_lane_attempted_count",
+                "response_lane_count_semantics",
+            )
+            if key in support and isinstance(support[key], (str, int, float, bool))
+        }
+    retention = value.get("verified_row_retention")
+    if isinstance(retention, Mapping):
+        compact_retention = {
+            key: retention[key]
+            for key in (
+                "limit", "source_count", "verified_source_count", "unverified_source_count",
+                "retained_count", "omitted_count", "verified_count_matches_publication", "status",
+            )
+            if key in retention and (isinstance(retention[key], (str, int, bool)) or retention[key] is None)
+        }
+        sections = retention.get("sections")
+        if isinstance(sections, Mapping):
+            compact_retention["sections"] = {
+                section: {
+                    key: row[key]
+                    for key in (
+                        "source_count", "verified_source_count", "unverified_source_count",
+                        "retained_count", "omitted_count", "status",
+                    )
+                    if key in row and (isinstance(row[key], (str, int, bool)) or row[key] is None)
+                }
+                for section, row in sections.items()
+                if section in {"co_leaders", "pending"} and isinstance(row, Mapping)
+            }
+        result["verified_row_retention"] = compact_retention
+    if include_rows and isinstance(value.get("theory_families"), Mapping):
+        result["theory_families"] = {
+            section: [
+                _compact_theory_family(row)
+                for row in rows[:7]
+                if isinstance(row, Mapping)
+            ]
+            for section, rows in value["theory_families"].items()
+            if section in {"co_leaders", "pending"} and isinstance(rows, list)
+        }
+    elapsed = value.get("elapsed_ms_from_button_click")
+    if type(elapsed) is int and elapsed >= 0:
+        result["elapsed_ms_from_button_click"] = elapsed
+    return result
+
