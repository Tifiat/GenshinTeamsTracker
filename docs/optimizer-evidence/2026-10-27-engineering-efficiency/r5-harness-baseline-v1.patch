+"""Validate owned mechanic deltas over the accepted runtime source closure.
+
+This helper never builds the dirty checkout or installs either runtime. Existing
+managed scratch owns generated sources, Go cache and output; small logs and the
+source map are exported before its cleanup.
+"""
+from __future__ import annotations
+
