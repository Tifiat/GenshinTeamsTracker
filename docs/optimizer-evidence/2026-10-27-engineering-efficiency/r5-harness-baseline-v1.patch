+def collect_unit_jsonl(raw, expected, authored):
+    """Reassemble by Package/Test, just like the reviewed v2 scalar collector."""
+    gate.require(type(raw) is bytes and 0 < len(raw) <= LIMITS["log_bytes_each"], "unit_output_size_invalid")
+    runs, passes, package_starts, package_passes, streams, errors = [], [], [], [], {}, []
+    for line in raw.splitlines():
+        try:
+            event = json.loads(line)
+            gate.require(type(event) is dict, "unit_event_invalid")
+            action, name, package = event.get("Action"), event.get("Test"), event.get("Package", "")
+            if name is not None:
+                gate.require(type(name) is str and re.fullmatch("[A-Za-z0-9_./=+-]{1,200}", name)
+                    and name.split("/", 1)[0] in expected, "unit_name_unexpected")
+                if action == "run": runs.append(name)
+                if action == "pass": passes.append(name)
+            elif action == "start": package_starts.append(package)
+            elif action == "pass": package_passes.append(package)
+            if action in {"fail", "skip", "build-fail"}: errors.append("unit_failed_or_skipped")
+            if type(event.get("Output")) is str:
+                key = (package, name); streams[key] = streams.get(key, "") + event["Output"]
+        except Exception:
+            errors.append("unit_event_invalid")
+    package_names = {"genshinteamstracker/native/gcsim_optimizer/internal/" + name for name in ("formula", "allsets")}
+    complete = (len(runs) == len(set(runs)) and sorted(runs) == sorted(passes)
+        and {name for name in runs if "/" not in name} == expected
+        and len(package_starts) == len(package_passes) == 2
+        and set(package_starts) == set(package_passes) == package_names)
+    reasons = sorted(reason for reason in authored if any(reason in text for text in streams.values()))
+    return {"accepted": complete and not errors and not reasons, "errors": sorted(set(errors)),
+        "test_runs": len(runs), "test_passes": len(passes), "named_runs": sorted(runs), "named_passes": sorted(passes),
