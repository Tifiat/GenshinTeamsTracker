+def _child_log_evidence(path: Path, *, receipt_missing: bool) -> dict[str, Any]:
+    """Retain hashes and fixed classifications, never private child output."""
+    evidence: dict[str, Any] = {}
+    if receipt_missing:
+        evidence["child_bootstrap_status"] = "unknown"
+    if not path.is_file():
+        return evidence
+    evidence["child_log_bytes"] = path.stat().st_size
+    evidence["child_log_sha256"] = _sha256_file(path)
+    if receipt_missing:
+        with path.open("rb") as stream:
+            prefix = stream.read(64 * 1024)
+        missing_qt = (
+            b"ModuleNotFoundError: No module named 'PySide6'",
+            b'ModuleNotFoundError: No module named "PySide6"',
+            b"ModuleNotFoundError: No module named 'PySide6.QtCore'",
+            b'ModuleNotFoundError: No module named "PySide6.QtCore"',
+        )
+        if any(marker in prefix for marker in missing_qt):
+            evidence["child_bootstrap_status"] = "pyside6_import_unavailable"
+    return evidence
+
