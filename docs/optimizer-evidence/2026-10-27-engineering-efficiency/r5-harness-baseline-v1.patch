+    if protocol.get("schema_kind") != "gtt_chevreuse_render_diagnostic_protocol_v2":
+        raise DiagnosticError("unsupported protocol schema")
+    if protocol.get("case_id") != CASE_ID or not isinstance(protocol.get("lease_id"), str) or not protocol["lease_id"].strip():
+        raise DiagnosticError("protocol case or lease is invalid")
+    if protocol.get("baseline_render_sha256") != render_diagnostic.PINS["baseline_render_sha256"]:
+        raise DiagnosticError("protocol retained n=500 baseline pin mismatch")
+    if protocol.get("call_order") != [{"build": build, "seed": seed} for build, seed in CALL_ORDER]:
+        raise DiagnosticError("protocol must authorize the exact four-call order")
+    if protocol.get("baseline_iterations") != 500 or protocol.get("diagnostic_iterations") != 1 or protocol.get("diagnostic_workers") != 1:
+        raise DiagnosticError("protocol n=500 baseline or 1x1 diagnostic budget drifted")
+    if protocol.get("timeouts_seconds") != {
+        "build": BUILD_TIMEOUT_SECONDS,
+        "helper": HELPER_TIMEOUT_SECONDS,
+        "outer": OUTER_TIMEOUT_SECONDS,
+    }:
+        raise DiagnosticError("protocol timeouts differ from fixed runner limits")
+    if protocol.get("receipt_path") != RECEIPT_PATH.relative_to(ROOT).as_posix():
+        raise DiagnosticError("protocol receipt path is not the fixed evidence receipt")
+
+    pins = protocol.get("pins")
+    if not isinstance(pins, dict):
+        raise DiagnosticError("protocol pins are missing")
+    required = {
+        "native_source_closure_sha256": NATIVE_CLOSURE_SHA256,
+        "native_source_manifest_sha256": NATIVE_MANIFEST_SHA256,
+        "native_source_file_count": NATIVE_FILE_COUNT,
+        "go_executable_sha256": GO_SHA256,
+        "retained_result_sha256": _sha256_file(RETAINED_RESULT),
+        "render_candidate_sha256": _sha256_file(HELPER_SOURCE),
+        **PROTECTED_RUNTIME_PINS,
+    }
+    for key, actual in required.items():
+        if pins.get(key) != actual:
+            raise DiagnosticError(f"protocol pin mismatch: {key}")
+    source_paths = protocol.get("source_paths")
+    if not isinstance(source_paths, dict):
+        raise DiagnosticError("protocol source pins are missing")
+    for name, relative in source_paths.items():
+        if not isinstance(name, str) or not isinstance(relative, str):
+            raise DiagnosticError("protocol source pin entry is invalid")
+        source = _inside(ROOT / relative, ROOT)
+        if pins.get(name) != _sha256_file(source):
+            raise DiagnosticError(f"protocol source pin mismatch: {name}")
+    return protocol
+
