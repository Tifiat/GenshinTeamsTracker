+                or type(row.get("measured_dps")) not in (int, float)
+                or not math.isfinite(row["measured_dps"])
+                or type(row.get("standard_error")) not in (int, float)
+                or not math.isfinite(row["standard_error"])):
+            raise ValueError("unified_tighnari_quality_row_missing")
+    for name in ("product_verification_best", "candidate_raw_search_best", "candidate_anchors_best"):
+        if quality.get(name) is None:
+            raise ValueError("unified_tighnari_best_missing")
+    if (quality["same_config_same_batch"]
+            and quality.get("descriptive_independent_normal_interval_raw_search_best") is not None):
+        raise ValueError("unified_tighnari_same_batch_interval_invalid")
+    record["tighnari_quality"] = {"result_sha256": k.sha(raw), "product_cohort": 9,
+                                  "candidate_raw": 9, "candidate_anchors": len(anchors),
+                                  "union_unique_configs": union, "ordinary_calls": union,
+                                  "ordinary_seconds": quality.get("ordinary_seconds"),
+                                  "same_config_same_batch": quality.get("same_config_same_batch"),
+                                  "cross_entrypoint_speed_claim": False}
+    return quality
