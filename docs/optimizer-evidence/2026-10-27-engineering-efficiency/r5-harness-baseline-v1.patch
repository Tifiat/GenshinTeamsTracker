+
+def early_preparation_admission_overlay() -> dict[str, Any]:
+    """Compose the exact matched V2 image with the opt-in early heuristic."""
+    base = matched.matched_overlay()
+    images = dict(base["images"])
+    overlay_files = dict(base["overlay_files"])
+    coordinator_path = "internal/allsets/neutral_coordinator.go"
+    before = images[coordinator_path]
+    changed, erased = _coordinator_image(before)
+    if erased != before:
+        raise ValueError("early preparation source erasure differs from exact matched V2")
+    images[coordinator_path] = changed
+    helper_path = "internal/allsets/zz_early_preparation_admission_test.go"
+    overlay_files[helper_path] = HELPER.read_bytes()
+
+    hashes = dict(base["hashes"])
+    hashes.update({
+        "early_preparation_admission_factory_sha256": _sha(Path(__file__).read_bytes()),
+        "early_preparation_admission_helper_sha256": _sha(HELPER.read_bytes()),
+        "early_preparation_admission_predecessor_coordinator_sha256": _sha(before),
+        "early_preparation_admission_coordinator_sha256": _sha(changed),
+        "early_preparation_admission_coordinator_erasure_sha256": _sha(erased),
+        "early_preparation_admission_source_map_sha256": k.gate.digest({path: _sha(raw) for path, raw in images.items()}),
+        "early_preparation_admission_overlay_sha256": k.gate.digest({path: _sha(raw) for path, raw in overlay_files.items()}),
+    })
+    metadata = {
+        "predecessor_provenance": base["metadata"],
+        "schema": "early_preparation_admission_v1",
+        "contract_names": list(CONTRACT_NAMES),
+        "algorithm_scope": "per-block current-team preparation admission before Prepare; no model/evaluator bound",
+        "selector": "membership: mandatory none/2p/4p/current/reservation failures; top ceil(N2+2/4), best ranked representative per set UID, then unconditional ceil(N2+2/8) rank-tail midpoints; admitted packages are prepared in original feasible-catalog order",
+        "no_gain_behavior": "prepare the entire remaining feasible catalog in original catalog order",
+        "gain_behavior": "unprepared tail rows remain early_preparation_heuristic_deferred with unknown exact outcome",
+        "ranking": "one fresh rawPriorities gradient and ArtifactLinearPriorities map per actor/block; finite PackagePriority values, descending then stable package key",
+        "timing_fields": "selector_seconds total plus disjoint raw_priority_seconds, artifact_linear_priority_seconds, and package_priority_dp_seconds",
+        "candidate_catalog": "full feasible catalog is retained; no dominated/unavailable claim; rerank on each new actor/block/cycle anchor",
+        "zero_control": "flag disabled returns exact original feasible order and performs no selector calls",
+        "ledger_file": "early-preparation-admission.jsonl",
+        "ledger_max_bytes": 16777216,
+        "source_erasure_to_exact_matched_v2": True,
+    }
+    source_files = tuple(dict.fromkeys((*base["source_files"], Path(__file__), HELPER)))
+    return {
+        **base,
+        "images": images,
+        "overlay_files": overlay_files,
+        "hashes": hashes,
+        "metadata": metadata,
+        "source_files": source_files,
+    }
