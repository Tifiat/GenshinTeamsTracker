+
+def _reconstruct_native_map(baseline: dict, priority: dict, archive: dict) -> dict[str, str]:
+    expected = dict(baseline["source_sha256"])
+    if len(expected) != 343 or _canonical_digest(expected) != EXPECTED_NATIVE_BASE:
+        raise ValueError("baseline_343_map_mismatch")
+    closure = priority["native_closure"]
+    for change in closure["modified"] + closure["added"]:
+        relative = Path(change["path"]).relative_to("native/gcsim_optimizer").as_posix()
+        if expected.get(relative) != change.get("before_sha256"):
+            raise ValueError("priority_preimage_mismatch")
+        expected[relative] = change["sha256"]
+    if len(expected) != 344 or _canonical_digest(expected) != PRIORITY_MAP_SHA256:
+        raise ValueError("priority_344_map_mismatch")
+    for change in archive["projected_delta"]["changes"]:
+        relative = Path(change["path"]).relative_to("native/gcsim_optimizer").as_posix()
+        if expected.get(relative) != change["before_sha256"]:
+            raise ValueError("archive_preimage_mismatch")
+        expected[relative] = change["after_sha256"]
+    if len(expected) != 345 or _canonical_digest(expected) != NATIVE_MAP_SHA256:
+        raise ValueError("archive_345_map_mismatch")
+    return expected
+
+
+def _native_snapshot() -> dict[str, Any]:
+    baseline = _read_json(ROOT / BASELINE_CLOSURE_REL)
+    priority = _read_json(ROOT / PRIORITY_RECIPE_REL)
+    archive = _read_json(ROOT / RECIPE_REL)
+    expected = _reconstruct_native_map(baseline, priority, archive)
+    actual = _native_source_map()
+    if actual != expected:
+        raise ValueError("actual_native_map_differs_from_reviewed_345_map")
+    for change in archive["projected_delta"]["changes"]:
+        if (ROOT / change["path"]).stat().st_size != change["after_bytes"]:
+            raise ValueError("archive_afterimage_size_mismatch")
+    return {"file_count": len(actual), "source_map_sha256": _canonical_digest(actual)}
+
+
+def _tool_pins() -> dict[str, str]:
+    # Copy the frozen import's pins; never mutate its globals or use its preflight.
+    expected = {**PINNED_FILES, **EXTRA_PINS}
