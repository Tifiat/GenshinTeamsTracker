+def run_four_regressions(job: Path, command, engine: Path, binary: Path,
+                         record: dict, save, export):
+    """Run the four prespecified cases under the same owned candidate binary."""
+    del engine  # The case preparer derives the engine root from each frozen binding.
+    cases = job / "cases"
+    cases.mkdir()
+    bindings = {"control": job / "control/engine-binding.json",
+                "candidate": job / "candidate/engine-binding.json"}
+    consumer = k.NATIVE / "gtt-optimizer.exe"
+    for case_key in ("chasca", "navia", "burgeon", "overload"):
+        case_started = time.monotonic()
+        deadline = case_started + LIMITS[case_key + "_seconds"]
+        case = cases / case_key
+        result = {"mode": "all_sets" if case_key == "chasca" else "selected",
+                  "entrypoint_control": "installed_product_cli" if case_key == "chasca" else "installed_selected_session",
+                  "entrypoint_candidate": "research_go_test_harness" if case_key == "chasca" else "installed_selected_session",
+                  "cross_entrypoint_speed_claim": False, "global_optimum_proved": False,
+                  "no_loss_proved": False}
+        record.setdefault("regressions", {})[case_key] = result
+        save()
+        for arm in ("control", "candidate"):
+            command([sys.executable, "-B", CASE_HELPER, "--job", job, "--case", case_key,
+                     "--stage", "prepare", "--arm", arm, "--binding", bindings[arm]],
+                    case_key + "-prepare-" + arm, 120, job, deadline=deadline)
+        fixture = json.loads(bounded(case / "fixture-receipt.json"))
+        if fixture.get("schema") != "health_unified_fixture_v1" or fixture.get("case_key") != case_key:
+            raise ValueError("unified_fixture_receipt_invalid")
+        result["fixture_receipt_sha256"] = k.sha(bounded(case / "fixture-receipt.json"))
+        for arm in ("control", "candidate"):
+            request = json.loads(bounded(case / arm / "request.json"))
+            binding = json.loads(bounded(bindings[arm]))
+            if request.get("engine") != binding:
+                raise ValueError("unified_case_engine_binding_invalid")
+            (case / arm / "rule-cache").mkdir()
+            result[arm + "_request_sha256"] = k.sha(bounded(case / arm / "request.json"))
+            result[arm + "_set_sources_sha256"] = k.sha(bounded(case / arm / "set-sources.json"))
+        if case_key == "chasca":
+            control = case / "control"
+            candidate = case / "candidate"
+            command([consumer, "validate-request", control / "request.json"],
+                    "chasca-control-validate", 30, job,
+                    {"GTT_RULE_CACHE_DIR": str(control / "rule-cache")}, deadline)
+            command([consumer, "optimize-all-sets", control / "request.json", control / "set-sources.json",
+                     control / "verification"], "chasca-control", 600, job,
+                    {"GTT_RULE_CACHE_DIR": str(control / "rule-cache")}, deadline)
+            product = json.loads(bounded(control / "verification/all-sets-result.json"))
+            search = product.get("search_config")
+            if product.get("mode") != "all_sets" or not isinstance(search, dict):
+                raise ValueError("unified_chasca_control_mode_invalid")
+            if (search.get("Search", {}).get("FirstFrontierWidth") != 32
+                    or search.get("Search", {}).get("RecheckFrontierWidth") != 8):
+                raise ValueError("unified_chasca_product_search_config_changed")
+            result["control"] = {"search_seconds": product.get("search_seconds"),
+                                  "source_preparation_seconds": product.get("source_preparation_seconds"),
+                                  "whole_headless_seconds": product.get("total_elapsed_ms", 0) / 1000,
+                                  "command_wall_seconds": record["commands"]["chasca-control"]["wall_seconds"],
+                                  "verification_cohort_count": len(product.get("verification", {}).get("candidates", [])),
+                                  "result_sha256": k.sha(bounded(control / "verification/all-sets-result.json"))}
+            with (candidate / "search-config.json").open("xb") as stream:
+                stream.write(k.gate.canonical({"search_config": search}))
+            request = json.loads(bounded(candidate / "request.json"))
+            seeds = request.get("stochastic", {}).get("seeds")
+            if not isinstance(seeds, list) or len(seeds) != 2 or len(set(seeds)) != 2:
+                raise ValueError("unified_chasca_seed_contract_invalid")
+            manifest = {"schema": "health_unified_case_inputs_v1", "case_key": "chasca", "mode": "all_sets",
+                        "inventory_artifacts": 600, "search_width": 32, "search_recheck_width": 8, "seeds": seeds,
+                        "control_request_sha256": result["control_request_sha256"],
+                        "control_set_sources_sha256": result["control_set_sources_sha256"],
+                        "control_result_sha256": result["control"]["result_sha256"],
+                        "candidate_request_sha256": result["candidate_request_sha256"],
+                        "candidate_set_sources_sha256": result["candidate_set_sources_sha256"],
+                        "search_config_sha256": k.sha(bounded(candidate / "search-config.json")),
+                        "fixture_receipt_sha256": result["fixture_receipt_sha256"],
+                        "control_engine_binding_sha256": json.loads(bounded(bindings["control"]))["binding_sha256"],
+                        "candidate_engine_binding_sha256": json.loads(bounded(bindings["candidate"]))["binding_sha256"]}
+            with (candidate / "input-manifest.json").open("xb") as stream:
+                stream.write(k.gate.canonical(manifest))
+            save()
+            export()  # Preserve the fresh product Chasca arm before the research arm.
+            command([binary, "-test.run=^TestHealthUnifiedChascaReplay$", "-test.v", "-test.parallel=1",
+                     "-test.timeout=520s"], "chasca-candidate", 540, job,
+                    {"GTT_HEALTH_UNIFIED_DIR": str(job), "GTT_HEALTH_UNIFIED_PHASE": "chasca-replay",
+                     "GTT_RULE_CACHE_DIR": str(candidate / "rule-cache")}, deadline)
+            complete.prior.retained.local_pair._verify_named_tests(bounded(job / "chasca-candidate.log").decode(),
+                                                                  ["TestHealthUnifiedChascaReplay"])
+            projection = json.loads(bounded(candidate / "candidate-projection.json"))
