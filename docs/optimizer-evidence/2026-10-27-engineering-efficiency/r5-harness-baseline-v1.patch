+"""Source-only whole-search damped preparation layered on the reviewed P arm.
+
+The primary formula anchor, 16-proposal selector and paired ordinary-feedback
+policy come from the existing formula-primary factory. This factory inserts
+the accepted B4 damped candidateRun immediately after each successful screen
+and before that package enters the unchanged selector. It never builds or runs
+Go itself.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_damped_relinearize_b4 as damped_b4
+from tools.experiments.gcsim.mvp_polish import adaptive_formula_primary as primary
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+ROOT = k.ROOT
+EVIDENCE = k.EVIDENCE
+ALLSETS_HELPER = Path(__file__).with_name("adaptive_damped_whole_test.go")
+RELINEARIZE_SEARCH = damped_b4.relinearize.SEARCH_SOURCE
+DAMPED_SEARCH = damped_b4.SEARCH_SOURCE
+
+SOURCE_FILES: tuple[Path, ...] = tuple(dict.fromkeys((
+    *primary.SOURCE_FILES,
+    *damped_b4.SOURCE_FILES,
+    Path(__file__),
+    ALLSETS_HELPER,
+)))
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _once(source: str, before: str, after: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"expected exactly one accepted P-source seam: {before!r}")
+    return source.replace(before, after, 1)
+
+
+def _replace_region(source: str, start: str, end: str, replacement: str) -> str:
+    if source.count(start) != 1:
+        raise ValueError(f"expected one accepted coordinator closure: {start!r}")
+    offset = source.index(start)
+    finish = source.find(end, offset)
+    if finish < 0:
+        raise ValueError(f"missing accepted coordinator closure end: {end!r}")
+    return source[:offset] + replacement + source[finish:]
+
+
+def _prepare_closure(source: str) -> str:
+    start = "prepare := func(anchor Candidate, actor int, pack domain.Package) (Candidate, bool, error) {"
+    end = "\n\trecord := func(c Candidate"
+    offset = source.index(start)
+    finish = source.find(end, offset)
+    if finish < 0:
+        raise ValueError("missing P package preparation closure boundary")
+    prepare = source[offset:finish]
+    prepare = _once(
+        prepare,
+        "solver, e := solverFor(c)",
+        "solverSetupStarted := time.Now()\n"
+        "\t\tsolver, e := solverFor(c)\n"
+        "\t\tsolverSetupSeconds := time.Since(solverSetupStarted).Seconds()",
+    )
+    prepare = _once(
+        prepare,
+        "\t\treturn c, true, nil",
+        "\t\tremaining := cfg.MaxSearchExpansions - out.SearchExpansions\n"
+        "\t\tif remaining < 0 { remaining = 0 }\n"
+        "\t\tallowance := min(remaining, cfg.Search.MaxExpandedPerActor)\n"
+        "\t\tblock := 0\n"
+        "\t\tif researchHybrid != nil { block = researchHybrid.block }\n"
+        "\t\tdampedCandidate, dampedStep, dampedErr := researchDampedWholePrepare(\n"
+        "\t\t\trunCtx, c, solver, actor, pack, block, screen, solverSetupSeconds, allowance, p.Coordinates(),\n"
+        "\t\t)\n"
+        "\t\tout.SearchExpansions += dampedStep.Expanded\n"
+        "\t\tif dampedErr != nil { return dampedCandidate, false, dampedErr }\n"
+        "\t\treturn dampedCandidate, true, nil",
+    )
+    return prepare
+
+
+def _coordinator_image(source: bytes) -> bytes:
+    text = source.decode("utf-8")
+    prepare = _prepare_closure(text)
+    return _replace_region(
+        text,
+        "prepare := func(anchor Candidate, actor int, pack domain.Package) (Candidate, bool, error) {",
+        "\n\trecord := func(c Candidate",
+        prepare,
+    ).encode("utf-8")
+
+
+def _replay_helper_image(source: bytes) -> bytes:
+    text = source.decode("utf-8")
+    text = _once(
+        text,
+        'if role == "candidate" { researchHybrid,err = newAdaptiveHybridPolicy(req,base,job); check(err,"adaptive_policy_binding_failed") } else { researchHybrid=nil }',
+        'if role == "candidate" {\n'
+        '\t\tresearchHybrid,err = newAdaptiveHybridPolicy(req,base,job); check(err,"adaptive_policy_binding_failed")\n'
+        '\t\tresearchDampedWhole,err = newAdaptiveDampedWholeState(job); check(err,"damped_whole_binding_failed")\n'
+        '\t} else { researchHybrid=nil; researchDampedWhole=nil }',
+    )
+    text = _once(
+        text,
+        'payload["policy"] = researchFormulaPrimaryPolicySummary()\n'
+        '    if runErr==nil && ctx.Err()==nil {\n'
+        '      verified,verifyErr:=adaptiveVerify(t,ctx,req,base,result,job,role)\n'
+        '      payload["verification"]=verified',
+        'payload["policy"] = researchFormulaPrimaryPolicySummary()\n'
+        '    dampedSummary,dampedSummaryErr:=researchDampedWholeSummary()\n'
+        '    payload["damped_screening"]=dampedSummary\n'
+        '    if dampedSummaryErr!=nil { payload["damped_screening_error"]=dampedSummaryErr.Error(); payload["complete"]=false; if runErr==nil {runErr=dampedSummaryErr} }\n'
+        '    if runErr==nil && ctx.Err()==nil {\n'
+        '      verifyStarted:=time.Now()\n'
