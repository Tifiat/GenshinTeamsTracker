+    old_pointer = store.active_state_path.read_bytes()
+    if (store.active_engine_id() != OLD_ENGINE_ID
+            or sync._digest(consumer) != OLD_CONSUMER_SHA256):
+        raise ValueError("unified_uptake_old_runtime_changed")
