+        "tools/experiments/gcsim/chasca_regression/fixture.py",
+        "tools/experiments/gcsim/chasca_regression/spec.json",
+        "tools/experiments/gcsim/mode_matrix/archetype_manifest_v1.json",
+        "run_workspace/gcsim/optimizer_go_contracts.py",
+        "run_workspace/gcsim/optimizer_engine_context.py",
+        "run_workspace/gcsim/optimizer_go_inputs.py",
+        "run_workspace/gcsim/optimizer_go_requests.py",
+        "run_workspace/gcsim/optimizer_go_selected.py"))
+    source_files.extend(scope.ROOT / relative for relative in (
+        "run_workspace/gcsim/optimizer_config.py",
+        "run_workspace/gcsim/config_structure.py",
+        "run_workspace/gcsim/artifact_investment_rules.py",
+        "run_workspace/gcsim/artifact_runner.py",
+        "run_workspace/gcsim/engine_store.py",
+        "run_workspace/gcsim/runtime_probe.py",
+        "run_workspace/gcsim/shipped_artifact.py",
+        "run_workspace/profile_context.py"))
+    source_files.append(cases.NAVIA_REQUEST)
+    for case_id in ("burgeon_thoma", "overload_chevreuse"):
+        source_files.append(case_data.load_case(case_id).rotation_path)
+    pinned = {path.relative_to(scope.ROOT).as_posix(): scope.sha(scope.bounded(path))
+              for path in source_files}
+    saved_replay = scope.EVIDENCE / "health-unified-uptake-v7-candidate-preservation-saved-union.json"
+    saved_replay_sha = scope.sha(scope.bounded(saved_replay, 1 << 20))
+    if saved_replay_sha != "9a58ee9c48cefb119e2fb69789726b854f4a63588e63a1288038c97106fdd7e5":
+        raise ValueError("preservation_saved_replay_changed")
+    return {"schema": "candidate_preservation_source_plan_v1",
+            "accepted_v7": scope.frozen_receipts(),
+            "accepted_361_image_map_sha256": scope.sha(cases.canonical({
+                name: scope.sha(raw) for name, raw in sorted(base.items())})),
+            "candidate_image_map_sha256": scope.sha(cases.canonical({
+                name: scope.sha(raw) for name, raw in sorted(images.items())})),
+            "candidate_images": len(images), "delta_hashes": dict(sorted(delta_hashes.items())),
+            "policy_sha256": policy_sha256, "saved_replay_sha256": saved_replay_sha,
+            "python_source_pins": pinned,
+            "installed_consumer_sha256": scope.CONSUMER_SHA,
+            "fixed_engine_artifact_sha256": scope.ENGINE_SHA}
