+def source_pins():
+    paths = (Path(__file__), Path(__file__).with_name("test_adaptive_precap_b4_staging.py"),
+             Path(__file__).with_name("adaptive_precap_b4_run.py"),
+             Path(__file__).with_name("test_adaptive_precap_b4_export.py"),
+             Path(producer.__file__), *producer.SOURCE_FILES,
+             Path(previous.__file__), Path(k.__file__), k.old.HELPER,
+             k.EVIDENCE / "TIGHNARI20_SCALAR_ACCEPTED_CONSUMER_BUILD.json",
+             k.EVIDENCE / "adaptive-formula-primary-result.json",
+             k.EVIDENCE / "adaptive-formula-primary-freeze.json",
+             k.EVIDENCE / "adaptive-no-feedback-result.json",
+             k.EVIDENCE / "adaptive-no-feedback-freeze.json",
+             k.EVIDENCE / "adaptive-no-feedback-candidate-projection.json.gz",
+             k.EVIDENCE / "adaptive-precap-b4-preflight-blocked.json",
+             k.EVIDENCE / "adaptive-precap-b4-result.json",
+             k.EVIDENCE / "adaptive-precap-b4-freeze-v2.json",
+             k.EVIDENCE / "adaptive-precap-b4-failed-build-closeout.json",
+             *sorted(k.EVIDENCE.glob("adaptive-precap-b4-precap-b4-*.gz")),
+             *sorted((k.EVIDENCE / "adaptive-precap-b4-preimages").glob("*.txt")),
+             k.RUN / "request.json", k.RUN / "set-sources.json")
+    return {p.relative_to(k.ROOT).as_posix(): k.sha(p.read_bytes()) for p in paths}
+
+
+def _go_package(raw):
+    match = re.search(rb"(?m)^package\s+([A-Za-z_][A-Za-z0-9_]*)\b", raw)
+    if match is None:
+        raise ValueError("replacement has no Go package declaration")
+    return match.group(1).decode("ascii")
+
+
+def verify_staged_overlay(overlay_path, expected):
+    """Read the serialized mapping and every backing file before compilation."""
+    serialized = overlay_path.read_bytes()
+    document = json.loads(serialized)
+    if not isinstance(document, dict) or set(document) != {"Replace"}:
+        raise ValueError("serialized overlay schema changed")
+    replacements = document["Replace"]
+    if not isinstance(replacements, dict) or set(replacements) != set(expected):
+        raise ValueError("serialized replacement targets differ from expected sources")
+    owned = overlay_path.parent.resolve()
+    seen, backings, deleted = set(), [], []
+    for target, raw in sorted(expected.items()):
+        backing_name = replacements[target]
+        if raw is None:
+            if backing_name != "":
+                raise ValueError("deleted source unexpectedly has a backing file")
+            deleted.append(target)
+            continue
+        if not isinstance(backing_name, str) or not backing_name:
+            raise ValueError("replacement backing path missing")
+        backing = Path(backing_name)
+        if not backing.is_absolute():
+            raise ValueError("replacement backing path is not absolute")
+        backing = backing.resolve(strict=True)
+        if not backing.is_relative_to(owned):
+            raise ValueError("replacement backing escaped the owned job")
+        identity = str(backing).casefold()
+        if identity in seen:
+            raise ValueError("replacement backing mapping is not injective")
+        seen.add(identity)
+        observed = backing.read_bytes()
+        expected_package = _go_package(raw)
+        if (observed != raw or k.sha(observed) != k.sha(raw)
+                or _go_package(observed) != expected_package):
+            raise ValueError("replacement backing bytes/hash/package mismatch")
+        backings.append({"source_target": target, "backing_path": str(backing),
+                         "sha256": k.sha(observed), "bytes": len(observed),
+                         "package": expected_package, "readback_exact": True})
+    return {"schema": "adaptive_precap_b4_staging_readback_v1", "mapping_injective": True,
+            "replacement_count": len(replacements), "backing_count": len(backings),
+            "serialized_overlay_sha256": k.sha(serialized), "backings": backings,
+            "deleted_sources": deleted}
+
+
+def stage_overlay(job, overlay, native_map):
+    """Use unique indexed identities for both source families, then verify disk."""
+    job = job.resolve()
+    replacements, expected = {}, {}
+
+    def stage(relative, raw, basename):
+        relative_path = Path(relative)
+        if relative_path.is_absolute() or ".." in relative_path.parts:
+            raise ValueError("replacement source path is not repository-relative")
+        target = str(k.NATIVE / relative_path)
+        if target in expected:
+            raise ValueError("duplicate replacement target")
+        backing = job / basename
+        with backing.open("xb") as stream:
+            stream.write(raw)
+        replacements[target], expected[target] = str(backing), raw
+
+    for index, (relative, raw) in enumerate(sorted(overlay["images"].items())):
+        path = k.NATIVE / relative
+        if not path.is_file() or k.sha(path.read_bytes()) != k.sha(raw):
+            stage(relative, raw, f"source-{index:03d}.go")
+    for relative in sorted(set(native_map) - set(overlay["images"]) - set(overlay["overlay_files"])):
+        target = str(k.NATIVE / relative)
+        replacements[target], expected[target] = "", None
+    for index, (relative, raw) in enumerate(sorted(overlay["overlay_files"].items())):
+        stage(relative, raw, f"overlay-{index:03d}-{Path(relative).name}")
+    overlay_path = job / "overlay.json"
+    with overlay_path.open("xb") as stream:
+        stream.write(k.gate.canonical({"Replace": replacements}))
+    return overlay_path, verify_staged_overlay(overlay_path, expected)
+
+
+def frozen_plan(overlay=None):
+    if overlay is None:
+        overlay = producer.precap_overlay()
+    return {"schema": "adaptive_precap_b4_collision_free_freeze_v3", "source_pins": source_pins(),
+            "overlay_hashes": overlay["hashes"], "metadata": overlay["metadata"],
+            "input_sha256": {name: k.sha(raw) for name, raw in overlay.get("input_files", {}).items()},
+            "limits": {"whole_including_cleanup": WHOLE_SECONDS, "cleanup_reserve": CLEANUP_RESERVE,
+                       "build": BUILD_SECONDS, "contracts": CONTRACT_SECONDS,
+                       "diagnostic": DIAGNOSTIC_SECONDS, "GOMEMLIMIT": "2GiB", "jobs": 1,
+                       "builds": 1, "diagnostics": 1, "RunNeutral": 0, "refine": 0,
+                       "ordinary": 0, "captures": 0, "installs": 0, "retries": 0},
+            "commands": ["go -C <native> test -c -p=1 -mod=readonly -buildvcs=false -overlay=<overlay> -o <job>/precap-b4.exe ./internal/allsets",
+                         "<job>/precap-b4.exe -test.run=^TestAdaptivePrecapContract -test.v -test.timeout=15s",
+                         "<job>/precap-b4.exe -test.run=^TestAdaptivePrecapB4Diagnostic$ -test.v -test.parallel=1 -test.timeout=60s"],
+            "evidence_prefix": PREFIX}
+
+
+def export_job(job, record):
+    """Save every available raw output before interpreting a possibly partial summary."""
+    outputs = record.setdefault("lossless_exports", {})
+    for path in sorted(job.glob("precap-b4-*")):
+        if path.is_file() and path.suffix in (".json", ".jsonl", ".log"):
+            outputs[path.name] = previous._write_gzip_once(
+                path.read_bytes(), k.EVIDENCE / (PREFIX + path.name + ".gz"))
+    result_path = job / "precap-b4-result.json"
+    if result_path.is_file():
+        result = json.loads(result_path.read_bytes())
+        if not isinstance(result, dict):
+            raise ValueError("diagnostic result is not an object")
+        record["diagnostic_summary"] = {name: result.get(name) for name in (
+            "complete", "witness_pass", "counts", "run_neutral_calls", "refine_calls",
+            "ordinary_calls", "captures", "provider_calls", "screen_calls", "evaluate_calls",
+            "diagnostic_seconds", "setup_seconds", "cheap_seconds", "queue_sha256",
+            "selection_order_offset")}
+
+
+def validate_success(job, record):
+    queue_bytes = (job / "precap-b4-queue.json").read_bytes()
+    queue = json.loads(queue_bytes)
+    result = json.loads((job / "precap-b4-result.json").read_bytes())
+    if result.get("complete") is not True or result.get("witness_pass") is not True:
+        raise ValueError("diagnostic completion or exact savedN witness failed")
+    if result.get("queue_sha256") != k.sha(queue_bytes):
+        raise ValueError("selector result is not bound to the full blind queue bytes")
+    rows = queue.get("rows")
+    counts = result.get("counts")
+    if not isinstance(rows, list) or len(rows) != 524 or not isinstance(counts, dict):
+        raise ValueError("complete524-package terminal provenance is missing")
+    if any(type(counts.get(key)) is not int or counts[key] < 0 for key in (
+            "feasible", "queued", "unavailable", "reservation", "errors")):
+        raise ValueError("terminal counts missing or not nonnegative integers")
+    if counts.get("feasible") != 524 or sum(counts.get(key, -10000) for key in (
+            "queued", "unavailable", "reservation", "errors")) != 524:
+        raise ValueError("feasible package terminal counts do not reconcile")
+    states = {"queued": 0, "unavailable": 0, "reservation": 0, "error": 0}
+    packages = set()
+    for row in rows:
+        if not isinstance(row, dict) or not isinstance(row.get("package"), str):
+            raise ValueError("terminal row lacks its canonical package key")
+        if row["package"] in packages or row.get("state") not in states:
+            raise ValueError("duplicate package or unknown terminal state")
+        packages.add(row["package"])
+        states[row["state"]] += 1
+    if (any(states[name] != counts[name] for name in ("queued", "unavailable", "reservation"))
+            or states["error"] != counts["errors"]):
+        raise ValueError("reported terminal counts differ from actual unique package rows")
+    for name in ("run_neutral_calls", "refine_calls", "ordinary_calls", "captures"):
+        if type(result.get(name)) is not int or result[name] != 0:
+            raise ValueError("forbidden or unknown diagnostic call count: " + name)
+    if result.get("provider_calls") != 1:
+        raise ValueError("diagnostic did not use exactly one saved neutral provider load")
+    export_job(job, record)
+    record["actual_counts"] = {name: result[name] for name in (
+        "run_neutral_calls", "refine_calls", "ordinary_calls", "captures", "provider_calls")}
+    record["coverage_counts"] = counts
+    record["witness_pass"] = True
+
+
+def run(destination, freeze_path):
+    started = time.monotonic()
+    if destination.exists():
+        raise FileExistsError(destination)
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("repository Python required")
+    overlay = producer.precap_overlay()
+    plan = frozen_plan(overlay)
+    freeze = json.loads(freeze_path.read_bytes())
+    if freeze.get("source_review_status") != "approved" or freeze.get("frozen_plan") != plan:
+        raise ValueError("source-reviewed freeze differs from this exact plan")
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")) or k.gate.retirement._default_process_probe(k.ROOT):
+        raise RuntimeError("owned scratch or optimizer process is not idle")
+    if tuple(k.EVIDENCE.glob(PREFIX + "precap-b4-*.gz")):
+        raise FileExistsError("prior diagnostic exports exist")
+    before, native, pins = k.protected(), k.old.native_map(), source_pins()
+    record = {"owner": "main execution21October", "status": "started", "errors": [],
+              "frozen_plan": plan, "freeze_path": str(freeze_path), "freeze_sha256": k.sha(freeze_path.read_bytes()),
+              "protected_before": before, "native_map_before_sha256": k.gate.digest(native),
+              "source_pins_before": pins, "managed_jobs_created": 0, "diagnostic_launches": 0,
+              "build_launches": 0, "installs": 0, "retries": 0, "oldwinner_producer_inputs": False}
+    active = [None]
+    with destination.open("xb") as stream:
+        def save():
+            k.gate.io._save(stream, record)
+
+        def export():
+            if active[0] is not None:
+                export_job(active[0], record)
+            save()
+
+        def body(job):
+            active[0] = job
+            record["managed_jobs_created"] = 1
+            env, _ = k.gate.common._environment(job)
+            env.update(GOMEMLIMIT="2GiB", GTT_PRECAP_B4="root_released_once",
+                       GTT_TIGHNARI_REPLAY_REPO=str(k.ROOT))
+            overlay_path, staging_manifest = stage_overlay(job, overlay, native)
+            record["staging_manifest"] = staging_manifest
+            for name, raw in overlay.get("input_files", {}).items():
+                path = job / name
+                if path.parent != job or path.exists():
+                    raise ValueError("diagnostic input must be one fresh job-local file")
+                path.write_bytes(raw)
+            binary = job / "precap-b4.exe"
+
+            def command(args, label, limit):
+                remaining = WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE
+                if remaining <= 0:
+                    raise TimeoutError("cleanup reserve reached")
+                record["stage"] = label
+                record.setdefault("command_timeouts_seconds", {})[label] = min(limit, remaining)
+                save()
+                result = k.gate.owned._run_owned(args, command_kind=label, env=env,
+                    log_path=job / (label + ".log"), timeout_seconds=min(limit, remaining))
+                record.setdefault("commands", {})[label] = result; save()
+                if not k.gate.command_passed(result):
+                    record["failure_tail"] = (job / (label + ".log")).read_text(encoding="utf-8", errors="replace")[-6000:]
+                    raise RuntimeError(label + " failed")
+
+            record["build_launches"] = 1
+            command([str(k.gate.owned.GO_EXE), "-C", str(k.NATIVE), "test", "-c", "-p=1", "-mod=readonly",
+                     "-buildvcs=false", "-overlay=" + str(overlay_path), "-o", str(binary), "./internal/allsets"],
+                    "precap-b4-compile", BUILD_SECONDS)
+            record["binary_sha256"] = k.sha(binary.read_bytes())
+            command([str(binary), "-test.run=^TestAdaptivePrecapContract", "-test.v", "-test.timeout=15s"],
+                    "precap-b4-contracts", CONTRACT_SECONDS)
+            if WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE < DIAGNOSTIC_SECONDS:
+                raise TimeoutError("full diagnostic admission does not fit")
+            record["diagnostic_launches"] = 1
+            command([str(binary), "-test.run=^TestAdaptivePrecapB4Diagnostic$", "-test.v", "-test.parallel=1", "-test.timeout=60s"],
+                    "precap-b4-diagnostic", DIAGNOSTIC_SECONDS)
+            validate_success(job, record)
+            if k.protected() != before or k.old.native_map() != native or source_pins() != pins:
+                raise RuntimeError("protected/native/frozen source drift")
+            record["status"] = "precap_b4_diagnostic_complete"; save()
+
+        try:
+            k.gate.run_owned_body(None, record, export, body)
+        except Exception as failure:
+            record["status"] = "failed"; record["errors"].append(str(failure))
+            try:
+                export()
+            except Exception as export_failure:
+                record["export_error"] = str(export_failure)
+        finally:
+            record["protected_after"] = k.protected()
+            record["native_map_after_sha256"] = k.gate.digest(k.old.native_map())
+            record["preservation_exact"] = (record["protected_after"] == before
+                and record["native_map_after_sha256"] == k.gate.digest(native) and source_pins() == pins)
+            record["remaining_managed_jobs"] = len(tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")))
+            record["optimizer_processes_remaining"] = bool(k.gate.retirement._default_process_probe(k.ROOT))
+            record["whole_seconds"] = round(time.monotonic() - started, 3)
+            if (not record["preservation_exact"] or record["remaining_managed_jobs"]
+                    or record["optimizer_processes_remaining"] or record.get("cleanup_status") != "confirmed"
+                    or record["whole_seconds"] > WHOLE_SECONDS):
+                record["status"] = "failed"; record["errors"].append("postflight or whole budget failed")
+            save()
+    return record
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--freeze", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    result = run(args.output, args.freeze)
+    print(json.dumps({name: result.get(name) for name in (
+        "status", "errors", "whole_seconds", "coverage_counts", "witness_pass",
+        "cleanup_status", "remaining_managed_jobs", "preservation_exact")}))
+    raise SystemExit(0 if result["status"] == "precap_b4_diagnostic_complete" else 1)
+
