+def _synthetic_theory_verified_row(build_index: int, measured_dps: float, *, reason: str | None = None) -> dict:
+    mains_by_slot = {}
+    for slot in ARTIFACT_MAIN_STAT_SLOTS:
+        legal_main = next(iter(LEGAL_FIVE_STAR_MAIN_STATS_BY_SLOT[slot]))
+        mains_by_slot[slot] = next(key for key, value in GO_TO_CONFIG_STAT.items() if value == legal_main)
+    lines_by_slot = []
+    upgrades_by_slot = []
+    for slot in ARTIFACT_MAIN_STAT_SLOTS:
+        main = GO_TO_CONFIG_STAT[mains_by_slot[slot]]
+        lines_by_slot.append([index for index, stat in enumerate(THEORY_STAT_KEYS) if stat != main][:4])
+        upgrades_by_slot.append([5.0, 0.0, 0.0, 0.0])
+    witness = {
+        "Mains": [[mains_by_slot[slot] for slot in ARTIFACT_MAIN_STAT_SLOTS] for _ in range(4)],
+        "Lines": [lines_by_slot[:] for _ in range(4)],
+        "Upgrades": [upgrades_by_slot[:] for _ in range(4)],
+    }
+    packages = [
+        {"wearer_key": f"actor-{actor}", "sets": [{"set_uid": f"set-{build_index}-{actor}", "count": 2}]}
+        for actor in range(4)
+    ]
+    alias = {
+        "tuple_key": f"tuple-{build_index}",
+        "context_sha256": f"{build_index + 1:064x}",
+        "uncertainty": [],
+        "packages": packages,
+    }
+    identity = {"kind": _MEASUREMENT_KIND, "packages": packages, "witness45": witness}
+    frame_sha256 = "b" * 64
+    candidate_sha256 = _candidate_sha256(frame_sha256, identity)
+    coordinate_units = [0.0] * len(THEORY_STAT_KEYS)
+    for lines, upgrades in zip(lines_by_slot, upgrades_by_slot):
+        for coordinate, units in zip(lines, upgrades):
+            coordinate_units[coordinate] += 1 + units
+    allocations = []
+    for actor in range(4):
+        substats = []
+        for index, stat_key in enumerate(THEORY_STAT_KEYS):
+            config_stat = GO_TO_CONFIG_STAT[stat_key]
+            roll_units = coordinate_units[index]
+            substats.append({
+                "stat_key": stat_key,
+                "roll_units": roll_units,
+                "stat_value": roll_units * FIVE_STAR_SUBSTAT_ROLL_RULES[config_stat].maximum,
+            })
+        allocations.append({
+            "wearer_key": f"actor-{actor}",
+            "main_stats": dict(mains_by_slot),
+            "substats": substats,
+            "spent_roll_units": 45,
+            "unspent_roll_units": 0,
+        })
+    formula_dps = 123.0
+    measurement = {
+        "build_identity": identity,
+        "candidate_sha256": candidate_sha256,
+        "frame_sha256": frame_sha256,
+        "config_sha256": "c" * 64,
+        "engine_result_sha256": "d" * 64,
+        "engine_artifact_sha256": "e" * 64,
+        "source_manifest_sha256": "f" * 64,
+        "formula_dps": formula_dps,
+        "measured_dps": measured_dps,
+        "standard_deviation": 2.0,
+        "standard_error": 2.0 / (500 ** 0.5),
+        "iterations": 500,
+        "ignore_burst_energy": True,
+        "origins": [{
+            "kind": "ordinary",
+            "phase": "first_light",
+            "family": candidate_sha256,
+            "context_sha256": "9" * 64,
+        }],
+    }
+    row = {
+        "family": candidate_sha256,
+        "formula_dps": formula_dps,
+        "deficit_percent": 100.0 * (120.0 - measured_dps) / 120.0,
+        "refinement_level": 0,
+        "aliases": [alias],
+        "allocations": allocations,
+        "witness45": witness,
+        "measurement": measurement,
+    }
+    if reason is not None:
+        row["reason"] = reason
+    return row
