+def _require_project_interpreter() -> None:
+    """Fail before preparation; importing QtCore creates no application."""
+    try:
+        correct = PROJECT_PYTHON.is_file() and Path(sys.executable).resolve(strict=True) == PROJECT_PYTHON.resolve(strict=True)
+    except (OSError, ValueError):
+        correct = False
+    if not correct:
+        raise ValueError("Run this research harness with the project's existing .venv/Scripts/python.exe")
+    try:
+        importlib.import_module("PySide6.QtCore")
+    except (ImportError, OSError):
+        raise RuntimeError("PySide6.QtCore is unavailable; invoke the project's existing .venv/Scripts/python.exe with its dependencies ready") from None
+
