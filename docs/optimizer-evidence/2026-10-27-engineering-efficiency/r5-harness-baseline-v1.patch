+def _varint(data: memoryview, offset: int) -> tuple[int, int]:
+    value = 0
+    for shift in range(0, 70, 7):
+        if offset >= len(data):
+            raise ValueError("protobuf_truncated_varint")
+        byte = data[offset]
+        offset += 1
+        if shift == 63 and byte > 1:
+            raise ValueError("protobuf_varint_overflow")
+        value |= (byte & 127) << shift
+        if byte < 128:
+            if shift and byte == 0:
+                raise ValueError("protobuf_overlong_varint")
+            return value, offset
+    raise ValueError("protobuf_overlong_varint")
+
+
+def _fields(data: memoryview, budget: _Budget) -> Iterator[tuple[int, int, Any]]:
+    offset = 0
+    while offset < len(data):
+        budget.field()
+        tag, offset = _varint(data, offset)
+        number, wire = tag >> 3, tag & 7
+        if not 0 < number < (1 << 29):
+            raise ValueError("protobuf_field_number")
+        if wire == 0:
+            value, offset = _varint(data, offset)
+            budget.value()
+        elif wire in (1, 2, 5):
+            if wire == 2:
+                size, offset = _varint(data, offset)
+            else:
+                size = 8 if wire == 1 else 4
+            if size > len(data) - offset:
+                raise ValueError("protobuf_length_overrun")
+            value = data[offset:offset + size]
+            offset += size
+        else:
+            raise ValueError("protobuf_wire")
+        yield number, wire, value
+
+
+def _singular(data: memoryview, known: set[int], budget: _Budget) -> dict[int, int]:
+    values: dict[int, int] = {}
+    for number, wire, value in _fields(data, budget):
+        if number in known:
+            if number in values or wire != 0:
+                raise ValueError("protobuf_duplicate_or_wire")
+            values[number] = value
+    return values
+
+
+def _repeated(wire: int, value: Any, budget: _Budget) -> Iterator[int]:
+    if wire == 0:
+        yield value
+    elif wire == 2:
+        offset = 0
+        while offset < len(value):
+            budget.value()
+            number, offset = _varint(value, offset)
+            yield number
+    else:
+        raise ValueError("protobuf_repeated_wire")
+
+
+def profile_metadata(raw: bytes) -> dict[str, Any]:
+    """Decode just bounded pprof metadata, never exporting strings or addresses."""
+    result = _result()
+    try:
+        if type(raw) is not bytes or not 0 < len(raw) <= MAX_PROFILE_BYTES:
+            raise ValueError("profile_compressed_bound")
