+                identity(kind, record)
+                string_indices(record, string_fields)
+                if number == 5:
+                    function_names.add(record.get(2, 0))
+                elif any(record.get(field, 0) not in (0, 1) for field in (7, 8, 9, 10)):
+                    raise ValueError("profile_mapping_bool")
