+        except Exception as exc:
+            record["errors"].append(type(exc).__name__ + ": " + str(exc))
+        finally:
+            success = record.get("verified_installed_sha256") == record.get("candidate_sha256") and bool(record.get("verified_installed_sha256")) and not record["errors"] and record.get("cleanup_status") == "confirmed"
+            if not success:
+                try:
+                    # install_candidate owns runtime recovery when its callback
+                    # fails; after a later export failure, use durable CAS too.
+                    actual = sha_file(CONSUMER)
+                    if actual != scope.CONSUMER_SHA:
+                        require(actual == record.get("candidate_sha256"), "dense_runtime_rollback_cas")
+                        temporary = CONSUMER.with_name("dense-rollback-stage.exe")
+                        require(not temporary.exists(), "dense_runtime_rollback_stage_exists")
+                        shutil.copy2(ROLLBACK / "previous-gtt-optimizer.exe", temporary)
+                        require(sha_file(temporary) == scope.CONSUMER_SHA, "dense_runtime_rollback_copy")
+                        os.replace(temporary, CONSUMER)
+                    rollback_sources(plan)
+                    record["rolled_back"] = True
+                except Exception as exc:
+                    record["errors"].append("rollback: " + type(exc).__name__ + ": " + str(exc))
+            record["whole_wall_seconds"] = time.monotonic() - started
+            record["managed_jobs_remaining"] = len(tuple(gate.managed.MANAGED_ROOT.glob("job-*")))
+            record["optimizer_processes_remaining"] = bool(gate.retirement._default_process_probe(ROOT))
+            try:
+                preserve(plan, record["candidate_sha256"] if success else scope.CONSUMER_SHA, success)
+                record["preservation_exact"] = True
+            except Exception as exc:
+                record["errors"].append("preservation: " + str(exc))
+            record["status"] = "installed_verified" if success and not record["errors"] and record["preservation_exact"] and not record["managed_jobs_remaining"] and not record["optimizer_processes_remaining"] else "failed"
+            save()
+    return record
+
+
+def main():
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument("--prepare", action="store_true")
+    parser.add_argument("--freeze-sha")
+    args = parser.parse_args()
+    if args.prepare:
+        result = prepare()
+    else:
+        require(bool(args.freeze_sha), "dense_freeze_digest_required")
+        result = run(args.freeze_sha)
+    print(json.dumps({k: result.get(k) for k in ("freeze", "sha256", "status", "errors", "candidate_sha256", "rolled_back", "whole_wall_seconds")}, sort_keys=True))
+    if result.get("status") == "failed":
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
