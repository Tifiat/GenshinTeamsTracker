+def read_bounded(path, maximum=32 << 20):
+    k.gate.managed.assert_unlinked(path)
+    if path.stat().st_size > maximum:
+        raise ValueError("profile_export_file_bound")
+    with path.open("rb") as stream:
+        raw = stream.read(maximum + 1)
+    if len(raw) > maximum:
+        raise ValueError("profile_export_read_bound")
+    return raw
