+def _hash(v):
+    return isinstance(v, str) and re.fullmatch("[0-9a-f]{64}", v) is not None
+
+
+def _number(v):
+    return type(v) in (int, float) and 0 <= v <= 1e15 and math.isfinite(v)
+
+
+def _int(v, high=20000):
+    return type(v) is int and 0 <= v <= high
