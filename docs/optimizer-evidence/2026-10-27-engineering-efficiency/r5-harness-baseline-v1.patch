+def load_sealed_wrapper(chasca, package):
+    """Actual loader for W2's unchanged absolute core import, MAIN sealed only."""
+    package = Path(package)
+    chasca.gate.managed.assert_unlinked(package)
+    require(package.is_dir() and package.resolve().is_relative_to((ROOT / CONTROL_ROOT).resolve()),
+            "navia_sealed_control_package_required")
+    require(not any(name == MODULE_NAME or name.startswith(MODULE_NAME + ".") for name in sys.modules),
+            "navia_wrapper_module_identity_already_loaded")
+    for name, expected in WRAPPER_PINS.items():
+        chasca.gate.managed.assert_unlinked(package / name)
+        require(sha((package / name).read_bytes()) == expected, "navia_sealed_source_drift")
+    parent = sys.modules["tools.experiments.gcsim"]
+    require(not hasattr(parent, "navia_exact_pair"), "navia_wrapper_parent_binding_collision")
+    namespace = ModuleType(MODULE_NAME)
+    namespace.__path__ = [str(package)]
+    sys.modules[MODULE_NAME] = namespace
+    setattr(parent, "navia_exact_pair", namespace)
+    installed = {MODULE_NAME: namespace}
+    try:
+        for name in ("pair_core", "main_adapter"):
+            qualified = MODULE_NAME + "." + name
+            spec = importlib.util.spec_from_file_location(qualified, package / (name + ".py"))
+            require(spec is not None and spec.loader is not None, "navia_sealed_loader_missing")
+            module = importlib.util.module_from_spec(spec)
+            sys.modules[qualified] = installed[qualified] = module
+            setattr(namespace, name, module)
+            spec.loader.exec_module(module)
+        adapter = installed[MODULE_NAME + ".main_adapter"]
+        require(adapter.core is installed[MODULE_NAME + ".pair_core"], "navia_sealed_core_identity")
+        require_sealed_wrapper(chasca, package, adapter.run_owned_pair)
+        return adapter
+    except BaseException:
+        for name, module in installed.items():
+            if sys.modules.get(name) is module:
+                del sys.modules[name]
+        if getattr(parent, "navia_exact_pair", None) is namespace:
+            delattr(parent, "navia_exact_pair")
+        raise
