+def _export_job(job: Path, record: dict[str, Any]) -> None:
+    exports: dict[str, Any] = record.setdefault("lossless_exports", {})
+    paths = [job / RESULT_NAME]
+    paths.extend(sorted(job.glob(PREFIX + "*.log")))
+    for path in paths:
+        if not path.is_file():
+            continue
+        limit = MAX_RESULT_BYTES if path.name == RESULT_NAME else MAX_LOG_BYTES
+        if path.stat().st_size > limit:
+            raise ValueError("raw actor-0 trace export exceeds bound: " + path.name)
+        raw = path.read_bytes()
+        if len(raw) > limit or len(raw) != path.stat().st_size:
+            raise ValueError("raw actor-0 trace export exceeds bound: " + path.name)
+        target = k.EVIDENCE / (PREFIX + path.name.removeprefix(PREFIX) + ".gz")
+        exports[path.name] = previous._write_gzip_once(raw, target)
+        if path.name == RESULT_NAME:
+            try:
+                parsed = json.loads(raw)
+                record["raw_trace_export_summary"] = {
+                    "schema_kind": parsed.get("schema_kind") if isinstance(parsed, dict) else None,
+                    "status": parsed.get("status") if isinstance(parsed, dict) else None,
+                    "complete": parsed.get("complete") if isinstance(parsed, dict) else None,
+                    "errors": parsed.get("errors") if isinstance(parsed, dict) else None,
+                    "refine_candidates_calls": parsed.get("refine_candidates_calls") if isinstance(parsed, dict) else None,
+                    "expanded_points": parsed.get("expanded_points") if isinstance(parsed, dict) else None,
+                    **_raw_trace_export_summary(parsed),
+                }
+            except Exception as failure:
+                record["raw_trace_parse_error"] = str(failure)
+
+
+def _raw_trace_export_summary(parsed: Any) -> dict[str, Any]:
+    trace = parsed.get("trace") if isinstance(parsed, dict) else None
+    if not isinstance(trace, dict):
+        return {
+            "trace_event_count": None,
+            "trace_event_array_count": None,
+            "trace_event_bytes": None,
+            "trace_overflow": None,
+            "trace_events_state": "unknown",
+        }
+    events = trace.get("events")
+    return {
+        "trace_event_count": trace.get("event_count"),
+        "trace_event_array_count": len(events) if isinstance(events, list) else None,
+        "trace_event_bytes": trace.get("event_bytes"),
+        "trace_overflow": trace.get("overflow"),
+        "trace_events_state": "present" if isinstance(events, list) else "unknown",
+    }
+
+
+def _validate_result(path: Path, input_pins: dict[str, dict[str, Any]]) -> dict[str, Any]:
+    if not path.is_file() or path.stat().st_size > MAX_RESULT_BYTES:
+        raise ValueError("actor-0 trace result is absent or exceeds the 32 MiB bound")
+    result = json.loads(path.read_bytes())
+    if result.get("schema_kind") != "adaptive_final_actor0_refine_trace_v1" or result.get("complete") is not True:
+        raise ValueError("actor-0 trace result is incomplete")
+    if result.get("status") != "complete" or result.get("errors") != []:
+        raise ValueError("actor-0 trace reports an error")
+    if result.get("context_sha256") != "83db92e9e66131ece23f9d9de71d09b6e7d6678a6f8185d12792fa60ba7d618a":
+        raise ValueError("actor-0 trace context differs from saved D final context")
+    if result.get("graph_sha256") != "38fcbfd36bf85a185e607072971cb18e0aae96d3c813de366334e0b1e4e93ad9":
+        raise ValueError("actor-0 trace graph differs from saved D final context")
+    expected_inputs = {row["path"]: row["sha256"] for row in input_pins.values()}
+    if result.get("input_sha256") != expected_inputs:
+        raise ValueError("actor-0 trace read set differs from the pinned D-only inputs")
+    if type(result.get("actor")) is not int or result["actor"] != 0:
+        raise ValueError("actor-0 trace reports a different actor")
+    if result.get("anchor_assignment") != _EXPECTED_ANCHOR:
+        raise ValueError("actor-0 trace anchor or fixed other-three assignments differ from saved D")
+    if result.get("packages") != _EXPECTED_PACKAGES:
+        raise ValueError("actor-0 trace package set differs from saved D")
+    if result.get("search_config") != _EXPECTED_SEARCH_CONFIG:
+        raise ValueError("actor-0 trace search configuration differs from the saved D run")
+    anchor_dps = result.get("anchor_saved_formula_dps")
+    if (not isinstance(anchor_dps, (int, float)) or isinstance(anchor_dps, bool)
+            or not math.isfinite(anchor_dps)):
+        raise ValueError("saved D anchor formula score is missing or nonfinite")
+    if abs(anchor_dps - _EXPECTED_ANCHOR_DPS) > 1e-10 * (1 + abs(_EXPECTED_ANCHOR_DPS)):
+        raise ValueError("saved D anchor formula score differs from the independently pinned value")
+    for key, expected in (("refine_candidates_calls", 1), ("run_neutral_calls", 0),
+                          ("ordinary_calls", 0), ("new_engine_capture_calls", 0),
+                          ("saved_capture_provider_calls", 1), ("saved_capture_seed_members", 2),
+                          ("refine_allowance", 20000)):
+        if type(result.get(key)) is not int or result[key] != expected:
+            raise ValueError("actor-0 trace call or source-data count differs: " + key)
+    if (type(result.get("refine_cancelled")) is not bool or result["refine_cancelled"]
+            or result.get("refine_error")):
+        raise ValueError("actor-0 RefineCandidates ended through cancellation or error")
+    expanded = result.get("expanded_points")
+    if type(expanded) is not int or not 0 <= expanded <= 20000:
+        raise ValueError("actor-0 expansion count is missing or out of bounds")
+    if (type(result.get("refine_budget_reached")) is not bool
+            or result["refine_budget_reached"] != (expanded >= 20000)):
+        raise ValueError("actor-0 budget flag differs from Step.Expanded")
+    if type(result.get("refine_exhaustive")) is not bool:
+        raise ValueError("actor-0 exhaustive status is not an explicit boolean")
+    if not isinstance(result.get("refine_stop"), str) or not result["refine_stop"]:
+        raise ValueError("actor-0 stop reason is missing")
+    trace = result.get("trace")
+    if not isinstance(trace, dict) or trace.get("complete") is not True or trace.get("overflow") is not False:
+        raise ValueError("actor-0 trace event observer overflowed")
+    events = trace.get("events")
+    count, event_bytes = trace.get("event_count"), trace.get("event_bytes")
+    max_events, max_bytes = trace.get("max_events"), trace.get("max_bytes")
+    if (not isinstance(events, list) or type(count) is not int or count != len(events)
+            or count > 50000 or type(event_bytes) is not int or event_bytes < 0 or event_bytes > 16 << 20
+            or type(max_events) is not int or max_events != 50000
+            or type(max_bytes) is not int or max_bytes != 16 << 20):
+        raise ValueError("actor-0 trace event counters are malformed or over limit")
+    if any(not isinstance(event, dict) or type(event.get("sequence")) is not int
+           or event.get("sequence") != index for index, event in enumerate(events)):
+        raise ValueError("actor-0 trace sequence is incomplete or reordered")
+    event_names = {event.get("event") for event in events}
+    if "refine_start" not in event_names or "free_inventory" not in event_names:
+        raise ValueError("actor-0 trace lacks the actual refiner entry or free inventory")
+    refine_start = next(event for event in events if event.get("event") == "refine_start")
+    if (type(refine_start.get("actor")) is not int or refine_start.get("actor") != 0
+            or type(refine_start.get("allowance")) is not int or refine_start.get("allowance") != 20000
+            or refine_start.get("anchor") != _EXPECTED_ANCHOR):
+        raise ValueError("initial trace event differs from the saved D actor-0 anchor/call")
+    first_round = next((event for event in events if event.get("event") == "round_start"), None)
+    if not isinstance(first_round, dict):
+        raise ValueError("actor-0 trace lacks its initial gradient-round anchor")
+    initial_best = first_round.get("pre_gradient_best")
+    if not isinstance(initial_best, dict) or initial_best.get("assignment") != _EXPECTED_ANCHOR:
+        raise ValueError("initial gradient-round assignment differs from the saved D anchor")
+    initial_dps = initial_best.get("dps")
+    if (not isinstance(initial_dps, (int, float)) or isinstance(initial_dps, bool)
+            or not math.isfinite(initial_dps)
+            or abs(initial_dps - anchor_dps) > 1e-10 * (1 + abs(anchor_dps))):
+        raise ValueError("initial trace formula score differs from the saved D anchor")
+    for key in ("setup_seconds", "refine_seconds", "wall_seconds"):
+        value = result.get(key)
+        if (not isinstance(value, (int, float)) or isinstance(value, bool)
+                or not math.isfinite(value) or value < 0):
+            raise ValueError("actor-0 trace timing is missing: " + key)
+    if result["refine_seconds"] > 100 or result["wall_seconds"] > DIAGNOSTIC_SECONDS:
+        raise ValueError("actor-0 trace exceeded its refinement or diagnostic cap")
+    report = result.get("report")
+    if not isinstance(report, dict):
+        raise ValueError("actual CandidateReport is missing")
+    step = report.get("Step")
+    if not isinstance(step, dict):
+        raise ValueError("actual CandidateReport.Step is missing")
+    step_anchor = step.get("anchor_dps")
+    if (not isinstance(step_anchor, (int, float)) or isinstance(step_anchor, bool)
+            or not math.isfinite(step_anchor)
+            or abs(step_anchor - anchor_dps) > 1e-10 * (1 + abs(anchor_dps))):
+        raise ValueError("actual CandidateReport anchor score differs from the saved D anchor")
+    if type(step.get("expanded")) is not int or step.get("expanded") != expanded:
+        raise ValueError("actual CandidateReport.Step.Expanded differs from the direct result count")
+    invalid_assignments = result.get("invalid_assignments")
+    if type(invalid_assignments) is not int or invalid_assignments < 0:
+        raise ValueError("direct invalid-assignment count is missing or malformed")
+    if "invalid_assignments" not in step:
+        if invalid_assignments != 0:
+            raise ValueError("CandidateReport omitted a nonzero invalid-assignment count")
+    else:
+        step_invalid_assignments = step["invalid_assignments"]
+        if (type(step_invalid_assignments) is not int or step_invalid_assignments < 0
+                or step_invalid_assignments != invalid_assignments):
+            raise ValueError("invalid-assignment counters are malformed or disagree with CandidateReport.Step")
+    if (report.get("Stop") != result.get("refine_stop")
+            or type(report.get("Exhaustive")) is not bool
+            or report.get("Exhaustive") != result.get("refine_exhaustive")):
+        raise ValueError("actual CandidateReport stop/exhaustive fields disagree with trace summary")
+    return result
+
+
+def run(destination: Path, freeze_path: Path) -> dict[str, Any]:
+    started = time.monotonic()
+    if destination.exists():
+        raise FileExistsError(destination)
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("run with the repository .venv/Scripts/python.exe")
+
+    overlay = producer.actor0_refine_trace_overlay()
+    inputs = _input_pins()
+    plan = _frozen_plan(overlay, inputs)
+    freeze_raw = freeze_path.read_bytes()
+    freeze = json.loads(freeze_raw)
+    if freeze.get("source_review_status") != "approved" or freeze.get("frozen_plan") != plan:
+        raise ValueError("source-reviewed freeze does not match this exact D-only trace plan")
