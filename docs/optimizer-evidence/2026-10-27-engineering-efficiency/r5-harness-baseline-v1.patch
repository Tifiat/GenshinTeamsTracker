+def validate_wall(wall, run_seconds):
+    keys = {"run_setup", "proposal_preparation", "queue_refine_secondary_policy", "package_joint",
+            "team_joint", "package_exchange", "post_cycle_team_joint", "final_stabilization", "run_neutral_finalize"}
+    finite = lambda n: type(n) in (int, float) and math.isfinite(n) and n >= 0
+    phases = wall.get("phase_seconds", {})
+    if wall.get("schema") != "e_whole_profile_v1" or set(phases) != keys or not all(map(finite, phases.values())):
+        raise ValueError("profile_wall_schema")
+    for key in ("run_neutral_wall_seconds", "phase_sum_seconds"):
+        if not finite(wall.get(key)):
+            raise ValueError("profile_wall_number")
+    residual = wall.get("unattributed_seconds")
+    if type(residual) not in (int, float) or not math.isfinite(residual):
+        raise ValueError("profile_wall_residual_number")
+    if residual < -0.002:
+        raise ValueError("profile_wall_overlap")
+    if (not math.isclose(sum(phases.values()), wall["phase_sum_seconds"], abs_tol=1e-6)
+            or not math.isclose(wall["phase_sum_seconds"] + wall["unattributed_seconds"], wall["run_neutral_wall_seconds"], abs_tol=1e-6)
+            or not math.isclose(wall["run_neutral_wall_seconds"], run_seconds, abs_tol=1e-3)):
+        raise ValueError("profile_wall_partition")
