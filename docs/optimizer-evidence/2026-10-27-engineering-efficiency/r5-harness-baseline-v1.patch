+def bounded_metadata_view(chasca):
+    """Only two readonly local Git metadata calls may run outside the owned tree."""
+    owned = SimpleNamespace(**vars(chasca.gate.owned))
+    git_state = owned._git_state
+    subprocess_api = git_state.__globals__["subprocess"]
+    def run(command, **kwargs):
+        require(len(command) >= 2 and command[1:] in (["rev-parse", "HEAD"],
+                ["rev-parse", "--git-path", "index"])
+                and Path(kwargs["cwd"]).resolve() == ROOT.resolve(), "navia_local_git_metadata_only")
+        kwargs["timeout"] = 5
+        kwargs["env"] = dict(kwargs["env"], GIT_NO_LAZY_FETCH="1", GIT_TERMINAL_PROMPT="0",
+                             GIT_OPTIONAL_LOCKS="0")
+        command = [command[0], "-c", "core.hooksPath=", "-c", "core.fsmonitor=false",
+                   "-c", "protocol.allow=never", *command[1:]]
+        return subprocess_api.run(command, **kwargs)
+    owned._git_state = function_view(git_state,
+        subprocess=SimpleNamespace(**{**vars(subprocess_api), "run": run}))
+    gate = SimpleNamespace(**{**vars(chasca.gate), "owned": owned})
+    return SimpleNamespace(**{**vars(chasca), "gate": gate,
+        "snapshot": function_view(chasca.snapshot, gate=gate)})
+
