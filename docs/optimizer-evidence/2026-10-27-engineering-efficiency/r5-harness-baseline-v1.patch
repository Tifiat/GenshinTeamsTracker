@@ -0,0 +1,286 @@
+"""Factory for one blind, engine-free actor-3 block-4 pre-cap replay.
+
+The factory only reconstructs accepted D346 plus its two-file D119 overlay,
+extracts the saved N block-4 anchor and selector witness, and returns overlays
+for the separately authorized managed runner. It does not build or execute Go.
+"""
+from __future__ import annotations
+
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_no_feedback as no_feedback
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+ROOT = k.ROOT
+RUN = k.RUN
+EVIDENCE = k.EVIDENCE
+HELPER = Path(__file__).with_name("adaptive_precap_b4_test.go")
+POLICY = Path(__file__).with_name("adaptive_hybrid_policy_test.go")
+PROJECTION = EVIDENCE / "adaptive-no-feedback-candidate-projection.json.gz"
+CONSUMER = EVIDENCE / "TIGHNARI20_SCALAR_ACCEPTED_CONSUMER_BUILD.json"
+SOURCE_FILES: tuple[Path, ...] = (Path(__file__), HELPER)
+BLIND_INPUT_POLICY = "saved N actor-3 block-4 anchor and selector witness only; no B-arm identity or winner"
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _canonical(value: Any) -> bytes:
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode()
+
+
+def _once(source: str, before: str, after: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"expected unique accepted-source marker: {before!r}")
+    return source.replace(before, after, 1)
+
+
+def _extract(source: str, start: str, end: str) -> str:
+    if source.count(start) != 1:
+        raise ValueError(f"expected one accepted closure start: {start!r}")
+    offset = source.index(start)
+    finish = source.find(end, offset)
+    if finish < 0:
+        raise ValueError(f"missing accepted closure end: {end!r}")
+    return source[offset:finish].rstrip()
+
+
+def _accepted_images() -> tuple[dict[str, bytes], str, str]:
+    closure = json.loads(CONSUMER.read_bytes())["accepted_source_closure"]
+    images, d346_sha = k.accepted_images()
+    # D119's accepted delta contains only these formula kernel/test images.
+    for relative in closure["changed_path_sha256"]:
+        if relative not in ("internal/formula/artifact_program.go", "internal/formula/artifact_arithmetic_test.go"):
+            raise ValueError("unexpected D119 accepted source delta")
+        images[relative] = (k.NATIVE / relative).read_bytes()
+    actual = {relative: k.sha(raw) for relative, raw in images.items()}
+    if actual != closure["candidate_path_sha256"]:
+        raise RuntimeError("accepted D346+D119 source closure mismatch")
+    if len(actual) != 346 or k.gate.digest(actual) != closure["candidate_source_map_sha256"]:
+        raise RuntimeError("accepted D346+D119 source map identity mismatch")
+    return images, d346_sha, closure["candidate_source_map_sha256"]
+
+
+def _saved_inputs() -> tuple[dict[str, Any], dict[str, Any]]:
+    # Read the compact saved N candidate projection only; never ingest the
+    # original optimizer output or any B-arm winner into the blind producer.
+    saved = json.loads(gzip.decompress(PROJECTION.read_bytes()))
+    projection = saved["projection"]
+    events = saved["policy"]["events"]
+    anchor_events = [row for row in events if row.get("type") == "block_anchor" and row.get("block") == 4]
+    queue_events = [row for row in events if row.get("type") == "queue_selected" and row.get("block") == 4]
+    if len(anchor_events) != 1 or len(queue_events) != 1:
+        raise RuntimeError("saved N block-4 anchor/witness is not unique")
+    anchor_event, witness_event = anchor_events[0], queue_events[0]
+    anchor = anchor_event["anchor"]
+    matches = [row for row in projection["search_work"]
+               if row.get("lane") == "neutral_actor_3:anchor"
+               and row.get("context_sha256") == anchor.get("context_sha256")
+               and row.get("assignment") == anchor.get("assignment")]
+    if len(matches) != 1:
+        raise RuntimeError("saved N block-4 anchor has no unique ordered work row")
+    if anchor_event.get("feedback_enabled") is not False or anchor_event.get("engine_incumbent") is not False:
+        raise RuntimeError("saved N block-4 anchor is not the formula fallback")
+    if witness_event.get("count") != 16 or len(witness_event.get("selected", [])) != 16:
+        raise RuntimeError("saved N block-4 selector witness is incomplete")
+
+    contexts = sorted((RUN / "verification/contexts").glob("context-*"))
+    if len(contexts) != 1:
+        raise RuntimeError("saved-only capture context inventory is not unique")
+    context_id = contexts[0].name.removeprefix("context-")
+    capture: dict[str, Any] = {"context_sha256": context_id, "seeds": []}
+    for seed in (742031889, 742031890):
+        folder = contexts[0] / f"seed-{seed}"
+        config = (folder / "config.txt").read_bytes()
+        member = (folder / "member.json").read_bytes()
+        effects = (folder / "member.json.effects.json").read_bytes()
+        capture["seeds"].append({
+            "seed": seed,
+            "config_path": f"verification/contexts/{contexts[0].name}/seed-{seed}/config.txt",
+            "member_path": f"verification/contexts/{contexts[0].name}/seed-{seed}/member.json",
+            "effects_path": f"verification/contexts/{contexts[0].name}/seed-{seed}/member.json.effects.json",
+            "config_sha256": _sha(config), "member_sha256": _sha(member),
+            "effects_sha256": _sha(effects), "config_bytes": len(config),
+            "member_bytes": len(member), "effects_bytes": len(effects),
+        })
+    config_sha = capture["seeds"][0]["config_sha256"]
+    if any(row["config_sha256"] != config_sha for row in capture["seeds"]):
+        raise RuntimeError("saved neutral capture configs differ between seeds")
+
+    anchor_row = matches[0]
+    plan = {
