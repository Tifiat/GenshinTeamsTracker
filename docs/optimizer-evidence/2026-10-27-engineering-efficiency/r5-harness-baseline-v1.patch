+"""Factory for a source-only B4 post-witness relinearization diagnostic.
+
+This composes the accepted D346+D119 pre-cap producer, keeps its original
+queue/witness bytes, and adds one linear-only search walk for each available
+prepared package. It never runs Go or an optimizer itself.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_precap_b4 as precap
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
