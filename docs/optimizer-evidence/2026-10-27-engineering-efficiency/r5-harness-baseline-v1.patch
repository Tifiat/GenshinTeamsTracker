+def source_plan(delta_hashes: dict[str, str], policy_sha256: str) -> dict:
+    """Freeze source closure separately from mutable physical repository files."""
+    policy_path = scope.EVIDENCE / "candidate-leader-policy-v1.json"
+    if (not scope._digest(policy_sha256)
+            or scope.sha(scope.bounded(policy_path, 1 << 20)) != policy_sha256):
+        raise ValueError("preservation_policy_sha_not_frozen")
+    base = scope.accepted_product_images()
+    delta = {relative: scope.bounded(scope.NATIVE / relative)
+             for relative in delta_hashes}
+    images = scope.admitted_delta(base, delta, delta_hashes)
+    source_files = [scope.ROOT / "tools/experiments/gcsim/mvp_polish" / name for name in (
+        "candidate_preservation_run.py", "candidate_preservation_case.py",
