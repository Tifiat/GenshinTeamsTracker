+def _result(status: str = "invalid", **fields: Any) -> dict[str, Any]:
+    return {"status": status, "errors": [], **fields}
+
+
+def _text_bytes(value: str, limit: int) -> bytes:
+    if type(value) is not str:
+        raise ValueError("text_type")
+    # Test length before encoding so a huge input does not create a huge copy.
+    if len(value) > limit:
+        raise ValueError("text_bound")
+    encoded = value.encode("utf-8", errors="strict")
+    if len(encoded) > limit or "\x00" in value:
+        raise ValueError("text_bound")
+    return encoded
+
+
+def _pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate_json_key")
+        result[key] = value
+    return result
+
+
+def _constant(_: str) -> None:
+    raise ValueError("nonfinite_json_number")
+
+
+def _float(value: str) -> float:
+    number = float(value)
+    if not math.isfinite(number):
+        raise ValueError("nonfinite_json_number")
+    return number
+
+
+def _integer(value: str) -> int:
+    if len(value) > 21:
+        raise ValueError("json_integer_bound")
+    return int(value)
+
+
+def _json(value: str) -> Any:
+    return json.loads(value, object_pairs_hook=_pairs, parse_constant=_constant,
+                      parse_float=_float, parse_int=_integer)
+
+
+def collect_go_events(text: str) -> dict[str, Any]:
+    """Require the one named run/pass, package pass, and complete test marker."""
+    result = _result(event_count=0, named_run_events=0, named_pass_events=0,
+                     package_pass_events=0, marker_count=0)
+    outputs = {"test": "", "package": ""}
+    phase = "before"
+    allowed = {"Time", "Action", "Package", "Test", "Elapsed", "Output"}
+    try:
+        _text_bytes(text, MAX_LOG_BYTES)
+        if not text or not text.endswith("\n"):
+            raise ValueError("go_jsonl_incomplete")
+        for line in text.splitlines():
+            result["event_count"] += 1
+            if result["event_count"] > MAX_EVENTS or not line:
+                raise ValueError("go_event_bound_or_blank")
+            event = _json(line)
+            if type(event) is not dict or set(event) - allowed:
+                raise ValueError("go_event_shape")
+            action = event.get("Action")
+            if type(action) is not str or event.get("Package") != PACKAGE:
+                raise ValueError("go_event_identity")
+            if "Time" in event and type(event["Time"]) is not str:
+                raise ValueError("go_event_type")
+            if "Elapsed" in event and (type(event["Elapsed"]) not in (int, float)
+                    or not math.isfinite(event["Elapsed"]) or event["Elapsed"] < 0):
+                raise ValueError("go_event_type")
+            named = "Test" in event
+            if named and event["Test"] != NAMED_TEST:
+                raise ValueError("go_unexpected_test")
+            if action in {"fail", "skip"}:
+                raise ValueError("go_fail_or_skip")
+            if phase == "done":
+                raise ValueError("go_after_package_pass")
+            if action == "run" and named and phase == "before":
+                result["named_run_events"] += 1
+                phase = "running"
+            elif action == "pass" and named and phase == "running":
+                result["named_pass_events"] += 1
+                phase = "passed"
+            elif action == "pass" and not named and phase == "passed":
+                result["package_pass_events"] += 1
+                phase = "done"
+            elif action == "output":
+                if type(event.get("Output")) is not str or (named and phase != "running"):
+                    raise ValueError("go_output_shape_or_order")
+                key = "test" if named else "package"
+                outputs[key] += event["Output"]
+                if len(outputs[key]) > MAX_LOG_BYTES:
+                    raise ValueError("go_output_bound")
+            elif action == "start" and not named and phase == "before":
+                pass
+            else:
+                raise ValueError("go_event_action_or_order")
+            if action != "output" and "Output" in event:
+                raise ValueError("go_output_wrong_action")
+        if phase != "done":
+            raise ValueError("go_missing_run_or_pass")
+        for output in outputs.values():
+            if output and not output.endswith("\n"):
+                raise ValueError("go_output_incomplete")
+            if "(cached)" in output or re.search(r"(?m)^\s*(?:FAIL|SKIP)\b", output):
+                raise ValueError("go_cached_or_failed_output")
+        marker_lines = [line for line in outputs["test"].splitlines() if MARKER in line]
+        result["marker_count"] = len(marker_lines)
+        marker_re = re.compile(r"\s*(?:[A-Za-z0-9_.-]+\.go:[0-9]+:\s*)?" + MARKER + r"\s*")
+        if (len(marker_lines) != 1 or not marker_re.fullmatch(marker_lines[0])
+                or MARKER in outputs["package"]):
+            raise ValueError("go_marker_missing_or_duplicate")
+        result["status"] = "valid"
+    except (ValueError, UnicodeError, RecursionError, OverflowError):
+        result["errors"] = ["go_events_rejected"]
+    return result
+
+
+def validate_summary(summary: dict[str, Any]) -> dict[str, Any]:
+    """Validate actual Go summary keys; bool is never an integer counter."""
+    result = _result()
+    try:
+        if type(summary) is not dict or set(summary) != SUMMARY_KEYS:
+            raise ValueError("summary_keys")
+        for key, expected in _EXACT_SUMMARY.items():
+            if type(summary[key]) is not type(expected) or summary[key] != expected:
+                raise ValueError("summary_exact")
+        for key in _COUNTERS:
+            if type(summary[key]) is not int or not 0 <= summary[key] <= UINT64_MAX:
+                raise ValueError("summary_counter")
+        if summary["gc_count_delta"] > (1 << 32) - 1:
+            raise ValueError("summary_gc_count")
+        for key, maximum in (("refine_wall_ns", INT64_MAX), ("gomaxprocs", INT64_MAX),
+                             ("profile_bytes", MAX_PROFILE_BYTES)):
+            if type(summary[key]) is not int or not 0 < summary[key] <= maximum:
+                raise ValueError("summary_positive_integer")
+        dps = summary["final_dps"]
+        if (type(dps) is not float or not math.isfinite(dps)
+                or struct.pack(">d", dps).hex() != EXPECTED_DPS_BITS):
+            raise ValueError("summary_dps_bits")
+        digest = summary["profile_sha256"]
+        if type(digest) is not str or not re.fullmatch(r"[0-9a-f]{64}", digest):
+            raise ValueError("summary_profile_digest")
+        result.update(status="valid", summary=dict(summary))
+    except (ValueError, TypeError, OverflowError):
+        result["errors"] = ["summary_rejected"]
+    return result
+
+
+def parse_summary(text: str | bytes) -> dict[str, Any]:
+    """Strict raw-JSON entry point, including duplicate-key detection."""
+    try:
+        if type(text) is bytes:
+            if len(text) > MAX_SUMMARY_BYTES:
+                raise ValueError("summary_bound")
+            text = text.decode("utf-8", errors="strict")
+        _text_bytes(text, MAX_SUMMARY_BYTES)
+        return validate_summary(_json(text))
+    except (ValueError, UnicodeError, RecursionError, OverflowError):
+        return _result(errors=["summary_json_rejected"])
+
