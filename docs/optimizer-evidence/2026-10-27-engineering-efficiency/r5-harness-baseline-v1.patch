+def _bounded_file_sha(path: Path, limit: int) -> tuple[str, int]:
+    info = path.stat()
+    if not path.is_file() or info.st_size > limit:
+        raise ValueError("pinned file is absent or exceeds its read bound: " + str(path))
+    raw = path.read_bytes()
+    if len(raw) != info.st_size:
+        raise ValueError("pinned file changed while being read: " + str(path))
+    return k.sha(raw), len(raw)
+
+
+def _input_pins() -> dict[str, dict[str, Any]]:
+    rows: dict[str, dict[str, Any]] = {}
+    total_bytes = 0
+    for name, pin in producer.INPUT_PINS.items():
+        path = k.ROOT / pin["path"]
+        size = path.stat().st_size
+        if size > MAX_SAVED_INPUT_FILE_BYTES:
+            raise ValueError("saved D input exceeds its per-file read bound: " + pin["path"])
+        total_bytes += size
+        if total_bytes > MAX_SAVED_INPUT_TOTAL_BYTES:
+            raise ValueError("saved D inputs exceed their aggregate read bound")
+        raw = path.read_bytes()
+        if len(raw) != size:
+            raise ValueError("saved D input changed while being read: " + pin["path"])
+        digest = k.sha(raw)
+        if digest != pin["sha256"]:
+            raise ValueError("saved D input identity changed: " + pin["path"])
+        rows[name] = {
+            "path": pin["path"],
+            "sha256": digest,
+            "bytes": len(raw),
+        }
+    return rows
+
+
+def _source_pins(overlay: dict[str, Any]) -> dict[str, str]:
+    runtime_paths = tuple(Path(module.__file__) for module in _RUNTIME_MODULES)
+    paths = tuple(dict.fromkeys((*producer.SOURCE_FILES, *runtime_paths, *_RUNTIME_FILES, Path(__file__))))
+    pins: dict[str, str] = {}
+    for path in paths:
+        digest, _ = _bounded_file_sha(path, MAX_SOURCE_PIN_BYTES)
+        pins[path.relative_to(k.ROOT).as_posix()] = digest
+    pins["accepted_D_candidates_image_sha256"] = overlay["hashes"]["accepted_D_candidates_image_sha256"]
+    pins["patched_D_candidates_image_sha256"] = overlay["hashes"]["actor0_trace_candidates_image_sha256"]
+    pins["observer_erasure_image_sha256"] = overlay["hashes"]["actor0_trace_observer_erasure_sha256"]
+    for path, raw in sorted(overlay["overlay_files"].items()):
+        pins["overlay:" + path] = k.sha(raw)
+    return pins
+
+
+def _frozen_plan(overlay: dict[str, Any], inputs: dict[str, dict[str, Any]]) -> dict[str, Any]:
