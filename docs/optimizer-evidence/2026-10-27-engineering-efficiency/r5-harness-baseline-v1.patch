+class TotalDeadline:
+    """One controller watchdog, not a launcher or a replacement job lifecycle.
+
+    A durable failure-retain marker is written before any allocation. Separate
+    timers record uncertainty before the cut and exit this supervisor at the
+    hard bound. KILL_ON_JOB_CLOSE containment is not an observed idle/close BOOL
+    at a hard exit; the immutable marker therefore retains unknown counters.
+    """
+    def __init__(self, seconds, failure_save, *, clock=time.monotonic, timer=threading.Timer, exit_process=os._exit):
+        self.started, self.seconds, self.clock = clock(), seconds, clock
+        self.failure_save, self.exit_process, self.timer = failure_save, exit_process, timer
+        self.timers = []
+
+    def allowance(self, maximum):
+        remaining = self.seconds - (self.clock() - self.started) - CLEANUP_RESERVE
+        require(remaining > 0, "navia_total_deadline_cleanup_reserve")
+        return min(maximum, remaining)
+
+    def retain_failure(self):
+        self.failure_save({"status": "failed_or_interrupted_ownership_retained", "owner": OWNER,
+            "engine_calls": None, "full_search_calls": None, "counters": "unknown_not_zero",
+            "cleanup_status": "explicit_review_required_no_automatic_delete"})
+
+    def start(self):
+        self.retain_failure()  # Failure of this write prevents all allocations.
+        for after, callback in ((self.seconds - CLEANUP_RESERVE, self.retain_failure),
+                                (self.seconds, lambda: self.exit_process(124))):
+            item = self.timer(max(0, after - (self.clock() - self.started)), callback)
+            item.daemon = True
+            item.start()
+            self.timers.append(item)
+        return self
+
+    def close(self):
+        for item in self.timers:
+            item.cancel()
+
+
+def deadline_status_writer(stream, path, ownership, marker, immutable_raw):
+    """Serialize this case's status updates; the ownership marker is immutable."""
+    lock, terminal = threading.RLock(), False
+    def save(facts):
+        nonlocal terminal
+        with lock:
+            if terminal:
+                return
+            require(marker.read_bytes() == immutable_raw, "navia_immutable_ownership_drift")
+            raw = canonical({**ownership, **facts})
+            stream.seek(0)
+            stream.truncate()
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+            require(path.read_bytes() == raw, "navia_deadline_ownership_readback")
+            terminal = facts.get("status") in ("completed", "explicit_private_cleanup_confirmed")
+    save.lock = lock
+    def close():
+        nonlocal terminal
+        with lock:
+            terminal = True
+    save.close = close
+    return save
+
+
+def cli_parser():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("operation", choices=("draft", "compile_guards", "pair", "cleanup_private"))
+    parser.add_argument("--protocol", type=Path, required=True)
+    parser.add_argument("--protocol-sha256", required=True)
+    parser.add_argument("--draft-operation", choices=("compile_guards", "pair"), default="compile_guards")
+    parser.add_argument("--private-input", type=Path)
+    parser.add_argument("--private-input-sha256")
+    parser.add_argument("--control", type=Path, help=argparse.SUPPRESS)
+    parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
+    parser.add_argument("--prepare-job", type=Path, help=argparse.SUPPRESS)
+    return parser
+
+
+def import_main_services(protocol):
+    from tools.experiments.gcsim.mvp_polish import direct_base_identity_witness as direct
+    direct.assert_runtime_identity()
+    direct.require_witness(protocol.get("direct_base_witness"))
+    from tools.experiments.gcsim.mvp_polish import chasca_width as chasca
+    require(Path.cwd().resolve() == ROOT.resolve() and Path(chasca.ROOT).resolve() == ROOT.resolve(),
+            "navia_main_checkout_required")
+    verify_project_sources(chasca, protocol["source_pins"])
+    require(Path(sys.executable).resolve() == (ROOT / ".venv/Scripts/python.exe").resolve()
+            and chasca.gate.owned._sha256_file(Path(sys.executable)) == PYTHON_SHA
+            and chasca.gate.owned._sha256_file(chasca.gate.owned.GO_EXE) == GO_SHA,
+            "navia_pinned_toolchain_required")
+    return bounded_metadata_view(chasca)
+
+
+def draft_protocol(template, operation, private_input=None, private_sha256=None):
+    """Fresh public metadata proposal only; prints no grant and no private bytes."""
+    value = {**template, "state": "prepared_not_released", "root_reviewed": False,
+             "execution_authorized": False, "operation": operation,
+             "limits": PAIR_LIMITS if operation == "pair" else COMPILE_LIMITS,
+             "engine_authorized": operation == "pair", "cleanup": None}
+    require((private_input is not None) == (operation == "pair")
+            and ((private_sha256 is not None) == (operation == "pair")), "navia_draft_private_binding")
+    value["private_input"] = ({"path": str(private_input), "sha256": private_sha256}
+                              if operation == "pair" else None)
+    value["result"] = (Path(SOURCE_PROTOCOL).parent /
+        ("navia-exact-" + value["lease_id"] + "-" + operation + ".json")).as_posix()
+    chasca = import_main_services(validate_protocol(value, operation, released=False))
+    paths = set(value["source_pins"]) | chasca.gate.runtime_paths() | set(chasca.PUBLIC.values())
+    value["pins"] = {relative: chasca.gate.owned._sha256_file(ROOT / relative) for relative in sorted(paths)}
+    value["before"] = chasca.snapshot(value["pins"])
+    value.pop("_sha256", None)
+    return value
+
+
+def seal_packet(chasca, protocol, control):
+    packet = protocol["packet"]
+    root, manifest_path = Path(packet["root"]), Path(packet["manifest"])
+    chasca.gate.managed.assert_unlinked(root)
+    chasca.gate.managed.assert_unlinked(manifest_path)
+    require(manifest_path.stat().st_size == 3182 and sha(manifest_path.read_bytes()) == PACKET_SHA,
+            "navia_reviewed_packet_manifest_drift")
+    manifest = json.loads(manifest_path.read_bytes())
+    rows = {row["path"]: row for row in manifest["files"]}
+    package = control / "sealed"
+    package.mkdir(mode=0o700)
+    for name, expected in WRAPPER_PINS.items():
+        relative = "tools/experiments/gcsim/navia_exact_pair/" + name
+        require(rows[relative]["sha256"] == expected, "navia_manifest_wrapper_binding")
+        source = root / relative
+        chasca.gate.managed.assert_unlinked(source)
+        require(source.stat().st_size == rows[relative]["bytes"] <= 1 << 20,
+                "navia_packet_file_size_drift")
+        raw = source.read_bytes()
+        require(sha(raw) == expected, "navia_packet_file_drift")
+        exclusive_raw(chasca, package / name, raw, 1 << 20)
+    candidate = Path(protocol["candidate_patch"]["path"])
+    chasca.gate.managed.assert_unlinked(candidate)
+    require(candidate.stat().st_size == 3897, "navia_candidate_patch_size")
+    raw = candidate.read_bytes()
+    require(sha(raw) == PATCH_SHA == protocol["candidate_patch"]["sha256"], "navia_candidate_patch_drift")
+    exclusive_raw(chasca, control / "candidate.patch", raw, 16384)
+    return package
+
+
+def bound_control(chasca, protocol, control):
+    control = Path(control)
+    chasca.gate.managed.assert_unlinked(control)
+    require(control.resolve().parent == (ROOT / CONTROL_ROOT).resolve()
+            and control.name == "job-" + protocol["lease_id"] and control.is_dir(), "navia_control_scope")
+    value = chasca.gate.read_json(control / "ownership.json", 32768)
+    require(value["owner"] == OWNER and value["protocol_sha256"] == protocol["_sha256"]
+            and value["lease_id"] == protocol["lease_id"]
+            and value["identity"] == PrivatePairSink._identity(control), "navia_control_ownership")
+    return control, value
+
+
+def worker_execute(chasca, protocol, args):
+    control, ownership = bound_control(chasca, protocol, args.control)
+    require(os.environ.get("GTT_NAVIA_EXACT_SUPERVISED") == ownership["token"],
+            "navia_supervised_worker_required")
+    def allowance(maximum):
+        remaining = ownership["hard_deadline_monotonic"] - time.monotonic() - CLEANUP_RESERVE
+        require(remaining > 0, "navia_total_deadline_cleanup_reserve")
+        return min(maximum, remaining)
+    def grant():
+        validate_protocol(protocol, args.operation)
+        allowance(1)
+    export = ROOT / PRIVATE_ROOT / ("job-" + protocol["lease_id"])
+    def scratch(job, stage):
+        allowance(1)
+        total = sum(chasca.gate.common._tree_bytes(path) for path in (control, Path(job), export)
+                    if path.exists())
+        require(total <= SCRATCH_LIMIT, "navia_combined_scratch_exceeded")
+    if args.prepare_job is not None:
+        worker_identity = chasca.gate.read_json(control / "worker.json", 32768)
+        require(os.getppid() == worker_identity["pid"], "navia_prepare_parent_binding")
+        prep.supervised_prepare(chasca, args.prepare_job, protocol, allowance=allowance,
+            scratch=scratch, require_grant=grant,
+            verify_sources=lambda: verify_project_sources(chasca, protocol["source_pins"]))
+        return 0
+    require(os.getppid() == ownership["supervisor_pid"], "navia_worker_parent_binding")
+    exclusive_raw(chasca, control / "worker.json", canonical({"pid": os.getpid()}), 32768)
+    require(chasca.snapshot(protocol["pins"]) == protocol["before"], "navia_before_state_drift")
+    require(not tuple(chasca.gate.managed.MANAGED_ROOT.glob("job-*"))
+            and not chasca.gate.retirement._default_process_probe(ROOT), "navia_shared_slot_not_idle")
+    record = {"schema_kind": "gtt_main_navia_exact_pair_result_v1", "owner": OWNER,
+        "protocol_sha256": protocol["_sha256"], "lease_id": protocol["lease_id"],
+        "status": "reserved", "errors": [], "limits": protocol["limits"],
+        "future_protocol_granted": args.operation == "pair", "engine_calls": 0,
+        "full_search_calls": 0, "ordinary_calls": 0, "support_calls": 0, "installs": 0,
+        "retries": 0, "cleanup_status": "not_allocated"}
+    sink, ledger_stream = None, None
+    result_path = control / "worker-result.json"
+    with result_path.open("xb") as result_stream:
+        def save():
+            if sink is not None:
+                raw_state = canonical(sink_state(sink))
+                require(len(raw_state) <= 2 << 20, "navia_private_state_size")
+                ledger_stream.seek(0)
+                ledger_stream.truncate()
+                ledger_stream.write(raw_state)
+                ledger_stream.flush()
+                os.fsync(ledger_stream.fileno())
+                require((control / "private-state.json").read_bytes() == raw_state,
+                        "navia_private_state_readback")
+                record["private_state_sha256"] = chasca.gate.owned._sha256_file(control / "private-state.json")
+            chasca.gate.io._save(result_stream, record)
+        save()
+        chasca = observation_view(chasca, record, save)
+        cached, runtime_env = {}, {}
+        def environment(job):
+            job = prep.owned_job(chasca, job)
+            if not cached:
+                env, facts = chasca.gate.common._environment(job)
+                for key, relative in chasca.prep.ISOLATED_DIRS.items():
+                    (job / relative).mkdir(mode=0o700, exist_ok=True)
+                    env[key] = str(job / relative)
+                env.update(PYTHONNOUSERSITE="1", PYTHONDONTWRITEBYTECODE="1", PYTHONPATH=str(ROOT))
+                runtime, runtime_facts = chasca.gate.candidate_environment(env, os.environ)
+                runtime_env.update(runtime)
+                record["build_environment"], record["runtime_environment"] = facts, runtime_facts
+                cached.update(job=str(job), env=env)
+                save()
+            require(cached["job"] == str(job), "navia_environment_job_changed")
+            return dict(cached["env"])
+        def protected():
+            grant()
+            verify_project_sources(chasca, protocol["source_pins"], sealed=control / "sealed")
+            require(chasca.snapshot(protocol["pins"]) == protocol["before"], "navia_protected_state_drift")
+        def build(job):
+            return build_pair(chasca, job, patch=(control / "candidate.patch").read_bytes(),
+                common_helper=control / "sealed/navia_exact_pair_test.go", environment=environment,
+                record=record, save=save, allowance=allowance, scratch=scratch, require_grant=grant)
+        if args.operation == "compile_guards":
+            run_compile_guards(chasca, record, save, build=build, environment=environment,
+                scratch=scratch, allowance=allowance, protected=protected)
+        else:
+            adapter = load_sealed_wrapper(chasca, control / "sealed")
+            ledger_stream = (control / "private-state.json").open("xb")
+            try:
+                def no_cleanup_release():
+                    raise ValueError("navia_separate_cleanup_release_required")
+                sink = PrivatePairSink(chasca, export, protocol_sha256=protocol["_sha256"], record=record,
+                    save=save, allowance=allowance, scratch=scratch, require_grant=grant,
+                    require_cleanup_release=no_cleanup_release,
+                    budget_extra=lambda: chasca.gate.common._tree_bytes(control))
+                save()  # Persist private ownership state before any input/export side effect.
+                def prepare(job):
+                    from tools.experiments.gcsim.mvp_polish import direct_base_identity_witness as direct
+                    env = environment(job)
+                    child_env = direct.child_environment(dict(env, GTT_NAVIA_EXACT_SUPERVISED=ownership["token"]))
+                    process = chasca.run_phase(job, [str(direct.BASE), "-B", "-m",
+                        "tools.experiments.gcsim.mvp_polish.navia_exact_pair", "pair", "--protocol",
+                        str(args.protocol), "--protocol-sha256", protocol["_sha256"], "--worker",
+                        "--control", str(control), "--prepare-job", str(job)], "navia_exact_prepare",
+                        child_env, 90,
+                        "preparation.log", record=record, save=save, allowance=allowance, scratch=sink.scratch)
+                    require(chasca.gate.command_passed(process), "navia_private_prepare_child_failed")
+                    path = job / "preparation-callback.json"
+                    value = chasca.gate.read_json(path, 2 << 20)
+                    require(value.get("schema_kind") == "gtt_main_navia_prepare_transport_v1"
+                            and value.get("protocol_sha256") == protocol["_sha256"]
+                            and type(value.get("result")) is list and len(value["result"]) == 3,
+                            "navia_prepare_transport_binding")
+                    receipt, request, binding = value["result"]
+                    observed = prep.receipt_from_prepared({"request": request,
+                        "request_sha256": receipt["request_sha256"]},
+                        chasca.gate.io._read_optional(job / "prepared/request.json", prep.REQUEST_LIMIT),
+                        chasca.gate.io._read_optional(job / "prepared/set-sources.json", prep.SOURCE_LIMIT),
+                        lambda item: sha(canonical(item)))
+                    require(observed == receipt, "navia_prepare_transport_receipt")
+                    return receipt, request, binding
+                callback = make_prepare_and_build(chasca, prepare,
+                    patch=(control / "candidate.patch").read_bytes(),
+                    common_helper=control / "sealed/navia_exact_pair_test.go", environment=environment,
+                    record=record, save=save, allowance=allowance, scratch=sink.scratch,
+                    require_grant=grant, private_sink=sink)
+                adapter.run_owned_pair(chasca, record, save, callback, runtime_env,
+                    protocol["pins"], protocol["before"], sink.scratch, allowance, sink.export_required)
+            finally:
+                ledger_stream.close()
+    return 0 if record["status"] in ("compile_guards_passed_cleanup_confirmed",
+        "exact_pair_quality_exported_cleanup_confirmed") else 1
+
+
+def control_inventory(chasca, control):
+    files, _ = chasca.repro_paths(control)
+    return [{"path": path.relative_to(control).as_posix(), "bytes": path.stat().st_size,
+             "sha256": chasca.gate.owned._sha256_file(path)} for path in sorted(files)
+            if path != control / "control-manifest.json"]
+
+
+def cleanup_control_only(chasca, protocol, control, ownership, manifest):
+    """Retire only a reviewed failed compile control; no fabricated pair sink."""
+    release = protocol["cleanup"]
+    require(release.get("explicit_cleanup_authorized") is True
+            and release.get("private_state") is None and ownership["operation"] == "compile_guards",
+            "navia_control_only_release_required")
+    result_pin, marker_pin = release["original_result"], release["immutable_ownership"]
+    result_path, marker_path = Path(result_pin["path"]), Path(marker_pin["path"])
+    expected_result = ROOT / Path(SOURCE_PROTOCOL).parent / (
+        "navia-exact-" + protocol["lease_id"] + "-compile_guards.json")
+    require(result_path == expected_result and marker_path == result_path.with_name(
+        result_path.stem + "-ownership.json"), "navia_control_only_public_binding")
+    original = read_bound_json(result_path, result_pin["sha256"], 262144)
+    immutable = read_bound_json(marker_path, marker_pin["sha256"], 32768)
+    for name in ("owner", "protocol_sha256", "lease_id", "operation", "control", "export",
+                 "created_utc", "expires_utc"):
+        require(immutable.get(name) == ownership[name], "navia_control_only_immutable_owner")
+    require(original.get("owner") == OWNER and original.get("lease_id") == protocol["lease_id"]
+            and original.get("protocol_sha256") == ownership["protocol_sha256"]
+            and original.get("private_control_manifest", {}).get("sha256")
+                == release["control_manifest"]["sha256"], "navia_control_only_result_binding")
+    observation = original.get("supervisor_process", {}).get("exact_job_observation", {})
+    require(original.get("supervisor_start_attempted") is False or observation.get("idle") is True,
+            "navia_control_only_job_idle_unconfirmed")
+    allowed_files = {"ownership.json", "candidate.patch", "worker.json", "worker.log", "worker-result.json"}
+    allowed_files.update("sealed/" + name for name in WRAPPER_PINS)
+    require({row["path"] for row in manifest["files"]} <= allowed_files,
+            "navia_control_only_unexpected_file")
+    _, directories = chasca.repro_paths(control)
+    allowed_directories = {control, control / "sealed"} | {control / name for name in (
+        "temp", "appdata", "localappdata", "xdg-cache", "xdg-config", "xdg-state",
+        "gocache", "gomodcache", "gotmp", "gopath", "rules")}
+    require(set(directories) <= allowed_directories, "navia_control_only_unexpected_directory")
+    # The existing lease and probe remain gates; neither is described as the
+    # exact-job evidence above. Any foreign active worker blocks this cleanup.
+    with chasca.gate.managed.run_directory_lease(chasca.gate.managed.MANAGED_ROOT):
+        require(not tuple(chasca.gate.managed.MANAGED_ROOT.glob("job-*"))
+                and not chasca.gate.retirement._default_process_probe(ROOT), "navia_control_only_slot_not_idle")
+        with chasca.gate.managed.run_directory_lease(control.parent):
+            require(control_inventory(chasca, control) == manifest["files"], "navia_cleanup_control_changed")
+            removed = chasca.gate.managed.remove_owned_job(control, control.parent)
+    require(not control.exists(), "navia_control_only_cleanup_unconfirmed")
+    return {"owner": OWNER, "cleanup_scope": "control_only", "control_removed_bytes": removed,
+            "cleanup_status": "confirmed", "original_managed_job_deleted": False}
+
+
+def cleanup_private(chasca, protocol):
+    """Explicit hash-reviewed retirement of the export and sealed control job.
+
+    A failed original managed job is intentionally NOT removed here. Its semantic
+    recovery remains a separate release. Unobserved crash writes, collisions,
+    unknown files and changed hashes fail closed instead of invoking a sweeper.
+    """
+    release = protocol["cleanup"]
+    require(release.get("scope") in ("control_only", "pair_capsule"), "navia_cleanup_scope_required")
+    manifest_pin = release["control_manifest"]
+    manifest_path = Path(manifest_pin["path"])
+    control = manifest_path.parent
+    require(control.resolve().parent == (ROOT / CONTROL_ROOT).resolve()
+            and control.name == "job-" + protocol["lease_id"]
+            and manifest_path == control / "control-manifest.json", "navia_cleanup_control_binding")
+    for path in (control, manifest_path):
+        chasca.gate.managed.assert_unlinked(path)
+    ownership = chasca.gate.read_json(control / "ownership.json", 32768)
+    require(ownership["owner"] == OWNER and ownership["lease_id"] == protocol["lease_id"]
+            and ownership["protocol_sha256"] == release["original_protocol_sha256"]
+            and ownership["identity"] == PrivatePairSink._identity(control), "navia_cleanup_control_owner")
+    manifest = read_bound_json(manifest_path, manifest_pin["sha256"])
+    require(manifest == {"owner": OWNER, "protocol_sha256": release["original_protocol_sha256"],
+                         "files": control_inventory(chasca, control)},
+            "navia_cleanup_inventory_or_state_drift")
+    if release["scope"] == "control_only":
+        return cleanup_control_only(chasca, protocol, control, ownership, manifest)
+    state_pin = release["private_state"]
+    state_path = Path(state_pin["path"])
+    require(state_path == control / "private-state.json", "navia_cleanup_private_state_binding")
+    state = read_bound_json(state_path, state_pin["sha256"], 2 << 20)
+    require(state["protocol_sha256"] == release["original_protocol_sha256"],
+            "navia_cleanup_inventory_or_state_drift")
+    require(not chasca.gate.retirement._default_process_probe(ROOT), "navia_cleanup_processes_active")
+    sink = restore_sink(chasca, state, save=lambda: None,
+        require_cleanup_release=lambda: require(release.get("explicit_cleanup_authorized") is True,
+                                                "navia_explicit_private_cleanup_release_required"))
+    require(sink.export == ROOT / PRIVATE_ROOT / ("job-" + protocol["lease_id"]),
+            "navia_cleanup_export_binding")
+    result = sink.cleanup(release["shared_capsule_sha256"])
+    with chasca.gate.managed.run_directory_lease(control.parent):
+        require(control_inventory(chasca, control) == manifest["files"], "navia_cleanup_control_changed")
+        result["control_removed_bytes"] = chasca.gate.managed.remove_owned_job(control, control.parent)
+    result["original_managed_job_deleted"] = False
+    return result
+
+
+def execute(protocol, args):
+    """One finite supervisor; the unchanged W2 wrapper owns the sole pair job."""
+    result = ROOT / protocol["result"]
+    require(result.parent.resolve() == (ROOT / Path(SOURCE_PROTOCOL).parent).resolve()
+            and result.name == "navia-exact-" + protocol["lease_id"] + "-" + args.operation + ".json",
+            "navia_public_result_scope")
+    require(result.parent.is_dir() and not result.exists(), "navia_public_result_already_exists")
+    control = ROOT / CONTROL_ROOT / ("job-" + protocol["lease_id"])
+    marker = result.with_name(result.stem + "-ownership.json")
+    # No production imports or outside directory creation before durable failure ownership.
+    ownership = {"owner": OWNER, "protocol_sha256": protocol["_sha256"],
+        "lease_id": protocol["lease_id"], "operation": args.operation, "control": str(control),
+        "export": str(ROOT / PRIVATE_ROOT / ("job-" + protocol["lease_id"])),
+        "created_utc": datetime.now(timezone.utc).isoformat(),
+        "expires_utc": (datetime.now(timezone.utc) + timedelta(hours=24)).isoformat()}
+    from tools import managed_optimizer_experiment as managed
+    managed.assert_unlinked(result)
+    managed.assert_unlinked(marker)
+    immutable_raw = canonical({**ownership, "status": "failure_retention_required_until_completion",
+        "engine_calls": None, "full_search_calls": None, "counters": "unknown_not_zero"})
+    with marker.open("xb") as initial:
+        initial.write(immutable_raw)
+        initial.flush()
+        os.fsync(initial.fileno())
+    require(marker.read_bytes() == immutable_raw, "navia_initial_ownership_readback")
+    status_path = marker.with_name(marker.stem + "-status.json")
+    managed.assert_unlinked(status_path)
+    with status_path.open("xb") as status_stream:
+        failure_save = deadline_status_writer(status_stream, status_path, ownership, marker, immutable_raw)
+        deadline = TotalDeadline(protocol["limits"]["whole_seconds"], failure_save).start()
+        outer_record = {"supervisor_start_attempted": False}
+        try:
+            chasca = import_main_services(protocol)
+            chasca.gate.managed.assert_unlinked(result)
+            chasca.gate.managed.assert_unlinked(marker)
+            if args.operation == "cleanup_private":
+                outcome = cleanup_private(chasca, protocol)
+                exclusive_raw(chasca, result, canonical(outcome), 262144)
+                failure_save({"status": "explicit_private_cleanup_confirmed", "cleanup_status": "confirmed"})
+                return 0
+            require(not args.worker and args.control is None and args.prepare_job is None,
+                    "navia_supervisor_arguments")
+            require(not control.exists() and chasca.gate.managed.MANAGED_ROOT.is_dir()
+                    and not tuple(chasca.gate.managed.MANAGED_ROOT.glob("job-*"))
+                    and not chasca.gate.retirement._default_process_probe(ROOT), "navia_shared_slot_not_idle")
+            require(args.operation != "pair" or not (ROOT / PRIVATE_ROOT /
+                    ("job-" + protocol["lease_id"])).exists(), "navia_private_export_already_exists")
+            require(chasca.snapshot(protocol["pins"]) == protocol["before"], "navia_before_state_drift")
+            deadline.allowance(1)
+            for parent in (ROOT / CONTROL_ROOT, ROOT / PRIVATE_ROOT):
+                chasca.gate.managed.assert_unlinked(parent)
+                parent.mkdir(mode=0o700, exist_ok=True)
+            # The public marker already owns the exact prospective path. A collision
+            # here never grants ownership of, or deletes, that preexisting path.
+            control.mkdir(mode=0o700)
+            with failure_save.lock:
+                ownership.update(identity=PrivatePairSink._identity(control), supervisor_pid=os.getpid(),
+                    hard_deadline_monotonic=deadline.started + deadline.seconds, token=os.urandom(24).hex())
+            failure_save({"status": "control_allocated_failure_retained", "engine_calls": None,
+                          "full_search_calls": None, "cleanup_status": "not_confirmed"})
+            exclusive_raw(chasca, control / "ownership.json", canonical(ownership), 32768)
+            seal_packet(chasca, protocol, control)
+            build_env, _ = chasca.gate.common._environment(control)
+            env, _ = chasca.gate.candidate_environment(build_env, os.environ)
+            env.update(PYTHONNOUSERSITE="1", PYTHONDONTWRITEBYTECODE="1", PYTHONPATH=str(ROOT),
+                       GTT_NAVIA_EXACT_SUPERVISED=ownership["token"])
+            # Existing Windows job-list containment includes prepare_d's git-show
+            # grandchildren, the preparation child and the cold Go binaries.
+            from tools.experiments.gcsim.mvp_polish import direct_base_identity_witness as direct
+            env = direct.child_environment(env)
+            command = [str(direct.BASE), "-B", "-m",
+                "tools.experiments.gcsim.mvp_polish.navia_exact_pair", args.operation,
+                "--protocol", str(args.protocol), "--protocol-sha256", protocol["_sha256"],
+                "--worker", "--control", str(control)]
+            def save_outer():
+                failure_save({"status": "supervised_child_failure_retention_required", **outer_record})
+            outer_runner = observation_view(chasca, outer_record, save_outer).gate.owned._run_owned
+            outer_record["supervisor_start_attempted"] = True
+            process = outer_runner(command, command_kind="navia_exact_supervisor",
+                env=env, log_path=control / "worker.log", timeout_seconds=deadline.allowance(1200))
+            deadline.allowance(1)
+            worker_path = control / "worker-result.json"
+            observed = (chasca.gate.read_json(worker_path, 262144) if worker_path.is_file() else
+                {"protocol_sha256": protocol["_sha256"], "owner": OWNER, "status": "failed",
+                 "errors": ["worker_receipt_unavailable"], "engine_calls": None,
+                 "full_search_calls": None, "private_raw_retained": True})
+            require(observed.get("protocol_sha256") == protocol["_sha256"], "navia_worker_receipt_binding")
+            inventory = {"owner": OWNER, "protocol_sha256": protocol["_sha256"],
+                         "files": control_inventory(chasca, control)}
+            receipt = exclusive_raw(chasca, control / "control-manifest.json", canonical(inventory), 1 << 20)
+            outcome = {**observed, "owner": OWNER, "lease_id": protocol["lease_id"],
+                       "supervisor_start_attempted": True, "supervisor_process": process,
+                       "private_control_manifest": receipt,
+                       "private_control_expires_utc": ownership["expires_utc"]}
+            expected = ("compile_guards_passed_cleanup_confirmed" if args.operation == "compile_guards"
+                        else "exact_pair_quality_exported_cleanup_confirmed")
+            passed = (chasca.gate.command_passed(process) and observed.get("status") == expected
+                      and outer_record.get("owned_cleanup_latch") is True)
+            if not passed:
+                outcome["status"] = "failed"
+            deadline.allowance(1)
+            if args.operation == "compile_guards" and passed:
+                with chasca.gate.managed.run_directory_lease(control.parent):
+                    require(control_inventory(chasca, control) == inventory["files"],
+                            "navia_compile_control_changed")
+                    outcome["control_removed_bytes"] = chasca.gate.managed.remove_owned_job(control, control.parent)
+                outcome["control_cleanup_status"] = "confirmed"
+            else:
+                outcome["control_cleanup_status"] = "retained_private_24h_explicit_cleaner_release_required"
+            exclusive_raw(chasca, result, canonical(outcome), 262144)
+            failure_save({"status": "completed" if passed else "failed_ownership_retained",
+                "engine_calls": observed.get("engine_calls"),
+                "full_search_calls": observed.get("full_search_calls"),
+                "cleanup_status": outcome["control_cleanup_status"]})
+            return 0 if passed else 1
+        except BaseException:
+            # Pre-launch source/sealing failure can still leave known partial
+            # owned files. Export their real inventory and immutable binding for
+            # control_only review. Unknown running descendants get NO such gate.
+            if (args.operation == "compile_guards" and ownership.get("identity") is not None
+                    and outer_record["supervisor_start_attempted"] is False
+                    and control.is_dir() and PrivatePairSink._identity(control) == ownership["identity"]
+                    and (control / "ownership.json").is_file() and not result.exists()
+                    and not (control / "control-manifest.json").exists()):
+                try:
+                    manifest = {"owner": OWNER, "protocol_sha256": protocol["_sha256"],
+                                "files": control_inventory(chasca, control)}
+                    receipt = exclusive_raw(chasca, control / "control-manifest.json", canonical(manifest), 1 << 20)
+                    exclusive_raw(chasca, result, canonical({"owner": OWNER, "status": "failed",
+                        "protocol_sha256": protocol["_sha256"], "lease_id": protocol["lease_id"],
+                        "supervisor_start_attempted": False, "private_control_manifest": receipt,
+                        "control_cleanup_status": "retained_24h_explicit_control_only_release_required",
+                        "engine_calls": 0, "full_search_calls": 0}), 262144)
+                except Exception:
+                    pass  # Initial immutable ownership remains; never retry or delete.
+            raise
+        finally:
+            deadline.close()
+            failure_save.close()
+
+
+def main(argv=None):
+    args = cli_parser().parse_args(argv)
+    require(re.fullmatch("[0-9a-f]{64}", args.protocol_sha256 or "") is not None,
+            "navia_protocol_sha256_required")
+    value = read_bound_json(args.protocol, args.protocol_sha256)
+    if args.operation == "draft":
+        require(not args.worker and args.control is None and args.prepare_job is None, "navia_draft_arguments")
+        value = draft_protocol(value, args.draft_operation, args.private_input, args.private_input_sha256)
+        print(json.dumps(value, sort_keys=True, indent=2, allow_nan=False))
+        return 0
+    value = validate_protocol(value, args.operation)
+    value["_sha256"] = args.protocol_sha256
+    if args.worker:
+        require(args.control is not None and args.operation in ("compile_guards", "pair"),
+                "navia_worker_arguments")
+        return worker_execute(import_main_services(value), value, args)
+    require(args.private_input is None and args.private_input_sha256 is None,
+            "navia_private_input_must_be_protocol_bound")
+    return execute(value, args)
+
+
+if __name__ == "__main__":
+    sys.dont_write_bytecode = True
+    raise SystemExit(main())
diff --git a/tools/experiments/gcsim/mvp_polish/navia_gap_point/prepare_v4.py b/tools/experiments/gcsim/mvp_polish/navia_gap_point/prepare_v4.py
