+++ b/tools/experiments/gcsim/mvp_polish/candidate_preservation_measure.py
@@ -0,0 +1,1096 @@
+"""Source-only arm adapter for the finite, frozen preservation comparison.
+
+The owning controller supplies its managed command runner and frozen phase caps.
+This module stages no engine or account data and has no executable entry point.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import gzip
+import math
+from pathlib import Path
+import re
+import subprocess
+import sys
+import time
+from typing import Callable
+
+from tools.experiments.gcsim.mvp_polish import candidate_preservation_run as scope
+from tools.experiments.gcsim.mvp_polish import candidate_preservation_case as selected_case
+from tools.experiments.gcsim.mvp_polish import health_unified_cases as cases
+from tools.experiments.gcsim.mvp_polish import case_data
+from tools.experiments.gcsim.mvp_polish.navia_exact_pair import function_view
+from run_workspace.gcsim.artifact_runner import (
+    DEFAULT_GCSIM_CONFIG_FILENAME, DEFAULT_GCSIM_RESULT_FILENAME,
+    run_active_gcsim_artifact,
+)
+from run_workspace.gcsim.optimizer_config import apply_gcsim_optimizer_worker_budget
+
+
+CASE = Path(selected_case.__file__)
+Command = Callable[[str, list[object], Path, dict[str, str], int], dict]
+MAX_RAW_EXPORT = 96 << 20
+MAX_TOTAL_EXPORT = 512 << 20
+MAX_SCRATCH = 3 << 30
+PACKET_SCHEMA = "candidate_preservation_one_case_packet_v1"
+
+
+def stage_fixed_binding(job: Path) -> Path:
+    """Pin the already installed engine for both fresh arms; no store write."""
+    job = cases.owned_job(job)
+    store = scope.accepted.engine_store.GcsimEngineStore(
+        scope.ROOT / "data/gcsim/engines")
+    if store.active_engine_id() != scope.accepted.runtime.ENGINE_ID:
+        raise ValueError("preservation_active_engine_id_changed")
+    engine_root = store.engines_dir / scope.accepted.runtime.ENGINE_ID
+    context, wire = scope.accepted.runtime.prepare_v4.candidate_binding(engine_root)
+    if (context.artifact_sha256 != scope.ENGINE_SHA
+            or wire.get("artifact_sha256") != scope.ENGINE_SHA):
+        raise ValueError("preservation_active_engine_artifact_changed")
+    path = job / "fixed-engine-binding.json"
+    cases.write_once(path, wire)
+    if cases.binding_input(job, path, "candidate") != wire:
+        raise ValueError("preservation_fixed_binding_roundtrip")
+    return path
+
+
+def fixed_case_binding(job: Path, path: Path, arm: str) -> dict:
+    """Use the existing strict binding check with this packet's fixed engine."""
+    return function_view(cases.binding_input, CONTROL_ENGINE_SHA=scope.ENGINE_SHA)(job, path, arm)
+
+
+def stage_control_winner_input(job: Path, case: str, observed: dict) -> dict:
+    """Prepare the Go verifier-only input from a fresh physically joined winner."""
+    job = cases.owned_job(job)
+    if observed.get("arm") != "control" or observed.get("case") != case:
+        raise ValueError("preservation_control_winner_arm_invalid")
+    folder = job / ("control" if case == "tighnari" else "cases/" + case + "/control")
+    if case in ("tighnari", "chasca"):
+        run_dir = folder
+        native_path = folder / "verification/all-sets-result.json"
+    else:
+        selected = json.loads(cases.read(folder / "selected-result.json", 4 << 20))
+        run_dir = Path(selected["run_dir"]).resolve(strict=True)
+        if not run_dir.is_relative_to(folder.resolve(strict=True)):
+            raise ValueError("preservation_control_selected_run_outside_case")
+        native_path = run_dir / "optimizer-output.json"
+    native = json.loads(cases.read(native_path, MAX_RAW_EXPORT))
+    winner = scope.control_winner_evidence(run_dir, native, scope.COUNTS[case])
+    observed_rows = observed["cohort"]["rows"]
+    if len([row for row in observed_rows if
+            row["assignment_sha256"] == winner["assignment_sha256"]
+            and row["config_sha256"] == winner["config_sha256"]
+            and row["engine_result_sha256"] == winner["engine_result_sha256"]]) != 1:
+        raise ValueError("preservation_control_observed_winner_drift")
+    independent_root = folder / "independent-validation"
+    if independent_root.exists():
+        raise ValueError("preservation_control_independent_repeat")
+    all_sets = case in ("tighnari", "chasca")
+    manifest = {"schema_kind": "gtt_optimizer_research_winner_input_v1",
+                "identity_kind": ("gtt_research_all_sets_rendered_config_v1" if all_sets
+                                  else "gtt_research_rendered_config_v1"),
+                "assignment_mode": "all_sets" if all_sets else "selected",
+                "assignment": winner["assignment"],
+                "assignment_sha256": winner["assignment_sha256"],
+                "config_sha256": winner["config_sha256"],
+                "baseline_result_sha256": winner["engine_result_sha256"],
+                "baseline_winner_rank": winner["rank"],
+                "workers": winner["workers"]}
+    if all_sets:
+        manifest["set_group_key"] = winner["set_group_key"]
+    manifest_path = folder / "independent-candidate.json"
+    cases.write_once(manifest_path, manifest)
+    return {"manifest_path": str(manifest_path),
+            "manifest_sha256": scope.sha(cases.read(manifest_path)),
+            "request_path": str(folder / "request.json"),
+            "config_path": winner["config_path"],
+            "baseline_result_path": winner["result_path"],
+            "run_root": str(independent_root),
+            "baseline_winner": winner}
+
+
+def run_control_heldout(job: Path, case: str, observed: dict,
+                        command: Command, maximum: int, consumer: Path,
+                        consumer_sha256: str) -> dict:
+    """Validate the frozen product winner once with 16 workers, without search."""
+    adapter_started = time.monotonic()
+    staged = stage_control_winner_input(job, case, observed)
+    selected_case.admit_consumer(job, "candidate", consumer, consumer_sha256)
+    folder = job / ("control" if case == "tighnari" else "cases/" + case + "/control")
+    manifest = json.loads(cases.read(Path(staged["manifest_path"]), 4 << 20))
+    request = json.loads(cases.read(Path(staged["request_path"]), 4 << 20))
+    baseline_config = cases.read(Path(staged["config_path"]), MAX_RAW_EXPORT)
+    baseline_raw = cases.read(Path(staged["baseline_result_path"]), MAX_RAW_EXPORT)
+    baseline = json.loads(baseline_raw)
+    if (scope.sha(baseline_config) != manifest["config_sha256"]
+            or scope.sha(baseline_raw) != manifest["baseline_result_sha256"]
+            or baseline.get("statistics", {}).get("iterations") != 500
+            or baseline.get("simulator_settings", {}).get("number_of_workers") != manifest["workers"]):
+        raise ValueError("preservation_control_baseline_changed")
+    source_text = baseline_config.decode("utf-8")
+    if not exact_engine_config_text(source_text, baseline.get("config_file")):
+        raise ValueError("preservation_control_baseline_config_not_bound")
+    target_text = apply_gcsim_optimizer_worker_budget(source_text, 16)
+    if apply_gcsim_optimizer_worker_budget(target_text, manifest["workers"]) != source_text:
+        raise ValueError("preservation_control_worker_rewrite_not_reversible")
+    expected_binding = request["engine"]
+
+    def seal_binding() -> None:
+        store = scope.accepted.engine_store.GcsimEngineStore(
+            scope.ROOT / "data/gcsim/engines")
+        if store.active_engine_id() != scope.accepted.runtime.ENGINE_ID:
+            raise ValueError("preservation_control_active_engine_changed")
+        engine_root = store.engines_dir / scope.accepted.runtime.ENGINE_ID
+        _, actual = scope.accepted.runtime.prepare_v4.candidate_binding(engine_root)
+        if (actual != expected_binding or actual["artifact_sha256"] != scope.ENGINE_SHA
+                or scope.sha(scope.bounded(Path(actual["binary_path"]), MAX_RAW_EXPORT)) != scope.ENGINE_SHA):
+            raise ValueError("preservation_control_engine_binding_changed")
+
+    seal_binding()
+    run_root = Path(staged["run_root"])
+    owned_command = {}
+
+    def owned_runner(args: tuple[str, ...], cwd: Path, _ambient: dict[str, str],
+                     timeout: int) -> subprocess.CompletedProcess[str]:
+        if owned_command:
+            raise ValueError("preservation_control_heldout_repeat")
+        if (Path(args[0]).resolve(strict=True) != Path(expected_binding["binary_path"]).resolve(strict=True)
+                or tuple(args[1:]) != ("-c", DEFAULT_GCSIM_CONFIG_FILENAME,
+                                       "-out", DEFAULT_GCSIM_RESULT_FILENAME)
+                or cwd.resolve(strict=True) != run_root.resolve(strict=True)):
+            raise ValueError("preservation_control_artifact_command_changed")
+        submitted = cases.read(cwd / DEFAULT_GCSIM_CONFIG_FILENAME, MAX_RAW_EXPORT).decode("utf-8")
+        if (submitted not in (target_text, target_text.replace("\n", "\r\n"))
+                or apply_gcsim_optimizer_worker_budget(
+                    submitted.replace("\r\n", "\n"), manifest["workers"])
+                    != source_text.replace("\r\n", "\n")):
+            raise ValueError("preservation_control_written_budget_changed")
+        owned_command.update(command(case + "-control-heldout", list(args), cwd,
+            {"GTT_RULE_CACHE_DIR": str(folder / "rule-cache")}, min(maximum, timeout)))
+        return subprocess.CompletedProcess(args, 0, "", "")
+
+    artifact = run_active_gcsim_artifact(target_text,
+        store_dir=scope.ROOT / "data/gcsim/engines", run_dir=run_root,
+        timeout_seconds=maximum, runner=owned_runner,
+        expected_engine_id=scope.accepted.runtime.ENGINE_ID,
+        enable_shipped_fallback=False)
+    seal_binding()
+    if (not artifact.success or artifact.status != "passed" or not owned_command
+            or Path(artifact.artifact_path).resolve(strict=True) !=
+               Path(expected_binding["binary_path"]).resolve(strict=True)
+            or Path(artifact.config_path).resolve(strict=True) !=
+               (run_root / DEFAULT_GCSIM_CONFIG_FILENAME).resolve(strict=True)
+            or Path(artifact.result_path).resolve(strict=True) !=
+               (run_root / DEFAULT_GCSIM_RESULT_FILENAME).resolve(strict=True)):
+        raise ValueError("preservation_control_artifact_run_invalid")
+    config_raw = cases.read(Path(artifact.config_path), MAX_RAW_EXPORT)
+    result_raw = cases.read(Path(artifact.result_path), MAX_RAW_EXPORT)
+    engine_result = json.loads(result_raw)
+    validate_worker16_result(config_raw, engine_result, source_text,
+                             manifest["workers"], artifact.summary)
+    receipt = {"schema": "candidate_preservation_python_heldout_v1", "complete": True,
+               "source": "installed_active_gcsim_artifact", "case": case,
+               "baseline_manifest_sha256": staged["manifest_sha256"],
+               "baseline_config_sha256": manifest["config_sha256"],
+               "baseline_result_sha256": manifest["baseline_result_sha256"],
+               "baseline_workers": manifest["workers"], "baseline_iterations": 500,
+               "submitted_config_sha256": scope.sha(config_raw),
+               "returned_config_sha256": scope.sha(engine_result["config_file"].encode("utf-8")),
+               "result_sha256": scope.sha(result_raw), "workers": 16,
+               "iterations": 500, "mean_dps": artifact.summary.dps_mean,
+               "standard_error": artifact.summary.dps_se,
+               "engine_binding_sha256": expected_binding["binding_sha256"],
+               "engine_artifact_sha256": scope.ENGINE_SHA,
+               "ordinary_wall_seconds": owned_command["wall_seconds"],
+               "adapter_wall_seconds": time.monotonic() - adapter_started,
+               "independence_basis": "new owned run directory and one fresh ordinary batch; no search feedback"}
+    receipt_path = run_root / "independent-python-v1.json"
+    cases.write_once(receipt_path, receipt)
+    output = {"calls": 1, "iterations": 500, "workers": 16,
+              "measured_dps": receipt["mean_dps"], "standard_error": receipt["standard_error"],
+              "assignment_mode": manifest["assignment_mode"],
+              "set_group_key": manifest.get("set_group_key"),
+              "typed_manifest_sha256": staged["manifest_sha256"],
+              "baseline_config_sha256": manifest["config_sha256"],
+              "baseline_result_sha256": manifest["baseline_result_sha256"],
+              "config_sha256": receipt["submitted_config_sha256"],
+              "engine_result_sha256": receipt["result_sha256"],
+              "config_path": str(artifact.config_path),
+              "result_path": str(artifact.result_path),
+              "receipt_sha256": scope.sha(cases.read(receipt_path, 4 << 20)),
+              "command_wall_seconds": owned_command["wall_seconds"],
+              "adapter_wall_seconds": time.monotonic() - adapter_started,
+              "selection_role": "fresh 16-worker n500 after product winner frozen; no search"}
+    return scope.validate_independent_result(output)
+
+
+def valid_embedded_worker_config(written: str, embedded: object,
+                                 baseline: str, baseline_workers: int) -> bool:
+    """Match the pinned engine ReadConfig line normalization and reversible options."""
+    if not exact_engine_config_text(written, embedded):
+        return False
+    normalized = written.replace("\r\n", "\n")
+    try:
+        return (apply_gcsim_optimizer_worker_budget(normalized, baseline_workers)
+                == baseline.replace("\r\n", "\n"))
+    except ValueError:
+        return False
+
+
+def exact_engine_config_text(submitted: str, embedded: object) -> bool:
+    """The pinned Go engineclient expectedEngineConfigText identity rule."""
+    if type(embedded) is not str or "\r\n" in embedded:
+        return False
+    normalized = submitted.replace("\r\n", "\n")
+    if any(re.fullmatch(r'import "(.+)"', row) for row in normalized.split("\n")):
+        return False
+    return embedded == normalized + "\n"
+
+
+def validate_worker16_result(config_raw: bytes, engine_result: dict,
+                             baseline: str, baseline_workers: int,
+                             summary: object) -> None:
+    """Check physical config, engine echo, budget, and parsed n500 statistics."""
+    written = config_raw.decode("utf-8")
+    expected = apply_gcsim_optimizer_worker_budget(baseline, 16)
+    settings = engine_result.get("simulator_settings")
+    statistics = engine_result.get("statistics")
+    dps = statistics.get("dps") if type(statistics) is dict else None
+    mean = dps.get("mean") if type(dps) is dict else None
+    deviation = dps.get("sd") if type(dps) is dict else None
+    parsed_mean = getattr(summary, "dps_mean", None)
+    parsed_se = getattr(summary, "dps_se", None)
+    if (written not in (expected, expected.replace("\n", "\r\n"))
+            or not valid_embedded_worker_config(written, engine_result.get("config_file"),
+                                                baseline, baseline_workers)
+            or type(settings) is not dict or settings.get("number_of_workers") != 16
+            or type(statistics) is not dict or statistics.get("iterations") != 500
+            or getattr(summary, "iterations", None) != 500
+            or any(type(value) not in (int, float) or not math.isfinite(value)
+                   for value in (mean, deviation, parsed_mean, parsed_se))
+            or deviation < 0 or parsed_se < 0
+            or not math.isclose(mean, parsed_mean, rel_tol=0, abs_tol=1e-9)
+            or not math.isclose(deviation / math.sqrt(500), parsed_se,
+                                rel_tol=0, abs_tol=1e-9)):
+        raise ValueError("preservation_control_independent_physical_mismatch")
+
+
+def prepare_regression(job: Path, case: str, arm: str, binding_path: Path,
+                       consumer: Path, consumer_sha: str) -> dict:
+    """Reuse the accepted four-case fixture and wire preparer exactly once."""
+    if case not in cases.CASES:
+        raise ValueError("preservation_case_unknown")
+    return selected_case.run(job, case, arm, "prepare", binding_path, consumer, consumer_sha)
+
+
+def prepare_tighnari(job: Path, arm: str, binding_path: Path) -> dict:
+    """Stage the archived 597-artifact wire with only its binary path rebound."""
+    if arm not in ("control", "candidate"):
+        raise ValueError("preservation_arm_invalid")
+    job = cases.owned_job(job)
+    # The existing control validator reads control/request.json, which this
+    # preparer is about to write; use its same candidate-shape validation first.
+    binding = fixed_case_binding(job, binding_path, "candidate")
+    scope.fixed_binding(binding, Path(binding["binary_path"]))
+    archive = scope.accepted.FROZEN_CANDIDATE_REQUEST
+    freeze = json.loads(scope.bounded(scope.EVIDENCE / "health-unified-uptake-v7-freeze.json", 8 << 20))
+    compressed = scope.bounded(archive, 4 << 20)
+    if scope.sha(compressed) != freeze["frozen_plan"]["v4_candidate_request_archive_sha256"]:
+        raise ValueError("preservation_tighnari_archive_changed")
+    source = json.loads(gzip.decompress(compressed))
+    if (len(source.get("artifacts", [])) != 597
+            or source.get("stochastic", {}).get("seeds") != cases.SEEDS):
+        raise ValueError("preservation_tighnari_fixture_changed")
+    request = {**source, "engine": binding}
+    folder = job / arm
+    folder.mkdir(exist_ok=True)
+    cases.write_once(folder / "request.json", request)
+    if arm == "control":
+        fixed_case_binding(job, binding_path, "control")
+    from run_workspace.gcsim.optimizer_go_all_sources import prepare_all_set_effect_sources
+    engine_root = Path(binding["binary_path"]).resolve(strict=True).parent.parent
+    sources = prepare_all_set_effect_sources(engine_root, binding, include_neutral_rules=True)
+    cases.write_once(folder / "set-sources.json", sources)
+    return {"request_sha256": scope.sha(cases.read(folder / "request.json")),
+            "set_sources_sha256": scope.sha(cases.read(folder / "set-sources.json")),
+            "source_archive_sha256": scope.sha(compressed),
+            "artifacts": 597, "seeds": list(cases.SEEDS)}
+
+
+def stage_candidate_overlay(job: Path, frozen_delta_hashes: dict[str, str]) -> dict:
+    """Stage one consumer build from accepted bytes plus the reviewed delta."""
+    job = cases.owned_job(job)
+    base = scope.accepted_product_images()
+    delta = {relative: scope.bounded(scope.NATIVE / relative)
+             for relative in frozen_delta_hashes}
+    images = scope.admitted_delta(base, delta, frozen_delta_hashes)
+    physical = {path.relative_to(scope.NATIVE).as_posix()
+                for path in scope.NATIVE.rglob("*.go")}
+    if tuple(sorted(physical - set(images))) != scope.accepted.FOREIGN_TEST_EXCLUSIONS:
+        raise ValueError("preservation_unlisted_physical_go_source")
+    replacements = {}
+    for relative, raw in sorted(images.items()):
+        staged = job / "candidate-source" / relative
+        staged.parent.mkdir(parents=True, exist_ok=True)
+        staged.write_bytes(raw)
+        replacements[str(scope.NATIVE / relative)] = str(staged)
+    overlay = job / "candidate-overlay.json"
+    cases.write_once(overlay, {"Replace": replacements})
+    return {"path": str(overlay), "sha256": scope.sha(cases.read(overlay)),
+            "images": len(images), "accepted_images": len(base),
+            "delta_hashes": dict(frozen_delta_hashes)}
+
+
+def build_candidate_once(job: Path, frozen_delta_hashes: dict[str, str],
+                         command: Command, build_seconds: int) -> dict:
+    """One staged consumer build; caller owns the whole-job clock and cleanup."""
+    if type(build_seconds) is not int or not 0 < build_seconds <= 600:
+        raise ValueError("preservation_build_cap_invalid")
+    overlay = stage_candidate_overlay(job, frozen_delta_hashes)
+    binary = job / "product-candidate.exe"
+    receipt = command("consumer-build",
+                      [scope.accepted.K.gate.owned.GO_EXE, "-C", scope.NATIVE,
+                       "build", "-p=1", "-mod=readonly", "-buildvcs=false",
+                       "-overlay=" + overlay["path"], "-o", binary,
+                       "./cmd/gtt-optimizer"], scope.NATIVE, {}, build_seconds)
+    if not binary.is_file():
+        raise ValueError("preservation_candidate_build_missing")
+    return {"overlay": overlay, "binary_path": str(binary),
+            "binary_sha256": scope.sha(scope.bounded(binary)),
+            "command_wall_seconds": receipt.get("wall_seconds")}
+
+
+def run_arm(job: Path, case: str, arm: str, *, binding_path: Path,
+            consumer: Path, consumer_sha: str, phase_seconds: int,
+            command: Command, adaptive_route: tuple[str, ...] | None = None,
+            policy_sha256: str | None = None) -> dict:
+    """One already-staged arm; final cohort is joined from actual verifier files."""
+    if (case not in scope.ORDER or arm not in ("control", "candidate")
+            or type(phase_seconds) is not int or phase_seconds <= 0):
+        raise ValueError("preservation_arm_admission")
+    job = cases.owned_job(job)
+    selected_case.admit_consumer(job, arm, consumer, consumer_sha)
+    folder = job / (arm if case == "tighnari" else "cases/" + case + "/" + arm)
+    wire = json.loads(cases.read(folder / "request.json", 4 << 20))
+    binding = fixed_case_binding(job, binding_path,
+                                 arm if case == "tighnari" else "candidate")
+    if wire.get("engine") != binding or binding["artifact_sha256"] != scope.ENGINE_SHA:
+        raise ValueError("preservation_arm_binding_drift")
+    cache = folder / "rule-cache"
+    cache.mkdir()
+    env = {"GTT_RULE_CACHE_DIR": str(cache), "GTT_RULE_BUNDLED_CACHE_DIR":
+           str(scope.NATIVE / "set-rule-cache"), "GTT_SCRATCH_DIR": str(job)}
+    if case in ("tighnari", "chasca"):
+        # The candidate command is intentionally absent until the saved adaptive
+        # policy names its production-neutral CLI route. A default command here
+        # would silently measure the unchanged fixed-finalist verifier.
+        if arm == "candidate":
+            if (type(adaptive_route) is not tuple or not adaptive_route
+                    or any(type(part) is not str or not part for part in adaptive_route)):
+                raise ValueError("preservation_adaptive_route_not_frozen")
+            if adaptive_route == ("optimize-all-sets",):
+                raise ValueError("preservation_adaptive_route_is_default")
+            route = adaptive_route
+        elif adaptive_route is not None:
+            raise ValueError("preservation_control_route_changed")
+        else:
+            route = ("optimize-all-sets",)
+        verification = folder / "verification"
+        result = command(case + "-" + arm,
+                         [consumer, *route, folder / "request.json",
+                          folder / "set-sources.json", verification], job, env, phase_seconds)
+        native = json.loads(cases.read(verification / "all-sets-result.json"))
+        observed = scope.observed_all_sets(folder, native, scope.COUNTS[case],
+                                           research=arm == "candidate")
+        observed["all_sets_route"] = list(route)
+    else:
+        policy_switch = ["--adaptive-selected"] if arm == "candidate" else []
+        result = command(case + "-" + arm,
+                         [sys.executable, "-B", "-m",
+                          "tools.experiments.gcsim.mvp_polish.candidate_preservation_case",
+                          "--job", job, "--case", case, "--arm", arm,
+                          "--stage", "selected", "--binding", binding_path,
+                          "--consumer", consumer, "--consumer-sha", consumer_sha,
+                          *policy_switch],
+                         scope.ROOT, env, phase_seconds)
+        output = json.loads(cases.read(folder / "selected-result.json", 4 << 20))
+        observed = scope.observed_selected(output, scope.COUNTS[case],
+                                           research=arm == "candidate")
+        observed["selected_receipt_sha256"] = scope.sha(cases.read(folder / "selected-result.json"))
+        verification = Path(output["run_dir"]).resolve(strict=True) / "verification"
+    if arm == "candidate":
+        # The later frozen ledger reader validates its typed contents and hard
+        # call/iteration limits. Mere file presence is not policy acceptance.
+        sidecar = verification / "adaptive-research-v1.json"
+        research_raw = cases.read(sidecar, 4 << 20)
+        if not scope._digest(policy_sha256):
+            raise ValueError("preservation_policy_sha_not_frozen")
+        observed["adaptive_research"] = scope.adaptive_ledger_summary(
+            research_raw, initial_cap=7 if case in ("tighnari", "chasca") else 5,
+            expected_policy_sha256=policy_sha256)
+        observed["adaptive_research_sidecar_sha256"] = scope.sha(research_raw)
+        if (observed["discovery_attempted_calls"] !=
+                observed["adaptive_research"]["ordinary_calls"] - 1):
+            raise ValueError("preservation_research_discovery_ledger_mismatch")
+    observed.update(case=case, arm=arm, consumer_sha256=consumer_sha,
+                    engine_artifact_sha256=scope.ENGINE_SHA,
+                    command_wall_seconds=result.get("wall_seconds"),
+                    command_kind=result.get("command_kind"),
+                    fresh_rule_cache_path=str(cache),
+                    ordinary_measurement_semantics=(
+                        "fresh discovery n500 calls plus separate held-out n500 final; product cohort excludes held-out"
+                        if arm == "candidate" else
+                        "one fresh final-n500 verifier per observed product cohort row"))
+    return observed
+
