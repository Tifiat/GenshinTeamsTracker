+def _retained_native_contracts() -> dict:
+    if (sha(_bounded(V4_NATIVE_LOG)) != V4_NATIVE_LOG_GZIP_SHA
+            or sha(_bounded(V4_FREEZE)) != V4_FREEZE_SHA):
+        raise ValueError("uptake_retained_native_evidence_changed")
+    raw = gzip.decompress(_bounded(V4_NATIVE_LOG))
+    if sha(raw) != V4_NATIVE_LOG_RAW_SHA or len(raw) != 10769:
+        raise ValueError("uptake_retained_native_log_changed")
+    lines = raw.decode("utf-8").splitlines()
+    runs = [parts[2] for line in lines if line.startswith("=== RUN   ")
+            for parts in [line.split()] if len(parts) == 3 and "/" not in parts[2]]
+    passes = [parts[2] for line in lines if line.startswith("--- PASS: ")
+              for parts in [line.split()] if len(parts) >= 4 and "/" not in parts[2]]
+    if (sorted(runs) != sorted(NATIVE_CONTRACTS)
+            or sorted(passes) != sorted(NATIVE_CONTRACTS)
+            or any(line.startswith(("--- FAIL:", "--- SKIP:", "FAIL")) for line in lines)):
+        raise ValueError("uptake_retained_native_contracts_invalid")
+    ok_lines = [line for line in lines if line.startswith("ok  ")]
+    packages = {line.split()[1]: line for line in ok_lines if len(line.split()) >= 3}
+    prefix = "genshinteamstracker/native/gcsim_optimizer/"
+    expected = {prefix + name for name in (
+        "internal/search", "internal/allsets", "internal/setcontext",
+        "internal/seteffects", "cmd/gtt-optimizer")}
+    if set(packages) != expected or len(ok_lines) != len(expected):
+        raise ValueError("uptake_retained_native_package_set_changed")
+    for name, line in packages.items():
+        compile_only = name in {prefix + "internal/setcontext", prefix + "internal/seteffects"}
+        if ("[no tests to run]" in line) != compile_only:
+            raise ValueError("uptake_retained_native_package_scope_changed")
+    result = json.loads(_bounded(V4_RESULT))
+    command = result.get("commands", {}).get("native-contracts", {})
+    if (sha(_bounded(V4_RESULT)) != V4_RESULT_SHA
+            or sha(_bounded(V4_AUDIT)) != V4_AUDIT_SHA
+            or result.get("status") != "failed"
+            or result.get("stage") != "native-contracts"
+            or result.get("cleanup_status") != "confirmed"
+            or result.get("remaining_managed_jobs") != 0
+            or result.get("builds") != {"consumer": 0, "engine": 0}
+            or result.get("button_runs") != {"control": 0, "candidate": 0}
+            or result.get("installs") != 0
+            or command.get("returncode") != 0
+            or command.get("timed_out") is not False
+            or command.get("log_sha256") != V4_NATIVE_LOG_RAW_SHA
+            or command.get("log_bytes") != len(raw)):
+        raise ValueError("uptake_retained_native_result_invalid")
+    return {"source_result_sha256": V4_RESULT_SHA, "source_audit_sha256": V4_AUDIT_SHA,
+            "source_freeze_sha256": V4_FREEZE_SHA,
+            "source_log_gzip_sha256": V4_NATIVE_LOG_GZIP_SHA,
+            "source_log_raw_sha256": V4_NATIVE_LOG_RAW_SHA,
+            "named_pass": list(NATIVE_CONTRACTS), "compile_only": ["internal/setcontext", "internal/seteffects"]}
