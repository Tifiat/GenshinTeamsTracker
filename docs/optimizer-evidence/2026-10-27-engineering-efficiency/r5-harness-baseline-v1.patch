+def partial_native_evidence(job):
+    """Keep typed attempted/sampled support evidence before failed-job cleanup."""
+    result = {"state": "partial_not_acceptance", "failure_codes": [], "support": []}
+    stderr = io._read_optional(job / "progress.jsonl", 262144)
+    if stderr:
+        text = stderr.decode("utf-8", errors="replace")
+        for phrase, code in (("support response check:", "support_response_check_failed"),
+                ("canonical inventory reference:", "canonical_inventory_reference_failed"),
+                ("All Sets did not produce a completed formula context", "no_completed_formula_context"),
+                ("ordinary simulation", "ordinary_simulation_failed"), ("compact capture", "compact_capture_failed"),
+                ("context deadline exceeded", "context_deadline_exceeded"), ("panic:", "native_panic")):
+            if phrase in text:
+                result["failure_codes"].append(code)
+        progress = []
+        for line in text.splitlines():
+            try:
+                row = json.loads(line)
+                item = {key: row[key] for key in ("stage", "completed", "total", "request_sha256") if key in row}
+                if item:
+                    progress.append(safe_diagnostic(item))
+            except Exception:
+                continue
+        result["last_progress"] = progress[-1:]
+    sample_keys = {"attempt", "kind", "actor", "stat", "delta", "seed", "sample_seed", "config_sha256",
+        "config_identity", "config_matched", "result_sha256", "iterations", "dps", "standard_deviation",
+        "standard_error", "insufficient_energy_max", "character_dps", "number_of_workers"}
+    roots = sorted((job / "verification").glob("stat-response-*"))
+    require(len(roots) <= 1, "partial_support_scope_invalid")
+    for root in roots:
+        item = {}
+        for name in ("attempts", "outcomes"):
+            raw = io._read_optional(root / (name + ".jsonl"), 131072)
+            rows = []
+            for line in (raw or b"").splitlines():
+                require(len(rows) < 66, "partial_support_scope_invalid")
+                row = json.loads(line)
+                rows.append(safe_diagnostic({key: row[key] for key in sample_keys if key in row}))
+            item[name] = rows
+            item[name + "_count"] = len(rows)
+        result["support"].append(item)
+    final_configs = sorted((job / "verification/final-n500").rglob("config.txt"))
+    require(len(final_configs) <= 9, "partial_finalist_scope_invalid")
+    result["finalist_config_sha256"] = [owned._sha256_file(path) for path in final_configs]
+    if not result["failure_codes"]:
+        result["failure_codes"] = ["native_error_unclassified_no_raw_error_export"]
+    return result
