+_FROZEN_ID = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}\Z")
+_FROZEN_NAME = re.compile(r"[0-9a-f]{64}\.json\Z")
+_FROZEN_REASONS = frozenset(("unclassified_unsupported", "unknown_operation", "shared_global_engine_state",
+    "symbolic_control_flow", "unsupported_arithmetic", "unsupported_type_or_assertion", "analysis_budget",
+    "dependency_link", "map_iteration_unproven", "unobserved_runtime_fact", "dynamic_schedule", "invalid_operation"))
