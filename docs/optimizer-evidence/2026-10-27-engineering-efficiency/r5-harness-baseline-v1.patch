+def _compact_helper_output(value: Mapping[str, Any]) -> dict[str, Any]:
+    keep = (
+        "frame_sha256", "baseline_candidate_sha256", "challenger_candidate_sha256",
+        "baseline_render_sha256", "challenger_render_sha256", "iterations", "workers",
+        "seeded_diagnostic",
+    )
+    compact = {key: value[key] for key in keep if key in value}
+    if "seeded_diagnostic" not in compact:
+        raise DiagnosticError("helper omitted the seeded diagnostic summary")
+    compact["seeded_diagnostic"] = _compact_stdout_diagnostic(compact["seeded_diagnostic"])
+    return compact
