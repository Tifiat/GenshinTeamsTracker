+def read_bounded(path):
+    size = path.stat().st_size
+    if size > LIMITS["raw_export_file_max"]:
+        raise ValueError("health_export_file_cap")
+    with path.open("rb") as stream:
+        raw = stream.read(LIMITS["raw_export_file_max"] + 1)
+    if len(raw) != size or path.stat().st_size != size:
+        raise ValueError("health_export_changed")
+    return raw
