+def _binary_archive(job: Path, binary: Path, archive_path: Path) -> dict:
+    job = cases.owned_job(job)
+    binary = binary.resolve(strict=True)
+    evidence = scope.EVIDENCE.resolve(strict=True)
+    if (binary != (job / "product-candidate.exe").resolve(strict=True)
+            or archive_path.resolve().parent != evidence
+            or archive_path.exists()):
+        raise ValueError("preservation_binary_archive_target_invalid")
+    raw = scope.bounded(binary, MAX_RAW_EXPORT)
+    writer = function_view(scope.accepted.complete.prior.retained._write_gzip_once,
+                           MAX_RAW_EXPORT_BYTES=MAX_RAW_EXPORT)
+    archive = writer(raw, archive_path)
+    return {"path": str(archive_path), "archive": archive,
+            "raw_sha256": scope.sha(raw), "raw_bytes": len(raw)}
+
+
+def _restore_binary(job: Path, archived: dict) -> dict:
+    job = cases.owned_job(job)
+    path = Path(archived["path"]).resolve(strict=True)
+    if (path.parent != scope.EVIDENCE.resolve(strict=True)
+            or not scope._digest(archived.get("raw_sha256"))
+            or not scope._digest(archived.get("archive_sha256"))):
+        raise ValueError("preservation_binary_archive_input_invalid")
+    compressed = scope.bounded(path, MAX_RAW_EXPORT)
+    if scope.sha(compressed) != archived["archive_sha256"]:
+        raise ValueError("preservation_binary_archive_changed")
+    raw = gzip.decompress(compressed)
+    if len(raw) > MAX_RAW_EXPORT or scope.sha(raw) != archived["raw_sha256"]:
+        raise ValueError("preservation_binary_archive_raw_changed")
+    binary = job / "product-candidate.exe"
+    with binary.open("xb") as stream:
+        stream.write(raw)
+    if scope.sha(scope.bounded(binary)) != archived["raw_sha256"]:
+        raise ValueError("preservation_binary_restore_failed")
+    return {"binary_path": str(binary), "binary_sha256": archived["raw_sha256"],
+            "archive_path": str(path), "archive_sha256": archived["archive_sha256"]}
+
+
+def _tighnari_contract_provenance(freeze: dict, plan: dict) -> None:
+    """Bind the no-engine contract PASS and exact ten source bytes before a build."""
+    evidence = scope.EVIDENCE.resolve(strict=True)
+    pins = (freeze.get("contract_pass_receipt"), freeze.get("delta_source_archive"))
+    payloads = []
+    for pin in pins:
+        if type(pin) is not dict or not scope._digest(pin.get("sha256")):
+            raise ValueError("preservation_tighnari_source_receipt_missing")
+        path = Path(pin.get("path", "")).resolve(strict=True)
+        if path.parent != evidence:
+            raise ValueError("preservation_tighnari_source_receipt_outside_evidence")
+        raw = scope.bounded(path, 8 << 20)
+        if scope.sha(raw) != pin["sha256"]:
+            raise ValueError("preservation_tighnari_source_receipt_changed")
+        payloads.append(json.loads(raw))
+    contract, archive = payloads
+    if (contract.get("status") != "contract_pass"
+            or contract.get("cleanup_status") != "confirmed"
+            or contract.get("preservation_exact") is not True
+            or contract.get("builds") != 0 or contract.get("optimizer_runs") != 0
+            or contract.get("installs") != 0
+            or sorted(contract.get("named_tests_passed", [])) != sorted(contract.get("expected_test_names", []))
+            or len(contract.get("named_tests_passed", [])) != 9
+            or archive.get("schema") != "candidate_preservation_delta_source_archive_v1"
+            or archive.get("contract_result_sha256") != pins[0]["sha256"]
+            or archive.get("contract_freeze_sha256") != contract.get("freeze_sha256")
+            or archive.get("source_plan_sha256") != contract.get("source_plan_sha256")
+            or archive.get("policy_sha256") != plan["policy_sha256"]
+            or archive.get("accepted_361_image_map_sha256") != plan["accepted_361_image_map_sha256"]):
+        raise ValueError("preservation_tighnari_contract_provenance_invalid")
+    rows = archive.get("files")
+    if type(rows) is not list or len(rows) != len(plan["delta_hashes"]):
+        raise ValueError("preservation_tighnari_delta_archive_incomplete")
+    seen = set()
+    for row in rows:
+        relative = row.get("path")
+        expected = plan["delta_hashes"].get(relative)
+        receipt = row.get("archive", {})
+        path = Path(receipt.get("path", "")).resolve(strict=True)
+        if (not expected or relative in seen or row.get("source_sha256") != expected
+                or not path.is_relative_to(evidence)
+                or receipt.get("raw_sha256") != expected
+                or receipt.get("readback_exact") is not True):
+            raise ValueError("preservation_tighnari_delta_archive_row_invalid")
+        compressed = scope.bounded(path, MAX_RAW_EXPORT)
+        if (scope.sha(compressed) != receipt.get("compressed_sha256")
+                or len(compressed) != receipt.get("compressed_bytes")):
+            raise ValueError("preservation_tighnari_delta_archive_changed")
+        raw = gzip.decompress(compressed)
+        if (len(raw) != receipt.get("raw_bytes") or scope.sha(raw) != expected
+                or raw != scope.bounded(scope.NATIVE / relative, MAX_RAW_EXPORT)):
+            raise ValueError("preservation_tighnari_delta_archive_readback_mismatch")
+        seen.add(relative)
+    if seen != set(plan["delta_hashes"]):
+        raise ValueError("preservation_tighnari_delta_archive_missing_source")
+
+
+def one_case_packet(freeze_path: Path, output_path: Path, *,
+                    control_heldout: Callable[[Path, str, dict, Command], dict] | None = None) -> dict:
+    """Run exactly one reviewed case in the existing managed owner.
+
+    The control verification callback is deliberately required. Its Go input
+    schema is still owned by the research command; omission cannot fall back
+    to discovery metrics or a reused ordinary result.
+    """
+    started = time.monotonic()
+    gate = scope.accepted.K.gate
+    freeze_raw = scope.bounded(freeze_path, 8 << 20)
+    freeze = json.loads(freeze_raw)
+    limits = freeze.get("limits")
+    case = freeze.get("case")
+    candidate_binary = [None, None]
+    if control_heldout is None and type(limits) is dict:
+        control_heldout = lambda job, case, observed, command: run_control_heldout(
+            job, case, observed, command, limits["control_verify_seconds"],
+            candidate_binary[0], candidate_binary[1])
