+def run_once(protocol_path: Path, protocol_sha256: str) -> dict[str, Any]:
+    assert_unlinked(RECEIPT_PATH)
+    if RECEIPT_PATH.exists():
+        raise DiagnosticError("this fixed protocol receipt is already reserved or consumed")
+    closure_summary = _verify_native_closure()
+    protocol = _validate_protocol(protocol_path, protocol_sha256)
+    runtime_before = _runtime_pins()
+    pins = protocol["pins"]
+    if any(pins.get(key) != value for key, value in runtime_before.items()):
+        raise DiagnosticError("protected runtime or repository pin mismatch")
+    if _sha256_file(GO_EXE) != GO_SHA256:
+        raise DiagnosticError("pinned Go executable changed")
+    retained_row = _load_retained_row(pins["retained_result_sha256"])
+    receipt: dict[str, Any] = {
+        "schema_kind": "gtt_chevreuse_render_diagnostic_result_v2",
+        "lease_id_sha256": hashlib.sha256(protocol["lease_id"].encode("utf-8")).hexdigest(),
+        "status": "reserved",
+        "case_id": CASE_ID,
+        "mode": "render_then_four_seeded_ordinary_calls",
+        "protocol_sha256": protocol_sha256,
+        "baseline_render_sha256": render_diagnostic.PINS["baseline_render_sha256"],
+        "source_closure": closure_summary,
+        "source_closure_receipt_sha256": NATIVE_CLOSURE_SHA256,
+        "runtime_pins_before": runtime_before,
+        "build": None,
+        "helper": None,
+        "preparation": None,
+        "managed_job_removed": None,
+        "cleanup_status": "unconfirmed",
+        "engine_calls_planned": 4,
+        "engine_calls_attempted": 0,
+        "engine_calls_completed": 0,
+        "engine_calls_failed": 0,
+        "engine_calls_in_flight": 0,
+        "error_code": None,
+    }
+    started = time.monotonic()
+    job: Path | None = None
+    rendered_result: dict[str, Any] = {}
+    _publish_receipt(receipt, replace_existing=False)
+    receipt_written = True
+
+    def remaining(timeout: int) -> int:
+        seconds = OUTER_TIMEOUT_SECONDS - (time.monotonic() - started)
+        if seconds <= 0:
+            raise DiagnosticError("outer timeout exhausted")
+        return max(1, min(timeout, int(seconds)))
+
+    try:
+        with managed_scratch(MANAGED_ROOT) as active_job:
+            job = active_job.resolve(strict=True)
+            try:
+                env = _owned_environment(job)
+                with _apply_environment(env):
+                    case = load_case(CASE_ID)
+                    if case.source_profiles_sha256 != render_diagnostic.PINS["source_profiles_sha256"]:
+                        raise DiagnosticError("public Chevreuse profile pin mismatch")
+                    db_path, team, _rotation, fixture = create_archetype_fixture(
+                        job, CASE_ID, store_dir=DEFAULT_GCSIM_ENGINE_STORE_DIR,
+                    )
+                    receipt["fixture"] = {"sha256": fixture.get("fixture_sha256")}
+                    if fixture.get("fixture_sha256") != pins.get("fixture_sha256"):
+                        raise DiagnosticError("synthetic fixture pin mismatch")
+
+                    def renderer(payload: Mapping[str, Any]) -> Mapping[str, Any]:
+                        # Production request/source preparation and all its pins must pass
+                        # before this callback is reached, so an invalid request spends no build.
+                        module_dir = job / "nested-helper"
+                        module_dir.mkdir()
+                        shutil.copyfile(HELPER_SOURCE, module_dir / "main.go")
+                        native_module = ROOT / "native/gcsim_optimizer"
+                        (module_dir / "go.mod").write_text(
+                            "module genshinteamstracker/native/gcsim_optimizer/research/chevreuse_render_diagnostic\n\n"
+                            "go 1.26.0\n\n"
+                            "require genshinteamstracker/native/gcsim_optimizer v0.0.0\n\n"
+                            f"replace genshinteamstracker/native/gcsim_optimizer => {native_module.as_posix()}\n",
+                            encoding="utf-8",
+                            newline="\n",
