+        and protocol.get("engine_authorized") is False and protocol.get("install_authorized") is False
+        and protocol.get("limits") == LIMITS and protocol.get("result") == RESULT.relative_to(ROOT).as_posix()
+        and re.fullmatch("[a-z0-9-]{1,100}", protocol.get("lease_id", "")), "protocol_not_released")
