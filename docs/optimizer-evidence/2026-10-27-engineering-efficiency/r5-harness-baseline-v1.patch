diff --git a/tools/experiments/gcsim/mvp_polish/mechanic_cache_packet.py b/tools/experiments/gcsim/mvp_polish/mechanic_cache_packet.py
new file mode 100644
--- /dev/null
+++ b/tools/experiments/gcsim/mvp_polish/mechanic_cache_packet.py
@@ -0,0 +1,323 @@
+"""Finite cache comparisons over the existing managed button gate.
+
+Default is describe-only. Explicit execution runs exactly Overload All ON-learning,
+identical ON-repeat, then genuine OFF. That action exports and stops for review.
+The separate explicit corpus action uses frozen saved inputs, incremental rows
+and at most one ON repeat. Neither action builds or installs a runtime.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import ExitStack
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import struct
+import zipfile
+from unittest.mock import patch
+
+from tools.experiments.gcsim.mvp_polish import mechanic_button_gate as gate
+from tools.experiments.gcsim.mvp_polish import mechanic_uptake as uptake
+from tools.experiments.gcsim.mvp_polish.mechanic_packet_evidence import write_json
+from tools.managed_optimizer_experiment import managed_scratch, assert_unlinked
+
+ROOT = gate.ROOT
+OUTPUT_ROOT = ROOT / "docs/optimizer-evidence/2026-10-25-cache-team-matrix"
+CONFIG = ROOT / "docs/optimizer-evidence/2026-10-25-all-teams-button-timings/real-inventory/source-configs/overload-source.json"
+ARMS = (("on-learning", True), ("on-repeat", True), ("off", False))
+_NAME = re.compile(r"[0-9a-f]{64}\.(gttast|gttir)\Z")
+
+
+def _output(path: Path, *, existing: bool = False) -> Path:
+    path = path.expanduser().absolute()
+    assert_unlinked(path)
+    path = path.resolve()
+    path.relative_to(OUTPUT_ROOT.resolve())
+    if path == OUTPUT_ROOT.resolve() or (path.exists() and not existing):
+        raise ValueError("use one new packet output directory under the dated matrix owner")
+    return path
+
+
+def cache_entries(cache: Path, engine: Path) -> list[dict]:
+    """Validate static transport envelopes; production revalidates on consumption.
+
+    This does not reimplement module semantics or deserialize executable state.
+    IR RawMessage bytes are hashed verbatim, including Go's JSON HTML escaping.
+    """
+    assert_unlinked(cache)
+    rows, counts, sizes = [], {"gttast": 0, "gttir": 0}, {"gttast": 0, "gttir": 0}
+    for path in sorted(cache.iterdir()) if cache.exists() else ():
+        assert_unlinked(path)
+        match = _NAME.fullmatch(path.name)
+        if not path.is_file() or not match:
+            raise ValueError("unexpected file in the owned immutable-cache snapshot")
+        kind = match.group(1)
+        raw = path.read_bytes()
+        counts[kind] += 1
+        sizes[kind] += len(raw)
+        item = {"name": path.name, "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest(), "kind": kind}
+        if kind == "gttast":
+            if len(raw) < 20 or raw[:8] != b"GTTAST02":
+                raise ValueError("invalid AST envelope")
+            hlen, plen = struct.unpack(">IQ", raw[8:20])
+            if not 0 < hlen <= 4096 or plen > 32 << 20 or len(raw) != 20+hlen+plen:
+                raise ValueError("AST envelope exceeds bounds")
+            header = json.loads(raw[20:20+hlen])
+            source = (engine / header["name"]).resolve(strict=True)
+            source.relative_to(engine.resolve(strict=True))
+            body = source.read_bytes()
+            key = hashlib.sha256(b"gtt-rule-ast-cache\0" + b"2\0" + header["go_version"].encode() +
+                b"\0" + header["name"].encode() + b"\0" + body).hexdigest()
+            if (header["schema"] != 2 or hashlib.sha256(body).hexdigest() != header["source_sha256"]
+                    or hashlib.sha256(raw[20+hlen:]).hexdigest() != header["payload_sha256"] or key != path.stem):
+                raise ValueError("AST source/key/payload binding changed")
+            item.update(source=header["name"], role="source_ast", schema=2)
+        else:
+            if len(raw) > 4 << 20:
+                raise ValueError("IR file exceeds production bound")
+            text = raw.decode("utf-8")
+            record = json.loads(text)
+            marker = re.search(r'"payload"\s*:\s*', text)
+            if marker is None:
+                raise ValueError("IR payload missing")
+            payload, end = json.JSONDecoder().raw_decode(text, marker.end())
+            digest = hashlib.sha256(text[marker.end():end].encode()).hexdigest()
+            if (record.get("key") != path.stem or record.get("payload_sha256") != digest
+                    or payload.get("schema") != 4 or payload.get("compiler") != "source-module-plan-lazy-dependency-v4"
+                    or payload.get("role") not in {"root", "dependency"}):
+                raise ValueError("IR key/schema/role/payload binding changed")
+            item.update(role=payload["role"], entry=payload["entry"], schema=4,
+                        source_closure_sha256=payload["source_closure_sha256"],
+                        coverage=payload.get("coverage"))
+        rows.append(item)
+    if (counts["gttast"] > 512 or sizes["gttast"] > 64 << 20
+            or counts["gttir"] > 4096 or sizes["gttir"] > 128 << 20):
+        raise ValueError("cache snapshot exceeds existing production capacity")
+    return rows
+
+
+def warm_status(receipt: dict) -> dict:
+    mechanics = receipt.get("mechanics", {})
+    ir = mechanics.get("ir_cache", {})
+    ast = mechanics.get("ast_cache", {})
+    required = ("semantic_analyses", "misses", "writes", "repairs", "errors", "fresh_binds")
+    complete = all(type(ir.get(k)) is int for k in required)
+    warm = (complete and ir["fresh_binds"] > 0 and all(ir[k] == 0 for k in required[:-1])
+            and all(ast.get(k) == 0 for k in ("Misses", "Writes", "Repairs", "Errors")))
+    return {"confirmed_no_new_compile": warm, "ir": ir, "ast": ast,
+        "role_counter_scope": "runtime counts aggregate root+dependency; per-entry roles retained in cache manifests, no invented split"}
+
+
+def comparison(arms: list[dict]) -> dict:
+    by = {x["arm"]: x for x in arms}
+    if set(by) != {x[0] for x in ARMS} or any(x.get("status") != "success" for x in arms):
+        return {"status": "incomplete_or_failed", "next": "STOP; export and diagnose; no automatic retry or matrix"}
+    warm, off = by["on-repeat"], by["off"]
+    return {"status": "complete", "warm_confirmed": warm["warm"]["confirmed_no_new_compile"],
+        "learning_ms": by["on-learning"]["button_ms"], "warm_ms": warm["button_ms"], "off_ms": off["button_ms"],
+        "learning_to_repeat_saving_ms": by["on-learning"]["button_ms"]-warm["button_ms"],
+        "observed_warm_saving_ms": off["button_ms"]-warm["button_ms"],
+        "benefit_observed_in_single_packet": warm["button_ms"] < off["button_ms"],
+        "scope": "one same-version three-arm observation; OS warmth uncontrolled, not a general speed certificate",
+        "next": "STOP for coordinator/MAIN phase diagnosis before any matrix allocation"}
+
+
+def _signature(result: dict) -> dict:
+    j = (result.get("case") or {}).get("config_join", {})
+    inventory = result.get("practical_inventory", {})
+    return {**{key: j.get(key) for key in ("prepared_config_sha256", "rotation_source_sha256", "context_sha256",
+        "target_sha256", "request_result_options", "request_seed_schedule", "request_payload_sha256")},
+        "inventory_sha256": inventory.get("artifact_input_sha256"), "total": inventory.get("artifact_count"),
+        "eligible": inventory.get("eligible_count")}
+
+
+def export_details(capture: Path, native: Path, target: Path) -> None:
+    """Retain diagnostics before any post-run assertion can discard owned data."""
+    if capture.exists():
+        assert_unlinked(capture)
+        for path in capture.iterdir():
+            assert_unlinked(path)
+            if not path.is_file() or path.suffix != ".json" or path.stat().st_size > 4 << 20:
+                raise ValueError("unexpected child evidence export")
+        shutil.copytree(capture, target)
+    else:
+        target.mkdir(parents=True)
+        write_json(target / "capture-unavailable.json", {"status":"unavailable_before_child_finalizer"})
+    total = 0
+    if native.exists():
+        for path in sorted(native.iterdir()):
+            assert_unlinked(path)
+            if not path.is_file() or path.is_symlink() or not path.name.endswith(".stderr.txt"):
+                continue
+            with path.open("rb") as stream:
+                stream.seek(max(0, path.stat().st_size-(64 << 10)))
+                raw = stream.read(64 << 10)
+            if not raw:
+                continue
+            total += len(raw)
+            if total > 2 << 20:
+                write_json(target / "native-tail-overflow.json", {"limit_bytes":2 << 20})
+                break
+            (target / (path.name+".tail.txt")).write_bytes(raw)
+
+
+def run_first(output: Path, lease: str) -> dict:
+    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", lease):
+        raise ValueError("explicit short packet lease required")
+    output = _output(output)
+    output.mkdir(parents=True)
+    record = {"schema": "same_version_cache_packet_v1", "status": "preparing", "arms": [],
+        "consumer_sha256": gate.INSTALLED_CONSUMER_SHA256, "engine_sha256": gate.INSTALLED_ENGINE_SHA256,
+        "case_id": "overload_chevreuse", "mode": "all_sets", "account_writes": False,
+        "root_dispatch_only": True, "next": "first three arms only; no automatic matrix"}
+    # The existing scoped keeper owns account/settings/Git/runtime preservation.
+    from tools.experiments.gcsim.mvp_polish import mechanic_compiler_stage as stage
+    protected = stage.previous.scope.accepted.K.protected()
+    native = stage.previous.scope.accepted.K.old.native_map()
+    def save(): write_json(output / "packet.json", record)
+    save()
+    try:
+        with managed_scratch() as job:
+            store = uptake._store(ROOT).root_dir
+            engine = store / "engines" / uptake.NEW_ENGINE_ID
+            frozen = gate.snapshot_active_inventory(job=job, project_root=ROOT, engine_store=store)
+            frozen_path = frozen["path"]
+            record["frozen_inventory"] = {k:v for k,v in frozen.items() if k != "path"}
+            first_signature = None
+            def same_snapshot(*, job: Path, **_):
+                target = job / "account-inventory-snapshot.db"
+                if target.exists() or gate._sha(frozen_path) != frozen["sha256"]:
+                    raise ValueError("frozen inventory drift or copy slot occupied")
+                shutil.copyfile(frozen_path, target)
+                if gate._sha(target) != frozen["sha256"]:
+                    raise ValueError("arm snapshot differs from the frozen account")
+                return {**frozen, "path": target}
+            cache = job / "benchmark-rule-cache"
+            for arm, enabled in ARMS:
+                print(json.dumps({"arm":arm,"status":"starting"}), flush=True)
+                capture = job / "packet-evidence" / arm
+                original_env = gate.run_case._child_environment
+                def environment(*args, **kwargs):
+                    env = original_env(*args, **kwargs)
+                    env.update(GTT_MECHANIC_PACKET_CAPTURE_DIR=str(capture), GTT_MECHANIC_PACKET_OWNED_ROOT=str(job))
+                    return env
+                before = cache_entries(cache, engine)
+                try:
+                    with ExitStack() as stack:
+                        stack.enter_context(patch.object(gate, "snapshot_active_inventory", same_snapshot))
+                        stack.enter_context(patch.object(gate.run_case, "_child_environment", environment))
+                        result = gate.run_one(suite_root=job, project_root=ROOT, consumer=uptake._consumer(ROOT),
+                            engine_store=store, source_config=CONFIG, case_id="overload_chevreuse", mode="all_sets",
+                            cache_flag=("cold" if not before else "reuse") if enabled else "off", cache_enabled=enabled,
+                            receipt_output=output / (arm+".json"), lease_id=lease+"-"+arm,
+                            test_watchdog_seconds=1200, installed_runtime=True)
+                finally:
+                    native_dir = job / "private-native-logs" / hashlib.sha256((lease+"-"+arm).encode()).hexdigest()[:16]
+                    export_details(capture, native_dir, output / (arm+"-details"))
+                after = cache_entries(cache, engine)
+                write_json(output / (arm+"-cache.json"), {"before":before,"after":after,
+                    "before_state":result["benchmark_cache"]["before"], "after_state":result["benchmark_cache"]["after"]})
+                signature = _signature(result)
+                if first_signature is None:
+                    first_signature = signature
+                elif signature != first_signature:
+                    raise ValueError("arm input/options/seed/rotation binding changed")
+                case = result.get("case") or {}
+                entry = {"arm":arm,"status":result.get("status"), "button_ms":case.get("timings_ms",{}).get("button_click_to_terminal_ms"),
+                    "measured":case.get("result_summary",{}).get("measured"), "warm":warm_status(result),
+                    "signature":signature, "details":arm+"-details", "phase_and_call_evidence":arm+".json"}
+                record["arms"].append(entry)
+                record["status"] = "measuring"
+                save()
+                print(json.dumps({"arm":arm,"status":entry["status"],"button_ms":entry["button_ms"],"warm":entry["warm"]["confirmed_no_new_compile"]}), flush=True)
+                if result.get("status") != "success" or not result.get("managed_job_removed"):
+                    break
+            # Static cache-only transfer is retained before deleting all raw
+            # account copies/runs. It is not installed as a product bundle.
+            rows = cache_entries(cache, engine)
+            archive = output / "benchmark-cache.zip"
+            with zipfile.ZipFile(archive, "x", compression=zipfile.ZIP_DEFLATED) as zipped:
+                for row in rows: zipped.write(cache / row["name"], row["name"])
+            write_json(output / "benchmark-cache-manifest.json", {"schema":"static_cache_transport_v1",
+                "owner":"cache-team-matrix-20261025", "consumer_sha256":record["consumer_sha256"],
+                "engine_sha256":record["engine_sha256"], "archive_sha256":gate._sha(archive), "entries":rows,
+                "cache_state":gate._cache_state(cache), "expires_at_utc":(datetime.now(timezone.utc)+timedelta(days=7)).isoformat(),
+                "cleaner":"python -m tools.experiments.gcsim.mvp_polish.mechanic_cache_packet --retire-cache --output <packet-folder>",
+                "scope":"static source AST/IR transport; product revalidates each entry; not executable/cache-coverage acceptance"})
+            record["comparison"] = comparison(record["arms"])
+            record["status"] = "exported_pending_review"
+            save()
+        record["owned_job_removed"] = not job.exists()
+    except Exception as error:
+        record.update(status="failed", error_class=type(error).__name__, error=str(error),
+                      owned_job_removed=not job.exists() if "job" in locals() else True)
+    finally:
+        record["protected_exact"] = stage.previous.scope.accepted.K.protected() == protected
+        record["native_exact"] = stage.previous.scope.accepted.K.old.native_map() == native
+        save()
+    return record
+
+
+def retire_cache(output: Path, *, now: datetime | None = None) -> None:
+    output = _output(output, existing=True)
+    manifest = json.loads((output / "benchmark-cache-manifest.json").read_bytes())
+    if manifest.get("owner") != "cache-team-matrix-20261025":
+        raise ValueError("cache transport owner mismatch")
+    now = now or datetime.now(timezone.utc)
+    if now < datetime.fromisoformat(manifest["expires_at_utc"]):
+        raise ValueError("retained benchmark cache has not reached its finite expiry")
+    archive = output / "benchmark-cache.zip"
+    assert_unlinked(archive)
+    if gate._sha(archive) != manifest["archive_sha256"]:
+        raise ValueError("cache archive changed; refuse deletion")
+    archive.unlink()  # One exact owned file; receipts/details are preserved.
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--execute-first-packet", action="store_true")
+    parser.add_argument("--retire-cache", action="store_true")
+    parser.add_argument("--retire-frozen-mechanics", action="store_true")
+    parser.add_argument("--prepare-corpus-inputs", action="store_true")
+    parser.add_argument("--execute-corpus", action="store_true")
+    parser.add_argument("--inputs", type=Path)
+    parser.add_argument("--cache-source", type=Path)
+    parser.add_argument("--resume", action="store_true")
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--lease-id", default="")
+    args = parser.parse_args()
+    if sum((args.execute_first_packet,args.retire_cache,args.retire_frozen_mechanics,args.prepare_corpus_inputs,args.execute_corpus)) > 1:
+        parser.error("choose one finite action")
+    if args.retire_frozen_mechanics:
+        if args.output is None:parser.error('--output required')
+        from .mechanic_packet_evidence import retire_frozen_records
+        retire_frozen_records(_output(args.output,existing=True))
+    elif args.prepare_corpus_inputs:
+        if args.output is None: parser.error("--output required")
+        from .mechanic_corpus_inputs import write_inputs
+        print(json.dumps({"status":"inputs_projected","engine_calls":0,"inputs":str(write_inputs(args.output))}))
+    elif args.execute_corpus:
+        if not all((args.output,args.lease_id,args.inputs,args.cache_source)):
+            parser.error("--output, --lease-id, --inputs and --cache-source required")
+        from .mechanic_corpus_packet import run_corpus
+        result=run_corpus(args.output,args.lease_id,args.inputs,args.cache_source,resume=args.resume)
+        print(json.dumps({k:v for k,v in result.items() if k!='rows'}),flush=True)
+        if result['status']!='complete' or not all(result.get(k) for k in ('owned_job_removed','native_exact','protected_exact')):raise SystemExit(2)
+    elif args.retire_cache:
+        if args.output is None: parser.error("--output required")
+        retire_cache(args.output)
+    elif args.execute_first_packet:
+        if args.output is None or not args.lease_id: parser.error("--output and --lease-id required")
+        record = run_first(args.output, args.lease_id)
+        print(json.dumps({k:v for k,v in record.items() if k != "arms"}), flush=True)
+        if record.get("status") != "exported_pending_review" or not record.get("owned_job_removed") or not record.get("protected_exact") or not record.get("native_exact"):
+            raise SystemExit(2)
+    else:
+        print(json.dumps({"status":"describe_only","engine_calls":0,"case":"overload_chevreuse/all_sets",
+            "arms":[x[0] for x in ARMS],"requires":["root heavy grant","fresh quota","--execute-first-packet","--output","--lease-id"]}))
+
+
+if __name__ == "__main__": main()
