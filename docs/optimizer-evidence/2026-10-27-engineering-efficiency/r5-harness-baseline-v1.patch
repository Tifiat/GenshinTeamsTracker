+def _result_digest(value) -> str:
+    return hashlib.sha256(
+        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+
+
+def _theory_snapshot_ready(value) -> bool:
+    if not isinstance(value, dict):
+        return False
+    verification = value.get("verification")
+    return (
+        value.get("status") == "success"
+        and value.get("response_status") == "ordinary_verified"
+        and isinstance(verification, dict)
+        and verification.get("in_progress") is False
+        and type(verification.get("completed_count")) is int
+        and verification["completed_count"] >= 1
+    )
