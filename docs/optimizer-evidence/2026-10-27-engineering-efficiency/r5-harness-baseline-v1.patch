+def _sanitized_native_error(message: str) -> str:
+    """Keep only a small fixed technical vocabulary from actual stderr text."""
+    words = re.findall(r"[A-Za-z]+", message[:2048].casefold())
+    output: list[str] = []
+    for word in words[:40]:
+        safe = word if word in _SAFE_ERROR_WORDS else "[detail]"
+        if safe != "[detail]" or not output or output[-1] != safe:
+            output.append(safe)
+    return " ".join(output)[:180]
