+def checkpoint_frozen_records(directory: Path, output: Path) -> dict:
+    """One bounded, deduplicated audit archive; no raw run/account data."""
+    button.assert_unlinked(directory);button.assert_unlinked(output)
+    archive=output/'frozen-mechanics.zip';manifest_path=output/'frozen-mechanics-manifest.json'
+    records={};rejected=temporary=unowned=0
+    if archive.exists():
+        button.assert_unlinked(archive)
+        previous=json.loads(manifest_path.read_bytes())
+        if previous.get('owner')!='cache-team-matrix-20261025-frozen' or button._sha(archive)!=previous['archive_sha256']:raise ValueError('frozen archive checkpoint changed')
+        with zipfile.ZipFile(archive) as z:
+            if len(z.infolist())>256 or sum(x.file_size for x in z.infolist())>8<<20:raise ValueError('frozen archive bounds')
+            for item in z.infolist():records[item.filename]=_frozen_record(z.read(item),item.filename)
+    entries=list(directory.iterdir()) if directory.exists() else []
+    if len(entries)>1024:raise ValueError('frozen owning-store scan bounds')
+    for path in entries:
+        button.assert_unlinked(path)
+        if path.name.startswith('.mechanic-tmp-'):temporary+=1;continue
+        if not _FROZEN_NAME.fullmatch(path.name) or not path.is_file():unowned+=1;continue
+        try:
+            if path.stat().st_size>16*1024:raise ValueError('frozen record bounds')
+            value=_frozen_record(path.read_bytes(),path.name)
+        except (ValueError,TypeError,KeyError,AttributeError,OverflowError):rejected+=1;continue
+        old=records.get(path.name)
+        # Native Count is already cumulative in this job. Never sum snapshots.
+        if old is None or (value['last_seen'],value['count'])>=(old['last_seen'],old['count']):records[path.name]=value
+    ordered=sorted(records.items(),key=lambda x:(x[1]['last_seen'],x[0]),reverse=True)
+    overflow=max(0,len(ordered)-256);ordered=ordered[:256]
+    temporary_archive=output/'frozen-mechanics.part';button.assert_unlinked(temporary_archive);rows=[];total=0
+    with zipfile.ZipFile(temporary_archive,'w',compression=zipfile.ZIP_DEFLATED) as z:
+        for name,value in ordered:
+            raw=json.dumps(value,sort_keys=True,separators=(',',':')).encode();total+=len(raw)
+            if len(raw)>16*1024 or total>8<<20:raise ValueError('frozen exported bounds')
+            z.writestr(name,raw);rows.append({'name':name,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),
+                'mechanic_id':value['mechanic_id'],'reason_code':value['reason_code'],'consumer_site':value.get('consumer_site','')})
+    button.assert_unlinked(archive);os.replace(temporary_archive,archive)
+    manifest={'schema':'bounded_frozen_mechanics_release_transport_v1','owner':'cache-team-matrix-20261025-frozen',
+        'consumer_sha256':button.INSTALLED_CONSUMER_SHA256,'engine_sha256':button.INSTALLED_ENGINE_SHA256,
+        'record_schema':2,'records':len(rows),'bytes':total,'limits':{'records':256,'record_bytes':16384,'directory_bytes':8388608},
+        'entries':rows,'archive_sha256':button._sha(archive),'rejected_records':rejected,'temporary_entries_skipped':temporary,
+        'unowned_entries_skipped':unowned,'overflow_unique_records':overflow,
+        'expires_at_utc':(datetime.now(timezone.utc)+timedelta(days=7)).isoformat(),
+        'cleaner':'python -m tools.experiments.gcsim.mvp_polish.mechanic_cache_packet --retire-frozen-mechanics --output <corpus-folder>',
+        'scope':'validated unique static FrozenRecord v2 fields only; no Reason/request/config/account/runtime state; snapshot counts are not summed',
+        'count_scope':'native record from latest contributing job; cross-resume totals unavailable'}
+    write_json(manifest_path,manifest)
+    return {'records':len(rows),'bytes':total,'archive_sha256':manifest['archive_sha256'],'rejected_records':rejected,'overflow':overflow}
+
