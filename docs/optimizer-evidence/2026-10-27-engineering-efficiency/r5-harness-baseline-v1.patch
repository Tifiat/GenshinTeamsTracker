+        "skipped_engine_calls": (
+            evidence.get("skipped_calls") if type(evidence.get("skipped_calls")) is int else None
+        ),
+        "selected_seed_count": len(selected_seeds) if isinstance(selected_seeds, list) else None,
+        "evidence_source": "native support_response.check plan/evidence; absent counts remain unknown",
+        "numeric_evidence": project_support_response(receipt),
