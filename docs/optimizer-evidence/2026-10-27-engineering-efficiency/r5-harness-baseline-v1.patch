+                    log_path=job / "build.log", timeout_seconds=LIMITS["build_seconds"])
+                save(); require(command_passed(record["build"]), "candidate_build_failed")
+                record["candidate_binary"] = {"bytes": binary.stat().st_size, "sha256": owned._sha256_file(binary)}
+                require(snapshot(protocol["pins"]) == before, "pre_candidate_state_drift")
+                process_env, record["candidate_runtime_environment"] = candidate_environment(env, os.environ)
+                record["candidate_all_calls"] = 1; save()
+                record["candidate"] = owned._run_owned(candidate_command(binary, job), command_kind="saved_all_sets", env=process_env,
+                    log_path=job / "optimizer-output.json", stderr_path=job / "progress.jsonl", timeout_seconds=LIMITS["candidate_seconds"])
+                save()
+                if not command_passed(record["candidate"]):
+                    try:
+                        record["partial"] = partial_native_evidence(job)
+                    except Exception as exc:
+                        record["partial"] = {"state": "collection_failed", "failure_code": str(exc)
+                            if type(exc) is ValueError and re.fullmatch("[a-z_]{1,80}", str(exc)) else "partial_collection_failed"}
+                    save()
+                    raise ValueError("candidate_all_sets_failed")
+                after = read_json(job / "optimizer-output.json")
+                record["timings"] = {"baseline_process_seconds": 344.609,
+                    "candidate_process_seconds": record["candidate"]["wall_seconds"],
+                    "baseline_native_ms": baseline.get("total_elapsed_ms"), "candidate_native_ms": after.get("total_elapsed_ms"),
+                    "baseline_search_seconds": baseline.get("search_seconds"), "candidate_search_seconds": after.get("search_seconds"),
+                    "baseline_ordinary_ms": baseline.get("verification", {}).get("total_elapsed_ms"),
+                    "candidate_ordinary_ms": after.get("verification", {}).get("total_elapsed_ms"),
+                    "baseline_support_ms": baseline.get("support_response", {}).get("elapsed_ms"),
+                    "candidate_support_ms": after.get("support_response", {}).get("elapsed_ms")}
+                record["model_performance"] = safe_diagnostic({"baseline": baseline.get("neutral_model"), "candidate": after.get("neutral_model")})
+                record["comparison"] = compare_outputs(baseline, after)
+                evidence = after["support_response"]["check"]["evidence"]
+                record["engine_attempts_observed"] = {"capture_members": after["capture_members"],
+                    "support": evidence["attempted_calls"], "final_n500": len(after["verification"]["candidates"])}
+                counts = record["engine_attempts_observed"]
+                counts["total"] = counts["capture_members"] + counts["support"] + counts["final_n500"]
+                counts["neutral_members"] = 2
+                counts["schedule_members"] = counts["capture_members"] - counts["neutral_members"]
+                require(0 <= counts["schedule_members"] <= 96 and counts["capture_members"] <= 98
+                        and counts["support"] <= 66 and counts["final_n500"] <= 9
+                        and counts["total"] <= 173, "call_scope_exceeded")
+                require(snapshot(protocol["pins"]) == before and owned._sha256_file(PROTOCOL) == protocol_sha,
+                        "after_state_drift")
+                record["after_before_cleanup"] = before
+                save(); require(record["comparison"]["accepted"], "candidate_quality_parity_failed")
+                require(record["candidate"]["wall_seconds"] < record["baseline_process_seconds"], "candidate_not_faster")
+                require(common._tree_bytes(job) <= LIMITS["owned_scratch_bytes"], "scratch_budget_exceeded")
+                record["status"] = "quality_and_latency_pass_cleanup_pending"; save()
+                if accepted_callback is not None:
+                    # Read-only review hook. A promotion wrapper must own and test
+                    # its explicitly released runtime transition separately.
+                    accepted_callback(binary, record, save)
+                    require(snapshot(protocol["pins"]) == before, "callback_changed_protected_runtime")
+            run_owned_body(None, record, save, body)
+        except Exception:
+            record["status"] = "failed"
+            record["errors"].append("lifecycle_or_export_failed")
+        try:
+            require(snapshot(protocol["pins"]) == before, "postflight_state_drift")
+            record["after"] = before
+            record["postflight_idle"] = not retirement._default_process_probe(ROOT)
+            record["remaining_managed_jobs"] = len(tuple(managed.MANAGED_ROOT.glob("job-*")))
+            require(record["postflight_idle"] and record["remaining_managed_jobs"] == 0
+                    and record["cleanup_status"] == "confirmed", "cleanup_not_confirmed")
+            if not record["errors"]:
+                record["status"] = "quality_and_latency_pass"
+        except Exception:
+            record["status"] = "failed"
+            record["errors"].append("postflight_or_cleanup_failed")
+        save()
+    return record
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument("--execute", action="store_true")
+    parser.add_argument("--protocol-sha256")
+    args = parser.parse_args(argv)
+    if not args.execute:
+        print(json.dumps({"status": "source_preparation_only", "engine_calls": 0, "builds": 0})); return 0
+    if not args.protocol_sha256:
+        parser.error("--execute requires the independently released --protocol-sha256")
+    try:
+        result = execute(args.protocol_sha256)
+        print(json.dumps({"status": result["status"], "cleanup_status": result["cleanup_status"]}))
+        return 0 if result["status"] == "quality_and_latency_pass" else 2
+    except Exception:
+        print(json.dumps({"status": "blocked_before_allocation_or_export_failed", "retry": False})); return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
