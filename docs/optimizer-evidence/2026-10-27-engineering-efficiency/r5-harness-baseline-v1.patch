+			t.Fatal("formula leader was not retained as both anchor and fallback")
+		}'''
+    if text.count(old_assertions) != 1:
+        raise ValueError("expected one anchor contract assertion block")
+    text = text.replace(old_assertions, new_assertions, 1)
+    return text.encode("utf-8")
+
+
+def no_feedback_overlay() -> dict[str, Any]:
+    """Return the exact accepted replay images plus the feedback-disabled test overlay.
+
+    The 16-proposal selector and the two-cycle saved request stay inherited
+    from the existing replay. The returned sources are not written or run here.
