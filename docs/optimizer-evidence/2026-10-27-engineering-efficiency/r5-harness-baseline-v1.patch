+def _restore_v5_control(job: Path, control: Path) -> tuple[dict, Path, dict]:
+    receipt = json.loads(_bounded(V5_CONTROL_EXPORTS))
+    files = {name: item for name, item in receipt["files"].items()
+             if name.startswith("control/")}
+    if len(files) != 148:
+        raise ValueError("uptake_retained_control_file_count_changed")
+    restored = {}
+    for relative, item in sorted(files.items()):
+        parts = Path(relative).parts
+        if not parts or parts[0] != "control" or any(part in ("", ".", "..") for part in parts):
+            raise ValueError("uptake_retained_control_path_invalid")
+        archive = EVIDENCE / ("health-unified-uptake-v5-" + relative.replace("/", "__") + ".gz")
+        metadata = item.get("archive", {})
+        if (metadata.get("path") != str(archive)
+                or metadata.get("readback_exact") is not True
+                or metadata.get("raw_sha256") != item.get("source_sha256")):
+            raise ValueError("uptake_retained_control_archive_metadata_invalid")
+        compressed = _bounded(archive)
+        if (sha(compressed) != metadata.get("compressed_sha256")
+                or len(compressed) != metadata.get("compressed_bytes")):
+            raise ValueError("uptake_retained_control_archive_changed")
+        raw = gzip.decompress(compressed)
+        if (len(raw) != metadata.get("raw_bytes")
+                or len(raw) > LIMITS["raw_export_file_max"]
+                or sha(raw) != item["source_sha256"]):
+            raise ValueError("uptake_retained_control_raw_changed")
+        target = (job / relative).resolve()
+        if not target.is_relative_to(job.resolve()):
+            raise ValueError("uptake_retained_control_target_invalid")
+        target.parent.mkdir(parents=True, exist_ok=True)
+        if target.exists():
+            if _bounded(target) != raw:
+                raise ValueError("uptake_retained_control_staged_request_changed")
+        else:
+            with target.open("xb") as stream:
+                stream.write(raw)
+        if sha(_bounded(target)) != item["source_sha256"]:
+            raise ValueError("uptake_retained_control_readback_changed")
+        restored[relative] = item["source_sha256"]
+    source = json.loads(_bounded(V5_RESULT))["control_button"]
+    old_run = Path(source["run_dir"])
+    if tuple(old_run.parts[-3:-1]) != ("control", "button-runs"):
+        raise ValueError("uptake_retained_control_old_run_dir_invalid")
+    run_dir = (control / "button-runs" / old_run.name).resolve(strict=True)
+    if not run_dir.is_relative_to(control.resolve()):
+        raise ValueError("uptake_retained_control_new_run_dir_invalid")
+    if json.loads(_bounded(control / "button-receipt.json")) != source:
+        raise ValueError("uptake_retained_control_receipt_changed")
+    return source, run_dir, restored
+
