+def exclusive_raw(chasca, path, raw, maximum, *, on_created=None):
+    path = Path(path)
+    require(type(raw) is bytes and 0 < len(raw) <= maximum, "navia_private_raw_scope")
+    chasca.gate.managed.assert_unlinked(path)
+    with path.open("xb") as stream:
+        if on_created is not None:
+            on_created(path)
+        stream.write(raw)
+        stream.flush()
+        os.fsync(stream.fileno())
+    require(path.stat().st_size == len(raw) and path.read_bytes() == raw,
+            "navia_private_raw_readback")
+    return {"verified": True, "bytes": len(raw), "sha256": sha(raw)}
+
