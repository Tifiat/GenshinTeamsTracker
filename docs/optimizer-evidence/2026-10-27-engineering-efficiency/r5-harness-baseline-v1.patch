+
+def _canonical_sha256(value: Any) -> str:
+    encoded = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def load_case(case_id: str) -> ArchetypeCase:
+    saved = os.environ.get("GTT_MECHANIC_CORPUS_INPUT")
+    if saved:
+        from .mechanic_corpus_inputs import load_button_case
+        return load_button_case(saved, str(case_id))
+    return _load_registered_case(case_id)
+
+
+def _load_registered_case(case_id: str) -> ArchetypeCase:
+    manifest = json.loads(CASE_MANIFEST_PATH.read_text(encoding="utf-8"))
+    if manifest.get("schema_kind") != "gtt_optimizer_mvp_polish_case_manifest_v1":
+        raise ValueError("Unsupported MVP polish case manifest")
+    raw = manifest.get("cases", {}).get(str(case_id))
+    if not isinstance(raw, dict):
+        raise ValueError(f"Unknown MVP polish case: {case_id!r}")
+    archetypes = json.loads(ARCHETYPE_MANIFEST_PATH.read_text(encoding="utf-8"))
+    team_key = str(raw["source_manifest_team"])
+    team = archetypes.get("teams", {}).get(team_key)
+    if not isinstance(team, dict):
+        raise ValueError(f"Pinned public team is missing from the source manifest: {team_key}")
+    source_url = str(team.get("source_url") or "")
+    source_id = source_url.rstrip("/").rsplit("/", 1)[-1]
+    if source_id != raw.get("source_id"):
+        raise ValueError(f"Public rotation source ID changed for {case_id}")
+    relative_rotation = Path(str(team.get("rotation_file") or ""))
+    if relative_rotation.is_absolute() or ".." in relative_rotation.parts:
+        raise ValueError("Pinned rotation must be a repository-relative public file")
+    rotation_path = (ROOT / relative_rotation).resolve(strict=True)
+    rotation_path.relative_to(ROOT.resolve())
+    rotation_bytes = rotation_path.read_bytes()
+    rotation_sha256 = hashlib.sha256(rotation_bytes).hexdigest()
+    if rotation_sha256 != raw.get("rotation_sha256"):
+        raise ValueError(f"Pinned rotation bytes changed for {case_id}")
+    rotation_text = rotation_bytes.decode("utf-8")
+    profiles = team.get("virtual_profiles")
+    if not isinstance(profiles, list) or len(profiles) != 4 or not all(isinstance(row, dict) for row in profiles):
+        raise ValueError(f"Pinned source team must contain four public profiles: {case_id}")
+    profiles_sha256 = _canonical_sha256(profiles)
+    if profiles_sha256 != raw.get("source_profiles_sha256"):
+        raise ValueError(f"Pinned profile levels/weapons changed for {case_id}")
+    options = {
+        str(position): tuple(str(key) for key in keys)
+        for position, keys in raw["main_stat_options_by_position"].items()
+    }
+    for position in range(1, 6):
+        keys = options.get(str(position), ())
+        if not keys or len(keys) > 5:
+            raise ValueError(f"Expected one through five pinned legal main choices for slot {position}")
+        if any(key not in ALLOWED_MAIN_KEYS_BY_POSITION[position] for key in keys):
+            raise ValueError(f"Illegal main stat choice for artifact slot {position}")
+        if any((5, key) not in ARTISCAN_MAX_MAIN_STAT_VALUES for key in keys):
+            raise ValueError(f"No project 5-star main-stat template for slot {position}")
+    set_domains = tuple(str(key) for key in raw.get("synthetic_set_domain_keys", ()))
+    starts = {
+        str(character).casefold(): str(set_key)
+        for character, set_key in raw.get("synthetic_set_starts_by_character", {}).items()
+    }
+    baseline_mains = {
+        str(character).casefold(): {str(position): str(key) for position, key in mains.items()}
+        for character, mains in raw.get("baseline_main_stats_by_character", {}).items()
+    }
+    alternatives = {
+        str(set_key): {str(position): str(key) for position, key in mains.items()}
+        for set_key, mains in raw.get("synthetic_alternative_set_main_stats", {}).items()
+    }
+    expected_artifact_count_raw = raw.get("expected_artifact_count")
+    if expected_artifact_count_raw is not None and (
+        type(expected_artifact_count_raw) is not int or expected_artifact_count_raw < 1
+    ):
+        raise ValueError("Expected synthetic artifact count must be a positive integer")
+    expected_artifact_count = expected_artifact_count_raw
+    if set_domains:
+        if len(set(set_domains)) != len(set_domains) or len(set_domains) != int(raw.get("candidate_set_domains", 0)):
+            raise ValueError("Synthetic set-domain keys must be unique and match their pinned count")
+        if expected_artifact_count is None:
+            raise ValueError("A synthetic fixture plan must pin its expected artifact count")
+        profile_keys = tuple(str(profile["character_key"]).casefold() for profile in profiles)
+        if set(starts) != set(profile_keys) or set(baseline_mains) != set(profile_keys):
+            raise ValueError("Synthetic set starts and mains must cover the four pinned public profiles")
+        if set(starts.values()) - set(set_domains):
+            raise ValueError("Every synthetic baseline set must be a pinned candidate domain")
+        if set(alternatives) != set(set_domains) - set(starts.values()):
+            raise ValueError("Synthetic alternative mains must cover every non-baseline candidate domain")
+        for character, mains in baseline_mains.items():
+            if set(mains) != {"3", "4", "5"}:
+                raise ValueError(f"Synthetic baseline mains are incomplete for {character}")
+            for position, key in mains.items():
+                if key not in options[position]:
+                    raise ValueError(f"Synthetic baseline main is not a pinned legal choice for {character}")
+        for set_key, mains in alternatives.items():
+            if set_key not in set_domains or set(mains) != {"3", "4", "5"}:
+                raise ValueError(f"Synthetic alternative set mains are incomplete: {set_key}")
+            for position, key in mains.items():
+                if key not in ALLOWED_MAIN_KEYS_BY_POSITION[int(position)]:
+                    raise ValueError(f"Synthetic alternative has an illegal main: {set_key}/{position}")
+                if key not in options[position]:
+                    raise ValueError(f"Synthetic alternative main is not a pinned global choice: {set_key}/{position}")
+    elif str(raw.get("status")) != "prepared_not_executed":
+        raise ValueError("An executable MVP case must pin its synthetic set inventory")
+    return ArchetypeCase(
+        case_id=str(case_id),
+        team_key=team_key,
+        archetype=str(team.get("archetype") or ""),
+        source_id=source_id,
+        source_url=source_url,
+        rotation_path=rotation_path,
+        rotation_text=rotation_text,
+        rotation_sha256=rotation_sha256,
+        source_profiles=tuple(profiles),
+        source_profiles_sha256=profiles_sha256,
+        main_stat_options_by_position=options,
+        synthetic_set_domain_keys=set_domains,
+        synthetic_set_starts_by_character=starts,
+        baseline_main_stats_by_character=baseline_mains,
+        synthetic_alternative_set_main_stats=alternatives,
+        candidate_set_domains=int(raw["candidate_set_domains"]),
+        expected_artifact_count=expected_artifact_count,
+        recommended_first_mode=str(raw["recommended_first_mode"]),
+        status=str(raw["status"]),
+    )
+
+
+def case_ids() -> tuple[str, ...]:
+    saved = os.environ.get("GTT_MECHANIC_CORPUS_INPUT")
+    if saved:
