+def _assignment(value: object) -> list[list[int]]:
+    if (not isinstance(value, list) or len(value) != 4
+            or any(not isinstance(row, list) or len(row) != 5
+                   or any(type(item) is not int for item in row) for row in value)):
+        raise ValueError("unified_full20_assignment_invalid")
+    flat = [item for row in value for item in row]
+    if len(set(flat)) != 20:
+        raise ValueError("unified_full20_assignment_duplicate")
+    return value
