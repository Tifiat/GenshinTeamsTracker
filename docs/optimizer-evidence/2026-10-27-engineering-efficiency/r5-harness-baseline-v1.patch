+def selected_cohort_summary(output: dict) -> dict:
+    rows = output.get("cohort")
+    if not isinstance(rows, list) or not 1 <= len(rows) <= 22:
+        raise ValueError("unified_selected_cohort_count_invalid")
+    summaries = []
+    for row in rows:
+        assignment = row.get("assignment")
+        if (not isinstance(assignment, list) or len(assignment) != 4
+                or any(not isinstance(actor, list) or len(actor) != 5 for actor in assignment)
+                or len({artifact for actor in assignment for artifact in actor}) != 20
+                or any(type(artifact) is not int for actor in assignment for artifact in actor)
+                or row.get("iterations") != 500
+                or not isinstance(row.get("config_sha256"), str)
+                or len(row["config_sha256"]) != 64):
+            raise ValueError("unified_selected_cohort_row_invalid")
+        for key in ("formula_dps", "measured_dps", "standard_error"):
+            value = row.get(key)
+            if type(value) not in (float, int) or not math.isfinite(value):
+                raise ValueError("unified_selected_cohort_score_invalid")
+        summaries.append({key: row[key] for key in ("rank", "source", "assignment_sha256",
+                                                     "config_sha256", "formula_dps", "measured_dps",
+                                                     "standard_error", "iterations")})
+    best = max(summaries, key=lambda row: row["measured_dps"])
+    return {"cohort_count": len(summaries), "cohort": summaries,
+            "measured_best": best, "quality_scope": "distinct engine per arm, ordinary Selected verifier"}
+
