+def _read_child_receipt(path: Path) -> dict[str, Any] | None:
+    try:
+        return _compact_child_receipt(json.loads(path.read_text(encoding="utf-8")))
+    except (OSError, UnicodeError, json.JSONDecodeError):
+        return None
+
+
+def _default_receipt_output(*, case_id: str, mode: str, lease_id: str) -> Path:
+    lease_digest = hashlib.sha256(str(lease_id).encode("utf-8")).hexdigest()[:16]
+    return ROOT / RECEIPT_OUTPUT_RELATIVE_ROOT / f"{case_id}-{mode}-{lease_digest}.json"
+
+
+def _resolve_candidate_optimizer_binary(candidate: str | Path, job: Path) -> Path:
+    """Accept only an unlinked regular file beneath this owned job."""
+    owned_job = Path(job).resolve(strict=True)
+    assert_unlinked(owned_job)
+    candidate_path = Path(candidate).expanduser()
+    if not candidate_path.is_absolute():
+        candidate_path = owned_job / candidate_path
+    assert_unlinked(candidate_path)
+    resolved = candidate_path.resolve(strict=True)
+    if resolved == owned_job or not resolved.is_relative_to(owned_job):
+        raise ValueError("Prepared optimizer binary must be inside its managed job")
+    assert_unlinked(resolved)
+    if not resolved.is_file():
+        raise ValueError("Prepared optimizer binary must be a regular file")
+    return resolved
+
+
+def _sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _prepare_receipt_output(path: str | Path) -> Path:
+    """Validate an explicit durable output path before launching the child."""
+    output_root = (ROOT / RECEIPT_OUTPUT_RELATIVE_ROOT).absolute()
+    assert_unlinked(output_root)
+    candidate = Path(path).expanduser()
+    if not candidate.is_absolute():
+        candidate = ROOT / candidate
+    candidate = candidate.absolute()
+    assert_unlinked(candidate)
+
+    # Reject malformed/outside destinations before creating even the evidence
+    # directory. Resolve non-existent paths so ``..`` and linked ancestors do
+    # not bypass the fixed output boundary.
+    resolved_root = output_root.resolve(strict=False)
+    resolved = candidate.resolve(strict=False)
+    if resolved == resolved_root or not resolved.is_relative_to(resolved_root):
+        raise ValueError("Receipt output must be a file under the MVP polish evidence directory")
+    if resolved.suffix.casefold() != ".json":
+        raise ValueError("Receipt output must use the .json extension")
+
+    output_root.mkdir(parents=True, exist_ok=True)
+    assert_unlinked(output_root)
+    resolved_root = output_root.resolve(strict=True)
+    resolved = candidate.resolve(strict=False)
+    if resolved == resolved_root or not resolved.is_relative_to(resolved_root):
+        raise ValueError("Receipt output must be a file under the MVP polish evidence directory")
+    resolved.parent.mkdir(parents=True, exist_ok=True)
+    assert_unlinked(resolved)
+    if resolved.exists():
+        raise FileExistsError("Refusing to overwrite an existing MVP polish receipt")
+    return resolved
+
+
+def _public_receipt(value: Mapping[str, Any]) -> dict[str, Any]:
+    """Keep persistent evidence to the runner's public compact schema only."""
+    return {key: value[key] for key in _RECEIPT_KEYS if key in value}
+
+
+def _write_receipt_atomically(
+    path: Path,
+    receipt: Mapping[str, Any],
+    *,
+    replace_existing: bool = False,
+) -> None:
+    """Write a compact receipt atomically using a temp file beside its target."""
+    path = Path(path)
+    assert_unlinked(path)
+    if not path.parent.is_dir():
+        raise FileNotFoundError("Receipt output directory is unavailable")
+    if not replace_existing and path.exists():
+        raise FileExistsError("Refusing to overwrite an existing MVP polish receipt")
+    if replace_existing and not path.is_file():
+        raise FileNotFoundError("Pre-cleanup receipt is unavailable for update")
+
+    fd, temporary_name = tempfile.mkstemp(
+        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent,
+    )
+    temporary_path = Path(temporary_name)
+    try:
+        try:
+            stream_context = os.fdopen(fd, "w", encoding="utf-8", newline="\n")
+        except BaseException:
+            os.close(fd)
+            raise
+        with stream_context as stream:
+            assert_unlinked(temporary_path)
+            json.dump(_public_receipt(receipt), stream, ensure_ascii=False, sort_keys=True, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        assert_unlinked(path)
+        if not replace_existing and path.exists():
+            raise FileExistsError("Refusing to overwrite an existing MVP polish receipt")
+        if replace_existing and not path.is_file():
+            raise FileNotFoundError("Pre-cleanup receipt is unavailable for update")
+        assert_unlinked(temporary_path)
+        if replace_existing:
+            # This replaces only the pre-cleanup receipt owned by this call.
+            os.replace(temporary_path, path)
+        elif os.name == "nt":
+            # Windows rename is atomic and refuses to replace an existing
+            # destination, including one created after the check above.
+            os.rename(temporary_path, path)
+        else:
+            # POSIX rename replaces destinations. A same-directory hard link
+            # publishes the complete file atomically without clobbering.
+            os.link(temporary_path, path)
+            temporary_path.unlink()
+    finally:
+        if os.path.lexists(temporary_path):
+            assert_unlinked(temporary_path)
+            temporary_path.unlink()
+
+
+def run_managed_case(
+    *,
+    case_id: str,
+    mode: str,
+    execute: bool,
+    lease_id: str,
+    timeout_seconds: int = OUTER_TIMEOUT_DEFAULT_SECONDS,
+    engine_store_dir: str | Path = DEFAULT_GCSIM_ENGINE_STORE_DIR,
+    optimizer_binary: str | Path = DEFAULT_OPTIMIZER_BINARY,
+    prepare_optimizer_binary: Callable[[Path], Path] | None = None,
+    scratch_root: str | Path = MANAGED_ROOT,
+    popen_factory: Callable[..., Any] | None = None,
+    receipt_output: str | Path | None = None,
+) -> dict[str, Any]:
+    """Run one test child and return a compact receipt after job cleanup.
+
+    ``popen_factory`` is solely a unit-test seam. Production callers use the
+    real child process and cannot request a second case or automatic retry.
+    ``prepare_optimizer_binary`` is an orchestration-only trusted callback,
+    invoked once inside the owned job before child setup. It is intentionally
+    unavailable through the ordinary CLI and has no automatic build behavior.
+    ``receipt_output`` is opt-in so fake/API callers do not persist evidence by
+    default; production CLI execution always supplies a unique output path.
+    A preparation callback requires an explicit durable receipt destination.
+    """
+    _validate_execution(
+        case_id=case_id,
+        mode=mode,
+        execute=execute,
+        lease_id=lease_id,
+        timeout_seconds=timeout_seconds,
+    )
+    _require_project_interpreter()
+    engine_store = Path(engine_store_dir).expanduser().resolve(strict=True)
+    binary = Path(optimizer_binary).expanduser().resolve(strict=True)
+    if not engine_store.is_dir() or not binary.is_file():
+        raise ValueError("Selected engine store and optimizer consumer must exist")
+    receipt_path = _prepare_receipt_output(receipt_output) if receipt_output is not None else None
+    if prepare_optimizer_binary is not None and receipt_path is None:
+        raise ValueError("Prepared optimizer consumer requires an explicit receipt output")
+
+    receipt: dict[str, Any] = {
+        "schema_kind": SUMMARY_SCHEMA,
+        "case_id": case_id,
+        "mode": mode,
+        "status": "failed",
+        "lease_id_sha256": hashlib.sha256(str(lease_id).encode("utf-8")).hexdigest(),
+        "outer_process_elapsed_ms": None,
+        "child_exit_code": None,
+        "error_code": None,
+        "case": None,
+        "managed_job_removed": None,
+        "cleanup_status": "unconfirmed",
+    }
+    if receipt_path is not None:
+        receipt["receipt_output"] = receipt_path.relative_to(ROOT.resolve(strict=True)).as_posix()
+    job: Path | None = None
+    with managed_scratch(Path(scratch_root)) as active_job:
+        # Preflight happens before waiting for the managed lease. Another
+        # caller may have completed this same receipt while we waited, so
+        # recheck under the serial lease before launching any numeric child.
+        if receipt_path is not None:
+            assert_unlinked(receipt_path)
+            if receipt_path.exists():
+                raise FileExistsError("Refusing to overwrite an existing MVP polish receipt")
+        job = active_job.resolve(strict=True)
+        candidate_binary = binary
+        candidate_preparation_failed = False
+        if prepare_optimizer_binary is not None:
+            preparation_started = time.monotonic()
+            try:
+                candidate_binary = _resolve_candidate_optimizer_binary(
+                    prepare_optimizer_binary(job), job
+                )
+                receipt["candidate_optimizer_binary_sha256"] = _sha256_file(candidate_binary)
+            except Exception as exc:  # No callback exception text or path is retained.
+                candidate_preparation_failed = True
+                receipt["error_code"] = "candidate_preparation_failed"
+                receipt["error_class"] = type(exc).__name__
+            finally:
+                receipt["candidate_preparation_elapsed_ms"] = round(
+                    (time.monotonic() - preparation_started) * 1000
+                )
+
+        if not candidate_preparation_failed:
+            environment = _child_environment(
+                job,
+                case_id=case_id,
+                mode=mode,
+                lease_id=lease_id,
+                engine_store=engine_store,
+                optimizer_binary=candidate_binary,
+            )
+            command = [sys.executable, "-B", "-m", "unittest", "-f", _CHILD_TEST]
+            factory = popen_factory or start_optimizer_process
+            started = time.monotonic()
+            process = None
+            child_output = None
+            try:
+                child_output = (job / "child-bootstrap.log").open("w", encoding="utf-8", newline="\n")
+                kwargs: dict[str, Any] = {
+                    "cwd": optimizer_process_workdir(ROOT),
+                    "env": environment,
+                    "stdin": subprocess.DEVNULL,
+                    "stdout": child_output,
+                    "stderr": subprocess.STDOUT,
+                    "text": True,
+                }
+                if os.name == "nt":
+                    kwargs["creationflags"] = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
+                else:
+                    kwargs["start_new_session"] = True
+                process = factory(command, **kwargs)
+                try:
+                    receipt["child_exit_code"] = process.wait(timeout=int(timeout_seconds))
+                except subprocess.TimeoutExpired:
+                    receipt["error_code"] = "outer_timeout"
+                    _stop_child(process)
+            except Exception as exc:  # No raw stderr, paths, or traceback are retained.
+                receipt["error_code"] = "child_launch_or_wait_error"
+                receipt["error_class"] = type(exc).__name__
+            finally:
+                if process is not None:
+                    try:
+                        if process.poll() is None:
+                            _stop_child(process)
+                        if process.poll() is None:
+                            raise RuntimeError("outer test child remained alive after stop/join")
+                    except Exception as exc:  # cleanup failure is never treated as a valid run
+                        receipt["error_code"] = receipt.get("error_code") or "child_cleanup_failed"
+                        receipt["error_class"] = type(exc).__name__
+                    finally:
+                        try:
+                            close_optimizer_process_lifetime(process)
+                        except Exception as exc:
+                            receipt["error_code"] = receipt.get("error_code") or "child_lifetime_close_failed"
+                            receipt["error_class"] = type(exc).__name__
+                if child_output is not None:
+                    try:
+                        child_output.close()
+                    except OSError as exc:
+                        receipt["error_code"] = receipt.get("error_code") or "child_log_close_failed"
+                        receipt["error_class"] = type(exc).__name__
+                receipt["outer_process_elapsed_ms"] = round((time.monotonic() - started) * 1000)
+
+        child_receipt = _read_child_receipt(job / "case-summary.json")
+        if not candidate_preparation_failed:
+            try:
+                receipt.update(_child_log_evidence(job / "child-bootstrap.log", receipt_missing=child_receipt is None))
+            except OSError as exc:
+                receipt["error_code"] = receipt.get("error_code") or "child_log_read_failed"
+                receipt["error_class"] = type(exc).__name__
+                if child_receipt is None:
+                    receipt["child_bootstrap_status"] = "unknown"
+        if child_receipt is not None:
+            receipt["case"] = child_receipt
+            if child_receipt.get("status") == "success" and receipt["child_exit_code"] == 0 and not receipt["error_code"]:
+                receipt["status"] = "success"
+            elif not receipt["error_code"]:
+                receipt["error_code"] = str(
+                    (child_receipt.get("errors") or {}).get("code") or "case_failed"
+                )
+        elif not receipt["error_code"]:
+            receipt["error_code"] = "compact_child_receipt_missing"
+        if receipt["child_exit_code"] not in (None, 0) and not receipt["error_code"]:
+            receipt["error_code"] = "child_nonzero_exit"
+        if receipt["status"] != "success":
+            receipt["status"] = "failed"
+
