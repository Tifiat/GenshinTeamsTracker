+    "TestAdaptiveHybridContractEarlyPreparationAdmission",
+    "TestAdaptiveHybridContractEarlyPreparationAdmissionRescueAndUnknown",
+    "TestAdaptiveHybridContractEarlyPreparationAdmissionRebuildAndFailClosed",
+)
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _coordinator_image(raw: bytes) -> tuple[bytes, bytes]:
+    text = raw.decode("utf-8")
+    restorations: list[tuple[str, str]] = []
+
+    def replace_once(before: str, after: str) -> None:
+        nonlocal text
+        text = exact_reuse._replace_once(text, before, after, restorations)
+
+    replace_once(
+        "\t\t\tfor packIndex, pack := range feasible {\n",
+        "\t\t\tpreparationOrder := feasible\n"
+        "\t\t\tvar earlyPlan *researchEarlyPreparationBlock\n"
+        "\t\t\tinitialPreparationCount := len(feasible)\n"
+        "\t\t\tif researchEarlyPreparationAdmissionEnabled {\n"
+        "\t\t\t\tearlyPlan, err = researchEarlyPreparationAdmissionBlock(runCtx, anchor, cycle+1, actor, feasible)\n"
+        "\t\t\t\tif err != nil { return out, err }\n"
+        "\t\t\t\tpreparationOrder = researchEarlyPreparationOrder(true, feasible, earlyPlan)\n"
+        "\t\t\t\tinitialPreparationCount = len(preparationOrder)\n"
+        "\t\t\t}\n"
+        "\t\t\tappendDeferredTail := func(completed int) {\n"
+        "\t\t\t\tif earlyPlan == nil || completed != initialPreparationCount || earlyPlan.initialDone { return }\n"
+        "\t\t\t\tpreparationOrder = append(preparationOrder, earlyPlan.completeInitialAdmission()...)\n"
+        "\t\t\t}\n"
+        "\t\t\tfor packIndex := 0; packIndex < len(preparationOrder); packIndex++ {\n"
+        "\t\t\t\tpack := preparationOrder[packIndex]\n"
+        "\t\t\t\trescued := earlyPlan != nil && packIndex >= initialPreparationCount\n",
+    )
+    replace_once(
+        "\t\t\t\tc, ok, e := prepare(anchor, actor, pack)\n"
+        "\t\t\t\tif e != nil {\n"
+        "\t\t\t\t\treturn out, e\n"
+        "\t\t\t\t}\n",
+        "\t\t\t\tc, ok, e := prepare(anchor, actor, pack)\n"
+        "\t\t\t\tif earlyPlan != nil { earlyPlan.recordPrepare(pack, c, ok, out.ReservationDeferred > reservedBefore, rescued, e) }\n"
+        "\t\t\t\tif e != nil {\n"
+        "\t\t\t\t\treturn out, e\n"
+        "\t\t\t\t}\n",
+    )
+    replace_once(
+        "\t\t\t\t\t}\n"
+        "\t\t\t\t\tcontinue\n"
+        "\t\t\t\t}\n"
+        "\t\t\t\tretain(c)\n",
+        "\t\t\t\t\t}\n"
+        "\t\t\t\t\tappendDeferredTail(packIndex + 1)\n"
+        "\t\t\t\t\tcontinue\n"
+        "\t\t\t\t}\n"
+        "\t\t\t\tretain(c)\n",
+    )
+    replace_once(
+        "\t\t\t\theap.Push(queue, &neutralProposal{actor: actor, pack: pack, seed: c.Score.Assignment, priority: c.Score.DPS,\n"
+        "\t\t\t\t\torder: coverage.Queued, screen: screens[fmt.Sprintf(\"%d:%s\", actor, pack.Key())]})\n",
+        "\t\t\t\theap.Push(queue, &neutralProposal{actor: actor, pack: pack, seed: c.Score.Assignment, priority: c.Score.DPS,\n"
+        "\t\t\t\t\torder: coverage.Queued, screen: screens[fmt.Sprintf(\"%d:%s\", actor, pack.Key())]})\n"
+        "\t\t\t\tappendDeferredTail(packIndex + 1)\n",
+    )
+    replace_once(
+        "\t\t\t}\n"
+        "\t\t\tout.ProposalSeconds += time.Since(proposalStarted).Seconds()\n",
+        "\t\t\t}\n"
+        "\t\t\tif earlyPlan != nil {\n"
+        "\t\t\t\tearlyPlan.finishBlock()\n"
+        "\t\t\t\tif earlyPlan.summary.HeuristicDeferred > 0 { boundaries[\"early_preparation_heuristic_deferred\"] = true }\n"
+        "\t\t\t}\n"
+        "\t\t\tout.ProposalSeconds += time.Since(proposalStarted).Seconds()\n",
+    )
+    changed = text.encode("utf-8")
+    erased = exact_reuse._erase(text, restorations).encode("utf-8")
+    if erased != raw:
+        raise ValueError("early preparation admission does not erase to exact matched V2 source")
+    return changed, erased
