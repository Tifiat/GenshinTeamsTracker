+def main(argv: list[str] | None = None) -> int:
+    args = _parser().parse_args(argv)
+    if not args.execute:
+        if args.case:
+            case = load_case(args.case)
+            output = {
+                "status": "prepared_not_executed",
+                "case_id": case.case_id,
+                "archetype": case.archetype,
+                "source_id": case.source_id,
+                "source_url": case.source_url,
+                "rotation_sha256": case.rotation_sha256,
+                "source_profiles_sha256": case.source_profiles_sha256,
+                "recommended_first_mode": case.recommended_first_mode,
+                "required_for_numeric_execution": ["--case", "--mode", "--execute", "--lease-id"],
+            }
+        else:
+            output = {
+                "status": "prepare_only",
+                "available_cases": list(case_ids()),
+                "required_for_numeric_execution": ["--case", "--mode", "--execute", "--lease-id"],
+            }
+        print(json.dumps(output, sort_keys=True, indent=2))
+        return 0
+    if not args.case or not args.mode or not args.lease_id.strip():
+        _parser().error("--execute requires --case, --mode, and --lease-id")
+    try:
+        receipt = run_managed_case(
+            case_id=args.case,
+            mode=args.mode,
+            execute=args.execute,
+            lease_id=args.lease_id,
+            timeout_seconds=args.timeout_seconds,
+            engine_store_dir=args.engine_store,
+            optimizer_binary=args.optimizer_binary,
+            receipt_output=(
+                args.receipt_output
+                if args.receipt_output is not None
+                else _default_receipt_output(
+                    case_id=args.case,
+                    mode=args.mode,
+                    lease_id=args.lease_id,
+                )
+            ),
+        )
+    except (OSError, ValueError, RuntimeError) as exc:
+        print(json.dumps({
+            "schema_kind": SUMMARY_SCHEMA,
+            "case_id": args.case,
+            "mode": args.mode,
+            "status": "failed",
+            "error_code": "preflight_failed",
+            "error_class": type(exc).__name__,
+        }, sort_keys=True, indent=2))
+        return 2
+    print(json.dumps(receipt, sort_keys=True, indent=2))
+    return 0 if receipt["status"] == "success" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
