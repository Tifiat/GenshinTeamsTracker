+"""Factory for the isolated damped B4 post-witness relinearization overlay.
+
+This keeps the accepted V3 pre-cap queue/witness producer byte-identical and
+adds a bounded proper-blend walk to its post-witness per-package phase. The
+factory only returns source images; it never builds, searches, or runs Go.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_precap_b4 as precap
+from tools.experiments.gcsim.mvp_polish import adaptive_relinearize_b4 as relinearize
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+ROOT = k.ROOT
+EVIDENCE = k.EVIDENCE
+SEARCH_SOURCE = Path(__file__).with_name("adaptive_damped_relinearize_search.go")
+CONTRACT_TEST = Path(__file__).with_name("adaptive_damped_relinearize_b4_test.go")
+NEW_SOURCE_FILES = (Path(__file__), SEARCH_SOURCE, CONTRACT_TEST)
+SOURCE_FILES: tuple[Path, ...] = tuple(dict.fromkeys((
+    *precap.SOURCE_FILES,
+    *relinearize.SOURCE_FILES,
+    *NEW_SOURCE_FILES,
+)))
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _once(source: str, before: str, after: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"expected exactly one accepted V3 helper marker: {before!r}")
+    return source.replace(before, after, 1)
+
+
+def _damped_screen_helper() -> str:
+    return '''\
+func combineDampedScreen(original search.CandidateReport, result search.ResearchDampedRelinearizeResult) search.CandidateReport {
+	combined := original
+	add := func(value float64) {
+		if math.IsNaN(value) || math.IsInf(value, 0) { return }
+		if combined.Samples == 0 { combined.Low, combined.High = value, value } else {
+			combined.Low = math.Min(combined.Low, value)
+			combined.High = math.Max(combined.High, value)
+		}
+		combined.Samples++
+	}
+	for _, round := range result.Trace {
+		if round.LinearStatus == "scored" && round.LinearFullDPS != nil { add(*round.LinearFullDPS) }
+		for _, trial := range round.MaskTrials {
+			if trial.Status == "scored" && trial.FullDPS != nil { add(*trial.FullDPS) }
+		}
+	}
+	// Original paired samples remain unchanged; damped points add scalar samples only.
+	return combined
+}
+'''
+
+
+def _damped_cost_helper() -> str:
+    return '''\
+func addDampedWalkCost(total *search.ResearchDampedWalkCost, value search.ResearchDampedWalkCost) {
+	total.Rounds += value.Rounds
+	total.LinearSelections += value.LinearSelections
+	total.LinearPoints += value.LinearPoints
+	total.MaskTrials += value.MaskTrials
+	total.MaskDuplicateSkips += value.MaskDuplicateSkips
+	total.MaskIllegalSkips += value.MaskIllegalSkips
+	total.MaskBudgetSkips += value.MaskBudgetSkips
+	total.MaskPointCalls += value.MaskPointCalls
+	total.MaskFullScoreCalls += value.MaskFullScoreCalls
+	total.LinearBudgetSkips += value.LinearBudgetSkips
+	total.LinearFullScoreCalls += value.LinearFullScoreCalls
+	total.AcceptedBlends += value.AcceptedBlends
+	total.AcceptedLinear += value.AcceptedLinear
+	total.StopNoGain += value.StopNoGain
+	total.StopRoundCap += value.StopRoundCap
+	total.ExpandedPoints += value.ExpandedPoints
+}
+'''
+
+
+def _instrument_relinearize_helper(raw: bytes) -> bytes:
+    source = raw.decode("utf-8")
+    source = _once(
+        source,
+        "func copyRelinearizeRow(source map[string]any) map[string]any {",
+        _damped_screen_helper() + "\n" + _damped_cost_helper() + "\nfunc copyRelinearizeRow(source map[string]any) map[string]any {",
+    )
