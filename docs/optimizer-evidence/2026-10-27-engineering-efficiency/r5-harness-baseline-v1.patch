+        "damped_max_blends_per_round": 30,
+        "damped_max_points_per_round": 31,
+        "damped_point_upper_bound": 81065,
+        "damped_assignment_trace": "one full anchor and linear assignment per round, reconstructable mask rows, selected accepted assignment only",
+        "damped_repeat_semantics": "known full and reduced scores are reused for repeated endpoints; repeated endpoints do not consume point allowance or trigger duplicate evaluation, and proper unseen blends are still considered",
