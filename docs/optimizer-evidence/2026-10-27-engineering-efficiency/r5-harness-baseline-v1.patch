+"""Source-only whole-D final-pair telemetry overlay.
+
+This layers bounded final-stabilization snapshots and invocation records over
+the completed final-stagnation-pair experiment. It does not change search or
+acceptance behavior and does not build or run Go.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import final_stagnation_pair_completion as predecessor
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+ROOT = k.ROOT
+EVIDENCE = k.EVIDENCE
+TELEMETRY = Path(__file__).with_name("final_pair_whole_test.go")
+SOURCE_FILES: tuple[Path, ...] = tuple(dict.fromkeys((*predecessor.SOURCE_FILES, Path(__file__), TELEMETRY)))
+MAX_TELEMETRY_BYTES = 32 << 20
+MAX_PROJECTION_BYTES = 32 << 20
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _once(source: str, before: str, after: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"expected one final-pair whole source seam: {before!r}")
+    return source.replace(before, after, 1)
+
+
+def _coordinator_image(source: bytes) -> tuple[bytes, bytes]:
+    text = source.decode("utf-8")
+    restorations: list[tuple[str, str]] = []
+
+    def replace_once(before: str, after: str) -> None:
+        nonlocal text
+        text = predecessor._replace_once(text, before, after, restorations)
+
+    replace_once(
+        "\tstabilizedFinalists = neutralStabilizationFinalists(archive, cfg.FinalistLimit)\n",
+        "\tstabilizedFinalists = neutralStabilizationFinalists(archive, cfg.FinalistLimit)\n"
+        "\tif e := researchFinalPairWholePlan(stabilizedFinalists, cfg.MaxSearchExpansions, out.SearchExpansions, cfg.Search.MaxExpandedPerActor, cfg.FinalistLimit, cfg.Search); e != nil { return out, e }\n",
+    )
+    replace_once(
+        "\t\tif remaining <= 0 || runCtx.Err() != nil {\n"
+        "\t\t\tboundaries[\"finalist_stabilization_deferred\"] = true\n"
+        "\t\t\tbreak\n"
+        "\t\t}\n",
+        "\t\tif remaining <= 0 || runCtx.Err() != nil {\n"
+        "\t\t\treason := \"global_budget_exhausted\"\n"
+        "\t\t\tif runCtx.Err() != nil { reason = \"run_context_done\" }\n"
+        "\t\t\tif e := researchFinalPairWholeNotInvoked(stabilizedFinalists, finalistIndex, out.SearchExpansions, remaining, reason, runCtx.Err() != nil); e != nil { return out, e }\n"
+        "\t\t\tboundaries[\"finalist_stabilization_deferred\"] = true\n"
+        "\t\t\tbreak\n"
+        "\t\t}\n",
+    )
+    replace_once(
+        "\t\tstarted := time.Now()\n"
+        "\t\tpolished, e := solver.StabilizeFinalAllSets(runCtx, c.Score.Assignment, min(remaining, cfg.Search.MaxExpandedPerActor))\n"
+        "\t\tout.SearchExpansions += polished.Evaluations\n",
+        "\t\tallowance := min(remaining, cfg.Search.MaxExpandedPerActor)\n"
+        "\t\tif e := researchFinalPairWholeStart(finalistIndex, c, cfg.MaxSearchExpansions, out.SearchExpansions, remaining, allowance); e != nil { return out, e }\n"
+        "\t\tstarted := time.Now()\n"
+        "\t\tpolished, e := solver.StabilizeFinalAllSets(runCtx, c.Score.Assignment, allowance)\n"
+        "\t\ttelemetryErr := researchFinalPairWholeComplete(finalistIndex, c, cfg.MaxSearchExpansions, out.SearchExpansions, allowance, len(out.NeutralStabilization), polished, e, time.Since(started).Seconds(), runCtx.Err() != nil)\n"
+        "\t\tout.SearchExpansions += polished.Evaluations\n",
+    )
+    replace_once(
+        "\t\tif e != nil {\n"
+        "\t\t\treturn out, e\n"
+        "\t\t}\n"
+        "\t}\n\n"
+        "\treturn out, nil\n",
+        "\t\tif e != nil {\n"
+        "\t\t\treturn out, e\n"
+        "\t\t}\n"
+        "\t\tif telemetryErr != nil { return out, telemetryErr }\n"
+        "\t}\n\n"
+        "\treturn out, nil\n",
+    )
+    if not restorations:
+        raise ValueError("final-pair whole coordinator instrumentation was empty")
+    return text.encode("utf-8"), predecessor._erase(text, restorations).encode("utf-8")
+
+
+def _replay_helper_image(source: bytes) -> bytes:
+    text = source.decode("utf-8")
+    text = _once(
+        text,
+        'researchDampedWhole,err = newAdaptiveDampedWholeState(job); check(err,"damped_whole_binding_failed")',
+        'researchDampedWhole,err = newAdaptiveDampedWholeState(job); check(err,"damped_whole_binding_failed")\n'
+        '        researchFinalPairWhole,err = newFinalPairWholeState(job); check(err,"final_pair_whole_binding_failed")',
+    )
+    text = _once(
+        text,
+        "} else { researchHybrid=nil; researchDampedWhole=nil }",
+        "} else { researchHybrid=nil; researchDampedWhole=nil; researchFinalPairWhole=nil }",
+    )
+    text = _once(
+        text,
+        "saved.Config.MaxContexts != 48 || saved.Config.MaxSearchExpansions != 8000000 || saved.Config.ResultGroups != 3 || saved.Config.ResultAlternatives != 3",
+        "saved.Config.MaxContexts != 48 || saved.Config.MaxGuides != 12 || saved.Config.FinalistLimit != 7 || saved.Config.MaxSearchExpansions != 8000000 || saved.Config.ResultGroups != 3 || saved.Config.ResultAlternatives != 3",
+    )
+    text = _once(
