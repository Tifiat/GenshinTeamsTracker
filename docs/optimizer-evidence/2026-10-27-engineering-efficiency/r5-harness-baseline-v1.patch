+"""Research-only relinearization runner; numerical execution is separately released."""
+from __future__ import annotations
+
+import argparse
+import json
+import gzip
+import math
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_relinearize_b4 as producer
+from tools.experiments.gcsim.mvp_polish import adaptive_precap_b4_run_v3 as infra
+from tools.experiments.gcsim.mvp_polish import adaptive_formula_primary_run as previous
+
+k = previous.k
+PREFIX = "adaptive-relinearize-b4-v3-"
+WHOLE_SECONDS, CLEANUP_RESERVE = 300, 45
+BUILD_SECONDS, CONTRACT_SECONDS, DIAGNOSTIC_SECONDS = 180, 15, 60
+
+
+def source_pins():
+    paths = (Path(__file__), Path(__file__).with_name("test_adaptive_relinearize_b4_export.py"),
+             *producer.SOURCE_FILES,
+             k.EVIDENCE / "adaptive-precap-b4-v3-result.json",
+             k.EVIDENCE / "adaptive-precap-b4-v3-freeze.json",
+             k.EVIDENCE / "adaptive-precap-b4-v3-closeout.json",
+             k.EVIDENCE / "adaptive-precap-b4-v3-ready.json",
+             k.EVIDENCE / "relinearize-b4-retained-baseline-coverage.json",
+             Path(__file__).with_name("adaptive_relinearize_b4_run.py"),
+             k.EVIDENCE / "adaptive-relinearize-b4-ready.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-freeze.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-result.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-failed-build-closeout.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-preimages" / "adaptive_relinearize_b4_test.go.txt",
+             Path(__file__).with_name("adaptive_relinearize_b4_run_v2.py"),
+             k.EVIDENCE / "adaptive-relinearize-b4-v2-ready.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-v2-freeze.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-v2-result.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-v2-failed-contract-closeout.json",
+             k.EVIDENCE / "adaptive-relinearize-b4-v2-preimages" / "adaptive_relinearize_search.go.txt",
+             *sorted(k.EVIDENCE.glob("adaptive-relinearize-b4-v2-precap-b4-*.gz")),
+             *sorted(k.EVIDENCE.glob("adaptive-relinearize-b4-precap-b4-*.gz")),
+             *sorted(k.EVIDENCE.glob("adaptive-precap-b4-v3-precap-b4-*.gz")))
+    pins = dict(infra.source_pins())
+    pins.update({p.relative_to(k.ROOT).as_posix(): k.sha(p.read_bytes()) for p in paths})
+    return pins
+
+
+stage_overlay = infra.stage_overlay
+
+
+def frozen_plan(overlay=None):
+    if overlay is None:
+        overlay = producer.relinearize_overlay()
+    return {"schema": "adaptive_relinearize_b4_leaf_array_successor_freeze_v3", "source_pins": source_pins(),
+            "overlay_hashes": overlay["hashes"], "metadata": overlay["metadata"],
+            "input_sha256": {name: k.sha(raw) for name, raw in overlay.get("input_files", {}).items()},
+            "limits": {"whole_including_cleanup": WHOLE_SECONDS, "cleanup_reserve": CLEANUP_RESERVE,
+                       "build": BUILD_SECONDS, "contracts": CONTRACT_SECONDS,
+                       "diagnostic": DIAGNOSTIC_SECONDS, "GOMEMLIMIT": "2GiB", "jobs": 1,
+                       "builds": 1, "diagnostics": 1, "RunNeutral": 0, "refine": 0,
+                       "ordinary": 0, "captures": 0, "installs": 0, "retries": 0},
+            "commands": ["go -C <native> test -c -p=1 -mod=readonly -buildvcs=false -overlay=<overlay> -o <job>/precap-b4.exe ./internal/allsets",
+                         "<job>/precap-b4.exe -test.run=^TestAdaptivePrecapContract -test.v -test.timeout=15s",
+                         "<job>/precap-b4.exe -test.run=^TestAdaptivePrecapB4Diagnostic$ -test.v -test.parallel=1 -test.timeout=60s"],
+            "evidence_prefix": PREFIX}
+
+
+def _summary(path, names, record):
+    if not path.is_file():
+        return None
+    try:
+        def invalid_constant(value):
+            raise ValueError("nonfinite JSON constant: " + value)
+        result = json.loads(path.read_bytes(), parse_constant=invalid_constant)
+        if not isinstance(result, dict):
+            raise ValueError("summary is not an object")
+        return {name: result.get(name) for name in names}
+    except (ValueError, UnicodeError) as failure:
+        record.setdefault("summary_errors", {})[path.name] = str(failure)
+        return None
+
+
+def export_job(job, record):
+    """Save all raw phase outputs first; unknown summaries remain unknown."""
+    outputs = record.setdefault("lossless_exports", {})
+    paths = {path for pattern in ("precap-b4-*", "relinearize-b4-*")
+             for path in job.glob(pattern)}
+    for path in sorted(paths):
+        if path.is_file() and path.suffix in (".json", ".jsonl", ".log"):
+            outputs[path.name] = previous._write_gzip_once(
+                path.read_bytes(), k.EVIDENCE / (PREFIX + path.name + ".gz"))
+    record["original_summary"] = _summary(job / "precap-b4-result.json",
+        ("complete", "witness_pass", "counts", "queue_sha256",
+         "diagnostic_seconds", "cheap_seconds", "selection_order_offset"), record)
+    record["diagnostic_summary"] = _summary(job / "relinearize-b4-result.json",
+        ("complete", "witness_pass", "improved_selector_pass", "counts", "original_queue_sha256",
+         "improved_queue_sha256", "forbidden_path_counts", "forbidden_paths_pass", "screen_calls",
+         "panel_evaluate_dps_calls", "original_setup_seconds", "original_cheap_seconds",
+         "original_diagnostic_seconds", "alternative_total_seconds", "alternative_solver_setup_seconds",
+         "alternative_walk_seconds", "original_screen_cost_totals", "alternative_cost_totals"), record)
+
+
+def _terminals(queue, result):
+    rows, counts = queue.get("rows"), result.get("counts")
+    if not isinstance(rows, list) or len(rows) != 524 or not isinstance(counts, dict):
+        raise ValueError("complete524 terminal coverage required")
+    states = {"queued": 0, "unavailable": 0, "reservation": 0, "error": 0}
+    packages = set()
+    for row in rows:
+        if (not isinstance(row, dict) or not isinstance(row.get("package"), str)
+                or row["package"] in packages or row.get("state") not in states):
+            raise ValueError("invalid or duplicate terminal identity")
+        packages.add(row["package"]); states[row["state"]] += 1
+    expected = {"feasible": 524, "queued": states["queued"], "unavailable": states["unavailable"],
+                "reservation": states["reservation"], "errors": states["error"]}
+    if any(type(counts.get(name)) is not int or counts[name] != value
+           for name, value in expected.items()):
+        raise ValueError("terminal counts differ from actual rows")
+    return {row["package"]: row for row in rows}, states
+
+
+def _zero_calls(result):
+    for name in ("run_neutral_calls", "refine_calls", "ordinary_calls", "captures"):
+        if type(result.get(name)) is not int or result[name] != 0:
+            raise ValueError("forbidden or unknown call count: " + name)
+    if type(result.get("provider_calls")) is not int or result["provider_calls"] != 1:
+        raise ValueError("saved provider load count differs")
+
+
+def _assignment(value):
+    if (not isinstance(value, list) or len(value) != 4
+            or any(not isinstance(actor, list) or len(actor) != 5 for actor in value)):
+        raise ValueError("complete20-ID assignment required")
+    ids = [artifact for actor in value for artifact in actor]
+    if any(type(artifact) is not int for artifact in ids) or len(set(ids)) != 20:
+        raise ValueError("assignment IDs duplicate or malformed")
+
+
+def _cost(value):
+    names = ("candidate_runs", "initial_program_calls", "initial_program_nanos",
+             "point_program_calls", "point_program_nanos", "finish_score_calls", "finish_score_nanos",
+             "walk_point_full_score_calls", "walk_point_full_score_nanos", "value_gradient_calls",
+             "value_gradient_nanos", "linear_assignment_calls", "linear_assignment_nanos",
+             "linear_plan_calls", "linear_plan_nanos", "linear_plan_assignment_calls",
+             "linear_plan_assignment_nanos")
+    if not isinstance(value, dict) or any(type(value.get(name)) is not int or value[name] < 0 for name in names):
+        raise ValueError("actual component cost counters/times missing or malformed")
+
+
+def _selector(rows, states):
+    if not isinstance(rows, list) or len(rows) != 524:
+        raise ValueError("full actual selector provenance missing")
+    if {row.get("package") for row in rows} != set(states):
+        raise ValueError("selector package identities differ")
+    ranks = [row.get("formula_rank") for row in rows if states[row["package"]]["state"] == "queued"]
+    if any(type(rank) is not int for rank in ranks) or sorted(ranks) != list(range(1, 524)):
+        raise ValueError("actual formula ranks do not cover every queued package")
+    if any(type(row.get("selected")) is not bool for row in rows) or sum(row["selected"] for row in rows) != 16:
+        raise ValueError("actual unchanged selector did not choose16")
+
+
+def validate_success(job, record):
+    # Durable blind outputs precede comparison against old full rows.
+    export_job(job, record)
+    original_raw = (job / "precap-b4-queue.json").read_bytes()
+    improved_raw = (job / "relinearize-b4-queue.json").read_bytes()
+    original, improved = json.loads(original_raw), json.loads(improved_raw)
+    original_result = json.loads((job / "precap-b4-result.json").read_bytes())
+    result = json.loads((job / "relinearize-b4-result.json").read_bytes())
+    if (original_result.get("complete") is not True or original_result.get("witness_pass") is not True
+            or result.get("complete") is not True or result.get("witness_pass") is not True
+            or result.get("improved_selector_pass") is not True):
+        raise ValueError("original witness or alternative stage incomplete")
+    if (original_result.get("queue_sha256") != k.sha(original_raw)
+            or result.get("original_queue_sha256") != k.sha(original_raw)
+            or result.get("improved_queue_sha256") != k.sha(improved_raw)):
+        raise ValueError("phase result/queue commitments differ")
+    baseline, states = _terminals(original, original_result)
+    alternatives, alternative_states = _terminals(improved, result)
+    if (set(baseline) != set(alternatives) or states != alternative_states
+            or states != {"queued": 523, "unavailable": 1, "reservation": 0, "error": 0}):
+        raise ValueError("original terminal states or package coverage changed")
+    _zero_calls(original_result)
+    forbidden = result.get("forbidden_path_counts")
+    names = ("run_neutral", "refine_candidates", "ordinary_engine", "compact_capture", "engine_provider_capture")
+    if (result.get("forbidden_paths_pass") is not True or not isinstance(forbidden, dict)
+            or any(type(forbidden.get(name)) is not int or forbidden[name] != 0 for name in names)):
+        raise ValueError("forbidden or unknown alternative entry counts")
+    if result.get("original_selector_rows") != original_result.get("selector_rows"):
+        raise ValueError("original selector provenance was changed")
+    _selector(original_result.get("selector_rows"), baseline)
+    _selector(result.get("improved_selector_rows"), alternatives)
+    _cost(result.get("original_screen_cost_totals")); _cost(result.get("alternative_cost_totals"))
+    processed = 0
+    for package, before in baseline.items():
+        row = alternatives[package]
+        alternative = row.get("relinearization")
+        if not isinstance(alternative, dict) or row["state"] != before["state"]:
+            raise ValueError("alternative terminal provenance missing or changed")
+        if before["state"] != "queued":
+            if alternative.get("status") != "unavailable":
+                raise ValueError("unavailable model was substituted")
+            continue
+        processed += 1
+        score = alternative.get("best_dps")
+        if (alternative.get("status") != "complete" or type(score) not in (int, float)
+                or not math.isfinite(score) or score < before["formula_dps"]
+                or alternative.get("context_sha256") != before["context_sha256"]
+                or type(alternative.get("rounds")) is not int or not 0 <= alternative["rounds"] <= 5
+                or not isinstance(alternative.get("stop"), str)):
+            raise ValueError("non-monotonic, incomplete or context-changing alternative")
+        candidate = alternative.get("best_assignment")
+        _assignment(candidate); _assignment(before["seed_assignment"])
+        _cost(alternative.get("cost"))
+        if alternative.get("pair_samples_added") != 0:
+            raise ValueError("alternative introduced pair-neighborhood evidence")
+        if any(candidate[actor] != before["seed_assignment"][actor] for actor in range(3)):
+            raise ValueError("alternative changed fixed teammates")
+    counts = result["counts"]
+    if (type(counts.get("alternative_processed")) is not int
+            or counts["alternative_processed"] != processed
+            or type(counts.get("alternative_errors")) is not int or counts["alternative_errors"] != 0
+            or type(forbidden.get("relinearize_method_calls")) is not int
+            or forbidden["relinearize_method_calls"] != processed):
+        raise ValueError("uniform alternative coverage or actual entry calls differ")
+    # Old full queue is a validation witness, never a proposal input.
+    old = json.loads(gzip.decompress((k.EVIDENCE /
+                    "adaptive-precap-b4-v3-precap-b4-queue.json.gz").read_bytes()))
+    old_rows = {row["package"]: row for row in old["rows"]}
+    if set(old_rows) != set(baseline):
+        raise ValueError("original inventory differs from retained V3")
+    for package, previous_row in old_rows.items():
+        if any(baseline[package].get(key) != value for key, value in previous_row.items()):
+            raise ValueError("original row differs from retained V3")
+    record["actual_counts"] = {"run_neutral_calls": forbidden["run_neutral"],
+        "refine_calls": forbidden["refine_candidates"], "ordinary_calls": forbidden["ordinary_engine"],
+        "captures": forbidden["compact_capture"] + forbidden["engine_provider_capture"],
+        "provider_calls": original_result["provider_calls"], "method_calls": forbidden["relinearize_method_calls"]}
+    record["coverage_counts"] = counts
+    record["witness_pass"] = True
+    record["original_all524_rows_match_v3"] = True
+
+
+def run(destination, freeze_path):
+    started = time.monotonic()
+    if destination.exists():
+        raise FileExistsError(destination)
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("repository Python required")
+    overlay = producer.relinearize_overlay()
+    plan = frozen_plan(overlay)
+    freeze = json.loads(freeze_path.read_bytes())
+    if freeze.get("source_review_status") != "approved" or freeze.get("frozen_plan") != plan:
+        raise ValueError("source-reviewed freeze differs from this exact plan")
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")) or k.gate.retirement._default_process_probe(k.ROOT):
+        raise RuntimeError("owned scratch or optimizer process is not idle")
+    if tuple(k.EVIDENCE.glob(PREFIX + "*.gz")):
+        raise FileExistsError("prior diagnostic exports exist")
+    before, native, pins = k.protected(), k.old.native_map(), source_pins()
+    record = {"owner": "main execution21October", "status": "started", "errors": [],
+              "frozen_plan": plan, "freeze_path": str(freeze_path), "freeze_sha256": k.sha(freeze_path.read_bytes()),
+              "protected_before": before, "native_map_before_sha256": k.gate.digest(native),
+              "source_pins_before": pins, "managed_jobs_created": 0, "diagnostic_launches": 0,
+              "build_launches": 0, "installs": 0, "retries": 0, "oldwinner_producer_inputs": False}
+    active = [None]
+    with destination.open("xb") as stream:
+        def save():
+            k.gate.io._save(stream, record)
+
+        def export():
+            if active[0] is not None:
+                export_job(active[0], record)
+            save()
+
+        def body(job):
+            active[0] = job
+            record["managed_jobs_created"] = 1
+            env, _ = k.gate.common._environment(job)
+            env.update(GOMEMLIMIT="2GiB", GTT_PRECAP_B4="root_released_once",
+                       GTT_TIGHNARI_REPLAY_REPO=str(k.ROOT))
+            overlay_path, staging_manifest = stage_overlay(job, overlay, native)
+            record["staging_manifest"] = staging_manifest
+            for name, raw in overlay.get("input_files", {}).items():
+                path = job / name
+                if path.parent != job or path.exists():
+                    raise ValueError("diagnostic input must be one fresh job-local file")
+                path.write_bytes(raw)
+            binary = job / "precap-b4.exe"
+
+            def command(args, label, limit):
+                remaining = WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE
+                if remaining <= 0:
+                    raise TimeoutError("cleanup reserve reached")
+                record["stage"] = label
+                record.setdefault("command_timeouts_seconds", {})[label] = min(limit, remaining)
+                save()
+                result = k.gate.owned._run_owned(args, command_kind=label, env=env,
+                    log_path=job / (label + ".log"), timeout_seconds=min(limit, remaining))
+                record.setdefault("commands", {})[label] = result; save()
+                if not k.gate.command_passed(result):
+                    record["failure_tail"] = (job / (label + ".log")).read_text(encoding="utf-8", errors="replace")[-6000:]
+                    raise RuntimeError(label + " failed")
+
+            record["build_launches"] = 1
+            command([str(k.gate.owned.GO_EXE), "-C", str(k.NATIVE), "test", "-c", "-p=1", "-mod=readonly",
+                     "-buildvcs=false", "-overlay=" + str(overlay_path), "-o", str(binary), "./internal/allsets"],
+                    "precap-b4-compile", BUILD_SECONDS)
+            record["binary_sha256"] = k.sha(binary.read_bytes())
+            command([str(binary), "-test.run=^TestAdaptivePrecapContract", "-test.v", "-test.timeout=15s"],
+                    "precap-b4-contracts", CONTRACT_SECONDS)
+            if WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE < DIAGNOSTIC_SECONDS:
+                raise TimeoutError("full diagnostic admission does not fit")
+            record["diagnostic_launches"] = 1
+            command([str(binary), "-test.run=^TestAdaptivePrecapB4Diagnostic$", "-test.v", "-test.parallel=1", "-test.timeout=60s"],
+                    "precap-b4-diagnostic", DIAGNOSTIC_SECONDS)
+            validate_success(job, record)
+            if k.protected() != before or k.old.native_map() != native or source_pins() != pins:
+                raise RuntimeError("protected/native/frozen source drift")
+            record["status"] = "relinearize_b4_diagnostic_complete"; save()
+
+        try:
+            k.gate.run_owned_body(None, record, export, body)
+        except Exception as failure:
+            record["status"] = "failed"; record["errors"].append(str(failure))
+            try:
+                export()
+            except Exception as export_failure:
+                record["export_error"] = str(export_failure)
+        finally:
+            record["protected_after"] = k.protected()
+            record["native_map_after_sha256"] = k.gate.digest(k.old.native_map())
+            record["preservation_exact"] = (record["protected_after"] == before
+                and record["native_map_after_sha256"] == k.gate.digest(native) and source_pins() == pins)
+            record["remaining_managed_jobs"] = len(tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")))
+            record["optimizer_processes_remaining"] = bool(k.gate.retirement._default_process_probe(k.ROOT))
+            record["whole_seconds"] = round(time.monotonic() - started, 3)
+            if (not record["preservation_exact"] or record["remaining_managed_jobs"]
+                    or record["optimizer_processes_remaining"] or record.get("cleanup_status") != "confirmed"
+                    or record["whole_seconds"] > WHOLE_SECONDS):
+                record["status"] = "failed"; record["errors"].append("postflight or whole budget failed")
+            save()
+    return record
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--freeze", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    result = run(args.output, args.freeze)
+    print(json.dumps({name: result.get(name) for name in (
+        "status", "errors", "whole_seconds", "coverage_counts", "witness_pass",
+        "cleanup_status", "remaining_managed_jobs", "preservation_exact")}))
+    raise SystemExit(0 if result["status"] == "relinearize_b4_diagnostic_complete" else 1)
+
+
diff --git a/tools/experiments/gcsim/mvp_polish/archive_benchmark_output.py b/tools/experiments/gcsim/mvp_polish/archive_benchmark_output.py
new file mode 100644
--- /dev/null
+++ b/tools/experiments/gcsim/mvp_polish/archive_benchmark_output.py
@@ -0,0 +1,245 @@
+"""Pure bounded collector for one archive projection Go JSONL capture.
+
+Output validity is separate from process success; callers must also use the
+independent invocation gate. No process is launched and no raw output is exported.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import math
+import re
+from typing import Any
+
+from .priority_benchmark_output import (
+    _DuplicateKey,
+    _reject_constant,
+    _strict_float,
+    _strict_object,
+)
+
+
+PACKAGE = "genshinteamstracker/native/gcsim_optimizer/internal/allsets"
+NAMED_TESTS = (
+    "TestNeutralRepresentativeProjectionMatchesLegacyAtEveryPrefix",
+    "TestRepresentativeProjectionPreservesArchiveTieAndReplacementRows",
+    "TestRepresentativeProjectionKeepsGroupLimitBeforeAssignmentDedup",
+    "TestNeutralRepresentativeSnapshotIsDetachedAndStable",
+    "TestNeutralRepresentativeProjectionGuardsAndArchiveClamp",
+    "TestNeutralStabilizationPanelIgnoresExpandedOutputLimits",
+    "TestResultArchiveKeepsBestAlternativesPerCanonicalPackageGroup",
+    "TestResultArchiveTiesAreDeterministicAndGroupsCanReenter",
+)
+BENCHMARK_ROOT = "BenchmarkResultArchiveRepresentativeProjection"
+LEAVES = ("legacy_dual", "single_archive")
+SIZES = (1, 2, 7, 50, 101)
+REPETITIONS = 3
+BENCHMARK_N = 100
+BENCHMARK_NAMES = tuple(
+    f"{BENCHMARK_ROOT}/{leaf}/K_{size}" for leaf in LEAVES for size in SIZES
+)
+_ANNOUNCEMENTS = frozenset(
+    (BENCHMARK_ROOT,)
+    + tuple(f"{BENCHMARK_ROOT}/{leaf}" for leaf in LEAVES)
+    + BENCHMARK_NAMES
+)
+_ROW_RE = re.compile(
+    r"^(?P<name>" + re.escape(BENCHMARK_ROOT)
+    + r"/(?:legacy_dual|single_archive)/K_(?:1|2|7|50|101))\s+"
+    r"(?P<n>\S+)\s+(?P<ns>\S+)\s+ns/op\s+"
+    r"(?P<bytes>\S+)\s+B/op\s+(?P<allocs>\S+)\s+allocs/op$"
+)
+_FRAME_RE = re.compile(r"^(?:=== RUN\s+|--- PASS:\s+)(?P<label>\S+)(?:\s+\(\d+(?:\.\d+)?s\))?$")
+_INTEGER_RE = re.compile(r"^[0-9]+$")
+
+MAX_JSONL_BYTES = 8 * 1024 * 1024
+MAX_JSONL_LINE_BYTES = 256 * 1024
+MAX_EVENTS = 50_000
+MAX_OUTPUT_BYTES = 2 * 1024 * 1024
+
+
+def _check_strings(value: Any) -> None:
+    """Reject escaped lone surrogates anywhere, including foreign event fields."""
+    pending = [value]
+    while pending:
+        item = pending.pop()
+        if isinstance(item, str):
+            item.encode("utf-8")
+        elif isinstance(item, dict):
+            pending.extend(item.keys())
+            pending.extend(item.values())
+        elif isinstance(item, list):
+            pending.extend(item)
+
+
+def _integer(token: str) -> int:
+    if not _INTEGER_RE.fullmatch(token):
+        raise ValueError("integer_required")
+    return int(token)
+
+
+def _rows(output: str, result: dict[str, Any]) -> None:
+    counts = dict.fromkeys(BENCHMARK_NAMES, 0)
+    for original in output.splitlines():
+        if len(original.encode("utf-8")) > MAX_JSONL_LINE_BYTES:
+            result["errors"].append("target_output_line_too_large")
+            continue
+        line = original.strip()
+        match = _ROW_RE.fullmatch(line)
+        if match:
+            name = match["name"]
+            counts[name] += 1
+            row: dict[str, Any] = {"name": name}
+            for field, token, integral in (
+                ("n", match["n"], True),
+                ("ns_per_op", match["ns"], False),
+                ("bytes_per_op", match["bytes"], True),
+                ("allocs_per_op", match["allocs"], True),
+            ):
+                try:
+                    number = _integer(token) if integral else float(token)
+                    if not integral and (not math.isfinite(number) or number < 0):
+                        raise ValueError("finite_nonnegative_required")
+                    row[field] = number
+                except (ValueError, OverflowError):
+                    row[field] = None
+                    result["errors"].append(f"benchmark_{field}_invalid")
+            if row["n"] is not None and row["n"] != BENCHMARK_N:
+                result["errors"].append("benchmark_n_mismatch")
+            result["benchmark_rows"].append(row)
+            continue
+        if line in _ANNOUNCEMENTS:
+            continue
+        framed = _FRAME_RE.fullmatch(line)
+        if framed and framed["label"] in _ANNOUNCEMENTS:
+            continue
+        # Test/subtest verbose controls are normal. Unknown benchmark labels,
+        # including suffixed CPU labels, must never become accepted announcements.
+        label = line
+        for prefix in ("=== RUN", "--- PASS:"):
+            if line.startswith(prefix):
+                label = line[len(prefix):].strip()
+                break
+        if label.startswith("Benchmark"):
+            result["errors"].append("benchmark_line_unrecognized")
+    for name, count in counts.items():
+        if count != REPETITIONS:
+            result["errors"].append(f"benchmark_row_count:{name}:{count}")
+
+
+def collect_jsonl(data: bytes) -> dict[str, Any]:
+    """Validate captured bytes and retain bounded numeric evidence on failure."""
+    is_bytes = isinstance(data, bytes)
+    if not is_bytes:
+        data = b""
+    result: dict[str, Any] = {
+        "status": "invalid",
+        "jsonl_bytes": len(data),
+        "jsonl_sha256": hashlib.sha256(data).hexdigest(),
+        "event_count": 0,
+        "target_package_event_count": 0,
+        "package_pass_events": 0,
+        "named_counts": {name: {"run": 0, "pass": 0} for name in NAMED_TESTS},
+        "benchmark_rows": [],
+        "errors": [],
+    }
+    errors = result["errors"]
+    if not is_bytes:
+        errors.append("jsonl_input_not_bytes")
+        return result
+    if len(data) > MAX_JSONL_BYTES:
+        errors.append("jsonl_too_large")
+    stream = io.BytesIO(data[:MAX_JSONL_BYTES])
+    output_parts: list[str] = []
+    output_bytes = 0
+    line_number = 0
+    while True:
+        line = stream.readline(MAX_JSONL_LINE_BYTES + 1)
+        if not line:
+            break
+        line_number += 1
+        if line_number > MAX_EVENTS:
+            errors.append("jsonl_too_many_events")
+            break
+        if len(line) > MAX_JSONL_LINE_BYTES:
+            errors.append(f"jsonl_line_too_large:{line_number}")
+            break
+        if not line.endswith(b"\n"):
+            errors.append(f"jsonl_missing_final_newline:{line_number}")
+            break
+        if not line.strip():
+            errors.append(f"jsonl_blank_line:{line_number}")
+            continue
+        try:
+            event = json.loads(
+                line.decode("utf-8"), object_pairs_hook=_strict_object,
+                parse_float=_strict_float, parse_constant=_reject_constant,
+            )
+            _check_strings(event)
+        except _DuplicateKey:
+            errors.append(f"json_duplicate_key:{line_number}")
+            continue
+        except (UnicodeError, ValueError, RecursionError):
+            errors.append(f"json_malformed:{line_number}")
+            continue
+        result["event_count"] += 1
+        if not isinstance(event, dict):
+            errors.append(f"json_event_not_object:{line_number}")
+            continue
+        if event.get("Package") != PACKAGE:
+            continue
+        result["target_package_event_count"] += 1
+        action, test_name = event.get("Action"), event.get("Test")
+        if not isinstance(action, str):
+            errors.append(f"target_action_invalid:{line_number}")
+            action = ""
+        if test_name is not None and not isinstance(test_name, str):
+            errors.append(f"target_test_name_invalid:{line_number}")
+            test_name = None
+        if test_name in result["named_counts"] and action in ("run", "pass"):
+            result["named_counts"][test_name][action] += 1
+        if action in ("fail", "skip"):
+            errors.append(f"target_package_{action}")
+        if action == "pass" and not test_name:
+            result["package_pass_events"] += 1
+        fragment = event.get("Output")
+        if fragment is None:
+            continue
+        if not isinstance(fragment, str):
+            errors.append(f"target_output_invalid:{line_number}")
+            continue
+        encoded = fragment.encode("utf-8")
+        remaining = MAX_OUTPUT_BYTES - output_bytes
+        if len(encoded) > remaining:
+            errors.append("target_output_too_large")
+            fragment = encoded[:remaining].decode("utf-8", errors="ignore")
+        output_parts.append(fragment)
+        output_bytes += len(fragment.encode("utf-8"))
+    for name, counts in result["named_counts"].items():
+        for action, count in counts.items():
+            if count != REPETITIONS:
+                errors.append(f"named_test_{action}_count:{name}:{count}")
+    if result["package_pass_events"] != 1:
+        errors.append(f"package_pass_count:{result['package_pass_events']}")
+    output = "".join(output_parts)  # Go may split a single line over many events.
+    if output and not output.endswith("\n"):
+        errors.append("target_output_missing_final_newline")
+    _rows(output, result)
+    if not errors:
+        result["status"] = "valid"
+    return result
+
+
+def invocation_is_valid(
+    collected: dict[str, Any], *, returncode: int | None,
+    timed_out: bool, launcher_error: str | None,
+) -> bool:
+    """Output acceptance never substitutes for the actual process outcome."""
+    return (
+        collected.get("status") == "valid"
+        and collected.get("errors") == []
+        and type(returncode) is int and returncode == 0
+        and timed_out is False and launcher_error is None
+    )
diff --git a/tools/experiments/gcsim/mvp_polish/candidate_preservation_case.py b/tools/experiments/gcsim/mvp_polish/candidate_preservation_case.py
new file mode 100644
