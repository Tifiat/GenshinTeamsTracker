+            receipt["status"] = "failed_unverified"
+        receipt["whole_wall_seconds"] = round(time.monotonic() - started, 3)
+        receipt["within_whole_wall_budget"] = receipt["whole_wall_seconds"] <= 300
+        if not receipt["within_whole_wall_budget"]:
+            receipt["status"] = "failed_unverified"
+        receipt["finished_utc"] = datetime.now(timezone.utc).isoformat()
+        _write(result_path, receipt, replace_existing=True)
+        print(
+            f"CLEANUP confirmed={cleanup_confirmed} removed_bytes={removed_bytes} "
+            f"remaining_jobs={receipt['cleanup']['remaining_managed_jobs']} status={receipt['status']}",
