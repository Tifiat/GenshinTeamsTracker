+    if meta.get("status") != "valid":
+        raise ValueError("profile_metadata_invalid")
+    profile = decoder.decode_profile(raw, "cpu")
+    normalized = k.gate.canonical(profile)
+    if len(normalized) > LIMITS["normalized_profile_max"]:
+        raise ValueError("normalized_profile_export_bound")
