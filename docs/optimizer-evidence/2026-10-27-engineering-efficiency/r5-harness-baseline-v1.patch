+def file_map(root, predicate=lambda _path: True):
+    managed.assert_unlinked(root)
+    result = {}
+    for directory, children, files in os.walk(root, followlinks=False):
+        for name in children:
+            managed.assert_unlinked(Path(directory) / name)
+        for name in files:
+            path = Path(directory) / name
+            managed.assert_unlinked(path)
+            if predicate(path):
+                result[path.relative_to(root).as_posix()] = {"bytes": path.stat().st_size, "sha256": owned._sha256_file(path)}
+    return result
+
