+def _finalize_test_harness(
+    *,
+    harness,
+    summary_path: Path,
+    summary: dict,
+    started: float,
+) -> bool:
+    """Persist a bounded receipt after joining, even when teardown raises."""
+    joined = True
+    try:
+        if harness is not None:
+            joined = harness.shutdown_for_test() is True
+            if not joined:
+                summary["status"] = "failed"
+                summary["errors"] = {"code": "worker_thread_join_failed", "class": "QThread"}
+            else:
+                try:
+                    harness.close()
+                    harness.deleteLater()
+                    _APP.processEvents()
+                except Exception as exc:
+                    summary["status"] = "failed"
+                    summary["errors"] = {"code": "harness_teardown_failed", "class": type(exc).__name__}
+    except Exception as exc:
+        joined = False
+        if harness is not None:
+            worker = getattr(harness, "_gcsim_browser_run_worker", None)
+            thread = getattr(harness, "_gcsim_browser_run_thread", None)
+            _UNJOINED_TEST_THREADS.append((harness, worker, thread))
+        summary["status"] = "failed"
+        summary["errors"] = {"code": "harness_shutdown_failed", "class": type(exc).__name__}
+    finally:
+        summary.setdefault("process_guard", {})["worker_thread_joined"] = (
+            joined if harness is not None else None
+        )
+        summary.setdefault("timings_ms", {})["whole_test_child_elapsed_ms"] = round(
+            (time.monotonic() - started) * 1000
+        )
+        _write_child_summary(summary_path, summary)
+    return joined
+
