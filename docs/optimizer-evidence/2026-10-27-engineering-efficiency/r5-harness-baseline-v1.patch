+"""Case-specific actual production preparation inside V4's existing owned job.
+
+No active-pointer write or alternate DB abstraction. Only the actual engine
+context loader is privately bound to an independently resealed candidate tree.
+The original preparer still derives all request, snapshot and trace identities.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parents[5]
+
+
+def services():
+    from tools.experiments.gcsim.mvp_polish import prepare_navia_exact_pair, navia_exact_pair
+    from run_workspace.gcsim import optimizer_engine_context, engine_store, source_manifest_build
+    from run_workspace.gcsim.rotation_editor import source, syntax
+    production = prepare_navia_exact_pair.production_services()
+    return SimpleNamespace(**locals())
+
+
+def candidate_binding(engine_path):
+    """Read actual context/manifest bytes using production binding validation."""
+    api = services()
+    root = Path(engine_path).resolve(strict=True)
+    api.navia_exact_pair.require(root.is_relative_to(ROOT), "v4_candidate_outside_main")
+    api.navia_exact_pair.require(root.is_dir(), "v4_candidate_tree_missing")
+    manifest = api.engine_store.load_engine_manifest(root)
+    installation = api.engine_store.GcsimEngineInstallation(manifest.engine_id, root, manifest)
+    context = api.optimizer_engine_context.build_gcsim_optimizer_engine_context(installation, require_resealed=True)
+    body = json.loads((root / "build/gtt-source-manifest-body.json").read_bytes())
+    source_sha = api.navia_exact_pair.sha(api.source_manifest_build.canonical_json(body).encode())
+    patch_sha = manifest.patch_metadata["patch_stack_sha256"]
+    binding_sha = api.production.canonical_sha256({"kind": "gtt.standalone_engine_binding.v1",
+        "artifact_sha256": context.artifact_sha256, "source_manifest_sha256": source_sha,
+        "patch_manifest_sha256": patch_sha})
+    wire = {"binary_path": str(Path(context.artifact_path).resolve()).replace("\\", "/"),
+        "artifact_sha256": context.artifact_sha256, "binding_sha256": binding_sha,
+        "source_manifest_sha256": source_sha, "patch_manifest_sha256": patch_sha,
+        "capabilities": sorted(context.capabilities)}
+    return context, wire
+
+
+def prepare_owned(chasca, job, *, review, source_pins, allowance, scratch):
+    """One real readonly-account snapshot and production preparation; no Go.
+
+    Caller already owns the single managed lease/job. Every drift rejects the
+    stage before compile/capture; no new team, private data substitution or retry.
+    """
+    api = services()
+    controller, require, sha = api.navia_exact_pair, api.navia_exact_pair.require, api.navia_exact_pair.sha
+    job = api.prepare_navia_exact_pair.owned_job(chasca, job)
+    allowance(90)
+    scratch(job, "v4_production_prepare_before")
+    controller.verify_project_sources(chasca, source_pins)
+    metadata = json.loads(Path(review["original_metadata_path"]).read_bytes())
+    private_pin = metadata["private_input"]
+    private = controller.read_bound_json(private_pin["path"], private_pin["sha256"])
+    require(private["schema_kind"] == "gtt_navia_owned_production_protocol_v1", "v4_original_private_protocol_shape")
+    case = api.production.case
+    old_request_raw = (Path(review["original_capsule_path"]) / "prepared/request.json").read_bytes()
+    require(sha(old_request_raw) == review["original_request_raw_sha256"], "v4_original_capsule_request_drift")
+    wire = case.read_wire(private["requests"]["all_sets"])
+    require(wire == json.loads(old_request_raw), "v4_retained_wire_and_capsule_differ")
+    for pin in private["pins"].values():
+        path = Path(pin["path"]).resolve(strict=True)
+        require(path.is_relative_to(ROOT) and source_pins.get(path.relative_to(ROOT).as_posix()) == pin["sha256"],
+                "v4_private_input_source_not_pinned")
+        case.read_pin(pin, limit=32 << 20)
+    case.read_pin(private["runtime"]["optimizer"], limit=128 << 20)
+    context, engine_wire = candidate_binding(review["candidate_engine_path"])
+    require(engine_wire == review["engine_binding"], "v4_resealed_candidate_binding_drift")
+    account = private["account_database"]
+    database = job / "account-snapshot.db"
+    case.snapshot_account(account["database"]["path"], database, account)
+    connection = case.readonly_connection(database)
+    try:
+        # Real source dialect preserves declaration/RNG order; no sorted-team
+        # replacement follows from the canonical wire wearers' sorted order.
+        dialect = api.source.load_source_dialect(Path(context.engine_root))
+        team = case.team_from_account(connection, wire, dialect=dialect)
+    finally:
+        connection.close()
+    require(api.production.canonical_sha256(team) == private["new_team_sha256"], "v4_retained_team_or_order_drift")
+    folder = job / "production-prepared"
+    folder.mkdir(mode=0o700)
+    runtime = {**private["runtime"], "engine_id": context.engine_id}
+    request = api.production.request_type(**case.request_kwargs(wire, db_path=database, team=team,
+        runtime=runtime, run_root=folder))
+    def load_candidate(*, store_dir, require_resealed=True):
+        require(Path(store_dir).resolve() == Path(runtime["engine_store_dir"]).resolve() and require_resealed is True,
+                "v4_private_context_loader_scope")
+        verified, current_wire = candidate_binding(review["candidate_engine_path"])
+        require(current_wire == engine_wire, "v4_candidate_context_changed")
+        return verified
+    prepare = controller.function_view(api.production.prepare,
+        load_active_gcsim_optimizer_engine_context=load_candidate)
+    prepared = prepare(request, folder, mode="all_sets")
+    request_raw = chasca.gate.io._read_optional(folder / "request.json", 1 << 20)
+    require(json.loads(request_raw) == prepared["request"], "v4_production_raw_request_drift")
+    require(prepared["request"]["engine"] == engine_wire, "v4_production_engine_binding_differs")
+    source_path = folder / "set-sources.json"
+    api.production.write_canonical(source_path, api.production.sources(Path(context.engine_root), engine_wire,
+        include_neutral_rules=True))
+    sources_raw = chasca.gate.io._read_optional(source_path, 16 << 20)
+    from tools.experiments.gcsim.mvp_polish.navia_gap_point import ordinary_v4
+    admission = ordinary_v4.validate_preparation(old_request_raw, request_raw, sources_raw, prepared=prepared,
+        reviewed_engine=engine_wire, expected_request_sha256=prepared["request_sha256"], expected_sources_sha256=sha(sources_raw))
+    require(case.database_pins(account["database"]["path"]) == account, "v4_source_account_drift_during_prepare")
+    controller.verify_project_sources(chasca, source_pins)
+    scratch(job, "v4_production_prepare_after")
+    receipt = {"producer": "actual prepare_optimizer_inputs plus prepare_all_set_effect_sources",
+        "account_snapshots": 1, "source_account_readonly": True, "private_context_loader": "actual build_gcsim_optimizer_engine_context require_resealed=True",
+        "active_pointer_writes": 0, "source_account_before_after_pins_exact": True,
+        "team_and_declaration_order_equal_original": True, "all_597_artifact_and_non_engine_trace_request_fields_exact": True,
+        "actual_request_sha256": prepared["request_sha256"], "actual_request_raw_sha256": sha(request_raw),
+        "actual_sources_sha256": sha(sources_raw), "admission": admission,
+        "budget_scope": "same owned job and enclosing600-second timer; before any Go or engine command"}
+    return prepared, request_raw, sources_raw, receipt
diff --git a/tools/experiments/gcsim/mvp_polish/preparation_exact_reuse.py b/tools/experiments/gcsim/mvp_polish/preparation_exact_reuse.py
