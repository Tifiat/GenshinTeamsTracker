+        "GTT_MVP_POLISH_PROCESS_CAP": str(PROCESS_CAP_BY_MODE[mode]),
+        "GTT_MVP_POLISH_CASE_ROOT": str(paths["inputs"]),
+        "GTT_MVP_POLISH_RUN_ROOT": str(paths["runs"]),
+        "GTT_MVP_POLISH_SUMMARY_PATH": str(job / "case-summary.json"),
+        "GTT_RULE_BUNDLED_CACHE_DIR": str(ROOT / "native/gcsim_optimizer/set-rule-cache"),
+        "GTT_RULE_CACHE_DIR": str(paths["rules"]),
+        "TMP": str(paths["temp"]),
+        "TEMP": str(paths["temp"]),
+        "APPDATA": str(paths["appdata_roaming"]),
+        "LOCALAPPDATA": str(paths["appdata_local"]),
+        "XDG_CONFIG_HOME": str(paths["xdg_config"]),
+        "XDG_CACHE_HOME": str(paths["xdg_cache"]),
+        "XDG_STATE_HOME": str(paths["xdg_state"]),
+        "QT_QPA_PLATFORM": "offscreen",
+        "PYTHONDONTWRITEBYTECODE": "1",
+        "PYTHONNOUSERSITE": "1",
