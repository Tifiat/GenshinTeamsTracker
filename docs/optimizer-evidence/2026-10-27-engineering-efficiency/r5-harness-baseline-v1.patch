+def _write_once(path: Path, raw: bytes) -> None:
+    with path.open("xb") as stream:
+        stream.write(raw)
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def _consumer_path(root: Path) -> Path:
+    return root / "native/gcsim_optimizer/gtt-optimizer.exe"
+
+
+def _protected_unchanged(before: dict, after: dict, allowed: set[str]) -> None:
+    if set(after) != set(before) or any(after[key] != before[key] for key in before if key not in allowed):
+        raise ValueError("unified_uptake_protected_drift")
