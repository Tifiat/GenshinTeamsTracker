+def sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def bounded(path: Path, maximum: int = MAX_ARCHIVE) -> bytes:
+    size = path.stat().st_size
+    if size > maximum:
+        raise ValueError("preservation_file_cap")
+    with path.open("rb") as stream:
+        raw = stream.read(size + 1)
+    if len(raw) != size or path.stat().st_size != size:
+        raise ValueError("preservation_file_changed")
+    return raw
+
+
+def accepted_product_images() -> dict[str, bytes]:
+    """Reconstruct accepted 361-image source without reading the mutable tree."""
+    images = accepted._accepted_v8_images()
+    accepted_keys = set(images)
+    manifest_path = accepted.PORT_MANIFEST
+    if sha(bounded(manifest_path)) != accepted.PORT_MANIFEST_SHA:
+        raise ValueError("preservation_port_manifest_changed")
+    manifest = json.loads(bounded(manifest_path))
+    pins = manifest.get("paths")
+    if (manifest.get("schema") != "health_unified_product_port_source_v4"
+            or manifest.get("accepted_archive_manifest_sha256") != accepted.ACCEPTED_ARCHIVE_MANIFEST_SHA
+            or type(pins) is not dict or len(pins) != 40):
+        raise ValueError("preservation_port_manifest_invalid")
+    for relative, expected in sorted(pins.items()):
+        parts = Path(relative).parts
+        if (not parts or parts[0] not in ("cmd", "internal")
+                or any(part in ("", ".", "..") for part in parts)
+                or not relative.endswith(".go") or type(expected) is not str):
+            raise ValueError("preservation_port_path_invalid")
+        archive = EVIDENCE / ("health-unified-uptake-v7-product-port-source-images__"
+                              + relative.replace("/", "__") + ".gz")
+        if not archive.resolve(strict=True).is_relative_to(EVIDENCE.resolve(strict=True)):
+            raise ValueError("preservation_port_archive_outside_evidence")
+        raw = gzip.decompress(bounded(archive))
+        if len(raw) > MAX_ARCHIVE or sha(raw) != expected:
+            raise ValueError("preservation_port_archive_changed")
+        images[relative] = raw
+    if len(images) != 361 or set(images) != accepted_keys | set(pins):
+        raise ValueError("preservation_product_source_count")
+    return images
+
