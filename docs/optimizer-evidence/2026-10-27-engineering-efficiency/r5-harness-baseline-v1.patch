+def compare_candidate_quality(product_result: dict) -> dict:
+    """Join fresh product verification to frozen same-engine ordinary rows."""
+    frozen = json.loads(gzip.decompress(_bounded(FROZEN_QUALITY)))
+    archived = {}
+    for row in (*frozen["product_verification_cohort"],
+                *frozen["candidate_raw_search"], *frozen["candidate_anchors"]):
+        config = row["candidate_config_sha256"]
+        measurements = tuple(row[key] for key in
+                             ("measured_dps", "standard_error", "standard_deviation"))
+        if config in archived and archived[config]["measurements"] != measurements:
+            raise ValueError("uptake_archived_quality_conflicting_batch")
+        archived[config] = {"measurements": measurements, "label": row["label"]}
+    cohort = product_result.get("verification", {}).get("candidates", [])
+    if len(cohort) != 9:
+        raise ValueError("uptake_quality_cohort_not_nine")
+    joined = []
+    unmatched = []
+    for row in cohort:
+        config = row.get("config_sha256")
+        reference = archived.get(config)
+        _assignment(row.get("assignment"))
+        if (type(config) is not str or len(config) != 64
+                or row.get("iterations") != 500):
+            raise ValueError("uptake_quality_product_row_invalid")
+        observed = tuple(row.get(key) for key in
+                         ("measured_dps", "standard_error", "standard_deviation"))
+        if (any(type(value) not in (int, float) or not math.isfinite(float(value)) for value in observed)
+                or observed[1] < 0 or observed[2] < 0):
+            raise ValueError("uptake_quality_measurement_missing")
+        if reference is None:
+            unmatched.append({"product_rank": row.get("rank"), "config_sha256": config,
+                              "measured_dps": observed[0], "standard_error": observed[1]})
+            continue
+        retained = reference["measurements"]
+        difference = float(observed[0]) - float(retained[0])
+        difference_se = math.hypot(float(observed[1]), float(retained[1]))
+        joined.append({"product_rank": row.get("rank"), "config_sha256": config,
+                       "frozen_label": reference["label"],
+                       "fresh_measured_dps": observed[0], "fresh_standard_error": observed[1],
+                       "retained_measured_dps": retained[0], "retained_standard_error": retained[1],
+                       "fresh_minus_retained_dps": difference,
+                       "descriptive_independent_interval95": [difference - 1.96 * difference_se,
+                                                              difference + 1.96 * difference_se]})
+    frozen_best = frozen["candidate_raw_search_best"]["candidate_config_sha256"]
+    winner = max(cohort, key=lambda row: row["measured_dps"])
+    if winner["config_sha256"] not in archived:
+        raise ValueError("uptake_winner_requires_bounded_common_check")
+    raw_best = frozen["candidate_raw_search_best"]
+    winner_difference = float(winner["measured_dps"]) - float(raw_best["measured_dps"])
+    winner_difference_se = math.hypot(float(winner["standard_error"]),
+                                      float(raw_best["standard_error"]))
+    winner_interval = [winner_difference - 1.96 * winner_difference_se,
+                       winner_difference + 1.96 * winner_difference_se]
+    if winner_interval[1] < 0:
+        raise ValueError("uptake_clear_quality_regression")
+    return {"archive_sha256": sha(_bounded(FROZEN_QUALITY)),
+            "same_engine_ordinary_joins": joined, "unmatched_nonwinning_configs": unmatched,
+            "frozen_research_best_config_sha256": frozen_best,
+            "frozen_research_best_present_in_product_cohort": frozen_best in {row["config_sha256"] for row in cohort},
+            "product_best_config_sha256": winner["config_sha256"],
+            "fresh_winner_minus_retained_raw_best_dps": winner_difference,
+            "descriptive_independent_interval95": winner_interval,
+            "no_loss_proved": False, "global_optimum_proved": False,
+            "selection_adjustment_applied": False,
+            "iterations": 500,
+            "comparison": "same engine and rendered config where joined; fresh independent ordinary batches, postselection interval descriptive"}
+
