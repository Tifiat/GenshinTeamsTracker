+def physical_gear(assignments: list[dict], records: dict[int, dict], definitions: dict,
+                  *, layer: str) -> dict:
+    wearers: dict[str, list] = {}
+    seen: set[int] = set()
+    for assignment in assignments:
+        aid, wearer = assignment.get("artifact_id"), assignment.get("wearer_key")
+        if type(aid) is not int or aid not in records or not isinstance(wearer, str):
+            raise ValueError("gear identity is not a real artifact in the frozen account inventory")
+        if aid in seen:
+            raise ValueError("gear repeats a physical artifact")
+        seen.add(aid)
+        wearers.setdefault(wearer, []).append(records[aid])
+    return {"layer": layer, "mapping_status": "complete" if len(seen) == 20 and len(wearers) == 4 else "partial",
+        "artifact_count": len(seen), "wearers": [{"wearer_key": key, "artifacts": rows,
+            "active_set_bonuses": describe_bonuses(Counter(x["set_key"] for x in rows), definitions)}
+            for key, rows in wearers.items()]}
