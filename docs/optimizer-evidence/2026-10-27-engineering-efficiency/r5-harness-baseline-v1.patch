+    if case.status != "prepared_not_executed" or not case.synthetic_set_domain_keys:
+        raise ValueError(f"Case {case_id!r} is prepared-only and cannot be executed")
+    button_mode_policy(mode)
+    if not execute:
+        raise ValueError("Numeric execution requires explicit --execute")
+    if not str(lease_id).strip():
+        raise ValueError("Numeric execution requires a non-empty orchestration --lease-id")
+    if isinstance(timeout_seconds, bool) or not 1 <= int(timeout_seconds) <= OUTER_TIMEOUT_MAX_SECONDS:
+        raise ValueError(f"Outer watchdog must be between 1 and {OUTER_TIMEOUT_MAX_SECONDS} seconds")
