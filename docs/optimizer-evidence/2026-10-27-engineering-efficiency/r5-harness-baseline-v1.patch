+def _technical(text: str, root: Path) -> str:
+    text = text.replace(str(root), "<owned>").replace(str(button.ROOT), "<project>")
+    # These backends have no authentication input. Still redact credential-shaped
+    # lines rather than exporting them if a future stderr producer changes.
+    return re.sub(r"(?i)(authorization|cookie|access_token|refresh_token)\s*[:=][^\n]*",
+                  r"\1:[redacted]", text)[:4096]
