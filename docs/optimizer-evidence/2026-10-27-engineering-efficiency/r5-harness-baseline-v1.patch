+    policy = dict(raw)
+    for field in ("set_group_limit", "builds_per_group"):
+        if type(policy.get(field)) is not int or policy[field] < 1:
+            raise ValueError(f"Invalid MVP button mode policy field: {mode}.{field}")
+    for field in ("fast_mode", "expanded_limits"):
+        if type(policy.get(field)) is not bool:
+            raise ValueError(f"Invalid MVP button mode policy field: {mode}.{field}")
+    if policy["fast_mode"] or policy["expanded_limits"]:
+        raise ValueError("MVP button mode policy must retain measured, default limits")
+    return policy
+
+
+def case_review_policy() -> str:
+    manifest = json.loads(CASE_MANIFEST_PATH.read_text(encoding="utf-8"))
+    return str(manifest.get("paired_control_policy") or "")
+
+
+def _stat_mapping(artiscan_key: str):
+    property_type = ARTISCAN_STAT_KEY_TO_PROPERTY_TYPE.get(artiscan_key)
+    mapping = STAT_MAPPINGS_BY_PROPERTY_TYPE.get(property_type)
+    if mapping is None:
+        raise ValueError(f"No project stat mapping for public template key {artiscan_key!r}")
+    return mapping
+
+
+def _substat_templates() -> tuple[dict[str, Any], ...]:
+    artiscan_to_roll_key = {
+        "hp": "hp", "atk": "atk", "def": "def", "hp_": "hp%", "atk_": "atk%",
+        "def_": "def%", "eleMas": "em", "enerRech_": "er", "critRate_": "cr", "critDMG_": "cd",
+    }
+    rows = []
+    for artiscan_key, roll_key in artiscan_to_roll_key.items():
+        mapping = _stat_mapping(artiscan_key)
+        rule = FIVE_STAR_SUBSTAT_ROLL_RULES[roll_key]
+        rows.append({
+            "stat_key": artiscan_key,
+            "roll_key": roll_key,
+            "property_type": mapping.property_type,
+            "property_name": PROPERTY_TYPE_NAMES[mapping.property_type],
+            "roll_values": tuple(Decimal(str(value)) for value in rule.values),
+            "percent": artiscan_key in {"hp_", "atk_", "def_", "enerRech_", "critRate_", "critDMG_"},
+        })
+    return tuple(rows)
+
+
+def _display_substat_total(template: Mapping[str, Any], rolled_value: Decimal) -> str:
+    """Round only the summed legal roll value to the artifact display unit."""
+    percent = bool(template["percent"])
+    display_value = rolled_value * Decimal(100) if percent else rolled_value
+    quantum = Decimal("0.1") if percent else Decimal("1")
+    value = display_value.quantize(quantum, rounding=ROUND_HALF_UP)
+    text = format(value.normalize(), "f")
+    return f"{text}%" if percent else text
+
+
+_SUBSTAT_PROFILES = (
+    ("critRate_", "critDMG_", "atk_", "enerRech_", "eleMas", "hp_", "atk", "hp", "def_", "def"),
+    ("enerRech_", "critRate_", "critDMG_", "atk_", "hp_", "eleMas", "atk", "hp", "def_", "def"),
+    ("critRate_", "critDMG_", "atk_", "eleMas", "enerRech_", "hp_", "atk", "hp", "def_", "def"),
+    ("hp_", "enerRech_", "hp", "critRate_", "critDMG_", "atk_", "def_", "def", "atk", "eleMas"),
+)
+
+
+def _substats_for_main(
+    main_property_type: int,
+    template_rows: tuple[dict[str, Any], ...],
+    profile_index: int,
+    artifact_id: int,
+) -> list[dict[str, Any]]:
+    by_key = {row["stat_key"]: row for row in template_rows}
+    preference = _SUBSTAT_PROFILES[profile_index % len(_SUBSTAT_PROFILES)]
+    selected_keys = [
+        key for key in preference
+        if by_key[key]["property_type"] != main_property_type
+    ][:4]
+    if len(selected_keys) < 4:
+        for row in template_rows:
+            if row["property_type"] != main_property_type and row["stat_key"] not in selected_keys:
+                selected_keys.append(row["stat_key"])
+            if len(selected_keys) == 4:
+                break
+    if len(selected_keys) != 4 or len(set(selected_keys)) != 4:
+        raise ValueError("Could not create four legal distinct substats without a main-stat collision")
+
+    # Four starting lines plus five upgrades. The project schema stores the
+    # rolled value and the number of additional upgrade procs separately.
+    upgrades = (2, 1, 1, 1)
+    result: list[dict[str, Any]] = []
+    for line_index, key in enumerate(selected_keys):
+        row = by_key[key]
+        value = Decimal("0")
+        roll_count = 1 + upgrades[line_index]
+        for roll_index in range(roll_count):
+            tier_index = (artifact_id + line_index + roll_index) % len(ROLL_VALUE_QUALITIES)
+            value += row["roll_values"][tier_index]
+        value_text = _display_substat_total(row, value)
+        result.append({
+            "property_type": row["property_type"],
+            "property_name": row["property_name"],
+            "value": value_text,
+            "times": upgrades[line_index],
+            "stat_key": key,
+        })
+    if sum(item["times"] for item in result) != 5:
+        raise AssertionError("Synthetic five-star artifact must contain exactly five upgrade events")
+    return result
+
+
+def create_archetype_fixture(
+    root: str | Path,
+    case_id: str,
+    *,
+    store_dir: str | Path | None = None,
+) -> tuple[Path, dict[str, Any], str, dict[str, Any]]:
+    """Build an isolated synthetic inventory with catalog-pinned set starts.
+
+    Each case uses four explicit baseline set domains plus two alternatives
+    and a pinned bounded inventory. Four complete baseline profile builds are
+    equipped. No live account database or imported artifacts are read.
+    """
+    case = load_case(case_id)
+    if (
+        not case.synthetic_set_domain_keys
+        or case.expected_artifact_count is None
+        or case.status != "prepared_not_executed"
+    ):
+        raise ValueError(f"Case {case_id!r} has no prepared synthetic fixture plan")
+    root_path = Path(root).expanduser().resolve()
+    root_path.mkdir(parents=True, exist_ok=True)
+    db_path = root_path / f"{case.case_id}-synthetic.db"
+    if db_path.exists():
+        raise FileExistsError(f"Refusing to replace existing synthetic database: {db_path}")
+
+    store = GcsimEngineStore(store_dir or os.environ.get("GTT_OPTIMIZER_BUTTON_ENGINE_STORE"))
+    installation = store.get_active_engine()
+    if installation is None:
+        raise RuntimeError("No active GCSIM engine catalog is installed")
+    roster = load_active_virtual_roster_catalog(store=store)
+    if roster.engine_id != installation.engine_id:
+        raise RuntimeError("Active public roster catalog does not match selected engine")
+    characters_by_key = {item.gcsim_key.casefold(): item for item in roster.characters}
+    weapons_by_key = {item.gcsim_key.casefold(): item for item in roster.weapons}
+    set_catalog = load_gcsim_artifact_set_catalog(installation.path)
+    set_catalog_by_key = {item.key.casefold(): item for item in set_catalog.sets}
+    selected_sets = []
+    for pinned_key in case.synthetic_set_domain_keys:
+        item = set_catalog_by_key.get(pinned_key.casefold())
+        if item is None or not item.registered or not item.optimizer_four_piece_ready:
+            raise RuntimeError(f"Pinned synthetic set is unavailable in the active public catalog: {pinned_key}")
+        selected_sets.append(item)
+    selected_sets = tuple(selected_sets)
+
+    profile_rows: list[tuple[Mapping[str, Any], Any, Any]] = []
+    for profile in case.source_profiles:
+        character_key = str(profile["character_key"]).casefold()
+        weapon_key = str(profile["weapon_key"]).casefold()
+        character = characters_by_key.get(character_key)
+        weapon = weapons_by_key.get(weapon_key)
+        if character is None or weapon is None:
+            raise ValueError(f"Active engine catalog is missing pinned profile {character_key}/{weapon_key}")
+        if weapon not in compatible_weapons(character, roster.weapons):
+            raise ValueError(f"Pinned public weapon is incompatible with {character_key}")
+        profile_rows.append((profile, character, weapon))
+
+    inventory_templates = _substat_templates()
+    connection = sqlite3.connect(db_path)
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA foreign_keys = ON")
+    artifacts_by_set_pos_variant: dict[tuple[str, int, int], list[int]] = {}
+    inventory_facts: list[dict[str, Any]] = []
+    try:
+        init_db(connection)
+        artifact_id = 0
+        baseline_set_keys = set(case.synthetic_set_starts_by_character.values())
+        for set_item in selected_sets:
+            set_key = set_item.key
+            baseline_set = set_key in baseline_set_keys
+            set_alternative_mains = case.synthetic_alternative_set_main_stats.get(set_key, {})
+            for position in range(1, 6):
+                if not baseline_set and position >= 3:
+                    main_keys = (set_alternative_mains[str(position)],)
+                else:
+                    main_keys = case.main_stat_options_by_position[str(position)]
+                variant_count = max(4 if baseline_set else 1, len(main_keys))
+                for variant_index in range(variant_count):
+                    main_key = main_keys[variant_index % len(main_keys)]
+                    artifact_id += 1
+                    main = _stat_mapping(main_key)
+                    main_value = ARTISCAN_MAX_MAIN_STAT_VALUES[(5, main_key)]
+                    profile_index = variant_index % len(case.source_profiles)
+                    substats = _substats_for_main(
+                        main.property_type, inventory_templates, profile_index, artifact_id
+                    )
+                    content_fingerprint = artifact_content_fingerprint(
+                        set_uid=set_key,
+                        pos=position,
+                        rarity=5,
+                        level=20,
+                        main_property_type=main.property_type,
+                        main_property_value=main_value,
+                        substats=substats,
+                    )
+                    physical_fingerprint = hashlib.sha256(
