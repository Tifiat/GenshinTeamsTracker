+def _theory_gear(run_root: Path, database: Path, store: Path) -> dict:
+    from ui.gcsim_browser.theory_result import TheoryResultPages, build_theory_page
+    from run_workspace.gcsim.engine_store import GcsimEngineStore
+    choices = load_active_virtual_artifact_set_choices(database, language="en-us", store=GcsimEngineStore(store))
+    candidates = [p for run in sorted(run_root.glob("*")) for p in
+                  (run / "theory-result.json", run / "optimizer-output.json") if p.is_file() and not p.is_symlink()]
+    for path in sorted(candidates, key=lambda x: x.stat().st_mtime_ns, reverse=True):
+        if path.stat().st_size > 16 << 20:
+            continue
+        try:
+            raw = json.loads(path.read_bytes())
+            snapshot = raw.get("product_result", raw)
+            pages = TheoryResultPages(snapshot, set_choices=choices)
+            if not len(pages):
+                continue
+            page = build_theory_page(pages, 0)
+        except (ValueError, KeyError, TypeError):
+            continue
+        definitions = set_definitions(database, store)
+        wearers = []
+        for row in page.rows:
+            artifacts = [{"artifact_id": None, "virtual_item": f"{row.wearer_key}/{a.pos}",
+                "set_key": a.set_uid, "slot": a.pos_name,
+                "main_stat": {"name": a.main_property_name, "value": a.main_property_value},
+                "substats": [{"name": x.property_name, "value": x.value} for x in a.substats]}
+                for a in row.artifacts]
+            wearers.append({"wearer_key": row.wearer_key, "artifacts": artifacts,
+                "active_set_bonuses": describe_bonuses(Counter(x["set_key"] for x in artifacts), definitions)})
+        return {"layer": "ordinary_verified_theory_virtual_witness", "mapping_status": "complete",
+                "artifact_count": 20, "wearers": wearers, "physical_artifact_ids": False}
+    return {"layer": "theory_virtual_witness", "mapping_status": "unavailable", "artifact_count": 0}
+
+
+def install_capture(test_module, destination: Path) -> ExitStack:
+    """Wrap the existing adapted child; call after the real-inventory adapter."""
+    root = Path(os.environ["GTT_MECHANIC_PACKET_OWNED_ROOT"]).resolve(strict=True)
+    destination = destination.resolve()
+    destination.relative_to(root)
+    destination.mkdir(parents=True, exist_ok=False)
+    original_create, original_finalize = test_module._create_admitted_fixture, test_module._finalize_test_harness
+    captured: dict = {}
+
+    def create(*args, **kwargs):
+        result = original_create(*args, **kwargs)
+        database, team = Path(result[0]), result[1]
+        store = Path(kwargs["store_dir"])
+        records, definitions = artifact_rows(database, store), set_definitions(database, store)
+        assignments, requested = [], []
+        with closing(sqlite3.connect(database.as_uri()+"?mode=ro", uri=True)) as conn:
+            conn.row_factory = sqlite3.Row
+            for slot in team["slots"]:
+                override = slot["gcsim_virtual_override"]
+                wearer = override["character"]["gcsim_key"]
+                rows = get_artifact_build_slots(conn, int(override["artifact_build_id"]))
+                assignments.extend({"wearer_key": wearer, "artifact_id": int(row["artifact_id"])} for row in rows)
+                requested.append({"wearer_key": wearer, "sets": override.get("artifact_set_bonuses", [])})
+        captured.update(database=database, store=store, records=records, definitions=definitions)
+        input_gear = physical_gear(assignments, records, definitions, layer="actual_input_equipped_owned")
+        input_gear["requested_set_packages"] = requested
+        input_gear["selected_set_source_details"] = result[3].get("selected_sets_by_character", {})
+        input_gear["disposable_input_slot_repairs"] = result[3].get("disposable_input_slot_repairs", [])
+        input_gear["input_assignment_policy"] = result[3].get("input_assignment_policy", "original fixture policy")
+        input_gear["selected_inventory_admission"] = "see actual preflight/adapter_terminal_errors; no missing inventory inferred from source labels"
+        write_json(destination / "input-gear.json", input_gear)
+        return result
+
+    def finalize(**kwargs):
+        harness = kwargs.get("harness")
+        adapter_errors = []
+        for payload in getattr(harness, "payloads", ()):
+            if isinstance(payload, dict) and payload.get("success") is not True:
+                adapter_errors.append({key: _technical(payload[key], root)
+                    for key in ("error_code", "error", "message") if isinstance(payload.get(key), str)})
+        joined = original_finalize(**kwargs)
+        run_root = Path(os.environ["GTT_MVP_POLISH_RUN_ROOT"]).resolve(strict=True)
+        causes = native_causes(run_root)
+        causes["adapter_terminal_errors"] = adapter_errors[:8]
+        write_json(destination / "native-causes.json", causes)
+        summary = kwargs["summary"]
+        rs = summary.get("result_summary", {})
+        assignments = rs.get("winner_assignments")
+        if captured and isinstance(assignments, list) and assignments:
+            result_gear = physical_gear(assignments, captured["records"], captured["definitions"], layer="ordinary_measured_winner")
+        elif captured and summary.get("mode") == "theory":
+            result_gear = _theory_gear(run_root, captured["database"], captured["store"])
+        else:
+            result_gear = {"layer": "result", "mapping_status": "unavailable", "artifact_count": 0,
+                           "reason": "no saved verified winner; no mapping inferred"}
+        write_json(destination / "result-gear.json", result_gear)
+        return joined
+
+    stack = ExitStack()
+    stack.enter_context(patch.object(test_module, "_create_admitted_fixture", create))
+    stack.enter_context(patch.object(test_module, "_finalize_test_harness", finalize))
+    return stack
