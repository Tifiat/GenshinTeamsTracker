+        "command_argv": _command(), "limits": LIMITS, "result": RESULT_REL,
+        "pins": pins, "runtime_files": RUNTIME_FILES, "expected_head": EXPECTED_HEAD,
+    }
+    for key, value in expected.items():
+        # Canonical JSON distinguishes booleans from integers and binds nested keys.
+        if key not in protocol or _canonical_digest(protocol[key]) != _canonical_digest(value):
+            raise ValueError("protocol_contract_mismatch:" + key)
+
+
+def _preflight(protocol_path: Path, protocol_sha: str) -> dict[str, Any]:
+    _require_project_interpreter()
+    if Path(sys.executable).resolve(strict=True) != PROJECT_PYTHON.resolve(strict=True):
+        raise ValueError("project_interpreter_mismatch")
+    relative = protocol_path.absolute().relative_to(ROOT)
+    if ".." in relative.parts or relative.parts[:2] != ("docs", "optimizer-evidence"):
+        raise ValueError("protocol_path_outside_evidence")
+    path = ROOT
+    for part in relative.parts:
+        path /= part
+        _reject_reparse(path)
+    if _sha256(path) != protocol_sha:
+        raise ValueError("protocol_sha256_mismatch")
+    pins = _tool_pins()
+    _validate_protocol(_read_json(path), pins)
+    if (ROOT / RESULT_REL).exists():
+        raise FileExistsError("exclusive_result_exists_no_retry")
+    if not MODULE_CACHE.is_dir():
+        raise FileNotFoundError("existing_module_cache_missing")
+    managed = ROOT / ".codex_tmp/managed-optimizer"
+    if not managed.is_dir() or any(managed.glob("job-*")):
+        raise RuntimeError("managed_job_residue_blocks_allocation")
+    if _resolved_head() != EXPECTED_HEAD:
+        raise ValueError("protected_head_mismatch")
+    return {"protocol": relative.as_posix(), "protocol_sha256": protocol_sha,
+            "tools_and_fixtures": pins, "native_closure": _native_snapshot(),
+            "runtime": _runtime_snapshot()}
+
+
+def _metric_summary(rows: list[dict[str, Any]]) -> dict[str, Any]:
+    result = {"unit": "one complete 4096-event stream plus final representative selection", "by_k": {}}
+    for size in collector.SIZES:
+        kernels = {}
+        for leaf in collector.LEAVES:
+            samples = [row for row in rows if row["name"] == f"{collector.BENCHMARK_ROOT}/{leaf}/K_{size}"]
+            metrics = {key: [row[key] for row in samples if row.get(key) is not None]
+                       for key in ("ns_per_op", "bytes_per_op", "allocs_per_op")}
+            medians = {}
+            for key, values in metrics.items():
+                try:
+                    medians[key] = statistics.median(values) if values else None
+                except OverflowError:
+                    medians[key] = None
+            kernels[leaf] = {"samples": metrics, "medians": medians}
+        ratios, regressions = {}, {}
+        for key in ("ns_per_op", "bytes_per_op", "allocs_per_op"):
+            old, new = (kernels[leaf]["medians"][key] for leaf in collector.LEAVES)
+            try:
+                ratio = new / old if new is not None and old not in (None, 0) else None
+                ratios[key] = ratio if ratio is None or math.isfinite(ratio) else None
+            except OverflowError:
+                ratios[key] = None
+            regressions[key] = new > old if new is not None and old is not None else None
+        result["by_k"][str(size)] = {"kernels": kernels, "single_over_legacy_median_ratios": ratios,
+                                     "regressions": regressions}
+    return result
+
+
+def _collect_log(path: Path) -> dict[str, Any]:
+    if not path.is_file():
+        return collector.collect_jsonl(b"")
+    with path.open("rb") as stream:
+        result = collector.collect_jsonl(stream.read(collector.MAX_JSONL_BYTES + 1))
+    result["jsonl_bytes"] = path.stat().st_size
+    result["jsonl_sha256"] = _sha256(path)
+    return result
+
+
+def _preservation(preflight: dict[str, Any], protocol_path: Path) -> dict[str, Any]:
+    current = {"tools_and_fixtures": _tool_pins(), "native_closure": _native_snapshot(),
+               "runtime": _runtime_snapshot()}
+    unchanged = all(current[key] == preflight[key] for key in current)
+    unchanged = unchanged and _sha256(protocol_path) == preflight["protocol_sha256"]
+    return {"unchanged": unchanged, **current}
+
+
+def main() -> int:
+    arguments = argparse.ArgumentParser()
+    arguments.add_argument("--protocol", type=Path, required=True)
+    arguments.add_argument("--protocol-sha256", required=True)
+    args = arguments.parse_args()
+    started = time.monotonic()
+    result_path = ROOT / RESULT_REL
+    receipt: dict[str, Any] = {
+        "schema_version": 1, "kind": "gtt.archive_representatives_validation_v1",
+        "lease_id": LEASE_ID, "protocol_sha256": args.protocol_sha256,
+        "status": "preflight_started", "managed_jobs": 0, "go_command_attempts": 0,
+        "engine_calls": 0, "captures": 0, "ordinary_calls": 0, "installs": 0, "retries": 0,
+        "started_utc": datetime.now(timezone.utc).isoformat(),
+    }
+    try:
+        preflight = _preflight(args.protocol, args.protocol_sha256)
+        args.protocol = ROOT / preflight["protocol"]
+        receipt.update({"preflight": preflight, "status": "reserved_before_allocation"})
+        _write(result_path, receipt, replace_existing=False)
+    except Exception as exc:
+        # Invalid release or drift allocates nothing; preserve an exclusive failure.
+        receipt.update({"status": "preflight_failed", "error_class": type(exc).__name__})
+        if not result_path.exists():
+            _write(result_path, receipt, replace_existing=False)
+        return 2
+    job = None
+    try:
+        with managed_scratch() as job:
+            receipt["managed_jobs"] = 1
+            stdout_path = job / "stdout.jsonl"
+            try:
+                env, environment = _environment(job)
+                receipt.update({"environment": environment, "command_argv": _command()})
+                if time.monotonic() - started > LIMITS["whole_wall_seconds"] - LIMITS["owned_command_wall_seconds"]:
+                    raise TimeoutError("insufficient_whole_wall_budget_before_go")
+                receipt.update({"status": "go_command_started", "go_command_attempts": 1})
+                _write(result_path, receipt, replace_existing=True)
+                outcome = _run_owned(_command(), command_kind="archive_representatives_go_test_benchmark",
+                                     env=env, log_path=stdout_path, stderr_path=job / "stderr.log",
+                                     timeout_seconds=LIMITS["owned_command_wall_seconds"])
+                receipt["command"] = outcome
+                receipt["collector"] = _collect_log(stdout_path)
+                accepted = collector.invocation_is_valid(
+                    receipt["collector"], returncode=outcome.get("returncode"),
+                    timed_out=outcome.get("timed_out"), launcher_error=outcome.get("error_class"))
+                receipt["process_gate"] = {"accepted": accepted, "returncode": outcome.get("returncode"),
+                                            "timed_out": outcome.get("timed_out"), "launcher_error": outcome.get("error_class")}
+                receipt["status"] = "pass_scoped_validation" if accepted else "failed_unverified"
+                receipt["post_run_checks"] = _preservation(preflight, args.protocol)
+                if not receipt["post_run_checks"]["unchanged"]:
+                    receipt["status"] = "failed_unverified"
+            except Exception as exc:
+                receipt.update({"status": "failed_unverified", "execution_error_class": type(exc).__name__})
+            finally:
+                # Export partial counts/rows even if launching or preservation fails.
+                if "collector" not in receipt:
+                    receipt["collector"] = _collect_log(stdout_path)
+                receipt["benchmark_summary"] = _metric_summary(receipt["collector"]["benchmark_rows"])
+                receipt["pre_cleanup"] = {"exported_before_cleanup": True}
+                try:
+                    receipt["pre_cleanup"]["job_bytes_before_removal"] = _tree_bytes(job)
+                except Exception as exc:
+                    receipt["pre_cleanup"]["measurement_error_class"] = type(exc).__name__
+                    receipt["status"] = "failed_unverified"
+                _write(result_path, receipt, replace_existing=True)
+    except Exception as exc:
+        receipt.update({"status": "failed_unverified", "cleanup_or_export_error_class": type(exc).__name__})
+    receipt["cleanup"] = {"confirmed": job is not None and not job.exists(),
+                          "remaining_managed_jobs": len(list((ROOT / ".codex_tmp/managed-optimizer").glob("job-*")))}
+    receipt["cleanup"]["removed_bytes"] = (
+        receipt.get("pre_cleanup", {}).get("job_bytes_before_removal") if receipt["cleanup"]["confirmed"] else None)
+    if not receipt["cleanup"]["confirmed"] or receipt["cleanup"]["remaining_managed_jobs"]:
+        receipt["status"] = "failed_unverified"
+    try:
+        receipt["post_cleanup_checks"] = _preservation(preflight, args.protocol)
+        if not receipt["post_cleanup_checks"]["unchanged"]:
+            receipt["status"] = "failed_unverified"
+    except Exception as exc:
+        receipt.update({"status": "failed_unverified", "post_cleanup_error_class": type(exc).__name__})
+    receipt["whole_wall_seconds"] = round(time.monotonic() - started, 3)
+    receipt["within_whole_wall_budget"] = receipt["whole_wall_seconds"] <= LIMITS["whole_wall_seconds"]
+    if not receipt["within_whole_wall_budget"]:
+        receipt["status"] = "failed_unverified"
+    receipt["finished_utc"] = datetime.now(timezone.utc).isoformat()
+    _write(result_path, receipt, replace_existing=True)
+    print("ARCHIVE_GATE " + receipt["status"], flush=True)
+    return 0 if receipt["status"] == "pass_scoped_validation" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
