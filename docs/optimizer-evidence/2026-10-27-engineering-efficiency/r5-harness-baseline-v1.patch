@@ -0,0 +1,44 @@
+"""Private whole-Chasca target snapshot; read-only Go metadata, no simulation."""
+from __future__ import annotations
+
+import json
+import subprocess
+
+TARGET_KEYS=('CGO_ENABLED','GOOS','GOARCH','GOAMD64','GOEXPERIMENT')
+
+
+def inspect_target(go,env,cwd):
+    command=[str(go),'env','-json',*TARGET_KEYS,'GOVERSION']
+    result=subprocess.run(command,env=env,cwd=cwd,capture_output=True,text=True,check=True,timeout=30)
+    if len(result.stdout.encode())>16<<10:raise ValueError('Go target metadata exceeded')
+    resolved=json.loads(result.stdout)
+    validate_target(resolved)
+    return {'resolved':resolved,'command':command,'build_flags':env.get('GOFLAGS','')}
+
+
+def validate_target(resolved):
+    if set(resolved)!={*TARGET_KEYS,'GOVERSION'} or any(type(v)!=str for v in resolved.values()) or resolved['CGO_ENABLED'] not in ('0','1'):
+        raise ValueError('complete resolved Go target snapshot required')
+    if resolved['GOOS']!='windows' or resolved['GOARCH']!='amd64' or resolved['GOAMD64'] not in ('v1','v2','v3','v4') or not resolved['GOVERSION'].startswith('go1.'):
+        raise ValueError('target outside existing native profile support')
+
+
+def pin_target(env,snapshot):
+    validate_target(snapshot['resolved'])
+    if env.get('GOFLAGS','')!=snapshot['build_flags']:raise ValueError('assembled build flags differ from target inspection')
+    return {**env,**{key:snapshot['resolved'][key] for key in TARGET_KEYS}}
+
+
+def inspect_binary(go,binary,env,cwd):
+    result=subprocess.run([str(go),'version','-m','-json',str(binary)],env=env,cwd=cwd,capture_output=True,text=True,check=True,timeout=30)
+    if len(result.stdout.encode())>32<<10:raise ValueError('Go binary metadata exceeded')
+    return json.loads(result.stdout)
+
+
+def assert_binary_target(snapshot,info):
+    validate_target(snapshot['resolved'])
+    settings={row['Key']:row['Value'] for row in info['Settings']}
+    if info['GoVersion']!=snapshot['resolved']['GOVERSION'] or any(settings.get(key,'')!=snapshot['resolved'][key] for key in TARGET_KEYS):
+        raise ValueError('actual binary does not match resolved target snapshot')
+    if settings.get('-tags',''):raise ValueError('whole Chasca snapshot has no custom build tags')
+    return {'GoVersion':info['GoVersion'],**{key:settings.get(key,'') for key in TARGET_KEYS}}
