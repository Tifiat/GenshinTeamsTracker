+"""Guarded, explicit mechanic engine/consumer/cache uptake and rollback.
+
+Importing this module has no runtime side effects. Call ``apply_pair`` only
+after independent acceptance, with the isolated ``mechanic_candidate_store``
+outputs. The retained rollback directory is deliberately never deleted here.
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+from typing import Callable
+import uuid
+import zipfile
+
+from run_workspace.gcsim import engine_store, runtime_bundle_sync as sync, tree_identity
+from run_workspace.gcsim.optimizer_engine_context import load_active_gcsim_optimizer_engine_context
+from tools.experiments.gcsim.parametric_effects.install_neutral import relocate_overlay
+from tools.experiments.gcsim.mvp_polish import retire_native_performance_rollback as retirement
+from tools.experiments.gcsim.mvp_polish import tighnari_saved_gate as gate
+from tools.experiments.gcsim.search_hypotheses import promotion_gate
+
+
+OLD_ENGINE_ID = "gcsim-v2.45.0-unified-health-20261023"
+OLD_ROLLBACK_ID = "gcsim-v2.45.0-flat-initializer-v6-remaining-v2"
+OLD_ENGINE_SHA256 = "3913a8773c696e0c4728cf51b6531bf0ab8c49e23b891dacaede2b20a168d306"
+OLD_CONSUMER_SHA256 = "77b2a653a2e54a993d9f99045b3131da25b9062cf69dd21c08bd2025a76443fd"
+NEW_ENGINE_ID = "gcsim-v2.45.0-mechanic-compiler-20261025"
+NEW_ENGINE_SHA256 = "f1e076b7fa9d292d0bab83aed9d3db0ec917437b288dcc6798cd69f4718f9b93"
+NEW_CONSUMER_SHA256 = "415d995c20897d13faf70217fedd37831528e6570b249b472d154b36a61f069d"
+BUNDLE_ARCHIVE_SHA256 = "43c1a5b636839ae599a47162f72cfe78f0a1b9e582d331a3468ef2d30c649901"
+EVIDENCE_RELATIVE = Path("docs/optimizer-evidence/2026-10-25-mechanic-compiler")
+ROLLBACK_NAME = "runtime-rollback"
+_CACHE_NAME = re.compile(r"[0-9a-f]{64}\.(?:gttast|gttir)\Z")
+
+
+def _consumer(root: Path) -> Path:
+    return root / "native/gcsim_optimizer/gtt-optimizer.exe"
+
+
+def _bundle(root: Path) -> Path:
+    return root / "native/gcsim_optimizer/set-rule-cache"
+
+
+def _store(root: Path) -> engine_store.GcsimEngineStore:
+    return engine_store.GcsimEngineStore(root / "data/gcsim/engines")
+
+
+def _rollback_path(root: Path, rollback_dir: Path) -> Path:
+    expected = root / EVIDENCE_RELATIVE / ROLLBACK_NAME
+    if rollback_dir.resolve() != expected.resolve() or not expected.parent.is_dir():
+        raise ValueError("mechanic_uptake_rollback_path_invalid")
+    sync._plain_ancestors(expected.parent)
+    return expected
+
+
+def _write_once(path: Path, data: bytes) -> None:
+    with path.open("xb") as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def _file_map(path: Path) -> dict:
+    return gate.file_map(path)
+
+
+def _protected_unchanged(before: dict, now: dict, root: Path, allowed: bool) -> None:
+    consumer = _consumer(root)
+    pointer = _store(root).active_state_path
+    bundle = _bundle(root)
+
+    def exempt(raw: str) -> bool:
+        if not allowed:
+            return False
+        path = Path(raw)
+        if not path.is_absolute():
+            path = root / path
+        path = path.resolve()
+        return path in {consumer, pointer} or bundle == path or bundle in path.parents
+
+    if {key: value for key, value in before.items() if not exempt(key)} != {
+        key: value for key, value in now.items() if not exempt(key)
+    }:
+        raise ValueError("mechanic_uptake_protected_drift")
+
+
+def _bundle_archive_map(root: Path) -> dict:
+    archive = root / EVIDENCE_RELATIVE / "stage22-final-v1-bundled-cache.zip"
+    if sync._digest(archive) != BUNDLE_ARCHIVE_SHA256:
+        raise ValueError("mechanic_uptake_bundle_archive_changed")
+    result = {}
+    with zipfile.ZipFile(archive) as zipped:
+        for info in zipped.infolist():
+            if (info.is_dir() or not _CACHE_NAME.fullmatch(info.filename)
+                    or info.filename in result or info.file_size > 16 * 1024 * 1024):
+                raise ValueError("mechanic_uptake_bundle_archive_entry_invalid")
+            body = zipped.read(info)
+            result[info.filename] = {"bytes": len(body), "sha256": hashlib.sha256(body).hexdigest()}
+    if len(result) != 267:
+        raise ValueError("mechanic_uptake_bundle_archive_count_changed")
+    return result
+
+
+def _original_overlay_root(candidate_engine: Path) -> Path:
+    overlay = json.loads((candidate_engine / "build/gtt-source-overlay.json").read_bytes())
+    rows = overlay.get("Replace")
+    if not isinstance(rows, dict) or not rows:
+        raise ValueError("mechanic_uptake_overlay_invalid")
+    paths = []
+    for before, after in rows.items():
+        if not isinstance(before, str) or not isinstance(after, str):
+            raise ValueError("mechanic_uptake_overlay_invalid")
+        paths.extend((Path(before).resolve(), Path(after).resolve()))
+    old_root = Path(os.path.commonpath(paths))
+    if old_root == Path(old_root.anchor) or len(old_root.parts) < 4:
+        raise ValueError("mechanic_uptake_overlay_root_too_broad")
+    for path in paths:
+        relative = path.relative_to(old_root)
+        installed_equivalent = candidate_engine / relative
+        installed_equivalent.resolve(strict=True).relative_to(candidate_engine)
+        if not installed_equivalent.is_file():
+            raise ValueError("mechanic_uptake_overlay_target_missing")
+    return old_root
+
+
+def _prepare_candidate(candidate_engine: Path) -> tuple[object, dict]:
+    """Reseal only the isolated candidate's generated overlay after relocation."""
+    original, _ = sync._verified_engine(candidate_engine, engine_id=NEW_ENGINE_ID,
+                                         expected_artifact_sha=NEW_ENGINE_SHA256)
+    before = _file_map(candidate_engine)
+    old_root = _original_overlay_root(candidate_engine)
+    if old_root != candidate_engine:
+        relocate_overlay(candidate_engine, old_root)
+        resealed = replace(original, engine_tree_hash=tree_identity.directory_sha256(
+            candidate_engine, excluded_relative_paths=("gtt_engine_manifest.json",)))
+        engine_store._write_manifest(candidate_engine / "gtt_engine_manifest.json", resealed)
+    manifest, _ = sync._verified_engine(candidate_engine, engine_id=NEW_ENGINE_ID,
+                                         expected_artifact_sha=NEW_ENGINE_SHA256)
+    after = _file_map(candidate_engine)
+    changed = {name for name in before if before[name] != after.get(name)}
+    if set(before) != set(after) or changed - {"build/gtt-source-overlay.json", "gtt_engine_manifest.json"}:
+        raise ValueError("mechanic_uptake_candidate_source_changed")
+    return manifest, after
+
+
+def _sibling(parent: Path, kind: str) -> Path:
+    return parent / f".mechanic-uptake-{kind}-{uuid.uuid4().hex}"
+
+
+def _copy_bundle(source: Path, sibling: Path, expected: dict) -> None:
+    sync._plain_tree(source)
+    if sibling.exists():
+        raise ValueError("mechanic_uptake_bundle_stage_occupied")
+    shutil.copytree(source, sibling)
+    if _file_map(sibling) != expected:
+        raise ValueError("mechanic_uptake_bundle_copy_changed")
+
+
+def _remove_cache_sibling(path: Path, parent: Path, expected: dict) -> None:
+    """Validate the exact resolved temporary directory before recursive removal."""
+    parent = parent.resolve(strict=True)
+    sync._plain_tree(path)
+    resolved = path.resolve(strict=True)
+    resolved.relative_to(parent)
+    if (resolved.parent != parent or not resolved.name.startswith(".mechanic-uptake-")
+            or _file_map(resolved) != expected):
+        raise ValueError("mechanic_uptake_cleanup_scope_changed")
+    shutil.rmtree(resolved)
+
+
+def _swap_bundle(destination: Path, incoming: Path, outgoing: Path,
+                 expected_old: dict, expected_new: dict) -> None:
+    if outgoing.exists() or _file_map(destination) != expected_old or _file_map(incoming) != expected_new:
+        raise ValueError("mechanic_uptake_bundle_swap_precondition_changed")
+    os.replace(destination, outgoing)
+    try:
+        os.replace(incoming, destination)
+    except BaseException:
+        os.replace(outgoing, destination)
+        raise
+    if _file_map(destination) != expected_new or _file_map(outgoing) != expected_old:
+        raise RuntimeError("mechanic_uptake_bundle_swap_incomplete")
+
+
+def _restore_bundle(destination: Path, old_sibling: Path, new_map: dict, old_map: dict) -> None:
+    if not old_sibling.exists():
+        if _file_map(destination) != old_map:
+            raise RuntimeError("mechanic_uptake_old_bundle_missing")
+        return
+    new_sibling = _sibling(destination.parent, "failed-new-cache")
+    _swap_bundle(destination, old_sibling, new_sibling, new_map, old_map)
+    if _file_map(new_sibling) != new_map:
+        raise RuntimeError("mechanic_uptake_failed_new_bundle_changed")
+    _remove_cache_sibling(new_sibling, destination.parent, new_map)
+
+
+def apply_pair(*, root: Path, job: Path, candidate_engine: Path, candidate_consumer: Path,
+               candidate_bundle: Path, rollback_dir: Path, protected_before: dict,
+               protected_now: Callable[[], dict], save: Callable[[dict], None]) -> dict:
+    """Install the already accepted isolated trio; rollback on every failed step."""
+    root, job = root.resolve(strict=True), job.resolve(strict=True)
+    job.relative_to(root)
+    candidate_engine = candidate_engine.resolve(strict=True)
+    candidate_consumer = candidate_consumer.resolve(strict=True)
+    candidate_bundle = candidate_bundle.resolve(strict=True)
+    for path in (candidate_engine, candidate_consumer, candidate_bundle):
+        path.relative_to(job)
+    rollback_dir = _rollback_path(root, rollback_dir)
+    if rollback_dir.exists() or retirement._default_process_probe(root):
+        raise ValueError("mechanic_uptake_busy_or_rollback_occupied")
+    store, consumer, bundle = _store(root), _consumer(root), _bundle(root)
+    old_pointer = store.active_state_path.read_bytes()
+    if (json.loads(old_pointer) != {
+        "schema_version": engine_store.GCSIM_ENGINE_STATE_SCHEMA_VERSION,
+        "active_engine_id": OLD_ENGINE_ID, "rollback_engine_id": OLD_ROLLBACK_ID,
+    } or sync._digest(consumer) != OLD_CONSUMER_SHA256):
+        raise ValueError("mechanic_uptake_old_runtime_changed")
+    old_manifest, _ = sync._verified_engine(store.engines_dir / OLD_ENGINE_ID,
+                                             engine_id=OLD_ENGINE_ID,
+                                             expected_artifact_sha=OLD_ENGINE_SHA256)
+    if any((directory / NEW_ENGINE_ID).exists() for directory in
+           (store.engines_dir, store.staging_dir, store.failed_dir)):
+        raise ValueError("mechanic_uptake_engine_id_occupied")
+    if sync._digest(candidate_consumer) != NEW_CONSUMER_SHA256:
+        raise ValueError("mechanic_uptake_consumer_candidate_changed")
+    expected_bundle = _bundle_archive_map(root)
+    if _file_map(candidate_bundle) != expected_bundle:
+        raise ValueError("mechanic_uptake_bundle_candidate_changed")
+    manifest, candidate_map = _prepare_candidate(candidate_engine)
+    before_store, before_bundle = _file_map(store.root_dir), _file_map(bundle)
+    _protected_unchanged(protected_before, protected_now(), root, False)
+
+    rollback_dir.mkdir(mode=0o700)
+    old_consumer = rollback_dir / "previous-gtt-optimizer.exe"
+    shutil.copy2(consumer, old_consumer)
+    if sync._digest(old_consumer) != OLD_CONSUMER_SHA256:
+        raise ValueError("mechanic_uptake_old_consumer_snapshot_changed")
+    _write_once(rollback_dir / "active-engine-before.json", old_pointer)
+    old_bundle_snapshot = rollback_dir / "previous-set-rule-cache"
+    _copy_bundle(bundle, old_bundle_snapshot, before_bundle)
+    binding = {
+        "schema": "mechanic_runtime_rollback_v1", "owner": "mechanic-compiler-20261025",
+        "old_engine_id": OLD_ENGINE_ID, "old_rollback_engine_id": OLD_ROLLBACK_ID,
+        "old_engine_artifact_sha256": OLD_ENGINE_SHA256,
+        "old_engine_manifest_sha256": sync._digest(store.engines_dir / OLD_ENGINE_ID / "gtt_engine_manifest.json"),
+        "old_engine_tree_sha256": old_manifest.engine_tree_hash,
+        "old_store_map_sha256": gate.digest(before_store),
+        "old_bundle_map_sha256": gate.digest(before_bundle),
+        "old_pointer_sha256": sync._digest(rollback_dir / "active-engine-before.json"),
+        "old_consumer_sha256": OLD_CONSUMER_SHA256,
+        "new_engine_id": NEW_ENGINE_ID, "new_engine_artifact_sha256": NEW_ENGINE_SHA256,
+        "new_consumer_sha256": NEW_CONSUMER_SHA256,
+        "new_bundle_map_sha256": gate.digest(expected_bundle),
+        "review_after_utc": (datetime.now(timezone.utc) + timedelta(days=7)).isoformat(),
+        "expiry_action": "report_only_no_automatic_deletion",
+    }
+    _write_once(rollback_dir / "rollback-binding.json",
+                json.dumps(binding, sort_keys=True, separators=(",", ":")).encode())
+    saved = {"status": "before_write", "rollback": binding}
+    save(saved)
+
+    installed = None
+    stage_bundle = _sibling(bundle.parent, "stage-cache")
+    old_sibling = _sibling(bundle.parent, "old-cache")
+    with retirement._project_mutation_locks(root):
+        if (retirement._default_process_probe(root)
+                or store.active_state_path.read_bytes() != old_pointer
+                or sync._digest(consumer) != OLD_CONSUMER_SHA256
+                or _file_map(store.root_dir) != before_store
+                or _file_map(bundle) != before_bundle
+                or _file_map(candidate_engine) != candidate_map
+                or _file_map(candidate_bundle) != expected_bundle):
+            raise ValueError("mechanic_uptake_locked_runtime_changed")
+        _protected_unchanged(protected_before, protected_now(), root, False)
+        try:
+            installed = sync._install_engine(store, candidate_engine, manifest)
+            relocate_overlay(installed, candidate_engine)
+            installed_manifest = replace(manifest, engine_tree_hash=tree_identity.directory_sha256(
+                installed, excluded_relative_paths=("gtt_engine_manifest.json",)))
+            engine_store._write_manifest(installed / "gtt_engine_manifest.json", installed_manifest)
+            sync._verified_engine(installed, engine_id=NEW_ENGINE_ID,
+                                  expected_artifact_sha=NEW_ENGINE_SHA256)
+            installed_map = _file_map(installed)
+            if (set(installed_map) != set(candidate_map)
+                    or {key for key in installed_map if installed_map[key] != candidate_map[key]}
+                    - {"build/gtt-source-overlay.json", "gtt_engine_manifest.json"}):
+                raise ValueError("mechanic_uptake_installed_source_changed")
+            _copy_bundle(candidate_bundle, stage_bundle, expected_bundle)
+            _swap_bundle(bundle, stage_bundle, old_sibling, before_bundle, expected_bundle)
+            moved_original = rollback_dir / "moved-original-cache"
+            if moved_original.exists():
+                raise ValueError("mechanic_uptake_original_cache_slot_occupied")
+            os.replace(old_sibling, moved_original)
+            saved["status"] = "engine_and_bundle_staged"
+            save(saved)
+
+            def verify_after() -> None:
+                store.activate_engine(NEW_ENGINE_ID)
+                current = load_active_gcsim_optimizer_engine_context(
+                    store_dir=store.root_dir, require_resealed=True)
+                if (current.engine_id != NEW_ENGINE_ID
+                        or current.artifact_sha256 != NEW_ENGINE_SHA256
+                        or sync._digest(consumer) != NEW_CONSUMER_SHA256
+                        or _file_map(bundle) != expected_bundle):
+                    raise ValueError("mechanic_uptake_installed_readback_failed")
+                existing = _file_map(store.root_dir)
+                prefix = "engines/" + NEW_ENGINE_ID + "/"
+                unchanged = {key: value for key, value in existing.items()
+                             if key != store.active_state_path.name and not key.startswith(prefix)}
+                previous = {key: value for key, value in before_store.items()
+                            if key != store.active_state_path.name}
+                if unchanged != previous:
+                    raise ValueError("mechanic_uptake_old_engine_store_changed")
+                _protected_unchanged(protected_before, protected_now(), root, True)
+
+            promotion_gate.install_candidate(candidate_consumer, consumer, job,
+                                             old_sha=OLD_CONSUMER_SHA256,
+                                             candidate_sha=NEW_CONSUMER_SHA256,
+                                             verify_after=verify_after)
+            if _file_map(moved_original) != before_bundle:
+                raise RuntimeError("mechanic_uptake_old_cache_retention_changed")
+            _write_once(rollback_dir / "active-engine-after.json",
+                        store.active_state_path.read_bytes())
+            saved.update(status="installed_and_verified", installed_engine_path=str(installed),
+                         pointer_after_sha256=sync._digest(store.active_state_path),
+                         bundle_files=len(expected_bundle))
+            save(saved)
+        except BaseException:
+            if sync._digest(consumer) == NEW_CONSUMER_SHA256:
+                staged = sync._stage_copy(old_consumer, consumer.parent, suffix=".exe")
+                os.replace(staged, consumer)
+            if store.active_state_path.read_bytes() != old_pointer:
+                staged = sync._stage_copy(rollback_dir / "active-engine-before.json",
+                                          store.root_dir, suffix=".json")
+                os.replace(staged, store.active_state_path)
+            if _file_map(bundle) == expected_bundle and not old_sibling.exists():
+                _copy_bundle(old_bundle_snapshot, old_sibling, before_bundle)
+            if old_sibling.exists():
+                _restore_bundle(bundle, old_sibling, expected_bundle, before_bundle)
+            if (sync._digest(consumer) != OLD_CONSUMER_SHA256
+                    or store.active_state_path.read_bytes() != old_pointer
+                    or _file_map(bundle) != before_bundle):
+                raise RuntimeError("mechanic_uptake_apply_rollback_incomplete")
+            saved.update(status="rolled_back_after_failed_apply",
+                         inactive_new_engine_retained=str(installed) if installed else None)
+            save(saved)
+            raise
+        finally:
+            if stage_bundle.exists():
+                if _file_map(stage_bundle) == expected_bundle:
+                    _remove_cache_sibling(stage_bundle, bundle.parent, expected_bundle)
+    return saved
+
+
+def rollback_pair(*, root: Path, rollback_dir: Path, protected_before: dict,
+                  protected_now: Callable[[], dict], save: Callable[[dict], None]) -> dict:
+    """Restore exact pre-uptake binary, pointer and bundle after acceptance fails."""
+    root = root.resolve(strict=True)
+    rollback_dir = _rollback_path(root, rollback_dir)
+    if not rollback_dir.is_dir():
+        raise ValueError("mechanic_uptake_rollback_missing")
+    store, consumer, bundle = _store(root), _consumer(root), _bundle(root)
+    binding = json.loads((rollback_dir / "rollback-binding.json").read_bytes())
+    old_consumer = rollback_dir / "previous-gtt-optimizer.exe"
+    old_pointer_path = rollback_dir / "active-engine-before.json"
+    old_pointer = old_pointer_path.read_bytes()
+    old_bundle = rollback_dir / "previous-set-rule-cache"
+    old_bundle_map = _file_map(old_bundle)
+    expected_bundle = _bundle_archive_map(root)
+    if (binding.get("schema") != "mechanic_runtime_rollback_v1"
+            or binding.get("owner") != "mechanic-compiler-20261025"
+            or binding.get("old_engine_id") != OLD_ENGINE_ID
+            or binding.get("old_rollback_engine_id") != OLD_ROLLBACK_ID
+            or binding.get("old_engine_artifact_sha256") != OLD_ENGINE_SHA256
+            or binding.get("old_consumer_sha256") != OLD_CONSUMER_SHA256
+            or binding.get("new_engine_id") != NEW_ENGINE_ID
+            or binding.get("new_engine_artifact_sha256") != NEW_ENGINE_SHA256
+            or binding.get("new_consumer_sha256") != NEW_CONSUMER_SHA256
+            or binding.get("old_pointer_sha256") != sync._digest(old_pointer_path)
+            or binding.get("old_bundle_map_sha256") != gate.digest(old_bundle_map)
+            or binding.get("new_bundle_map_sha256") != gate.digest(expected_bundle)
+            or json.loads(old_pointer) != {
+                "schema_version": engine_store.GCSIM_ENGINE_STATE_SCHEMA_VERSION,
+                "active_engine_id": OLD_ENGINE_ID, "rollback_engine_id": OLD_ROLLBACK_ID,
+            }):
+        raise ValueError("mechanic_uptake_rollback_binding_changed")
+    current_pointer = store.active_state_path.read_bytes()
+    after_pointer = rollback_dir / "active-engine-after.json"
+    if (json.loads(current_pointer).get("active_engine_id") != NEW_ENGINE_ID
+            or json.loads(current_pointer).get("rollback_engine_id") != OLD_ENGINE_ID
+            or not after_pointer.is_file() or current_pointer != after_pointer.read_bytes()
+            or sync._digest(old_consumer) != OLD_CONSUMER_SHA256
+            or sync._digest(consumer) != NEW_CONSUMER_SHA256
+            or _file_map(bundle) != expected_bundle
+            or retirement._default_process_probe(root)):
+        raise ValueError("mechanic_uptake_rollback_precondition_changed")
+    before_store = _file_map(store.root_dir)
+    prefix = "engines/" + NEW_ENGINE_ID + "/"
+    restored_map = {key: value for key, value in before_store.items() if not key.startswith(prefix)}
+    restored_map[store.active_state_path.name] = {
+        "bytes": len(old_pointer), "sha256": sync._digest(old_pointer_path),
+    }
+    if (gate.digest(restored_map) != binding.get("old_store_map_sha256")
+            or sync._digest(store.engines_dir / OLD_ENGINE_ID / "gtt_engine_manifest.json")
+            != binding.get("old_engine_manifest_sha256")):
+        raise ValueError("mechanic_uptake_old_store_changed")
+    sync._verified_engine(store.engines_dir / OLD_ENGINE_ID, engine_id=OLD_ENGINE_ID,
+                          expected_artifact_sha=OLD_ENGINE_SHA256)
+    _protected_unchanged(protected_before, protected_now(), root, True)
+    with retirement._project_mutation_locks(root):
+        if (retirement._default_process_probe(root)
+                or store.active_state_path.read_bytes() != current_pointer
+                or sync._digest(consumer) != NEW_CONSUMER_SHA256
+                or _file_map(store.root_dir) != before_store
+                or _file_map(bundle) != expected_bundle):
+            raise ValueError("mechanic_uptake_locked_rollback_drift")
+        staged_bundle = _sibling(bundle.parent, "restore-cache")
+        displaced_bundle = _sibling(bundle.parent, "new-cache")
+        staged_consumer = sync._stage_copy(old_consumer, consumer.parent, suffix=".exe")
+        staged_pointer = sync._stage_copy(old_pointer_path, store.root_dir, suffix=".json")
+        recovery_consumer = sync._stage_copy(consumer, consumer.parent, suffix=".exe")
+        recovery_pointer = sync._stage_copy(store.active_state_path, store.root_dir, suffix=".json")
+        _copy_bundle(old_bundle, staged_bundle, old_bundle_map)
+        try:
+            _swap_bundle(bundle, staged_bundle, displaced_bundle, expected_bundle, old_bundle_map)
+            os.replace(staged_consumer, consumer)
+            os.replace(staged_pointer, store.active_state_path)
+            if (sync._digest(consumer) != OLD_CONSUMER_SHA256
+                    or store.active_state_path.read_bytes() != old_pointer
+                    or _file_map(bundle) != old_bundle_map
+                    or gate.digest({key: value for key, value in _file_map(store.root_dir).items()
+                                    if not key.startswith(prefix)}) != binding["old_store_map_sha256"]):
+                raise RuntimeError("mechanic_uptake_postapply_rollback_incomplete")
+            _protected_unchanged(protected_before, protected_now(), root, False)
+        except BaseException:
+            if sync._digest(consumer) == OLD_CONSUMER_SHA256:
+                if sync._digest(recovery_consumer) != NEW_CONSUMER_SHA256:
+                    raise RuntimeError("mechanic_uptake_recovery_consumer_changed")
+                os.replace(recovery_consumer, consumer)
+            if store.active_state_path.read_bytes() != current_pointer:
+                if sync._digest(recovery_pointer) != hashlib.sha256(current_pointer).hexdigest():
+                    raise RuntimeError("mechanic_uptake_recovery_pointer_changed")
+                os.replace(recovery_pointer, store.active_state_path)
+            if displaced_bundle.exists():
+                _restore_bundle(bundle, displaced_bundle, old_bundle_map, expected_bundle)
+            raise
+        finally:
+            staged_consumer.unlink(missing_ok=True)
+            staged_pointer.unlink(missing_ok=True)
+            recovery_consumer.unlink(missing_ok=True)
+            recovery_pointer.unlink(missing_ok=True)
+            if staged_bundle.exists() and _file_map(staged_bundle) == old_bundle_map:
+                _remove_cache_sibling(staged_bundle, bundle.parent, old_bundle_map)
+        if _file_map(displaced_bundle) != expected_bundle:
+            raise RuntimeError("mechanic_uptake_displaced_bundle_changed")
+        _remove_cache_sibling(displaced_bundle, bundle.parent, expected_bundle)
+    receipt = {"status": "postapply_rollback_complete", "consumer_exact": True,
+               "pointer_exact": True, "bundle_exact": True,
+               "new_engine_retained_inactive": str(store.engines_dir / NEW_ENGINE_ID)}
+    save(receipt)
+    return receipt
