+++ b/tools/experiments/gcsim/mvp_polish/tighnari_profile_samples_v2.py
@@ -0,0 +1,218 @@
+"""Bounded, dependency-free pprof attribution; exports no paths or addresses.
+
+Schema follows the installed Go pprof encoder and runtime/pprof/protomem.go.
+Go heap values are already sample-rate-scaled. Never scale them a second time.
+"""
+from collections import defaultdict
+import hashlib
+import zlib
+from tools.experiments.gcsim.mvp_polish.refine_profile_output import _fields, _singular, _repeated, _symbol
+
+MAX_RAW = 2 << 20
+MAX_EXPANDED = 16 << 20
+MAX_RECORDS = 20000
+MAX_FRAMES = 300000
+MAX_EXPORT = 4 << 20
+PRODUCTION = "genshinteamstracker/native/gcsim_optimizer/internal/"
+CPU_TYPES = [("samples", "count"), ("cpu", "nanoseconds")]
+ALLOC_TYPES = [("alloc_objects", "count"), ("alloc_space", "bytes"),
+               ("inuse_objects", "count"), ("inuse_space", "bytes")]
+
+
+class Budget:
+    def __init__(self):
+        self.fields = self.values = 0
+    def field(self):
+        self.fields += 1
+        if self.fields > 300000:
+            raise ValueError("profile_field_limit")
+    def value(self):
+        self.values += 1
+        if self.values > 600000:
+            raise ValueError("profile_value_limit")
+
+
+def need(condition, code):
+    if not condition:
+        raise ValueError(code)
+
+
+def safe_symbol(name):
+    try:
+        return _symbol(name)
+    except ValueError:
+        return "redacted_symbol_" + hashlib.sha256(name.encode("utf-8")).hexdigest()[:20]
+
+
+def decode_profile(raw, kind):
+    need(type(raw) is bytes and 0 < len(raw) <= MAX_RAW and kind in {"cpu", "allocs"}, "profile_input_limit")
+    inflater = zlib.decompressobj(16 + zlib.MAX_WBITS)
+    data = inflater.decompress(raw, MAX_EXPANDED + 1)
+    need(len(data) <= MAX_EXPANDED and inflater.eof and not inflater.unused_data
+         and not inflater.unconsumed_tail, "profile_gzip_invalid")
+    budget = Budget()
+    strings, types, samples, functions, locations, mappings = [], [], [], {}, {}, {}
+    scalars, period_type = {}, None
+    def unique(table, ident, value):
+        need(type(ident) is int and 0 < ident < 2**63 and ident not in table
+             and len(table) < MAX_RECORDS, "profile_record_identity")
+        table[ident] = value
+    for field, wire, value in _fields(memoryview(data), budget):
+        if field in (1, 2, 3, 4, 5, 6, 11):
+            need(wire == 2, "profile_message_wire")
+        if field in (1, 11):
+            pair = _singular(value, {1, 2}, budget)
+            pair = (pair.get(1, 0), pair.get(2, 0))
+            if field == 1:
+                need(len(types) < 4, "profile_type_limit")
+                types.append(pair)
+            else:
+                need(period_type is None, "duplicate_period_type")
+                period_type = pair
+        elif field == 2:
+            need(len(samples) < MAX_RECORDS, "profile_sample_limit")
+            stack, values = [], []
+            for child, child_wire, child_value in _fields(value, budget):
+                if child in (1, 2):
+                    target = stack if child == 1 else values
+                    target.extend(_repeated(child_wire, child_value, budget))
+                    need(len(stack) <= 256 and len(values) <= 4, "profile_sample_shape")
+                elif child == 3:
+                    need(child_wire == 2, "profile_label_wire")
+                    _singular(child_value, {1, 2, 3, 4}, budget)  # Labels are not exported.
+            need(stack and values and all(0 <= n < 2**63 for n in values), "profile_negative_raw_sample")
+            samples.append((stack, values))
+        elif field == 3:
+            row = _singular(value, set(range(1, 11)), budget)
+            unique(mappings, row.get(1), True)  # Addresses/files/build IDs intentionally discarded.
+        elif field == 4:
+            row, lines = {}, []
+            for child, child_wire, child_value in _fields(value, budget):
+                if child in (1, 2, 3, 5):
+                    need(child_wire == 0 and child not in row, "profile_location_wire")
+                    row[child] = child_value
+                elif child == 4:
+                    need(child_wire == 2 and len(lines) < 256, "profile_inline_limit")
+                    line = _singular(child_value, {1, 2, 3}, budget)
+                    need(0 <= line.get(2, 0) < 2**31, "profile_line_limit")
+                    lines.append((line.get(1), line.get(2, 0)))
+            unique(locations, row.get(1), (row.get(2, 0), lines))
+        elif field == 5:
+            row = _singular(value, {1, 2, 3, 4, 5}, budget)
+            unique(functions, row.get(1), row.get(2, 0))
+        elif field == 6:
+            need(len(strings) < 60000 and len(value) <= 16384, "profile_string_limit")
+            strings.append(bytes(value).decode("utf-8"))
+        elif field in (9, 10, 12):
+            need(wire == 0 and field not in scalars and value < 2**63, "profile_scalar")
+            scalars[field] = value
+    need(strings and strings[0] == "", "profile_empty_string")
+    def string(index):
+        need(type(index) is int and 0 <= index < len(strings), "profile_string_reference")
+        return strings[index]
+    resolved = [(string(t), string(u)) for t, u in types]
+    need(resolved == (CPU_TYPES if kind == "cpu" else ALLOC_TYPES), "profile_sample_types")
+    need(period_type is not None, "profile_missing_period_type")
+    period_resolved = (string(period_type[0]), string(period_type[1]))
+    period = scalars.get(12, 0)
+    need((kind == "cpu" and period_resolved == ("cpu", "nanoseconds") and 0 < period <= 1000000000)
+         or (kind == "allocs" and period_resolved == ("space", "bytes") and period == 65536), "profile_period")
+    names = {ident: safe_symbol(string(index)) for ident, index in functions.items()}
+    frame_ids, frames, stacks = {}, [], {}
+    def frame_id(name, line):
+        key = (name, line)
+        if key not in frame_ids:
+            need(len(frames) < MAX_RECORDS, "profile_frame_limit")
+            frame_ids[key] = len(frames)
+            frames.append([name, line])
+        return frame_ids[key]
+    for ident, (mapping, lines) in locations.items():
+        need(not mapping or mapping in mappings, "profile_mapping_reference")
+        stack = []
+        for function, line in lines:
+            need(function in names, "profile_function_reference")
+            stack.append(frame_id(names[function], line))
+        stacks[ident] = stack or [frame_id("unknown_function", 0)]
+    merged, totals, expanded_frames = {}, [0] * len(resolved), 0
+    for stack, values in samples:
+        need(len(values) == len(resolved) and all(loc in stacks for loc in stack), "profile_sample_reference")
+        expanded_stack = tuple(frame for loc in stack for frame in stacks[loc])
+        expanded_frames += len(expanded_stack)
+        need(expanded_frames <= MAX_FRAMES, "profile_stack_expansion_limit")
+        if expanded_stack not in merged:
+            merged[expanded_stack] = [0] * len(resolved)
+        for i, value in enumerate(values):
+            merged[expanded_stack][i] += value
+            totals[i] += value
+            need(totals[i] < 2**63, "profile_total_limit")
+    need(samples, "profile_empty_samples")
+    if kind == "cpu":
+        need(totals[0] > 0 and totals[1] == totals[0] * period and scalars.get(10, 0) > 0, "profile_cpu_totals")
+    return {"schema": 2, "kind": kind, "raw_bytes": len(raw), "raw_sha256": hashlib.sha256(raw).hexdigest(),
+            "sample_types": [list(t) for t in resolved], "period": period,
+            "duration_ns": scalars.get(10, 0), "totals": totals, "raw_sample_records": len(samples),
+            "lost_profile_event": any(n.rsplit(".", 1)[-1] == "lostProfileEvent" for n in names.values()),
+            "redacted_function_count": sum(n.startswith("redacted_symbol_") for n in names.values()),
+            "frames": frames, "samples": [{"stack": list(s), "values": v} for s, v in sorted(merged.items())]}
+
+
+def stack_values(profile, column):
+    result = defaultdict(int)
+    for sample in profile["samples"]:
+        stack = tuple(tuple(profile["frames"][i]) for i in sample["stack"])
+        result[stack] += sample["values"][column]
+    return dict(result)
+
+
+def summarize(stacks, *, unit, production_only=False):
+    flat, cumulative = defaultdict(int), defaultdict(int)
+    total = kept = excluded = 0
+    for stack, weight in stacks.items():
+        if production_only and not any(name.startswith(PRODUCTION) for name, _ in stack):
+            excluded += weight
+            continue
+        if not weight:
+            continue
+        total += weight
+        kept += 1
+        flat[stack[0][0]] += weight
+        for name in {name for name, _ in stack}:  # recursion counted once
+            cumulative[name] += weight
+    names = set(flat) | set(cumulative)
+    def row(name):
+        return {"symbol": name, "flat": flat[name], "cumulative": cumulative[name]}
+    flat_order = sorted(names, key=lambda n: (-abs(flat[n]), n))
+    cumulative_order = sorted(names, key=lambda n: (-abs(cumulative[n]), n))
+    flat_top = flat_order[:40]
+    return {"unit": unit, "total": total, "excluded_total": excluded,
+            "nonzero_stacks": kept, "function_count": len(names),
+            "top_flat": [row(n) for n in flat_top],
+            "top_cumulative": [row(n) for n in cumulative_order[:40]],
+            "omitted_flat": sum(flat[n] for n in flat_order[40:]),
+            "omitted_function_count": max(0, len(names) - 40), "production_only": production_only}
+
+
+def summarize_cpu(profile):
+    need(profile["kind"] == "cpu" and profile["sample_types"] == [list(t) for t in CPU_TYPES], "cpu_summary_kind")
+    result = summarize(stack_values(profile, 1), unit="nanoseconds")
+    need(result["total"] == profile["totals"][1], "cpu_summary_total")
+    result.update(weighted_samples=profile["totals"][0], period_ns=profile["period"],
+                  lost_profile_event=profile["lost_profile_event"])
+    return result
+
+
+def summarize_alloc_delta(before, after):
+    need(before["kind"] == after["kind"] == "allocs" and before["period"] == after["period"] == 65536
+         and before["sample_types"] == after["sample_types"] == [list(t) for t in ALLOC_TYPES], "allocation_snapshot_schema")
+    results = {}
+    for column, key, unit in ((0, "alloc_objects", "objects"), (1, "alloc_space", "bytes")):
+        left, right = stack_values(before, column), stack_values(after, column)
+        delta = {s: right.get(s, 0) - left.get(s, 0) for s in left.keys() | right.keys()}
+        result = summarize(delta, unit=unit, production_only=True)
+        result["all_stacks_delta"] = after["totals"][column] - before["totals"][column]
+        need(result["total"] + result["excluded_total"] == result["all_stacks_delta"], "allocation_delta_total")
+        result["sampling_estimate"] = True
+        result["negative_stack_count"] = sum(v < 0 for v in delta.values())
+        results[key] = result
+    return results
+
