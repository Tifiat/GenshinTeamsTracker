+def _stage_request(job: Path, arm: str, engine_binding: dict) -> tuple[Path, dict]:
+    folder = job / arm
+    folder.mkdir()
+    original = json.loads(_bounded(K.RUN / "request.json"))
+    request = {**original, "engine": engine_binding}
+    path = folder / "request.json"
+    path.write_bytes(K.gate.canonical(request))
+    return folder, request
+
+
+def _candidate_binding(build, binding: dict) -> dict:
+    wire = {"binary_path": str(build.artifact_path).replace("\\", "/"),
+            "artifact_sha256": build.artifact_sha256,
+            "source_manifest_sha256": build.source_manifest_body_sha256,
+            "patch_manifest_sha256": binding["patch_stack_sha256"],
+            "capabilities": sorted(build.gtt_capabilities)}
+    wire["binding_sha256"] = K.sha(complete.source_manifest_build.canonical_json({
+        "kind": "gtt.standalone_engine_binding.v1",
+        "artifact_sha256": build.artifact_sha256,
+        "source_manifest_sha256": build.source_manifest_body_sha256,
+        "patch_manifest_sha256": binding["patch_stack_sha256"]}).encode())
+    return wire
+
+
+def _manifest_engine(engine: Path, build, binding: dict, patch: bytes) -> dict:
+    store = engine_store.GcsimEngineStore(ROOT / "data/gcsim/engines")
+    old = engine_store.load_engine_manifest(store.engines_dir / runtime.OLD_ENGINE_ID)
+    metadata = {**old.metadata, **build.metadata(),
+                "artifact_sha256": ENGINE_SHA,
+                "source_manifest_body_sha256": SOURCE_SHA,
+                "source_manifest_patched_tree_sha256": build.source_manifest_patched_tree_sha256,
+                "unified_health_research_v8_result_sha256": V8_RESULT_SHA}
+    patch_files = json.loads(old.patch_metadata["patch_files"])
+    patch_hashes = json.loads(old.patch_metadata["patch_file_sha256"])
+    if len(patch_files) != 17 or "candidate-source.patch" in patch_files:
+        raise ValueError("uptake_original_patch_stack_invalid")
+    patch_files.append("candidate-source.patch")
+    patch_hashes["candidate-source.patch"] = sha(patch)
+    patch_meta = {**old.patch_metadata,
+                  "patch_files": json.dumps(patch_files, separators=(",", ":")),
+                  "patch_file_sha256": json.dumps(patch_hashes, sort_keys=True, separators=(",", ":")),
+                  "patch_stack_sha256": binding["patch_stack_sha256"],
+                  "patch_stack_path": str(engine)}
+    manifest = replace(old, engine_id=runtime.ENGINE_ID,
+                       source_path=str(engine), patch_count=18,
+                       engine_tree_hash=tree_identity.directory_sha256(
+                           engine, excluded_relative_paths=("gtt_engine_manifest.json",)),
+                       prepared_at_utc=datetime.now(timezone.utc).isoformat(),
+                       patch_metadata=patch_meta, metadata=metadata)
+    engine_store._write_manifest(engine / "gtt_engine_manifest.json", manifest)
+    sync._verified_engine(engine, engine_id=runtime.ENGINE_ID,
+                          expected_artifact_sha=ENGINE_SHA)
+    return manifest.to_dict()
