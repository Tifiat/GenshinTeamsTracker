@@ -0,0 +1,647 @@
+"""One source-frozen formula-primary/secondary experiment using the existing managed runner.
+
+Importing this module only prepares source images and read-only saved-input
+pins. Execution requires the exact reviewed --freeze document. No baseline,
+hybrid, or fixed-control run is repeated here.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+import os
+from pathlib import Path
+import sys
+import time
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_formula_primary as ablation
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+
+EVIDENCE_PREFIX = "adaptive-formula-primary-"
+WHOLE_SECONDS = 480
+CLEANUP_RESERVE_SECONDS = 60
+COMPILE_SECONDS = 180
+CONTRACT_SECONDS = 30
+CANDIDATE_SECONDS = 240
+MAX_PROJECTION_BYTES = 8 << 20
+MAX_RAW_EXPORT_BYTES = 32 << 20
+
+
+def _saved_input_paths() -> tuple[Path, ...]:
+    names = (
+        "adaptive-hybrid-baseline-projection.json.gz",
+        "adaptive-hybrid-successor-candidate-projection.json.gz",
+        "adaptive-no-feedback-candidate-projection.json.gz",
+        "adaptive-fixed-control-baseline_best-result.json.gz",
+        "adaptive-fixed-control-baseline_best-config.txt.gz",
+        "adaptive-fixed-control-baseline_best-n2000.txt.gz",
+        "adaptive-fixed-control-adaptive_best-result.json.gz",
+        "adaptive-fixed-control-adaptive_best-config.txt.gz",
+        "adaptive-fixed-control-adaptive_best-n2000.txt.gz",
+    )
+    return tuple(k.EVIDENCE / name for name in names)
+
+
+def _read_saved_inputs() -> dict[str, dict[str, Any]]:
+    """Read and pin prior evidence only; never launches or reconstructs a run."""
+    inputs: dict[str, dict[str, Any]] = {}
+    for path in _saved_input_paths():
+        compressed = path.read_bytes()
+        raw = gzip.decompress(compressed) if path.suffix == ".gz" else compressed
+        if len(raw) > MAX_RAW_EXPORT_BYTES:
+            raise ValueError(f"saved input exceeds bounded read: {path.name}")
+        row: dict[str, Any] = {
+            "path": str(path),
+            "compressed_sha256": k.sha(compressed),
+            "compressed_bytes": len(compressed),
+            "raw_sha256": k.sha(raw),
+            "raw_bytes": len(raw),
+        }
+        if path.name.endswith("projection.json.gz") or path.name.endswith("result.json.gz"):
+            document = json.loads(raw)
+            if path.name.endswith("projection.json.gz"):
+                row["projection_schema"] = document.get("schema")
+                row["complete"] = document.get("complete")
+                row["initial_assignment"] = document.get("projection", {}).get("initial", {}).get("score", {}).get("assignment")
+            else:
+                row["control_status"] = document.get("status")
+                row["attempted"] = document.get("attempted")
+                row["completed"] = document.get("completed")
+        inputs[path.name] = row
+    return inputs
+
+
+def _source_pins(overlay: dict[str, Any]) -> dict[str, str]:
+    replay = ablation.replay
+    paths = (
+        Path(__file__),
+        Path(__file__).with_name("adaptive_no_feedback_run.py"),
+        Path(__file__).with_name("test_adaptive_formula_primary_export.py"),
+        Path(ablation.__file__),
+        Path(ablation.no_feedback.__file__),
+        Path(replay.__file__),
+        replay.POLICY,
+        replay.EXTRA,
+        Path(k.__file__),
+        k.old.HELPER,
+        k.RUN / "request.json",
+        k.RUN / "set-sources.json",
+        k.EVIDENCE / "adaptive-no-feedback-result.json",
+        k.EVIDENCE / "adaptive-no-feedback-freeze.json",
+        k.EVIDENCE / "TIGHNARI20_SCALAR_ACCEPTED_CONSUMER_BUILD.json",
+    )
+    pins = {path.relative_to(k.ROOT).as_posix(): k.sha(path.read_bytes()) for path in (*paths, *getattr(ablation, "SOURCE_FILES", ()))}
+    pins["preimage:adaptive_no_feedback_run.py"] = k.sha(Path(__file__).with_name("adaptive_no_feedback_run.py").read_bytes())
+    pins["accepted_source_map_sha256"] = overlay["hashes"]["accepted_source_map_sha256"]
+    pins["patched_source_map_sha256"] = overlay["hashes"]["replayed_source_map_sha256"]
+    for path, raw in sorted(overlay["overlay_files"].items()):
+        pins["overlay:" + path] = k.sha(raw)
+    return pins
+
+
+def frozen_plan() -> dict[str, Any]:
+    """Canonical plan the parent can place in the source-review freeze receipt."""
+    overlay = ablation.formula_primary_overlay()
+    inputs = _read_saved_inputs()
+    return _frozen_plan(overlay, inputs)
+
+
+def _frozen_plan(overlay: dict[str, Any], inputs: dict[str, dict[str, Any]]) -> dict[str, Any]:
+    pins = _source_pins(overlay)
+    return {
+        "schema": "adaptive_formula_primary_run_freeze_v1",
+        "policy": overlay["metadata"],
+        "source_pins": pins,
+        "overlay_hashes": overlay["hashes"],
+        "saved_input_pins": {name: row["compressed_sha256"] for name, row in inputs.items()},
+        "limits": {
+            "whole_seconds_including_cleanup": WHOLE_SECONDS,
+            "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
+            "compile_seconds_max": COMPILE_SECONDS,
+            "contract_test_seconds_max": CONTRACT_SECONDS,
+            "candidate_test_seconds": CANDIDATE_SECONDS,
+            "go_mem_limit": "2GiB",
+            "managed_jobs_created_max": 1,
+            "candidate_builds": 1,
+            "candidate_replays": 1,
+            "baseline_or_hybrid_replays": 0,
+            "policy_engine_calls": 48,
+            "secondary_refinements_max": 8,
+            "secondary_refinements_per_block_max": 1,
+            "final_engine_measurements": 9,
+        },
+        "commands": [
+            "go test -c -p=1 -mod=readonly -buildvcs=false -overlay=<job>/overlay.json -o <job>/adaptive-formula-primary.exe ./internal/allsets",
+            "<job>/adaptive-formula-primary.exe -test.run=^TestAdaptiveHybridContract -test.v -test.timeout=30s",
+            "<job>/adaptive-formula-primary.exe -test.run=^TestAdaptiveHybridSavedReplay$ -test.v -test.parallel=1 -test.timeout=240s (GTT_TIGHNARI_REPLAY_ROLE=candidate)",
+        ],
+        "evidence_prefix": EVIDENCE_PREFIX,
+    }
+
+
+def _write_gzip_once(raw: bytes, target: Path) -> dict[str, Any]:
+    if len(raw) > MAX_RAW_EXPORT_BYTES:
+        raise ValueError(f"raw export exceeds bound: {target.name}")
+    if target.exists():
+        readback = target.read_bytes()
+        if gzip.decompress(readback) != raw:
+            raise ValueError(f"existing gzip export differs; refusing overwrite: {target.name}")
+    else:
+        packed = gzip.compress(raw, mtime=0)
+        with target.open("xb") as stream:
+            stream.write(packed)
+            stream.flush()
+            os.fsync(stream.fileno())
+        readback = target.read_bytes()
+    if gzip.decompress(readback) != raw:
+        raise ValueError(f"gzip readback mismatch: {target.name}")
+    return {
+        "path": str(target),
+        "raw_bytes": len(raw),
+        "raw_sha256": k.sha(raw),
+        "compressed_bytes": len(readback),
+        "compressed_sha256": k.sha(readback),
+        "readback_exact": True,
+    }
+
+
+def _policy_sample_count(policy: dict[str, Any]) -> int:
+    """Only this typed zero-call policy schema may encode its nil samples as null."""
+    if "samples" not in policy:
+        raise ValueError("policy samples missing; unknown is not zero")
+    samples = policy["samples"]
+    if isinstance(samples, list):
+        return len(samples)
+    if (samples is None and type(policy.get("calls")) is int and policy["calls"] == 0
+            and policy.get("engine_ms") == 0 and policy.get("engine_wall_ms") == 0
+            and policy.get("has_incumbent") is False):
+        return 0
+    raise ValueError("null/malformed samples outside typed zero-call policy")
+
+
+def _export_job(job: Path, record: dict[str, Any]) -> None:
+    exports: dict[str, Any] = record.setdefault("lossless_exports", {})
+    logs: list[dict[str, Any]] = []
+    for path in sorted(job.glob("formula-primary-*.log")):
+        artifact = _write_gzip_once(
+            path.read_bytes(), k.EVIDENCE / f"{EVIDENCE_PREFIX}log-{path.name}.gz"
+        )
+        artifact["source_name"] = path.name
+        logs.append(artifact)
+    if logs:
+        exports["command_logs"] = logs
+    progress_rows: list[dict[str, Any]] = []
+    progress_path = job / "adaptive-policy-progress.jsonl"
+    if progress_path.is_file():
+        progress = progress_path.read_bytes()
+        exports["policy_journal"] = _write_gzip_once(
+            progress, k.EVIDENCE / f"{EVIDENCE_PREFIX}policy-progress.jsonl.gz"
+        )
+    ledger_rows: list[dict[str, Any]] = []
+    ledger_path = job / "candidate-final-ledger.jsonl"
+    if ledger_path.is_file():
+        ledger_raw = ledger_path.read_bytes()
+        exports["final_ledger"] = _write_gzip_once(
+            ledger_raw, k.EVIDENCE / f"{EVIDENCE_PREFIX}final-ledger.jsonl.gz"
+        )
+    projection = job / "candidate-projection.json"
+    if projection.is_file():
+        raw = projection.read_bytes()
+        if len(raw) > MAX_PROJECTION_BYTES:
+            raise ValueError("candidate projection exceeds 8 MiB retention bound")
+        target = k.EVIDENCE / f"{EVIDENCE_PREFIX}candidate-projection.json.gz"
+        exports["ordered_projection"] = _write_gzip_once(raw, target)
+
+
+    final_root = job / "candidate-final"
+    if final_root.is_dir():
+        configs = sorted(final_root.rglob("config.txt"))
+        results = sorted(final_root.rglob("result.json"))
+        record["raw_final_artifacts"] = {"configs_found": len(configs), "results_found": len(results)}
+        if configs or results:
+            rows = []
+            for label, paths in (("config", configs), ("result", results)):
+                for index, path in enumerate(paths):
+                    relative = path.relative_to(final_root).as_posix()
+                    target = k.EVIDENCE / f"{EVIDENCE_PREFIX}final-{label}-{index:02d}.gz"
+                    artifact = _write_gzip_once(path.read_bytes(), target)
+                    artifact["source_relative_path"] = relative
+                    artifact["kind"] = label
+                    artifact["index"] = index
+                    rows.append(artifact)
+            record["raw_final_artifacts"]["exports"] = rows
+    policy_root = job / "adaptive-policy-runs"
+    policy_artifacts = []
+    for label, filename in (("config", "config.txt"), ("result", "result.json")):
+        paths = sorted(policy_root.rglob(filename)) if policy_root.is_dir() else []
+        if len(paths) > 48:
+            raise ValueError("policy raw artifacts exceed48-call grant")
+        for index, path in enumerate(paths):
+            row = _write_gzip_once(path.read_bytes(), k.EVIDENCE / f"{EVIDENCE_PREFIX}policy-{label}-{index:02d}.gz")
+            row.update(kind=label, source_relative_path=path.relative_to(policy_root).as_posix())
+            policy_artifacts.append(row)
+    record["raw_policy_artifacts"] = policy_artifacts
+    if projection.is_file():
+        # Every available raw artifact is durable before parsing summary inputs.
+        payload = json.loads(projection.read_bytes())
+        if progress_path.is_file():
+            progress_rows = [json.loads(line) for line in progress.splitlines() if line]
+        if ledger_path.is_file():
+            ledger_rows = [json.loads(line) for line in ledger_raw.splitlines() if line]
+        policy = payload.get("policy", {})
+        events = policy.get("events", [])
+        final = progress_rows[-1] if progress_rows else policy
+        record["candidate_summary"] = {
+            "complete": payload.get("complete"),
+            "provider_calls": payload.get("provider_calls"),
+            "run_neutral_seconds": payload.get("run_neutral_seconds"),
+            "search_metrics": payload.get("search_metrics"),
+            "ordered_projection_sha256": k.sha(raw),
+            "finalists": len(payload.get("projection", {}).get("finalists", [])),
+            "initial_candidate_protected": any(
+                row.get("assignment") == payload.get("projection", {}).get("initial", {}).get("score", {}).get("assignment")
+                for row in payload.get("verification", {}).get("panel", [])
+            ),
+            "policy_calls": policy.get("calls"),
+            "policy_engine_ms": policy.get("engine_ms"),
+            "policy_engine_wall_ms": policy.get("engine_wall_ms"),
+            "policy_samples": _policy_sample_count(policy),
+            "policy_has_incumbent": policy.get("has_incumbent"),
+            "event_count": len(events),
+            "secondary_event_counts": {kind: sum(row.get("type") == kind for row in events) for kind in sorted({row.get("type", "") for row in events if "secondary" in row.get("type", "")})},
+            "feedback_disabled_events": sum(row.get("type") == "feedback_disabled" for row in events),
+            "progress_snapshots": len(progress_rows),
+            "final_policy_calls": final.get("calls"),
+            "final_policy_samples": _policy_sample_count(final),
+            "final_ledger_attempted": sum(row.get("phase") == "attempted_before_runner" for row in ledger_rows),
+            "final_ledger_measured": sum(row.get("phase") == "measured" for row in ledger_rows),
+            "final_measurements": len(payload.get("verification", {}).get("result", {}).get("candidates", [])),
+            "final_panel_workers": payload.get("verification", {}).get("workers"),
+            "final_panel_parallelism": payload.get("verification", {}).get("parallelism"),
+        }
+
+
+
+def _validate_success(job: Path, record: dict[str, Any]) -> None:
+    payload = json.loads((job / "candidate-projection.json").read_bytes())
+    policy = payload.get("policy", {})
+    verify = payload.get("verification", {})
+    measured = verify.get("result", {}).get("candidates", [])
+    ledger = [json.loads(line) for line in (job / "candidate-final-ledger.jsonl").read_bytes().splitlines() if line]
+    attempts = [row for row in ledger if row.get("phase") == "attempted_before_runner"]
+    completions = [row for row in ledger if row.get("phase") == "measured"]
+    initial = payload.get("projection", {}).get("initial", {}).get("score", {}).get("assignment")
+    panel_assignments = [row.get("assignment") for row in verify.get("panel", [])]
+    if not payload.get("complete") or payload.get("provider_calls") != 1:
+        raise ValueError("saved candidate replay did not complete with one provider call")
+    calls = policy.get("calls")
+    if type(calls) is not int or not 0 <= calls <= 48 or _policy_sample_count(policy) != calls:
+        raise ValueError("policy calls/samples violate48-call frozen grant")
+    events = policy.get("events")
+    if not isinstance(events, list):
+        raise ValueError("policy events missing")
+    anchors = [e for e in events if e.get("type") == "block_anchor"]
+    if len(anchors) != 8 or any(e["anchor"]["assignment"] != e["fallback"]["assignment"] for e in anchors):
+        raise ValueError("primary formula fallback was replaced or eight blocks missing")
+    secondary = [e for e in events if e.get("type") == "secondary_refinement_started"]
+    if len(secondary) > 8 or len({e.get("block") for e in secondary}) != len(secondary):
+        raise ValueError("secondary refinement exceeds one per block/eight total")
+    if policy.get("has_incumbent"):
+        incumbent = policy["incumbent"]["assignment"]
+        if incumbent not in panel_assignments:
+            raise ValueError("exact engine incumbent missing from protected final panel")
+    formula_leader = payload["best_found_by_search_before_protection"]["score"]["assignment"]
+    if formula_leader not in panel_assignments:
+        raise ValueError("current formula leader missing from protected final panel")
+    if len(measured) != 9 or len(attempts) != 9 or len(completions) != 9:
+        raise ValueError("final verification ledger/result is not exactly nine attempted and measured")
+    attempted_keys = [row.get("candidate_sha256") for row in attempts]
+    completion_measurements = [row.get("measurement", {}) for row in completions]
+    completion_keys = [row.get("candidate_sha256") for row in completion_measurements]
+    if (len(set(attempted_keys)) != 9 or len(set(completion_keys)) != 9
+            or set(attempted_keys) != set(completion_keys)):
+        raise ValueError("final attempted and measured ledger candidate identities do not join uniquely")
+    if initial not in panel_assignments:
+        raise ValueError("original search initial candidate is absent from the protected final panel")
+    if verify.get("iterations") != 500 or verify.get("workers") != 4 or verify.get("parallelism") != 4:
+        raise ValueError("final verification settings differ from the frozen 9 x n500 protocol")
+    ranks: set[int] = set()
+    assignments: set[str] = set()
+    measured_by_assignment: dict[str, dict[str, Any]] = {}
+    for row in measured:
+        if (row.get("iterations") != 500 or len(row.get("config_sha256", "")) != 64
+                or len(row.get("engine_result_sha256", "")) != 64):
+            raise ValueError("final measured row is missing its exact n500/config/result identity")
+        rank = row.get("rank")
+        assignment = row.get("assignment")
+        if type(rank) is not int or rank < 1 or rank > 9 or rank in ranks:
+            raise ValueError("final measured ranks are missing, duplicated, or outside 1..9")
+        if not isinstance(assignment, list) or len(assignment) != 4 or any(
+            not isinstance(package, list) or len(package) != 5 for package in assignment
+        ):
+            raise ValueError(f"final measured assignment at rank {rank} is not 4x5")
+        flat_ids = [artifact_id for package in assignment for artifact_id in package]
+        if any(type(artifact_id) is not int for artifact_id in flat_ids) or len(set(flat_ids)) != 20:
+            raise ValueError(f"final measured assignment at rank {rank} does not use 20 unique artifact IDs")
+        identity = json.dumps(assignment, separators=(",", ":"))
+        if identity in assignments:
+            raise ValueError("duplicate final measured assignment")
+        ranks.add(rank)
+        assignments.add(identity)
+        measured_by_assignment[identity] = row
+    completion_by_assignment: dict[str, dict[str, Any]] = {}
+    for entry in completion_measurements:
+        identity = entry.get("build_identity", {}).get("assignment")
+        if not isinstance(identity, list):
+            raise ValueError("final measured ledger entry is missing its build assignment")
+        identity_key = json.dumps(identity, separators=(",", ":"))
+        if identity_key in completion_by_assignment:
+            raise ValueError("duplicate final measured ledger assignment")
+        completion_by_assignment[identity_key] = entry
+    if ranks != set(range(1, 10)) or set(measured_by_assignment) != set(completion_by_assignment):
+        raise ValueError("final measured rows and ledger assignments do not join exactly")
+    final_root = job / "candidate-final"
+    bindings = []
+    for identity, row in measured_by_assignment.items():
+        rank = row["rank"]
+        ledger_measurement = completion_by_assignment[identity]
+        if (ledger_measurement.get("config_sha256") != row.get("config_sha256")
+                or ledger_measurement.get("engine_result_sha256") != row.get("engine_result_sha256")):
+            raise ValueError(f"final measured row and ledger hashes differ at rank {rank}")
+        rank_dirs = {
+            path.parent for path in final_root.rglob("config.txt")
+            if path.parent.name.startswith(f"{rank:02d}-")
+        }
+        if len(rank_dirs) != 1:
+            raise ValueError(f"could not uniquely locate raw final artifacts for rank {rank}")
+        rank_dir = next(iter(rank_dirs))
+        config_path, result_path = rank_dir / "config.txt", rank_dir / "result.json"
+        if not config_path.is_file() or not result_path.is_file():
+            raise ValueError(f"raw final config/result is incomplete at rank {rank}")
+        config_sha, result_sha = k.sha(config_path.read_bytes()), k.sha(result_path.read_bytes())
+        if config_sha != row["config_sha256"] or result_sha != row["engine_result_sha256"]:
+            raise ValueError(f"raw final config/result hashes do not bind to rank {rank}")
+        bindings.append({
+            "rank": rank,
+            "assignment": row["assignment"],
+            "candidate_sha256": ledger_measurement["candidate_sha256"],
+            "config_sha256": config_sha,
+            "engine_result_sha256": result_sha,
+        })
+    record["final_measurement_bindings"] = sorted(bindings, key=lambda row: row["rank"])
+    _export_job(job, record)
+    policy_root = job / "adaptive-policy-runs"
+    actual_pairs = {}
+    results = sorted(policy_root.rglob("result.json")) if policy_root.is_dir() else []
+    configs = sorted(policy_root.rglob("config.txt")) if policy_root.is_dir() else []
+    if len(results) != calls or len(configs) != calls:
+        raise ValueError("policy raw artifacts do not match actual sample count")
+    for result_path in results:
+        config_path = result_path.with_name("config.txt")
+        if not config_path.is_file():
+            raise ValueError("policy result has no submitted config")
+        pair = (k.sha(config_path.read_bytes()), k.sha(result_path.read_bytes()))
+        if pair in actual_pairs:
+            raise ValueError("duplicate policy raw result identity")
+        actual_pairs[pair] = result_path.parent.relative_to(policy_root).as_posix()
+    samples = policy["samples"] if isinstance(policy["samples"], list) else []
+    seeds = json.loads((k.RUN / "request.json").read_bytes())["stochastic"]["seeds"]
+    if sorted(row.get("call") for row in samples) != list(range(1, calls + 1)):
+        raise ValueError("policy sample call sequence is incomplete")
+    started_events = [e for e in events if e.get("type") == "ordinary_started"]
+    finished_events = [e for e in events if e.get("type") == "ordinary_finished"]
+    if len(started_events) != calls or len(finished_events) != calls:
+        raise ValueError("policy actual started/finished events do not match calls")
+    bindings_policy = []
+    for sample in samples:
+        pair = (sample.get("config_sha256"), sample.get("engine_result_sha256"))
+        if pair not in actual_pairs or sample.get("seed") not in seeds:
+            raise ValueError("policy sample has no exact raw pair or authorized seed")
+        bindings_policy.append({key: sample.get(key) for key in (
+            "block", "call", "seed", "config_sha256", "engine_result_sha256")})
+        bindings_policy[-1]["source_relative_directory"] = actual_pairs[pair]
+    record["policy_measurement_bindings"] = bindings_policy
+    artifacts = record.get("raw_final_artifacts", {})
+    if artifacts.get("configs_found") != 9 or artifacts.get("results_found") != 9 or len(artifacts.get("exports", [])) != 18:
+        raise ValueError("nine raw final configs and results were not durably exported")
+
+
+def run(destination: Path, freeze_path: Path) -> dict[str, Any]:
+    started = time.monotonic()
+    if destination.exists():
+        raise FileExistsError(destination)
+    overlay = ablation.formula_primary_overlay()
+    inputs = _read_saved_inputs()
+    plan = _frozen_plan(overlay, inputs)
+    frozen = json.loads(freeze_path.read_bytes())
+    if frozen.get("source_review_status") != "approved" or frozen.get("frozen_plan") != plan:
+        raise ValueError("source-reviewed freeze does not match this exact formula-primary CLI plan")
+    saved_inputs = inputs
+    pins = _source_pins(overlay)
+    before = k.protected()
+    native_before = k.old.native_map()
+    source_before = {
+        relative: k.sha((k.ROOT / relative).read_bytes())
+        for relative in pins
+        if not relative.startswith(("accepted_", "patched_", "overlay:", "preimage:"))
+    }
+    active: list[Path | None] = [None]
+    record: dict[str, Any] = {
+        "schema": "adaptive_formula_primary_run_result_v1",
+        "status": "started",
+        "errors": [],
+        "freeze_path": str(freeze_path),
+        "freeze_sha256": k.sha(freeze_path.read_bytes()),
+        "frozen_plan": plan,
+        "saved_input_pins": saved_inputs,
+        "protected_before": before,
+        "accepted_native_map_before_sha256": k.gate.digest(native_before),
+        "source_pins_before": source_before,
+        "managed_jobs_created": 0,
+        "remaining_managed_jobs": None,
+        "baseline_or_hybrid_reruns": 0,
+        "candidate_replays": 0,
+        "policy_engine_calls": None,
+        "final_measurements": None,
+        "installs": 0,
+        "captures": 0,
+        "retries": 0,
+        "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
+    }
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("run with the repository .venv/Scripts/python.exe")
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")):
+        raise RuntimeError("managed-job root is not idle; no attempt started")
+    if k.gate.retirement._default_process_probe(k.ROOT):
+        raise RuntimeError("optimizer process probe is not idle; no attempt started")
+    for target in (
+        destination,
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}candidate-projection.json.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}policy-progress.jsonl.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}final-ledger.jsonl.gz",
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}log-{label}.log.gz" for label in (
+            "formula-primary-compile", "formula-primary-contracts", "formula-primary-candidate",
+        )),
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}final-config-{index:02d}.gz" for index in range(9)),
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}final-result-{index:02d}.gz" for index in range(9)),
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}policy-{kind}-{index:02d}.gz" for kind in ("config", "result") for index in range(48)),
+    ):
+        if target.exists():
+            raise FileExistsError(target)
+    with destination.open("xb") as stream:
+        def save() -> None:
+            k.gate.io._save(stream, record)
+
+        def export() -> None:
+            job = active[0]
+            if job is not None:
+                _export_job(job, record)
+            save()
+
+        def body(job: Path) -> None:
+            active[0] = job
+            record["managed_jobs_created"] = 1
+            env, _ = k.gate.common._environment(job)
+            env.update(
+                GOMEMLIMIT="2GiB",
+                GTT_TIGHNARI_ARCHIVED_WHOLE="root_released_once",
+                GTT_TIGHNARI_REPLAY_REPO=str(k.ROOT),
+                GTT_TIGHNARI_REPLAY_ROLE="candidate",
+            )
+            replace: dict[str, str] = {}
+            for index, (relative, raw) in enumerate(sorted(overlay["images"].items())):
+                native_path = k.NATIVE / relative
+                if not native_path.is_file() or k.sha(native_path.read_bytes()) != k.sha(raw):
+                    staged = job / f"source-{index:03d}.go"
+                    staged.write_bytes(raw)
+                    replace[str(native_path)] = str(staged)
+            for relative in set(native_before) - set(overlay["images"]):
+                replace[str(k.NATIVE / relative)] = ""
+            for relative, raw in sorted(overlay["overlay_files"].items()):
+                staged = job / Path(relative).name
+                staged.write_bytes(raw)
+                replace[str(k.NATIVE / relative)] = str(staged)
+            overlay_path = job / "overlay.json"
+            overlay_path.write_bytes(k.gate.canonical({"Replace": replace}))
+            binary = job / "adaptive-formula-primary.exe"
+
+            def command(args: list[str], label: str, limit: int) -> None:
+                remaining = WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE_SECONDS
+                if remaining <= 0:
+                    raise TimeoutError("cleanup reserve reached before " + label)
+                timeout = min(limit, remaining)
+                record["stage"] = label
+                record.setdefault("command_timeouts_seconds", {})[label] = timeout
+                save()
+                result = k.gate.owned._run_owned(
+                    args,
+                    command_kind=label,
+                    env=env,
+                    log_path=job / f"{label}.log",
+                    timeout_seconds=timeout,
+                )
+                record.setdefault("commands", {})[label] = result
+                save()
+                if not k.gate.command_passed(result):
+                    log = job / f"{label}.log"
+                    if log.exists():
+                        record["failure_tail"] = log.read_text(encoding="utf-8", errors="replace")[-5000:]
+                        save()
+                    raise RuntimeError(label + " failed")
+
+            go = str(k.gate.owned.GO_EXE)
+            command(
+                [go, "-C", str(k.NATIVE), "test", "-c", "-p=1", "-mod=readonly", "-buildvcs=false",
+                 "-overlay=" + str(overlay_path), "-o", str(binary), "./internal/allsets"],
+                "formula-primary-compile", COMPILE_SECONDS,
+            )
+            record["binary_sha256"] = k.sha(binary.read_bytes())
+            save()
+            command(
