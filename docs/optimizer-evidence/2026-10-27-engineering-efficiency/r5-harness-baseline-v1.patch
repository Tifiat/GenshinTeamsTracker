+++ b/tools/experiments/gcsim/mvp_polish/candidate_preservation_case.py
@@ -0,0 +1,119 @@
+"""Thin, owned-process binding for the four existing regression fixtures.
+
+This wrapper changes only the consumer and fixed engine identities in the
+already reviewed case helper. Each arm is a fresh Python process. It does not
+alter product code, source fixtures, account state, or the optimizer request.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from unittest.mock import patch
+
+from tools.experiments.gcsim.mvp_polish import health_unified_cases as cases
+
+
+FIXED_ENGINE_SHA = "3913a8773c696e0c4728cf51b6531bf0ab8c49e23b891dacaede2b20a168d306"
+INSTALLED_CONSUMER_SHA = "a2c59f7396f8047caa27ffe511a8ec476390a3ac54692911346be80542fddffc"
+
+
+def selected_research_command(argv: tuple[str, ...], run_dir: Path) -> tuple[str, ...]:
+    """Switch only the Selected verification mode; retain Finish signaling."""
+    if (len(argv) != 8 or argv[1] != "verify-fgbs"
+            or argv[5] != "all" or argv[6] != "--finish-file"
+            or Path(argv[7]).resolve() != (Path(run_dir) / "finish-requested").resolve()):
+        raise ValueError("preservation_selected_command_shape_changed")
+    return (*argv[:5], "adaptive-research", *argv[6:])
+
+
+def admit_consumer(job: Path, arm: str, path: Path, expected_sha: str) -> Path:
+    resolved = path.resolve(strict=True)
+    installed = (cases.ROOT / "native/gcsim_optimizer/gtt-optimizer.exe").resolve(strict=True)
+    staged = (job / "product-candidate.exe").resolve(strict=True) if (job / "product-candidate.exe").is_file() else None
+    if arm == "control":
+        if resolved != installed or expected_sha != INSTALLED_CONSUMER_SHA:
+            raise ValueError("preservation_control_consumer_identity")
+    elif arm == "candidate":
+        if resolved != staged or expected_sha == INSTALLED_CONSUMER_SHA:
+            raise ValueError("preservation_candidate_consumer_identity")
+    else:
+        raise ValueError("preservation_arm_invalid")
+    if hashlib.sha256(resolved.read_bytes()).hexdigest() != expected_sha:
+        raise ValueError("preservation_consumer_hash_changed")
+    return resolved
+
+
+def run(job: Path, case: str, arm: str, stage: str, binding_path: Path,
+        consumer_path: Path, consumer_sha: str, adaptive_selected: bool = False) -> dict:
+    job = cases.owned_job(job)
+    consumer = admit_consumer(job, arm, consumer_path, consumer_sha)
+    if case not in cases.CASES or stage not in ("prepare", "selected"):
+        raise ValueError("preservation_case_stage_invalid")
+    cases.CONSUMER = consumer
+    cases.CONSUMER_SHA = consumer_sha
+    cases.CONTROL_ENGINE_SHA = FIXED_ENGINE_SHA
+    # The historical control helper expects a Tighnari request at job/control.
+    # This one-case job has only cases/<case>/control; prepare writes that wire
+    # and the owner verifies its engine against this same validated binding.
+    binding = cases.binding_input(job, binding_path, "candidate")
+    if binding["artifact_sha256"] != FIXED_ENGINE_SHA:
+        raise ValueError("preservation_fixed_engine_changed")
+    if stage == "prepare":
+        if adaptive_selected:
+            raise ValueError("preservation_prepare_policy_invalid")
+        result = cases.prepare(job, case, arm, binding)
+    else:
+        if case == "chasca":
+            raise ValueError("preservation_chasca_is_all_sets")
+        if adaptive_selected:
+            if arm != "candidate":
+                raise ValueError("preservation_control_research_route_forbidden")
+            from tools.experiments.gcsim.mvp_polish import candidate_preservation_run as research
+            from tools.experiments.gcsim.mvp_polish.navia_exact_pair import function_view
+            from run_workspace.gcsim.optimizer_go_selected import GcsimOptimizerGoSelectedSession
+            original = GcsimOptimizerGoSelectedSession._optimizer_command
+
+            def research_command(self, binary, run_dir):
+                return selected_research_command(original(self, binary, run_dir), run_dir)
+
+            # Only the private Python receipt/session view admits the research
+            # discovery cohort (up to six). frozen_prepare still writes the
+            # byte-identical staged optimizer request with its old display cap.
+            research_cases = dict(cases.CASES)
+            original_case = research_cases[case]
+            research_cases[case] = (*original_case[:3], 6)
+            with patch.object(GcsimOptimizerGoSelectedSession,
+                              "_optimizer_command", research_command):
+                result = function_view(cases.selected,
+                    CASES=research_cases,
+                    selected_verification_cohort=research.research_verification_cohort)(job, case, arm, binding)
+            if not 1 <= len(result.get("cohort", [])) <= 6:
+                raise ValueError("preservation_selected_research_discovery_count")
+        else:
+            result = cases.selected(job, case, arm, binding)
+    if result.get("success") is not True:
+        raise ValueError("preservation_case_adapter_failed")
+    return {"case": case, "arm": arm, "stage": stage, "consumer_sha256": consumer_sha,
+            "engine_artifact_sha256": FIXED_ENGINE_SHA, "success": True}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--job", type=Path, required=True)
+    parser.add_argument("--case", choices=cases.CASES, required=True)
+    parser.add_argument("--arm", choices=("control", "candidate"), required=True)
+    parser.add_argument("--stage", choices=("prepare", "selected"), required=True)
+    parser.add_argument("--binding", type=Path, required=True)
+    parser.add_argument("--consumer", type=Path, required=True)
+    parser.add_argument("--consumer-sha", required=True)
+    parser.add_argument("--adaptive-selected", action="store_true")
+    arguments = parser.parse_args()
+    print(json.dumps(run(arguments.job, arguments.case, arguments.arm, arguments.stage,
+                         arguments.binding, arguments.consumer, arguments.consumer_sha,
+                         arguments.adaptive_selected), sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/experiments/gcsim/mvp_polish/candidate_preservation_measure.py b/tools/experiments/gcsim/mvp_polish/candidate_preservation_measure.py
