+def _verify_native_closure() -> dict[str, Any]:
+    _inside(NATIVE_CLOSURE, EVIDENCE_DIR)
+    if _sha256_file(NATIVE_CLOSURE) != NATIVE_CLOSURE_SHA256:
+        raise DiagnosticError("native source-closure receipt pin mismatch")
+    closure = json.loads(NATIVE_CLOSURE.read_text(encoding="utf-8"))
+    entries = closure.get("source_sha256")
+    if (
+        closure.get("kind") != "gtt.native_ab_source_closure_v1"
+        or closure.get("source_file_count") != NATIVE_FILE_COUNT
+        or closure.get("source_manifest_sha256") != NATIVE_MANIFEST_SHA256
+        or not isinstance(entries, dict)
+        or len(entries) != NATIVE_FILE_COUNT
+    ):
+        raise DiagnosticError("native 343-file source closure metadata drifted")
+    if closure.get("native_root") != "native/gcsim_optimizer":
+        raise DiagnosticError("native source-closure root metadata drifted")
+    if any(not isinstance(key, str) or not isinstance(value, str) for key, value in entries.items()):
+        raise DiagnosticError("native source closure contains a non-string path or hash")
+    canonical = json.dumps(entries, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    if hashlib.sha256(canonical).hexdigest() != NATIVE_MANIFEST_SHA256:
+        raise DiagnosticError("native source-closure canonical map digest drifted")
+    native_root = _inside(NATIVE_ROOT, ROOT)
+    found: set[str] = set()
+    for current, directories, filenames in os.walk(native_root, followlinks=False):
+        for name in directories:
+            assert_unlinked(Path(current) / name)
+        for name in filenames:
+            candidate = Path(current) / name
+            assert_unlinked(candidate)
+            if candidate.suffix == ".go" or candidate.name in {"go.mod", "go.sum"}:
+                found.add(candidate.relative_to(native_root).as_posix())
+    if found != set(entries):
+        raise DiagnosticError("native source closure file set drifted")
+    for relative, expected in entries.items():
+        if (
+            not isinstance(expected, str)
+            or len(expected) != 64
+            or any(character not in "0123456789abcdef" for character in expected)
+            or not relative
+            or "\\" in relative
+            or relative.startswith("/")
+            or posixpath.normpath(relative) != relative
+            or relative == ".."
+            or relative.startswith("../")
+        ):
+            raise DiagnosticError("native source closure contains an invalid path or hash")
+        source = _inside(native_root / Path(*relative.split("/")), native_root)
+        if _sha256_file(source) != expected:
+            raise DiagnosticError("native source closure content drifted")
+    return {"source_file_count": NATIVE_FILE_COUNT, "source_manifest_sha256": NATIVE_MANIFEST_SHA256}
+
+
+def _git_state() -> dict[str, str]:
+    git = shutil.which("git")
+    if not git:
+        raise DiagnosticError("Git is unavailable for protected state checks")
+    env = dict(os.environ)
+    env["GIT_OPTIONAL_LOCKS"] = "0"
+    head = subprocess.run(
+        [git, "rev-parse", "HEAD"], cwd=ROOT, env=env, check=True,
+        capture_output=True, text=True, timeout=10,
+    ).stdout.strip()
+    index_path = subprocess.run(
+        [git, "rev-parse", "--git-path", "index"], cwd=ROOT, env=env, check=True,
+        capture_output=True, text=True, timeout=10,
+    ).stdout.strip()
+    index = Path(index_path)
+    if not index.is_absolute():
+        index = ROOT / index
+    index = _inside(index, ROOT)
+    return {"HEAD": head, "index_sha256": _sha256_file(index)}
+
