+def _run_owned(
+    argv: list[str], *, command_kind: str, env: Mapping[str, str], log_path: Path,
+    timeout_seconds: int, stdin_path: Path | None = None, stderr_path: Path | None = None,
+) -> dict[str, Any]:
+    started = time.monotonic()
+    process = None
+    timed_out = False
+    error_class = None
+    code = None
+    try:
+        with log_path.open("w", encoding="utf-8", newline="\n") as output:
+            error_context = (
+                stderr_path.open("w", encoding="utf-8", newline="\n")
+                if stderr_path is not None else None
+            )
+            try:
+                error_output = error_context or subprocess.STDOUT
+                if stdin_path is None:
+                    process = start_optimizer_process(
+                        argv, cwd=optimizer_process_workdir(ROOT), env=dict(env),
+                        stdin=subprocess.DEVNULL, stdout=output, stderr=error_output, text=True,
+                    )
+                else:
+                    with stdin_path.open("rb") as input_stream:
+                        process = start_optimizer_process(
+                            argv, cwd=optimizer_process_workdir(ROOT), env=dict(env),
+                            stdin=input_stream, stdout=output, stderr=error_output, text=True,
+                        )
+                try:
+                    code = process.wait(timeout=timeout_seconds)
+                except subprocess.TimeoutExpired:
+                    timed_out = True
+                    process.terminate()
+                    process.wait(timeout=15)
+            finally:
+                if error_context is not None:
+                    error_context.close()
+    except Exception as exc:
+        error_class = type(exc).__name__
+    finally:
+        if process is not None:
+            try:
+                if process.poll() is None:
+                    process.terminate()
+                    process.wait(timeout=15)
+            except Exception as exc:
+                error_class = error_class or type(exc).__name__
+            try:
+                close_optimizer_process_lifetime(process)
+            except Exception as exc:
+                error_class = error_class or type(exc).__name__
+    log = log_path.read_bytes() if log_path.is_file() else b""
+    result = {
+        "command_kind": command_kind,
+        "returncode": code,
+        "timed_out": timed_out,
+        "error_class": error_class,
+        "wall_seconds": round(time.monotonic() - started, 3),
+        "log_bytes": len(log),
+        "log_sha256": hashlib.sha256(log).hexdigest(),
+    }
+    if stderr_path is not None:
+        error_log = stderr_path.read_bytes() if stderr_path.is_file() else b""
+        result["stderr_bytes"] = len(error_log)
+        result["stderr_sha256"] = hashlib.sha256(error_log).hexdigest()
+    return result
+
+
+def _publish_receipt(receipt: dict[str, Any], *, replace_existing: bool) -> None:
+    path = RECEIPT_PATH
+    path.parent.mkdir(parents=True, exist_ok=True)
+    assert_unlinked(path.parent)
+    if path.parent.resolve(strict=True) != EVIDENCE_DIR.resolve(strict=True):
+        raise DiagnosticError("receipt directory drifted")
+    assert_unlinked(path)
+    if replace_existing:
+        existing = json.loads(path.read_text(encoding="utf-8"))
+        if existing.get("lease_id_sha256") != receipt.get("lease_id_sha256"):
+            raise DiagnosticError("refusing to replace another diagnostic receipt")
+    elif path.exists():
+        raise FileExistsError("refusing to overwrite a prior diagnostic receipt")
+    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
+    temporary = Path(temporary_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as stream:
+            json.dump(receipt, stream, sort_keys=True, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        assert_unlinked(temporary)
+        if replace_existing:
+            os.replace(temporary, path)
+        else:
+            os.rename(temporary, path)
+    finally:
+        if temporary.exists():
+            assert_unlinked(temporary)
+            temporary.unlink()
+
