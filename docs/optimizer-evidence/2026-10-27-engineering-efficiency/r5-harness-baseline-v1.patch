+    def test_theory_first_verified_snapshot_uses_reader_thread_and_actual_finish_route(self):
+        gui_thread_id = threading.get_ident()
+        snapshot = output_snapshot()
+        wearers = ("wearer-a", "wearer-b", "wearer-c", "wearer-d")
+        team = {
+            "slots": [
+                {"character": {"name": wearer, "gcsim_character_key": wearer}}
+                for wearer in wearers
+            ]
+        }
+        harness = ArchetypeButtonHarness(None, team, {})
+        state = {
+            "run_started": threading.Event(),
+            "reader_finished": threading.Event(),
+            "finish_requested": threading.Event(),
+            "run_finished": threading.Event(),
+        }
+
+        class IdleTheorySession:
+            def __init__(self, request, *, progress_callback):
+                self.request = request
+                self.progress_callback = progress_callback
+                self.run_mode = "theory"
+                self._finish_requested = threading.Event()
+
+            def run(self):
+                state["worker_thread_id"] = threading.get_ident()
+                state["run_current_qthread_is_gui"] = QThread.currentThread() == _APP.thread()
+                state["run_started"].set()
+
+                def emit_progress_from_reader():
+                    state["reader_thread_id"] = threading.get_ident()
+                    self.progress_callback({
+                        "stage": "simulating_finalists", "sequence": 1,
+                        "completed_work": 1, "total_work": 4,
+                    })
+                    self.progress_callback({
+                        "stage": "searching",
+                        "sequence": 2,
+                        "completed_work": 1,
+                        "total_work": 4,
+                        "theory_snapshot": snapshot,
+                    })
+                    state["reader_finished"].set()
+
+                reader = threading.Thread(target=emit_progress_from_reader, daemon=True)
+                reader.start()
+                reader.join(timeout=1.0)
+                state["reader_joined"] = not reader.is_alive()
+                state["finish_timed_out"] = not self._finish_requested.wait(timeout=1.0)
+                state["run_finished"].set()
+                success = not state["finish_timed_out"]
+                payload = {
+                    "success": success, "status": "success" if success else "failed", "mode": "theory",
+                    "adapter_timings": {"finish_requested": self._finish_requested.is_set()},
+                }
+                if success:
+                    payload["result"] = output_snapshot(2, finished_early=True)
+                else:
+                    payload["error_code"] = "synthetic_finish_timeout"
+                return payload
+
+            def request_finish(self):
+                state["finish_request_thread_id"] = threading.get_ident()
+                state["finish_requested_before_run_end"] = not state["run_finished"].is_set()
+                state["finish_requested"].set()
+                self._finish_requested.set()
+
+        try:
+            with (
+                patch("ui.app_shell._selected_gcsim_engine_id", return_value="synthetic-engine"),
+                patch(
+                    "run_workspace.gcsim.optimizer_go_theory_session.GcsimOptimizerGoTheorySession",
+                    IdleTheorySession,
+                ),
+            ):
+                payload = harness.click_one_mode("theory", "raiden.attack", watchdog_ms=2500)
+            self.assertTrue(
+                payload["success"],
+                f"synthetic worker did not finish from first publication: status={payload.get('status')} "
+                f"error={payload.get('error_code')} state={state} "
+                f"gui={gui_thread_id} "
+                f"stages={[stage for _, stage in harness.progress_events]} "
+                f"receiver_threads={harness.progress_receiver_thread_ids} "
+                f"bridge_gui={harness._theory_progress_bridge.thread() == harness.thread()}",
+            )
+            self.assertTrue(state["run_started"].is_set())
+            self.assertTrue(state["reader_finished"].is_set())
+            self.assertTrue(state["reader_joined"])
+            self.assertNotEqual(state["reader_thread_id"], state["worker_thread_id"])
+            self.assertNotEqual(state["worker_thread_id"], threading.get_ident())
+            self.assertFalse(state["run_current_qthread_is_gui"])
+            self.assertTrue(harness.first_theory_ready_snapshot)
+            self.assertIsNotNone(harness.first_theory_ready_projection)
+            self.assertEqual(harness.first_theory_ready_controls, {
+                "event_stage": "searching", "finalizing_before": True,
+                "finalizing_after": False, "finish_enabled": True,
+            })
+            self.assertTrue(_theory_lifecycle_guard(harness, payload)["theory_session_finish_requested"])
+            self.assertTrue(payload["result"]["finished_early"])
+            self.assertTrue(harness.finish_button_clicked)
+            self.assertFalse(state["finish_timed_out"])
+            self.assertTrue(state["finish_requested_before_run_end"])
+            self.assertEqual(state["finish_request_thread_id"], threading.get_ident())
+            self.assertTrue(state["run_finished"].is_set())
+            self.assertTrue(harness.progress_receiver_thread_ids)
+            self.assertTrue(all(
+                thread_id == threading.get_ident()
+                for thread_id in harness.progress_receiver_thread_ids
+            ))
+            self.assertIs(harness.workspace.update_optimizer_progress.__self__, harness._theory_progress_bridge)
+            self.assertGreaterEqual(harness.first_theory_ready_elapsed_ms, 0)
+            self.assertGreaterEqual(harness.first_theory_ready_projection_ms, 0)
+        finally:
+            harness.shutdown_for_test()
+            harness.close()
+            harness.deleteLater()
+            _APP.processEvents()
