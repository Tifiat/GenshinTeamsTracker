+def verify_chasca_quality(job: Path, result: dict):
+    case = job / "cases/chasca"
+    raw = bounded(case / "unified-quality.json")
+    quality = json.loads(raw)
+    product = quality.get("product_verification_cohort")
+    candidate = quality.get("candidate_raw_search")
+    anchors = quality.get("candidate_anchors")
+    union = quality.get("union_unique_configs")
+    if (quality.get("schema") != "health_unified_chasca_quality_v1"
+            or quality.get("complete") is not True
+            or quality.get("input_manifest_sha256") != k.sha(bounded(case / "candidate/input-manifest.json"))
+            or quality.get("control_request_sha256") != result["control_request_sha256"]
+            or quality.get("candidate_request_sha256") != result["candidate_request_sha256"]
+            or quality.get("candidate_engine_binding_sha256") != json.loads(bounded(job / "candidate/engine-binding.json"))["binding_sha256"]
+            or type(quality.get("candidate_frame_sha256")) is not str
+            or len(quality["candidate_frame_sha256"]) != 64
+            or type(product) is not list or len(product) != 9
+            or type(candidate) is not list or len(candidate) != 9
+            or type(anchors) is not list or not 1 <= len(anchors) <= 2
+            or type(union) is not int or not 1 <= union <= 20
+            or quality.get("ordinary_attempts") != union
+            or quality.get("iterations") != 500 or quality.get("workers") != 4
+            or type(quality.get("parallelism_max")) is not int
+            or not 1 <= quality["parallelism_max"] <= 4
+            or quality.get("global_optimum_proved") is not False
+            or quality.get("no_loss_proved") is not False
+            or type(quality.get("same_config_same_batch")) is not bool
+            or not quality.get("entrypoint_caveat")):
+        raise ValueError("unified_chasca_quality_invalid")
+    for row in [*product, *candidate, *anchors]:
+        if (len(row.get("assignment", [])) != 4 or row.get("iterations") != 500
+                or type(row.get("measured_dps")) not in (int, float)
+                or not math.isfinite(row["measured_dps"])
+                or type(row.get("standard_error")) not in (int, float)
+                or not math.isfinite(row["standard_error"])):
+            raise ValueError("unified_chasca_quality_row_invalid")
+    if (not quality.get("product_verification_best") or not quality.get("candidate_raw_search_best")
+            or (quality["same_config_same_batch"]
+                and quality.get("descriptive_independent_normal_interval_raw_search_best") is not None)):
+        raise ValueError("unified_chasca_quality_best_invalid")
+    result["quality"] = {"result_sha256": k.sha(raw), "product_cohort": 9, "candidate_raw": 9,
+                         "candidate_anchors": len(anchors), "union_unique_configs": union,
+                         "ordinary_calls": union, "ordinary_seconds": quality.get("ordinary_seconds"),
+                         "same_config_same_batch": quality["same_config_same_batch"]}
+
