+        kind_raw = boundary.get("kind")
+        kind = kind_raw if isinstance(kind_raw, str) and kind_raw in _BOUNDARY_KINDS else "unknown"
+        uid = _static_identifier(boundary.get("mechanic_uid"))
+        operation = _static_identifier(boundary.get("operation"))
+        if operation in {"unknown", "global_read"}:
+            reason = boundary.get("reason")
+            if isinstance(reason, str) and reason.startswith(_SHARED_GLOBAL_PREFIX):
+                cause = _static_identifier(reason[len(_SHARED_GLOBAL_PREFIX):])
+                if cause != "unknown":
+                    operation = cause
+                    shared_global_causes += 1
+        if uid == "unknown" or operation == "unknown" or kind == "unknown":
+            invalid_identifiers += 1
+        key = (kind, uid, operation)
+        groups[key] = groups.get(key, 0) + 1
+    ordered = sorted(groups.items(), key=lambda item: (-item[1], item[0]))
+    return {
+        "source_available": True,
+        "observations": sum(groups.values()),
+        "invalid_or_missing_identifiers": invalid_identifiers,
+        "shared_global_static_causes": shared_global_causes,
+        "groups": [{"kind": kind, "mechanic_uid": uid, "operation": operation,
+                    "count": count} for (kind, uid, operation), count in ordered[:64]],
+        "unique_groups_overflow": max(0, len(ordered) - 64),
+        "observations_overflow": sum(count for _, count in ordered[64:]),
+    }
+
+
+def _compact_mechanic_report(run_root: Path, mode: str) -> dict[str, Any]:
+    """Read only known output wrappers and export counts, never source symbols."""
+    names = {"selected": "gob7-result.json", "all_sets": "all-sets-result.json",
+             "theory": "theory-result.json"}
+    candidates: list[Path] = []
+    for run in sorted(run_root.glob("*")) if run_root.exists() else ():
+        if not run.is_dir() or run.is_symlink():
+            continue
+        for parent in (run, run / "verification"):
+            candidate = parent / names[mode]
+            if candidate.is_file() and not candidate.is_symlink():
+                candidates.append(candidate)
+        # The normal adapter stores only product_result in theory-result.json;
+        # the complete CLI wrapper (including mechanics) remains in stdout.
+        for name in ("optimizer-output.json", "mechanic-fallback-result.json"):
+            candidate = run / name
+            if candidate.is_file() and not candidate.is_symlink():
+                candidates.append(candidate)
+    for candidate in sorted(candidates, key=lambda item: item.stat().st_mtime_ns, reverse=True):
+        if candidate.stat().st_size > 8 * 1024 * 1024:
+            continue
+        try:
+            wrapper = json.loads(candidate.read_text(encoding="utf-8"))
+        except (OSError, UnicodeError, json.JSONDecodeError):
+            continue
+        if not isinstance(wrapper, dict):
+            continue
+        product = wrapper.get("product_result")
+        product = product if isinstance(product, dict) else {}
+        report = wrapper.get("mechanics") or wrapper.get("mechanic_report") or product.get("mechanic_report")
+        if not isinstance(report, dict):
+            continue
+        coverage = report.get("static_coverage")
+        rows = [row for row in coverage if isinstance(row, dict)] if isinstance(coverage, list) else []
+        frozen = report.get("frozen_store")
+        omitted = _nonnegative_int(wrapper.get("omitted_uncertain_groups"))
+        if omitted is None:
+            omitted = _nonnegative_int(product.get("omitted_uncertain_groups"))
+        result = {
+            "status": "available", "source_result_sha256": _sha(candidate),
+            "cache_enabled": report.get("cache_enabled") if type(report.get("cache_enabled")) is bool else None,
+            "ir_cache": _counts(report.get("ir_cache"), (
+                "semantic_analyses", "fresh_binds", "memory_hits", "writable_hits",
+                "bundled_hits", "misses", "writes", "repairs", "errors")),
+            "ast_cache": _counts(report.get("ast_cache"), (
+                "Hits", "MemoryHits", "WritableHits", "BundledHits", "Misses",
+                "Repairs", "Writes", "Errors")),
+            "static_coverage": {
+                "mechanics": len(rows),
+                "parsed": sum(row.get("parse") == "parsed" for row in rows),
+                "parse_not_prepared": sum(row.get("parse") == "not_prepared" for row in rows),
+                "linked": sum(row.get("link") == "linked" for row in rows),
+                "link_partial": sum(row.get("link") == "partial" for row in rows),
+                "link_not_prepared": sum(row.get("link") == "not_prepared" for row in rows),
+                "source_only": sum(row.get("semantics") == "source_only" for row in rows),
+                "semantics_partial": sum(row.get("semantics") == "partial" for row in rows),
+                "semantics_unknown": sum(row.get("semantics") == "unknown" for row in rows),
+                "semantics_unavailable": sum(row.get("semantics") == "unavailable" for row in rows),
+                "runtime_unverified": sum(row.get("runtime") == "unverified" for row in rows),
+                "unresolved": sum(_nonnegative_int(row.get("unresolved_count")) or 0 for row in rows),
+            },
+            "bound_boundary_count": _nonnegative_int(report.get("bound_boundary_count")),
+            "bound_boundaries": _compact_boundaries(wrapper, product),
+            "omitted_uncertain_groups": omitted,
+            "frozen_store": _counts(frozen, ("Records", "Overflow", "Errors", "Evicted")),
+        }
+        reason_codes = report.get("reason_codes")
+        if isinstance(reason_codes, dict):
+            groups = reason_codes.get("groups")
+            safe_groups = []
+            for row in groups[:64] if isinstance(groups, list) else ():
+                if not isinstance(row, dict):
+                    continue
+                code = row.get("reason_code")
+                if not isinstance(code, str) or not _SAFE_CODE.fullmatch(code):
+                    continue
+                safe = {"mechanic_uid": _static_identifier(row.get("mechanic_uid")),
+                        "reason_code": code, "operation": _static_identifier(row.get("operation")),
+                        "count": _nonnegative_int(row.get("count"))}
+                site = row.get("consumer_site")
+                if isinstance(site, str) and re.fullmatch(r"rule_[a-z0-9_]+\.go:[1-9][0-9]{0,6}", site):
+                    safe["consumer_site"] = site
+                safe_groups.append(safe)
+            result["reason_codes"] = {"groups": safe_groups, **_counts(reason_codes, (
+                "unique_groups_overflow", "observations_overflow", "unmatched_static_identity"))}
+        status = report.get("diagnostics_status")
+        if status in {"not_configured", "unavailable"}:
+            result["diagnostics_status"] = status
+        elif isinstance(frozen, dict):
+            result["diagnostics_status"] = "recorded"
+        return result
+    return {"status": "unavailable", "known_output_files": len(candidates)}
+
+
+def _write_augmented_receipt(path: Path, result: dict[str, Any]) -> None:
+    """Replace only this gate's compact receipt after managed cleanup."""
+    if not path.is_file():
+        raise FileNotFoundError("base button receipt missing after managed cleanup")
+    assert_unlinked(path)
+    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
+    temporary = Path(name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as stream:
+            json.dump(result, stream, sort_keys=True, indent=2, ensure_ascii=False)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def _installed_identity(project: Path, consumer: Path, store: Path) -> dict[str, str]:
+    """Read-only exact installed runtime gate; no pointer or cache mutation."""
+    from tools.experiments.gcsim.mvp_polish.mechanic_candidate_store import ENGINE_ID
+
+    expected_consumer = (project / "native" / "gcsim_optimizer" / "gtt-optimizer.exe").resolve(strict=True)
+    expected_store = (project / "data" / "gcsim" / "engines").resolve(strict=True)
+    assert_unlinked(expected_consumer)
+    assert_unlinked(expected_store)
+    if consumer != expected_consumer or store != expected_store:
+        raise ValueError("installed runtime must use exact normal consumer and engine store")
+    consumer_sha = _sha(consumer)
+    context = load_active_gcsim_optimizer_engine_context(store_dir=store)
+    if (consumer_sha != INSTALLED_CONSUMER_SHA256 or context.engine_id != ENGINE_ID
+            or context.artifact_sha256 != INSTALLED_ENGINE_SHA256 or not context.trusted
+            or context.issues):
+        raise ValueError("installed runtime identity differs from guarded uptake")
+    return {"consumer_sha256": consumer_sha, "engine_id": context.engine_id,
+            "engine_artifact_sha256": context.artifact_sha256,
+            "engine_binding_sha256": context.binding_sha256}
+
+
+def run_one(*, suite_root: Path, project_root: Path, consumer: Path, engine_store: Path,
+            source_config: Path, case_id: str, mode: str, cache_flag: str,
+            cache_enabled: bool, receipt_output: Path, lease_id: str,
+            test_watchdog_seconds: int = 1200,
+            installed_runtime: bool = False) -> dict[str, Any]:
+    """Run exactly one explicit case and mode; no candidate install or live cache write.
+
+    The suite root is an already-owned outer managed job. Candidate inputs must
+    be staged inside it. Installed mode accepts only the guarded normal runtime.
+    Use a fresh receipt name per call.
+    """
+    # Release any stale disposable SQLite connection cycle before validation or
+    # allocation. A failed Windows cleanup can otherwise keep the job locked.
+    gc.collect()
+    suite = _owned_suite(Path(suite_root))
+    project = Path(project_root).resolve(strict=True)
+    if project != ROOT.resolve(strict=True):
+        raise ValueError("project root differs from this source checkout")
+    if type(installed_runtime) is not bool:
+        raise ValueError("installed_runtime must be explicit boolean")
+    installed_before: dict[str, str] | None = None
+    if installed_runtime:
+        binary = Path(consumer).expanduser().resolve(strict=True)
+        store = Path(engine_store).expanduser().resolve(strict=True)
+        installed_before = _installed_identity(project, binary, store)
+    else:
+        binary = _inside(Path(consumer), suite, file=True)
+        store = _inside(Path(engine_store), suite)
+        if not store.is_dir():
+            raise ValueError("isolated candidate engine store missing")
+    config = Path(source_config).resolve(strict=True)
+    config.relative_to(project / "docs" / "optimizer-evidence")
+    source_body = json.loads(config.read_text(encoding="utf-8"))
+    if config.suffix != ".json" or not isinstance(source_body, dict):
+        raise ValueError("public team source config invalid")
+    if type(cache_enabled) is not bool or mode not in MODES or case_id not in run_case.case_ids():
+        raise ValueError("one supported case, mode, and cache flag required")
+    if (cache_enabled and cache_flag not in {"cold", "reuse"}) or (not cache_enabled and cache_flag != "off"):
+        raise ValueError("cache flag must be cold/reuse when on, off when disabled")
+    case = run_case.load_case(case_id)
+    profile_keys = {str(row["character_key"]).casefold() for row in case.source_profiles}
+    config_keys = {str(row.get("name", "")).casefold()
+                   for row in source_body.get("character_details", ()) if isinstance(row, dict)}
+    if len(profile_keys) != 4 or config_keys != profile_keys:
+        raise ValueError("public source config roster differs from pinned button case")
+    if not lease_id or not 30 <= test_watchdog_seconds <= 3600:
+        raise ValueError("explicit lease and finite test watchdog required")
+    cache = suite / "benchmark-rule-cache"
+    before = _cache_state(cache)
+    if cache_enabled and (cache_flag == "cold") != (before["files"] == 0):
+        raise ValueError("cache flag does not match stable benchmark cache state")
+    if cache_enabled:
+        cache.mkdir(mode=0o700, exist_ok=True)
+    receipt = Path(receipt_output).resolve()
+    receipt.relative_to(project / "docs" / "optimizer-evidence")
+    if receipt.exists():
+        raise FileExistsError("benchmark receipt already exists")
+    if receipt.suffix.casefold() != ".json" or not receipt.parent.is_dir():
+        raise ValueError("dated benchmark receipt directory must already exist")
+    assert_unlinked(receipt)
+    evidence = suite / "private-native-logs" / hashlib.sha256(lease_id.encode()).hexdigest()[:16]
+    if evidence.exists():
+        raise FileExistsError("private native evidence scope already exists")
+    evidence.parent.mkdir(mode=0o700, exist_ok=True)
+    snapshot: dict[str, Any] = {}
+    original_environment = run_case._child_environment
+    original_candidate_resolver = run_case._resolve_candidate_optimizer_binary
+
+    def prepare_receipt(path: str | Path) -> Path:
+        if Path(path).resolve() != receipt or receipt.exists():
+            raise ValueError("benchmark receipt path changed or already exists")
+        return receipt
+
+    def prepare(job: Path) -> Path:
+        snapshot.update(snapshot_active_inventory(job=job, project_root=project, engine_store=store))
+        if installed_runtime:
+            _installed_identity(project, binary, store)
+            return binary
+        candidate = job / "candidate-optimizer.exe"
+        shutil.copy2(binary, candidate)
+        if _sha(candidate) != _sha(binary):
+            raise ValueError("candidate consumer copy hash mismatch")
+        return candidate
+
+    def child_environment(job: Path, **kwargs: Any) -> dict[str, str]:
+        env = original_environment(job, **kwargs)
+        env.update({
+            "GTT_REAL_INVENTORY_SNAPSHOT": str(snapshot["path"]),
+            "GTT_REAL_TEAM_SOURCE_CONFIG": str(config),
+            "GTT_MECHANIC_EXPECTED_TOTAL": str(snapshot["artifact_count"]),
+            "GTT_MECHANIC_EXPECTED_ELIGIBLE": str(snapshot["eligible_count"]),
+            "GTT_MECHANIC_EXPECTED_SETS": str(snapshot["set_domain_count"]),
+            "GTT_MECHANIC_SNAPSHOT_SHA256": snapshot["sha256"],
+            "GTT_MECHANIC_NATIVE_LOG_DIR": str(evidence),
+            "GTT_FROZEN_MECHANICS_DIR": str(suite / "frozen-mechanics"),
+            "GTT_MECHANIC_TEST_CACHE_ENABLED": "1" if cache_enabled else "0",
+            "GTT_MECHANIC_CACHE_ENABLED": "1" if cache_enabled else "0",
+            # Legacy child validates this as positive. The worker wrapper in
+            # install_child_adapter sets the *actual* product timeout to zero.
+            "GTT_MVP_POLISH_PRODUCT_TIMEOUT_MS": "1",
+            "GTT_MVP_POLISH_WORKER_WATCHDOG_MS": str(test_watchdog_seconds * 1000),
+            "GTT_MVP_POLISH_PROCESS_CAP": str(PROCESS_CAP[mode]),
+        })
+        env.pop("GTT_MVP_POLISH_EXPECTED_FIXTURE_SHA256", None)
+        if installed_runtime:
+            env["GTT_RULE_BUNDLED_CACHE_DIR"] = str(project / "native" / "gcsim_optimizer" / "set-rule-cache")
+        else:
+            env["GTT_RULE_BUNDLED_CACHE_DIR"] = str(_inside(suite / "bundled-mechanics", suite))
+        if cache_enabled:
+            env["GTT_RULE_CACHE_DIR"] = str(cache)
+        return env
+
+    def resolve_installed_candidate(candidate: str | Path, job: Path) -> Path:
+        if not installed_runtime:
+            return original_candidate_resolver(candidate, job)
+        resolved = Path(candidate).expanduser().resolve(strict=True)
+        if resolved != binary:
+            raise ValueError("prepared installed consumer path changed")
+        _installed_identity(project, binary, store)
+        return binary
+
+    with ExitStack() as stack:
+        stack.enter_context(patch.object(run_case, "_CHILD_TEST", CHILD_TEST))
+        stack.enter_context(patch.object(run_case, "_child_environment", child_environment))
+        if installed_runtime:
+            stack.enter_context(patch.object(run_case, "_resolve_candidate_optimizer_binary", resolve_installed_candidate))
+        stack.enter_context(patch.object(run_case, "_prepare_receipt_output", prepare_receipt))
+        stack.enter_context(patch.object(run_case, "OUTER_TIMEOUT_MAX_SECONDS", 3600))
+        stack.enter_context(patch.dict(run_case.PROCESS_CAP_BY_MODE, {mode: PROCESS_CAP[mode]}))
+        result = run_case.run_managed_case(
+            case_id=case_id, mode=mode, execute=True, lease_id=lease_id,
+            timeout_seconds=test_watchdog_seconds + 30,
+            engine_store_dir=store, optimizer_binary=binary,
+            prepare_optimizer_binary=prepare,
+            scratch_root=suite / "button-jobs", receipt_output=receipt,
+        )
+    after = _cache_state(cache)
+    if installed_runtime:
+        result["installed_runtime"] = True
+        result["installed_identity"] = installed_before
+        try:
+            installed_after = _installed_identity(project, binary, store)
+            result["installed_identity_after_match"] = installed_after == installed_before
+        except (OSError, ValueError, RuntimeError):
+            result["installed_identity_after_match"] = False
+        if not result["installed_identity_after_match"] and result.get("status") == "success":
+            result["status"] = "failed"
+            result["error_code"] = "installed_runtime_identity_changed"
+    if not cache_enabled and after != before:
+        result["status"] = "failed"
+        result["error_code"] = "disabled_cache_changed_stable_benchmark_cache"
+    result["practical_inventory"] = (
+        {key: value for key, value in snapshot.items() if key != "path"}
+        if snapshot else {"status": "snapshot_unavailable"}
+    )
+    result["benchmark_cache"] = {"flag": cache_flag, "cache_enabled": cache_enabled,
+                                 "before": before, "after": after,
+                                 "bundled_cache": "application_read_only"}
+    result["public_inputs"] = {"source_config_sha256": _sha(config),
+                               "rotation_sha256": case.rotation_sha256,
+                               "source_profiles_sha256": case.source_profiles_sha256,
+                               "result_options": {"set_group_limit": 3, "builds_per_group": 3,
+                                                  "fast_mode": False}}
+    native_manifest = evidence / "manifest.json"
+    if native_manifest.is_file():
+        result["native_log_manifest_sha256"] = _sha(native_manifest)
+        native = json.loads(native_manifest.read_text(encoding="utf-8"))
+        result["native_failure_evidence"] = {
+            "status": native.get("status"),
+            "error_codes": native.get("error_codes", []),
+            "sanitized_error_excerpts": native.get("sanitized_error_excerpts", []),
+            "unclassified_error_text_present": native.get("unclassified_error_text_present", False),
+        }
+    else:
+        result["native_log_status"] = "unavailable_before_cleanup"
+    mechanics_path = evidence / "mechanics.json"
+    if mechanics_path.is_file():
+        result["mechanics"] = json.loads(mechanics_path.read_text(encoding="utf-8"))
+    else:
+        result["mechanics"] = {"status": "unavailable_before_cleanup"}
+    if result.get("status") == "success":
+        if result["mechanics"].get("status") != "available":
+            result["status"] = "failed"
+            result["error_code"] = "mechanic_report_unavailable"
+        elif result["mechanics"].get("cache_enabled") is not cache_enabled:
+            result["status"] = "failed"
+            result["error_code"] = "mechanic_cache_switch_mismatch"
+    result["measurement_scope"] = "full_account_snapshot; one AppShell button; test_watchdog_only"
+    if mode == "theory":
+        case_result = result.get("case") if isinstance(result.get("case"), dict) else {}
+        guard = case_result.get("process_guard") if isinstance(case_result.get("process_guard"), dict) else {}
+        if (result.get("status") == "success" and guard.get("theory_finish_button_clicked") is True
+                and guard.get("theory_first_ready_phase") == "first_light"):
+            result["theory_measurement_label"] = "first_light + Finish"
+        else:
+            result["theory_measurement_label"] = "unverified_terminal_or_no_first_light"
+    else:
+        case_result = result.get("case") if isinstance(result.get("case"), dict) else {}
+        join = case_result.get("config_join") if isinstance(case_result.get("config_join"), dict) else {}
+        if (result.get("status") == "success" and snapshot
+                and join.get("request_artifact_count") != snapshot["eligible_count"]):
+            result["status"] = "failed"
+            result["error_code"] = "request_inventory_count_mismatch"
+    _write_augmented_receipt(receipt, result)
+    return result
+
+
+def install_child_adapter(button: Any) -> ExitStack:
+    """Patch only fixture input and test guards around the production button."""
+    from tools.experiments.gcsim.mvp_polish.real_inventory_adapter import install_real_inventory
+
+    expected_total = int(os.environ["GTT_MECHANIC_EXPECTED_TOTAL"])
+    expected_eligible = int(os.environ["GTT_MECHANIC_EXPECTED_ELIGIBLE"])
+    expected_sets = int(os.environ["GTT_MECHANIC_EXPECTED_SETS"])
+    snapshot = Path(os.environ["GTT_REAL_INVENTORY_SNAPSHOT"]).resolve(strict=True)
+    if _sha(snapshot) != os.environ["GTT_MECHANIC_SNAPSHOT_SHA256"]:
+        raise ValueError("managed full-account snapshot changed")
+    source_config = Path(os.environ["GTT_REAL_TEAM_SOURCE_CONFIG"]).resolve(strict=True)
+    native_dir = Path(os.environ["GTT_MECHANIC_NATIVE_LOG_DIR"]).resolve()
+    cache_raw = os.environ["GTT_MECHANIC_TEST_CACHE_ENABLED"]
+    if cache_raw not in {"0", "1"}:
+        raise ValueError("explicit mechanic cache switch required")
+    cache_enabled = cache_raw == "1"
+    original_create = button._create_admitted_fixture
+    original_record = button._record_real_button_contract
+    original_finalize = button._finalize_test_harness
+    real_worker = button.GcsimBrowserSelectedOptimizerWorker
+
+    def create(root: Path, case: Any, *, store_dir: Path):
+        db, team, rotation, metadata, _ = original_create(root, case, store_dir=store_dir)
+        admission = install_real_inventory(db, team, metadata, list(case.source_profiles), source_config)
+        if (metadata["artifact_domain_count"] != expected_total
+                or metadata["set_domain_count"] != expected_sets):
+            raise ValueError("fixture changed the full account artifact/set domain")
+        metadata["account_snapshot_eligible_count"] = expected_eligible
+        metadata["fixture_sha256"] = _sha(snapshot)
+        metadata["fixture_quality_scope"] = "active_profile_full_account_artifact_snapshot"
+        return db, team, rotation, metadata, admission
+
+    def record(summary: dict, **kwargs: Any):
+        kwargs["expected_artifact_count"] = expected_total
+        return original_record(summary, **kwargs)
+
+    class NoProductTimeout(real_worker):
+        def __init__(self, request: Any):
+            super().__init__(replace(request, product_timeout_ms=0))
+
+    def finalize(*, harness: Any, summary_path: Path, summary: dict, started: float) -> bool:
+        summary.setdefault("process_guard", {})["product_timeout_ms"] = 0
+        summary.setdefault("timings_ms", {})["product_timeout_ms"] = 0
+        joined = original_finalize(harness=harness, summary_path=summary_path,
+                                   summary=summary, started=started)
+        run_root = Path(os.environ["GTT_MVP_POLISH_RUN_ROOT"]).resolve(strict=True)
+        evidence = _capture_native_logs(run_root, native_dir)
+        manifest = native_dir / "manifest.json"
+        manifest.write_text(json.dumps(evidence, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+        manifest.chmod(0o600)
+        mechanics = _compact_mechanic_report(run_root, os.environ["GTT_MVP_POLISH_MODE"])
+        mechanics_path = native_dir / "mechanics.json"
+        mechanics_path.write_text(json.dumps(mechanics, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+        mechanics_path.chmod(0o600)
+        return joined
+
+    stack = ExitStack()
+    stack.enter_context(patch.object(button, "_create_admitted_fixture", create))
+    stack.enter_context(patch.object(button, "_record_real_button_contract", record))
+    stack.enter_context(patch.object(button, "_finalize_test_harness", finalize))
+    stack.enter_context(patch.object(button, "GcsimBrowserSelectedOptimizerWorker", NoProductTimeout))
+    stack.enter_context(patch("ui.app_shell.is_gcsim_mechanic_cache_enabled", return_value=cache_enabled))
+    stack.enter_context(patch.object(button, "button_mode_policy", lambda _mode: {
+        "set_group_limit": 3, "builds_per_group": 3, "fast_mode": False,
+        "expanded_limits": False,
+    }))
+    stack.enter_context(patch.dict(button.PROCESS_CAP_BY_MODE, {
+        mode: PROCESS_CAP[mode] for mode in MODES
+    }))
+    packet_capture = os.environ.get("GTT_MECHANIC_PACKET_CAPTURE_DIR")
+    if packet_capture:
+        from tools.experiments.gcsim.mvp_polish.mechanic_packet_evidence import install_capture
+        stack.enter_context(install_capture(button, Path(packet_capture)))
+    return stack
+
