+def compact_fixture_admission(value):
+    """Only fixed labels, finite bounded integer counts and two SHA identities."""
+    if not isinstance(value, Mapping): return {"schema_kind": SCHEMA, "status": "unknown", "code": "fixture_admission_missing"}
+    status, code = value.get("status"), value.get("code")
+    valid_label = value.get("schema_kind") == SCHEMA and type(status) is str and type(code) is str and ((status == "passed" and code == "fixture_admitted")
+        or (status == "failed" and code in CODES and code != "fixture_admitted"))
+    result = {"schema_kind": SCHEMA, "status": status if valid_label else "unknown",
+              "code": code if valid_label else "fixture_admission_invalid"}
+    for key in COUNT_FIELDS:
+        raw = value.get(key)
+        result[key] = raw if type(raw) is int and 0 <= raw <= 2000 else None
+    for key in SHA_FIELDS:
+        raw = value.get(key); result[key] = raw if _sha(raw) else None
+    if result["status"] == "passed" and any(result[key] is None for key in COUNT_FIELDS + SHA_FIELDS):
+        result.update(status="unknown", code="fixture_admission_invalid")
+    return result
