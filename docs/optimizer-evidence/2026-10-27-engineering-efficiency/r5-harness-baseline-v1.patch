+
+class RetirementError(RuntimeError):
+    """A safe, short failure code; messages never include raw process command lines."""
+
+    def __init__(self, code: str, detail: str = "") -> None:
+        super().__init__(code)
+        self.code = code
+        self.detail = detail
+
+
+class _Stage(NamedTuple):
+    name: str
+    binary_rel: str
+    manifest_rel: str
+    recipe_rel: str
+    backup_sha: str
+    backup_bytes: int
+    candidate_sha: str
+    candidate_bytes: int
+    manifest_kind: str
+    manifest_fields: frozenset[str]
+
+
+def _stage(name: str) -> _Stage:
+    if name == DEFAULT_STAGE:
+        return _Stage(
+            name, ROLLBACK_BINARY_REL, ROLLBACK_MANIFEST_REL, RECIPE_REL,
+            OLD_SHA256, OLD_BYTES, CANDIDATE_SHA256, CANDIDATE_BYTES,
+            ROLLBACK_MANIFEST_KIND, REQUIRED_MANIFEST_FIELDS,
+        )
+    if name == B_STAGE:
+        return _Stage(
+            name, B_ROLLBACK_BINARY_REL, B_ROLLBACK_MANIFEST_REL, B_RECIPE_REL,
+            CANDIDATE_SHA256, CANDIDATE_BYTES, B_CANDIDATE_SHA256, B_CANDIDATE_BYTES,
+            B_ROLLBACK_MANIFEST_KIND, B_REQUIRED_MANIFEST_FIELDS,
+        )
+    raise RetirementError("unknown_stage")
+
+
+def _sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _is_link_or_reparse(path: Path) -> bool:
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return False
+    return stat.S_ISLNK(info.st_mode) or bool(
+        getattr(info, "st_file_attributes", 0)
+        & getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0)
+    )
+
+
+def _safe_path(root: Path, relative: str) -> Path:
+    """Resolve one fixed path and reject traversal, escapes and linked ancestors."""
+    if relative not in _ROLLBACK_PATHS:
+        raise RetirementError("target_not_allowlisted")
+    root_path = Path(os.path.abspath(root))
+    if not root_path.is_dir():
+        raise RetirementError("workspace_root_missing")
+    target = root_path.joinpath(*relative.split("/"))
+    try:
+        for node in (target, *target.parents):
+            if _is_link_or_reparse(node):
+                raise RetirementError("linked_path")
+        resolved_root = root_path.resolve(strict=True)
+        resolved_target = target.resolve(strict=False)
+        resolved_target.relative_to(resolved_root)
+    except RetirementError:
+        raise
+    except (OSError, ValueError):
+        raise RetirementError("unsafe_target") from None
+    return target
+
+
+def _identity_path(root: Path, relative: str) -> Path:
+    if relative not in {CONSUMER_REL, ENGINE_REL, POINTER_REL, RECIPE_REL, B_RECIPE_REL}:
+        raise RetirementError("identity_path_not_allowlisted")
+    root_path = Path(os.path.abspath(root))
+    target = root_path.joinpath(*relative.split("/"))
+    try:
+        for node in (target, *target.parents):
+            if _is_link_or_reparse(node):
+                raise RetirementError("linked_path")
+        target.resolve(strict=True).relative_to(root_path.resolve(strict=True))
+    except RetirementError:
+        raise
+    except (OSError, ValueError):
+        raise RetirementError("identity_file_missing_or_unsafe") from None
+    return target
+
+
+def _exists(path: Path) -> bool:
+    try:
+        path.lstat()
+        return True
+    except FileNotFoundError:
+        return False
+    except OSError:
+        raise RetirementError("target_inspection_failed") from None
+
+
+def _regular_file_info(path: Path) -> tuple[int, str]:
+    try:
+        if _is_link_or_reparse(path):
+            raise RetirementError("linked_path")
+        info = path.lstat()
+        if not stat.S_ISREG(info.st_mode):
+            raise RetirementError("target_not_regular_file")
+        digest = hashlib.sha256()
+        with path.open("rb") as source:
+            for chunk in iter(lambda: source.read(1024 * 1024), b""):
+                digest.update(chunk)
+        return int(info.st_size), digest.hexdigest()
+    except RetirementError:
+        raise
+    except OSError:
+        raise RetirementError("target_read_failed") from None
+
+
+def _read_small_json(path: Path, maximum_bytes: int) -> tuple[dict[str, object], bytes]:
+    try:
+        initial_size = path.lstat().st_size
+    except OSError:
+        raise RetirementError("target_read_failed") from None
+    if initial_size <= 0 or initial_size > maximum_bytes:
+        raise RetirementError("json_size_invalid")
+    size, _ = _regular_file_info(path)
+    if size <= 0 or size > maximum_bytes:
+        raise RetirementError("json_size_invalid")
+    try:
+        with path.open("rb") as source:
+            raw = source.read(maximum_bytes + 1)
+        if len(raw) > maximum_bytes:
+            raise RetirementError("json_size_invalid")
+        value = json.loads(raw.decode("utf-8"))
+    except RetirementError:
+        raise
+    except (OSError, UnicodeError, json.JSONDecodeError):
+        raise RetirementError("json_invalid") from None
+    if not isinstance(value, dict):
+        raise RetirementError("json_shape_invalid")
+    return value, raw
+
+
+def _verify_recipe(root: Path, stage: _Stage) -> str:
+    recipe_path = _identity_path(root, stage.recipe_rel)
+    recipe, raw = _read_small_json(recipe_path, 64 * 1024)
+    rollback = recipe.get("durable_rollback")
+    runtime = recipe.get("runtime_pins")
+    build = recipe.get("build")
+    if not isinstance(rollback, Mapping) or not isinstance(runtime, Mapping) or not isinstance(build, Mapping):
+        raise RetirementError("recipe_shape_invalid")
+    expected_rollback = {
+        "binary_path": stage.binary_rel,
+        "manifest_path": stage.manifest_rel,
+        "binary_sha256": stage.backup_sha,
+        "binary_bytes": stage.backup_bytes,
+        "manifest_maximum_bytes": MANIFEST_MAX_BYTES,
+    }
+    if any(rollback.get(key) != value for key, value in expected_rollback.items()):
+        raise RetirementError("recipe_rollback_drift")
+    manifest_fields = rollback.get("manifest_required_fields")
+    if (not isinstance(manifest_fields, list)
+            or len(manifest_fields) != len(stage.manifest_fields)
+            or any(not isinstance(field, str) for field in manifest_fields)
+            or set(manifest_fields) != stage.manifest_fields):
+        raise RetirementError("recipe_manifest_fields_drift")
+    expected_runtime = {
+        "installed_consumer_path": CONSUMER_REL,
+        "installed_consumer_sha256": stage.backup_sha,
+        "engine_id": ENGINE_ID,
+        "engine_artifact_sha256": ENGINE_SHA256,
+        "active_pointer_path": POINTER_REL,
+        "active_pointer_sha256": POINTER_SHA256,
+    }
+    if any(runtime.get(key) != value for key, value in expected_runtime.items()):
+        raise RetirementError("recipe_runtime_drift")
+    if build.get("output_sha256") != stage.candidate_sha or build.get("output_bytes") != stage.candidate_bytes:
+        raise RetirementError("recipe_candidate_drift")
+    if stage.name == B_STAGE:
+        predecessor = recipe.get("predecessor")
+        expected_predecessor = {
+            "manifest_sha256": PREDECESSOR_MANIFEST_SHA256,
+            "recipe_sha256": PREDECESSOR_RECIPE_SHA256,
+            "manifest_path": ROLLBACK_MANIFEST_REL,
+            "recipe_path": RECIPE_REL,
+        }
+        if not isinstance(predecessor, Mapping) or any(
+                predecessor.get(key) != value for key, value in expected_predecessor.items()):
+            raise RetirementError("recipe_predecessor_drift")
+        if _verify_recipe(root, _stage(DEFAULT_STAGE)) != PREDECESSOR_RECIPE_SHA256:
+            raise RetirementError("predecessor_recipe_hash_mismatch")
+    return _sha256(raw)
+
+
+def _verify_current_runtime(root: Path, stage: _Stage, *, abandoned: bool = False) -> tuple[str, str]:
+    recipe_sha = _verify_recipe(root, stage)
+    from run_workspace.gcsim.optimizer_go_requests import DEFAULT_OPTIMIZER_BINARY
+
+    consumer = _identity_path(root, CONSUMER_REL)
+    default_binary = Path(DEFAULT_OPTIMIZER_BINARY)
+    try:
+        for node in (default_binary, *default_binary.parents):
+            if _is_link_or_reparse(node):
+                raise RetirementError("linked_default_consumer")
+        if default_binary.resolve(strict=True) != consumer.resolve(strict=True):
+            raise RetirementError("default_consumer_path_drift")
+    except RetirementError:
+        raise
+    except (OSError, ValueError):
+        raise RetirementError("default_consumer_path_drift") from None
+
+    consumer_size, consumer_sha = _regular_file_info(consumer)
+    expected_size, expected_sha = (
+        (stage.backup_bytes, stage.backup_sha) if abandoned
+        else (stage.candidate_bytes, stage.candidate_sha)
+    )
+    if stage.name == DEFAULT_STAGE and (consumer_size, consumer_sha) == (B_CANDIDATE_BYTES, B_CANDIDATE_SHA256):
+        successor = _stage(B_STAGE)
+        successor_recipe_sha = _verify_recipe(root, successor)
+        _verify_remaining_pair(root, successor, successor_recipe_sha)
+        _verify_predecessor_manifest(root)
+    elif (consumer_size, consumer_sha) != (expected_size, expected_sha):
+        raise RetirementError("current_consumer_drift")
+    if stage.name == B_STAGE:
+        _verify_remaining_pair(root, _stage(DEFAULT_STAGE), PREDECESSOR_RECIPE_SHA256)
+        _verify_predecessor_manifest(root)
+
+    for relative, expected_size, expected_sha, code in (
+        (ENGINE_REL, None, ENGINE_SHA256, "engine_drift"),
+        (POINTER_REL, None, POINTER_SHA256, "active_pointer_drift"),
+    ):
+        path = _identity_path(root, relative)
+        size, actual_sha = _regular_file_info(path)
+        if actual_sha != expected_sha or (expected_size is not None and size != expected_size):
+            raise RetirementError(code)
+    return recipe_sha, consumer_sha
+
+
+def _validate_manifest(root: Path, recipe_sha: str, stage: _Stage) -> tuple[dict[str, object], int, str]:
+    manifest_path = _safe_path(root, stage.manifest_rel)
+    value, raw = _read_small_json(manifest_path, MANIFEST_MAX_BYTES)
+    missing = stage.manifest_fields - value.keys()
+    if missing:
+        raise RetirementError("manifest_fields_missing")
+    if (value.get("schema_version") != 1 or isinstance(value.get("schema_version"), bool)
+            or value.get("kind") != stage.manifest_kind
+            or not isinstance(value.get("owner"), str) or not value.get("owner", "").strip()):
+        raise RetirementError("manifest_identity_invalid")
+    expected = {
+        "backup_path": stage.binary_rel,
+        "backup_sha256": stage.backup_sha,
+        "backup_bytes": stage.backup_bytes,
+        "previous_consumer_sha256": stage.backup_sha,
+        "candidate_sha256": stage.candidate_sha,
+        "engine_id": ENGINE_ID,
+        "engine_artifact_sha256": ENGINE_SHA256,
+        "active_pointer_sha256": POINTER_SHA256,
+        "recipe_sha256": recipe_sha,
+        "retirement_gate": RETIREMENT_GATE,
+    }
+    if stage.name == B_STAGE:
+        expected.update({
+            "predecessor_manifest_sha256": PREDECESSOR_MANIFEST_SHA256,
+            "predecessor_recipe_sha256": PREDECESSOR_RECIPE_SHA256,
+        })
+    if any(value.get(key) != expected_value for key, expected_value in expected.items()):
+        raise RetirementError("manifest_identity_mismatch")
+    if (isinstance(value.get("backup_bytes"), bool)
+            or not isinstance(value.get("backup_bytes"), int)):
+        raise RetirementError("manifest_size_invalid")
+    for key in ("comparison_result_sha256", "review_receipt_sha256"):
+        digest = value.get(key)
+        if not isinstance(digest, str) or not _SHA256.fullmatch(digest):
+            raise RetirementError("manifest_receipt_hash_invalid")
+    return value, len(raw), _sha256(raw)
+
+
+def _verify_predecessor_manifest(root: Path) -> None:
+    path = _safe_path(root, ROLLBACK_MANIFEST_REL)
+    if _exists(path):
+        _, raw = _read_small_json(path, MANIFEST_MAX_BYTES)
+        if _sha256(raw) != PREDECESSOR_MANIFEST_SHA256:
+            raise RetirementError("predecessor_manifest_hash_mismatch")
+
+
+def _verify_remaining_pair(root: Path, stage: _Stage, recipe_sha: str) -> None:
+    """Check any retained counterpart files without requiring retired files."""
+    binary = _safe_path(root, stage.binary_rel)
+    manifest = _safe_path(root, stage.manifest_rel)
+    if _exists(manifest):
+        _validate_manifest(root, recipe_sha, stage)
+    if _exists(binary) and _regular_file_info(binary) != (stage.backup_bytes, stage.backup_sha):
+        raise RetirementError("backup_binary_mismatch")
+
+
+def _inspect_pair(
+    root: Path, stage: _Stage, *, abandoned: bool = False,
+) -> tuple[dict[str, object] | None, dict[str, object]]:
+    disposition = {"disposition": "abandoned"} if abandoned else {}
+    binary = _safe_path(root, stage.binary_rel)
+    manifest = _safe_path(root, stage.manifest_rel)
+    binary_exists = _exists(binary)
+    manifest_exists = _exists(manifest)
+    if not binary_exists and not manifest_exists:
+        return None, {"status": "already_absent", "stage": stage.name, "deleted": [], **disposition}
+    if binary_exists != manifest_exists:
+        raise RetirementError("partial_pair")
+
+    recipe_sha, consumer_sha = _verify_current_runtime(root, stage, abandoned=abandoned)
+    manifest_value, manifest_bytes, manifest_sha = _validate_manifest(root, recipe_sha, stage)
+    binary_bytes, binary_sha = _regular_file_info(binary)
+    if binary_bytes != stage.backup_bytes or binary_sha != stage.backup_sha:
+        raise RetirementError("backup_binary_mismatch")
+    return manifest_value, {
+        "status": "preview_only",
+        "stage": stage.name,
+        **disposition,
+        "deleted": [],
+        "targets": [
+            {"path": stage.manifest_rel, "bytes": manifest_bytes, "sha256": manifest_sha},
+            {"path": stage.binary_rel, "bytes": binary_bytes, "sha256": binary_sha},
+        ],
+        "runtime": {
+            "consumer_sha256": consumer_sha,
+            "engine_id": ENGINE_ID,
+            "engine_sha256": ENGINE_SHA256,
+            "active_pointer_sha256": POINTER_SHA256,
+            "recipe_sha256": recipe_sha,
+        },
+    }
+
+
+def _default_process_probe(root: Path) -> Sequence[str]:
+    """Use known build/backend process names and this app's Python entrypoint."""
+    if os.name != "nt":
+        raise RetirementError("process_probe_unavailable")
+    script = r"""
+$ErrorActionPreference = 'Stop'
+$root = [System.IO.Path]::GetFullPath($env:GTT_RETIRE_PROJECT_ROOT).TrimEnd([char]'\')
+$busy = [System.Collections.Generic.List[string]]::new()
+$processNames = @('go','compile','link','gtt-optimizer','gtt-gcsim','GenshinTeamsTracker')
+foreach ($p in @(
+    Get-Process -Name $processNames -ErrorAction SilentlyContinue
+)) {
+    $busy.Add([string]$p.ProcessName)
+}
+$python = @(
+    Get-CimInstance -ClassName Win32_Process -Filter "Name='python.exe' OR Name='pythonw.exe'" -ErrorAction Stop
+)
+foreach ($p in $python) {
+    $cmd = [string]$p.CommandLine
+    if ($cmd -and $cmd.IndexOf($root, [System.StringComparison]::OrdinalIgnoreCase) -ge 0 -and
+        $cmd -match '(?i)main\.py|ui\.app_shell_smoke') {
+        $busy.Add('project-app-python')
+    }
+}
+ConvertTo-Json -InputObject ([ordered]@{ busy = @($busy | Sort-Object -Unique) }) -Compress
+"""
+    environment = dict(os.environ)
+    environment["GTT_RETIRE_PROJECT_ROOT"] = str(Path(root).resolve(strict=True))
+    try:
+        completed = subprocess.run(
+            ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script],
+            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+            text=True, encoding="utf-8", errors="replace", timeout=20, check=False,
+            env=environment, creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        raise RetirementError("process_probe_failed") from None
+    if completed.returncode != 0:
+        raise RetirementError("process_probe_failed")
+    try:
+        result = json.loads(completed.stdout)
+    except json.JSONDecodeError:
+        raise RetirementError("process_probe_result_invalid") from None
+    if not isinstance(result, dict):
+        raise RetirementError("process_probe_result_invalid")
+    busy = result.get("busy", [])
+    if isinstance(busy, str):
+        busy = [busy]
+    if not isinstance(busy, list) or any(not isinstance(name, str) for name in busy):
+        raise RetirementError("process_probe_result_invalid")
+    return tuple(busy[:24])
+
+
+def _require_idle(root: Path, process_probe: ProcessProbe) -> None:
+    busy = tuple(process_probe(root))
+    if busy:
+        names = ", ".join(name[:80] for name in busy[:8])
+        raise RetirementError("active_project_process", names)
+
+
+@contextmanager
+def _project_mutation_locks(root: Path) -> Iterator[None]:
+    """Match the runtime installer lock order; preview intentionally skips both."""
+    from run_workspace.profile_control import profile_operation_lock, profile_supervisor_lock
+
+    with ExitStack() as locks:
+        try:
+            locks.enter_context(profile_supervisor_lock(project_root=root))
+            locks.enter_context(profile_operation_lock(project_root=root))
+        except (OSError, RuntimeError):
+            raise RetirementError("project_operation_busy") from None
+        yield
+
+
+def retire_rollback(
+    root: Path = ROOT,
+    *,
+    stage: str = DEFAULT_STAGE,
+    abandoned: bool = False,
+    execute: bool = False,
+    accepted: bool = False,
+    process_probe: ProcessProbe = _default_process_probe,
+) -> dict[str, object]:
+    """Preview by default; delete only the exact validated pair with both flags."""
+    selected_stage = _stage(stage)
+    if abandoned and selected_stage.name != B_STAGE:
+        raise RetirementError("abandonment_not_supported")
+    if execute != accepted:
+        raise RetirementError("explicit_consent_required")
+    root = Path(root)
+    if not execute:
+        manifest_value, result = _inspect_pair(root, selected_stage, abandoned=abandoned)
+        if manifest_value is None:
+            return result
+        _require_idle(root, process_probe)
+        result["process_state"] = "idle"
+        result["message"] = "Preview only; no files were deleted."
+        return result
+
+    with _project_mutation_locks(root):
+        manifest_value, result = _inspect_pair(root, selected_stage, abandoned=abandoned)
+        if manifest_value is None:
+            return result
+        deleted: list[str] = []
+        # Remove the manifest first so rollback bytes remain recoverable if
+        # the second idle check blocks or the process is interrupted.
+        for relative in (selected_stage.manifest_rel, selected_stage.binary_rel):
+            try:
+                recipe_sha, consumer_sha = _verify_current_runtime(root, selected_stage, abandoned=abandoned)
+                if (recipe_sha != result["runtime"]["recipe_sha256"]
+                        or consumer_sha != result["runtime"]["consumer_sha256"]):
+                    raise RetirementError("runtime_changed_before_delete")
+                target = _safe_path(root, relative)
+                if relative == selected_stage.manifest_rel:
+                    _, size, digest = _validate_manifest(root, recipe_sha, selected_stage)
+                    expected_size = next(row["bytes"] for row in result["targets"] if row["path"] == relative)
+                    expected_digest = next(row["sha256"] for row in result["targets"] if row["path"] == relative)
+                else:
+                    size, digest = _regular_file_info(target)
+                    expected_size, expected_digest = selected_stage.backup_bytes, selected_stage.backup_sha
+                if size != expected_size or digest != expected_digest:
+                    raise RetirementError("pair_changed_before_delete")
+                _require_idle(root, process_probe)
+                target.unlink()
+                deleted.append(relative)
+                if _exists(target):
+                    raise RetirementError("delete_verification_failed")
+            except RetirementError as error:
+                if deleted:
+                    return {
+                        **result, "status": "partial_retirement", "deleted": deleted,
+                        "error_code": error.code, "detail": error.detail,
+                    }
+                raise
+            except OSError:
+                if deleted:
+                    return {
+                        **result, "status": "partial_retirement", "deleted": deleted,
+                        "error_code": "delete_failed", "detail": "",
+                    }
+                raise RetirementError("delete_failed") from None
+
+        return {
+            **result, "status": "retired", "deleted": deleted,
+            "process_checks": 2, "message": "Only the validated rollback pair was removed.",
+        }
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--stage", choices=(DEFAULT_STAGE, B_STAGE), default=DEFAULT_STAGE,
+        help="Select one fixed rollback pair; the original native-performance pair is the default.",
+    )
+    parser.add_argument(
+        "--abandoned", action="store_true",
+        help="B stage only: retire a failed-install pair against the exact restored ae4d consumer.",
+    )
+    parser.add_argument(
+        "--execute", action="store_true",
+        help="Delete the validated pair; requires --accepted as a separate explicit flag.",
+    )
+    parser.add_argument(
+        "--accepted", action="store_true",
+        help="Confirm manual acceptance/abandonment of this rollback pair for retirement.",
+    )
+    args = parser.parse_args(argv)
+    try:
+        result = retire_rollback(
+            stage=args.stage, abandoned=args.abandoned, execute=args.execute, accepted=args.accepted,
+        )
+    except RetirementError as error:
+        result = {"status": "blocked", "error_code": error.code, "detail": error.detail}
+    print(json.dumps(result, ensure_ascii=True, sort_keys=True, separators=(",", ":")))
+    return 0 if result.get("status") in {"already_absent", "preview_only", "retired"} else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
