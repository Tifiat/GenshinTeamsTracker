+                                                   "candidate_cohort": len(candidate),
+                                                   "union_unique_configs": union,
+                                                   "ordinary_calls": union,
+                                                   "ordinary_seconds": quality.get("ordinary_seconds"),
+                                                   "same_config_same_batch": quality["same_config_same_batch"]}
