+"""One control and one instrumented search-only saved Tigh V2 replay."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import sys
+import time
+
+sys.dont_write_bytecode = True
+from tools.experiments.gcsim.mvp_polish import preparation_v2_measure as producer
+from tools.experiments.gcsim.mvp_polish import dense_node_install as installed
+
+dense, scope = producer.dense, producer.scope
+ROOT, NATIVE, EVIDENCE = producer.ROOT, producer.NATIVE, producer.EVIDENCE
+gate = scope.accepted.K.gate
+PREFIX, LIMITS = producer.PREFIX, producer.LIMITS
+FREEZE = EVIDENCE / (PREFIX + "-freeze.json")
+RESULT = EVIDENCE / (PREFIX + "-result.json")
+
+
+def require(ok, code):
+    if not ok:
+        raise ValueError(code)
+
+
+def pins():
+    paths = [Path(__file__), Path(producer.__file__), producer.HELPER,
+        Path(dense.__file__), Path(scope.__file__), Path(dense.prior.__file__),
+        NATIVE / "go.mod", NATIVE / "go.sum", Path(gate.__file__),
+        Path(gate.owned.__file__), Path(gate.common.__file__),
+        Path(gate.lifecycle.__file__), Path(gate.managed.__file__),
+        Path(gate.io.__file__), Path(gate.retirement.__file__),
+        EVIDENCE / "candidate-preservation-tighnari-v2-result.json",
+        EVIDENCE / "candidate-preservation-tighnari-v2-freeze.json",
+        EVIDENCE / "dense-node-install-v1-result.json",
+        NATIVE / "internal/allsets/neutral_profile_test.go"]
+    return {p.relative_to(ROOT).as_posix(): installed.sha_file(p) for p in paths}
+
+
+def exclusions(base):
+    physical = scope.accepted.K.old.native_map()
+    expected = dense.physical_exclusions()
+    expected["internal/engineclient/dense_node_lookup.go"] = installed.sha_file(NATIVE / "internal/engineclient/dense_node_lookup.go")
+    require(set(physical) - set(base) == set(expected), "preparation_unknown_physical_source")
+    require(all(physical.get(k) == v for k, v in expected.items()), "preparation_exclusion_drift")
+    return expected
+
+
+def prepare():
+    require(not FREEZE.exists() and not RESULT.exists(), "preparation_already_prepared")
+    inputs = producer.inputs()
+    overlays = {a: producer.overlay(a == "instrumented") for a in ("control", "instrumented")}
+    base = dense.base_images()
+    plan = {"schema": "preparation_v2_measure_plan_v1", "limits": LIMITS,
+        "source_pins": pins(), "inputs": inputs,
+        "base_map_sha256": scope.sha(dense.canonical(dense.image_hashes(base))),
+        "arms": {a: {"image_map_sha256": o["image_map_sha256"], "extra_map_sha256": o["extra_map_sha256"]} for a, o in overlays.items()},
+        "physical_exclusions": exclusions(base),
+        "protected_before": scope.accepted.K.protected(), "native_before": scope.accepted.K.old.native_map(),
+        "dirty_before": installed.dirty_map(), "consumer_sha256": installed.sha_file(installed.CONSUMER),
+        "engine_sha256": scope.ENGINE_SHA, "python_sha256": installed.sha_file(Path(sys.executable)),
+        "go_sha256": installed.sha_file(gate.owned.GO_EXE),
+        "timers": {"exclusive": ["binding_model_and_structure", "utility_gradient_and_early_guide", "reduced_scoring", "full_scoring", "package_seed_and_legal_proposal", "bookkeeping_other_including_unisolated_observer_cost"],
+            "nested": ["bind_inclusive", "candidate_constructor_inclusive", "solver_construction", "early_utility_inclusive", "existing_candidate_metrics", "whole_proposal", "whole_RunNeutral"],
+            "cpu": "Go CPU profile; phase=proposal_preparation goroutine label, sampled not wall attribution",
+            "repeat_scope": "complete neutralCandidateKey at coordinator candidateSearch boundary, stable request/engine/formula/policy frame digest; no global scalar-duplicate claim",
+            "overhead": "one exact observer-free control, one instrumented replay; elapsed deltas descriptive single pair; key-map cost separately timed; JSON/export after timed search"},
+        "commands": ["go -C <native> test -c -p=1 -mod=readonly -buildvcs=false -overlay=<arm-overlay> -o <arm.test.exe> ./internal/allsets",
+            "<arm.test.exe> -test.v -test.run=^TestPreparationSavedV2$ -test.timeout=230s",
+            "go tool pprof -top -nodecount=40 -tagfocus=phase=proposal_preparation <instrumented.test.exe> <preparation-cpu.pprof>"],
+        "no_engine_guard": "both arms panic in runOrdinary/runCompact; policy call replaced only by exact archived ParseOrdinaryResult+ValidateOrdinaryResultIdentity; no fallback; original recorded wall budget used only as logical policy clock",
+        "version_scope": "accepted361 exact preparation core matching V2; AH dense decoder differs only before decoded-input replay; research final-selection is outside replay"}
+    scope.cases.write_once(FREEZE, plan)
+    return {"freeze": str(FREEZE), "sha256": installed.sha_file(FREEZE), "inputs": len(inputs["files"]), "arms": plan["arms"]}
+
+
+def stage(job, plan, arm):
+    o = producer.overlay(arm == "instrumented")
+    require({k: o[k] for k in ("image_map_sha256", "extra_map_sha256")} == plan["arms"][arm], "preparation_overlay_drift")
+    replace = {}
+    for name, raw in {**o["images"], **o["extras"]}.items():
+        target = job / (arm + "-source") / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(raw)
+        require(installed.sha_file(target) == scope.sha(raw), "preparation_source_write")
+        replace[str(NATIVE / name)] = str(target)
+    replace.update({str(NATIVE / name): "" for name in plan["physical_exclusions"]})
+    path = job / (arm + "-overlay.json")
+    scope.cases.write_once(path, {"Replace": replace})
+    require(json.loads(dense.read(path))["Replace"] == replace, "preparation_overlay_write")
+    return path
+
+
+def scrub(value):
+    if isinstance(value, list):
+        return [scrub(v) for v in value]
+    if isinstance(value, dict):
+        return {k: scrub(v) for k, v in value.items() if not any(t in k.lower() for t in ("seconds", "nanos", "elapsed", "_ms"))}
+    return value
+
+
+def parity(outputs, original):
+    keys = ("search_work", "search_expansions", "neutral_cycles", "raw_finalists", "initial", "selected", "leader", "boundaries",
+            "neutral_stabilization", "neutral_package_joint", "neutral_model", "adaptive_policy", "queued", "unqueued", "pending",
+            "reservation_deferred", "skipped_duplicate", "guides", "stop_reason", "saved_policy_calls", "engine_process_calls", "provider_calls")
+    comparisons = {k: scrub(outputs["control"][k]) == scrub(outputs["instrumented"][k]) for k in keys}
+    require(all(comparisons.values()), "preparation_control_instrumented_parity")
+    mapping = {"search_work": "search_work", "search_expansions": "search_expansions", "neutral_cycles": "neutral_cycles",
+        "boundaries": "effect_boundaries", "neutral_stabilization": "neutral_stabilization", "neutral_package_joint": "neutral_package_joint",
+        "neutral_model": "neutral_model", "adaptive_policy": "adaptive_policy", "queued": "queued", "unqueued": "unqueued_across_guides",
+        "pending": "pending", "reservation_deferred": "reservation_deferred", "skipped_duplicate": "skipped_duplicate", "guides": "guides", "stop_reason": "search_stop_reason"}
+    historical = {k: scrub(outputs["control"][k]) == scrub(original[v]) for k, v in mapping.items()}
+    policy_clock = {}
+    for arm, output in outputs.items():
+        actual, prior = output["adaptive_policy"], original["adaptive_policy"]
+        policy_clock[arm] = (actual["engine_wall_ms"] == prior["engine_wall_ms"] and actual["engine_ms"] == prior["engine_ms"]
+            and [(s["elapsed_ms"], s["engine_elapsed_ms"]) for s in actual["samples"]]
+             == [(s["elapsed_ms"], s["engine_elapsed_ms"]) for s in prior["samples"]])
+    require(all(policy_clock.values()), "preparation_logical_policy_clock_parity")
+    raw = original["neutral_search_finalists"]["rows"]
+    expected = [{"assignment": v["score"]["assignment"], "formula_dps": v["score"]["dps"], "packages": v["packages"],
+                 "context_sha256": v["context_sha256"], "rendered_config_sha256": v["config_sha256"], "score_source": v["score"]["source"]} for v in raw]
+    historical["raw_finalists_full20_formulas_order_rendered_configs"] = len(raw) == len(outputs["control"]["raw_finalists"]) and all(
+        all(actual[k] == v for k, v in row.items()) for actual, row in zip(outputs["control"]["raw_finalists"], expected))
+    require(all(historical.values()), "preparation_historical_v2_parity")
+    return {"control_instrumented": comparisons, "historical_v2": historical, "logical_policy_clock": policy_clock, "raw_finalists": len(raw)}
+
+
+def partition(output):
+    blocks = output["observer"]["blocks"]
+    require(len(blocks) == 8 and [(b["Cycle"], b["Actor"]) for b in blocks] == [(c, a) for c in (1, 2) for a in range(4)], "preparation_eight_blocks")
+    parts, totals = [], {}
+    for b in blocks:
+        n, m = b["Nanos"], b["Metrics"]
+        initial = m.get("InitialProgramNanos", 0)
+        buckets = {
+            "binding_model_and_structure": n.get("bind_inclusive", 0) - n.get("bind_full_score", 0) + n.get("solver_construction", 0) + n.get("candidate_constructor_inclusive", 0) - initial + n.get("post_screen_view", 0),
+            "utility_gradient_and_early_guide": m.get("ValueGradientNanos", 0) + n.get("early_utility_inclusive", 0),
+            "reduced_scoring": initial + m.get("PointProgramNanos", 0),
+            "full_scoring": n.get("search_full_score", 0) + n.get("bind_full_score", 0),
+            "package_seed_and_legal_proposal": n.get("package_seed_legal", 0) + sum(m.get(k, 0) for k in ("LinearAssignmentNanos", "LinearPlanNanos", "LinearPlanAssignmentNanos")),
+        }
+        buckets["bookkeeping_other_including_unisolated_observer_cost"] = b["WallNanos"] - sum(buckets.values())
+        require(all(v >= 0 for v in buckets.values()), "preparation_negative_exclusive_bucket")
+        parts.append({"cycle": b["Cycle"], "actor": b["Actor"], "whole_seconds": b["WallNanos"] / 1e9, "exclusive_seconds": {k: v / 1e9 for k, v in buckets.items()}})
+        for k, v in buckets.items(): totals[k] = totals.get(k, 0) + v / 1e9
+    return {"blocks": parts, "exclusive_seconds": totals, "whole_block_seconds": sum(b["WallNanos"] for b in blocks) / 1e9,
+            "proposal_seconds": output["proposal_seconds"], "inclusive_metrics_separate": [b["Metrics"] for b in blocks]}
+
+
+def execute(expected):
+    require(installed.sha_file(FREEZE) == expected, "preparation_freeze_sha")
+    plan = json.loads(dense.read(FREEZE))
+    require(plan["source_pins"] == pins() and plan["limits"] == LIMITS and not RESULT.exists(), "preparation_plan_or_output_drift")
+    require(installed.sha_file(Path(sys.executable)) == plan["python_sha256"] and installed.sha_file(gate.owned.GO_EXE) == plan["go_sha256"], "preparation_tool_drift")
+    require(not tuple(gate.managed.MANAGED_ROOT.glob("job-*")) and not gate.retirement._default_process_probe(ROOT), "preparation_busy")
+    protected, native = plan["protected_before"], plan["native_before"]
+    require(scope.accepted.K.protected() == protected and scope.accepted.K.old.native_map() == native, "preparation_before_drift")
+    started = time.monotonic()
+    record = {"schema": "preparation_v2_measure_result_v1", "status": "started", "errors": [], "freeze_sha256": expected,
+              "limits": LIMITS, "commands": {}, "builds": 0, "replays": 0, "engine_calls": 0, "installs": 0, "exports": {}}
+    active = [None]
+    with RESULT.open("xb") as stream:
+        def save(): gate.io._save(stream, record)
+
+        def export():
+            job = active[0]
+            if job is not None:
+                paths = [p for p in job.iterdir() if p.is_file() and (p.suffix in {".log", ".pprof"} or p.name.endswith("-output.json") or p.name.endswith("-overlay.json") or p.name in {"inputs.json", "fixed-engine-binding.json"})]
+                paths += list((job / "instrumented").glob("*.json")) if (job / "instrumented").is_dir() else []
+                require(sum(p.stat().st_size for p in paths) <= LIMITS["retained_bytes"], "preparation_export_budget")
+                writer = dense.function_view(scope.accepted.complete.prior.retained._write_gzip_once, MAX_RAW_EXPORT_BYTES=32 << 20)
+                for path in paths:
+                    raw = dense.read(path, 32 << 20)
+                    key = path.relative_to(job).as_posix()
+                    token = scope.sha((key + scope.sha(raw)).encode())[:24]
+                    if token not in record["exports"]:
+                        record["exports"][token] = {"relative_path": key, "archive": writer(raw, EVIDENCE / (PREFIX + "__" + token + ".gz"))}
+            save()
+
+        def body(job):
+            active[0] = job
+            binding = dense.prior.stage_fixed_binding(job)
+            initial_binding = dense.read(binding)
+            manifest = {"Files": {}, "frame_sha256": scope.sha(dense.canonical({"inputs": plan["inputs"], "source_map": plan["base_map_sha256"]}))}
+            for name, item in plan["inputs"]["files"].items():
+                raw = producer.archived({"archive": item})
+                target = job / "saved-inputs" / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes(raw)
+                manifest["Files"][name] = {"Path": str(target), "SHA256": item["raw_sha256"], "Bytes": item["raw_bytes"]}
+            scope.cases.write_once(job / "inputs.json", manifest)
+            env, _ = gate.common._environment(job)
+            for n in ("gocache", "gotmp", "temp"): (job / n).mkdir(exist_ok=True)
+            env.update(GOMAXPROCS="1", GOMEMLIMIT="2GiB", GTT_SCRATCH_DIR=str(job))
+
+            def command(label, argv, seconds, extra=None):
+                require(time.monotonic() - started + seconds + LIMITS["cleanup_reserve_seconds"] <= LIMITS["whole_seconds"], "preparation_remaining_budget")
+                require(gate.common._tree_bytes(job) <= LIMITS["scratch_bytes"], "preparation_scratch_budget")
+                require(scope.accepted.K.protected() == protected and scope.accepted.K.old.native_map() == native and pins() == plan["source_pins"], "preparation_precommand_drift")
+                runner = dense.function_view(gate.owned._run_owned, optimizer_process_workdir=lambda _: NATIVE)
+                row = runner([str(v) for v in argv], command_kind="preparation-v2-" + label, env={**env, **(extra or {})}, log_path=job / (label + ".log"), timeout_seconds=seconds)
+                record["commands"][label] = row
+                export()
+                require(gate.command_passed(row), "preparation_command_failed_" + label)
+
+            binaries = {}
+            outputs = {}
+            for arm in ("control", "instrumented"):
+                overlay = stage(job, plan, arm)
+                binaries[arm] = job / (arm + ".test.exe")
+                record["builds"] += 1
+                command(arm + "-build", [gate.owned.GO_EXE, "-C", NATIVE, "test", "-c", "-p=1", "-mod=readonly", "-buildvcs=false", "-overlay=" + str(overlay), "-o", binaries[arm], "./internal/allsets"], LIMITS["build_seconds"])
+                record["replays"] += 1
+                command(arm + "-replay", [binaries[arm], "-test.v", "-test.run=^TestPreparationSavedV2$", "-test.timeout=230s"], LIMITS["replay_seconds"], {"GTT_PREPARATION_ARM": arm})
+                outputs[arm] = json.loads(dense.read(job / (arm + "-output.json"), 32 << 20))
+            original = json.loads(dense.read(job / "saved-inputs/verification/all-sets-result.json"))
+            record["parity"] = parity(outputs, original)
+            record["partition"] = partition(outputs["instrumented"])
+            record["overhead"] = {"control_run_seconds": outputs["control"]["run_seconds"], "instrumented_run_seconds": outputs["instrumented"]["run_seconds"],
+                "control_proposal_seconds": outputs["control"]["proposal_seconds"], "instrumented_proposal_seconds": outputs["instrumented"]["proposal_seconds"],
+                "key_map_overhead_nanos": outputs["instrumented"]["observer"]["key_map_overhead_nanos"],
+                "interpretation": "single ordered pair; observer+CPU profile+machine variation, not a precise correction factor"}
+            for tag, args in (("cpu-top", ["-top", "-nodecount=40", "-tagfocus=phase=proposal_preparation"]), ("cpu-tags", ["-tags"])):
+                command(tag, [gate.owned.GO_EXE, "tool", "pprof", *args, binaries["instrumented"], job / "preparation-cpu.pprof"], 30)
+            record["key_summary"] = {k: v for k, v in outputs["instrumented"]["observer"].items() if k not in {"blocks", "candidate_search_keys"}}
+            store = scope.accepted.engine_store.GcsimEngineStore(ROOT / "data/gcsim/engines")
+            context, wire = scope.accepted.runtime.prepare_v4.candidate_binding(store.engines_dir / scope.accepted.runtime.ENGINE_ID)
+            require(context.artifact_sha256 == scope.ENGINE_SHA and dense.canonical(wire) == dense.canonical(json.loads(initial_binding)), "preparation_engine_binding_drift")
+            record["status"] = "measured_cleanup_pending"
+            export()
+        try:
+            gate.run_owned_body(None, record, export, body)
+        except Exception as exc:
+            record["errors"].append(type(exc).__name__ + ": " + str(exc))
+        finally:
+            record["whole_wall_seconds"] = time.monotonic() - started
+            current = installed.dirty_map()
+            record["preservation_exact"] = scope.accepted.K.protected() == protected and scope.accepted.K.old.native_map() == native and pins() == plan["source_pins"] and all(current.get(n, "absent") == v for n, v in plan["dirty_before"].items())
+            record["managed_jobs_remaining"] = len(tuple(gate.managed.MANAGED_ROOT.glob("job-*")))
+            record["optimizer_processes_remaining"] = bool(gate.retirement._default_process_probe(ROOT))
+            record["status"] = "complete_uninstalled" if record.get("parity") and record.get("partition") and not record["errors"] and record.get("cleanup_status") == "confirmed" and record["preservation_exact"] and not record["managed_jobs_remaining"] and not record["optimizer_processes_remaining"] else "failed"
+            save()
+    return record
+
+
+def main():
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument("--prepare", action="store_true")
+    parser.add_argument("--freeze-sha")
+    args = parser.parse_args()
+    if args.prepare:
+        r = prepare()
+    else:
+        require(bool(args.freeze_sha), "preparation_reviewed_freeze_required")
+        r = execute(args.freeze_sha)
+    print(json.dumps({k: r.get(k) for k in ("freeze", "sha256", "status", "errors", "whole_wall_seconds")}, sort_keys=True))
+    if r.get("status") == "failed": raise SystemExit(2)
+
+
+if __name__ == "__main__": main()
