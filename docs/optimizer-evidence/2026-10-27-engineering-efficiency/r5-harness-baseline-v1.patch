+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+ROLLBACK_MANIFEST_KIND = "gtt.native_performance_rollback_manifest_v1"
+DEFAULT_STAGE = "native-performance"
+B_STAGE = "native-performance-b"
+B_ROLLBACK_MANIFEST_KIND = "gtt.native_performance_b_rollback_manifest_v1"
+
+ROLLBACK_BINARY_REL = "native/gcsim_optimizer/gtt-optimizer.exe.pre-native-performance-20261015.rollback"
