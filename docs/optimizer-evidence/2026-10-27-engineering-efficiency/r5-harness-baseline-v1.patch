+def restore_sink(chasca, value, *, save, require_cleanup_release):
+    require(value.get("schema_kind") == "gtt_main_navia_private_sink_state_v1"
+            and value.get("owner") == OWNER, "navia_private_state_owner")
+    sink = PrivatePairSink(chasca, value["export"], protocol_sha256=value["protocol_sha256"],
+        record=value["record"], save=save, allowance=lambda _: 1, scratch=lambda *_: None,
+        require_grant=lambda: None, require_cleanup_release=require_cleanup_release,
+        now=datetime.fromisoformat(value["created_utc"]))
+    require(sink.expires.isoformat() == value["expires_utc"]
+            and set(value["fields"]) == set(sink_state(sink)["fields"]), "navia_private_state_schema")
+    sink.job = Path(value["job"]) if value["job"] is not None else None
+    for name, item in value["fields"].items():
+        setattr(sink, name, item)
+    return sink
