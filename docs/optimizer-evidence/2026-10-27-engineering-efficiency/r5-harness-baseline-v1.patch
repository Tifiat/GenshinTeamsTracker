+                "unique_groups_overflow": 0, "observations_overflow": 0}
+    groups: dict[tuple[str, str, str], int] = {}
+    invalid_identifiers = 0
+    shared_global_causes = 0
+    for item in raw:
+        boundary = item.get("boundary") if isinstance(item, dict) else None
+        if not isinstance(boundary, dict):
