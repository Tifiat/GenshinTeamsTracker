+    "search.(*candidateRun).point", "search.(*candidateRun).retain",
+    "search.(*candidateRun).priorities", "search.(*candidateRun).finish",
+    "search.(*Engine).candidateRun", "search.(*Engine).RefineCandidates",
+    "search.(*Engine).mergeFinalists", "search.candidateDotPriorities",
