+def run(destination: Path, freeze_path: Path):
+    started = time.monotonic()
+    plan = source_plan()
+    freeze = json.loads(bounded(freeze_path))
+    if freeze.get("frozen_plan") != plan or freeze.get("source_review_status") != "approved":
+        raise ValueError("unified_review_required")
+    if freeze.get("execution_grant") != "one_health_unified_packet":
+        raise ValueError("unified_grant_required")
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("unified_python_identity")
+    if destination.exists() or tuple(k.EVIDENCE.glob(PREFIX + "*.gz")):
+        raise ValueError("unified_outputs_exist")
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")) or k.gate.retirement._default_process_probe(k.ROOT):
+        raise ValueError("unified_scratch_busy")
+    protected, native = k.protected(), k.old.native_map()
+    active = [None]
+    exported_source_sha256 = {}
+    record = {"schema": "health_unified_result_v1", "status": "started", "errors": [],
+              "freeze_sha256": k.sha(bounded(freeze_path)), "plan_sha256": k.gate.digest(plan),
+              "protected_before": protected, "native_before_sha256": k.gate.digest(native),
+              "commands": {}, "installs": 0, "retries": 0,
+              "timing_boundary": plan["comparison_limit"]}
+    with destination.open("xb") as stream:
+        def save(): k.gate.io._save(stream, record)
+        def export():
+            try:
+                job = active[0]
+                if job is None:
+                    return
+                paths = [p for p in job.glob("*.log") if p.is_file()]
+                paths += [p for p in job.glob("*.json") if p.is_file()]
+                paths += [p for p in job.glob("*.patch") if p.is_file()]
+                for arm in ("control", "candidate", "unified-quality", "cases"):
+                    root = job / arm
+                    if root.is_dir():
+                        paths += [p for p in root.rglob("*") if p.is_file() and p.suffix in (".json", ".jsonl", ".txt", ".cfg")]
+                for relative in ("build/gtt-source-manifest-body.json", "build/gtt-source-manifest-input.json"):
+                    path = job / "engine-candidate" / relative
+                    if path.is_file():
+                        paths.append(path)
+                total = sum(path.stat().st_size for path in paths)
+                if total > LIMITS["raw_export_total_max"]:
+                    raise ValueError("unified_export_total_cap")
+                batch = {}
+                for path in sorted(set(paths)):
+                    name = path.relative_to(job).as_posix()
+                    digest = k.sha(bounded(path))
+                    if name not in exported_source_sha256:
+                        writer = function_view(complete.prior.retained._write_gzip_once,
+                                               MAX_RAW_EXPORT_BYTES=LIMITS["raw_export_file_max"])
+                        batch[name] = {"source_sha256": digest,
+                                       "archive": writer(bounded(path), k.EVIDENCE / (PREFIX + name.replace("/", "__") + ".gz"))}
+                        exported_source_sha256[name] = digest
+                    elif exported_source_sha256[name] != digest:
+                        raise ValueError("unified_exported_source_changed")
+                if batch:
+                    ordinal = len(record.setdefault("export_receipts", [])) + 1
+                    receipt = k.EVIDENCE / (PREFIX + f"exports-stage-{ordinal:02d}.json")
+                    with receipt.open("xb") as stream:
+                        stream.write(k.gate.canonical({"schema": "health_unified_export_stage_v1",
+                                                       "ordinal": ordinal, "files": batch}))
+                    record["export_receipts"].append({"path": str(receipt), "sha256": k.sha(bounded(receipt)),
+                                                      "files": len(batch)})
+                record["export_files_count"] = len(exported_source_sha256)
+                record["export_raw_bytes"] = total
+            finally:
+                save()
+        def body(job: Path):
+            active[0] = job
+            env, _ = k.gate.common._environment(job)
+            env.update(GOMEMLIMIT="2GiB", GTT_SCRATCH_DIR=str(job),
+                       GTT_RULE_BUNDLED_CACHE_DIR=str(k.NATIVE / "set-rule-cache"))
+            tighnari_deadline = started + LIMITS["tighnari_seconds"]
+            def preserved():
+                if k.protected() != protected or k.old.native_map() != native or source_plan() != plan:
+                    raise ValueError("unified_source_or_runtime_changed")
+            def command(args, label, maximum, cwd, extra=None, deadline=None):
+                if label in record["commands"]:
+                    raise ValueError("unified_command_repeat")
+                preserved()
+                if deadline is not None:
+                    maximum = min(maximum, deadline - time.monotonic())
+                whole_left = LIMITS["whole_seconds"] - (time.monotonic() - started) - LIMITS["cleanup_reserve_seconds"]
+                if maximum <= 0 or whole_left < maximum:
+                    raise TimeoutError("unified_phase_budget_unavailable")
+                if k.gate.common._tree_bytes(job) > LIMITS["scratch_bytes_max"]:
+                    raise ValueError("unified_scratch_cap")
+                record["stage"] = label
+                save()
+                runner = function_view(k.gate.owned._run_owned, optimizer_process_workdir=lambda _: cwd)
+                result = runner([str(arg) for arg in args], command_kind=PREFIX + label,
+                                env={**env, **(extra or {})}, log_path=job / (label + ".log"), timeout_seconds=maximum)
+                record["commands"][label] = result
+                save()
+                if not k.gate.command_passed(result):
+                    raise ValueError("unified_owned_command_failed")
+                return result
+            overlay = complete.modules()[2].combined_overlay()
+            overlay["overlay_files"] = {**overlay["overlay_files"], HELPER_TARGET: HELPER.read_bytes()}
+            overlay_path, staged = complete.old_run.staging.stage_overlay(job, overlay, native)
+            record["staging_manifest"] = staged
+            binary = job / "health-unified.exe"
+            command([k.gate.owned.GO_EXE, "-C", k.NATIVE, "test", "-c", "-p=1", "-mod=readonly",
+                     "-buildvcs=false", "-overlay=" + str(overlay_path), "-o", binary, "./internal/allsets"],
+                    "native-build", LIMITS["native_build_seconds"], k.NATIVE, deadline=tighnari_deadline)
+            record["native_binary_sha256"] = k.gate.owned._sha256_file(binary)
+            save()
