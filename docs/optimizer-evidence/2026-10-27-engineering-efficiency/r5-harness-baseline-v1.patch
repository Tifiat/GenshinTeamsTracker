+        "candidate_context_count": len(debug.get("context_panel") or ()) if isinstance(debug.get("context_panel"), list) else None,
+        "proposal_package_count": ((debug.get("proposal_report") or {}).get("packages_considered")
+                                   if isinstance(debug.get("proposal_report"), dict) else None),
+        "search_summary": search_summary,
