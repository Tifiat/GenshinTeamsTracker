+++ b/tools/experiments/gcsim/mvp_polish/preparation_exact_reuse_run.py
@@ -0,0 +1,270 @@
+"""One frozen matched E-control/candidate packet; existing managed lifecycle.
+
+One binary, two fresh sequential processes, identical light wall observation,
+real policy simulations and no CPU profiler or post-search n500 measurements.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import preparation_exact_reuse_replay as producer
+from tools.experiments.gcsim.mvp_polish import e_whole_profile_run as checks
+
+k, retained, staging = checks.k, checks.retained, checks.staging
+PREFIX = "preparation-exact-reuse-v2-"
+LIMITS = {"whole_seconds":1080, "cleanup_reserve_seconds":90, "build_seconds":180,
+          "contracts_seconds":30, "each_replay_seconds":330, "managed_jobs":1,
+          "builds":1, "RunNeutral":2, "policy_n1_each_max":48, "policy_n1_total_max":96,
+          "secondary_each_max":8, "policy_workers":1, "final_n500":0,
+          "captures":0, "installs":0, "retries":0, "GOMEMLIMIT":"2GiB target, not peak cap"}
+
+
+def source_plan():
+    base = checks.original.final_pair_whole_overlay()
+    overlay = producer.matched_overlay()
+    pins = retained._source_pins(base)
+    for path in (*producer.SOURCE_FILES, Path(__file__), Path(__file__).with_name("test_preparation_exact_reuse_run.py"),
+                 Path(checks.__file__), Path(checks.metadata.__file__), Path(checks.decoder_source.__file__)):
+        pins[path.relative_to(k.ROOT).as_posix()] = k.sha(path.read_bytes())
+    names = retained._contract_names(base) + [producer.clocks.PROFILE_CONTRACT]
+    names += overlay["metadata"]["candidate"]["contract_names"]
+    if len(names) != len(set(names)):
+        raise ValueError("duplicate_matched_contract_name")
+    saved = retained._read_saved_inputs()
+    for name in ("final-pair-whole-candidate-projection.json.gz",):
+        raw = (k.EVIDENCE / name).read_bytes()
+        saved[name] = {"compressed_sha256":k.sha(raw), "raw_sha256":k.sha(gzip.decompress(raw))}
+    return {"schema":"preparation_exact_reuse_matched_plan_v2", "limits":LIMITS,
+            "source_pins":pins, "saved_input_pins":saved, "overlay_hashes":overlay["hashes"],
+            "metadata":overlay["metadata"], "contract_names":names,
+            "tools":{str(path):k.sha(path.read_bytes()) for path in (k.ROOT/".venv/Scripts/python.exe", k.gate.owned.GO_EXE)},
+            "commands":[
+                "go -C <native> test -c -p=1 -mod=readonly -buildvcs=false -overlay=<job>/overlay.json -o <job>/preparation-reuse.exe ./internal/allsets",
+                "<job>/preparation-reuse.exe -test.run=^("+"|".join(names)+")$ -test.v -test.parallel=1 -test.timeout=30s",
+                "GTT_PREPARATION_REUSE_ARM=control <job>/preparation-reuse.exe -test.run=^TestAdaptiveHybridSavedReplay$ -test.v -test.parallel=1 -test.timeout=330s",
+                "GTT_PREPARATION_REUSE_ARM=candidate <job>/preparation-reuse.exe -test.run=^TestAdaptiveHybridSavedReplay$ -test.v -test.parallel=1 -test.timeout=330s"],
+            "arm_order":["control","candidate"], "cpu_profile":False,
+            "comparison":"Matched unprofiled control/candidate; exact ordered work/output/score bits and policy evidence. Changed finalists receive no automatic ordinary extension.",
+            "retention":"Per-arm lossless bounded logs/projection/journals/raw policy pairs before cleanup, including partial failure. No historical reruns or installed change.",
+            "execution_grant_required":"one_matched_preparation_reuse_packet"}
+
+
+def export_arm(job, arm, record):
+    root = job / arm
+    exports = record.setdefault("lossless_exports", {})
+    files = ("candidate-projection.json", "adaptive-policy-progress.jsonl", "adaptive-damped-whole-screening.jsonl",
+             "final-pair-whole-plan.jsonl", "final-pair-whole-stabilization.jsonl")
+    for name in files:
+        path = root / name
+        if path.is_file():
+            exports[name] = retained._write_gzip_once(checks.read_bounded(path), k.EVIDENCE/(PREFIX+arm+"-"+name+".gz"))
+    policy_root = root / "adaptive-policy-runs"
+    artifacts = []
+    for kind, filename in (("config","config.txt"),("result","result.json")):
+        paths = sorted(policy_root.rglob(filename)) if policy_root.is_dir() else []
+        if len(paths) > 48:
+            raise ValueError("matched_policy_export_limit")
+        for index,path in enumerate(paths):
+            info = retained._write_gzip_once(checks.read_bounded(path), k.EVIDENCE/f"{PREFIX}{arm}-policy-{kind}-{index:02d}.gz")
+            info.update(kind=kind, source_relative_path=path.relative_to(policy_root).as_posix())
+            artifacts.append(info)
+    record["policy_artifacts"] = artifacts
+
+
+def validate_arm(job, arm, record):
+    root = job / arm
+    payload = json.loads(checks.read_bounded(root/"candidate-projection.json"))
+    if payload.get("complete") is not True or payload.get("provider_calls") != 1 or payload.get("experiment_arm") != arm:
+        raise ValueError("matched_arm_incomplete")
+    if payload.get("cpu_profiler_started") is not False:
+        raise ValueError("matched_unexpected_cpu_profile")
+    if payload.get("verification") != {"disabled_for_profile":True,"result":{"candidates":[]}}:
+        raise ValueError("matched_final_measurements_not_disabled")
+    if (root/"candidate-final").exists() or (root/"candidate-final-ledger.jsonl").exists() or list(job.rglob("*.pprof")):
+        raise ValueError("matched_unexpected_engine_or_profile_work")
+    policy = payload["policy"]
+    calls = policy.get("calls")
+    if type(calls) is not int or not 0 <= calls <= 48 or retained._policy_sample_count(policy) != calls:
+        raise ValueError("matched_policy_call_limit")
+    events = policy.get("events", [])
+    secondary = [e for e in events if e.get("type")=="secondary_refinement_started"]
+    if len(secondary)>8 or len({e.get("block") for e in secondary})!=len(secondary):
+        raise ValueError("matched_secondary_limit")
+    checks.validate_policy_artifacts(root, policy, record)
+    retained._validate_damped_screening(root, payload, record)
+    retained._validate_final_pair_whole(root, payload, record)
+    checks.validate_wall(payload["wall_profile"], payload["run_neutral_seconds"])
+    if payload["wall_profile"].get("status")!="complete" or payload["wall_profile"].get("run_error") is not None:
+        raise ValueError("matched_wall_incomplete")
+    record.update(policy_calls=calls, secondary_refinements=len(secondary), search_metrics=payload["search_metrics"],
+                  run_neutral_seconds=payload["run_neutral_seconds"], setup_seconds=payload["setup_seconds"],
+                  wall_profile=payload["wall_profile"], performance=payload["performance"],
+                  saved_e_comparison=checks.compare_saved(payload))
+    return payload
+
+
+def compare(control, candidate):
+    semantic = k.gate.semantic
+    left, right = semantic(control["projection"]), semantic(candidate["projection"])
+    work_left, work_right = left["search_work"], right["search_work"]
+    first = next((i for i,(a,b) in enumerate(zip(work_left,work_right)) if a!=b),None)
+    if first is None and len(work_left)!=len(work_right):
+        first=min(len(work_left),len(work_right))
+    policy_equal=semantic(control["policy"])==semantic(candidate["policy"])
+    metrics_equal=control["search_metrics"]==candidate["search_metrics"]
+    elapsed_left, elapsed_right = control["run_neutral_seconds"], candidate["run_neutral_seconds"]
+    enabled_hits=candidate["performance"].get("PreparedPayloadProgramHits")
+    disabled_hits=control["performance"].get("PreparedPayloadProgramHits",0)
+    if type(enabled_hits) is not int or enabled_hits<=0 or disabled_hits!=0:
+        raise ValueError("matched_reuse_not_exercised_or_control_enabled")
+    return {"control_run_neutral_seconds":elapsed_left,"candidate_run_neutral_seconds":elapsed_right,
+            "run_neutral_difference_seconds":elapsed_right-elapsed_left,
+            "run_neutral_change_percent":100*(elapsed_right/elapsed_left-1),
+            "control_projection_sha256":k.gate.digest(left),"candidate_projection_sha256":k.gate.digest(right),
+            "ordered_output_work_score_bits_equal":left==right,"policy_equal_except_timing":policy_equal,
+            "search_metrics_equal":metrics_equal,"first_work_difference":first,
+            "control_work_rows":len(work_left),"candidate_work_rows":len(work_right),
+            "prepared_payload_program_hits":enabled_hits,
+            "exact_quality_parity":left==right and metrics_equal,
+            "ordinary_policy_note":"Independent seeded runs retained; divergence is evidence to inspect, not an automatic regression attribution.",
+            "speed_note":"One fixed-order matched pair, not a repeated/population speed estimate; both arms have identical wall observation and no CPU profiler.",
+            "early_selection":"Unchanged. This candidate reuses exact preparation before screening; it does not introduce heuristic exclusion."}
+
+
+def posthoc_controls(control,candidate):
+    """Saved ordinary panels are observations only, never search inputs."""
+    key=lambda assignment:json.dumps(assignment,separators=(",",":"))
+    observed={arm:{key(row["score"]["assignment"]) for row in value["projection"]["finalists"]}
+              for arm,value in (("control",control),("candidate",candidate))}
+    reports={}
+    for name,filename in (("B","adaptive-hybrid-baseline-projection.json.gz"),
+                          ("P","adaptive-formula-primary-candidate-projection.json.gz"),
+                          ("E","final-pair-whole-candidate-projection.json.gz")):
+        saved=json.loads(gzip.decompress((k.EVIDENCE/filename).read_bytes()))
+        rows=[]
+        for row in saved["verification"]["result"]["candidates"]:
+            identity=key(row["assignment"])
+            rows.append({"old_panel_rank":row["rank"],"assignment":row["assignment"],
+                         "saved_formula_dps":row["formula_dps"],"saved_ordinary_mean":row["measured_dps"],
+                         "control_search_finalist":identity in observed["control"],
+                         "candidate_search_finalist":identity in observed["candidate"]})
+        reports[name]={"rows":rows,"newly_missing_from_candidate":sum(r["control_search_finalist"] and not r["candidate_search_finalist"] for r in rows)}
+    return {"scope":"Membership in the actual search-finalist projection, before ordinary-panel protections. Historical ordinary means are not new candidate measurements.","panels":reports}
+
+
+def run(destination,freeze_path):
+    started=time.monotonic()
+    plan=source_plan()
+    freeze=json.loads(freeze_path.read_bytes())
+    if freeze.get("source_review_status")!="approved" or freeze.get("execution_grant")!="one_matched_preparation_reuse_packet" or freeze.get("frozen_plan")!=plan:
+        raise ValueError("matched_exact_reviewed_grant_required")
+    if Path(sys.executable).resolve()!=(k.ROOT/".venv/Scripts/python.exe").resolve():
+        raise ValueError("matched_python_identity")
+    if destination.exists() or tuple(k.EVIDENCE.glob(PREFIX+"*.gz")):
+        raise ValueError("matched_outputs_already_exist")
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")) or k.gate.retirement._default_process_probe(k.ROOT):
+        raise ValueError("matched_scratch_busy")
+    before,native=k.protected(),k.old.native_map()
+    overlay=producer.matched_overlay()
+    active=[None]
+    record={"schema":"preparation_exact_reuse_matched_result_v2","status":"started","errors":[],
+            "frozen_plan":plan,"freeze_sha256":k.sha(freeze_path.read_bytes()),"protected_before":before,
+            "native_before_sha256":k.gate.digest(native),"build_launches":0,"replay_launches":0,
+            "captures":0,"installs":0,"retries":0,"arms":{}}
+    with destination.open("xb") as stream:
+        def save():k.gate.io._save(stream,record)
+        def export():
+            try:
+                job=active[0]
+                if job is not None:
+                    for label in ("build","contracts","control","candidate"):
+                        path=job/f"matched-{label}.log"
+                        if path.is_file():
+                            record.setdefault("log_exports",{})[label]=retained._write_gzip_once(checks.read_bounded(path),k.EVIDENCE/(PREFIX+"log-"+label+".gz"))
+                    for arm in ("control","candidate"):
+                        if (job/arm).exists():export_arm(job,arm,record["arms"].setdefault(arm,{}))
+            finally:save()
+        def body(job):
+            active[0]=job
+            env,_=k.gate.common._environment(job)
+            env.update(GOMEMLIMIT="2GiB",GTT_TIGHNARI_ARCHIVED_WHOLE="root_released_once",
+                       GTT_TIGHNARI_REPLAY_REPO=str(k.ROOT),GTT_TIGHNARI_REPLAY_ROLE="candidate")
+            overlay_path,manifest=staging.stage_overlay(job,overlay,native)
+            record["staging_manifest"]=manifest
+            binary=job/"preparation-reuse.exe"
+            def command(args,label,maximum,arm=None):
+                remaining=LIMITS["whole_seconds"]-(time.monotonic()-started)-LIMITS["cleanup_reserve_seconds"]
+                required=maximum+(LIMITS["each_replay_seconds"] if arm=="control" else 0)
+                if remaining<required:raise TimeoutError("matched_full_remaining_phase_budget_unavailable")
+                record["stage"]=label
+                save()
+                current=dict(env)
+                if arm is not None:current["GTT_PREPARATION_REUSE_ARM"]=arm
+                result=k.gate.owned._run_owned(args,command_kind=label,env=current,log_path=job/(label+".log"),timeout_seconds=maximum)
+                record.setdefault("commands",{})[label]=result
+                save()
+                if not k.gate.command_passed(result):raise ValueError("matched_owned_command_failed")
+            record["build_launches"]=1
+            command([str(k.gate.owned.GO_EXE),"-C",str(k.NATIVE),"test","-c","-p=1","-mod=readonly","-buildvcs=false","-overlay="+str(overlay_path),"-o",str(binary),"./internal/allsets"],"matched-build",LIMITS["build_seconds"])
+            record["binary_sha256"]=k.sha(binary.read_bytes())
+            names=plan["contract_names"]
+            command([str(binary),"-test.run=^("+"|".join(names)+")$","-test.v","-test.parallel=1","-test.timeout=30s"],"matched-contracts",LIMITS["contracts_seconds"])
+            retained.local_pair._verify_named_tests(checks.read_bounded(job/"matched-contracts.log").decode(),names)
+            payloads={}
+            for arm in ("control","candidate"):
+                if source_plan()!=plan or k.protected()!=before or k.old.native_map()!=native:
+                    raise ValueError("matched_pre_arm_source_drift")
+                record["replay_launches"]+=1
+                command([str(binary),"-test.run=^TestAdaptiveHybridSavedReplay$","-test.v","-test.parallel=1","-test.timeout=330s"],"matched-"+arm,LIMITS["each_replay_seconds"],arm)
+                retained.local_pair._verify_named_tests(checks.read_bounded(job/("matched-"+arm+".log")).decode(),["TestAdaptiveHybridSavedReplay"])
+                arm_record=record["arms"].setdefault(arm,{})
+                export_arm(job,arm,arm_record)
+                payloads[arm]=validate_arm(job,arm,arm_record)
+                save()
+            record["comparison"]=compare(payloads["control"],payloads["candidate"])
+            record["posthoc_controls"]=posthoc_controls(payloads["control"],payloads["candidate"])
+            record["status"]="matched_complete_cleanup_pending"
+            if not record["comparison"]["exact_quality_parity"]:
+                record["status"]="matched_parity_not_established_cleanup_pending"
+            save()
+        try:k.gate.run_owned_body(None,record,export,body)
+        except Exception as exc:
+            record["status"]="failed"
+            record["errors"].append(str(exc))
+        finally:
+            try:
+                record["protected_after"]=k.protected()
+                after=k.old.native_map()
+                record["native_after_sha256"]=k.gate.digest(after)
+                record["pins_and_saved_inputs_exact"]=source_plan()==plan
+                record["preservation_exact"]=record["protected_after"]==before and after==native
+                record["remaining_managed_jobs"]=len(tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")))
+                record["optimizer_processes_remaining"]=bool(k.gate.retirement._default_process_probe(k.ROOT))
+                record["whole_wall_seconds"]=time.monotonic()-started
+                good=(record["preservation_exact"] and record["pins_and_saved_inputs_exact"] and record["remaining_managed_jobs"]==0 and not record["optimizer_processes_remaining"] and record.get("cleanup_status")=="confirmed" and record["whole_wall_seconds"]<=LIMITS["whole_seconds"])
+                if not good:
+                    record["status"]="failed";record["errors"].append("matched_postflight_failed")
+                elif not record["errors"]:
+                    if record["status"]=="matched_complete_cleanup_pending":record["status"]="matched_complete"
+                    elif record["status"]=="matched_parity_not_established_cleanup_pending":record["status"]="matched_parity_not_established"
+            except Exception as exc:
+                record["status"]="failed";record["errors"].append("matched_postflight_snapshot_failed")
+                record["postflight_error"]=str(exc)
+            save()
+    return record
+
+
+if __name__=="__main__":
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--freeze",required=True,type=Path)
+    parser.add_argument("--output",required=True,type=Path)
+    args=parser.parse_args()
+    result=run(args.output,args.freeze)
+    print(json.dumps({key:result.get(key) for key in ("status","errors","cleanup_status","comparison")}))
+    raise SystemExit(0 if result["status"]=="matched_complete" else 2)
