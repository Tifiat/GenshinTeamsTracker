+def compare_outputs(before, after):
+    require(before.get("mode") == after.get("mode") == "all_sets", "wrong_mode")
+    for output in (before, after):
+        product = output.get("product_result", {})
+        require(product.get("status") == "success" and product.get("ranking_basis") == "gcsim", "product_failed")
+    model_a, model_summary_a = model_projection(before)
+    model_b, model_summary_b = model_projection(after)
+    support_a, support_summary_a = support_projection(before)
+    support_b, support_summary_b = support_projection(after)
+    a, winner_a = finalist_projection(before)
+    b, winner_b = finalist_projection(after)
+    same_rows = set(a) == set(b)
+    ordinary = []
+    for identity in sorted(set(a) & set(b)):
+        left, right = a[identity], b[identity]
+        matching = all(exact(left[key]) == exact(right[key]) for key in ("formula_dps", "config_sha256", "iterations"))
+        difference = abs(number(left["measured_dps"]) - number(right["measured_dps"]))
+        allowance = 5 * math.hypot(number(left["standard_error"]), number(right["standard_error"]))
+        ordinary.append({"assignment_sha256": identity, "same_formula_and_config": matching,
+                         "before": left, "after": right, "absolute_mean_difference": difference,
+                         "combined_five_sigma_allowance": allowance, "within_sampling": difference <= allowance})
+    checks = {"all_model_witnesses_exact": model_a == model_b, "full_support_guide_exact": support_a == support_b,
+              "same_all_finalists": same_rows,
+              "all_finalist_configs_and_formulas_exact": same_rows and all(row["same_formula_and_config"] for row in ordinary),
+              "ordinary_n500_within_sampling": same_rows and all(row["within_sampling"] for row in ordinary),
+              "same_request_binding": before["product_result"].get("request_sha256") == after["product_result"].get("request_sha256")}
+    winner_difference = abs(number(a[winner_a]["measured_dps"]) - number(b[winner_b]["measured_dps"]))
+    winner_allowance = 5 * math.hypot(number(a[winner_a]["standard_error"]), number(b[winner_b]["standard_error"]))
+    checks["winner_uncertainty_overlap"] = winner_a == winner_b or (same_rows and winner_difference <= winner_allowance)
+    return {"accepted": all(checks.values()), "checks": checks, "baseline_model": model_summary_a,
+            "candidate_model": model_summary_b, "baseline_support_sha256": support_summary_a["sha256"],
+            "candidate_support": support_summary_b, "baseline_winner": winner_a, "candidate_winner": winner_b,
+            "same_winner_observed": winner_a == winner_b, "winner_mean_difference": winner_difference,
+            "winner_combined_five_sigma_allowance": winner_allowance,
+            "winner_change_interpretation": "same_winner" if winner_a == winner_b else "sampled_winner_changed_no_rank_improvement_claim",
+            "ordinary_n500": ordinary}
