+def run_owned_body(job, record, save, body, *, services=None):
+    """Reuse the reviewed export-before-cleanup contract, including failures."""
+    services = services or SimpleNamespace(managed=managed)
+    with lifecycle._retained_job(services, record, save) as job_path:
+        require(job is None or job == job_path, "job_scope_changed")
+        try:
+            body(job_path)
+        except Exception as exc:
+            record["status"] = "failed"
+            record.setdefault("errors", []).append(str(exc) if type(exc) is ValueError and re.fullmatch("[a-z_]{1,80}", str(exc)) else "candidate_gate_failed")
+        finally:
+            record["precleanup_idle"] = not retirement._default_process_probe(ROOT)
+            record["scratch_bytes_before_cleanup"] = common._tree_bytes(job_path)
+    return record
