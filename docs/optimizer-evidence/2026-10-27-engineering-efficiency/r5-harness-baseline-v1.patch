+def _support_response_summary(receipt: dict) -> dict:
+    check = receipt.get("check") if isinstance(receipt.get("check"), dict) else receipt
+    evidence = check.get("evidence") if isinstance(check.get("evidence"), dict) else {}
+    response_plan = check.get("plan") if isinstance(check.get("plan"), dict) else {}
+    plan = response_plan.get("plan") if isinstance(response_plan.get("plan"), dict) else {}
+    selected_seeds = check.get("selected_seeds")
+    evidence_limit = evidence.get("call_limit")
+    plan_limit = plan.get("call_limit")
+    return {
+        "status": check.get("status") or receipt.get("status"),
+        "configured_call_limit": (
+            evidence_limit if type(evidence_limit) is int
+            else plan_limit if type(plan_limit) is int
+            else None
+        ),
