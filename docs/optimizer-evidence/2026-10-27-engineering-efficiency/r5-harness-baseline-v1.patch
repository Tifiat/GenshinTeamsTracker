+def describe_bonuses(counts: dict, definitions: dict) -> list[dict]:
+    result = []
+    for key, count in sorted(counts.items()):
+        if not key or count < 2:
+            continue
+        item = definitions.get(key, {"name": key})
+        for tier in (2, 4):
+            if count >= tier:
+                text = item.get("two_piece" if tier == 2 else "four_piece", "")
+                result.append({"set_key": item.get("gcsim_key", key), "set_uid": item.get("set_uid", key),
+                    "name": item["name"], "piece_bonus": tier,
+                    "equipped_piece_count": count, "effect": text,
+                    "effect_status": "catalog_text" if text else "catalog_text_unavailable",
+                    "provenance": item.get("provenance", "set_mapping_unavailable")})
+    return result
