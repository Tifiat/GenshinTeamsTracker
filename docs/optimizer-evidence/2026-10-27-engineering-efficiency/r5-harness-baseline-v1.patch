+def _export_final_pair_whole(job: Path, record: dict[str, Any]) -> None:
+    exports = record.setdefault("lossless_exports", {})
+    for key, filename in (
+        ("final_pair_plan", "final-pair-whole-plan.jsonl"),
+        ("final_pair_stabilizations", "final-pair-whole-stabilization.jsonl"),
+    ):
+        path = job / filename
+        if path.is_file():
+            exports[key] = _write_gzip_once(path.read_bytes(), k.EVIDENCE / (filename + ".gz"))
+
