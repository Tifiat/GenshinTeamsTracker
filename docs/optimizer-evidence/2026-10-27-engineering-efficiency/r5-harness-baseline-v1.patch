+def prepare_d_owned(chasca, job, physical, *, environment, record, save, allowance, scratch):
+    """Actual prepare_d, with only its four check_output calls privately bound.
+
+    Each stdout file is raw child bytes, not decoded/re-encoded Python text.
+    Existing run_phase reaches the same observed owned runner as the builds, so
+    every Git-show job is queried before any managed cleanup can be considered.
+    """
+    old, calls = chasca.old, []
+    require(len(old.HEAD_IMAGES) == 4, "navia_git_source_inventory")
+    def check_output(command, *, cwd):
+        index = len(calls)
+        require(index < 4 and command == ["git", "show", "HEAD:native/gcsim_optimizer/" + old.HEAD_IMAGES[index]]
+                and Path(cwd).resolve() == ROOT.resolve(), "navia_git_source_command_scope")
+        calls.append(command[-1])
+        log = "git-show-" + str(index) + ".log"
+        env = dict(environment(job), GIT_NO_LAZY_FETCH="1", GIT_TERMINAL_PROMPT="0", GIT_OPTIONAL_LOCKS="0")
+        require(GIT.is_file() and sha(GIT.read_bytes()) == GIT_SHA, "navia_git_executable_drift")
+        argv = [str(GIT), "-C", str(ROOT), "--no-pager", "-c", "core.hooksPath=", "-c",
+                "core.fsmonitor=false", "-c", "protocol.allow=never", "show", command[-1]]
+        # check_output's stdout-only bytes must not acquire merged diagnostics.
+        width = SimpleNamespace(**vars(chasca.width))
+        run = width._run_owned
+        def separate_stderr(arguments, **options):
+            return run(arguments, stderr_path=job / ("git-show-" + str(index) + ".stderr.log"), **options)
+        width._run_owned = separate_stderr
+        phase = function_view(chasca.run_phase, width=width)
+        process = phase(job, argv, "navia_exact_git_show_" + str(index), env, 10, log,
+            record=record, save=save, allowance=allowance, scratch=scratch)
+        require(chasca.gate.command_passed(process), "navia_git_source_snapshot_failed")
+        require(type(process.get("stderr_bytes")) is int and 0 <= process["stderr_bytes"] <= 262144,
+                "navia_git_source_stderr_scope")
+        raw = chasca.gate.io._read_optional(job / log, 262144)
+        require(type(raw) is bytes and 0 < len(raw) <= 262144, "navia_git_source_stdout_scope")
+        return raw
+    api = old.prepare_d.__globals__["subprocess"]
+    prepare = function_view(old.prepare_d,
+        subprocess=SimpleNamespace(**{**vars(api), "check_output": check_output}))
+    result = prepare(physical)
+    require(len(calls) == 4, "navia_git_source_inventory")
+    return result
+
