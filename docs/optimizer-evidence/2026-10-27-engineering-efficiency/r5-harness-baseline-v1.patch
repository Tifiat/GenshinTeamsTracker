+def run(destination: Path, freeze_path: Path) -> dict:
+    started = time.monotonic()
+    plan = source_plan()
+    freeze = json.loads(_bounded(freeze_path))
+    if (freeze.get("frozen_plan") != plan
+            or freeze.get("source_review_status") != "approved"
+            or freeze.get("execution_grant") != "one_health_unified_uptake_v7_packet"):
+        raise ValueError("uptake_source_review_or_grant_missing")
+    if "accepted_product_images" not in plan:
+        # The physical native tree contains four foreign source deltas. The
+        # production port must supply an exact accepted overlay before any
+        # build or button run can be admitted.
+        raise ValueError("uptake_product_closure_not_frozen")
+    if Path(sys.executable).resolve() != (ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("uptake_python_identity_changed")
+    rollback_dir = EVIDENCE / (PREFIX + "rollback")
+    if (destination.exists() or rollback_dir.exists()
+            or tuple(path for path in EVIDENCE.glob(PREFIX + "*.gz")
+                     if path not in (V7_RUNNER_PREIMAGE, V7_BUTTON_PREIMAGE))
+            or tuple(K.gate.managed.MANAGED_ROOT.glob("job-*"))
+            or K.gate.retirement._default_process_probe(ROOT)):
+        raise ValueError("uptake_output_or_process_busy")
+    protected_before = K.protected()
+    native_before = K.old.native_map()
+    store = engine_store.GcsimEngineStore(ROOT / "data/gcsim/engines")
+    active = [None]
+    exported = {}
+    record = {"schema": "health_unified_uptake_result_v7", "status": "started",
+              "errors": [], "commands": {}, "builds": {"consumer": 0, "engine": 0},
+              "button_runs": {"control": 0, "candidate": 0}, "installs": 0,
+              "retries": 0, "source_plan_sha256": K.gate.digest(plan),
+              "freeze_sha256": sha(_bounded(freeze_path)),
+              "protected_before": protected_before,
+              "native_source_before_sha256": K.gate.digest(native_before),
+              "engine_store_snapshot_boundary": "after_native_contracts_before_product_build",
+              "scope": plan["button_scope"]}
+    with destination.open("xb") as stream:
+        def save() -> None:
+            K.gate.io._save(stream, record)
+
+        def runtime_save(payload: dict) -> None:
+            record["runtime_transaction"] = payload.copy()
+            save()
+
+        def export() -> None:
+            try:
+                job = active[0]
+                if job is None:
+                    return
+                paths = [p for p in job.glob("*") if p.is_file() and p.suffix in (".json", ".log", ".patch")]
+                for rel in ("control", "candidate", "installed", "engine-source-images",
+                            "product-port-source-images"):
+                    root = job / rel
+                    if root.is_dir():
+                        paths += [p for p in root.rglob("*") if p.is_file() and p.suffix in
+                                  (".json", ".jsonl", ".txt", ".cfg", ".go")]
+                root = job / "engine-candidate/build"
+                if root.is_dir():
+                    paths += [p for p in root.rglob("*") if p.is_file() and p.suffix == ".json"]
+                total = sum(p.stat().st_size for p in set(paths))
+                if total > LIMITS["raw_export_total_max"]:
+                    raise ValueError("uptake_export_total_cap")
+                batch = {}
+                for path in sorted(set(paths)):
+                    relative = path.relative_to(job).as_posix()
+                    raw = _bounded(path)
+                    digest = sha(raw)
