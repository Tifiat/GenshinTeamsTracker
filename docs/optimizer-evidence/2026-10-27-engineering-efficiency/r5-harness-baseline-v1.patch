+"""Inert-by-default paired archived RunNeutral replay; no engine or installation.
+
+Reuse the verified v2 unit receipt; two builds and two executions share a managed
+lease/cache. Installed D is reconstructed virtually and must match its historical
+345-file commitment before allocation. The test overlay is identical on both.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[4]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+from tools.experiments.gcsim.mvp_polish import tighnari_saved_gate as gate
+from tools.experiments.gcsim.mvp_polish import run_archive_representatives as historical
+
+AREA = gate.AREA
+NATIVE = ROOT / "native/gcsim_optimizer"
+HELPER = AREA / "tighnari_archived_whole_test.go"
