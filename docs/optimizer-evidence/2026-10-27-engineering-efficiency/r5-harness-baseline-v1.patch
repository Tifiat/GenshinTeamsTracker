+def _runtime_pins() -> dict[str, str]:
+    consumer = Path(DEFAULT_OPTIMIZER_BINARY)
+    assert_unlinked(consumer)
+    consumer = consumer.resolve(strict=True)
+    active_pointer = ROOT / "data/gcsim/engines/active_engine.json"
