+        try:
+            result = bound(argv, **kwargs)
+            accepted = (result.get("returncode") == 0 and result.get("timed_out") is False
+                        and result.get("error_class") is None)
+            if not accepted or state["row"] is None:
+                record["owned_cleanup_latch"] = False
+            result["exact_job_observation"] = state["row"]
+            result["cleanup_latch"] = record["owned_cleanup_latch"] is True
+            return result
+        except BaseException as exc:
+            record["owned_cleanup_latch"] = False
+            if not isinstance(exc, Exception):
+                state["interruption"] = exc
+            raise
+        finally:
+            record["owned_process_pending"].remove(stage)
+            if state["row"] is None:
+                record.setdefault("owned_job_observations", []).append({"stage": stage,
+                    "normal_wait_returned": state["waited"], "idle": False,
+                    "active_processes": None, "close_handle_BOOL": "unobserved",
+                    "observation_error": type(state["failure"]).__name__ if state["failure"] else "unavailable"})
+            try:
+                save()
+            except BaseException:
+                record["owned_cleanup_latch"] = False
+                if state["interruption"] is not None:
+                    raise state["interruption"]
+                raise
+    return invoke
+
