+        "proposal_seconds": debug.get("proposal_seconds"),
+        "guide_seconds": debug.get("guide_seconds"),
+        "search_stop_reason": str(search_stop or "")[:100],
+        "search_expansions": debug.get("search_expansions"),
+        "capture_members": (
+            debug.get("capture_members")
+            if type(debug.get("capture_members")) is int and debug.get("capture_members") >= 0
+            else None
+        ),
+        "capture_members_semantics": (
+            "reserved seed slots before provider calls; not completed captures"
+            if type(debug.get("capture_members")) is int else None
