+        expanded = envelope.decompress(raw, MAX_EXPANDED_BYTES + 1)
+        if (len(expanded) > MAX_EXPANDED_BYTES or not envelope.eof
+                or envelope.unused_data or envelope.unconsumed_tail):
+            raise ValueError("profile_gzip_incomplete_or_bound")
+        budget = _Budget()
+        strings: list[str] = []
+        indices: set[int] = set()
+        function_names: set[int] = set()
+        types: list[tuple[int, int]] = []
+        period_type: tuple[int, int] | None = None
+        singular: dict[int, int] = {}
+        identities: dict[str, set[int]] = {key: set() for key in ("function", "mapping", "location")}
+        record_count, totals = 0, [0, 0]
+
+        def string_indices(record: dict[int, int], fields: tuple[int, ...]) -> None:
+            for field in fields:
+                index = record.get(field, 0)
+                if index > INT64_MAX:
+                    raise ValueError("profile_string_index")
+                indices.add(index)
+
+        def identity(kind: str, record: dict[int, int]) -> None:
+            value = record.get(1, 0)
+            if value == 0 or value in identities[kind]:
+                raise ValueError("profile_duplicate_identity")
+            identities[kind].add(value)
+
+        for number, wire, value in _fields(memoryview(expanded), budget):
+            if number in (1, 2, 3, 4, 5, 6, 11) and wire != 2:
+                raise ValueError("profile_message_wire")
+            if number in (1, 11):
+                record = _singular(value, {1, 2}, budget)
+                string_indices(record, (1, 2))
+                pair = (record.get(1, 0), record.get(2, 0))
+                if number == 1:
+                    types.append(pair)
+                    if len(types) > 2:
+                        raise ValueError("profile_sample_types")
+                else:
+                    if period_type is not None:
+                        raise ValueError("profile_duplicate_period_type")
+                    period_type = pair
