+def _fold_diagnostic_events(events: list[Mapping[str, Any]]) -> dict[str, Any]:
+    """Fold fsynced helper events without treating an unfinished call as a result."""
+    starts: dict[int, dict[str, Any]] = {}
+    finished: set[int] = set()
+    terminal: Mapping[str, Any] | None = None
+    planned = 4
+    contract_error = False
+    for event in events:
+        if event.get("schema_kind") != DIAGNOSTIC_SCHEMA:
+            contract_error = True
+            continue
+        kind = event.get("event")
+        if kind == "diagnostic_started":
+            planned = event.get("planned_invocations", 4)
+        elif kind == "attempt_started":
+            ordinal = event.get("ordinal")
+            if (
+                type(ordinal) is not int or ordinal in starts or ordinal != len(starts) + 1
+                or ordinal < 1 or ordinal > len(CALL_ORDER)
+            ):
+                contract_error = True
+                continue
+            expected_build, expected_seed = CALL_ORDER[ordinal - 1]
+            if (event.get("build"), event.get("seed")) != (expected_build, expected_seed):
+                contract_error = True
+            starts[ordinal] = {
+                "ordinal": ordinal,
+                "build": expected_build,
+                "seed": expected_seed,
+                "status": "in_flight",
+            }
+        elif kind == "attempt_finished":
+            ordinal = event.get("ordinal")
+            attempt = starts.get(ordinal) if type(ordinal) is int else None
+            if attempt is None or ordinal in finished:
+                contract_error = True
+                continue
+            if (event.get("build"), event.get("seed")) != (attempt["build"], attempt["seed"]):
+                contract_error = True
+            status = event.get("status")
+            if status not in {"completed", "failed"}:
+                contract_error = True
+                status = "unknown"
+            attempt["status"] = status
+            if isinstance(event.get("error_code"), str):
+                attempt["error_code"] = event["error_code"]
+            result = _compact_attempt_result(event.get("result"))
+            if result is not None:
+                attempt["result"] = result
+            finished.add(ordinal)
+        elif kind == "finished":
+            terminal = event
+        else:
+            contract_error = True
+
+    attempts = [starts[index] for index in sorted(starts)]
+    completed = sum(item["status"] == "completed" for item in attempts)
+    failed = sum(item["status"] == "failed" for item in attempts)
+    in_flight = sum(item["status"] == "in_flight" for item in attempts)
+    engine_unchanged = None
+    error_code = None
+    if terminal is not None:
+        status = terminal.get("status")
+        error_code = terminal.get("error_code")
+        unchanged = terminal.get("engine_unchanged_after_stage")
+        if type(unchanged) is bool:
+            engine_unchanged = unchanged
+        if status not in {"completed", "failed"}:
+            contract_error = True
+        if (
+            terminal.get("planned_invocations", planned) != planned
+            or terminal.get("attempted_invocations", len(starts)) != len(starts)
+            or terminal.get("completed_invocations", completed) != completed
+            or terminal.get("failed_invocations", failed) != failed
+        ):
+            contract_error = True
+    else:
+        status = "incomplete"
+        if in_flight:
+            error_code = "attempt_outcome_unknown"
+    if contract_error:
+        status, error_code = "failed", "diagnostic_ledger_contract_mismatch"
+    return {
+        "status": status,
+        "planned_invocations": planned,
+        "attempted_invocations": len(starts),
+        "completed_invocations": completed,
+        "failed_invocations": failed,
+        "in_flight_invocations": in_flight,
+        "engine_unchanged_after_stage": engine_unchanged,
+        "error_code": error_code,
+        "attempts": attempts,
+    }
+
+
+def _load_diagnostic_ledger(job: Path) -> dict[str, Any] | None:
+    path = job / DIAGNOSTIC_LEDGER_NAME
+    assert_unlinked(path)
+    if not path.is_file():
+        return None
+    raw = path.read_bytes()
+    lines = raw.splitlines(keepends=True)
+    events: list[Mapping[str, Any]] = []
+    incomplete_tail = False
+    invalid_line = False
+    for index, line in enumerate(lines):
+        try:
+            event = json.loads(line.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            if index == len(lines) - 1 and not line.endswith((b"\n", b"\r")):
+                incomplete_tail = True
+            else:
+                invalid_line = True
+            continue
+        if not isinstance(event, Mapping):
+            invalid_line = True
+        else:
+            events.append(event)
+    summary = _fold_diagnostic_events(events)
+    if invalid_line:
+        summary["status"] = "failed"
+        summary["error_code"] = "diagnostic_ledger_invalid_line"
+    if incomplete_tail and summary.get("error_code") is None:
+        summary["error_code"] = "diagnostic_ledger_truncated_tail"
+    return {
+        "seeded_diagnostic": summary,
+        "ledger_bytes": len(raw),
+        "ledger_sha256": hashlib.sha256(raw).hexdigest(),
+        "ledger_truncated_tail": incomplete_tail,
+    }
+
+
+def _recover_helper_result(job: Path, result: dict[str, Any], receipt: dict[str, Any]) -> None:
+    ledger = _load_diagnostic_ledger(job)
+    if ledger is not None:
+        ledger_diag = ledger["seeded_diagnostic"]
+        stdout_diag = result.get("seeded_diagnostic")
+        if isinstance(stdout_diag, Mapping):
+            for key in (
+                "baseline_config_sha256", "challenger_config_sha256", "receipt_name",
+                "receipt_sha256", "engine_unchanged_after_stage",
+            ):
+                if key in stdout_diag:
+                    ledger_diag[key] = stdout_diag[key]
+            if isinstance(stdout_diag.get("error_code"), str) and not ledger_diag.get("error_code"):
+                ledger_diag["error_code"] = stdout_diag["error_code"]
+            if stdout_diag.get("receipt_name") not in (None, DIAGNOSTIC_LEDGER_NAME):
+                ledger_diag["status"] = "failed"
+                ledger_diag["error_code"] = "diagnostic_ledger_name_mismatch"
+            supplied_sha = stdout_diag.get("receipt_sha256")
+            if isinstance(supplied_sha, str) and supplied_sha != ledger["ledger_sha256"]:
+                ledger_diag["status"] = "failed"
+                ledger_diag["error_code"] = "diagnostic_ledger_hash_mismatch"
+            if not ledger_diag.get("attempts") and isinstance(stdout_diag.get("attempts"), list):
+                ledger_diag["attempts"] = _compact_stdout_diagnostic(stdout_diag).get("attempts", [])
+        result["seeded_diagnostic"] = ledger_diag
+        receipt["diagnostic_ledger"] = {
+            key: value for key, value in ledger.items() if key != "seeded_diagnostic"
+        }
+        receipt["engine_calls_planned"] = ledger_diag["planned_invocations"]
+        receipt["engine_calls_attempted"] = ledger_diag["attempted_invocations"]
+        receipt["engine_calls_completed"] = ledger_diag["completed_invocations"]
+        receipt["engine_calls_failed"] = ledger_diag["failed_invocations"]
+        receipt["engine_calls_in_flight"] = ledger_diag["in_flight_invocations"]
+    elif isinstance(result.get("seeded_diagnostic"), Mapping):
+        diag = result["seeded_diagnostic"]
+        planned = diag.get("planned_invocations", 4)
+        attempted = diag.get("attempted_invocations", 0)
+        completed = diag.get("completed_invocations", 0)
+        failed = diag.get("failed_invocations", 0)
+        receipt["engine_calls_planned"] = planned
+        receipt["engine_calls_attempted"] = attempted
+        receipt["engine_calls_completed"] = completed
+        receipt["engine_calls_failed"] = failed
+        receipt["engine_calls_in_flight"] = max(0, attempted - completed - failed)
+    if result or "diagnostic_ledger" in receipt:
+        receipt["result"] = result
+
+
+def _load_retained_row(expected_sha256: str) -> dict[str, Any]:
+    _inside(RETAINED_RESULT, EVIDENCE_DIR)
+    if _sha256_file(RETAINED_RESULT) != expected_sha256:
+        raise DiagnosticError("retained Theory result pin mismatch")
+    receipt = json.loads(RETAINED_RESULT.read_text(encoding="utf-8"))
+    row = receipt["case"]["result_summary"]["theory_first_ready_snapshot"]["theory_families"]["co_leaders"][0]
+    if not isinstance(row, dict) or row.get("family") != render_diagnostic.PINS["baseline_family_sha256"]:
+        raise DiagnosticError("retained Chevreuse family row changed")
+    return row
+
