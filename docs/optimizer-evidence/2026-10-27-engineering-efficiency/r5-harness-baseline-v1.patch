+ALLSETS_HELPER = Path(__file__).with_name("adaptive_relinearize_b4_test.go")
+CONTRACT_TEST = Path(__file__).with_name("adaptive_relinearize_search_test.go")
+FIXTURE_ROOT = ROOT / "tests" / "fixtures" / "gcsim_optimizer_go_v1"
+FIXTURE_REQUEST = FIXTURE_ROOT / "request_v1.json"
+FIXTURE_COMPACT_IR = FIXTURE_ROOT / "compact_ir_v1.json"
+FIXTURE_LOADER_SOURCE = ROOT / "native" / "gcsim_optimizer" / "internal" / "search" / "fgbs_test.go"
+SOURCE_FILES: tuple[Path, ...] = (
+    Path(__file__), SEARCH_SOURCE, ALLSETS_HELPER, CONTRACT_TEST,
+    FIXTURE_REQUEST, FIXTURE_COMPACT_IR, FIXTURE_LOADER_SOURCE,
+)
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _once(source: str, before: str, after: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"expected exactly one accepted-source marker: {before!r}")
+    return source.replace(before, after, 1)
+
+
+def _instrument_search(source: str) -> str:
+    source = _once(source, '\t"strings"\n', '\t"strings"\n\t"time"\n')
+    edits = (
+        (
+            "\tbest             ScoredAssignment",
+            "\tbest             ScoredAssignment\n\tlastPoint        ScoredAssignment",
+        ),
+        (
+            "\tv, err := p.Evaluate(r.x)",
+            "\tmetric := researchCandidateMetric(engine, actor)\n"
+            "\tif metric != nil { metric.CandidateRuns++; metric.InitialProgramCalls++ }\n"
+            "\tmetricStarted := time.Now()\n"
+            "\tv, err := p.Evaluate(r.x)\n"
+            "\tif metric != nil { metric.InitialProgramNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+        (
+            "\tv, err := r.program.Evaluate(r.x)",
+            "\tmetric := researchCandidateMetric(r.engine, r.actor)\n"
+            "\tif metric != nil { metric.PointProgramCalls++ }\n"
+            "\tmetricStarted := time.Now()\n"
+            "\tv, err := r.program.Evaluate(r.x)\n"
+            "\tif metric != nil { metric.PointProgramNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+        (
+            '\trow := ScoredAssignment{trial, v, "real_candidate"}',
+            '\trow := ScoredAssignment{trial, v, "real_candidate"}\n\tr.lastPoint = row',
+        ),
+        (
+            "\t\tv, e := r.engine.score(row.Assignment)",
+            "\t\tmetric := researchCandidateMetric(r.engine, r.actor)\n"
+            "\t\tif metric != nil { metric.FinishScoreCalls++ }\n"
+            "\t\tmetricStarted := time.Now()\n"
+            "\t\tv, e := r.engine.score(row.Assignment)\n"
+            "\t\tif metric != nil { metric.FinishScoreNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+        (
+            "\t_, weights, _, err := r.program.ValueGradient(r.x)",
+            "\tmetric := researchCandidateMetric(r.engine, r.actor)\n"
+            "\tif metric != nil { metric.ValueGradientCalls++ }\n"
+            "\tmetricStarted := time.Now()\n"
+            "\t_, weights, _, err := r.program.ValueGradient(r.x)\n"
+            "\tif metric != nil { metric.ValueGradientNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+        (
+            "\tids, _, err := r.engine.domain.PackageLinearAssignment(p, priority, used)",
+            "\tmetric := researchCandidateMetric(r.engine, r.actor)\n"
+            "\tif metric != nil { metric.LinearAssignmentCalls++ }\n"
+            "\tmetricStarted := time.Now()\n"
+            "\tids, _, err := r.engine.domain.PackageLinearAssignment(p, priority, used)\n"
+            "\tif metric != nil { metric.LinearAssignmentNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+        (
+            "\tplan, err := r.engine.domain.PreparePackageLinear(domain.Package{Sets: r.engine.domain.Wearers[r.actor].SelectedSets}, w, r.used)",
+            "\tmetric := researchCandidateMetric(r.engine, r.actor)\n"
+            "\tif metric != nil { metric.LinearPlanCalls++ }\n"
+            "\tmetricStarted := time.Now()\n"
+            "\tplan, err := r.engine.domain.PreparePackageLinear(domain.Package{Sets: r.engine.domain.Wearers[r.actor].SelectedSets}, w, r.used)\n"
+            "\tif metric != nil { metric.LinearPlanNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+        (
+            "\t\tids, _, e := plan.Assignment(excluded...)",
+            "\t\tmetric := researchCandidateMetric(r.engine, r.actor)\n"
+            "\t\tif metric != nil { metric.LinearPlanAssignmentCalls++ }\n"
+            "\t\tmetricStarted := time.Now()\n"
+            "\t\tids, _, e := plan.Assignment(excluded...)\n"
+            "\t\tif metric != nil { metric.LinearPlanAssignmentNanos += time.Since(metricStarted).Nanoseconds() }",
+        ),
+    )
+    for before, after in edits:
+        source = _once(source, before, after)
+    return source
+
+
+def _instrument_precap_helper(raw: bytes) -> bytes:
+    source = raw.decode("utf-8")
+    source = _once(
+        source,
+        "\tsearchCtx, cancel := context.WithTimeout(t.Context(), 55*time.Second)",
+        "\tsearchDeadline := time.Now().Add(55*time.Second)\n"
+        "\tif testDeadline, ok := t.Deadline(); ok {\n"
+        "\t\texportGraceDeadline := testDeadline.Add(-2 * time.Second)\n"
+        "\t\tif exportGraceDeadline.Before(searchDeadline) { searchDeadline = exportGraceDeadline }\n"
+        "\t}\n"
+        "\tsearchCtx, cancel := context.WithDeadline(t.Context(), searchDeadline)",
+    )
+    source = _once(
+        source,
+        "\tretained := []Candidate{}\n\tretain := func(candidate Candidate) { retained = append(retained, candidate) }",
+        "\tretained := []Candidate{}\n"
+        "\tpreparedByPackage := make(map[string]Candidate, 524)\n"
+        "\tretain := func(candidate Candidate) { retained = append(retained, candidate) }",
+    )
+    source = _once(
+        source,
+        "\t\tretain(candidate)\n\t\torder := counts[\"queued\"] + 1",
+        "\t\tpreparedByPackage[pack.Key()] = candidate\n"
+        "\t\tretain(candidate)\n\t\torder := counts[\"queued\"] + 1",
+    )
+    source = _once(
+        source,
+        "\t\tt.Fatal(\"pre-cap counters or saved N selector witness failed\")\n\t}\n}",
+        "\t\tt.Fatal(\"pre-cap counters or saved N selector witness failed\")\n\t}\n"
+        "\tif err := researchRunRelinearizeB4(t, job, searchCtx, plan.Actor, plan.Anchor.Assignment, actualFeasible, rows, preparedByPackage, screens, solverFor, cfg, queueSHA, witnessPass, selectorRows); err != nil {\n"
+        "\t\tt.Fatal(err)\n\t}\n}",
+    )
+    source = _once(
+        source,
+        "\tif ResearchPrecapRunNeutralCalls != 0 || search.ResearchPrecapRefineCalls != 0 ||\n"
+        "\t\tengineclient.ResearchPrecapOrdinaryCalls != 0 || engineclient.ResearchPrecapCompactCalls != 0 ||\n"
+        "\t\tsetcontext.ResearchPrecapEngineProviderCalls != 0 {\n"
+        "\t\tt.Fatal(\"forbidden path guard was entered before diagnostic\")\n"
+        "\t}\n}\n\nfunc TestAdaptivePrecapB4Diagnostic",
+        "\tif ResearchPrecapRunNeutralCalls != 0 || search.ResearchPrecapRefineCalls != 0 ||\n"
+        "\t\tengineclient.ResearchPrecapOrdinaryCalls != 0 || engineclient.ResearchPrecapCompactCalls != 0 ||\n"
+        "\t\tsetcontext.ResearchPrecapEngineProviderCalls != 0 {\n"
+        "\t\tt.Fatal(\"forbidden path guard was entered before diagnostic\")\n"
+        "\t}\n\tresearchAdaptiveRelinearizeContractCheck(t)\n}\n\nfunc TestAdaptivePrecapB4Diagnostic",
+    )
+    return source.encode("utf-8")
+
+
+def relinearize_overlay() -> dict[str, Any]:
+    """Return the exact frozen base images plus the research-only delta."""
+    base = precap.precap_overlay()
+    images = dict(base["images"])
+    candidate_source = images["internal/search/candidates.go"].decode("utf-8")
+    candidate_source = _instrument_search(candidate_source)
+    images["internal/search/candidates.go"] = candidate_source.encode("utf-8")
+
+    overlay_files = dict(base["overlay_files"])
+    overlay_files["internal/allsets/zz_adaptive_precap_b4_test.go"] = _instrument_precap_helper(
+        overlay_files["internal/allsets/zz_adaptive_precap_b4_test.go"]
+    )
+    overlay_files["internal/search/zz_adaptive_relinearize_search.go"] = SEARCH_SOURCE.read_bytes()
+    overlay_files["internal/allsets/zz_adaptive_relinearize_b4_test.go"] = ALLSETS_HELPER.read_bytes()
+    overlay_files["internal/allsets/zz_adaptive_relinearize_contract_test.go"] = CONTRACT_TEST.read_bytes()
+
+    hashes = dict(base["hashes"])
+    hashes["pre_relinearization_patched_map_sha256"] = hashes.pop("patched_map_sha256")
+    hashes["pre_relinearization_helper_sha256"] = hashes.pop("helper_sha256")
+    hashes["patched_map_sha256"] = k.gate.digest({path: _sha(raw) for path, raw in images.items()})
+    hashes["helper_sha256"] = _sha(overlay_files["internal/allsets/zz_adaptive_precap_b4_test.go"])
+    hashes.update({
+        "relinearize_factory_sha256": _sha(Path(__file__).read_bytes()),
+        "relinearize_search_sha256": _sha(SEARCH_SOURCE.read_bytes()),
+        "relinearize_allsets_helper_sha256": _sha(ALLSETS_HELPER.read_bytes()),
+        "relinearize_contract_test_sha256": _sha(CONTRACT_TEST.read_bytes()),
+        "relinearize_fixture_request_sha256": _sha(FIXTURE_REQUEST.read_bytes()),
+        "relinearize_fixture_compact_ir_sha256": _sha(FIXTURE_COMPACT_IR.read_bytes()),
+        "relinearize_fixture_loader_source_sha256": _sha(FIXTURE_LOADER_SOURCE.read_bytes()),
+        "instrumented_candidates_sha256": _sha(images["internal/search/candidates.go"]),
+        "instrumented_precap_helper_sha256": _sha(overlay_files["internal/allsets/zz_adaptive_precap_b4_test.go"]),
+    })
+    metadata = dict(base["metadata"])
+    metadata.update({
+        "schema": "adaptive_relinearize_b4_overlay_v1",
+        "phase_order": ["original_524_queue_fsync", "original_16_selector_witness", "relinearize_available_queues", "improved_524_queue_fsync", "actual_improved_16_selector"],
+        "relinearize_policy": "current-gradient legal full-package assignment, exact reduced point retained as a diagnostic, strict exact full-DPS promotion only, max five rounds; zero gradient is recorded but still proceeds to legal assignment; stop on repeated assignment/no strict full improvement/context/budget",
+        "relinearize_queued_rows": "all original queued actor-3 packages one at a time",
+        "original_queue_and_result_immutable": True,
+        "engine_calls": 0,
+        "RunNeutral_calls": 0,
+        "RefineCandidates_calls": 0,
+        "ordinary_engine_calls": 0,
+        "fresh_capture_calls": 0,
+        "new_search_framework": False,
+        "selector_policy_body_changed": False,
+        "old_winner_input": False,
+        "actual_fixture_contract": "accepted searchFixtures request_v1.json + compact_ir_v1.json; fixture loader source pinned; root resolved from GTT_TIGHNARI_REPLAY_REPO",
+    })
+    return {
+        **base,
+        "images": images,
+        "overlay_files": overlay_files,
