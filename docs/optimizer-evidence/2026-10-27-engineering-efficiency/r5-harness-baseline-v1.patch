+def require_sealed_wrapper(chasca, package, run_owned_pair):
+    """Validate an already loaded MAIN-owned sealed package; never load foreign code."""
+    package = Path(package)
+    chasca.gate.managed.assert_unlinked(package)
+    require(package.is_dir() and package.resolve(strict=True).is_relative_to(ROOT.resolve()),
+            "navia_sealed_main_package_required")
+    for name, expected in WRAPPER_PINS.items():
+        path = package / name
+        chasca.gate.managed.assert_unlinked(path)
+        require(path.is_file() and sha(path.read_bytes()) == expected, "navia_sealed_source_drift")
+    require(Path(run_owned_pair.__code__.co_filename).resolve() == (package / "main_adapter.py").resolve()
+            and Path(run_owned_pair.__globals__["core"].__file__).resolve() == (package / "pair_core.py").resolve(),
+            "navia_sealed_callable_binding")
+    return package / "navia_exact_pair_test.go"
