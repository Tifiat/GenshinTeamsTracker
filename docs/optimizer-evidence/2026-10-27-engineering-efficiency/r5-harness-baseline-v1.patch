+def _validate_stabilization(stabilization: Any, assignment: Any, input_dps: Any, allowance: Any) -> None:
+    local_pair._assignment(assignment, "input_assignment")
+    anchor_dps = local_pair._number(input_dps, "input_dps")
+    local_pair._integer(allowance, "allowance", 20000)
+    if not isinstance(stabilization, dict):
+        raise ValueError("full actual final stabilization absent")
+    expanded = local_pair._integer(stabilization.get("evaluations"), "evaluations", allowance)
+    accepted = local_pair._integer(stabilization.get("accepted"), "accepted", expanded)
+    local_pair._scored(stabilization.get("leader"), "leader")
+    if stabilization["leader"]["dps"] < anchor_dps - 1e-10 * (1 + anchor_dps):
+        raise ValueError("final stabilization lost its input leader")
+    if type(stabilization.get("single_stationary")) is not bool or not stabilization.get("stop"):
+        raise ValueError("stationarity or stop reason absent")
+    summary = stabilization.get("pair_completion")
+    if (not isinstance(summary, dict) or summary.get("schema") != "final_stagnation_pair_completion_v1"
+            or type(summary.get("pair_coverage_complete")) is not bool
+            or summary.get("accepted_sequence_overflow") is not False or not summary.get("stop")
+            or "pair_coverage_base" not in summary):
+        raise ValueError("explicit pair coverage/overflow/stop absent")
+    for key in ("passes", "recovery_passes", "pair_expanded"):
+        local_pair._integer(summary.get(key), key)
+    if (summary["passes"] < 1 or summary["recovery_passes"] > summary["passes"]
+            or summary["pair_expanded"] > expanded):
+        raise ValueError("final stabilization phase counts disagree")
+    for key in ("normal_stabilize_seconds", "pair_completion_seconds", "total_seconds"):
+        local_pair._number(summary.get(key), key)
+    sequence = summary.get("accepted_sequence")
+    if not isinstance(sequence, list) or len(sequence) != accepted:
+        raise ValueError("accepted sequence absent or truncated")
+    previous = anchor_dps
+    for row in sequence:
+        local_pair._scored(row, "accepted_sequence")
+        if not row["dps"] > previous + 1e-9 * (1 + abs(previous)):
+            raise ValueError("accepted sequence not strictly full-score improving")
+        previous = row["dps"]
+    leader = stabilization["leader"]
+    if sequence:
+        if any(sequence[-1][key] != leader[key] for key in ("assignment", "dps")):
+            raise ValueError("leader does not equal last accepted tuple")
+    elif leader["assignment"] != assignment or abs(leader["dps"] - anchor_dps) > 1e-10 * (1 + anchor_dps):
+        raise ValueError("leader changed without acceptance")
+    actors = summary.get("actors")
+    if not isinstance(actors, list) or len(actors) != 4:
+        raise ValueError("four actor ledgers absent")
+    integer_fields = (
+        "calls", "free_product", "candidate_pairs", "gate_allowed_pairs", "base_id_skips", "duplicate_skips",
+        "point_calls", "expanded", "pair_point_expanded", "invalid_assignments", "gate_plans", "gate_fallbacks",
+        "gate_validation_checks", "gate_pool_metadata_checks", "partner_repair_witnesses",
+        "left_partner_repair_witnesses", "right_partner_repair_witnesses", "candidate_run_calls", "gradient_calls",
+        "finish_calls", "returned_finalist_rows",
+    )
+    for actor, stats in enumerate(actors):
+        if not isinstance(stats, dict) or type(stats.get("actor")) is not int or stats["actor"] != actor:
+            raise ValueError("actor ledger order missing")
+        if "base_assignment" not in stats:
+            raise ValueError("explicit actor base absent, including not-started actors")
+        for key in integer_fields:
+            local_pair._integer(stats.get(key), "actor." + key)
+        for key in ("setup_seconds", "guide_seconds", "pool_seconds", "gate_seconds", "pair_point_seconds",
+                    "finish_seconds", "total_seconds"):
+            local_pair._number(stats.get(key), "actor." + key)
+        if type(stats.get("coverage_complete")) is not bool or not stats.get("stop"):
+            raise ValueError("explicit actor coverage/stop absent")
+        widths = stats.get("pool_widths")
+        if not isinstance(widths, list) or len(widths) != 5:
+            raise ValueError("actor pool widths absent")
+        for width in widths:
+            local_pair._integer(width, "pool_width")
+        if stats["calls"]:
+            local_pair._assignment(stats.get("base_assignment"), "actor.base_assignment")
+        if stats["pair_point_expanded"] != stats["expanded"] or stats["gate_plans"] > 20 * stats["calls"]:
+            raise ValueError("pair/gate counts disagree")
+    if sum(stats["expanded"] for stats in actors) != summary["pair_expanded"]:
+        raise ValueError("actor and summary pair expansions disagree")
+    if summary["stop"] in ("pair_fringe_incomplete", "budget_exhausted_before_fringe") and not stabilization["single_stationary"]:
+        raise ValueError("unchanged partial pass lost proved N1")
+    if summary["stop"] == "accepted_gain_restart_n1" and (stabilization["single_stationary"] or not accepted):
+        raise ValueError("accepted gain retained stale N1")
+    if summary["pair_coverage_complete"]:
+        local_pair._assignment(summary.get("pair_coverage_base"), "pair_coverage_base")
+        if (summary["recovery_passes"] < 1 or not stabilization["single_stationary"]
+                or summary["pair_coverage_base"] != leader["assignment"]
+                or any(stats["calls"] < 1 or not stats["coverage_complete"]
+                       or stats["base_assignment"] != summary["pair_coverage_base"] for stats in actors)):
+            raise ValueError("coverage does not refer to current stationary leader")
+
+
