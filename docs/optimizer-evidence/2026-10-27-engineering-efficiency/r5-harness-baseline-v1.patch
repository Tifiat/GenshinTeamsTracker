+def semantic(value, path=()):
+    if type(value) is dict:
+        return {key: semantic(item, path + (key,)) for key, item in value.items()
+                if not (len(path) == 2 and path[0] == "search_work" and key in {"CaptureSeconds", "SearchSeconds"})
+                and not (len(path) == 2 and path[0] == "neutral_package_joint" and key == "Seconds")
+                and not (len(path) == 2 and path[0] == "neutral_cycles" and key in CYCLE_PERF)}
+    if type(value) is list:
+        return [semantic(item, path + (i,)) for i, item in enumerate(value)]
+    return gate.exact(value)
