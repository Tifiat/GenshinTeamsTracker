+    names = re.findall(r"^func (TestAdaptiveHybridContractFinalPairCompletion\w*)\(t \*testing\.T\)",
+                       producer.ALLSETS_CONTRACT.read_text(encoding="utf-8"), re.MULTILINE)
+    if len(names) < 2 or len(names) != len(set(names)):
+        raise ValueError("focused All Sets contract test names are absent or duplicated")
+    return names
+
+
+def _source_pins(overlay: dict[str, Any]) -> dict[str, str]:
+    paths = tuple(dict.fromkeys((
+        *producer.SOURCE_FILES, *prior.producer.SOURCE_FILES,
+        *(Path(module.__file__) for module in prior._RUNTIME_MODULES),
+        *prior._RUNTIME_FILES, Path(prior.__file__), Path(__file__),
+    )))
+    pins = {path.relative_to(k.ROOT).as_posix(): prior._bounded_file_sha(path, MAX_SOURCE_PIN_BYTES)[0]
+            for path in paths}
+    pins.update({"image:" + path: k.sha(raw) for path, raw in overlay["images"].items()})
+    pins.update({"overlay:" + path: k.sha(raw) for path, raw in overlay["overlay_files"].items()})
+    return pins
+
+
+def _frozen_plan(overlay: dict[str, Any], inputs: dict[str, dict[str, Any]]) -> dict[str, Any]:
+    names = _contract_names()
+    return {
+        "schema": "final_stagnation_pair_completion_run_freeze_v1",
+        "metadata": overlay["metadata"],
+        "source_pins": _source_pins(overlay),
+        "overlay_hashes": overlay["hashes"],
+        "saved_input_pins": {name: row["sha256"] for name, row in inputs.items()},
+        "focused_contract_names": names,
+        "limits": {
+            "whole_seconds_including_cleanup": WHOLE_SECONDS,
+            "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
+            "compile_seconds_max": COMPILE_SECONDS,
+            "contracts_seconds_max": CONTRACT_SECONDS,
+            "diagnostic_seconds_max": DIAGNOSTIC_SECONDS,
+            "stabilize_seconds_max": STABILIZE_SECONDS,
+            "go_mem_limit": "2GiB", "managed_jobs_created_max": 1,
+            "candidate_builds": 1, "saved_d_outer_stabilize_calls": 1,
+            "contract_execution_scope": "synthetic fixtures and real domain/search APIs; no saved-D diagnostic execution",
+            "stabilize_allowance": 20000, "actors": "uniform all four; shared allowance may stop early",
+            "result_bytes_max": MAX_RESULT_BYTES, "log_bytes_max": MAX_LOG_BYTES,
+            "source_pin_file_bytes_max": MAX_SOURCE_PIN_BYTES,
+            "saved_input_file_bytes_max": prior.MAX_SAVED_INPUT_FILE_BYTES,
+            "saved_input_total_bytes_max": prior.MAX_SAVED_INPUT_TOTAL_BYTES,
+            "RunNeutral": 0, "ordinary_calls": 0, "new_engine_captures": 0,
+            "installs": 0, "retries": 0,
+        },
+        "commands": [
+            "go -C <native> test -c -p=1 -mod=readonly -buildvcs=false -overlay=<job>/overlay.json -o <job>/final-pair-completion.exe ./internal/allsets",
+            "<job>/final-pair-completion.exe -test.run=^(" + "|".join(names) + ")$ -test.v -test.parallel=1 -test.timeout=30s",
+            "<job>/final-pair-completion.exe -test.run=^" + DIAGNOSTIC_TEST + "$ -test.v -test.parallel=1 -test.timeout=180s",
+        ],
+        "evidence_prefix": PREFIX,
+        "runtime_projection_input": "adaptive-damped-whole-candidate-projection.json.gz only",
+        "p_projection_read": False,
+        "coverage_boundary": "completed fringe only; both-outsider pairs and three-slot changes unsearched; partial budget is an explicit diagnostic outcome",
+    }
+
+
+def frozen_plan() -> dict[str, Any]:
+    return _frozen_plan(producer.final_stagnation_pair_completion_overlay(), _input_pins())
+
+
+def _verify_named_tests(raw: str, expected: list[str]) -> None:
+    runs = re.findall(r"^=== RUN\s+(\w+)\s*$", raw, re.MULTILINE)
+    passes = re.findall(r"^--- PASS: (\w+) \(", raw, re.MULTILINE)
+    if (sorted(runs) != sorted(expected) or sorted(passes) != sorted(expected)
+            or "no tests to run" in raw or "--- FAIL:" in raw or "--- SKIP:" in raw):
+        raise ValueError("named tests did not each execute and pass exactly once")
+
+
+def _export_job(job: Path, record: dict[str, Any]) -> None:
+    exports = record.setdefault("lossless_exports", {})
+    for path in (job / RESULT_NAME, *sorted(job.glob(PREFIX + "*.log"))):
+        if not path.is_file():
+            continue
+        limit = MAX_RESULT_BYTES if path.name == RESULT_NAME else MAX_LOG_BYTES
+        if path.stat().st_size > limit:
+            raise ValueError("pair-completion export exceeds bound: " + path.name)
+        raw = path.read_bytes()
+        if len(raw) > limit or len(raw) != path.stat().st_size:
+            raise ValueError("pair-completion export changed while reading: " + path.name)
+        exports[path.name] = previous._write_gzip_once(raw, k.EVIDENCE / (path.name + ".gz"))
+        if path.name == RESULT_NAME:
+            try:
+                parsed = json.loads(raw)
+                record["raw_result_summary"] = {key: parsed.get(key) for key in (
+                    "schema_kind", "status", "complete", "errors", "stabilize_calls",
+                    "stabilize_cancelled", "stabilize_error", "setup_seconds", "stabilize_seconds", "wall_seconds")}
+                observed_calls = parsed.get("stabilize_calls")
+                if type(observed_calls) is int and observed_calls >= 0:
+                    record["stabilize_calls"] = observed_calls
+            except Exception as failure:
+                record["raw_result_summary_error"] = str(failure)
+
+
+def _integer(value: Any, label: str, maximum: int | None = None) -> int:
+    if type(value) is not int or value < 0 or (maximum is not None and value > maximum):
+        raise ValueError("missing or out-of-range integer: " + label)
+    return value
+
+
+def _number(value: Any, label: str) -> float:
+    if type(value) not in (int, float) or not math.isfinite(value) or value < 0:
+        raise ValueError("missing or nonfinite/nonnegative number: " + label)
+    return value
+
+
+def _assignment(value: Any, label: str) -> None:
+    if (not isinstance(value, list) or len(value) != 4
+            or any(not isinstance(row, list) or len(row) != 5 for row in value)
+            or any(type(item) is not int or item <= 0 for row in value for item in row)
+            or len({item for row in value for item in row}) != 20):
+        raise ValueError("invalid complete assignment: " + label)
+
+
+def _scored(value: Any, label: str) -> None:
+    if not isinstance(value, dict) or not isinstance(value.get("source"), str):
+        raise ValueError("missing full-scored assignment: " + label)
+    _assignment(value.get("assignment"), label)
+    _number(value.get("dps"), label + ".dps")
+
+
+def _validate_result(path: Path, input_pins: dict[str, dict[str, Any]]) -> dict[str, Any]:
+    if not path.is_file() or path.stat().st_size > MAX_RESULT_BYTES:
+        raise ValueError("pair-completion result absent or over bound")
+    result = json.loads(path.read_bytes())
+    if (not isinstance(result, dict) or result.get("schema_kind") != "final_stagnation_pair_completion_v1"
+            or result.get("status") != "complete" or result.get("complete") is not True
+            or result.get("errors") != []):
+        raise ValueError("pair-completion diagnostic is incomplete")
+    expected_inputs = {row["path"]: row["sha256"] for row in input_pins.values()}
+    if result.get("input_sha256") != expected_inputs:
+        raise ValueError("saved-D runtime read set differs from input pins")
+    if result.get("request_identity_sha256") != "15f66332eed4bafa85567d60e554e5c8fcac7ce14f0fc8454e6504ad6b45a4cd":
+        raise ValueError("request identity differs from saved D")
+    if result.get("context_sha256") != "83db92e9e66131ece23f9d9de71d09b6e7d6678a6f8185d12792fa60ba7d618a":
+        raise ValueError("context differs from saved D")
+    if result.get("graph_sha256") != "38fcbfd36bf85a185e607072971cb18e0aae96d3c813de366334e0b1e4e93ad9":
+        raise ValueError("graph differs from saved D")
+    if (result.get("anchor_assignment") != prior._EXPECTED_ANCHOR
+            or result.get("packages") != prior._EXPECTED_PACKAGES
+            or result.get("search_config") != prior._EXPECTED_SEARCH_CONFIG):
+        raise ValueError("anchor, packages or search configuration differs from saved D")
+    anchor_dps = _number(result.get("anchor_saved_formula_dps"), "anchor_saved_formula_dps")
+    if abs(anchor_dps - prior._EXPECTED_ANCHOR_DPS) > 1e-10 * (1 + abs(prior._EXPECTED_ANCHOR_DPS)):
+        raise ValueError("saved anchor DPS differs")
+    for key, expected in (("stabilize_calls", 1), ("run_neutral_calls", 0), ("ordinary_calls", 0),
+                          ("new_engine_capture_calls", 0), ("saved_capture_provider_calls", 1),
+                          ("saved_capture_seed_members", 2), ("stabilize_allowance", 20000)):
+        if type(result.get(key)) is not int or result[key] != expected:
+            raise ValueError("call/source count differs: " + key)
+    if result.get("stabilize_cancelled") is not False or result.get("stabilize_error"):
+        raise ValueError("saved-D stabilization cancelled or errored; preserve partial export")
+    for key in ("setup_seconds", "stabilize_seconds", "wall_seconds"):
+        _number(result.get(key), key)
+    if result["stabilize_seconds"] > STABILIZE_SECONDS or result["wall_seconds"] > DIAGNOSTIC_SECONDS:
+        raise ValueError("saved-D diagnostic exceeded its finite limit")
+    stabilization = result.get("stabilization")
+    if not isinstance(stabilization, dict):
+        raise ValueError("actual Stabilization is absent")
+    expanded = _integer(stabilization.get("evaluations"), "evaluations", 20000)
+    accepted = _integer(stabilization.get("accepted"), "accepted", expanded)
+    _scored(stabilization.get("leader"), "leader")
+    if stabilization["leader"]["dps"] < anchor_dps - 1e-10 * (1 + anchor_dps):
+        raise ValueError("stabilization lost the saved anchor")
+    if type(stabilization.get("single_stationary")) is not bool or not stabilization.get("stop"):
+        raise ValueError("stationarity or stop reason is absent")
+    summary = stabilization.get("pair_completion")
+    if (not isinstance(summary, dict) or summary.get("schema") != "final_stagnation_pair_completion_v1"
+            or type(summary.get("pair_coverage_complete")) is not bool
+            or summary.get("accepted_sequence_overflow") is not False or not summary.get("stop")):
+        raise ValueError("pair-completion coverage/overflow summary is absent")
+    for key in ("passes", "recovery_passes", "pair_expanded"):
+        _integer(summary.get(key), key)
+    if summary["passes"] < 1 or summary["recovery_passes"] > summary["passes"] or summary["pair_expanded"] > expanded:
+        raise ValueError("phase counters disagree")
+    for key in ("normal_stabilize_seconds", "pair_completion_seconds", "total_seconds"):
+        _number(summary.get(key), key)
+    sequence = summary.get("accepted_sequence")
+    if not isinstance(sequence, list) or len(sequence) != accepted:
+        raise ValueError("actual accepted sequence is missing or truncated")
+    previous_dps = anchor_dps
+    for index, row in enumerate(sequence):
+        _scored(row, "accepted_sequence[" + str(index) + "]")
+        if not row["dps"] > previous_dps + 1e-9 * (1 + abs(previous_dps)):
+            raise ValueError("accepted sequence is not strictly full-score improving")
+        previous_dps = row["dps"]
+    if sequence and any(sequence[-1][key] != stabilization["leader"][key] for key in ("assignment", "dps")):
+        raise ValueError("final leader differs from last accepted assignment")
+    if not sequence and stabilization["leader"]["assignment"] != prior._EXPECTED_ANCHOR:
+        raise ValueError("leader changed without an acceptance record")
+    if not sequence and abs(stabilization["leader"]["dps"] - anchor_dps) > 1e-10 * (1 + abs(anchor_dps)):
+        raise ValueError("leader score changed without an acceptance record")
+    actors = summary.get("actors")
+    if not isinstance(actors, list) or len(actors) != 4:
+        raise ValueError("four actor ledgers are absent")
+    integer_fields = (
+        "calls", "free_product", "candidate_pairs", "gate_allowed_pairs", "base_id_skips", "duplicate_skips",
+        "point_calls", "expanded", "pair_point_expanded", "invalid_assignments", "gate_plans", "gate_fallbacks",
+        "gate_validation_checks", "gate_pool_metadata_checks", "partner_repair_witnesses",
+        "left_partner_repair_witnesses", "right_partner_repair_witnesses", "candidate_run_calls", "gradient_calls",
+        "finish_calls", "returned_finalist_rows",
+    )
+    for actor, stats in enumerate(actors):
+        if not isinstance(stats, dict) or type(stats.get("actor")) is not int or stats["actor"] != actor:
+            raise ValueError("actor ledger order differs")
+        for key in integer_fields:
+            _integer(stats.get(key), "actor." + key)
+        for key in ("setup_seconds", "guide_seconds", "pool_seconds", "gate_seconds", "pair_point_seconds", "finish_seconds", "total_seconds"):
+            _number(stats.get(key), "actor." + key)
+        if type(stats.get("coverage_complete")) is not bool or not stats.get("stop"):
+            raise ValueError("actor coverage/stop is absent")
+        widths = stats.get("pool_widths")
+        if not isinstance(widths, list) or len(widths) != 5:
+            raise ValueError("actor pool widths absent")
+        for width in widths:
+            _integer(width, "pool_width")
+        if stats["calls"]:
+            _assignment(stats.get("base_assignment"), "actor.base_assignment")
+        if stats["pair_point_expanded"] != stats["expanded"] or stats["gate_plans"] > 20 * stats["calls"]:
+            raise ValueError("actor pair/gate work disagrees")
+    if sum(stats["expanded"] for stats in actors) != summary["pair_expanded"]:
+        raise ValueError("actor expansions disagree with pair total")
+    if summary["stop"] in ("pair_fringe_incomplete", "budget_exhausted_before_fringe") and not stabilization["single_stationary"]:
+        raise ValueError("unchanged partial pair pass lost proved N1 stationarity")
+    if summary["stop"] == "accepted_gain_restart_n1" and (stabilization["single_stationary"] or not accepted):
+        raise ValueError("accepted gain reported stale N1 stationarity")
+    if summary["pair_coverage_complete"]:
+        _assignment(summary.get("pair_coverage_base"), "pair_coverage_base")
+        if (summary["recovery_passes"] < 1 or not stabilization["single_stationary"]
+                or summary["pair_coverage_base"] != stabilization["leader"]["assignment"]
+                or any(stats["calls"] < 1 or not stats["coverage_complete"] or stats["base_assignment"] != summary["pair_coverage_base"] for stats in actors)):
+            raise ValueError("completed coverage does not refer to final stationary leader")
+    return result
+
+
+def run(destination: Path, freeze_path: Path) -> dict[str, Any]:
+    started = time.monotonic()
+    if destination.exists():
+        raise FileExistsError(destination)
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("run with repository .venv/Scripts/python.exe")
+    overlay = producer.final_stagnation_pair_completion_overlay()
+    inputs = _input_pins()
+    plan = _frozen_plan(overlay, inputs)
+    freeze_raw = freeze_path.read_bytes()
+    freeze = json.loads(freeze_raw)
+    if freeze.get("source_review_status") != "approved" or freeze.get("frozen_plan") != plan:
+        raise ValueError("approved exact source freeze is required")
+    pins, protected_before, native_before = _source_pins(overlay), k.protected(), k.old.native_map()
+    active: list[Path | None] = [None]
+    record: dict[str, Any] = {
+        "schema": "final_stagnation_pair_completion_run_v1", "status": "started", "errors": [],
+        "freeze_path": str(freeze_path), "freeze_sha256": k.sha(freeze_raw), "frozen_plan": plan,
+        "saved_input_pins": inputs, "protected_before": protected_before,
+        "accepted_native_map_before_sha256": k.gate.digest(native_before), "source_pins_before": pins,
+        "managed_jobs_created": 0, "remaining_managed_jobs": None, "build_launches": 0,
+        "contract_launches": 0, "diagnostic_launches": 0, "stabilize_calls": None,
+        "RunNeutral": 0, "ordinary_calls": 0, "new_engine_captures": 0, "installs": 0, "retries": 0,
+        "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
+    }
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")) or k.gate.retirement._default_process_probe(k.ROOT):
+        raise RuntimeError("managed jobs/processes not idle; no attempt started")
+    targets = [destination, k.EVIDENCE / (RESULT_NAME + ".gz")]
+    targets.extend(k.EVIDENCE / (PREFIX + label + ".log.gz") for label in ("compile", "contracts", "diagnostic"))
+    for target in targets:
+        if target.exists():
+            raise FileExistsError(target)
+    with destination.open("xb") as stream:
+        def save() -> None:
+            k.gate.io._save(stream, record)
+
+        def export() -> None:
+            if active[0] is not None:
+                _export_job(active[0], record)
+            save()
+
+        def body(job: Path) -> None:
+            active[0] = job
+            record["managed_jobs_created"] = 1
+            env, _ = k.gate.common._environment(job)
+            env.update(GOMEMLIMIT="2GiB", GTT_TIGHNARI_REPLAY_REPO=str(k.ROOT), GTT_FINAL_PAIR_COMPLETION="root_released_once")
+            overlay_path, manifest = staging.stage_overlay(job, overlay, native_before)
+            record["staging_manifest"] = manifest
+            binary = job / "final-pair-completion.exe"
+
+            def command(args: list[str], label: str, limit: int) -> None:
+                remaining = WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE_SECONDS
+                if remaining <= 0:
+                    raise TimeoutError("cleanup reserve reached before " + label)
+                record["stage"] = label
+                record.setdefault("command_timeouts_seconds", {})[label] = min(limit, remaining)
+                save()
+                result = k.gate.owned._run_owned(args, command_kind=label, env=env,
+                    log_path=job / (PREFIX + label + ".log"), timeout_seconds=min(limit, remaining))
+                record.setdefault("commands", {})[label] = result
+                save()
+                if not k.gate.command_passed(result):
+                    log = job / (PREFIX + label + ".log")
+                    if log.exists():
+                        record["failure_tail"] = log.read_text(encoding="utf-8", errors="replace")[-6000:]
+                        save()
+                    raise RuntimeError(label + " failed")
+
+            record["build_launches"] = 1
+            command([str(k.gate.owned.GO_EXE), "-C", str(k.NATIVE), "test", "-c", "-p=1", "-mod=readonly",
+                     "-buildvcs=false", "-overlay=" + str(overlay_path), "-o", str(binary), "./internal/allsets"],
+                    "compile", COMPILE_SECONDS)
+            record["binary_sha256"] = k.sha(binary.read_bytes())
+            names = plan["focused_contract_names"]
+            record["contract_launches"] = 1
+            command([str(binary), "-test.run=^(" + "|".join(names) + ")$", "-test.v", "-test.parallel=1",
+                     "-test.timeout=" + str(CONTRACT_SECONDS) + "s"], "contracts", CONTRACT_SECONDS)
+            _verify_named_tests((job / (PREFIX + "contracts.log")).read_text(encoding="utf-8", errors="replace"), names)
+            record["focused_contract_names_passed"] = names
+            remaining = WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE_SECONDS
+            if remaining < DIAGNOSTIC_SECONDS:
+                raise TimeoutError("full saved-D diagnostic does not fit with cleanup reserve")
+            record["diagnostic_launches"] = 1
+            command([str(binary), "-test.run=^" + DIAGNOSTIC_TEST + "$", "-test.v", "-test.parallel=1",
+                     "-test.timeout=" + str(DIAGNOSTIC_SECONDS) + "s"], "diagnostic", DIAGNOSTIC_SECONDS)
+            _verify_named_tests((job / (PREFIX + "diagnostic.log")).read_text(encoding="utf-8", errors="replace"), [DIAGNOSTIC_TEST])
+            if k.protected() != protected_before or k.old.native_map() != native_before:
+                raise RuntimeError("protected profile/native source changed")
+            if _source_pins(overlay) != pins or _input_pins() != inputs:
+                raise RuntimeError("pinned source/saved inputs changed")
+            _export_job(job, record)
+            try:
+                result = _validate_result(job / RESULT_NAME, inputs)
+            except Exception as failure:
+                record["result_validation_error"] = str(failure)
+                save()
+                raise
+            record["diagnostic_summary"] = {key: result[key] for key in (
+                "context_sha256", "graph_sha256", "stabilize_calls", "stabilization", "setup_seconds", "stabilize_seconds", "wall_seconds")}
+            record["stabilize_calls"] = result["stabilize_calls"]
+            record["preservation_exact_before_cleanup"] = True
+            record["status"] = "complete"
+            save()
+
+        try:
+            k.gate.run_owned_body(None, record, export, body)
+        except Exception as failure:
+            record["status"] = "failed"
+            record["errors"].append(str(failure))
+            try:
+                export()
+            except Exception as export_failure:
+                record["export_error"] = str(export_failure)
+                save()
+        finally:
+            protected_after, native_after = k.protected(), k.old.native_map()
+            record["protected_after"] = protected_after
+            record["accepted_native_map_after_sha256"] = k.gate.digest(native_after)
+            record["preservation_exact_after_cleanup"] = protected_after == protected_before and native_after == native_before
+            try:
+                record["source_pins_after_cleanup"] = _source_pins(overlay)
+                record["source_pins_exact_after_cleanup"] = record["source_pins_after_cleanup"] == pins
+            except Exception as failure:
+                record["source_pins_exact_after_cleanup"] = False
+                record["source_pin_postflight_error"] = str(failure)
+            try:
+                record["saved_input_pins_after_cleanup"] = _input_pins()
+                record["saved_inputs_exact_after_cleanup"] = record["saved_input_pins_after_cleanup"] == inputs
+            except Exception as failure:
+                record["saved_inputs_exact_after_cleanup"] = False
+                record["saved_input_postflight_error"] = str(failure)
+            record["remaining_managed_jobs"] = len(tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")))
+            record["optimizer_processes_remaining"] = bool(k.gate.retirement._default_process_probe(k.ROOT))
+            record["whole_wall_seconds"] = round(time.monotonic() - started, 3)
+            record["lease_status"] = record.get("cleanup_status", "unknown")
+            if (record["whole_wall_seconds"] > WHOLE_SECONDS or not record["preservation_exact_after_cleanup"]
+                    or record["remaining_managed_jobs"] != 0 or record["optimizer_processes_remaining"]
+                    or record["lease_status"] != "confirmed" or not record["source_pins_exact_after_cleanup"]
+                    or not record.get("saved_inputs_exact_after_cleanup", False)):
+                record["status"] = "failed"
+                record["errors"].append("postflight wall, preservation, processes, source/input pins or cleanup failed")
+            save()
+    return record
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--freeze", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    result = run(args.output, args.freeze)
+    print(json.dumps({key: result.get(key) for key in (
+        "status", "errors", "stage", "whole_wall_seconds", "diagnostic_summary", "managed_jobs_created",
+        "remaining_managed_jobs", "lease_status", "preservation_exact_after_cleanup", "source_pins_exact_after_cleanup")}))
+    return 0 if result.get("status") == "complete" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
