+def _child_environment(
+    job: Path,
+    *,
+    case_id: str,
+    mode: str,
+    lease_id: str,
+    engine_store: Path,
+    optimizer_binary: Path,
+) -> dict[str, str]:
+    paths = {
+        "temp": job / "temp",
+        "appdata_roaming": job / "appdata" / "roaming",
+        "appdata_local": job / "appdata" / "local",
+        "xdg_config": job / "xdg" / "config",
+        "xdg_cache": job / "xdg" / "cache",
+        "xdg_state": job / "xdg" / "state",
+        "rules": job / "rules",
+        "inputs": job / "case-inputs",
+        "runs": job / "saved-runs",
+    }
+    for path in paths.values():
+        path.mkdir(parents=True, exist_ok=True)
+    environment = dict(os.environ)
+    # Keep the disposable run from inheriting an account selection. The fixture
+    # code uses only its caller-provided DB path and the installed public engine.
+    environment.pop("GTT_ACCOUNT_PROFILE", None)
+    environment.update({
+        "GTT_SCRATCH_DIR": str(job),
+        "GTT_OPTIMIZER_BUTTON_ENGINE_STORE": str(engine_store),
+        "GTT_OPTIMIZER_BUTTON_TEST_BINARY": str(optimizer_binary),
