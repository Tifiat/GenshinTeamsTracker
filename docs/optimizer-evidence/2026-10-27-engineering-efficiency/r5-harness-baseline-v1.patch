+"""Finite archive-overlay sidecar lookup parity and saved-input benchmark.
+
+No engine, optimizer search, runtime installation or mutable native-source use.
+The caller must obtain coordinator review of the prepared freeze before --run.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+from pathlib import Path
+import statistics
+import sys
+import time
+
+from tools.experiments.gcsim.mvp_polish import candidate_preservation_run as scope
+from tools.experiments.gcsim.mvp_polish import candidate_preservation_measure as prior
+from tools.experiments.gcsim.mvp_polish.navia_exact_pair import function_view
+
+ROOT, NATIVE, EVIDENCE = scope.ROOT, scope.NATIVE, scope.EVIDENCE
+SOURCE = Path(__file__).with_name("node_lookup_source")
+DELTA = ("effect_inputs.go", "neutral_inputs.go", "onheal_roots.go", "dense_node_lookup.go")
+TEST = "dense_node_measure_test.go"
+FOCUSED = ("TestEffectSidecarRejectsCrossContextAndMalformedPorts",
+           "TestMissingEffectCapabilityDoesNotLaunchOrWrite",
+           "TestNeutralInputIdentityAndEventOrderValidation", "TestDenseNodeSavedParity")
+RESULT_SHA = "f56c634aad078e33fab02c06057c8366dae56f6b4fece076e31f01272585cc0b"
+RESEARCH_ONLY = ("cmd/gtt-optimizer/candidate_leader_research.go",
+    "cmd/gtt-optimizer/candidate_leader_research_test.go",
+    "cmd/gtt-optimizer/replacement_results_test.go",
+    "cmd/gtt-optimizer/research_winner_verification.go",
+    "cmd/gtt-optimizer/research_winner_verification_test.go")
+LIMITS = {"whole_seconds": 1440, "build_seconds": 240, "focus_seconds": 120,
+          "round_seconds": 90, "cleanup_reserve_seconds": 180, "scratch_bytes": 1 << 30}
+
+
+def canonical(value: object) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+
+
+def read(path: Path, cap: int = 96 << 20) -> bytes:
+    return scope.bounded(path, cap)
+
+
+def pins() -> dict:
+    gate = scope.accepted.K.gate
+    paths = [Path(__file__), *(SOURCE / n for n in (*DELTA, TEST)),
+             Path(scope.__file__), Path(prior.__file__), Path(scope.accepted.__file__),
+             Path(scope.cases.__file__), NATIVE/"go.mod", NATIVE/"go.sum",
+             *(Path(m.__file__) for m in (gate, gate.owned, gate.common,
+                 gate.lifecycle, gate.managed, gate.io, gate.retirement,
+                 scope.accepted.engine_store, scope.accepted.runtime,
+                 scope.accepted.runtime.prepare_v4, scope.accepted.K,
+                 scope.accepted.K.old)),
+             Path(function_view.__code__.co_filename),
+             Path(gate.owned.start_optimizer_process.__code__.co_filename),
+             Path(scope.accepted.complete.prior.retained._write_gzip_once.__code__.co_filename)]
+    paths.extend(NATIVE / name for name in (*RESEARCH_ONLY, *scope.accepted.FOREIGN_TEST_EXCLUSIONS))
+    paths.append(EVIDENCE / "candidate-preservation-tighnari-v2-freeze.json")
+    return {str(p.relative_to(ROOT)): (scope.sha(read(p)) if p.is_file() else "absent")
+            for p in paths}
+
+
+def base_images() -> dict[str, bytes]:
+    images = scope.accepted_product_images()
+    # The dirty live tree omits this call. Never use it as the control.
+    raw = images["internal/engineclient/neutral_inputs.go"]
+    if scope.sha(raw) != "8619244e760f40a58d398919afb1181e1df78283c2d0c2bdf3117f2a2237b4a3":
+        raise ValueError("dense_archived_health_baseline_changed")
+    if b"validateNeutralHealthRoots(n, nodes, len(owners))" not in raw:
+        raise ValueError("dense_health_guard_missing")
+    return images
+
+
+def image_hashes(images: dict[str, bytes]) -> dict:
+    return {k: scope.sha(v) for k, v in sorted(images.items())}
+
+
+def physical_exclusions() -> dict:
+    result_raw = read(EVIDENCE / "candidate-preservation-tighnari-v2-result.json")
+    if scope.sha(result_raw) != RESULT_SHA:
+        raise ValueError("dense_exclusion_receipt_drift")
+    frozen = read(EVIDENCE / "candidate-preservation-tighnari-v2-freeze.json")
+    if scope.sha(frozen) != json.loads(result_raw)["freeze_sha256"]:
+        raise ValueError("dense_exclusion_freeze_drift")
+    delta = json.loads(frozen)["delta_hashes"]
+    excluded = {}
+    for name in RESEARCH_ONLY:
+        actual = scope.sha(read(NATIVE / name))
+        if actual != delta[name]:
+            raise ValueError("dense_research_exclusion_changed")
+        excluded[name] = actual
+    for name in scope.accepted.FOREIGN_TEST_EXCLUSIONS:
+        excluded[name] = scope.sha(read(NATIVE / name))
+    return excluded
+
+
+def archived_inputs() -> list[dict]:
+    path = EVIDENCE / "candidate-preservation-tighnari-v2-result.json"
+    raw = read(path)
+    if scope.sha(raw) != RESULT_SHA:
+        raise ValueError("dense_saved_receipt_changed")
+    result = json.loads(raw)
+    files = {}
+    for stage in result["export_receipts"]:
+        raw = read(Path(stage["path"]))
+        if scope.sha(raw) != stage["sha256"]:
+            raise ValueError("dense_export_receipt_changed")
+        files.update(json.loads(raw)["files"])
+    inputs = []
+    for seed in (742031889, 742031890):
+        names = [k for k in files if k.startswith("candidate/verification/contexts/")
+                 and k.endswith(f"/seed-{seed}/member.json")]
+        if len(names) != 1:
+            raise ValueError("dense_capture_identity_ambiguous")
+        pair = {"seed": seed}
+        for role, name in (("member", names[0]), ("effect", names[0] + ".effects.json")):
+            item = files[name]["archive"]
+            packed = read(Path(item["path"]))
+            raw = gzip.decompress(packed)
+            if (scope.sha(packed) != item["compressed_sha256"]
+                    or len(packed) != item["compressed_bytes"]
+                    or scope.sha(raw) != item["raw_sha256"] or len(raw) != item["raw_bytes"]):
+                raise ValueError("dense_capture_archive_changed")
+            pair[role] = {"archive": item["path"], "gzip_sha256": item["compressed_sha256"],
+                          "raw_sha256": item["raw_sha256"], "raw_bytes": item["raw_bytes"]}
+            if role == "effect":
+                effect = json.loads(raw)
+                if effect["seed"] != str(seed) or effect["member_content_sha256"] != pair["member"]["raw_sha256"]:
+                    raise ValueError("dense_capture_join_changed")
+                pair.update(config_sha256=effect["input_config_sha256"],
+                            source_sha256=effect["source_manifest_body_sha256"])
+        inputs.append(pair)
+    return inputs
+
+
+def prepare(path: Path) -> dict:
+    if path.parent.resolve() != EVIDENCE.resolve() or path.exists():
+        raise ValueError("dense_freeze_path")
+    base = base_images()
+    plan = {"schema": "dense_node_measure_v1", "source_pins": pins(), "limits": LIMITS,
+            "baseline_images": len(base), "baseline_image_map_sha256": scope.sha(canonical(image_hashes(base))),
+            "baseline_archive_sha256": scope.accepted.ACCEPTED_ARCHIVE_MANIFEST_SHA,
+            "port_manifest_sha256": scope.accepted.PORT_MANIFEST_SHA,
+            "physical_overlay_deletions": physical_exclusions(),
+            "inputs": archived_inputs(), "saved_result_sha256": RESULT_SHA,
+            "python_sha256": scope.sha(read(Path(sys.executable))),
+            "go_sha256": scope.sha(read(scope.accepted.K.gate.owned.GO_EXE)),
+            "engine_sha256": scope.ENGINE_SHA, "consumer_sha256": scope.CONSUMER_SHA,
+            "focused_names": list(FOCUSED), "rounds": [["control", "candidate"],
+                ["candidate", "control"], ["control", "candidate"]],
+            "scope": "archive-only node lookup; full read/decode and sidecar-only; no engine/search/install"}
+    scope.cases.write_once(path, plan)
+    return {"freeze_path": str(path), "sha256": scope.sha(read(path)),
+            "baseline_images": len(base), "input_count": 2}
+
+
+def stage_overlay(job: Path, arm: str, base: dict[str, bytes]) -> dict:
+    images = dict(base)
+    images["internal/engineclient/" + TEST] = read(SOURCE / TEST)
+    if arm == "candidate":
+        for name in DELTA:
+            images["internal/engineclient/" + name] = read(SOURCE / name)
+    physical = {p.relative_to(NATIVE).as_posix() for p in NATIVE.rglob("*.go")}
+    excluded = physical_exclusions()
+    if physical - set(base) != set(excluded):
+        raise ValueError("dense_unlisted_physical_source")
+    replace = {}
+    for relative, raw in sorted(images.items()):
+        target = job / (arm + "-source") / relative
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(raw)
+        replace[str(NATIVE / relative)] = str(target)
+    # The pinned local Go fsys overlay contract treats an empty backing path as
+    # deletion. Apply it to BOTH arms, not merely to the source admission gate.
+    for relative in excluded:
+        replace[str(NATIVE / relative)] = ""
+    overlay = job / (arm + "-overlay.json")
+    scope.cases.write_once(overlay, {"Replace": replace})
+    written = json.loads(read(overlay))["Replace"]
+    if any(written.get(str(NATIVE / name)) != "" for name in excluded):
+        raise ValueError("dense_overlay_deletion_write_drift")
+    return {"path": str(overlay), "images": len(images),
+            "image_map_sha256": scope.sha(canonical(image_hashes(images))),
+            "deleted_physical_files": excluded}
+
+
+def stage_inputs(job: Path, frozen: list[dict]) -> Path:
+    staged = []
+    for item in frozen:
+        row = {k: item[k] for k in ("seed", "config_sha256", "source_sha256")}
+        for role in ("member", "effect"):
+            pin = item[role]
+            packed = read(Path(pin["archive"]))
+            raw = gzip.decompress(packed)
+            if scope.sha(packed) != pin["gzip_sha256"] or scope.sha(raw) != pin["raw_sha256"] or len(raw) != pin["raw_bytes"]:
+                raise ValueError("dense_input_drift")
+            target = job / f"seed-{item['seed']}-{role}.json"
+            target.write_bytes(raw)
+            if scope.sha(read(target)) != pin["raw_sha256"]:
+                raise ValueError("dense_input_write_drift")
+            row[role + "_path"] = str(target)
+            row[role + "_sha256"] = pin["raw_sha256"]
+        staged.append(row)
+    path = job / "inputs.json"
+    scope.cases.write_once(path, staged)
+    return path
+
+
+def summary(rows: list[dict]) -> dict:
+    output = {}
+    for phase in ("sidecar_decode_validate", "whole_read_decode_validate"):
+        output[phase] = {}
+        for metric in ("wall_ns", "alloc_bytes", "mallocs"):
+            series = {arm: [next(p for p in r[arm]["phases"] if p["name"] == phase)[metric]
+                            for r in rows] for arm in ("control", "candidate")}
+            for i in range(3):
+                left = next(p for p in rows[i]["control"]["phases"] if p["name"] == phase)
+                right = next(p for p in rows[i]["candidate"]["phases"] if p["name"] == phase)
+                if left["output_sha256"] != right["output_sha256"]:
+                    raise ValueError("dense_benchmark_output_mismatch")
+            control, candidate = series["control"], series["candidate"]
+            c, a = statistics.median(control), statistics.median(candidate)
+            output[phase][metric] = {"control_median": c, "control_range": [min(control), max(control)],
+                "candidate_median": a, "candidate_range": [min(candidate), max(candidate)],
+                "difference_of_medians": a-c,
+                "paired_delta_median": statistics.median([y-x for x, y in zip(control, candidate)]),
+                "difference_percent": 100*(a-c)/c if c else None}
+    return output
+
+
+def run(freeze: Path, output: Path, expected_sha256: str) -> dict:
+    gate = scope.accepted.K.gate
+    raw_freeze = read(freeze)
+    if not scope._digest(expected_sha256) or scope.sha(raw_freeze) != expected_sha256:
+        raise ValueError("dense_reviewed_freeze_digest_mismatch")
+    plan = json.loads(raw_freeze)
+    if (plan.get("schema") != "dense_node_measure_v1" or plan.get("limits") != LIMITS
+            or plan.get("source_pins") != pins() or plan.get("rounds") !=
+            [["control", "candidate"], ["candidate", "control"], ["control", "candidate"]]
+            or output.parent.resolve() != EVIDENCE.resolve() or output.exists()):
+        raise ValueError("dense_freeze_or_output_invalid")
+    base = base_images()
+    if (scope.sha(canonical(image_hashes(base))) != plan["baseline_image_map_sha256"]
+            or scope.sha(read(Path(sys.executable))) != plan["python_sha256"]
+            or scope.sha(read(gate.owned.GO_EXE)) != plan["go_sha256"]):
+        raise ValueError("dense_source_or_tool_drift")
+    if tuple(gate.managed.MANAGED_ROOT.glob("job-*")) or gate.retirement._default_process_probe(ROOT):
+        raise ValueError("dense_busy")
+    protected, native = scope.accepted.K.protected(), scope.accepted.K.old.native_map()
+    started = time.monotonic()
+    record = {"schema": "dense_node_result_v1", "status": "started", "errors": [],
+              "freeze_sha256": expected_sha256, "limits": LIMITS,
+              "independent_controller_review": plan.get("independent_controller_review"),
+              "protected_before": protected, "builds": 0, "installs": 0,
+              "engine_calls": 0, "search_calls": 0, "commands": {}, "rounds": []}
+    active = [None]
+    with output.open("xb") as stream:
+        def save(): gate.io._save(stream, record)
+
+        def export():
+            job = active[0]
+            if job is not None:
+                paths = [p for p in job.iterdir() if p.is_file() and
+                         (p.name.endswith(".log") or p.name in ("inputs.json", "fixed-engine-binding.json",
+                          "control-overlay.json", "candidate-overlay.json") or p.name.startswith("receipt-"))]
+                if sum(p.stat().st_size for p in paths) > 8 << 20:
+                    raise ValueError("dense_export_budget")
+                writer = function_view(scope.accepted.complete.prior.retained._write_gzip_once,
+                                       MAX_RAW_EXPORT_BYTES=8 << 20)
+                for path in paths:
+                    raw = read(path, 8 << 20)
+                    if path.name in record.get("exports", {}):
+                        if record["exports"][path.name]["raw_sha256"] != scope.sha(raw):
+                            raise ValueError("dense_export_mutated")
+                        continue
