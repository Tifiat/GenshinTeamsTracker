+def admitted_delta(base: dict[str, bytes], delta: dict[str, bytes],
+                   frozen_hashes: dict[str, str]) -> dict[str, bytes]:
+    """Overlay only a separately reviewed and hash-frozen candidate delta."""
+    if not delta or set(delta) != set(frozen_hashes):
+        raise ValueError("preservation_delta_missing_or_extra")
+    result = dict(base)
+    for relative, raw in delta.items():
+        parts = Path(relative).parts
+        if (not parts or parts[0] not in ("cmd", "internal")
+                or any(part in ("", ".", "..") for part in parts)
+                or not relative.endswith(".go") or type(raw) is not bytes
+                or sha(raw) != frozen_hashes[relative]):
+            raise ValueError("preservation_delta_path_or_hash")
+        result[relative] = raw
+    return result
+
+
+def fixed_binding(binding: dict, engine_binary: Path) -> dict:
+    """Require both fresh arms to use the current installed engine physics."""
+    if (type(binding) is not dict or binding.get("artifact_sha256") != ENGINE_SHA
+            or Path(binding.get("binary_path", "")).resolve(strict=True) != engine_binary.resolve(strict=True)
+            or sha(bounded(engine_binary)) != ENGINE_SHA):
+        raise ValueError("preservation_fixed_engine_changed")
+    return binding
+
+
+def case_inputs_equal(control: dict, candidate: dict) -> bool:
+    """Engine and consumer identities are separately pinned; request wire matches."""
+    if control != candidate:
+        raise ValueError("preservation_arm_input_drift")
+    if control.get("engine", {}).get("artifact_sha256") != ENGINE_SHA:
+        raise ValueError("preservation_arm_engine_drift")
+    if (len(control.get("artifacts", [])) not in (98, 597, 600)
+            or control.get("stochastic", {}).get("seeds") != cases.SEEDS):
+        raise ValueError("preservation_arm_fixture_drift")
+    return True
+
+
+def _digest(value) -> bool:
+    return (type(value) is str and len(value) == 64
+            and all(character in "0123456789abcdef" for character in value))
+
+
+def collected_cohort(run_dir: Path, native: dict, allowance: int) -> dict:
+    """Use the existing exact final-n500 config/result/wave join before summary."""
+    rows, waves = cases.selected_verification_cohort(run_dir, native)
+    summary = cohort_summary(rows, allowance)
+    summary["waves"] = waves
+    return summary
+
+
+def control_winner_evidence(run_dir: Path, native: dict, allowance: int) -> dict:
+    """Bind the product winner to its actual n500 config and result files.
+
+    This deliberately leaves frame, context, graph, and package identities to
+    the Go verification-only command unless the producer supplies their join.
+    """
+    rows, _ = cases.selected_verification_cohort(run_dir, native)
+    cohort_summary(rows, allowance)
+    root = run_dir.resolve(strict=True)
+    request = json.loads(cases.read(root / "request.json", 4 << 20))
+    wearers = request.get("wearers")
+    if type(wearers) is not list or len(wearers) != 4:
+        raise ValueError("preservation_control_winner_request_shape")
+    product = native.get("product_result")
+    published = product.get("candidates") if type(product) is dict else None
+    if (type(published) is not list or not published
+            or published[0].get("rank") != 1
+            or type(published[0].get("artifacts")) is not list
+            or len(published[0]["artifacts"]) != 20
+            or product.get("winner") != published[0]["artifacts"]
+            or type(published[0].get("measured")) is not dict):
+        raise ValueError("preservation_control_product_winner_shape")
+    published_artifacts = published[0]["artifacts"]
+    assignment = []
+    offset = 0
+    for actor, wearer in enumerate(wearers):
+        current = wearer.get("current_artifacts")
+        if type(current) is not list or len(current) != 5:
+            raise ValueError("preservation_control_winner_wearer_shape")
+        actor_ids = []
+        for item in current:
+            actual = published_artifacts[offset]
+            offset += 1
+            identifier = actual.get("artifact_id") if type(actual) is dict else None
+            if (type(identifier) is not int or identifier <= 0
+                    or actual.get("wearer_key") != wearer.get("wearer_key")
+                    or actual.get("slot") != item.get("slot")):
+                raise ValueError("preservation_control_product_artifact_order")
+            actor_ids.append(identifier)
+        assignment.append(actor_ids)
+    if len({identifier for actor in assignment for identifier in actor}) != 20:
+        raise ValueError("preservation_control_product_artifact_reuse")
+    assignment_sha = sha(cases.canonical(assignment))
+    result_sha = published[0]["measured"].get("engine_result_sha256")
+    matched = [row for row in rows if (row.get("assignment_sha256") == assignment_sha
+               and row.get("engine_result_sha256") == result_sha)]
+    if len(matched) != 1:
+        raise ValueError("preservation_control_product_winner_join")
+    row = matched[0]
+    config = Path(row["config_path"]).resolve(strict=True)
+    result = Path(row["result_path"]).resolve(strict=True)
+    if (not config.is_relative_to(root) or not result.is_relative_to(root)
+            or sha(cases.read(config)) != row["config_sha256"]
+            or sha(cases.read(result)) != row["engine_result_sha256"]):
+        raise ValueError("preservation_control_winner_physical_mismatch")
+    group_key = published[0].get("set_group_key")
+    if type(group_key) is not str or not group_key:
+        raise ValueError("preservation_control_set_group_missing")
+    return {"rank": row["rank"], "assignment": row["assignment"],
+            "assignment_sha256": row["assignment_sha256"],
+            "config_path": str(config), "config_sha256": row["config_sha256"],
+            "result_path": str(result), "engine_result_sha256": row["engine_result_sha256"],
+            "formula_dps": row["formula_dps"], "iterations": row["iterations"],
+            "workers": row["verification_workers"], "set_group_key": group_key,
+            "identity_scope": "published product rank 1 joined to actual n500 config/result; frame and set package validated by Go"}
+
+
+def observed_all_sets(run_dir: Path, native: dict, allowance: int,
+                      *, research: bool = False) -> dict:
+    """Report only work and final measurements present in the product output."""
+    if native.get("mode") != "all_sets":
+        raise ValueError("preservation_all_sets_mode_changed")
+    if research:
+        rows, waves = research_verification_cohort(run_dir, native)
+        cohort = cohort_summary(rows, 9)
+        if cohort["count"] > 8:
+            raise ValueError("preservation_all_sets_discovery_over_budget")
+        cohort["waves"] = waves
+        heldout = heldout_candidate(waves)
+    else:
+        cohort = collected_cohort(run_dir, native, allowance)
+        heldout = None
+    work = native.get("search_work")
+    provider = native.get("provider_timings")
+    if (type(work) is not list or type(provider) is not list
+            or type(native.get("search_expansions")) is not int
+            or native["search_expansions"] < 0
+            or type(native.get("search_seconds")) not in (int, float)
+            or not math.isfinite(native["search_seconds"])):
+        raise ValueError("preservation_all_sets_telemetry_missing")
+    calls = cohort["count"]
+    iterations = sum(row["iterations"] for row in cohort["rows"])
+    attempted = (sum(wave["calls"] for wave in cohort["waves"]
+                     if wave["name"] != "independent_final_n500") if research else
+                 sum(wave["candidate_count"] for wave in cohort["waves"]))
+    if (calls > attempted if research else calls != attempted):
+        raise ValueError("preservation_ordinary_wave_call_mismatch")
+    policy = native.get("adaptive_policy")
+    response = native.get("support_response")
+    policy_calls = None
+    response_calls = None
+    if type(policy) is dict and policy.get("active") is True:
+        samples = policy.get("samples")
+        policy_calls = policy.get("calls")
+        if (type(policy_calls) is not int or policy_calls < 0
+                or type(samples) is not list or len(samples) != policy_calls):
+            raise ValueError("preservation_policy_call_ledger_invalid")
+    if type(response) is dict:
+        evidence = response.get("check", {}).get("evidence")
+        if type(evidence) is dict:
+            response_calls = evidence.get("attempted_calls")
+            if type(response_calls) is not int or response_calls < 0:
+                raise ValueError("preservation_response_call_ledger_invalid")
+    captures = native.get("capture_members")
+    if type(captures) is not int or captures < 0 or captures != len(provider):
+        raise ValueError("preservation_capture_count_invalid")
+    return {"cohort": cohort, "ordinary_final_calls": calls,
+            "ordinary_final_iterations": iterations,
+            "independent_final": heldout,
+            "discovery_attempted_calls": attempted,
+            "search_work_rows": len(work), "search_expansions": native["search_expansions"],
+            "search_seconds": native["search_seconds"],
+            "capture_provider_rows": len(provider), "capture_members": captures,
+            "policy_observed_calls": policy_calls,
+            "response_observed_attempted_calls": response_calls,
+            "search_stop_reason": native.get("search_stop_reason"),
+            "coverage": "stage-local producer counts only; no aggregate or screening-iteration claim without the new causal call ledger"}
+
+
+def observed_selected(output: dict, allowance: int, *, research: bool = False) -> dict:
+    """SelectedSession has already joined the final files in its owned run."""
+    if (output.get("schema") != "health_unified_selected_v1"
+            or output.get("success") is not True
+            or type(output.get("cohort")) is not list
+            or type(output.get("verification_waves")) is not list):
+        raise ValueError("preservation_selected_output_invalid")
+    cohort = cohort_summary(output["cohort"], 9 if research else allowance)
+    if research and cohort["count"] > 6:
+        raise ValueError("preservation_selected_discovery_over_budget")
+    waves = output["verification_waves"]
+    attempted = (sum(wave["calls"] for wave in waves
+                     if wave["name"] != "independent_final_n500") if research else
+                 sum(wave["candidate_count"] for wave in waves))
+    if (cohort["count"] > attempted if research else cohort["count"] != attempted):
+        raise ValueError("preservation_selected_wave_call_mismatch")
+    return {"cohort": cohort, "waves": waves,
+            "independent_final": heldout_candidate(waves) if research else None,
+            "discovery_attempted_calls": attempted,
+            "ordinary_final_calls": cohort["count"],
+            "ordinary_final_iterations": sum(row["iterations"] for row in cohort["rows"]),
+            "setup_seconds": output.get("setup_seconds"),
+            "search_seconds": output.get("search_seconds"),
+            "verification_seconds": output.get("verification_seconds"),
+            "whole_headless_seconds": output.get("whole_headless_seconds"),
+            "coverage": "owned SelectedSession final verifier output; screening calls require separate producer telemetry"}
+
+
+def adaptive_ledger_summary(raw: bytes, *, initial_cap: int = 7,
+                            expected_policy_sha256: str | None = None) -> dict:
+    """Bound research calls from the producer's causal per-phase receipt."""
+    if initial_cap not in (5, 7):
+        raise ValueError("preservation_adaptive_initial_cap_invalid")
+    receipt = json.loads(raw)
+    phases = receipt.get("phases")
+    pool = receipt.get("pool")
+    if (receipt.get("schema_kind") != "gtt_optimizer_candidate_leader_research_v1"
+            or receipt.get("policy_id") != "candidate_leader_research_v1"
+            or receipt.get("status") != "completed"
+            or receipt.get("pool_maximum") != 11
+            or receipt.get("initial_maximum") != 7
+            or receipt.get("maximum_ordinary_calls") != 9
+            or receipt.get("maximum_iterations") != 4500
+            or not _digest(receipt.get("frame_sha256"))
+            or not _digest(receipt.get("policy_sha256"))
+            or type(pool) is not list or not 1 <= len(pool) <= 11
+            or type(phases) is not list or not 2 <= len(phases) <= 3):
+        raise ValueError("preservation_adaptive_receipt_invalid")
+    if expected_policy_sha256 is not None and receipt["policy_sha256"] != expected_policy_sha256:
+        raise ValueError("preservation_adaptive_policy_sha_changed")
+    names = [phase.get("name") for phase in phases]
+    if (names[0] != "initial_n500" or names[-1] != "independent_final_n500"
+            or (len(names) == 3 and names[1] != "optional_context_neighbor_n500")):
+        raise ValueError("preservation_adaptive_phase_order")
+    pool_ids = {row.get("candidate_id") for row in pool}
+    if len(pool_ids) != len(pool) or not all(_digest(identifier) for identifier in pool_ids):
+        raise ValueError("preservation_adaptive_pool_identity")
+    calls = 0
+    iterations = 0
+    compact = []
+    discovered = set()
+    for index, phase in enumerate(phases):
+        measurements = phase.get("measurements")
+        attempted_ids = phase.get("attempted_candidate_ids")
+        rejected_ids = phase.get("energy_rejected_candidate_ids", [])
+        failed_ids = phase.get("failed_candidate_ids", [])
+        count = phase.get("calls")
+        n = phase.get("iterations")
+        workers = phase.get("workers")
+        if (type(count) is not int or count < 1
+                or type(n) is not int or n != 500
+                or type(workers) is not int or workers < 1
+                or type(measurements) is not list or not 1 <= len(measurements) <= count
+                or type(attempted_ids) is not list or len(attempted_ids) != count
+                or len(set(attempted_ids)) != count
+                or any(identifier not in pool_ids for identifier in attempted_ids)
+                or type(rejected_ids) is not list or type(failed_ids) is not list
+                or set(rejected_ids) & set(failed_ids)
+                or any(identifier not in attempted_ids for identifier in rejected_ids + failed_ids)
+                or {row.get("candidate_id") for row in measurements} |
+                   set(rejected_ids) | set(failed_ids) != set(attempted_ids)
+                or len({row.get("candidate_id") for row in measurements}) != len(measurements)
+                or (index == 0 and count > initial_cap)
+                or (index > 0 and count != 1)):
+            raise ValueError("preservation_adaptive_phase_budget")
+        for row in measurements:
+            if (row.get("candidate_id") not in attempted_ids
+                    or row.get("candidate_id") in rejected_ids
+                    or row.get("candidate_id") in failed_ids
+                    or row.get("phase") != phase["name"]
+                    or row.get("iterations") != 500
+                    or not _digest(row.get("config_sha256"))
+                    or not _digest(row.get("engine_result_sha256"))
+                    or type(row.get("workers")) is not int or row["workers"] < 1):
+                raise ValueError("preservation_adaptive_measurement_invalid")
+        if index < len(phases) - 1:
+            identifiers = {row["candidate_id"] for row in measurements}
+            if discovered & identifiers:
+                raise ValueError("preservation_adaptive_discovery_repeated")
+            discovered.update(identifiers)
+        calls += count
+        iterations += count * n
+        compact.append({"name": phase["name"], "calls": count,
+                        "iterations_per_call": n, "workers": workers,
+                        "elapsed_ms": phase.get("elapsed_ms"),
+                        "attempted_candidate_ids": attempted_ids,
+                        "measured_candidate_ids": [row["candidate_id"] for row in measurements],
+                        "energy_rejected_candidate_ids": rejected_ids,
+                        "failed_candidate_ids": failed_ids})
+    final_id = receipt.get("final_candidate_id")
+    if (calls > 9 or iterations > 4500 or not _digest(final_id)
+            or final_id not in discovered
+            or receipt.get("recommended_candidate_id") != final_id
+            or phases[-1]["measurements"][0]["candidate_id"] != final_id
+            or type(receipt.get("independent_validation")) is not str):
+        raise ValueError("preservation_adaptive_final_invalid")
+    return {"receipt_sha256": sha(raw), "policy_sha256": receipt["policy_sha256"],
+            "pool_count": len(pool),
+            "phases": compact, "ordinary_calls": calls,
+            "ordinary_iterations": iterations, "final_candidate_id": final_id,
+            "discovery_elapsed_ms": receipt.get("discovery_elapsed_ms"),
+            "total_elapsed_ms": receipt.get("total_elapsed_ms"),
+            "independent_final_calls": 1,
+            "independent_final_iterations": 500,
+            "selection_scope": "frozen discovery leader then fresh held-out n500; no global optimum or no-loss proof"}
+
+
+def research_verification_cohort(run_dir: Path, native: dict) -> tuple[list[dict], list[dict]]:
+    """Physically join every research phase, keeping the held-out row separate."""
+    verification_root = run_dir.resolve(strict=True) / "verification"
+    raw = cases.read(verification_root / "adaptive-research-v1.json", 4 << 20)
+    adaptive_ledger_summary(raw)
+    receipt = json.loads(raw)
+    discovery = {}
+    wave_rows = []
+    for phase in receipt["phases"]:
+        phase_root = Path(phase["run_root"]).resolve(strict=True)
+        if not phase_root.is_relative_to(verification_root):
+            raise ValueError("preservation_research_phase_outside_run")
+        configs = sorted(phase_root.glob("wave-*/*/config.txt"))
+        results = sorted(phase_root.glob("wave-*/*/result.json"))
+        if (len(configs) != phase["calls"] or len(results) != phase["calls"]
+                or {path.parent for path in configs} != {path.parent for path in results}):
+            raise ValueError("preservation_research_phase_files_missing")
+        measured = {row["candidate_id"]: row for row in phase["measurements"]}
+        phase_files = {}
+        for identifier in phase["attempted_candidate_ids"]:
+            matches = [path for path in configs if path.parent.name.endswith("-" + identifier[:12])]
+            if len(matches) != 1:
+                raise ValueError("preservation_research_candidate_file_ambiguous")
+            config = matches[0]
+            result_path = config.parent / "result.json"
+            config_raw = cases.read(config)
+            result_raw = cases.read(result_path)
+            result = json.loads(result_raw)
+            simulator = result.get("simulator_settings")
+            statistics = result.get("statistics")
+            embedded = result.get("config_file")
+            if (type(embedded) is not str
+                    or embedded.encode("utf-8") not in (config_raw, config_raw + b"\n")
+                    or type(simulator) is not dict
+                    or type(statistics) is not dict or statistics.get("iterations") != 500
+                    or type(simulator.get("number_of_workers")) is not int
+                    or simulator["number_of_workers"] < 1):
+                raise ValueError("preservation_research_phase_result_mismatch")
+            hashes = {"candidate_id": identifier, "config_path": str(config),
+                      "result_path": str(result_path), "config_sha256": sha(config_raw),
+                      "engine_result_sha256": sha(result_raw),
+                      "workers": simulator["number_of_workers"]}
+            measurement = measured.get(identifier)
+            if measurement is not None:
+                stats = result.get("statistics", {})
+                dps = stats.get("dps", {}) if type(stats) is dict else None
+                mean = dps.get("mean") if type(dps) is dict else None
+                deviation = dps.get("sd") if type(dps) is dict else None
+                if (hashes["config_sha256"] != measurement["config_sha256"]
+                        or hashes["engine_result_sha256"] != measurement["engine_result_sha256"]
+                        or hashes["workers"] != measurement["workers"]
+                        or type(mean) not in (int, float) or type(deviation) not in (int, float)
+                        or not math.isclose(mean, measurement["measured_dps"], rel_tol=0, abs_tol=1e-9)
+                        or type(measurement.get("standard_error")) not in (int, float)
+                        or not math.isclose(deviation / math.sqrt(500), measurement["standard_error"],
+                                            rel_tol=0, abs_tol=1e-9)):
+                    raise ValueError("preservation_research_measured_result_mismatch")
+            phase_files[identifier] = hashes
+            if phase["name"] != "independent_final_n500" and measurement is not None:
+                if identifier in discovery:
+                    raise ValueError("preservation_research_discovery_repeat")
+                discovery[identifier] = {"measurement": measurement,
+                                         "config_path": str(config),
+                                         "result_path": str(result_path)}
+        wave_rows.append({"name": phase["name"], "calls": phase["calls"],
+                          "iterations": phase["iterations"], "workers": phase["workers"],
+                          "elapsed_ms": phase.get("elapsed_ms"),
+                          "run_root": str(phase_root), "attempt_files": phase_files,
+                          "measurements": phase["measurements"]})
+    verification = native.get("verification")
+    rows = verification.get("candidates") if type(verification) is dict else None
+    if type(rows) is not list or not 1 <= len(rows) <= len(discovery):
+        raise ValueError("preservation_research_discovery_count")
+    pool = {row["candidate_id"]: row for row in receipt["pool"]}
+    joined = []
+    used = set()
+    for row in rows:
+        matches = [(identifier, entry) for identifier, entry in discovery.items()
+                   if (entry["measurement"]["config_sha256"] == row.get("config_sha256")
+                       and entry["measurement"]["engine_result_sha256"] == row.get("engine_result_sha256")
+                       and sha(cases.canonical(pool[identifier]["assignment"])) == row.get("assignment_sha256"))]
+        if len(matches) != 1 or matches[0][0] in used:
+            raise ValueError("preservation_research_discovery_join_ambiguous")
+        identifier, entry = matches[0]
+        used.add(identifier)
+        joined.append({**row, "candidate_id": identifier,
+                       "config_path": entry["config_path"],
+                       "result_path": entry["result_path"],
+                       "verification_workers": entry["measurement"]["workers"],
+                       "verification_parallelism": None})
+    return joined, wave_rows
+
+
+def heldout_candidate(waves: list[dict]) -> dict:
+    """Return the independently run n500 row, never a discovery ranking row."""
+    final = [wave for wave in waves if wave.get("name") == "independent_final_n500"]
+    if len(final) != 1 or final[0].get("calls") != 1 or len(final[0].get("measurements", [])) != 1:
+        raise ValueError("preservation_heldout_phase_invalid")
+    measurement = final[0]["measurements"][0]
+    files = final[0]["attempt_files"].get(measurement["candidate_id"])
+    if files is None:
+        raise ValueError("preservation_heldout_files_missing")
+    return {"candidate_id": measurement["candidate_id"],
+            "measured_dps": measurement["measured_dps"],
+            "standard_error": measurement["standard_error"],
+            "calls": 1, "iterations": measurement["iterations"],
+            "workers": measurement["workers"],
+            **files, "selection_role": "fresh held-out validation after discovery winner frozen"}
+
+
+def cohort_summary(rows: list[dict], allowance: int) -> dict:
+    """Validate the rows already joined to the native verifier's final files."""
+    if (type(rows) is not list or allowance not in (2, 3, 9)
+            or not 1 <= len(rows) <= allowance):
+        raise ValueError("preservation_cohort_count")
+    reduced = []
+    for row in rows:
+        assignment = row.get("assignment")
+        if (type(row.get("rank")) is not int or row["rank"] < 1
+                or type(assignment) is not list or len(assignment) != 4
+                or any(type(actor) is not list or len(actor) != 5 for actor in assignment)
+                or any(type(identifier) is not int or identifier <= 0
+                       for actor in assignment for identifier in actor)
+                or len({identifier for actor in assignment for identifier in actor}) != 20
+                or not _digest(row.get("assignment_sha256"))
+                or row["assignment_sha256"] != sha(cases.canonical(assignment))
+                or row.get("iterations") != 500
+                or not _digest(row.get("config_sha256"))
+                or not _digest(row.get("engine_result_sha256"))
+                or type(row.get("source")) is not str or not row["source"]):
+            raise ValueError("preservation_cohort_row_shape")
+        for key in ("measured_dps", "standard_error"):
+            value = row.get(key)
+            if type(value) not in (int, float) or not math.isfinite(value) or (key == "standard_error" and value < 0):
+                raise ValueError("preservation_cohort_stat_invalid")
+        reduced.append({key: row.get(key) for key in ("rank", "assignment", "assignment_sha256",
+            "source", "formula_dps", "measured_dps", "standard_error", "iterations", "config_sha256",
+            "engine_result_sha256", "verification_workers", "verification_parallelism")})
+    if sorted(row["rank"] for row in reduced) != list(range(1, len(reduced) + 1)):
+        raise ValueError("preservation_cohort_rank_invalid")
+    best = max(reduced, key=lambda row: row["measured_dps"])
+    return {"count": len(reduced), "allowance": allowance, "rows": reduced, "measured_best": best,
+            "selection_scope": "observed product verification cohort; no global optimum or no-loss proof"}
+
+
+def descriptive_difference(control: dict, candidate: dict) -> dict:
+    """Independent-arm descriptive difference; post-selection limits stay explicit."""
+    left, right = control["measured_best"], candidate["measured_best"]
+    delta = right["measured_dps"] - left["measured_dps"]
+    uncertainty = math.hypot(right["standard_error"], left["standard_error"])
+    return {"difference_dps": delta, "standard_error": uncertainty,
+            "nominal_95_interval": [delta - 1.96 * uncertainty, delta + 1.96 * uncertainty],
+            "same_full_config": right["config_sha256"] == left["config_sha256"],
+            "independent_ordinary_batches": True, "post_selection": True,
+            "global_optimum_proved": False, "no_loss_proved": False}
+
+
+def validate_independent_result(row: dict) -> dict:
+    if (type(row) is not dict or row.get("calls") != 1 or row.get("iterations") != 500
+            or not _digest(row.get("config_sha256"))
+            or not _digest(row.get("engine_result_sha256"))
+            or type(row.get("measured_dps")) not in (int, float)
+            or type(row.get("standard_error")) not in (int, float)
+            or not math.isfinite(row["measured_dps"])
+            or not math.isfinite(row["standard_error"])
+            or row["standard_error"] < 0):
+        raise ValueError("preservation_independent_result_invalid")
+    return row
+
+
+def independent_difference(control: dict, candidate: dict) -> dict:
+    """Compare new n500 validations of the two frozen selected leaders."""
+    validate_independent_result(control)
+    validate_independent_result(candidate)
+    delta = candidate["measured_dps"] - control["measured_dps"]
+    se = math.hypot(candidate["standard_error"], control["standard_error"])
+    return {"difference_dps": delta, "standard_error": se,
+            "nominal_95_interval": [delta - 1.96 * se, delta + 1.96 * se],
+            "same_full_config": candidate["config_sha256"] == control["config_sha256"],
+            "independent_ordinary_batches": True,
+            "selection_scope": "one fresh n500 validation per already selected leader; no feedback to either search",
+            "global_optimum_proved": False, "no_loss_proved": False}
+
+
+def frozen_receipts() -> dict:
+    result = EVIDENCE / "health-unified-uptake-v7-result.json"
+    audit = EVIDENCE / "health-unified-uptake-v7-actual-audit.json"
+    if sha(bounded(result)) != V7_RESULT_SHA or sha(bounded(audit)) != V7_AUDIT_SHA:
+        raise ValueError("preservation_installed_provenance_changed")
+    return {"uptake_result_sha256": V7_RESULT_SHA, "uptake_audit_sha256": V7_AUDIT_SHA,
+            "accepted_archive_manifest_sha256": accepted.ACCEPTED_ARCHIVE_MANIFEST_SHA,
+            "port_manifest_sha256": accepted.PORT_MANIFEST_SHA,
+            "fixed_engine_artifact_sha256": ENGINE_SHA,
+            "installed_consumer_sha256": CONSUMER_SHA}
