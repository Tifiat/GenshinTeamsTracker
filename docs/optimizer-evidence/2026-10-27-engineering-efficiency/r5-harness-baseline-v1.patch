+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--freeze", required=True, type=Path)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--freeze-sha", help="exact digest reviewed by the coordinator")
+    parser.add_argument("--prepare", action="store_true")
+    args = parser.parse_args()
+    if args.prepare:
+        result = prepare(args.freeze)
+    else:
+        if args.output is None or args.freeze_sha is None:
+            parser.error("--output and --freeze-sha required for reviewed execution")
+        result = run(args.freeze, args.output, args.freeze_sha)
+        result = {k: result.get(k) for k in ("status", "errors", "cleanup_status", "summary")}
+    print(json.dumps(result, sort_keys=True))
+    if result.get("status") == "failed": raise SystemExit(2)
+
+
+if __name__ == "__main__": main()
