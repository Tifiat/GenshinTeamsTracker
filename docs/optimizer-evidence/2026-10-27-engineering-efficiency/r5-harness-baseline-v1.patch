+def _safe_authored_render_error(exc: BaseException) -> str | None:
+    """Keep only a short, fixed-label message emitted by our diagnostic layer."""
+    if type(exc) is not render_diagnostic.RenderDiagnosticError:
+        return None
+    message = str(exc)
+    if (
+        not message
+        or len(message) > 180
+        or not message.isascii()
+        or any(not (character.isalnum() or character in " _.-") for character in message)
+    ):
+        return None
+    return message
+
