+def _nonnegative_int(value: Any) -> int | None:
+    return value if type(value) is int and value >= 0 else None
+
+
+def _counts(source: Any, keys: tuple[str, ...]) -> dict[str, int]:
+    if not isinstance(source, dict):
+        return {}
+    return {key: checked for key in keys
+            if (checked := _nonnegative_int(source.get(key))) is not None}
+
+
+def _static_identifier(value: Any) -> str:
+    if (isinstance(value, str) and len(value) <= 180
+            and _STATIC_IDENTIFIER.fullmatch(value)
+            and ".." not in value and not value.startswith("/")):
+        return value
+    return "unknown"
