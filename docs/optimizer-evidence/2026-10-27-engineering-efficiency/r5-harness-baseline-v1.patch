+"""One accepted-D346 vs ordered-extrema pair on the saved20October input.
+
+Uses the existing managed lease, Windows job runner and export-before-cleanup.
+No simulation, inventory edit, width change or installation. Accepted source is
+verified file by file before overlays are materialized; dirty source is retained.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[4]
+sys.path.insert(0, str(ROOT))
+from tools.experiments.gcsim.mvp_polish import tighnari_archived_whole as old
+
+gate, NATIVE = old.gate, old.NATIVE
+RUN = ROOT / "data/profiles/57b730eff7544d0eb4e9f74ecb8fc2fa/data/gcsim/optimizer-go-runs/all_sets-20261020-224036-24149ec9"
+EVIDENCE = ROOT / "docs/optimizer-evidence/2026-10-15-mvp-polish"
+ACCEPTED = ROOT / "docs/optimizer-evidence/2026-10-18-main-unification/D346_ACCEPTED_CONSUMER_BUILD.json"
+sha = lambda value: hashlib.sha256(value).hexdigest()
+
+
+def accepted_images():
+    closure = json.loads(ACCEPTED.read_bytes())["accepted_source_closure"]
+    expected = closure["candidate_path_sha256"]
+    baseline = dict(closure["baseline_path_sha256"])
+    baseline.update({key: "unused_foreign_test" for key in old.EXCLUDED})
+    images, _ = old.prepare_d(baseline)
+    program = (NATIVE / "internal/formula/artifact_program.go").read_bytes()
+    start = program.index(b"\t\tcase opMin:\n")
+    end = program.index(b"\t\tdefault:\n", start)
+    images["internal/formula/artifact_program.go"] = program[:start] + program[end:]
+    test = (NATIVE / "internal/formula/artifact_arithmetic_test.go").read_bytes()
+    test = test.replace(b"[]uint8{opAdd, opMultiply, opMin, opMax}", b"[]uint8{opAdd, opMultiply}", 1)
+    test = test.replace(b'\t\t\t{math.Copysign(0, -1), 0}, {0, math.Copysign(0, -1), 0},\n\t\t\t{2, 2, 2}, {-5, -2, -3}, {.5, math.SmallestNonzeroFloat64},\n', b'', 1)
+    test = test.replace(b'\t\t\tif len(inputs) == 0 && (op == opMin || op == opMax) {\n\t\t\t\tcontinue // Invalid IR; the source validator requires an operand.\n\t\t\t}\n', b'', 1)
+    images["internal/formula/artifact_arithmetic_test.go"] = test
+    result = {key: images.get(key, (NATIVE / key).read_bytes()) for key in expected}
+    actual = {key: sha(raw) for key, raw in result.items()}
+    if actual != expected:
+        raise RuntimeError("Accepted D346 source mismatch: " + str([key for key in expected if actual[key] != expected[key]]))
+    assert len(actual) == 346 and gate.digest(actual) == closure["candidate_source_map_sha256"]
+    return result, closure["candidate_source_map_sha256"]
+
+
+def fresh_helper():
+    source = old.HELPER.read_text(encoding="utf-8")
+    output = json.loads((RUN / "optimizer-output.json").read_bytes())
+    context = next((RUN / "verification/contexts").iterdir()).name.removeprefix("context-")
+    old_context = "8165007773d8120252a629b13145f1c24c60a680bc177af45418894e69a973e3"
+    pairs = [("all_sets-20261016-111937-21960bc2", RUN.name), (old_context, context),
+             ("7f3b25560bf04447e4ad94809622dcc1f28bf6d0c42eb295878c2fc770bf1ae7", output["product_result"]["request_sha256"]),
+             ("len(saved.Work) != 1791", f"len(saved.Work) != {len(output['search_work'])}")]
+    for match in re.finditer(r'read\("(request.json|set-sources.json|optimizer-output.json)", "[0-9a-f]{64}", [0-9]+\)', source):
+        relative = match.group(1)
+        after = (RUN / relative).read_bytes()
+        pairs.append((match.group(0), f'read("{relative}", "{sha(after)}", {len(after)})'))
+    config = (RUN / f"verification/contexts/context-{context}/seed-742031889/config.txt").read_bytes()
+    old_config = re.search(r'const tighnariWholeConfig = "([0-9a-f]{64})"', source).group(1)
+    pairs.extend(((old_config, sha(config)), ("tighnariWholeConfig, 1742", f"tighnariWholeConfig, {len(config)}")))
+    pins = re.findall(r'\{"[0-9a-f]{64}", "[0-9a-f]{64}", [0-9]+, [0-9]+\}', source)
+    assert len(pins) == 2
+    for seed, before in zip((742031889, 742031890), pins, strict=True):
+        folder = RUN / f"verification/contexts/context-{context}/seed-{seed}"
+        member, effects = (folder / "member.json").read_bytes(), (folder / "member.json.effects.json").read_bytes()
+        pairs.append((before, f'{{"{sha(member)}", "{sha(effects)}", {len(member)}, {len(effects)}}}'))
+    for before, after in pairs:
+        if before not in source:
+            raise RuntimeError("Fixture template pin missing: " + before)
+        source = source.replace(before, after)
+    return source.encode()
+
+
+def protected():
+    context = ROOT / ".codex_tmp/d346-native-ui-witness/job-d346-synthetic-20261020-once/context.json"
+    paths = [Path(row["path"]) for row in json.loads(context.read_bytes())["protected_files"]]
+    return {str(path): sha(path.read_bytes()) if path.exists() else None for path in paths}
+
+
+def run(output_path):
+    if output_path.exists():
+        raise RuntimeError("Receipt exists; no automatic retry")
+    images, source_map = accepted_images()
+    helper = fresh_helper()
+    before_native, before_protected = old.native_map(), protected()
+    assert before_protected[str(ROOT / "native/gcsim_optimizer/gtt-optimizer.exe")] == "0d1950cb8915550f52001d834ae905fb30b8e96a7c6744728b217aa19e5e9806"
+    if gate.retirement._default_process_probe(ROOT):
+        raise RuntimeError("Heavy/app process active")
+    record = {"scope": "acceptedD346 vs ordered extrema; saved20October width8; no fresh engine",
+              "status": "started", "errors": [], "accepted_source_map_sha256": source_map,
+              "helper_sha256": sha(helper), "source_before_sha256": gate.digest(before_native),
+              "protected_before": before_protected, "engine_calls": 0, "installs": 0}
+    started = time.monotonic()
+    with output_path.open("xb") as stream:
+        def save():
+            gate.io._save(stream, record)
+        def command(argv, env, job, label, seconds):
+            record["stage"] = label
+            save()
+            result = gate.owned._run_owned(argv, command_kind=label, env=env,
+                log_path=job / (label + ".log"), timeout_seconds=seconds)
+            record.setdefault("commands", {})[label] = result
+            if not gate.command_passed(result):
+                text = (job / (label + ".log")).read_text(encoding="utf-8", errors="replace")
+                record["failure_tail"] = text[-6000:]
+                save()
+                raise RuntimeError(label + " failed")
+        def body(job):
+            env, _ = gate.common._environment(job)
+            env.update(GOMEMLIMIT="2GiB", GTT_TIGHNARI_ARCHIVED_WHOLE="root_released_once", GTT_TIGHNARI_REPLAY_REPO=str(ROOT))
+            overlay = {}
+            for i, (relative, raw) in enumerate(sorted(images.items())):
+                if sha((NATIVE / relative).read_bytes()) != sha(raw):
+                    path = job / (f"source-{i}.go")
+                    path.write_bytes(raw)
+                    overlay[str(NATIVE / relative)] = str(path)
+            for relative in set(before_native) - set(images):
+                overlay[str(NATIVE / relative)] = ""
+            test = job / "fixture.go"
+            test.write_bytes(helper)
+            overlay[str(NATIVE / "internal/allsets/zz_tighnari_archived_whole_test.go")] = str(test)
+            overlays = {}
+            for role in ("baseline", "candidate"):
+                replace = dict(overlay)
+                if role == "candidate":
+                    for relative in ("internal/formula/artifact_program.go", "internal/formula/artifact_arithmetic_test.go"):
+                        replace.pop(str(NATIVE / relative), None)
+                path = job / (role + "-overlay.json")
+                path.write_bytes(gate.canonical({"Replace": replace}))
+                overlays[role] = path
+            go = str(gate.owned.GO_EXE)
+            command([go, "-C", str(NATIVE), "test", "-p=1", "-mod=readonly", "-buildvcs=false", "-overlay=" + str(overlays["candidate"]), "-count=1", "./internal/formula"], env, job, "formula-tests", 180)
+            for role in ("baseline", "candidate"):
+                command([go, "-C", str(NATIVE), "test", "-c", "-p=1", "-mod=readonly", "-buildvcs=false", "-overlay=" + str(overlays[role]), "-o", str(job / (role + ".exe")), "./internal/allsets"], env, job, role + "-build", 180)
+            projections = {}
+            for role in ("baseline", "candidate"):
+                runtime = dict(env, GTT_TIGHNARI_REPLAY_ROLE=role)
+                command([str(job / (role + ".exe")), "-test.run=^" + old.TEST + "$", "-test.v", "-test.parallel=1", "-test.timeout=420s"], runtime, job, role + "-search", 440)
+                payload = json.loads((job / (role + "-projection.json")).read_bytes())
+                assert payload["complete"] and payload["provider_calls"] == 1
+                projections[role] = payload
+                record.setdefault("arms", {})[role] = {"run_neutral_seconds": payload["run_neutral_seconds"], "setup_seconds": payload["setup_seconds"], "finalists": payload["projection"]["finalists"]}
+                save()
+            a, b = projections["baseline"], projections["candidate"]
+            record["exact_comparison"] = old.compare(a["projection"], b["projection"], old.PAIR_KEYS)
+            record["saved_comparison"] = old.compare(json.loads((RUN / "optimizer-output.json").read_bytes()), a["projection"], old.CORE_KEYS)
+            record["speed_percent"] = 100 * (1 - b["run_neutral_seconds"] / a["run_neutral_seconds"])
+            assert record["exact_comparison"]["equal"] and record["saved_comparison"]["equal"]
+            assert old.native_map() == before_native and protected() == before_protected
+            record["status"] = "exact_pair_pass"
+        gate.run_owned_body(None, record, save, body)
+        record["source_after_exact"] = old.native_map() == before_native
+        record["protected_after_exact"] = protected() == before_protected
+        record["whole_seconds"] = time.monotonic() - started
+        save()
+    return record
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--prepare", action="store_true")
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    if args.prepare:
+        images, digest = accepted_images()
+        print(json.dumps({"accepted_files": len(images), "accepted_map": digest, "helper_sha256": sha(fresh_helper())}))
+    else:
+        if args.output is None:
+            parser.error("--output required")
+        result = run(args.output)
+        print(json.dumps({key: result.get(key) for key in ("status", "errors", "stage", "cleanup_status", "speed_percent")}))
+        raise SystemExit(0 if result["status"] == "exact_pair_pass" else 1)
