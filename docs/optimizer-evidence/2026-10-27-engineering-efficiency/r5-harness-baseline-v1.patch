+def compare_observed(job: Path, case: str, control: dict, candidate: dict) -> dict:
+    """Join a completed pair without inferring unreported search simulations."""
+    if (control.get("case") != case or control.get("arm") != "control"
+            or candidate.get("case") != case or candidate.get("arm") != "candidate"
+            or control.get("engine_artifact_sha256") != scope.ENGINE_SHA
+            or candidate.get("engine_artifact_sha256") != scope.ENGINE_SHA):
+        raise ValueError("preservation_pair_arm_invalid")
+    root = job if case == "tighnari" else job / "cases" / case
+    left = json.loads(cases.read(root / "control/request.json", 4 << 20))
+    right = json.loads(cases.read(root / "candidate/request.json", 4 << 20))
+    scope.case_inputs_equal(left, right)
+    left_sources = cases.read(root / "control/set-sources.json")
+    right_sources = cases.read(root / "candidate/set-sources.json")
+    if left_sources != right_sources:
+        raise ValueError("preservation_arm_source_bundle_drift")
+    quality = scope.independent_difference(control.get("independent_final"),
+                                           candidate.get("independent_final"))
+    discovery = scope.descriptive_difference(control["cohort"], candidate["cohort"])
+    control_heldout_wall = control["independent_final"].get("adapter_wall_seconds")
+    control_engine_wall = control["independent_final"].get("command_wall_seconds")
+    if (type(control_heldout_wall) not in (int, float)
+            or not math.isfinite(control_heldout_wall) or control_heldout_wall < 0
+            or type(control_engine_wall) not in (int, float)
+            or not math.isfinite(control_engine_wall) or control_engine_wall < 0
+            or control_heldout_wall < control_engine_wall
+            or control["independent_final"].get("workers") != 16
+            or candidate["independent_final"].get("workers") != 16):
+        raise ValueError("preservation_control_heldout_timer_missing")
+    control_protocol_wall = control["command_wall_seconds"] + control_heldout_wall
+    candidate_protocol_wall = candidate["command_wall_seconds"]
+    return {"case": case, "same_request_payload": True,
+            "shared_set_sources_sha256": scope.sha(left_sources),
+            "engine_artifact_sha256": scope.ENGINE_SHA,
+            "control": control, "candidate": candidate,
+            "product_cohort_rows": {"control": control["ordinary_final_calls"],
+                                    "candidate": candidate["ordinary_final_calls"]},
+            "product_cohort_iterations": {"control": control["ordinary_final_iterations"],
+                                          "candidate": candidate["ordinary_final_iterations"]},
+            "candidate_research_actual_calls": candidate["adaptive_research"]["ordinary_calls"],
+            "candidate_research_actual_iterations": candidate["adaptive_research"]["ordinary_iterations"],
+            "independent_quality": quality,
+            "discovery_cohort_descriptive": discovery,
+            "full_quality_protocol_wall_seconds": {"control_product_plus_fresh_heldout": control_protocol_wall,
+                                                   "candidate_research_including_heldout": candidate_protocol_wall},
+            "control_heldout_wall_seconds": {"whole_adapter": control_heldout_wall,
+                                              "engine_command": control_engine_wall},
+            "full_quality_protocol_wall_delta_seconds": candidate_protocol_wall - control_protocol_wall,
+            "timing_scope": "control product command plus full Python held-out adapter vs candidate command including held-out; preparation and owner overhead separate",
+            "scope": "two fresh arms under the fixed engine; held-out quality descriptive and post-selection"}
+
+
+def run_case_pair(job: Path, case: str, *, binding_path: Path,
+                  control_consumer: Path, candidate_consumer: Path,
+                  candidate_consumer_sha: str, adaptive_route: tuple[str, ...] | None,
+                  policy_sha256: str,
+                  prepare_seconds: int, arm_seconds: int,
+                  command: Command, export: Callable[[], None],
+                  control_heldout: Callable[[Path, str, dict, Command], dict]) -> dict:
+    """One prespecified case, serial arms, with durable evidence after each arm.
+
+    The owner enforces the frozen whole/case deadline, source/protected checks,
+    command uniqueness, and cleanup. This function cannot allocate a job.
+    """
+    if case not in scope.ORDER or not 0 < prepare_seconds <= 120 or arm_seconds <= 0:
+        raise ValueError("preservation_case_cap_invalid")
+    job = cases.owned_job(job)
+    case_started = time.monotonic()
+    consumers = {"control": (control_consumer, scope.CONSUMER_SHA),
+                 "candidate": (candidate_consumer, candidate_consumer_sha)}
+    preparations = {}
+    for arm in ("control", "candidate"):
+        consumer, digest = consumers[arm]
+        if case == "tighnari":
+            preparations[arm] = prepare_tighnari(job, arm, binding_path)
+        else:
+            command_result = command(case + "-prepare-" + arm,
+                    [sys.executable, "-B", "-m",
+                     "tools.experiments.gcsim.mvp_polish.candidate_preservation_case",
+                     "--job", job, "--case", case, "--arm", arm,
+                     "--stage", "prepare", "--binding", binding_path,
+                     "--consumer", consumer, "--consumer-sha", digest],
+                    scope.ROOT, {"GTT_SCRATCH_DIR": str(job)}, prepare_seconds)
+            preparations[arm] = {"command_wall_seconds": command_result.get("wall_seconds")}
+    root = job if case == "tighnari" else job / "cases" / case
+    left = json.loads(cases.read(root / "control/request.json", 4 << 20))
+    right = json.loads(cases.read(root / "candidate/request.json", 4 << 20))
+    scope.case_inputs_equal(left, right)
+    if cases.read(root / "control/set-sources.json") != cases.read(root / "candidate/set-sources.json"):
+        raise ValueError("preservation_prepared_source_bundle_drift")
+    results = {}
+    for arm in ("control", "candidate"):
+        consumer, digest = consumers[arm]
+        results[arm] = run_arm(job, case, arm, binding_path=binding_path,
+                               consumer=consumer, consumer_sha=digest,
+                               phase_seconds=arm_seconds, command=command,
+                               adaptive_route=adaptive_route if arm == "candidate" else None,
+                               policy_sha256=policy_sha256 if arm == "candidate" else None)
+        if arm == "control":
+            results[arm]["independent_final"] = control_heldout(
+                job, case, results[arm], command)
+            # The callback must physically join the verifier-only result and
+            # report its separate real call; the quality check is a final gate.
+            scope.validate_independent_result(results[arm]["independent_final"])
+        export()
+    pair = compare_observed(job, case, results["control"], results["candidate"])
+    pair["preparation"] = preparations
+    pair["whole_case_wall_seconds"] = round(time.monotonic() - case_started, 3)
+    export()
+    return pair
+
