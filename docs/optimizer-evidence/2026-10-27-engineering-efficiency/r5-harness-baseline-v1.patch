+def _bounded(path: Path) -> bytes:
+    size = path.stat().st_size
+    if size > LIMITS["raw_export_file_max"]:
+        raise ValueError("uptake_file_cap")
+    with path.open("rb") as stream:
+        raw = stream.read(size + 1)
+    if len(raw) != size or path.stat().st_size != size:
+        raise ValueError("uptake_file_changed")
+    return raw
+
