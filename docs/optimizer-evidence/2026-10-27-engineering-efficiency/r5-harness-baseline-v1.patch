+    record["wall_profile"] = json.loads(read_bounded(job / "e-whole-profile.json"))
+    validate_wall(record["wall_profile"], payload["run_neutral_seconds"])
+    wall = record["wall_profile"]
+    if (wall.get("status") != "complete" or wall.get("run_error") is not None
+            or wall.get("cpu_profile_error") is not None or wall.get("profile_file") != "e-whole-cpu.pprof"
+            or wall.get("profile_start_immediately_before_run_neutral") is not True
+            or wall.get("profile_stop_immediately_after_run_neutral") is not True
+            or wall.get("profile_bytes") != record["cpu_profile_raw"]["bytes"]
+            or wall.get("profile_sha256") != record["cpu_profile_raw"]["sha256"]
+            or payload.get("e_whole_profile") != wall):
