+def _capture_native_logs(run_root: Path, destination: Path) -> dict[str, Any]:
+    """Retain native stderr/progress privately before the disposable child exits.
+
+    Never copy requests, rotations, account snapshots, profiles, artifacts, or
+    frozen-mechanic records. The outer managed suite owns finite deletion.
+    """
+    destination.mkdir(mode=0o700, parents=False, exist_ok=False)
+    names = ("optimizer-progress.jsonl", "optimizer-request-preflight.stderr.txt")
+    records = []
+    error_codes: set[str] = set()
+    excerpts: list[str] = []
+    unclassified_text = False
+    for run in sorted(run_root.glob("*")) if run_root.exists() else ():
+        if not run.is_dir() or run.is_symlink():
+            continue
+        sources = [run / name for name in names]
+        sources.extend(sorted(run.glob("compact-*.stderr.txt")))
+        for source in sources:
+            if not source.is_file() or source.is_symlink():
+                continue
+            size = source.stat().st_size
+            if size > MAX_NATIVE_LOG_BYTES:
+                records.append({"kind": source.name, "status": "too_large", "bytes": size})
+                continue
+            name = f"{len(records):03d}-{source.name}"
+            target = destination / name
+            with source.open("rb") as src, target.open("xb") as dst:
+                shutil.copyfileobj(src, dst, length=1 << 20)
+            target.chmod(0o600)
+            with target.open("rb") as stream:
+                offset = max(0, size - 256 * 1024)
+                stream.seek(offset)
+                tail = stream.read(256 * 1024).decode("utf-8", errors="replace").splitlines()
+                if offset and tail:
+                    tail = tail[1:]  # first line can start halfway through a JSON record
+                for line in tail:
+                    try:
+                        row = json.loads(line)
+                    except json.JSONDecodeError:
+                        row = None
+                    if isinstance(row, dict):
+                        for key in ("error_code", "code"):
+                            code = row.get(key)
+                            if isinstance(code, str) and _SAFE_CODE.fullmatch(code):
+                                error_codes.add(code)
+                        message = row.get("error")
+                        if isinstance(message, str) and len(excerpts) < 3:
+                            excerpts.append(_sanitized_native_error(message))
+                    elif line.strip():
+                        lowered = line.lstrip().casefold()
+                        if lowered.startswith("panic:"):
+                            error_codes.add("native_panic")
+                            if len(excerpts) < 3:
+                                excerpts.append(_sanitized_native_error(line))
+                        elif lowered.startswith("fatal error:"):
+                            error_codes.add("native_fatal_error")
+                            if len(excerpts) < 3:
+                                excerpts.append(_sanitized_native_error(line))
+                        elif "error" in lowered:
+                            unclassified_text = True
+                            if len(excerpts) < 3:
+                                excerpts.append(_sanitized_native_error(line))
+            records.append({"kind": source.name, "status": "retained_private", "bytes": size,
+                            "sha256": _sha(target), "file": name})
+    return {"status": "retained_private" if records else "native_stderr_unavailable",
+            "error_codes": sorted(error_codes)[:16],
+            "sanitized_error_excerpts": excerpts,
+            "unclassified_error_text_present": unclassified_text,
+            "files": records}
