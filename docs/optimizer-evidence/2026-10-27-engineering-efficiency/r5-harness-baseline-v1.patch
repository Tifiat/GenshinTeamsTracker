+"""Source-image factory and saved-evidence note for the no-feedback ablation.
+
+This module does not run Go, build the optimizer, start a search, invoke the
+engine, or write an artifact. It reuses the accepted-source replay factory and
+returns an in-memory overlay for a separately authorized runner.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_hybrid_replay as replay
+
+
+POLICY = Path(__file__).with_name("adaptive_hybrid_policy_test.go")
+
+
+def _replace_region(source: str, start: str, end: str, replacement: str) -> str:
+    if source.count(start) != 1:
+        raise ValueError(f"expected one source marker: {start!r}")
+    offset = source.index(start)
+    end_offset = source.find(end, offset)
+    if end_offset < 0:
+        raise ValueError(f"missing source end marker: {end!r}")
+    return source[:offset] + replacement + source[end_offset:]
+
+
+def no_feedback_policy_image(source: bytes | None = None) -> bytes:
+    """Keep queue selection intact while disabling engine-guided feedback."""
+    raw = POLICY.read_bytes() if source is None else source
+    text = raw.decode("utf-8")
+
+    anchor = '''// researchHybridAnchor keeps the formula leader as the block anchor.
+// Queue selection remains active, while engine-guided feedback is disabled.
+func researchHybridAnchor(fallback Candidate) Candidate {
+	if researchHybrid == nil {
+		return fallback
+	}
+	p := researchHybrid
+	p.block++
+	p.blockCalls = 0
+	p.allow = nil
+	p.uncertain = Candidate{}
+	p.hasUncertain = false
+	p.uncertainSpread = 0
+	p.uncertainPriority = 0
+	p.uncertainOrder = 0
+	p.blockFallback = fallback
+	p.hasBlockFallback = true
+	p.blockAnchor = fallback
+	p.hasBlockAnchor = true
+	p.Events = append(p.Events, map[string]any{
+		"type":                    "block_anchor",
+		"block":                   p.block,
+		"fallback":                adaptiveCandidateSummary(fallback),
+		"anchor":                  adaptiveCandidateSummary(fallback),
+		"engine_incumbent":        false,
+		"engine_incumbent_ignored": p.HasIncumbent,
+		"feedback_enabled":        false,
+	})
+	if p.block > adaptiveHybridMaxBlocks {
+		return fallback
+	}
+	return fallback
+}'''
+    text = _replace_region(text,
+                           "// researchHybridAnchor uses only a paired-seed measured winner",
+                           "\n// researchHybridQueue", anchor)
+
+    end = '''// researchHybridEnd records the disabled feedback decision without an ordinary engine call.
+func researchHybridEnd(ctx context.Context, leader Candidate) error {
+	if researchHybrid == nil {
+		return nil
+	}
+	p := researchHybrid
+	if ctx == nil {
+		return p.finishWithError(fmt.Errorf("no-feedback ablation requires a live search context"))
+	}
+	if err := ctx.Err(); err != nil {
+		return p.finishWithError(err)
+	}
+	p.Events = append(p.Events, map[string]any{
+		"type":                  "feedback_disabled",
+		"block":                 p.block,
+		"formula_leader":        adaptiveCandidateSummary(leader),
+		"engine_calls":           p.Calls,
+		"engine_outcome":         "disabled_by_ablation",
+		"has_engine_incumbent":   p.HasIncumbent,
+	})
+	if p.Calls != 0 || p.EngineMS != 0 || p.EngineWallMS != 0 || len(p.Samples) != 0 || p.HasIncumbent {
+		return p.finishWithError(fmt.Errorf("no-feedback ablation observed unexpected ordinary engine activity"))
+	}
+	return p.persistProgress()
+}'''
+    text = _replace_region(text,
+                           "// researchHybridEnd measures at most three unique complete builds",
+                           "\nfunc (p *adaptiveHybridPolicy) measurePair", end)
+
+    old_title = 't.Run("engine incumbent anchors the next block without replacing formula score", func(t *testing.T) {'
+    if text.count(old_title) != 1:
+        raise ValueError("expected one engine-incumbent anchor contract test")
+    text = text.replace(old_title,
+                        't.Run("no-feedback ablation always uses the formula fallback", func(t *testing.T) {', 1)
+    old_assertions = '''		if got.Score.Assignment != incumbent.Score.Assignment || got.Score.DPS != 10 {
