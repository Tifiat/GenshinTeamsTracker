+    require(same(runtime, install["after"]["runtime"]), "protected_state_failed")
+    require(same(services.installed._pair_evidence(), install["c_pair"]), "protected_state_failed")
+    recipes = services.cleaner._verify_recipes(ROOT)
+    pairs = {}
+    for name in services.cleaner.STAGES:
+        stage = services.cleaner._stage(name)
+        services.cleaner._manifest_info(ROOT, stage, recipes[name])
+        for relative in (stage.binary_rel, stage.manifest_rel):
+            pairs[relative] = _info(ROOT / relative, services)
+        require(pairs[stage.binary_rel] == (stage.backup_bytes, stage.backup_sha), "protected_state_failed")
+    pinset = _pins(context, services)
+    return {"pins_sha256": digest(canonical(pinset)), "native_files": len(native),
+        "native_map_sha256": digest(canonical(native)), "runtime_sha256": digest(canonical(runtime)),
+        "abc_rollback_sha256": digest(canonical(pairs)), "inputs": observe_inputs(context["inputs"], services),
+        "head": runtime["resolved_head"], "index_sha256": runtime["hashes"][".git/index"],
+        "consumer_sha256": runtime["hashes"][TARGET.replace("internal/formula/artifact_program.go", "gtt-optimizer.exe")]}, pinset
+
+
+def command(recipe, job):
+    return [part.replace("<approved-go.exe>", GO.as_posix()).replace("<repo>", ROOT.as_posix())
+            .replace("<owned-job>", job.as_posix()) for part in recipe["proposed_execution"]["argv"]]
+
+
+def validate_protocol(value, context):
+    expected = {"schema_version": 1, "kind": KIND + "_protocol_v1", "state": "root_released_once",
+        "recipe_sha256": RECIPE_SHA, "installed_c_receipt_sha256": INSTALL_SHA,
+        "before": context["before"], "pins": context["pins"], "source_evidence": context["source_evidence"],
+        "pin_provenance": PIN_PROVENANCE,
+        "limits": LIMITS, "command_argv_template": context["recipe"]["proposed_execution"]["argv"],
+        "module_cache": MODULE_CACHE.as_posix(), "result": RESULT.relative_to(ROOT).as_posix(),
+        "module_cache_override": "existing_shared_cache_read_only_dependency_use_offline_no_acquisition",
+        "log_cap_kind": "post_return_acceptance_not_live_cap", "whole_wall_kind": "observed_acceptance_with_precommand_admission",
+        "scratch_cap_kind": "pre_post_samples_not_live_quota", "memory_cap_kind": "GOMEMLIMIT_soft_only"}
+    require(type(value) is dict and set(value) == set(expected) | {"lease_id"}
+            and all(same(value[key], item) for key, item in expected.items()), "protocol_contract_failed")
+    require(type(value["lease_id"]) is str and re.fullmatch(r"[a-z0-9-]{1,100}", value["lease_id"]), "protocol_contract_failed")
+
+
+def _idle(services):
+    services.old._require_idle(ROOT, services.probe)
+
+
+def _check_inherited_environment():
+    # The existing helper owns all declared overrides; reject undeclared Go modes.
+    for key in ("GODEBUG", "GOEXPERIMENT", "GOCACHEPROG", "GOOS", "GOARCH", "GOAMD64", "GOFIPS140"):
+        require(not os.environ.get(key), "environment_failed")
+    require(os.environ.get("GOGC") in (None, "", "100"), "environment_failed")
+
+
+def _preflight(protocol_sha, protocol_path, services):
+    require(Path(sys.executable).resolve() == (ROOT / ".venv/Scripts/python.exe").resolve(), "preflight_failed")
+    require(type(protocol_sha) is str and re.fullmatch(r"[0-9a-f]{64}", protocol_sha)
+            and Path(protocol_path).absolute() == PROTOCOL, "protocol_contract_failed")
+    require(_info(PROTOCOL, services)[1] == protocol_sha and _info(ROOT / RECIPE_REL, services)[1] == RECIPE_SHA
+            and _info(ROOT / INSTALL_REL, services)[1] == INSTALL_SHA, "protocol_contract_failed")
+    recipe = _read_json(ROOT / RECIPE_REL, services)
+    install = _read_json(ROOT / INSTALL_REL, services, 262144)
+    require(install.get("status") == "installed" and install.get("cleanup_status") == "confirmed"
+            and type(install.get("remaining_managed_jobs")) is int and install["remaining_managed_jobs"] == 0, "preflight_failed")
+    require(same(recipe["proposed_execution"]["limits"], LIMITS), "source_contract_failed")
+    _check_inherited_environment()
+    services.managed.assert_unlinked(RESULT)
+    require(not RESULT.exists(), "receipt_conflict")
+    services.managed.assert_unlinked(MODULE_CACHE)
+    require(MODULE_CACHE.is_dir(), "preflight_failed")
+    services.managed.assert_unlinked(services.managed.MANAGED_ROOT)
+    require(services.managed.MANAGED_ROOT.is_dir() and not tuple(services.managed.MANAGED_ROOT.glob("job-*")), "scratch_busy")
+    context = {"recipe": recipe, "install": install, "inputs": input_spec(recipe, services)}
+    context["before"], context["pins"] = _snapshot(context, services)
+    context["afterimages"], context["source_evidence"] = prepare_sources(recipe, services)
+    context["protocol"] = _read_json(PROTOCOL, services)
+    validate_protocol(context["protocol"], context)
+    _idle(services)
+    return context
+
+
+def _save(record, services, *, first=False):
+    raw = canonical(record) + b"\n"
+    require(len(raw) <= LIMITS["retained_receipt_max_bytes"], "receipt_limit_failed")
+    services.managed.assert_unlinked(RESULT); services.managed.assert_unlinked(RESULT.parent)
+    RESULT.parent.mkdir(parents=True, exist_ok=True)
+    if first:
+        require(not RESULT.exists(), "receipt_conflict")
+    else:
+        previous = _read_json(RESULT, services, LIMITS["retained_receipt_max_bytes"])
+        require(previous.get("lease_id") == record["lease_id"] and previous.get("protocol_sha256") == record["protocol_sha256"], "receipt_conflict")
+    fd, name = tempfile.mkstemp(prefix="." + RESULT.name + ".", suffix=".tmp", dir=RESULT.parent)
+    temporary = Path(name)
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+        services.managed.assert_unlinked(RESULT); services.managed.assert_unlinked(RESULT.parent)
+        if first:
+            # This runner targets Windows: rename is atomic and refuses replacement.
+            require(os.name == "nt", "preflight_failed")
+            os.rename(temporary, RESULT)
+        else:
+            os.replace(temporary, RESULT)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+
+
+def _fail(record, code):
+    code = code if code in ERROR_CODES else "stage_failed"
+    if code not in record["errors"]:
+        record["errors"].append(code)
+    record["status"] = "failed"
+
+
+@contextmanager
+def _retained_job(services, record, export):
+    """One existing managed root/lease/cleaner; retain job if durable export fails."""
+    managed, root = services.managed, services.managed.MANAGED_ROOT.absolute()
+    managed.assert_unlinked(root); managed.assert_unlinked(root / ".gtt-active.lock")
+    with managed.run_directory_lease(root):
+        require(not tuple(root.glob("job-*")), "scratch_busy")
+        job = Path(tempfile.mkdtemp(prefix="job-", dir=root))
+        record.update(managed_jobs=1, cleanup_status="pending")
+        try:
+            yield job
+        finally:
+            record["exported_before_cleanup"] = True
+            try:
+                export()
+            except Exception:
+                record["exported_before_cleanup"] = False
+                record["cleanup_status"] = "retained_export_failed"
+                _fail(record, "receipt_export_failed")
+                raise GateError("receipt_export_failed") from None
+            if record.get("precleanup_idle") is not True:
+                record["cleanup_status"] = "retained_idle_unconfirmed"
+                _fail(record, "cleanup_failed")
+                raise GateError("cleanup_failed")
+            try:
+                record["removed_bytes"] = managed.remove_owned_job(job, root)
+                require(type(record["removed_bytes"]) is int and 0 <= record["removed_bytes"] < 2**63
+                        and not job.exists(), "cleanup_failed")
+                record["cleanup_status"] = "confirmed"
+            except Exception:
+                record["cleanup_status"] = "failed_job_retained"
+                _fail(record, "cleanup_failed")
+                raise GateError("cleanup_failed") from None
+
+
+def _job_body(job, context, record, services, save):
+    after = job / "after"; after.mkdir()
+    for name, raw in context["afterimages"].items():
+        target = after / name; target.write_bytes(raw)
+        require(_info(target, services) == (len(raw), digest(raw)), "materialization_failed")
+    replace = {key.replace("<repo>", ROOT.as_posix()): value.replace("<repo>", ROOT.as_posix()).replace("<owned-job>", job.as_posix())
+               for key, value in context["recipe"]["overlay"]["Replace"].items()}
+    require(len(replace) == 3, "materialization_failed")
+    (job / "overlay.json").write_bytes(canonical({"Replace": replace}))
+    env, _ = services.priorities._environment(job)
+    _check_inherited_environment()
+    env.update(GTT_ALL466_ONE_REFINE="reviewed_981", GTT_ALL466_REPLAY_REPO=str(ROOT), GOMEMLIMIT="2GiB", GOFLAGS="")
+    expected = {"GTT_SCRATCH_DIR": str(job), "GOMAXPROCS": "1", "CGO_ENABLED": "0", "GOENV": "off",
+                "GOWORK": "off", "GOTOOLCHAIN": "local", "GOPROXY": "off", "GOSUMDB": "off"}
+    require(all(env.get(key) == value for key, value in expected.items()) and Path(env.get("GOMODCACHE", "")) == MODULE_CACHE
+            and MODULE_CACHE.is_dir(), "environment_failed")
+    record["scratch_samples"]["before_go"] = services.archive._tree_bytes(job)
+    require(record["scratch_samples"]["before_go"] <= LIMITS["owned_scratch_pre_post_max_bytes"], "scratch_limit_failed")
+    current, pins = _snapshot(context, services)
+    require(same(current, context["before"]) and same(pins, context["pins"]), "protected_state_failed")
+    require(_info(PROTOCOL, services)[1] == context["protocol_sha256"], "protected_state_failed")
+    _idle(services)
+    # No whole-process guardian: admit early, then reject any observed 180s overrun.
+    require(time.monotonic() - context["started"] <= 15, "whole_budget_failed")
+    record.update(go_commands=1, command_state="admitted_may_have_invoked")
+    save()
+    record["process"] = normalize_process(services.owned._run_owned(command(context["recipe"], job),
+        command_kind=KIND, env=env, log_path=job / "go.jsonl", timeout_seconds=150))
+    record["command_state"] = "owned_runner_returned"
+
+
+def normalize_process(process):
+    """Do not retain arbitrary exception class names, command text or paths."""
+    require(type(process) is dict and process.get("command_kind") == KIND, "command_failed")
+    code, wall, size, sha = (process.get(key) for key in ("returncode", "wall_seconds", "log_bytes", "log_sha256"))
+    require((code is None or type(code) is int and -(2**63) <= code < 2**63)
+            and type(process.get("timed_out")) is bool and "error_class" in process
+            and type(wall) in (int, float) and math.isfinite(wall) and 0 <= wall <= 86400
+            and type(size) is int and 0 <= size < 2**63 and type(sha) is str and re.fullmatch(r"[0-9a-f]{64}", sha), "command_failed")
+    return {"returncode": code, "timed_out": process["timed_out"], "owned_error": process["error_class"] is not None,
+            "wall_seconds": wall, "log_bytes": size, "log_sha256": sha}
+
+
+def _collect(job, record, services):
+    path = job / "go.jsonl"; services.managed.assert_unlinked(path)
+    # _run_owned already read its entire log. This is an acceptance cap, not live protection.
+    size = path.stat().st_size
+    require(size <= LIMITS["raw_go_jsonl_max_bytes"], "capture_failed")
+    with path.open("rb") as stream:
+        raw = stream.read(LIMITS["raw_go_jsonl_max_bytes"] + 1)
+    process = record.get("process")
+    if process is not None:
+        require((len(raw), digest(raw)) == (process["log_bytes"], process["log_sha256"]), "capture_failed")
+    record["measurement"] = services.collector.collect_jsonl(raw)
+    require(record["measurement"]["valid"], "collector_failed")
+    require(process is not None and process["returncode"] == 0 and process["timed_out"] is False
+            and process["owned_error"] is False and process["wall_seconds"] <= 150, "command_failed")
+
+
+def _record(context, protocol_sha):
+    return {"schema_version": 1, "kind": KIND + "_result_v1", "status": "reserved", "errors": [],
+        "lease_id": context["protocol"]["lease_id"], "protocol_sha256": protocol_sha,
+        "recipe_sha256": RECIPE_SHA, "installed_c_receipt_sha256": INSTALL_SHA,
+        "pin_commitment": {"files": len(context["pins"]), "sha256": digest(canonical(context["pins"]))},
+        "pin_provenance": PIN_PROVENANCE,
+        "additional_pins": {key: value for key, value in context["pins"].items()
+                            if key not in context["install"]["after"]["pins"]}, "before": context["before"],
+        "source_evidence": context["source_evidence"], "limits": LIMITS, "managed_jobs": 0, "go_commands": 0,
+        "command_state": "not_admitted", "measurement": None, "process": None, "scratch_samples": {},
+        "cleanup_status": "not_allocated", "exported_before_cleanup": False, "preflight_idle": True,
+        "preflight_managed_jobs": 0, "engine_calls": 0, "installs": 0, "retries": 0,
+        "boundary": "Saved All466 paired warm scalar sequence only; no cold-anchor proof, promotion or installation.",
+        "resource_boundary": "Soft 2GiB; scratch pre/post only; log cap after helper full read; whole wall observed."}
+
+
+def execute(protocol_sha256, protocol_path=PROTOCOL):
+    started, services = time.monotonic(), _services()
+    context = _preflight(protocol_sha256, protocol_path, services)
+    context.update(started=started, protocol_sha256=protocol_sha256)
+    record = _record(context, protocol_sha256)
+    def save(first=False):
+        _save(record, services, first=first)
+    save(True)  # Exclusive permanent attempt reservation before any lease/allocation.
+    job = None
+    try:
+        with _retained_job(services, record, save) as job:
+            try:
+                _job_body(job, context, record, services, save)
+            except Exception as exc:
+                _fail(record, str(exc) if isinstance(exc, GateError) else "command_failed")
+            if record["go_commands"]:
+                try:
+                    _collect(job, record, services)
+                except Exception as exc:
+                    _fail(record, str(exc) if isinstance(exc, GateError) else "capture_failed")
+            try:
+                record["scratch_samples"]["after_go"] = services.archive._tree_bytes(job)
+                require(record["scratch_samples"]["after_go"] <= LIMITS["owned_scratch_pre_post_max_bytes"], "scratch_limit_failed")
+                current, pins = _snapshot(context, services)
+                record["after_before_cleanup"] = current
+                require(same(current, context["before"]) and same(pins, context["pins"]), "protected_state_failed")
+                require(_info(PROTOCOL, services)[1] == protocol_sha256, "protected_state_failed")
+            except Exception:
+                _fail(record, "precleanup_state_failed")
+            try:
+                _idle(services); record["precleanup_idle"] = True
+            except Exception:
+                _fail(record, "idle_failed")
+            record["wall_before_cleanup_seconds"] = round(time.monotonic() - started, 3)
+            if record["wall_before_cleanup_seconds"] > 180:
+                _fail(record, "whole_budget_failed")
+            record["status"] = "failed" if record["errors"] else "parity_pass_cleanup_pending"
+    except Exception as exc:
+        _fail(record, str(exc) if isinstance(exc, GateError) else "lifecycle_failed")
+    try:
+        current, pins = _snapshot(context, services)
+        record["after"] = current
+        require(same(current, context["before"]) and same(pins, context["pins"]), "protected_state_failed")
+        require(_info(PROTOCOL, services)[1] == protocol_sha256, "protected_state_failed")
+        _idle(services); record["postflight_idle"] = True
+    except Exception:
+        _fail(record, "postcleanup_state_failed")
+    try:
+        services.managed.assert_unlinked(services.managed.MANAGED_ROOT)
+        record["remaining_managed_jobs"] = len(tuple(services.managed.MANAGED_ROOT.glob("job-*")))
+    except Exception:
+        record["remaining_managed_jobs"] = None
+        _fail(record, "cleanup_failed")
+    record["whole_wall_seconds"] = round(time.monotonic() - started, 3)
+    if record["whole_wall_seconds"] > 180:
+        _fail(record, "whole_budget_failed")
+    if record["remaining_managed_jobs"] or record["cleanup_status"] != "confirmed":
+        _fail(record, "cleanup_failed")
+    if not record["errors"]:
+        record["status"] = "warm_sequence_parity_pass"
+    save()
+    return record
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(__doc__)
+    parser.add_argument("--execute", action="store_true")
+    parser.add_argument("--protocol", type=Path, default=PROTOCOL)
+    parser.add_argument("--protocol-sha256")
+    args = parser.parse_args(argv)
+    if not args.execute:
+        print(json.dumps({"status": "source_preparation_only"})); return 0
+    if not args.protocol_sha256:
+        parser.error("--execute requires --protocol-sha256")
+    try:
+        result = execute(args.protocol_sha256, args.protocol)
+    except Exception:
+        print(json.dumps({"status": "blocked_or_receipt_export_failed", "error": "consult_reserved_receipt_no_retry"})); return 2
+    print(json.dumps({"status": result["status"], "cleanup_status": result["cleanup_status"]}))
+    return 0 if result["status"] == "warm_sequence_parity_pass" else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
