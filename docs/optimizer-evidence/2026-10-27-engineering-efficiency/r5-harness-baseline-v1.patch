+@contextmanager
+def _process_launch_cap(mode: str, cap: int):
+    from run_workspace.gcsim import optimizer_go_session
+
+    real_popen = subprocess.Popen
+    real_optimizer_launcher = optimizer_go_session.start_optimizer_process
+    calls = {
+        "attempted": 0,
+        "launched": 0,
+        "reserved": 0,
+        "failed": 0,
+        "blocked": 0,
+        "stages": {},
+    }
+    lock = threading.Lock()
+    launching = threading.local()
+
+    def stage_for(command):
+        values = tuple(str(value).casefold() for value in command) if isinstance(command, (list, tuple)) else ()
+        if "validate-request" in values:
+            return "request_validation"
+        if "-gtt-trace-equation" in values:
+            return "compact_capture"
+        if any(value in {"verify-fgbs", "optimize-all-sets", "optimize-theory"} for value in values):
+            return "optimizer_search"
+        return "other"
+
+    def update(stage, field):
+        row = calls["stages"].setdefault(
+            stage, {"attempted": 0, "launched": 0, "failed": 0, "blocked": 0}
+        )
+        row[field] += 1
+
+    def guarded_popen(*args, **kwargs):
+        # The legacy route is forbidden. On non-Windows the owned seam itself
+        # delegates to Popen, so allow only that synchronous call-through.
+        if not getattr(launching, "inside_optimizer_launcher", False):
+            with lock:
+                calls["blocked"] += 1
+                update("legacy_unowned", "blocked")
+            raise RuntimeError("optimizer processes must use start_optimizer_process")
+        return real_popen(*args, **kwargs)
+
+    def guarded_optimizer_launcher(*args, **kwargs):
+        stage = stage_for(args[0] if args else ())
+        with lock:
+            calls["attempted"] += 1
+            update(stage, "attempted")
+            if calls["launched"] + calls["reserved"] >= cap:
+                calls["blocked"] += 1
+                update(stage, "blocked")
+                raise RuntimeError("MVP process launch cap exceeded")
+            calls["reserved"] += 1
+        previous = getattr(launching, "inside_optimizer_launcher", False)
+        launching.inside_optimizer_launcher = True
+        try:
+            process = real_optimizer_launcher(*args, **kwargs)
+        except BaseException:
+            with lock:
+                calls["reserved"] -= 1
+                calls["failed"] += 1
+                update(stage, "failed")
+            raise
+        finally:
+            launching.inside_optimizer_launcher = previous
+        with lock:
+            calls["reserved"] -= 1
+            calls["launched"] += 1
+            update(stage, "launched")
+        return process
+
+    with (
+        patch.object(subprocess, "Popen", side_effect=guarded_popen),
+        patch.object(optimizer_go_session, "start_optimizer_process", side_effect=guarded_optimizer_launcher),
+    ):
+        yield calls
+
+
