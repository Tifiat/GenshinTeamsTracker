+def verify_project_sources(chasca, pins, *, sealed=None):
+    """Explicit public import closure, with a fail-closed loaded-module backstop."""
+    for relative, expected in pins.items():
+        path = ROOT / relative
+        chasca.gate.managed.assert_unlinked(path)
+        require(chasca.gate.owned._sha256_file(path) == expected, "navia_controller_source_drift")
+    for module in tuple(sys.modules.values()):
+        filename = getattr(module, "__file__", None)
+        if not filename:
+            continue
+        path = Path(filename).resolve()
+        if not path.is_relative_to(ROOT.resolve()) or path.is_relative_to((ROOT / ".venv").resolve()):
+            continue
+        if sealed is not None and path.is_relative_to(Path(sealed).resolve()):
+            require(path.name in WRAPPER_PINS and sha(path.read_bytes()) == WRAPPER_PINS[path.name],
+                    "navia_sealed_import_closure")
+            continue
+        relative = path.relative_to(ROOT.resolve()).as_posix()
+        require(relative in pins and sha(path.read_bytes()) == pins[relative],
+                "navia_loaded_project_module_not_pinned")
+
