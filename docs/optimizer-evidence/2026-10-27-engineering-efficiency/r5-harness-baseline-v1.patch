+    union = quality.get("union_unique_configs")
+    limit = 6 if case_key == "navia" else 4
+    if (quality.get("schema") != "health_unified_selected_quality_v1"
+            or quality.get("complete") is not True or quality.get("case_key") != case_key
+            or quality.get("input_manifest_sha256") != k.sha(bounded(case / "case-manifest.json"))
+            or quality.get("control_request_sha256") != result["control_request_sha256"]
+            or quality.get("candidate_request_sha256") != result["candidate_request_sha256"]
+            or quality.get("candidate_engine_binding_sha256") != json.loads(bounded(job / "candidate/engine-binding.json"))["binding_sha256"]
+            or type(quality.get("candidate_frame_sha256")) is not str
+            or len(quality["candidate_frame_sha256"]) != 64
+            or type(control) is not list or len(control) != result["control"]["cohort_count"]
+            or type(candidate) is not list or len(candidate) != result["candidate"]["cohort_count"]
+            or type(union) is not int or not 1 <= union <= limit
+            or quality.get("ordinary_attempts") != union
+            or quality.get("iterations") != 500 or quality.get("workers") != 4
+            or type(quality.get("parallelism_max")) is not int
+            or not 1 <= quality["parallelism_max"] <= 4
+            or quality.get("global_optimum_proved") is not False
+            or quality.get("no_loss_proved") is not False
+            or type(quality.get("same_config_same_batch")) is not bool
+            or not quality.get("entrypoint_caveat")):
+        raise ValueError("unified_selected_quality_invalid")
+    for row in [*control, *candidate]:
