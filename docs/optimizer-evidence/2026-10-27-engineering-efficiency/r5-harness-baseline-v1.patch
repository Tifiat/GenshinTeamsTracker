+class _Budget:
+    def __init__(self) -> None:
+        self.fields = 0
+        self.values = 0
+
+    def field(self) -> None:
+        self.fields += 1
+        if self.fields > MAX_FIELDS:
+            raise ValueError("protobuf_field_bound")
+
+    def value(self) -> None:
+        self.values += 1
+        if self.values > MAX_FIELDS:
+            raise ValueError("protobuf_value_bound")
