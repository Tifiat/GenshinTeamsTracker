+    if sha(FROZEN_RESULT.read_bytes()) != EXPECTED_V7_SHA or sha(FROZEN_AUDIT.read_bytes()) != EXPECTED_AUDIT_SHA:
+        raise ValueError("unified_accepted_research_receipt_changed")
+    result = json.loads(FROZEN_RESULT.read_bytes())
+    audit = json.loads(FROZEN_AUDIT.read_bytes())
+    if (result.get("status") != "five_team_workflow_complete"
+            or result.get("cleanup_status") != "confirmed"
+            or result.get("remaining_managed_jobs") != 0
+            or audit.get("disposition", {}).get("finite_five_team_workflow") != "COMPLETE"
+            or audit.get("disposition", {}).get("operational_release") != "PASS"
+            or audit.get("disposition", {}).get("blockers") != []):
+        raise ValueError("unified_accepted_research_status_changed")
+    compressed = FROZEN_PANEL.read_bytes()
+    panel = json.loads(gzip.decompress(compressed))
+    rows = panel.get("raw")
+    if (panel.get("schema") != "health_combined_panel_v1"
+            or not isinstance(rows, list) or len(rows) != 9
+            or [row.get("label") for row in rows] != [f"raw_search_{i:02d}" for i in range(9)]):
+        raise ValueError("unified_frozen_panel_invalid")
+    return panel, {"v7_result_sha256": EXPECTED_V7_SHA,
+                   "v7_audit_sha256": EXPECTED_AUDIT_SHA,
+                   "frozen_panel_archive_sha256": sha(compressed),
+                   "frozen_panel_raw_sha256": sha(gzip.decompress(compressed))}
