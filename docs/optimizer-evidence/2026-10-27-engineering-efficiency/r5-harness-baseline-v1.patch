+"""Finite saved-input projection for the existing full-account button runner.
+
+Only roster/levels/weapons, requested bonuses and rotation are recovered from
+old requests. No old inventory, engine binding, budget or native result runs.
+"""
+from __future__ import annotations
+from dataclasses import replace
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import re
+
+from tools.managed_optimizer_experiment import MANAGED_ROOT, assert_unlinked
+
+ROOT=Path(__file__).resolve().parents[4]
+OUT=ROOT/'docs/optimizer-evidence/2026-10-25-cache-team-matrix'
+OLD=ROOT/'docs/optimizer-evidence/2026-10-25-all-teams-button-timings'
+ENV_KEY='GTT_MECHANIC_CORPUS_INPUT'
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value,sort_keys=True,ensure_ascii=False,separators=(',',':')).encode()).hexdigest()
+
+def normalize_sets(sets):
+    """A saved five-piece loadout requests the same active 4p bonus."""
+    return {str(k).casefold():4 if int(v)>=4 else 2 for k,v in sets.items() if int(v)>=2}
+
+def archived_profiles(request):
+    text=request['context']['prepared_config']['text']
+    chars={m[0]:m[1:] for m in re.findall(r'(?m)^\s*([a-z0-9_]+) char lvl=(\d+)/(\d+) cons=(\d+) talent=(\d+),(\d+),(\d+)\s*;',text)}
+    weapons={m[0]:m[1:] for m in re.findall(r'(?m)^\s*([a-z0-9_]+) add weapon="([a-z0-9_]+)" refine=(\d+) lvl=(\d+)/(\d+)\s*;',text)}
+    profiles=[];details=[]
+    for wearer in request['wearers']:
+        key=wearer['wearer_key'];c=chars[key];w=weapons[key]
+        if w[0]!=wearer['weapon_key']:raise ValueError('saved weapon identity mismatch')
+        profiles.append({'character_key':key,'character_level':int(c[0]),'constellation':int(c[2]),
+                         'talents':list(map(int,c[3:6])),'weapon_key':w[0],'refinement':int(w[1]),'weapon_level':int(w[2])})
+        sets=wearer.get('selected_set_package') or [{'set_uid':wearer['selected_set_uid'],'count':4}]
+        details.append({'name':key,'sets':normalize_sets({s['set_uid']:s['count'] for s in sets})})
+    return profiles,{'character_details':details},request['context']['rotation']['text']
+
+def resolve_inputs():
+    from . import case_data as data
+    manifest=json.loads((OUT/'manifest.json').read_bytes())
+    archetypes=json.loads(data.ARCHETYPE_MANIFEST_PATH.read_bytes())['teams']
+    rows=[]
+    for original in manifest['rows']:
+        name=original['case_id'];row={'case_id':name,'status':'missing_saved_config',
+            'source_paths':original['source_paths'],'enumerated_rotation_sha256':original.get('rotation_sha256')}
+        profiles=config=rotation=None;source_paths=[]
+        if name in data.case_ids():
+            case=data.load_case(name);profiles=list(case.source_profiles);rotation=case.rotation_text
+            alias={'overload_chevreuse':'overload','taser_sucrose':'taser'}.get(name)
+            full=OLD/'real-inventory/source-configs'/f'{alias}-source.json' if alias else None
+            config=json.loads(full.read_bytes()) if full else {'character_details':[{'name':key,'sets':{value:4}} for key,value in case.synthetic_set_starts_by_character.items()]}
+            source_paths=[data.CASE_MANIFEST_PATH,data.ARCHETYPE_MANIFEST_PATH,case.rotation_path]+([full] if full else [])
+        elif name in ('gaming_melt','lunar_crystallize','spread','aggravate','burning'):
+            full=OLD/'source-configs'/f'{name}-source.json';config=json.loads(full.read_bytes());profiles=archetypes[name]['virtual_profiles']
+            rotation_path=ROOT/archetypes[name]['rotation_file'];rotation=rotation_path.read_text(encoding='utf-8')
+            source_paths=[full,rotation_path,data.ARCHETYPE_MANIFEST_PATH]
+        elif name in ('tighnari_saved_request','navia_saved_request'):
+            filename={'tighnari_saved_request':'candidate-preservation-tighnari-v2-result__candidate__request.json.gz',
+                      'navia_saved_request':'candidate-preservation-navia-v1-result__cases__navia__candidate__request.json.gz'}[name]
+            source=ROOT/'docs/optimizer-evidence/2026-10-15-mvp-polish'/filename
+            profiles,config,rotation=archived_profiles(json.loads(gzip.decompress(source.read_bytes())))
+            source_paths=[source]
+        elif name=='chasca_600_fixture':
+            source=ROOT/'docs/optimizer-evidence/2026-10-25-chasca-current-button/spec-current.json'
+            spec=json.loads(source.read_bytes());profiles=[{**p,'character_level':90,'weapon_level':90} for p in spec['profiles']]
+            config={'character_details':[{'name':p['character_key'],'sets':{p['selected_set_key']:4}} for p in profiles]}
+            rotation=spec['rotation'];source_paths=[source]
+            row['enumeration_correction']='CSV explicitly cites spec-current.json; its rotation and profile order own this fixture, not mode_matrix chasca.txt'
+        else:
+            row['reason']='Saved recipe lacks a frozen complete material/set configuration in the enumerated sources; no profile/set selection is invented from a similar team.'
+            if name=='flins_jahoda_all_sets_lineage5_exact_input':row.update(status='missing_rotation_file',reason='Exact-lineage rotation and original run are absent; no substitute rotation.')
+        if profiles is not None:
+            details=[{'name':str(d['name']).casefold(),'sets':normalize_sets(d.get('sets',{}))} for d in config['character_details']]
+            config={'character_details':details}
+            if len(profiles)!=4 or len({p['character_key'] for p in profiles})!=4 or {p['character_key'] for p in profiles}!={d['name'] for d in details}:raise ValueError('saved roster mismatch:'+name)
+            pins=[{'path':p.relative_to(ROOT).as_posix(),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in source_paths]
+            row.update(status='ready',profiles=profiles,source_config=config,rotation_text=rotation,
+                       rotation_sha256=hashlib.sha256(rotation.encode()).hexdigest(),source_pins=pins,
+                       material_sha256=digest({'profiles':profiles,'requested_sets':details}),
+                       inventory_policy='Current frozen full account through production loader; no archived artifact IDs reused')
+        rows.append(row)
+    return {'schema':'finite_saved_cache_corpus_inputs_v1','source_manifest_sha256':hashlib.sha256((OUT/'manifest.json').read_bytes()).hexdigest(),'rows':rows}
+
+def write_inputs(output):
+    output=Path(output).resolve();output.relative_to(OUT.resolve());assert_unlinked(output)
+    if output.exists():raise FileExistsError(output)
+    document=resolve_inputs()
+    output.mkdir(parents=True)
+    for row in document['rows']:
+        if row['status']!='ready':continue
+        name=row['case_id'];rotation=output/(name+'-rotation.txt');rotation.write_bytes(row.pop('rotation_text').encode())
+        config=output/(name+'-config.json');config.write_text(json.dumps(row.pop('source_config'),sort_keys=True,indent=2)+'\n',encoding='utf-8')
+        row['rotation_file']=rotation.relative_to(ROOT).as_posix();row['source_config_file']=config.relative_to(ROOT).as_posix()
+        row['source_config_sha256']=hashlib.sha256(config.read_bytes()).hexdigest()
+    target=output/'resolved-inputs.json';target.write_text(json.dumps(document,sort_keys=True,indent=2)+'\n',encoding='utf-8')
+    return target
+
+def load_button_case(path, case_id):
+    from . import case_data as data
+    path=Path(path).resolve(strict=True);assert_unlinked(path);path.relative_to(MANAGED_ROOT.resolve(strict=True))
+    if path.stat().st_size>65536:raise ValueError('corpus case too large')
+    row=json.loads(path.read_bytes())
+    if row['case_id']!=case_id or row['status']!='ready':raise ValueError('corpus case identity mismatch')
+    rotation=(ROOT/row['rotation_file']).resolve(strict=True);rotation.relative_to(ROOT);raw=rotation.read_bytes()
+    if hashlib.sha256(raw).hexdigest()!=row['rotation_sha256']:raise ValueError('saved rotation changed')
+    config=ROOT/row['source_config_file']
+    if hashlib.sha256(config.read_bytes()).hexdigest()!=row['source_config_sha256']:raise ValueError('saved set config changed')
+    profiles=row['profiles'];details=json.loads(config.read_bytes())['character_details']
+    if digest({'profiles':profiles,'requested_sets':details})!=row['material_sha256']:raise ValueError('saved material changed')
+    base=data._load_registered_case('overload_chevreuse')
+    keys=[p['character_key'] for p in profiles]
+    starts=dict(zip(keys,base.synthetic_set_starts_by_character.values(),strict=True))
+    mains=dict(zip(keys,base.baseline_main_stats_by_character.values(),strict=True))
+    return replace(base,case_id=case_id,team_key=case_id,archetype='saved_corpus',source_id=case_id,
+                   source_url='repository://saved-corpus/'+case_id,rotation_path=rotation,rotation_text=raw.decode(),
+                   rotation_sha256=row['rotation_sha256'],source_profiles=tuple(profiles),source_profiles_sha256=digest(profiles),
+                   synthetic_set_starts_by_character=starts,baseline_main_stats_by_character=mains)
