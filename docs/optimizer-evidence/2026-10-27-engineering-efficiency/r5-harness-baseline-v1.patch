+                "<job>/e-profile.exe -test.run=^(" + "|".join(names) + ")$ -test.v -test.parallel=1 -test.timeout=30s",
+                "<job>/e-profile.exe -test.run=^TestAdaptiveHybridSavedReplay$ -test.v -test.parallel=1 -test.timeout=330s"],
+            "cpu_boundary": "Current Go process around RunNeutral only; stop/flush outside measured search; child engine CPU excluded.",
+            "wall_boundary": "Disjoint top-level intervals plus explicit residual cover external RunNeutral wall. Existing aggregate and solver timers are nested diagnostics.",
+            "comparison": "Exact ordered outputs/work/policy inputs and results against saved E, with independent engine randomness deviations exported; parity is an observation, not an execution prerequisite.",
