+def _theory_publication_summary(
+    snapshot: dict,
+    *,
+    elapsed_ms_from_button_click: int | None = None,
+) -> dict:
+    scalar_fields = (
+        "snapshot_version", "publication_version", "phase", "status", "response_status",
+        "reference_score", "practical_band_percent", "sensitivity_band_percent",
+        "found_group_families", "found_group_tuples", "sensitivity_group_families",
+        "sensitivity_group_tuples", "total_found_families", "total_found_tuples",
+        "domain_tuples", "unseen_tuples", "full_cartesian_covered",
+    )
+    summary = {
+        key: snapshot[key]
+        for key in scalar_fields
+        if key in snapshot and isinstance(snapshot[key], (str, int, float, bool))
+    }
+    if type(snapshot.get("finished_early")) is bool:
+        summary["finished_early"] = snapshot["finished_early"]
+    if elapsed_ms_from_button_click is not None:
+        summary["elapsed_ms_from_button_click"] = max(0, int(elapsed_ms_from_button_click))
+    verification = snapshot.get("verification")
+    if isinstance(verification, dict):
+        verification_fields = (
+            "policy_id", "limit", "iterations", "attempted_count", "completed_count",
+            "failed_count", "energy_rejected_count", "candidate_count", "unverified_count",
+            "omitted_count", "remaining_budget", "in_progress", "response_lane_reserve",
+            "response_lane_attempted_count",
+        )
+        summary["verification"] = {
+            key: verification[key]
+            for key in verification_fields
+            if key in verification and isinstance(verification[key], (str, int, float, bool))
+        }
+    rules = snapshot.get("rules")
+    support_status = rules.get("support_response_status") if isinstance(rules, dict) else None
+    verification = summary.get("verification") or {}
+    summary["support_stats"] = {
+        "producer_status": support_status if isinstance(support_status, str) else None,
+        "response_lane_reserve": verification.get("response_lane_reserve"),
+        "response_lane_attempted_count": verification.get("response_lane_attempted_count"),
+        "response_lane_count_semantics": "ordinary finalist candidates selected from the Theory response lane; not support probe calls",
+    }
+
+    row_limit = 7
+    total_retained = 0
+    rows_by_section: dict[str, list[dict]] = {}
+    retention: dict[str, dict[str, int | str | None]] = {}
+    expected_completed = (
+        verification.get("completed_count")
+        if isinstance(verification, dict) and type(verification.get("completed_count")) is int
+        else None
+    )
+    for section in ("co_leaders", "pending"):
+        source_rows = snapshot.get(section)
+        if not isinstance(source_rows, list):
+            rows_by_section[section] = []
+            retention[section] = {
+                "source_count": None,
+                "verified_source_count": None,
+                "unverified_source_count": None,
+                "retained_count": 0,
+                "omitted_count": None,
+                "status": "unknown",
+            }
+            continue
+        retained_rows = []
+        verified_source_count = 0
+        unverified_source_count = 0
+        for row in source_rows:
+            measurement = row.get("measurement") if isinstance(row, dict) else None
+            try:
+                is_verified = (
+                    isinstance(measurement, dict)
+                    and expected_completed is not None
+                    and type(measurement.get("iterations")) is int
+                    and isinstance(verification, dict)
+                    and measurement["iterations"] == verification.get("iterations")
+                    and validate_theory_family(row)
+                )
+            except (KeyError, TypeError, ValueError, OverflowError):
+                is_verified = False
+            if not is_verified:
+                unverified_source_count += 1
+                continue
+            verified_source_count += 1
+            if total_retained < row_limit:
+                retained_rows.append(_theory_family_summary(row))
+                total_retained += 1
+        rows_by_section[section] = retained_rows
+        omitted = verified_source_count - len(retained_rows)
+        retention[section] = {
+            "source_count": len(source_rows),
+            "verified_source_count": verified_source_count,
+            "unverified_source_count": unverified_source_count,
+            "retained_count": len(retained_rows),
+            "omitted_count": omitted,
+            "status": "complete" if omitted == 0 else "truncated",
+        }
+    known_sections = all(retention[section]["source_count"] is not None for section in ("co_leaders", "pending"))
+    verified_source_count = (
+        sum(int(retention[section]["verified_source_count"]) for section in ("co_leaders", "pending"))
+        if known_sections else None
+    )
+    summary["verified_row_retention"] = {
+        "limit": row_limit,
+        "source_count": sum(int(retention[section]["source_count"]) for section in ("co_leaders", "pending")) if known_sections else None,
+        "verified_source_count": verified_source_count,
+        "unverified_source_count": sum(int(retention[section]["unverified_source_count"]) for section in ("co_leaders", "pending")) if known_sections else None,
+        "retained_count": total_retained,
+        "omitted_count": sum(int(retention[section]["omitted_count"]) for section in ("co_leaders", "pending")) if known_sections else None,
+        "verified_count_matches_publication": (
+            verified_source_count == expected_completed
+            if verified_source_count is not None and expected_completed is not None else None
+        ),
+        "status": (
+            "budget_overflow" if known_sections and verified_source_count is not None and verified_source_count > row_limit
+            else "complete" if known_sections and all(retention[section]["status"] == "complete" for section in ("co_leaders", "pending"))
+            else "truncated" if known_sections else "unknown"
+        ),
+        "sections": retention,
+    }
+    summary["theory_families"] = rows_by_section
+    unavailable = snapshot.get("unavailable")
+    summary["unavailable_count"] = len(unavailable) if isinstance(unavailable, list) else None
+    # Only the compact publication and at most seven validated measured rows
+    # are copied; raw search/pending/unavailable collections are never cloned.
+    return copy.deepcopy(summary)
+
