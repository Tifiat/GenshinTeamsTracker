+++ b/tools/experiments/gcsim/mvp_polish/preparation_exact_reuse.py
@@ -0,0 +1,531 @@
+"""Opt-in exact family-program reuse over the retained E source image.
+
+The production/default model remains unchanged. The candidate only aliases an
+already retained ParametricProgram after the normal sparse source composition
+has validated the complete set choices and produced its existing exact family
+identity.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import e_whole_profile as predecessor
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+ROOT = k.ROOT
+EVIDENCE = k.EVIDENCE
+HELPER = Path(__file__).with_name("preparation_exact_reuse_test.go")
+CONTRACT_NAME = "TestAdaptiveHybridContractPreparedPayloadExactReuse"
+CONTRACT_NAMES = [CONTRACT_NAME]
+ALIAS_LIMIT = 128
+SOURCE_FILES: tuple[Path, ...] = tuple(dict.fromkeys((
+    *predecessor.SOURCE_FILES,
+    Path(__file__),
+    HELPER,
+)))
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _replace_once(text: str, before: str, after: str,
+                  restorations: list[tuple[str, str]]) -> str:
+    if text.count(before) != 1:
+        raise ValueError(f"expected one exact-reuse source seam: {before!r}")
+    text = text.replace(before, after, 1)
+    restorations.append((after, before))
+    return text
+
+
+def _erase(text: str, restorations: list[tuple[str, str]]) -> str:
+    for changed, original in reversed(restorations):
+        if text.count(changed) != 1:
+            raise ValueError("exact-reuse observer erasure seam is ambiguous")
+        text = text.replace(changed, original, 1)
+    return text
+
+
+def _expressions_image(raw: bytes) -> tuple[bytes, bytes]:
+    text = raw.decode("utf-8")
+    restorations: list[tuple[str, str]] = []
+    text = _replace_once(
+        text,
+        "\tSparseEffects map[int]*formula.InputExpression // private compact consumer path\n"
+        "\tConstants     []float64\n"
+        "\tEffects       map[string]*formula.InputExpression\n"
+        "\tBoundaries    []string\n"
+        "\tUncertainty   []string\n",
+        "\tSparseEffects map[int]*formula.InputExpression // private compact consumer path\n"
+        "\tConstants     []float64\n"
+        "\tEffects       map[string]*formula.InputExpression\n"
+        "\tBoundaries    []string\n"
+        "\tUncertainty   []string\n"
+        "\tpayloadIdentity string\n"
+        "\tpayloadIdentityValid bool\n",
+        restorations,
+    )
+    text = _replace_once(
+        text,
+        "func (x NeutralExpressions) Complete() bool { return len(x.Boundaries) == 0 }\n",
+        "func (x NeutralExpressions) Complete() bool { return len(x.Boundaries) == 0 }\n\n"
+        "// ResearchPreparedPayloadIdentity returns the existing validated sparse-family identity.\n"
+        "// It is only an opaque alias key within the owning NeutralModel lifetime.\n"
+        "func (x NeutralExpressions) ResearchPreparedPayloadIdentity() (string, bool) {\n"
+        "\treturn x.payloadIdentity, x.payloadIdentityValid\n"
+        "}\n",
+        restorations,
+    )
+    changed = text.encode("utf-8")
+    erased = _erase(text, restorations).encode("utf-8")
+    if erased != raw:
+        raise ValueError("NeutralExpressions observer does not erase to exact E source")
+    return changed, erased
+
+
+def _composition_image(raw: bytes) -> tuple[bytes, bytes]:
+    text = raw.decode("utf-8")
+    restorations: list[tuple[str, str]] = []
+    text = _replace_once(
+        text,
+        'import (\n\t"fmt"\n\t"genshinteamstracker/native/gcsim_optimizer/internal/formula"\n',
+        'import (\n\t"fmt"\n\t"genshinteamstracker/native/gcsim_optimizer/internal/contracts"\n\t"genshinteamstracker/native/gcsim_optimizer/internal/formula"\n',
+        restorations,
+    )
+    text = _replace_once(
+        text,
+        "\t\tif cached, ok := b.composedPayloads[payloadKey]; ok {\n"
+        "\t\t\tb.stats.FamilyHits++\n"
+        "\t\t\tcached.footprint = ruleFootprint{}\n",
+        "\t\tif cached, ok := b.composedPayloads[payloadKey]; ok {\n"
+        "\t\t\tb.stats.FamilyHits++\n"
+        "\t\t\tcached.payloadIdentity = payloadKey\n"
+        "\t\t\tcached.payloadIdentityValid = cached.Complete()\n"
+        "\t\t\tcached.footprint = ruleFootprint{}\n",
+        restorations,
+    )
+    text = _replace_once(
+        text,
+        "\tif sparse {\n"
+        "\t\tb.retainComposedPayload(payloadKey, out)\n"
+        "\t}\n"
+        "\treturn out\n",
+        "\tif sparse && out.Complete() {\n"
+        "\t\tout.payloadIdentity = payloadKey\n"
+        "\t\tout.payloadIdentityValid = true\n"
+        "\t\tb.retainComposedPayload(payloadKey, out)\n"
+        "\t}\n"
+        "\treturn out\n",
+        restorations,
+    )
+    text = _replace_once(
+        text,
+        "func (b *NeutralBinding) CompilePackagesSparse(choices []RuleChoice) NeutralExpressions {\n"
+        "\treturn b.compilePackages(choices, true, true)\n"
+        "}\n",
+        "func (b *NeutralBinding) CompilePackagesSparse(choices []RuleChoice) NeutralExpressions {\n"
+        "\treturn b.compilePackages(choices, true, true)\n"
+        "}\n\n"
+        "// ResearchPreparedPayloadIdentityContract exercises the actual sparse composer\n"
+        "// and identity producer with owned constant components, including latent ports.\n"
+        "func ResearchPreparedPayloadIdentityContract() error {\n"
+        "\tchoice := RuleChoice{Owner: 0, Key: \"probe\", Pieces: 2}\n"
+        "\tmakeBinding := func(live, latent float64) *NeutralBinding {\n"
+        "\t\tneutral := &contracts.NeutralInputs{Context: contracts.NeutralContext{Characters: []contracts.NeutralCharacter{{Index: 0, Key: \"actor_a\"}}}}\n"
+        "\t\tb := &NeutralBinding{members: []neutralBoundMember{{neutral: neutral, ports: []neutralBoundPort{{dimension: 0}, {dimension: 1}}}}, keys: []string{\"neutral:0:live\", \"neutral:0:latent\"}, components: map[RuleChoice]neutralComponent{}}\n"
+        "\t\tcomponent := b.componentOf(NeutralExpressions{raw: []float64{live, latent}, Effects: map[string]*formula.InputExpression{}, Boundaries: []string{}, Uncertainty: []string{}})\n"
+        "\t\tb.components[choice] = component\n"
+        "\t\treturn b\n"
+        "\t}\n"
+        "\tfirstBinding := makeBinding(0.125, 0.5)\n"
+        "\tfirst := firstBinding.CompilePackagesSparse([]RuleChoice{choice})\n"
+        "\tfirstIdentity, firstValid := first.ResearchPreparedPayloadIdentity()\n"
+        "\tif len(first.Constants) != 2 || first.Constants[0] != 0.125 || first.Constants[1] != 0.5 { return fmt.Errorf(\"actual sparse composer changed its complete constant vector: %v\", first.Constants) }\n"
+        "\tsecond := firstBinding.CompilePackagesSparse([]RuleChoice{choice})\n"
+        "\tsecondIdentity, secondValid := second.ResearchPreparedPayloadIdentity()\n"
+        "\tif !firstValid || !secondValid || firstIdentity == \"\" || firstIdentity != secondIdentity || firstBinding.stats.FamilyHits != 1 { return fmt.Errorf(\"actual sparse composition did not preserve a complete family identity: valid=%v/%v hits=%d\", firstValid, secondValid, firstBinding.stats.FamilyHits) }\n"
+        "\tchangedLive := makeBinding(0.25, 0.5).CompilePackagesSparse([]RuleChoice{choice})\n"
+        "\tchangedLiveIdentity, changedLiveValid := changedLive.ResearchPreparedPayloadIdentity()\n"
+        "\tif !changedLiveValid || changedLiveIdentity == firstIdentity { return fmt.Errorf(\"live raw constant was omitted from actual family identity\") }\n"
+        "\tchangedLatent := makeBinding(0.125, 0.75).CompilePackagesSparse([]RuleChoice{choice})\n"
+        "\tchangedIdentity, changedValid := changedLatent.ResearchPreparedPayloadIdentity()\n"
+        "\tif !changedValid || changedIdentity == firstIdentity { return fmt.Errorf(\"latent raw constant was omitted from actual family identity\") }\n"
+        "\treturn nil\n"
+        "}\n\n"
+        "// ResearchPreparedPayloadUncertaintyFixture supplies two sparse-composition\n"
+        "// choices with identical complete vectors but distinct current uncertainty.\n"
+        "func ResearchPreparedPayloadUncertaintyFixture() (*NeutralBinding, []RuleChoice, []RuleChoice) {\n"
+        "\tneutral := &contracts.NeutralInputs{Context: contracts.NeutralContext{Characters: []contracts.NeutralCharacter{{Index: 0, Key: \"actor_a\"}, {Index: 1, Key: \"actor_b\"}, {Index: 2, Key: \"actor_c\"}, {Index: 3, Key: \"actor_d\"}}}}\n"
+        "\tfirstChoice := RuleChoice{Owner: 0, Key: \"probe_a\", Pieces: 2}\n"
+        "\tsecondChoice := RuleChoice{Owner: 0, Key: \"probe_b\", Pieces: 2}\n"
+        "\tb := &NeutralBinding{members: []neutralBoundMember{{neutral: neutral, ports: []neutralBoundPort{{dimension: 0}, {dimension: 1}}}}, keys: []string{\"neutral:0:live\", \"neutral:0:latent\"}, ports: []formula.EffectPort{{Member: 0, NodeID: 1, Key: \"neutral:0:live\", Observed: 0}, {Member: 0, NodeID: 2, Key: \"neutral:0:latent\", Observed: 0}}, reads: []formula.ReadRoot{{Member: 0, NodeID: 2, Key: \"neutral-read:0:latent\", Observed: 0}}, components: map[RuleChoice]neutralComponent{}}\n"
+        "\tfor choice, uncertainty := range map[RuleChoice]string{firstChoice: \"research_uncertainty_a\", secondChoice: \"research_uncertainty_b\"} {\n"
+        "\t\tcomponent := b.componentOf(NeutralExpressions{raw: []float64{0, 0}, Effects: map[string]*formula.InputExpression{}, Boundaries: []string{}, Uncertainty: []string{uncertainty}})\n"
+        "\t\tb.components[choice] = component\n"
+        "\t}\n"
+        "\treturn b, []RuleChoice{firstChoice}, []RuleChoice{secondChoice}\n"
+        "}\n",
+        restorations,
+    )
+    changed = text.encode("utf-8")
+    erased = _erase(text, restorations).encode("utf-8")
+    if erased != raw:
+        raise ValueError("composition observer does not erase to exact E source")
+    return changed, erased
+
+
+def _neutral_model_image(raw: bytes) -> tuple[bytes, bytes]:
+    text = raw.decode("utf-8")
+    restorations: list[tuple[str, str]] = []
+    text = _replace_once(
+        text,
+        'import (\n\t"fmt"\n',
+        'import (\n\t"fmt"\n\t"math"\n'
+        '\t"genshinteamstracker/native/gcsim_optimizer/internal/contracts"\n',
+        restorations,
+    )
+    text = _replace_once(
