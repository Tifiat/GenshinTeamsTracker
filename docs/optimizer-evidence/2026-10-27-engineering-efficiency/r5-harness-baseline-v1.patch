+def validate_protocol(value, operation, *, released=True):
+    limits = {"compile_guards": COMPILE_LIMITS, "pair": PAIR_LIMITS,
+              "cleanup_private": {**COMPILE_LIMITS, "whole_seconds": 120,
+                                  "builds": 0, "guard_executions": 0}}[operation]
+    require(value.get("schema_kind") == "gtt_main_navia_exact_pair_protocol_v1"
+            and value.get("operation") == operation and value.get("limits") == limits
+            and value.get("packet_sha256") == PACKET_SHA
+            and value.get("baseline_source_sha256") == D345
+            and value.get("candidate_source_sha256") == D346
+            and value.get("guard_regex") == GUARD_REGEX
+            and value.get("cleanup_reserve_seconds") == CLEANUP_RESERVE
+            and value.get("install_authorized") is False
+            and value.get("engine_authorized") is (operation == "pair")
+            and re.fullmatch(r"[a-z0-9-]{1,80}", value.get("lease_id", "")) is not None,
+            "navia_protocol_scope")
+    require(type(value.get("source_pins")) is dict
+            and {THIS, PREPARER, IDLE_FRAGMENT} <= set(value["source_pins"])
+            and value["source_pins"][IDLE_FRAGMENT] == IDLE_SHA
+            and value.get("go_sha256") == GO_SHA and value.get("python_sha256") == PYTHON_SHA,
+            "navia_controller_source_pins")
+    for relative, expected in value["source_pins"].items():
+        require(type(relative) is str and not Path(relative).is_absolute()
+                and ".." not in Path(relative).parts and re.fullmatch("[0-9a-f]{64}", expected or ""),
+                "navia_controller_pin_shape")
+    require((operation == "pair") == (value.get("private_input") is not None)
+            and (operation == "cleanup_private") == (value.get("cleanup") is not None),
+            "navia_private_operation_binding")
+    if released:
+        require(value.get("state") == "root_released_once" and value.get("root_reviewed") is True
+                and value.get("execution_authorized") is True,
+                "navia_explicit_operation_release_required")
+        require(operation == "cleanup_private" or (type(value.get("pins")) is dict
+                and type(value.get("before")) is dict), "navia_fresh_protected_snapshot_required")
+    return value
+
