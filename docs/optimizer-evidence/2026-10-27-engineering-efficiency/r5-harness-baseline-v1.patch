+def _contract_names(overlay: dict[str, Any]) -> list[str]:
+    def collect(bundle: dict[str, Any]) -> list[str]:
+        names = []
+        for path, raw in (*bundle["images"].items(), *bundle["overlay_files"].items()):
+            if path.startswith("internal/allsets/") and path.endswith("_test.go"):
+                names.extend(re.findall(
+                    r"^func (TestAdaptiveHybridContract\w*)\(t \*testing\.T\)",
+                    raw.decode("utf-8"), re.MULTILINE))
+        if not names or len(names) != len(set(names)):
+            raise ValueError("AllSets contract names absent or duplicated")
+        return sorted(names)
+
+    names = collect(overlay)
+    previous = collect(local_pair.producer.damped_whole.damped_whole_overlay())
+    if not set(previous).issubset(names) or not set(local_pair._contract_names()).issubset(names):
+        raise ValueError("whole-D or six focused pair contracts absent from the same AllSets binary")
+    return names
+
