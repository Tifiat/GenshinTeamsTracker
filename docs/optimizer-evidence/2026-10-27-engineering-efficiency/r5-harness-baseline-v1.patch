+"""Owning mechanic observation delta over the accepted engine source tree.
+
+This produces source images for a managed copy. It never edits the active
+engine. The generated operation table is bound by the ordinary source manifest.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from tools.experiments.gcsim.mvp_polish import mechanic_compiler_stage as stage
+
+ROOT = stage.ROOT
+ENGINE = ROOT / "data/gcsim/engines/engines/gcsim-v2.45.0-unified-health-20261023"
+TEMPLATES = Path(__file__).with_name("mechanic_engine_source")
+
+
+def images() -> dict[str, bytes]:
+    out = {p.relative_to(TEMPLATES).as_posix(): p.read_bytes() for p in TEMPLATES.rglob("*.go")}
+    for name in ("mechanic_operations.go", "mechanic_arguments.go"):
+        out["pkg/gtttrace/" + name] = (stage.NATIVE / "internal/contracts" / name).read_text(encoding="utf-8").replace("package contracts", "package gtttrace", 1).encode()
+
+    def edit(name: str, before: str, after: str) -> None:
+        text = out.get(name, (ENGINE / name).read_bytes()).decode()
+        out[name] = stage.replace_once(text, before, after).encode()
+
+    edit("pkg/gtttrace/runtime.go", "type Runtime struct {", "type Runtime struct {\n\tmechanics *mechanicRuntime")
+    edit("internal/template/character/character.go", "type Character struct {", "//gtt:mechanic-state Core.GTTTrace action_schedule schedule\ntype Character struct {")
+    for field in ("ActionCD", "cdQueueWorkerStartedAt", "cdQueue", "AvailableCDCharge", "additionalCDCharge"):
+        text = out["internal/template/character/character.go"].decode()
+        lines = text.splitlines(keepends=True)
+        matching = [i for i,line in enumerate(lines) if line.lstrip().startswith(field+" ") or line.lstrip().startswith(field+"\t")]
+        if len(matching) != 1:
+            raise RuntimeError("mechanic resource field anchor changed: " + field)
+        lines.insert(matching[0], "\t//gtt:mechanic-resource raw\n")
