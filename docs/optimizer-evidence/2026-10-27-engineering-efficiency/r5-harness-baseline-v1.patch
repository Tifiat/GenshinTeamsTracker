+"""Only defer discarded attack containers on an existing exact Amount hit."""
+from __future__ import annotations
+
+from pathlib import Path
+from tools.experiments.gcsim.mvp_polish import preparation_v2_measure_run as saved
+
+ROOT, NATIVE, EVIDENCE = saved.ROOT, saved.NATIVE, saved.EVIDENCE
+HERE = Path(__file__).parent
+BRIDGE = HERE / "wire_amount_bridge.go"
+PREFIX = "wire-amount-v3"
+LIMITS = {"whole_seconds": 1800, "cleanup_reserve_seconds": 180,
+          "build_seconds": 240, "focus_seconds": 45, "micro_seconds": 30,
+          "search_seconds": 240, "micro_iterations": 100000,
+          "builds": 2, "full_replays": 2, "micro_samples": 6,
+          "scratch_bytes": 2 << 30, "retained_bytes": 64 << 20}
+
+
+def overlay(candidate: bool) -> dict:
+    base = saved.producer.overlay(False)
+    images, extras = dict(base["images"]), dict(base["extras"])
+    name = "internal/seteffects/rule_replay.go"
+    old = '''\t\targs := []any{}
+\t\tswitch q.Kind {
+\t\tcase "attack":
+\t\t\ttyp := strings.TrimPrefix(h.targets[q.Target].Type, "*")
+\t\t\targs = []any{h.wire(q.Attack), ruleRef{kind: "target", index: q.Target, typ: typ}}
+\t\tcase "reaction":
+\t\t\targs = []any{h.wire(q.Attack)}
+\t\t}
+\t\tbefore := len(h.mods)
+\t\tvalue, err := h.amount(m, q, args)'''
+    new = '''\t\t// wire constructs values but never mutates host modifiers/cache.
+\t\tbefore := len(h.mods)
+\t\tvalue, err := h.researchQueryAmount(m, q)'''
+    images[name] = saved.producer.patch_source(images[name], [(old, new)])
+    name = "internal/seteffects/rule_amount_cache.go"
+    images[name] = saved.producer.patch_source(images[name], [
+        ("func (h *ruleReplayHost) amount(m replayMod, q RuleQuery, args []any) (any, error) {", "func (h *ruleReplayHost) amount(m replayMod, q RuleQuery, args []any) (any, error) {\n\tresearchWireStats.AmountCalls++"),
+        ("\t\t\treturn cached.value, cached.err", "\t\t\tresearchWireStats.AmountCacheHits++\n\t\t\treturn cached.value, cached.err"),
+        ("\tvalue, err := ruleTry(func() any { return m.vm.invokeAmount(m.object.fields[\"Amount\"].(*ruleFunction), args) })", "\tresearchWireStats.AmountVMInvocations++\n\tvmStart := time.Now()\n\tvalue, err := ruleTry(func() any { return m.vm.invokeAmount(m.object.fields[\"Amount\"].(*ruleFunction), args) })\n\tresearchWireStats.AmountVMNanos += time.Since(vmStart).Nanoseconds()"),
+        ("package seteffects\n", "package seteffects\n\nimport \"time\"\n"),
+    ])
+    helper_name = "internal/allsets/zz_preparation_v2_measure_test.go"
+    helper = extras[helper_name].decode()
+    helper = helper.replace('func TestPreparationSavedV2(', 'func TestWireAmountSavedReplay(')
+    helper = helper.replace('(arm!="control"&&arm!="instrumented")', '(arm!="control"&&arm!="candidate")')
+    helper = helper.replace('if arm=="instrumented"{', 'if false{')
+    helper = helper.replace('start:=time.Now();result,runErr:=RunNeutral', 'seteffects.ResearchWireReset(); start:=time.Now();result,runErr:=RunNeutral')
+    helper = helper.replace('"schema":"preparation_v2_measure_output_v1"', '"schema":"wire_amount_saved_output_v1","wire_metrics":seteffects.ResearchWireSnapshot()')
+    helper += r'''
+
+func TestWireAmountFocused(t *testing.T) {
+ report:=seteffects.ResearchWireFocused(t)
+ raw,err:=json.Marshal(report);if err!=nil{t.Fatal(err)}
+ path:=os.Getenv("GTT_WIRE_OUTPUT");if path==""{t.Fatal("focused output required")}
+ if err=os.WriteFile(path,raw,0600);err!=nil{t.Fatal(err)}
+}
+func TestWireAmountMicro(t *testing.T) {
+ var attack contracts.EventValue
+ raw,err:=os.ReadFile(os.Getenv("GTT_WIRE_ATTACK"));if err!=nil{t.Fatal(err)}
+ if err=json.Unmarshal(raw,&attack);err!=nil{t.Fatal(err)}
+ report:=seteffects.ResearchWireMicro(t,attack,100000)
+ raw,err=json.Marshal(report);if err!=nil{t.Fatal(err)}
+ path:=os.Getenv("GTT_WIRE_OUTPUT");if path==""{t.Fatal("micro output required")}
+ if err=os.WriteFile(path,raw,0600);err!=nil{t.Fatal(err)}
+}
+'''
+    if 'seteffects.ResearchWireReset(); start:=' not in helper or 'if arm=="instrumented"{' in helper:
+        raise ValueError("wire_shared_helper_patch")
+    extras[helper_name] = helper.encode()
+    extras["internal/seteffects/zz_wire_amount_bridge.go"] = BRIDGE.read_bytes()
+    extras["internal/seteffects/zz_wire_amount_config.go"] = ("package seteffects\nconst researchWireLazy = " + ("true" if candidate else "false") + "\n").encode()
+    return {"images": images, "extras": extras,
+        "image_map_sha256": saved.scope.sha(saved.dense.canonical(saved.dense.image_hashes(images))),
+        "extra_map_sha256": saved.scope.sha(saved.dense.canonical(saved.dense.image_hashes(extras)))}
diff --git a/tools/experiments/gcsim/mvp_polish/wire_amount_run.py b/tools/experiments/gcsim/mvp_polish/wire_amount_run.py
new file mode 100644
--- /dev/null
+++ b/tools/experiments/gcsim/mvp_polish/wire_amount_run.py
@@ -0,0 +1,256 @@
+"""Finite, uninstalled wire/cache experiment using the existing saved V2 replay."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import statistics
+import sys
+import time
+
+sys.dont_write_bytecode = True
+from tools.experiments.gcsim.mvp_polish import wire_amount_overlay as candidate
+
+saved = candidate.saved
+dense, scope, installed, gate = saved.dense, saved.scope, saved.installed, saved.gate
+ROOT, NATIVE, EVIDENCE = candidate.ROOT, candidate.NATIVE, candidate.EVIDENCE
+PREFIX, LIMITS = candidate.PREFIX, candidate.LIMITS
+FREEZE, RESULT = [EVIDENCE / (PREFIX + suffix) for suffix in ("-freeze.json", "-result.json")]
+require = saved.require
+ARMS = ("control", "candidate")
+
+
+def pins():
+    paths = [Path(__file__), Path(candidate.__file__), candidate.BRIDGE]
+    return {**saved.pins(), **{p.relative_to(ROOT).as_posix(): installed.sha_file(p) for p in paths}}
+
+
+def attack_sample(inputs):
+    name = next(n for n in sorted(inputs["files"]) if n.endswith("member.json.effects.json"))
+    source = inputs["files"][name]
+    value = json.loads(saved.producer.archived({"archive": source}))
+    index, hit = next((i, h) for i, h in enumerate(value["neutral"]["hits"]) if h.get("attack"))
+    raw = dense.canonical(hit["attack"])
+    return raw, {"input": name, "input_raw_sha256": source["raw_sha256"], "seed": value["seed"],
+                 "hit_index": index, "hit_id": hit.get("id"), "raw_sha256": scope.sha(raw), "raw_bytes": len(raw)}
+
+
+def prepare():
+    require(not FREEZE.exists() and not RESULT.exists(), "wire_already_prepared")
+    inputs = saved.producer.inputs()
+    overlays = {a: candidate.overlay(a == "candidate") for a in ARMS}
+    require(overlays["control"]["images"] == overlays["candidate"]["images"], "wire_common_images")
+    require(overlays["control"]["extras"].keys() == overlays["candidate"]["extras"].keys(), "wire_common_extra_set")
+    differences = [n for n in overlays["control"]["extras"] if overlays["control"]["extras"][n] != overlays["candidate"]["extras"][n]]
+    require(differences == ["internal/seteffects/zz_wire_amount_config.go"], "wire_arm_difference")
+    base = dense.base_images()
+    _, attack = attack_sample(inputs)
+    plan = {"schema": "wire_amount_plan_v1", "limits": LIMITS, "source_pins": pins(), "inputs": inputs,
+        "base_map_sha256": scope.sha(dense.canonical(dense.image_hashes(base))), "attack_sample": attack,
+        "arms": {a: {k: o[k] for k in ("image_map_sha256", "extra_map_sha256")} for a, o in overlays.items()},
+        "physical_exclusions": saved.exclusions(base), "protected_before": scope.accepted.K.protected(),
+        "native_before": scope.accepted.K.old.native_map(), "dirty_before": installed.dirty_map(),
+        "python_sha256": installed.sha_file(Path(sys.executable)), "go_sha256": installed.sha_file(gate.owned.GO_EXE),
+        "consumer_sha256": installed.sha_file(installed.CONSUMER),
+        "micro_order": ["control", "candidate", "candidate", "control", "control", "candidate"],
+        "full_order": list(ARMS), "engine_calls": 0, "installs": 0,
+        "control": "accepted eager conversion and Amount cache semantics, identical diagnostic instrumentation; focused legacy-reference parity",
+        "candidate": "confirmed exact cache hit only: same array/object traversal; every leaf through owning wire; discard containers; no reset/insert before validation",
+        "limits_of_claim": ["map invalid-leaf iteration is nondeterministic in both; no arbitrary panic/OOM/allocation parity claim",
+            "100% hit micro fixture is not production savings; full pair descriptive single ordered sample",
+            "source core accepted361; installed dense decoder difference precedes decoded replay; no runtime installation",
+            "historical skipped_duplicate not published, remains unknown; historical JSONL unavailable"],
+        "metadata_exclusions": ["timing keys: existing saved.scrub seconds/nanos/elapsed/_ms convention", "invocation_bytes only after exact file-size binding and journal semantic parity"],
+        "export": "both arm recursive .json/.jsonl plus top logs/outputs/overlays/manifests; hashes/readback before managed cleanup"}
+    scope.cases.write_once(FREEZE, plan)
+    return {"freeze": str(FREEZE), "sha256": installed.sha_file(FREEZE), "inputs": len(inputs["files"]), "attack": attack}
+
+
+def stage(job, plan, arm):
+    o = candidate.overlay(arm == "candidate")
+    require({k: o[k] for k in ("image_map_sha256", "extra_map_sha256")} == plan["arms"][arm], "wire_overlay_drift")
+    replace = {}
+    for name, raw in {**o["images"], **o["extras"]}.items():
+        path = job / (arm + "-source") / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(raw)
+        require(installed.sha_file(path) == scope.sha(raw), "wire_stage_drift")
+        replace[str(NATIVE / name)] = str(path)
+    replace.update({str(NATIVE / name): "" for name in plan["physical_exclusions"]})
+    path = job / (arm + "-overlay.json")
+    scope.cases.write_once(path, {"Replace": replace})
+    require(json.loads(dense.read(path))["Replace"] == replace, "wire_overlay_readback")
+    return path
+
+
+def semantic(value, parent=""):
+    # The sole extra exclusion is file length, separately bound below to journal bytes.
+    value = saved.scrub(value)
+    if isinstance(value, dict):
+        return {k: semantic(v, k) for k, v in value.items() if not (parent == "final_pair_completion" and k == "invocation_bytes")}
+    if isinstance(value, list):
+        return [semantic(v, parent) for v in value]
+    return value
+
+
+def compare(job, outputs, original):
+    keys = ("search_work", "search_expansions", "neutral_cycles", "raw_finalists", "initial", "selected", "leader", "boundaries",
+        "neutral_stabilization", "neutral_package_joint", "neutral_model", "adaptive_policy", "queued", "unqueued", "pending",
+        "reservation_deferred", "skipped_duplicate", "guides", "stop_reason", "saved_policy_calls", "engine_process_calls", "provider_calls")
+    equal = {k: semantic(outputs["control"][k]) == semantic(outputs["candidate"][k]) for k in keys}
+    require(all(equal.values()), "wire_full_pair_semantic_parity:" + str([k for k, ok in equal.items() if not ok]))
+    mapping = {"search_work": "search_work", "search_expansions": "search_expansions", "neutral_cycles": "neutral_cycles",
+        "boundaries": "effect_boundaries", "neutral_stabilization": "neutral_stabilization", "neutral_package_joint": "neutral_package_joint",
+        "neutral_model": "neutral_model", "adaptive_policy": "adaptive_policy", "queued": "queued", "unqueued": "unqueued_across_guides",
+        "pending": "pending", "reservation_deferred": "reservation_deferred", "guides": "guides", "stop_reason": "search_stop_reason"}
+    historical = {k: semantic(outputs["control"][k]) == semantic(original[v]) for k, v in mapping.items()}
+    raw = original["neutral_search_finalists"]["rows"]
+    expected = [{"assignment": v["score"]["assignment"], "formula_dps": v["score"]["dps"], "packages": v["packages"],
+        "context_sha256": v["context_sha256"], "rendered_config_sha256": v["config_sha256"], "score_source": v["score"]["source"]} for v in raw]
+    historical["raw_finalists"] = len(raw) == len(outputs["control"]["raw_finalists"]) and all(
+        all(actual[k] == v for k, v in row.items()) for actual, row in zip(outputs["control"]["raw_finalists"], expected))
+    require(all(historical.values()), "wire_historical_parity:" + str([k for k, ok in historical.items() if not ok]))
+    clock = {}
+    for arm in ARMS:
+        a, b = outputs[arm]["adaptive_policy"], original["adaptive_policy"]
+        clock[arm] = a["engine_wall_ms"] == b["engine_wall_ms"] and a["engine_ms"] == b["engine_ms"] and [(s["elapsed_ms"], s["engine_elapsed_ms"]) for s in a["samples"]] == [(s["elapsed_ms"], s["engine_elapsed_ms"]) for s in b["samples"]]
+    require(all(clock.values()), "wire_logical_clock")
+    journals = {a: {p.relative_to(job / a).as_posix(): p for p in (job / a).rglob("*.jsonl")} for a in ARMS}
+    expected_journals = {"adaptive-policy-progress.jsonl", "early-preparation-admission.jsonl", "adaptive-damped-whole-screening.jsonl", "final-pair-whole-plan.jsonl", "final-pair-whole-stabilization.jsonl"}
+    require(set(journals["control"]) == set(journals["candidate"]) == expected_journals, "wire_journal_set")
+    journal_proof = {}
+    for name in journals["control"]:
+        rows = {a: [json.loads(row) for row in dense.read(journals[a][name]).splitlines() if row.strip()] for a in ARMS}
+        require(semantic(rows["control"]) == semantic(rows["candidate"]), "wire_journal_parity:" + name)
+        journal_proof[name] = {"rows": len(rows["control"]), "semantic_equal": True,
+            "bytes": {a: journals[a][name].stat().st_size for a in ARMS}}
+    length_proof = {}
+    for arm in ARMS:
+        completion = outputs[arm]["adaptive_policy"]["final_pair_completion"]
+        length = completion["invocation_bytes"]
+        matches = [n for n, p in journals[arm].items() if p.stat().st_size == length and n == "final-pair-whole-stabilization.jsonl"]
+        require(len(matches) == 1, "wire_invocation_bytes_binding")
+        length_proof[arm] = {"bytes": length, "file": matches[0]}
+    invariant_names = ("AttackReactionCalls", "CacheHits", "CacheMisses", "AmountCalls", "AmountCacheHits", "AmountVMInvocations")
+    metrics = {a: outputs[a]["wire_metrics"] for a in ARMS}
+    invariants = {k: metrics["control"][k] == metrics["candidate"][k] for k in invariant_names}
+    require(all(invariants.values()), "wire_counter_parity")
+    avoided = metrics["control"]["RootConversions"] - metrics["candidate"]["RootConversions"]
+    require(avoided == metrics["candidate"]["LeafValidationWalks"] == metrics["candidate"]["CacheHits"], "wire_conversion_accounting")
+    return {"pair": equal, "historical": historical, "historical_skipped_duplicate": "unknown/unpublished", "logical_clock": clock,
+        "journals": journal_proof, "invocation_bytes_binding": length_proof, "metric_invariants": invariants, "avoided_root_conversions": avoided}
+
+
+def execute(expected):
+    require(installed.sha_file(FREEZE) == expected, "wire_freeze_sha")
+    plan = json.loads(dense.read(FREEZE))
+    require(plan["source_pins"] == pins() and plan["limits"] == LIMITS and not RESULT.exists(), "wire_plan_drift")
