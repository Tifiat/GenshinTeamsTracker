+                            log_path=job / "checks.log", timeout_seconds=600)
+            raw = (job / "checks.log").read_bytes()
+            (OUT / (label + "-go.log")).write_bytes(raw)
+            record["commands"].append({"command": result,
+                                       "log_sha256": hashlib.sha256(raw).hexdigest()})
+            record["status"] = "passed" if previous.gate.command_passed(result) else "failed"
+        finally:
+            record["protected_exact"] = previous.scope.accepted.K.protected() == baseline["protected_before"]
+            current = previous.scope.accepted.K.old.native_map()
+            record["foreign_native_exact"] = all(current.get(n, "absent") == sha for n, sha in baseline["native_before"].items() if n not in CHANGED)
+            target.write_text(json.dumps(record, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    record["managed_job_removed"] = not job.exists()
+    target.write_text(json.dumps(record, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    return {**{k: v for k, v in record.items() if k not in {"source_images", "commands", "changed_files", "owned_live_source_sha256"}}, "changed_file_count": len(CHANGED)}
+
+
+if __name__ == "__main__":
+    print(json.dumps(check(sys.argv[1])))
