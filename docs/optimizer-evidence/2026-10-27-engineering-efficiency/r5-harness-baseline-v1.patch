+def require(condition, code):
+    if not condition:
+        raise ValueError(code)
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"),
+                      ensure_ascii=False, allow_nan=False).encode("utf-8")
+
+
+def digest(value):
+    return hashlib.sha256(canonical(value)).hexdigest()
+
+
+def read_json(path, maximum=LIMITS["raw_output_bytes"]):
+    managed.assert_unlinked(path)
+    with path.open("rb") as stream:
+        raw = stream.read(maximum + 1)
+    require(0 < len(raw) <= maximum, "json_size_invalid")
+    def pairs(items):
+        out = {}
+        for key, value in items:
+            require(key not in out, "duplicate_json_key")
+            out[key] = value
+        return out
+    def nonfinite(_):
+        raise ValueError("nonfinite_json")
+    value = json.loads(raw, object_pairs_hook=pairs, parse_constant=nonfinite)
+    require(type(value) is dict, "json_object_required")
+    return value
+
+
+def exact(value):
+    """Bind float64 bits, including signed zero; never tolerance-match formulas."""
+    if type(value) is float:
+        require(math.isfinite(value), "nonfinite_value")
+        return {"float64_bits": struct.pack(">d", value).hex()}
+    if type(value) is dict:
+        return {key: exact(item) for key, item in value.items()}
+    if type(value) is list:
+        return [exact(item) for item in value]
+    return value
+
+
+def semantic(value):
+    if type(value) is dict:
+        out = {}
+        for key, item in value.items():
+            lower = key.casefold()
+            if (key in VOLATILE or lower.endswith("seconds") or lower.endswith("_ms")
+                    or lower in {"elapsedms", "processms", "decodems"}):
+                continue
+            if lower in {"assignment", "artifacts", "winner", "anchor"} and isinstance(item, (dict, list)):
+                out[key + "_sha256"] = digest(exact(item))
+            else:
+                out[key] = semantic(item)
+        return out
+    if type(value) is list:
+        return [semantic(item) for item in value]
+    return exact(value)
+
+
+def model_projection(output):
+    require(all(key in output for key in ("search_work", "context_panel", "search_config")),
+            "model_evidence_missing")
+    projection = {key: semantic(output[key]) for key in MODEL_KEYS if key in output}
+    # Preserve every package/witness in the comparison; retain only bounded
+    # grouped commitments rather than the account's full assignment vectors.
+    groups = defaultdict(list)
+    for row in output["search_work"]:
+        groups[tuple(row.get("packages", []))].append(semantic(row))
+    packages = [{"packages": list(key), "witnesses": len(rows), "sha256": digest(rows)}
+                for key, rows in sorted(groups.items())]
+    contexts = {row.get("ContextSHA256") for row in output["context_panel"]}
+    finalists = {row["context_sha256"]: row.get("packages", []) for row in output["search_work"]
+                if row.get("context_sha256") in contexts}
+    return projection, {"sha256": digest(projection), "work_rows": len(output["search_work"]),
+                        "context_rows": len(output["context_panel"]), "package_groups": len(packages),
+                        "all_packages_and_witnesses_sha256": digest(packages), "finalist_packages": finalists,
+                        "performance_counters": [{key: row[key] for key in ("Cycle", "CandidateSearchCalls", "CandidateSearchReused")
+                                                  if key in row} for row in output.get("neutral_cycles", [])]}
+
+
+def safe_diagnostic(value):
+    """Only typed scalar diagnostics enter public evidence, never config text."""
+    if type(value) is dict:
+        require(all(type(key) is str and re.fullmatch("[A-Za-z0-9_.%+-]{1,100}", key) for key in value),
+                "diagnostic_key_not_public")
+        return {key: safe_diagnostic(item) for key, item in value.items()}
+    if type(value) is list:
+        return [safe_diagnostic(item) for item in value]
+    if type(value) is str:
+        require(re.fullmatch("[A-Za-z0-9_.%+-]{0,128}", value) is not None, "diagnostic_text_not_public")
+    require(value is None or type(value) in {str, int, float, bool}, "diagnostic_value_not_public")
+    return value
+
+
+def public_support_guide(support):
+    check = support.get("check", {}); evidence = check.get("evidence", {})
+    def selected(value, keys):
+        return safe_diagnostic({key: value[key] for key in keys if key in value})
+    sample_keys = ("seed", "sample_seed", "iterations", "dps", "standard_deviation", "standard_error",
+                   "dps_delta", "character_dps", "character_dps_delta", "config_sha256", "insufficient_energy_max")
+    direction_keys = ("binding", "owner", "stat", "amount", "mean_dps_change", "minimum_dps_change",
+                      "maximum_dps_change", "mean_other_dps_change", "minimum_other_dps_change",
+                      "seed_dps_changes", "status", "config_sha256", "sample_count")
+    perturbations = []
+    for row in evidence.get("perturbations", []):
+        item = selected(row, ("perturbation", "config_sha256", "mean_dps_delta", "mean_character_dps_delta", "second_seed_screened"))
+        item["samples"] = [selected(sample, sample_keys) for sample in row.get("samples", [])]
+        perturbations.append(item)
+    return {"status": support.get("status"), "binding": selected(check.get("binding", {}),
+                tuple(check.get("binding", {}))), "selected_seeds": safe_diagnostic(check.get("selected_seeds", [])),
+            "coverage_sha256": digest(semantic(support.get("coverage", {}))),
+            "check": {"status": check.get("status"), "plan_sha256": digest(semantic(check.get("plan", {}))),
+                "directions": [selected(row, direction_keys) for row in check.get("directions", [])],
+                "evidence": {**selected(evidence, ("call_limit", "attempted_calls", "skipped_calls", "screening_enabled", "engine_unchanged")),
+                             "baseline": [selected(row, sample_keys) for row in evidence.get("baseline", [])],
+                             "perturbations": perturbations}}}
+
+
+def support_projection(output):
+    support = output.get("support_response")
+    require(type(support) is dict, "support_evidence_missing")
+    normalized = semantic(support)
+    check = support.get("check", {})
+    evidence = check.get("evidence", {})
+    require(type(evidence.get("attempted_calls")) is int and type(evidence.get("skipped_calls")) is int,
+            "support_call_evidence_missing")
+    return normalized, {"sha256": digest(normalized), "status": support.get("status"),
+        "attempted_calls": evidence["attempted_calls"], "skipped_calls": evidence["skipped_calls"],
+        "full_guide": public_support_guide(support)}
+
+
+def number(value):
+    require(not isinstance(value, bool), "number_invalid")
+    parsed = float(value)
+    require(math.isfinite(parsed) and parsed >= 0, "number_invalid")
+    return parsed
+
+
+def finalist_projection(output):
+    verification = output.get("verification", {})
+    rows = verification.get("candidates", [])
+    require(verification.get("iterations") == 500 and type(rows) is list and 0 < len(rows) <= 9,
+            "finalist_n500_evidence_invalid")
+    result = {}
+    for row in rows:
+        require(row.get("iterations") == 500, "finalist_iterations_changed")
+        identity = row.get("assignment_sha256")
+        require(isinstance(identity, str) and re.fullmatch("[0-9a-f]{64}", identity), "finalist_identity_invalid")
+        require(identity not in result and digest(row["assignment"]) == identity, "finalist_assignment_invalid")
+        result[identity] = {key: row[key] for key in ("assignment_sha256", "formula_dps", "config_sha256",
+                                                     "measured_dps", "standard_error", "iterations")}
+        for key in ("formula_dps", "measured_dps", "standard_error"):
+            number(result[identity][key])
+    winner = verification.get("winner", {}).get("assignment_sha256")
+    require(winner in result, "winner_not_verified")
+    return result, winner
