+                path.write_bytes(raw)
+                mapping[str(NATIVE / name)] = str(path)
+            physical = previous.scope.accepted.K.old.native_map()
+            mapping.update({str(NATIVE / n): "" for n in set(physical) - set(source)})
+            overlay = job / "overlay.json"
+            overlay.write_text(json.dumps({"Replace": mapping}), encoding="utf-8")
+            env, _ = previous.gate.common._environment(job)
+            env.update(GOMAXPROCS="1", GOMEMLIMIT="2GiB", GTT_SCRATCH_DIR=str(job))
+            for name in ("gocache", "gotmp", "temp"):
+                (job / name).mkdir(exist_ok=True)
+            command = [str(previous.gate.owned.GO_EXE), "-C", str(NATIVE), "test", "-p=1", "-mod=readonly", "-buildvcs=false",
