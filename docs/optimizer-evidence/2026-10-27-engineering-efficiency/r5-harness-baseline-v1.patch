+++ b/tools/experiments/gcsim/mvp_polish/priority_benchmark_output.py
@@ -0,0 +1,324 @@
+"""Bounded parser for the local dot-priority Go test/benchmark JSONL output.
+
+This module validates captured output only. A caller must independently require
+process return code 0, no timeout, and no launcher error before accepting a gate.
+It deliberately does not launch Go or manage an experiment.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import math
+import re
+from typing import Any
+
+
+PACKAGE = "genshinteamstracker/native/gcsim_optimizer/internal/search"
+NAMED_TESTS = (
+    "TestCandidateDotPrioritiesMatchesLegacyBits",
+    "TestCandidateRunPrioritiesMatchLegacyAndPreserveTies",
+)
+BENCHMARK_ROOT = "BenchmarkCandidateDotPriorities"
+SIZES = (64, 1024)
+LEAVES = ("production_helper", "legacy_map_updates")
+REPETITIONS = 3
+BENCHMARK_N = 1000
+
+MAX_JSONL_BYTES = 8 * 1024 * 1024
+MAX_JSONL_LINE_BYTES = 256 * 1024
+MAX_EVENTS = 50_000
+MAX_OUTPUT_BYTES = 2 * 1024 * 1024
+
+
+def _benchmark_names() -> tuple[str, ...]:
+    return tuple(
+        f"{BENCHMARK_ROOT}/N={size}/{leaf}"
+        for size in SIZES
+        for leaf in LEAVES
+    )
+
+
+BENCHMARK_NAMES = _benchmark_names()
+_ANNOUNCEMENTS = frozenset(
+    (BENCHMARK_ROOT,)
+    + tuple(f"{BENCHMARK_ROOT}/N={size}" for size in SIZES)
+    + BENCHMARK_NAMES
+)
+_FRAME_RE = re.compile(r"^(?:=== RUN\s+|--- PASS:\s+)(?P<label>\S+)$")
+_ROW_RE = re.compile(
+    r"^(?P<name>BenchmarkCandidateDotPriorities/N=(?:64|1024)/"
+    r"(?:production_helper|legacy_map_updates))\s+"
+    r"(?P<n>\d+)\s+(?P<ns>\S+)\s+ns/op\s+"
+    r"(?P<bytes>\S+)\s+B/op\s+(?P<allocs>\S+)\s+allocs/op$"
+)
+
+
+class _DuplicateKey(ValueError):
+    pass
+
+
+def _strict_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise _DuplicateKey(key)
+        result[key] = value
+    return result
+
+
+def _reject_constant(value: str) -> None:
+    raise ValueError(f"nonstandard_json_constant:{value}")
+
+
+def _strict_float(value: str) -> float:
+    parsed = float(value)
+    if not math.isfinite(parsed):
+        raise ValueError("nonfinite_json_number")
+    return parsed
+
+
+def _new_result(data: bytes) -> dict[str, Any]:
+    return {
+        "status": "invalid",
+        "jsonl_bytes": len(data),
+        "jsonl_sha256": hashlib.sha256(data).hexdigest(),
+        "event_count": 0,
+        "target_package_event_count": 0,
+        "package_pass_events": 0,
+        "named_counts": {
+            name: {"run": 0, "pass": 0} for name in NAMED_TESTS
+        },
+        "benchmark_rows": [],
+        "errors": [],
+    }
+
+
+def _append_error(result: dict[str, Any], code: str) -> None:
+    result["errors"].append(code)
+
+
+def _metric(value: str) -> float:
+    parsed = float(value)
+    if not math.isfinite(parsed) or parsed < 0:
+        raise ValueError("metric_not_finite_nonnegative")
+    return parsed
+
+
+def _collect_benchmark_rows(output: str, result: dict[str, Any]) -> None:
+    counts = {name: 0 for name in BENCHMARK_NAMES}
+    for original_line in output.splitlines():
+        line = original_line.strip()
+        if not line:
+            continue
+
+        match = _ROW_RE.fullmatch(line)
+        if match is not None:
+            name = match.group("name")
+            counts[name] += 1
+            row: dict[str, Any] = {"name": name, "raw": line}
+            try:
+                n = int(match.group("n"))
+            except (ValueError, OverflowError):
+                n = None
+                _append_error(result, "benchmark_n_invalid")
+            row["n"] = n
+            if n is not None and n != BENCHMARK_N:
+                _append_error(result, "benchmark_n_mismatch")
+
+            metrics: dict[str, float | None] = {}
+            for field, token in (
+                ("ns_per_op", match.group("ns")),
+                ("bytes_per_op", match.group("bytes")),
+                ("allocs_per_op", match.group("allocs")),
+            ):
+                try:
+                    metrics[field] = _metric(token)
+                except (ValueError, OverflowError):
+                    metrics[field] = None
+                    _append_error(result, "benchmark_metric_invalid")
+            row.update(metrics)
+            bytes_per_op = metrics["bytes_per_op"]
+            allocs_per_op = metrics["allocs_per_op"]
+            if (
+                bytes_per_op is not None
+                and allocs_per_op is not None
+                and (not bytes_per_op.is_integer() or not allocs_per_op.is_integer())
+            ):
+                _append_error(result, "benchmark_integer_metric_invalid")
+            if bytes_per_op is not None and bytes_per_op.is_integer():
+                row["bytes_per_op"] = int(bytes_per_op)
+            if allocs_per_op is not None and allocs_per_op.is_integer():
+                row["allocs_per_op"] = int(allocs_per_op)
+            result["benchmark_rows"].append(row)
+            continue
+
+        # testing.Benchmark.Run may announce its root, size, or leaf label as
+        # a bare line. JSON-mode test output can frame a RUN announcement.
+        if line in _ANNOUNCEMENTS:
+            continue
+        framed = _FRAME_RE.fullmatch(line)
+        if framed is not None and framed.group("label") in _ANNOUNCEMENTS:
+            continue
+        if line.startswith("Benchmark"):
+            _append_error(result, "benchmark_line_unrecognized")
+            continue
+
+        # Verbose Go test output also includes ordinary test/subtest RUN and
+        # PASS lines. Only framed labels in the benchmark namespace are rows
+        # or benchmark announcements; unrelated test control text is normal.
+        if line.startswith("=== RUN") or line.startswith("--- PASS:"):
+            parts = line.split()
+            label = parts[2] if line.startswith("=== RUN") and len(parts) > 2 else ""
+            if line.startswith("--- PASS:"):
+                pass_parts = line[len("--- PASS:") :].strip().split()
+                label = pass_parts[0] if pass_parts else ""
+            if label.startswith("Benchmark"):
+                _append_error(result, "benchmark_line_unrecognized")
+
+    for name, count in counts.items():
+        if count != REPETITIONS:
+            _append_error(result, f"benchmark_row_count:{name}:{count}")
+
+
+def collect_jsonl(data: bytes) -> dict[str, Any]:
+    """Collect bounded Go ``-json`` output while retaining useful partials."""
+    if not isinstance(data, bytes):
+        data = b""
+        result = _new_result(data)
+        _append_error(result, "jsonl_input_not_bytes")
+        return result
+
+    result = _new_result(data)
+    bounded = data[:MAX_JSONL_BYTES]
+    if len(data) > MAX_JSONL_BYTES:
+        _append_error(result, "jsonl_too_large")
+
+    output_parts: list[str] = []
+    output_bytes = 0
+    event_stream = io.BytesIO(bounded)
+    line_number = 0
+    while True:
+        line = event_stream.readline(MAX_JSONL_LINE_BYTES + 1)
+        if not line:
+            break
+        line_number += 1
+        if line_number > MAX_EVENTS:
+            _append_error(result, "jsonl_too_many_events")
+            break
+        if len(line) > MAX_JSONL_LINE_BYTES:
+            _append_error(result, f"jsonl_line_too_large:{line_number}")
+            break
+        if not line.endswith(b"\n"):
+            _append_error(result, f"jsonl_missing_final_newline:{line_number}")
+            break
+        if not line.strip():
+            _append_error(result, f"jsonl_blank_line:{line_number}")
+            continue
+
+        try:
+            event = json.loads(
+                line.decode("utf-8"),
+                object_pairs_hook=_strict_object,
+                parse_float=_strict_float,
+                parse_constant=_reject_constant,
+            )
+        except _DuplicateKey:
+            _append_error(result, f"json_duplicate_key:{line_number}")
+            continue
+        except (UnicodeDecodeError, json.JSONDecodeError, ValueError, RecursionError):
+            _append_error(result, f"json_malformed:{line_number}")
+            continue
+
+        result["event_count"] += 1
+        if not isinstance(event, dict):
+            _append_error(result, f"json_event_not_object:{line_number}")
+            continue
+        package = event.get("Package")
+        if package != PACKAGE:
+            continue
+
+        result["target_package_event_count"] += 1
+        action = event.get("Action")
+        test_name = event.get("Test")
+        if not isinstance(action, str):
+            _append_error(result, f"target_action_invalid:{line_number}")
+            action = ""
+        if test_name is not None and not isinstance(test_name, str):
+            _append_error(result, f"target_test_name_invalid:{line_number}")
+            test_name = None
+
+        if test_name in result["named_counts"]:
+            if action in ("run", "pass"):
+                result["named_counts"][test_name][action] += 1
+            elif action in ("fail", "skip"):
+                _append_error(result, f"named_test_{action}:{test_name}")
+
+        if action in ("fail", "skip"):
+            _append_error(result, f"target_package_{action}")
+        if action == "pass" and not test_name:
+            result["package_pass_events"] += 1
+
+        fragment = event.get("Output")
+        if fragment is not None:
+            if not isinstance(fragment, str):
+                _append_error(result, f"target_output_invalid:{line_number}")
+                continue
+            try:
+                fragment_bytes = fragment.encode("utf-8")
+            except UnicodeEncodeError:
+                _append_error(result, f"target_output_encoding_invalid:{line_number}")
+                continue
+            remaining = MAX_OUTPUT_BYTES - output_bytes
+            if remaining <= 0:
+                _append_error(result, "target_output_too_large")
+                continue
+            if len(fragment_bytes) > remaining:
+                clipped = fragment_bytes[:remaining].decode("utf-8", errors="ignore")
+                output_parts.append(clipped)
+                output_bytes += len(clipped.encode("utf-8"))
+                _append_error(result, "target_output_too_large")
+            else:
+                output_parts.append(fragment)
+                output_bytes += len(fragment_bytes)
+
+    if len(data) > MAX_JSONL_BYTES and len(bounded) == MAX_JSONL_BYTES:
+        # The final included line may have been cut at the byte budget.
+        if bounded and not bounded.endswith(b"\n"):
+            _append_error(result, "jsonl_truncated_at_limit")
+
+    for name, counts in result["named_counts"].items():
+        for action in ("run", "pass"):
+            count = counts[action]
+            if count != REPETITIONS:
+                _append_error(result, f"named_test_{action}_count:{name}:{count}")
+    if result["package_pass_events"] != 1:
+        _append_error(
+            result,
+            f"package_pass_count:{result['package_pass_events']}",
+        )
+
+    reconstructed_output = "".join(output_parts)
+    if output_parts and reconstructed_output and not reconstructed_output.endswith("\n"):
+        _append_error(result, "target_output_missing_final_newline")
+    _collect_benchmark_rows(reconstructed_output, result)
+    if not result["errors"]:
+        result["status"] = "valid"
+    return result
+
+
+def invocation_is_valid(
+    collected: dict[str, Any],
+    *,
+    returncode: int | None,
+    timed_out: bool,
+    launcher_error: str | None,
+) -> bool:
+    """Require output validity and independent process/launcher success."""
+    return (
+        collected.get("status") == "valid"
+        and returncode == 0
+        and timed_out is False
+        and launcher_error is None
+    )
