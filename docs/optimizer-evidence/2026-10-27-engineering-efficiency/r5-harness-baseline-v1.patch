+def _compact_stdout_diagnostic(value: Any) -> dict[str, Any]:
+    if not isinstance(value, Mapping):
+        raise DiagnosticError("helper seeded diagnostic summary is malformed")
+    allowed = (
+        "status", "planned_invocations", "attempted_invocations", "completed_invocations",
+        "failed_invocations", "baseline_config_sha256", "challenger_config_sha256",
+        "receipt_name", "receipt_sha256", "engine_unchanged_after_stage", "error_code",
+    )
+    compact = {key: value[key] for key in allowed if key in value}
+    attempts = value.get("attempts")
+    if isinstance(attempts, list):
+        compact_attempts = []
+        for item in attempts:
+            if not isinstance(item, Mapping):
+                continue
+            attempt = {
+                key: item[key] for key in ("ordinal", "build", "seed", "status", "error_code")
+                if key in item
+            }
+            result = _compact_attempt_result(item.get("result"))
+            if result is not None:
+                attempt["result"] = result
+            compact_attempts.append(attempt)
+        compact["attempts"] = compact_attempts
+    return compact
+
+
+def _compact_attempt_result(value: Any) -> dict[str, Any] | None:
+    if not isinstance(value, Mapping):
+        return None
+    fields = (
+        "iterations", "dps", "standard_deviation", "standard_error", "elapsed_ms",
+        "sample_seed", "number_of_workers", "config_sha256", "engine_result_sha256",
+    )
+    result = {key: value[key] for key in fields if key in value}
+    character_dps = value.get("character_dps")
+    if isinstance(character_dps, Mapping):
+        result["character_dps"] = {
+            str(actor): score for actor, score in character_dps.items()
+            if isinstance(actor, str) and type(score) in (int, float)
+        }
+    identity = value.get("config_identity")
+    if isinstance(identity, Mapping):
+        safe_identity = (
+            "submitted_config_sha256", "submitted_config_bytes", "expected_engine_config_sha256",
+            "expected_engine_config_bytes", "returned_config_sha256", "returned_config_bytes", "matched",
+        )
+        result["config_identity"] = {key: identity[key] for key in safe_identity if key in identity}
+    return result
+
