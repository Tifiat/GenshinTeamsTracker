+def candidate_images(program, patch, apply_patch_exact):
+    """Use the existing exact patch producer for the one reviewed two-file patch."""
+    require(sha(patch) == PATCH_SHA and sha(program) == PROGRAM_BEFORE,
+            "navia_candidate_preimage_drift")
+    first = ("diff --git a/" + PROGRAM + " b/" + PROGRAM + "\n").encode()
+    second = ("diff --git a/" + RUNS + " b/" + RUNS + "\n").encode()
+    require(patch.startswith(first) and patch.count(first) == patch.count(second) == 1,
+            "navia_candidate_patch_shape")
+    modify, addition = patch[len(first):].split(second)
+    modify = modify.replace(("--- a/" + PROGRAM + "\n+++ b/" + PROGRAM + "\n").encode(),
+                            ("--- " + PROGRAM + "\n+++ " + PROGRAM + "\n").encode(), 1)
+    updated = apply_patch_exact(program, modify, PROGRAM, 4)
+    header = ("new file mode 100644\n--- /dev/null\n+++ b/" + RUNS + "\n@@ -0,0 +1,39 @@\n").encode()
+    require(addition.startswith(header), "navia_candidate_addition_shape")
+    lines = addition[len(header):].splitlines(keepends=True)
+    require(len(lines) == 39 and all(line.startswith(b"+") and line.endswith(b"\n") for line in lines),
+            "navia_candidate_addition_shape")
+    added = b"".join(line[1:] for line in lines)
+    require(sha(updated) == PROGRAM_AFTER and sha(added) == RUNS_SHA,
+            "navia_candidate_postimage_drift")
+    return {PROGRAM: updated, RUNS: added}
+
+
+def make_prepare_and_build(chasca, prepare, *, patch, common_helper, environment,
+                           record, save, allowance, scratch, require_grant, private_sink):
+    """Return W2's exact in-job tuple callback; no build occurs at construction."""
+    require(sha(patch) == PATCH_SHA, "navia_candidate_patch_drift")
+    helper = Path(common_helper)
+    require(helper.resolve().is_relative_to(ROOT.resolve()), "navia_helper_not_main_sealed")
+
+    def callback(job):
+        require_grant()
+        job = prep.owned_job(chasca, job)
+        preparation = prepare(job)
+        require(type(preparation) is tuple and len(preparation) == 3
+                and all(type(item) is dict for item in preparation), "navia_prepare_callback_shape")
+        prepared, request, binding = preparation
+        private_sink.bind(job, prepared, request, binding)
+        attestations = build_pair(chasca, job, patch=patch, common_helper=helper,
+            environment=environment, record=record, save=save, allowance=allowance,
+            scratch=scratch, require_grant=require_grant)
+        return prepared, request, attestations
+
+    return callback
+
