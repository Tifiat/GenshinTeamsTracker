+def guard_command(binary):
+    return [str(binary), "-test.run=" + GUARD_REGEX, "-test.v", "-test.parallel=1", "-test.timeout=30s"]
+
+
+def guard_log(raw):
+    require(type(raw) is bytes and 0 < len(raw) <= 262144, "navia_guard_log_size")
+    text = raw.decode("utf-8", errors="strict")
+    all_runs = re.findall(r"^=== RUN\s+(\S+)\s*$", text, re.M)
+    require(all(name.split("/", 1)[0] in GUARD_TESTS for name in all_runs), "navia_guard_unexpected_test")
+    runs = [name for name in all_runs if "/" not in name]
+    passes = re.findall(r"^--- PASS: (\S+) \([0-9.]+s\)\s*$", text, re.M)
+    require(len(runs) == len(passes) == 4 and set(runs) == set(passes) == GUARD_TESTS
+            and "--- FAIL:" not in text and len(re.findall(r"^PASS\s*$", text, re.M)) == 1,
+            "navia_guard_test_inventory")
+    return {"test_runs": 4, "test_passes": 4, "regex": GUARD_REGEX, "log_sha256": sha(raw)}
+
