+++ b/tools/experiments/gcsim/mvp_polish/prepare_navia_exact_pair.py
@@ -0,0 +1,192 @@
+"""MAIN-only private preparation callback; inert until a reviewed caller invokes it.
+
+This is callback glue, not an execution protocol or an execution grant. No account,
+production module, process or W2 module is opened at import. The future controller
+owns the grant, complete source/runtime pins, deadline and sealed W2 source load.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parents[4]
+SEEDS = [742031889, 742031890]
+WEARERS = ["furina", "navia", "xilonen", "yelan"]
+REQUEST_LIMIT = 1 << 20
+SOURCE_LIMIT = 16 << 20
+
+
+def require(condition, code):
+    if not condition:
+        raise ValueError(code)
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def owned_job(chasca, job):
+    job = Path(job)
+    chasca.gate.managed.assert_unlinked(job)
+    require(Path(chasca.ROOT).resolve() == ROOT.resolve(), "navia_main_root_required")
+    root = chasca.gate.managed.MANAGED_ROOT.resolve(strict=True)
+    require(job.is_absolute() and job.resolve(strict=True).parent == root
+            and job.is_dir() and job.name.startswith("job-"), "navia_owned_job_required")
+    return job.resolve(strict=True)
+
+
+def receipt_from_prepared(prepared, raw_request, raw_sources, canonical_sha256):
+    """Adapt the real production dict, not Chasca's differently named receipt."""
+    require(type(prepared) is dict and type(prepared.get("request")) is dict,
+            "navia_prepared_dict_required")
+    require(type(raw_request) is bytes and 0 < len(raw_request) <= REQUEST_LIMIT
+            and type(raw_sources) is bytes and 0 < len(raw_sources) <= SOURCE_LIMIT,
+            "navia_prepared_raw_scope")
+    request = prepared["request"]
+    require(json.loads(raw_request) == request, "navia_prepared_raw_object_drift")
+    require(request.get("schema_kind") == "gtt_gcsim_optimizer_request_v1"
+            and len(request.get("artifacts", ())) == 597
+            and [row["wearer_key"] for row in request.get("wearers", ())] == WEARERS
+            and request.get("stochastic", {}).get("seeds") == SEEDS,
+            "navia_prepared_identity")
+    require(request.get("budgets") == {"product_timeout_ms": 0, "development_timeout_ms": 0}
+            and request.get("result_options", {}).get("fast_mode") is False,
+            "navia_prepared_options")
+    for name in ("prepared_config", "rotation", "target"):
+        context = request["context"][name]
+        require(type(context["text"]) is str and sha(context["text"].encode()) == context["sha256"],
+                "navia_prepared_context_hash")
+    canonical = canonical_sha256(request)
+    require(prepared.get("request_sha256") == canonical, "navia_canonical_request_drift")
+    engine = request["engine"]
+    for name in ("artifact_sha256", "binding_sha256"):
+        value = engine.get(name)
+        require(type(value) is str and len(value) == 64
+                and all(character in "0123456789abcdef" for character in value),
+                "navia_engine_binding_invalid")
+    return {"complete": True, "artifact_count": 597, "seeds": list(SEEDS),
+            "request_sha256": canonical, "request_raw_sha256": sha(raw_request),
+            "source_bundle_sha256": sha(raw_sources), "engine_sha256": engine["artifact_sha256"],
+            "engine_binding_sha256": engine["binding_sha256"]}
+
+
+def production_services():
+    """Late imports: caller must first enter the existing MAIN owned job."""
+    from tools.experiments.gcsim.mvp_polish import navia_case
+    from run_workspace.gcsim.optimizer_go_all_sources import prepare_all_set_effect_sources
+    from run_workspace.gcsim.optimizer_go_contracts import canonical_sha256, write_canonical
+    from run_workspace.gcsim.optimizer_go_inputs import prepare_optimizer_inputs
+    from run_workspace.gcsim.optimizer_go_requests import GcsimOptimizerGoRequest
+    return SimpleNamespace(case=navia_case, request_type=GcsimOptimizerGoRequest,
+        prepare=prepare_optimizer_inputs, sources=prepare_all_set_effect_sources,
+        canonical_sha256=canonical_sha256, write_canonical=write_canonical)
+
+
+def prepare_private(chasca, job, *, wire_pin, account_pins, runtime,
+                    expected_team_sha256, input_pins, allowance, scratch,
+                    require_grant, services=None):
+    """Return (explicit receipt, request dict, private order binding).
+
+    ``wire_pin``, ``account_pins`` and ``runtime`` use the existing navia_case
+    shapes. The controller supplies those actual private pins; no public fixture,
+    guessed account path or another case's wire whitelist is accepted here.
+    ``require_grant`` is the future controller's check, not a supplied grant.
+    """
+    require_grant()
+    job = owned_job(chasca, job)
+    allowance(90)
+    scratch(job, "navia_exact_prepare_before")
+    services = services if services is not None else production_services()
+    case = services.case
+    require(type(input_pins) is dict and bool(input_pins), "navia_input_pins_required")
+    pins = [wire_pin, account_pins["database"], runtime["optimizer"], *input_pins.values()]
+    if account_pins.get("wal") is not None:
+        pins.append(account_pins["wal"])
+    for pin in pins:
+        path = Path(pin["path"])
+        chasca.gate.managed.assert_unlinked(path)
+        require(path.is_absolute() and path.resolve(strict=True).is_relative_to(ROOT.resolve()),
+                "navia_private_pin_outside_main")
+    store = Path(runtime["engine_store_dir"])
+    chasca.gate.managed.assert_unlinked(store)
+    require(store.resolve(strict=True).is_relative_to(ROOT.resolve()), "navia_engine_store_outside_main")
+    wire = case.read_wire(wire_pin)
+    require(len(wire["artifacts"]) == 597 and wire["stochastic"]["seeds"] == SEEDS,
+            "navia_retained_wire_identity")
+    for pin in input_pins.values():
+        case.read_pin(pin, limit=32 << 20)
+    case.read_pin(runtime["optimizer"], limit=128 << 20)
+    require(Path(wire["engine"]["binary_path"]).resolve(strict=True).is_relative_to(ROOT.resolve()),
+            "navia_engine_binary_outside_main")
+    require(case.file_digest(wire["engine"]["binary_path"]) == wire["engine"]["artifact_sha256"],
+            "navia_engine_binary_drift")
+    database = job / "account-snapshot.db"
+    case.snapshot_account(account_pins["database"]["path"], database, account_pins)
+    connection = case.readonly_connection(database)
+    try:
+        team = case.team_from_account(connection, wire)
+    finally:
+        connection.close()
+    require(services.canonical_sha256(team) == expected_team_sha256, "navia_team_binding_drift")
+    folder = job / "prepared"
+    chasca.gate.managed.assert_unlinked(folder)
+    folder.mkdir(mode=0o700)
+    request = services.request_type(**case.request_kwargs(
+        wire, db_path=database, team=team, runtime=runtime, run_root=folder))
+    prepared = services.prepare(request, folder, mode="all_sets")
+    require(type(prepared) is dict and type(prepared.get("request")) is dict,
+            "navia_prepared_dict_required")
+    case.require_wire_equal(prepared["request"], wire)
+    engine = prepared["request"]["engine"]
+    source_path = folder / "set-sources.json"
+    require(not source_path.exists(), "navia_source_output_exists")
+    services.write_canonical(source_path, services.sources(
+        Path(engine["binary_path"]).resolve().parent.parent, engine, include_neutral_rules=True))
+    raw_request = chasca.gate.io._read_optional(folder / "request.json", REQUEST_LIMIT)
+    raw_sources = chasca.gate.io._read_optional(source_path, SOURCE_LIMIT)
+    receipt = receipt_from_prepared(prepared, raw_request, raw_sources, services.canonical_sha256)
+    require(case.database_pins(account_pins["database"]["path"]) == account_pins,
+            "navia_source_database_drift")
+    binding = {"declaration_order": list(case.declaration_order(wire)),
+               "wearer_order": [row["wearer_key"] for row in wire["wearers"]],
+               "context_hashes": {name: wire["context"][name]["sha256"]
+                                  for name in ("prepared_config", "rotation", "target")}}
+    allowance(1)
+    scratch(job, "navia_exact_prepare_after")
+    return receipt, prepared["request"], binding
+
+
+def supervised_prepare(chasca, job, protocol, *, allowance, scratch, require_grant, verify_sources):
+    """Private child transport for this case, never the ordinary Navia runner.
+
+    Only metadata from prepare_navia_case's actual protocol shape is consumed;
+    its ordinary/capture ceilings are not reused as this pair's authorization.
+    The enclosing existing Windows job bounds this synchronous producer too.
+    """
+    from tools.experiments.gcsim.mvp_polish import navia_exact_pair as controller
+    require_grant()
+    job = owned_job(chasca, job)
+    pin = protocol["private_input"]
+    chasca.gate.managed.assert_unlinked(Path(pin["path"]))
+    private = controller.read_bound_json(pin["path"], pin["sha256"])
+    require(private.get("schema_kind") == "gtt_navia_owned_production_protocol_v1"
+            and type(private.get("requests")) is dict and "all_sets" in private["requests"]
+            and type(private.get("account_database")) is dict
+            and type(private.get("runtime")) is dict and type(private.get("pins")) is dict,
+            "navia_existing_private_protocol_shape")
+    services = production_services()
+    verify_sources()  # Reject any newly imported unpinned project source before account access.
+    for item in private["pins"].values():
+        relative = Path(item["path"]).resolve().relative_to(ROOT.resolve()).as_posix()
+        require(protocol["source_pins"].get(relative) == item["sha256"],
+                "navia_private_source_not_in_controller_closure")
+    result = prepare_private(chasca, job, wire_pin=private["requests"]["all_sets"],
+        account_pins=private["account_database"], runtime=private["runtime"],
+        expected_team_sha256=private["new_team_sha256"], input_pins=private["pins"],
+        allowance=allowance, scratch=scratch, require_grant=require_grant, services=services)
+    raw = controller.canonical({"schema_kind": "gtt_main_navia_prepare_transport_v1",
+                               "protocol_sha256": protocol["_sha256"], "result": list(result)})
+    controller.exclusive_raw(chasca, job / "preparation-callback.json", raw, 2 << 20)
+    return result[0]
diff --git a/tools/experiments/gcsim/mvp_polish/priority_benchmark_output.py b/tools/experiments/gcsim/mvp_polish/priority_benchmark_output.py
