+def native_causes(run_root: Path) -> dict:
+    failures, groups, files = [], {}, []
+    overflow = 0
+    for run in sorted(run_root.glob("*"))[:64]:
+        if not run.is_dir() or run.is_symlink():
+            continue
+        for name in ("optimizer-output.json", "all-sets-result.json", "mechanic-fallback-result.json", "theory-result.json"):
+            for source in (run / name, run / "verification" / name):
+                if not source.is_file() or source.is_symlink() or source.stat().st_size > 16 << 20:
+                    continue
+                try:
+                    wrapper = json.loads(source.read_bytes())
+                except (ValueError, UnicodeError):
+                    continue
+                if not isinstance(wrapper, dict):
+                    continue
+                for obj in (wrapper, wrapper.get("product_result", {})):
+                    if not isinstance(obj, dict):
+                        continue
+                    rows = obj.get("mechanic_boundaries", [])
+                    for bound in rows[:8192] if isinstance(rows, list) else []:
+                        b = bound.get("boundary") if isinstance(bound, dict) else None
+                        if not isinstance(b, dict):
+                            continue
+                        item = {k: b[k] for k in ("mechanic_uid", "kind", "reason_code", "consumer_site",
+                            "operation", "receiver", "owner", "owner_known", "owner_role", "caller_owner",
+                            "caller_known", "frame", "order") if isinstance(b.get(k), (str, int, bool))}
+                        reason = b.get("reason")
+                        if isinstance(reason, str):
+                            item["reason"] = _technical(reason, run_root)
+                            item["reason_truncated"] = len(reason) > 4096
+                        key = json.dumps(item, sort_keys=True)
+                        if key in groups:
+                            groups[key]["retained_occurrences"] += 1
+                        elif len(groups) < 256:
+                            groups[key] = {**item, "retained_occurrences": 1}
+                        else:
+                            overflow += 1
+        names = [run / "optimizer-progress.jsonl", run / "optimizer-request-preflight.stderr.txt",
+                 *sorted(run.glob("compact-*.stderr.txt"))]
+        for source in names[:128]:
+            if not source.is_file() or source.is_symlink():
+                continue
+            with source.open("rb") as stream:
+                size = source.stat().st_size
+                stream.seek(max(0, size-(256 << 10)))
+                text = stream.read(256 << 10).decode("utf-8", errors="replace")
+            for line in text.splitlines():
+                try:
+                    row = json.loads(line)
+                except ValueError:
+                    row = None
+                message = row.get("error") if isinstance(row, dict) else line if any(
+                    word in line.casefold() for word in ("error", "panic", "fatal")) else None
+                if isinstance(message, str) and len(failures) < 128:
+                    failures.append({"source": source.name, "message": _technical(message, run_root)})
+            files.append({"source": source.name, "bytes": size, "sha256": button._sha(source),
+                          "scanned_tail_bytes": min(size, 256 << 10)})
+    return {"schema": "bounded_native_technical_causes_v1", "failures": failures,
+        "mechanic_boundaries": list(groups.values()), "boundary_overflow": overflow,
+        "files": files, "scope": "actual native error text and bound reasons; no requests/profiles/configs exported"}
+
