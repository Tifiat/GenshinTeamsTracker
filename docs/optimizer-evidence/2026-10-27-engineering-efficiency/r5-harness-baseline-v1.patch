+        return (case.case_id,)
+    manifest = json.loads(CASE_MANIFEST_PATH.read_text(encoding="utf-8"))
+    cases = manifest.get("cases")
+    if not isinstance(cases, dict):
+        raise ValueError("MVP case manifest has no cases object")
