+             '\t\t\t\tInputs: []gtttrace.NumericRef{gtttrace.EventOutputRef(markerEventID, markerKey)},\n'
+             '\t\t\t\tOutput: map[string]float64{"dmg%": 1000}, CandidateDependencyComplete: false,\n'
+             '\t\t\t\tUncertaintyCodes: []string{"synthetic_modifier_uncertain"},\n\t\t\t},')
+    legacy_test = _replace_once(legacy_test, before, after, "legacy synthetic typed scalar path")
+    images["pkg/gttcompact/compile_test.go"] = legacy_test.encode()
+
+    return images
+
