+@contextmanager
+def _apply_environment(env: Mapping[str, str]):
+    original = dict(os.environ)
+    os.environ.clear()
+    os.environ.update(env)
+    try:
+        yield
+    finally:
+        os.environ.clear()
+        os.environ.update(original)
