+    return SimpleNamespace(installed=installed, old=installed.old, cleaner=installed.cleaner,
+        archive=module("run_archive_representatives"), priorities=module("run_priorities_local_dot"),
+        owned=module("run_render_diagnostic"), collector=module("artifact_eval_all466_parity_output"),
+        managed=importlib.import_module("tools.managed_optimizer_experiment"), probe=installed.old._default_process_probe)
+
+
+def _strict_object(pairs):
+    value = {}
+    for key, item in pairs:
+        require(key not in value, "source_contract_failed")
+        value[key] = item
+    return value
+
+
+def _read_json(path, services, limit=65536):
+    services.managed.assert_unlinked(path)
+    with path.open("rb") as stream:
+        raw = stream.read(limit + 1)
+    require(len(raw) <= limit, "source_contract_failed")
+    def invalid(_):
+        raise GateError("source_contract_failed")
+    value = json.loads(raw, object_pairs_hook=_strict_object, parse_constant=invalid)
+    require(type(value) is dict, "source_contract_failed")
+    return value
+
+
+def _info(path, services):
+    services.managed.assert_unlinked(path)
+    return services.old._regular_file_info(path)
+
+
+def _relative(root, relative):
+    path = PurePosixPath(relative)
+    require(type(relative) is str and not path.is_absolute() and path.as_posix() == relative
+            and ".." not in path.parts and "\\" not in relative and ":" not in relative,
+            "source_contract_failed")
+    return root.joinpath(*path.parts)
+
+
+def apply_patch_exact(source, patch, target, hunks):
+    """Single target, exact ordered hunk positions/counts/context; no fuzz."""
+    require(type(source) is bytes and type(patch) is bytes and b"\r" not in source + patch, "source_contract_failed")
+    lines = patch.splitlines(keepends=True)
+    require(lines[:2] == [("--- " + target + "\n").encode(), ("+++ " + target + "\n").encode()], "source_contract_failed")
+    original, result, cursor, index, seen = source.splitlines(keepends=True), [], 0, 2, 0
+    while index < len(lines):
+        header = re.fullmatch(rb"@@ -(\d+),(\d+) \+(\d+),(\d+) @@\n", lines[index])
+        require(header is not None, "source_contract_failed")
+        start, count, new_start, new_count = map(int, header.groups())
+        index += 1
+        block = []
+        while index < len(lines) and not lines[index].startswith(b"@@"):
+            line = lines[index]
+            require(line[:1] in (b" ", b"-", b"+") and line.endswith(b"\n"), "source_contract_failed")
+            block.append(line); index += 1
+        before = [line[1:] for line in block if line[:1] != b"+"]
+        after = [line[1:] for line in block if line[:1] != b"-"]
+        require(start > 0 and start - 1 >= cursor and start - 1 + count <= len(original)
+                and len(before) == count and len(after) == new_count
+                and original[start - 1:start - 1 + count] == before, "source_contract_failed")
+        result.extend(original[cursor:start - 1])
+        require(new_start == len(result) + 1, "source_contract_failed")
+        result.extend(after); cursor = start - 1 + count; seen += 1
+    require(seen == hunks, "source_contract_failed")
+    result.extend(original[cursor:])
+    return b"".join(result)
+
+
+def validate_baseline(source, helper, oracle):
+    marker = b"func (p *ArtifactProgram) Evaluate("
+    renamed = b"func (p *ArtifactProgram) EvaluateAll466FrozenBaseline("
+    end = b"\nfunc (p *ArtifactProgram) prepareDependencies("
+    require(source.count(marker) == 1 and source.count(end) == 1 and helper.count(renamed) == 1, "source_contract_failed")
+    body = source[source.index(marker):source.index(end)]
+    restored = helper[helper.index(renamed):].replace(renamed, marker, 1)
+    require(restored == body and len(body) == oracle["original_method_bytes"]
+            and digest(body) == oracle["original_method_sha256"], "source_contract_failed")
