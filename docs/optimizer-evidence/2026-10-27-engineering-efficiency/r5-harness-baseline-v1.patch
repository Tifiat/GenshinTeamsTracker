+"""Research-only admission heuristic before expensive neutral package preparation.
+
+The factory composes the exact matched preparation-reuse V2 source, then changes
+only the per-block package preparation order/admission loop. Deferred packages
+remain explicit heuristic unknowns; a no-gain admitted pass prepares the full
+remaining catalog before normal screening and queue work continues.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
