+
+def _shape(value, fields, required):
+    if not isinstance(value, dict) or not set(required) <= value.keys() or value.keys() - fields.keys():
+        raise ValueError("closed_schema_invalid")
+    if any(not fields[key](item) for key, item in value.items()):
+        raise ValueError("closed_field_invalid")
+    return value
