+    constructor during an explicitly delegated render. The persisted receipt is
+    a bounded projection, so this function does not manufacture omitted lineage.
+    """
+    if not isinstance(row, Mapping) or row.get("family") != PINS["baseline_family_sha256"]:
+        raise RenderDiagnosticError("retained baseline family is missing or changed")
+    measurement = row.get("measurement")
+    if not isinstance(measurement, Mapping):
+        raise RenderDiagnosticError("retained baseline measurement is missing")
+    for key, pin in (
+        ("candidate_sha256", PINS["baseline_family_sha256"]),
+        ("frame_sha256", PINS["frame_sha256"]),
+        ("config_sha256", PINS["baseline_render_sha256"]),
+        ("engine_artifact_sha256", PINS["engine_artifact_sha256"]),
+        ("source_manifest_sha256", PINS["source_manifest_sha256"]),
+    ):
+        _require_sha(measurement.get(key), pin, f"retained measurement {key}")
+    if measurement.get("iterations") != 500:
+        raise RenderDiagnosticError("retained ordinary measurement is not n=500")
+
+    fields = ("family", "formula_dps", "witness45", "aliases", "refinement_level")
+    if any(key not in row for key in fields):
+        raise RenderDiagnosticError("retained baseline row is incomplete")
+    formula_dps = row.get("formula_dps")
+    if type(formula_dps) not in (int, float) or not math.isfinite(formula_dps):
+        raise RenderDiagnosticError("retained baseline formula score is invalid")
+    baseline = copy.deepcopy({key: row[key] for key in fields})
+    if len(baseline.get("aliases", ())) != 1:
+        raise RenderDiagnosticError("retained baseline must have exactly one concrete alias")
+    witness = baseline.get("witness45")
+    if not isinstance(witness, Mapping):
+        raise RenderDiagnosticError("retained Witness45 is missing")
+    mains = witness.get("Mains")
+    lines = witness.get("Lines")
+    upgrades = witness.get("Upgrades")
+    if not all(isinstance(value, list) and len(value) == 4 for value in (mains, lines, upgrades)):
+        raise RenderDiagnosticError("retained Witness45 arrays are incomplete")
+    if any(
+        not isinstance(actor, list) or len(actor) != 5
+        for matrix in (mains, lines, upgrades)
+        for actor in matrix
+    ):
+        raise RenderDiagnosticError("retained Witness45 actor row is malformed")
+    if mains[0][2] != "atk_percent":
+        raise RenderDiagnosticError("retained Chevreuse sands main is not atk_percent")
+    baseline_witness = baseline["witness45"]
+    main_lines = baseline_witness["Lines"][0][2]
+    main_upgrades = baseline_witness["Upgrades"][0][2]
+    if (
+        not isinstance(main_lines, list) or len(main_lines) != 4
+        or not isinstance(main_upgrades, list) or len(main_upgrades) != 4
+    ):
+        raise RenderDiagnosticError("retained Chevreuse sands coordinates are malformed")
+    if type(main_lines[2]) is not int or main_lines[2] != 9:
+        raise RenderDiagnosticError("retained Chevreuse sands line 2 is not hp_percent")
+    if (
+        type(main_upgrades[2]) not in (int, float)
+        or not math.isfinite(main_upgrades[2])
+        or main_upgrades[2] != 0
+    ):
+        raise RenderDiagnosticError("retained Chevreuse sands line 2 has upgrades")
+
+    challenger = copy.deepcopy(baseline)
+    challenger_witness = challenger["witness45"]
+    challenger_witness["Mains"][0][2] = "hp_percent"
+    challenger_witness["Lines"][0][2][2] = 1
+    return baseline, challenger
+
+
+def _job_paths(db_path: str | Path, job_dir: str | Path) -> tuple[Path, Path]:
+    """Resolve unlinked caller-owned paths and keep the synthetic DB inside the job."""
+    raw_job = Path(job_dir).expanduser().absolute()
+    raw_db = Path(db_path).expanduser().absolute()
+    try:
+        assert_unlinked(raw_job)
+        assert_unlinked(raw_db)
+        job = raw_job.resolve(strict=True)
+        db = raw_db.resolve(strict=True)
+    except (OSError, RuntimeError, ValueError) as exc:
+        raise RenderDiagnosticError("private job paths are missing or linked") from exc
+    if not job.is_dir() or not db.is_file():
+        raise RenderDiagnosticError("private job directory or synthetic DB is invalid")
+    if db.name != f"{CASE_ID}-synthetic.db":
+        raise RenderDiagnosticError("expected the pinned disposable synthetic fixture DB")
+    try:
+        db.relative_to(job)
+    except ValueError as exc:
+        raise RenderDiagnosticError("synthetic DB must be inside the caller-owned job directory") from exc
+    return job, db
+
+
+def prepare_render_diagnostic(
+    *,
+    case_id: str,
+    synthetic_db_path: str | Path,
+    selected_team: Mapping[str, Any],
+    engine_store_dir: str | Path = DEFAULT_GCSIM_ENGINE_STORE_DIR,
+    retained_row: Mapping[str, Any] | None = None,
+    render: bool = False,
+    private_job_dir: str | Path,
+    renderer: Callable[[Mapping[str, Any]], Mapping[str, Any]] | None = None,
+) -> dict[str, Any]:
+    """Rehydrate pinned production inputs, optionally render baseline/HP pair.
+
+    ``render=False`` is the default and never invokes Go.  The caller must pass
+    the existing synthetic fixture DB/team explicitly; this function does not
+    create a fixture, access an account DB, launch a session, or run a backend.
+    Its historical timeout fields reproduce the retained request identity only;
+    they do not start a timed Theory session or authorize numerical work.
+    """
+    if case_id != CASE_ID:
+        raise RenderDiagnosticError("render diagnostic supports only overload_chevreuse")
+    if render and not callable(renderer):
+        raise RenderDiagnosticError("explicit rendering requires a caller-owned production renderer")
+    if not render and renderer is not None:
+        raise RenderDiagnosticError("renderer callback is valid only with explicit rendering")
+    job_dir, db_path = _job_paths(synthetic_db_path, private_job_dir)
+    case = load_case(case_id)
+    _validate_case(case)
+
+    request_obj = GcsimOptimizerGoTheoryRequest(
+        db_path=str(db_path),
+        selected_team=selected_team,
+        team_index=0,
+        rotation_shell_text=case.rotation_text,
+        infinite_energy_enabled=True,
+        engine_store_dir=str(Path(engine_store_dir).expanduser()),
+        expected_engine_id=ENGINE_ID,
+        seeds=tuple(DEFAULT_SELECTED_SEEDS),
+        # Production preparation derives the original 360000 ms development
+        # budget from this field. Reproduce the request, never run its session.
+        product_timeout_ms=HISTORICAL_REQUEST_BUDGETS["product_timeout_ms"],
+    )
+    with tempfile.TemporaryDirectory(prefix=".gtt-theory-request-", dir=job_dir) as temporary:
+        run_dir = Path(temporary) / "prepare"
+        run_dir.mkdir()
+        prepared = prepare_optimizer_inputs(request_obj, run_dir, mode="theory")
+    request = _validate_request(prepared, case)
+
+    summary: dict[str, Any] = {
+        "case_id": CASE_ID,
+        "status": "prepared_only",
+        "request_sha256": PINS["request_sha256"],
+        "frame_sha256": PINS["frame_sha256"],
+        "prepared_config_sha256": PINS["prepared_config_sha256"],
+        "rotation_sha256": PINS["rotation_sha256"],
+        "engine_artifact_sha256": PINS["engine_artifact_sha256"],
+        "rendered_config_count": 0,
+        "engine_call_count": 0,
+    }
+    if not render:
+        return summary
+    if retained_row is None:
+        raise RenderDiagnosticError("explicit rendering requires a retained measured row")
+    baseline_row, challenger_row = _copy_retained_row(retained_row)
+
+    engine = request["engine"]
+    engine_root = Path(str(engine["binary_path"])).resolve().parent.parent
+    source_bundle = prepare_all_set_effect_sources(engine_root, engine, include_neutral_rules=True)
+    catalog_sha = source_bundle.get("catalog_sha256") if isinstance(source_bundle, Mapping) else None
+    if not isinstance(catalog_sha, str) or len(catalog_sha) != 64:
+        raise RenderDiagnosticError("production source preparation returned no catalog pin")
+
+    payload = {
+        "request": request,
+        "retained_row": baseline_row,
+        "challenger_row": challenger_row,
+        "catalog_sha256": catalog_sha,
+        "pins": PINS,
+    }
+    try:
+        rendered = renderer(payload)
+    except Exception as exc:
+        raise RenderDiagnosticError("caller-owned production renderer rejected the prepared inputs") from exc
+    if not isinstance(rendered, Mapping):
+        raise RenderDiagnosticError("caller-owned production renderer returned an invalid result")
+    if rendered.get("frame_sha256") != PINS["frame_sha256"]:
+        raise RenderDiagnosticError("production renderer frame pin mismatch")
+    _require_sha(rendered.get("baseline_candidate_sha256"), PINS["baseline_family_sha256"], "baseline candidate")
+    challenger_candidate = rendered.get("challenger_candidate_sha256")
+    if (
+        not isinstance(challenger_candidate, str)
+        or len(challenger_candidate) != 64
+        or any(character not in "0123456789abcdef" for character in challenger_candidate)
+        or challenger_candidate == PINS["baseline_family_sha256"]
+    ):
+        raise RenderDiagnosticError("challenger candidate identity is invalid")
+    if rendered.get("baseline_render_sha256") != PINS["baseline_render_sha256"]:
+        raise RenderDiagnosticError("rendered baseline differs from the retained n=500 config")
+    baseline_text, challenger_text = rendered.get("baseline_config_text"), rendered.get("challenger_config_text")
+    if not isinstance(baseline_text, str) or not isinstance(challenger_text, str):
+        raise RenderDiagnosticError("production renderer omitted its in-memory config pair")
+    _require_sha(text_sha256(baseline_text), PINS["baseline_render_sha256"], "rendered baseline config")
+    challenger_sha = text_sha256(challenger_text)
+    _require_sha(rendered.get("challenger_render_sha256"), challenger_sha, "challenger config")
+    if rendered.get("iterations") != 500 or type(rendered.get("workers")) is not int or rendered["workers"] < 1:
+        raise RenderDiagnosticError("production renderer returned unexpected ordinary-run budgets")
+    baseline_file = job_dir / "theory-baseline-n500.config.txt"
+    challenger_file = job_dir / "theory-chev-hp-sands-n500.config.txt"
+    if baseline_file.exists() or challenger_file.exists():
+        raise RenderDiagnosticError("refusing to replace an existing private render output")
+    try:
+        assert_unlinked(job_dir)
+        assert_unlinked(baseline_file)
+        assert_unlinked(challenger_file)
+        with baseline_file.open("x", encoding="utf-8", newline="") as stream:
+            stream.write(baseline_text)
+        with challenger_file.open("x", encoding="utf-8", newline="") as stream:
+            stream.write(challenger_text)
+    except (OSError, RuntimeError, ValueError) as exc:
+        raise RenderDiagnosticError("could not retain configs inside the private job directory") from exc
+    summary.update({
+        "status": "rendered_only",
+        "baseline_render_sha256": PINS["baseline_render_sha256"],
+        "challenger_render_sha256": challenger_sha,
+        "baseline_candidate_sha256": PINS["baseline_family_sha256"],
+        "challenger_candidate_sha256": challenger_candidate,
+        "iterations": rendered.get("iterations"),
+        "workers": rendered.get("workers"),
+        "rendered_config_count": 2,
+    })
+    return summary
+
+
+__all__ = ["PINS", "RenderDiagnosticError", "prepare_render_diagnostic"]
