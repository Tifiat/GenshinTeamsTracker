+            assert_unlinked(path)
+            if path.is_file():
+                files.append(path)
+    files.sort()
+    digest = hashlib.sha256()
+    size = 0
+    for path in files:
+        assert_unlinked(path)
+        relative = path.relative_to(cache).as_posix()
+        bytes_count = path.stat().st_size
+        size += bytes_count
+        digest.update(relative.encode("utf-8") + b"\0" + str(bytes_count).encode() + b"\0")
+        digest.update(bytes.fromhex(_sha(path)))
+    return {"files": len(files), "bytes": size, "sha256": digest.hexdigest()}
