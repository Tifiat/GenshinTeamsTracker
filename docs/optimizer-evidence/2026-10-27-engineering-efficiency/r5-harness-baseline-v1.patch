+"""Local real-inventory fixture projection for the saved-team button benchmark.
+
+This adapter is imported only by the benchmark's managed child process. It
+copies the user-confirmed artifact snapshot into the disposable case database,
+keeps the AppShell/worker/button path, and never writes to the source profile.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sqlite3
+from pathlib import Path
+
+from hoyolab_export.artifact_db import replace_artifact_build_slots
+from run_workspace.gcsim.engine_store import GcsimEngineStore
+from run_workspace.gcsim.optimizer_artifact_database import load_gcsim_optimizer_artifact_database_input
+from run_workspace.gcsim.optimizer_engine_context import load_active_gcsim_optimizer_engine_context
+from .mechanic_corpus_inputs import normalize_sets
+from run_workspace.gcsim.virtual_roster import (
+    GcsimVirtualSetBonus,
+    load_active_virtual_artifact_set_choices,
+    load_active_virtual_roster_catalog,
+)
+
+
+def _rows(source: sqlite3.Connection, table: str):
+    columns = [row[1] for row in source.execute(f"PRAGMA table_info({table})")]
+    names = ",".join('"' + name + '"' for name in columns)
+    return columns, source.execute(f"SELECT {names} FROM {table}").fetchall()
+
+
+def eligible_input_assignments(profiles, current, eligible, selected_by_character):
+    """Keep legal current inputs first; fill only from the owning eligible pool.
+
+    Reserve every wearer's existing legal pieces before filling missing slots,
+    so an early incomplete wearer cannot steal another wearer's current piece.
+    This changes only the disposable fixture, never equipment in the account.
+    """
+    pool = {a.artifact_id: a for a in eligible}
+    keys = [str(p["character_key"]).casefold() for p in profiles]
+    assignments = {key: {} for key in keys}
+    used = set()
+    repairs = []
+    for key in keys:
+        for pos, aid in sorted(current.get(key, {}).items()):
+            artifact = pool.get(aid)
+            if pos in range(1, 6) and artifact is not None and artifact.position == pos and aid not in used:
+                assignments[key][pos] = aid
+                used.add(aid)
+    for key in keys:
+        preferred = {set_key for set_key, _ in selected_by_character.get(key, [])}
+        for pos in range(1, 6):
+            if pos in assignments[key]:
+                continue
+            candidates = sorted((a for a in pool.values() if a.position == pos and a.artifact_id not in used),
+                key=lambda a: ((a.gcsim_set_key or a.set_uid).casefold() not in preferred, a.artifact_id))
+            if not candidates:
+                raise ValueError(f"eligible_inventory_cannot_fill_input:{key}:{pos}")
+            aid = candidates[0].artifact_id
+            assignments[key][pos] = aid
+            used.add(aid)
+            repairs.append({"wearer_key": key, "position": pos,
+                "original_artifact_id": current.get(key, {}).get(pos), "input_artifact_id": aid,
+                "reason": "missing_ineligible_duplicate_or_wrong_slot_current_input"})
+    return assignments, repairs
+
+
+def install_real_inventory(db_path: str | Path, team: dict, metadata: dict, profiles: list[dict], config_path: str | Path):
+    snapshot = Path(os.environ["GTT_REAL_INVENTORY_SNAPSHOT"]).resolve(strict=True)
+    store = GcsimEngineStore(os.environ.get("GTT_OPTIMIZER_BUTTON_ENGINE_STORE"))
+    context = load_active_gcsim_optimizer_engine_context(store_dir=store.root_dir)
+    loaded = load_gcsim_optimizer_artifact_database_input(snapshot, engine_context=context)
+    if not loaded.ready or loaded.database_input is None:
+        raise ValueError("owning_eligible_inventory_not_ready")
+    eligible_ids = set(loaded.database_input.eligible_5_star_artifact_ids)
+    eligible = [a for a in loaded.database_input.artifacts if a.artifact_id in eligible_ids]
+    config = json.loads(Path(config_path).read_text(encoding="utf-8"))
+    details = {str(row["name"]).casefold(): row for row in config.get("character_details", [])}
+    source = sqlite3.connect(snapshot)
+    source.row_factory = sqlite3.Row
+    destination = sqlite3.connect(db_path)
+    destination.row_factory = sqlite3.Row
+    destination.execute("PRAGMA foreign_keys = OFF")
+    try:
+        # Replace only artifact-domain rows; the disposable fixture's profile
+        # shells and public virtual roster remain in place.
+        for table in (
+            "account_character_equipped_artifacts", "artifact_build_slots",
+            "artifact_equipment", "artifact_tag_links", "artifact_substats",
+            "artifacts", "artifact_set_bonus_descriptions", "artifact_set_names",
+            "artifact_sets",
+        ):
+            destination.execute(f'DELETE FROM "{table}"')
+        for table in (
+            "artifact_sets", "artifact_set_names", "artifact_set_bonus_descriptions",
+            "artifacts", "artifact_substats",
+        ):
+            source_columns = {row[1] for row in source.execute(f"PRAGMA table_info({table})")}
+            destination_columns = [row[1] for row in destination.execute(f"PRAGMA table_info({table})")]
+            columns = [column for column in destination_columns if column in source_columns]
+            if not columns:
+                continue
+            quoted = ",".join('"' + column + '"' for column in columns)
+            rows = source.execute(f'SELECT {quoted} FROM "{table}"').fetchall()
+            if not rows:
+                continue
+            marks = ",".join("?" for _ in columns)
+            destination.executemany(f'INSERT INTO "{table}" ({quoted}) VALUES ({marks})', rows)
+
