+        metrics: dict[str, Any] = {}
+        for kernel in ("production_helper", "legacy_map_updates"):
+            name = f"BenchmarkCandidateDotPriorities/N={size}/{kernel}"
+            samples = grouped.get(name, [])
+            values: dict[str, list[float]] = {}
+            for key in ("ns_per_op", "bytes_per_op", "allocs_per_op"):
+                values[key] = [
+                    float(row[key]) for row in samples
+                    if isinstance(row.get(key), (int, float)) and math.isfinite(float(row[key]))
+                ]
+            medians = {
+                key: statistics.median(items) if items else None
+                for key, items in values.items()
+            }
+            metrics[kernel] = {"samples": values, "medians": medians}
+        comparison = {}
+        for key in ("ns_per_op", "bytes_per_op", "allocs_per_op"):
+            production = metrics["production_helper"]["medians"][key]
+            legacy = metrics["legacy_map_updates"]["medians"][key]
+            comparison[key] = (production / legacy) if production is not None and legacy not in (None, 0) else None
+        comparison["allocations_regressed"] = (
+            metrics["production_helper"]["medians"]["allocs_per_op"] is not None
+            and metrics["legacy_map_updates"]["medians"]["allocs_per_op"] is not None
+            and metrics["production_helper"]["medians"]["allocs_per_op"] > metrics["legacy_map_updates"]["medians"]["allocs_per_op"]
+        )
+        by_size[str(size)] = {"kernels": metrics, "production_over_legacy_median_ratios": comparison}
+    return by_size
+
+
+def _write(path: Path, receipt: dict[str, Any], *, replace_existing: bool) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.is_symlink():
+        raise ValueError("result_receipt_is_linked")
+    if not replace_existing and path.exists():
+        raise FileExistsError("result_receipt_already_exists_no_retry")
+    if replace_existing and not path.is_file():
+        raise FileNotFoundError("result_receipt_missing_for_update")
+    fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
+    temporary_path = Path(temporary_name)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as stream:
+            json.dump(receipt, stream, sort_keys=True, ensure_ascii=False, indent=2, allow_nan=False)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        if replace_existing:
+            os.replace(temporary_path, path)
+        else:
+            # Windows rename is atomic and does not replace an existing receipt.
+            os.rename(temporary_path, path)
+    finally:
+        if temporary_path.exists():
+            temporary_path.unlink()
+
+
