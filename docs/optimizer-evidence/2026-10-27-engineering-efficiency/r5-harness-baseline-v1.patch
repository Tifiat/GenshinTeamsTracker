+        "if dampedSummaryErr!=nil { payload[\"damped_screening_error\"]=dampedSummaryErr.Error(); payload[\"complete\"]=false; if runErr==nil {runErr=dampedSummaryErr} }\n",
+        "if dampedSummaryErr!=nil { payload[\"damped_screening_error\"]=dampedSummaryErr.Error(); payload[\"complete\"]=false; if runErr==nil {runErr=dampedSummaryErr} }\n"
+        "    finalPairWholeSummary, finalPairWholeErr := researchFinalPairWholeSummary()\n"
+        "    payload[\"final_pair_whole\"] = finalPairWholeSummary\n"
+        "    if finalPairWholeErr != nil { payload[\"final_pair_whole_error\"]=finalPairWholeErr.Error(); payload[\"complete\"]=false; if runErr==nil {runErr=finalPairWholeErr} }\n",
+    )
+    text = _once(text, "if len(raw) > 8388608 {", "if len(raw) > 32<<20 {")
+    return text.encode("utf-8")
+
+
+def final_pair_whole_overlay() -> dict[str, Any]:
+    """Return the predecessor source image plus observational final telemetry."""
+    base = predecessor.final_stagnation_pair_completion_overlay()
+    images = dict(base["images"])
+    overlay_files = dict(base["overlay_files"])
+
+    before_coordinator = images["internal/allsets/neutral_coordinator.go"]
+    coordinator, erased_coordinator = _coordinator_image(before_coordinator)
+    if erased_coordinator != before_coordinator:
+        raise ValueError("final-pair whole observer erasure differs from exact predecessor source")
+    images["internal/allsets/neutral_coordinator.go"] = coordinator
+
+    replay_path = "internal/allsets/zz_adaptive_replay_test.go"
+    replay_helper = _replay_helper_image(overlay_files[replay_path])
+    overlay_files[replay_path] = replay_helper
+    overlay_files["internal/allsets/zz_final_pair_whole_test.go"] = TELEMETRY.read_bytes()
+
+    hashes = dict(base["hashes"])
+    hashes["pre_final_pair_whole_source_map_sha256"] = base["hashes"]["final_pair_source_map_sha256"]
+    hashes.update({
+        "final_pair_whole_factory_sha256": _sha(Path(__file__).read_bytes()),
+        "final_pair_whole_telemetry_sha256": _sha(TELEMETRY.read_bytes()),
+        "final_pair_whole_predecessor_coordinator_sha256": _sha(before_coordinator),
+        "final_pair_whole_coordinator_sha256": _sha(coordinator),
+        "final_pair_whole_coordinator_erasure_sha256": _sha(erased_coordinator),
+        "final_pair_whole_replay_helper_sha256": _sha(replay_helper),
+        "final_pair_whole_overlay_sha256": k.gate.digest({path: _sha(raw) for path, raw in overlay_files.items()}),
+        "final_pair_whole_source_map_sha256": k.gate.digest({path: _sha(raw) for path, raw in images.items()}),
+    })
+    source_files = tuple(dict.fromkeys((*base["source_files"], Path(__file__), TELEMETRY)))
+    metadata = {
+        "predecessor_provenance": base["metadata"],
+        "schema": "final_pair_whole_telemetry_v1",
+        "algorithm_change": "none; telemetry only on the already-tested All Sets final stabilization callsite",
+        "final_stabilization_plan_file": "final-pair-whole-plan.jsonl",
+        "final_stabilization_invocation_file": "final-pair-whole-stabilization.jsonl",
+        "final_stabilization_telemetry_max_bytes_per_file": MAX_TELEMETRY_BYTES,
+        "projection_max_bytes": MAX_PROJECTION_BYTES,
+        "projection_neutral_stabilization_retained": True,
+        "invocation_ledger_retains_full_stabilization": True,
+        "preloop_finalist_snapshot_count": 7,
+        "saved_config_guard": {"max_guides": 12, "coordinator_finalist_limit": 7},
+        "unknown_graphs_for_unstarted_finalists_remain_null": True,
+        "telemetry_overflow": "fail the replay without truncating; preserve whatever bounded JSONL rows and projection are already durable",
+        "source_erasure_to_predecessor": True,
+        "source_files": [str(path.resolve()) for path in source_files],
+    }
+    return {
+        **base,
+        "images": images,
+        "helper": replay_helper,
+        "overlay_files": overlay_files,
+        "hashes": hashes,
+        "metadata": metadata,
+        "source_files": source_files,
+    }
