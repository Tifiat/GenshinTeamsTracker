+"""Source-only preparation of one final-pair whole-search comparison.
+
+This is the retained D runner with a new factory, explicit contract evidence and
+lossless final-stabilization observations. No build or numeric execution is
+authorized by a READY document; run() requires a separately approved exact freeze.
+"""
+from __future__ import annotations
+
+import argparse
+import gzip
+import json
+import math
+import os
+import re
+from pathlib import Path
+import sys
+import time
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import final_pair_whole as ablation
+from tools.experiments.gcsim.mvp_polish import final_stagnation_pair_completion_run as local_pair
+from tools.experiments.gcsim.mvp_polish import adaptive_formula_primary_run as predecessor
+from tools.experiments.gcsim.mvp_polish import adaptive_precap_b4_run_v3 as staging
+from tools.experiments.gcsim.mvp_polish import adaptive_damped_relinearize_b4_run as diagnostic
+from tools.experiments.gcsim.mvp_polish import tighnari20_scalar_kernel as k
+
+
+EVIDENCE_PREFIX = "final-pair-whole-"
+WHOLE_SECONDS = 660
+CLEANUP_RESERVE_SECONDS = 60
+COMPILE_SECONDS = 180
+CONTRACT_SECONDS = 30
+CANDIDATE_SECONDS = 360
+MAX_PROJECTION_BYTES = 32 << 20
+MAX_RAW_EXPORT_BYTES = 32 << 20
+
+
+def _saved_input_paths() -> tuple[Path, ...]:
+    names = (
+        "adaptive-hybrid-baseline-projection.json.gz",
+        "adaptive-hybrid-successor-candidate-projection.json.gz",
+        "adaptive-no-feedback-candidate-projection.json.gz",
+        "adaptive-formula-primary-candidate-projection.json.gz",
+        "adaptive-damped-whole-candidate-projection.json.gz",
+        "adaptive-fixed-control-baseline_best-result.json.gz",
+        "adaptive-fixed-control-baseline_best-config.txt.gz",
+        "adaptive-fixed-control-baseline_best-n2000.txt.gz",
+        "adaptive-fixed-control-adaptive_best-result.json.gz",
+        "adaptive-fixed-control-adaptive_best-config.txt.gz",
+        "adaptive-fixed-control-adaptive_best-n2000.txt.gz",
+    )
+    return tuple(k.EVIDENCE / name for name in names)
+
+
+def _read_saved_inputs() -> dict[str, dict[str, Any]]:
+    """Read and pin prior evidence only; never launches or reconstructs a run."""
+    inputs: dict[str, dict[str, Any]] = {}
+    for path in _saved_input_paths():
+        compressed = path.read_bytes()
+        raw = gzip.decompress(compressed) if path.suffix == ".gz" else compressed
+        if len(raw) > MAX_RAW_EXPORT_BYTES:
+            raise ValueError(f"saved input exceeds bounded read: {path.name}")
+        row: dict[str, Any] = {
+            "path": str(path),
+            "compressed_sha256": k.sha(compressed),
+            "compressed_bytes": len(compressed),
+            "raw_sha256": k.sha(raw),
+            "raw_bytes": len(raw),
+        }
+        if path.name.endswith("projection.json.gz") or path.name.endswith("result.json.gz"):
+            document = json.loads(raw)
+            if path.name.endswith("projection.json.gz"):
+                row["projection_schema"] = document.get("schema")
+                row["complete"] = document.get("complete")
+                row["initial_assignment"] = document.get("projection", {}).get("initial", {}).get("score", {}).get("assignment")
+            else:
+                row["control_status"] = document.get("status")
+                row["attempted"] = document.get("attempted")
+                row["completed"] = document.get("completed")
+        inputs[path.name] = row
+    return inputs
+
+
+def _source_pins(overlay: dict[str, Any]) -> dict[str, str]:
+    # Prior evidence is read only for pins/comparison, never as a proposal input.
+    pins = predecessor._source_pins(predecessor.ablation.formula_primary_overlay())
+    paths = (Path(__file__), Path(__file__).with_name("test_adaptive_damped_whole_export.py"),
+             Path(predecessor.__file__), Path(staging.__file__), Path(diagnostic.__file__), *ablation.SOURCE_FILES,
+             *(k.EVIDENCE / ("adaptive-formula-primary-" + name + ".json")
+               for name in ("freeze", "result", "comparison", "closeout")),
+             *(k.EVIDENCE / ("adaptive-damped-relinearize-b4-" + name + ".json")
+               for name in ("ready", "freeze", "result", "posthoc", "closeout")),
+             *sorted(k.EVIDENCE.glob("adaptive-damped-relinearize-b4-*.gz")))
+    pins.update({path.relative_to(k.ROOT).as_posix(): k.sha(path.read_bytes()) for path in paths})
+    pins.update({"image:" + path: k.sha(raw) for path, raw in overlay["images"].items()})
+    for path in (
+        Path(local_pair.__file__),
+        *(k.EVIDENCE / ("adaptive-damped-whole-" + name + ".json")
+          for name in ("result", "comparison", "closeout")),
+        *sorted(k.EVIDENCE.glob("final-stagnation-pair-completion-*.json")),
+    ):
+        pins[path.relative_to(k.ROOT).as_posix()] = k.sha(path.read_bytes())
+    pins["accepted_source_map_sha256"] = overlay["hashes"]["accepted_source_map_sha256"]
+    pins["patched_source_map_sha256"] = overlay["hashes"]["final_pair_whole_source_map_sha256"]
+    pins.update({"overlay:" + path: k.sha(raw) for path, raw in overlay["overlay_files"].items()})
+    return pins
+
+def frozen_plan() -> dict[str, Any]:
+    """Canonical plan the parent can place in the source-review freeze receipt."""
+    overlay = ablation.final_pair_whole_overlay()
+    inputs = _read_saved_inputs()
+    return _frozen_plan(overlay, inputs)
+
+
+def _frozen_plan(overlay: dict[str, Any], inputs: dict[str, dict[str, Any]]) -> dict[str, Any]:
+    pins = _source_pins(overlay)
