+def _progress_summary(events: list[tuple[float, str]]) -> dict:
+    by_stage: dict[str, dict[str, float | int]] = {}
+    for index, (moment, stage) in enumerate(events):
+        row = by_stage.setdefault(stage, {"events": 0, "first_event_offset_ms": 0, "last_event_offset_ms": 0})
+        if row["events"] == 0:
+            first = events[0][0]
+            row["first_event_offset_ms"] = round((moment - first) * 1000)
+        row["events"] = int(row["events"]) + 1
+        row["last_event_offset_ms"] = round((moment - events[0][0]) * 1000)
+    return {
+        "clock_kind": "UI-observed event-arrival offsets, not engine phase durations",
+        "stages": by_stage,
+    }
