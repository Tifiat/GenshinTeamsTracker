+def build_pair(chasca, job, *, patch, common_helper, environment, record, save,
+               allowance, scratch, require_grant):
+    """Shared two-build path. Compile guards never call private preparation."""
+    require_grant()
+    job = prep.owned_job(chasca, job)
+    allowance(1)
+    old, gate = chasca.old, chasca.gate
+    physical = old.native_map()
+    images, baseline = prepare_d_owned(chasca, job, physical, environment=environment,
+        record=record, save=save, allowance=allowance, scratch=scratch)
+    expected = old.historical_d_map()
+    require(len(expected) == 345 and gate.digest(expected) == D345
+            and baseline["source_map_sha256"] == D345 and RUNS not in expected,
+            "navia_baseline_closure_drift")
+    program = images.get(PROGRAM)
+    if program is None:
+        program = (chasca.NATIVE / PROGRAM).read_bytes()
+    changed = candidate_images(program, patch, gate.lifecycle.apply_patch_exact)
+    candidate = {**expected, **{name: sha(raw) for name, raw in changed.items()}}
+    require(len(candidate) == 346 and gate.digest(candidate) == D346
+            and sum(candidate.get(name) == value for name, value in expected.items()) == 344,
+            "navia_candidate_closure_drift")
+    helper = Path(common_helper)
+    gate.managed.assert_unlinked(helper)
+    require(helper.resolve().is_relative_to(ROOT.resolve()), "navia_helper_not_main_sealed")
+    helper_raw, helper_sha = helper.read_bytes(), WRAPPER_PINS["navia_exact_pair_test.go"]
+    require(sha(helper_raw) == helper_sha, "navia_common_helper_drift")
+    common = job / "navia-exact-common-test.go"
+    exclusive_raw(chasca, common, helper_raw, 1 << 20)
+    virtual_helper = "internal/allsets/zz_navia_exact_pair_test.go"
+    require(virtual_helper not in physical, "navia_virtual_helper_collision")
+    env, attestations = environment(job), {}
+    for role, source_map, replacements in (
+            ("baseline", expected, images), ("candidate", candidate, {**images, **changed})):
+        folder = job / ("build-" + role)
+        folder.mkdir(mode=0o700)
+        replace = {str(chasca.NATIVE / name): "" for name in old.EXCLUDED}
+        for index, (name, raw) in enumerate(sorted(replacements.items())):
+            materialized = folder / ("source-" + str(index) + ".go")
+            exclusive_raw(chasca, materialized, raw, 1 << 20)
+            require(sha(raw) == source_map[name], "navia_materialized_source_drift")
+            replace[str(chasca.NATIVE / name)] = str(materialized)
+        replace[str(chasca.NATIVE / virtual_helper)] = str(common)
+        overlay = folder / "overlay.json"
+        exclusive_raw(chasca, overlay, canonical({"Replace": replace}), 1 << 20)
+        binary = folder / "navia-exact.test.exe"
+        command = [str(gate.owned.GO_EXE), "-C", str(chasca.NATIVE), "test", "-c", "-p=1",
+                   "-mod=readonly", "-trimpath", "-buildvcs=false", "-overlay=" + str(overlay),
+                   "-o", str(binary), "./internal/allsets"]
+        process = chasca.run_phase(job, command, "navia_exact_build_" + role, env, 120,
+            role + "-build.log", record=record, save=save, allowance=allowance, scratch=scratch)
+        require(gate.command_passed(process), "navia_source_bound_build_failed")
+        gate.managed.assert_unlinked(binary)
+        attestations[role] = {"path": str(binary), "sha256": gate.owned._sha256_file(binary),
+            "source_map_sha256": gate.digest(source_map), "common_harness_sha256": helper_sha}
+        record.setdefault("source_builds", {})[role] = {key: value for key, value in attestations[role].items()
+                                                       if key != "path"}
+        save()
+    require(old.native_map() == physical, "navia_build_changed_main_sources")
+    return attestations
+
+
+class PrivatePairSink:
+    """One Navia private capsule and two arm exports, using MAIN's existing cleaner."""
+
+    def __init__(self, chasca, export_job, *, protocol_sha256, record, save,
+                 allowance, scratch, require_grant, require_cleanup_release, now=None,
+                 budget_extra=lambda: 0):
+        self.chasca, self.record, self.save = chasca, record, save
+        self.allowance, self.base_scratch, self.require_grant = allowance, scratch, require_grant
+        self.require_cleanup_release = require_cleanup_release
+        self.budget_extra = budget_extra
+        self.export = Path(export_job)
+        chasca.gate.managed.assert_unlinked(self.export)
+        require(self.export.is_absolute() and self.export.parent.is_dir()
+                and self.export.resolve().is_relative_to((ROOT / ".codex_tmp").resolve())
+                and not self.export.resolve().is_relative_to(chasca.gate.managed.MANAGED_ROOT.resolve())
+                and re.fullmatch(r"job-[A-Za-z0-9_-]+", self.export.name) is not None,
+                "navia_private_export_scope")
+        require(re.fullmatch(r"[0-9a-f]{64}", protocol_sha256 or "") is not None,
+                "navia_protocol_hash_required")
+        self.protocol_sha256 = protocol_sha256
+        self.created = now if now is not None else datetime.now(timezone.utc)
+        require(self.created.tzinfo is not None, "navia_retention_timezone")
+        self.expires = self.created + timedelta(hours=24)
+        self.job = self.prepared = self.request = self.binding = self.capsule = self.retention = None
+        self.arms = {}
+        self.pending_arms, self.pending_originals = {}, {}
+        self.original_pins = []
+        self.planned_files, self.created_files = {}, {}
+        self.directory_created, self.directory_identity, self.ownership = False, None, None
+
+    def bind(self, job, prepared, request, binding):
+        self.require_grant()
+        require(self.job is None, "navia_private_sink_already_bound")
+        self.job = prep.owned_job(self.chasca, job)
+        require(type(binding) is dict and set(binding) == {"declaration_order", "wearer_order", "context_hashes"}
+                and len(binding["declaration_order"]) == 4
+                and set(binding["declaration_order"]) == set(prep.WEARERS)
+                and binding["wearer_order"] == prep.WEARERS
+                and binding["context_hashes"] == {name: request["context"][name]["sha256"]
+                    for name in ("prepared_config", "rotation", "target")}, "navia_private_input_binding")
+        self.prepared, self.request, self.binding = prepared, request, binding
+        require(not self.export.exists(), "navia_private_export_already_exists")
+        self.check_budget()
+
+    def check_budget(self, additional=0):
+        self.allowance(1)
+        total = self.chasca.gate.common._tree_bytes(self.job)
+        if self.export.exists():
+            total += self.chasca.gate.common._tree_bytes(self.export)
+        total += self.budget_extra()
+        require(type(additional) is int and additional >= 0 and total + additional <= SCRATCH_LIMIT,
+                "navia_combined_scratch_exceeded")
+        return total
+
+    @staticmethod
+    def _identity(path):
+        info = path.stat()
+        return [info.st_dev, info.st_ino]
+
+    def _publish_ownership(self, state):
+        # Only hashes/counts leave the private sink. This save precedes mkdir,
+        # each file open and every data write, including the first retention file.
+        ownership = {"owner": OWNER, "protocol_sha256": self.protocol_sha256,
+            "target_sha256": sha(os.path.normcase(str(self.export.resolve())).encode()),
+            "created_utc": self.created.isoformat(), "expires_utc": self.expires.isoformat(),
+            "state": state, "directory_created": self.directory_created,
+            "directory_identity_sha256": sha(canonical(self.directory_identity)),
+            "plan_sha256": sha(canonical(self.planned_files)),
+            "observed_sha256": sha(canonical(self.created_files)),
+            "originals_sha256": sha(canonical([self.original_pins, self.pending_originals])),
+            "planned_files": len(self.planned_files), "created_files": len(self.created_files),
+            "pending_arms": sorted(self.pending_arms)}
+        self.ownership = ownership
+        self.record["private_export_ownership"] = dict(ownership)
+        self.save()
+
+    def _plan_writes(self, writes):
+        plans = {}
+        for relative, raw in writes:
+            require(not Path(relative).is_absolute() and ".." not in Path(relative).parts
+                    and relative not in self.planned_files, "navia_private_write_plan")
+            target = self.export / relative
+            self.chasca.gate.managed.assert_unlinked(target)
+            require(not target.exists(), "navia_private_output_already_exists")
+            plans[relative] = {"bytes": len(raw), "sha256": sha(raw)}
+        self.planned_files.update(plans)
+        self._publish_ownership("writes_reserved")
+
+    def _reserve_directory(self):
+        require(not self.directory_created and not self.export.exists(), "navia_private_export_already_exists")
+        self._publish_ownership("directory_reserved")
+        self.export.mkdir(mode=0o700)  # Collision never establishes ownership.
+        self.directory_created = True
+        self.directory_identity = self._identity(self.export)
+        self._publish_ownership("directory_allocated")
+
+    def _observe_file(self, relative, maximum, complete):
+        path = self.export / relative
+        self.chasca.gate.managed.assert_unlinked(path)
+        row = self.created_files[relative]
+        require(self._identity(path) == row["identity"] and path.stat().st_size <= maximum,
+                "navia_private_created_file_changed")
+        row.update(bytes=path.stat().st_size, sha256=self.chasca.gate.owned._sha256_file(path), complete=complete)
+
+    def _write_private(self, relative, raw, maximum):
+        if relative not in self.planned_files:
+            self._plan_writes([(relative, raw)])
+        require(self.directory_created and self._identity(self.export) == self.directory_identity
+                and relative not in self.created_files
+                and self.planned_files[relative] == {"bytes": len(raw), "sha256": sha(raw)},
+                "navia_private_write_ownership")
+        self.check_budget(len(raw))
+        target = self.export / relative
+        self.chasca.gate.managed.assert_unlinked(target.parent)
+        target.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
+
+        def created(path):
+            self.created_files[relative] = {"identity": self._identity(path)}
+            self._publish_ownership("file_created")
+
+        try:
+            receipt = exclusive_raw(self.chasca, target, raw, maximum, on_created=created)
+            self._observe_file(relative, maximum, True)
+            self._publish_ownership("file_verified")
+            return receipt
+        except BaseException:
+            if relative in self.created_files:
+                try:
+                    self._observe_file(relative, maximum, False)
+                    self._publish_ownership("write_failed")
+                except Exception:
+                    self.record["private_export_recovery_required"] = "created_file_observation_or_save_failed"
+            raise
+
+    def _verify_owned_directory(self, *, allow_partial=False):
+        require(self.directory_created and self.export.is_dir()
+                and self._identity(self.export) == self.directory_identity
+                and self.record.get("private_export_ownership") == self.ownership,
+                "navia_private_directory_not_owned")
+        files, directories = self.chasca.repro_paths(self.export)
+        require({path.relative_to(self.export).as_posix() for path in files} == set(self.created_files),
+                "navia_private_export_unknown_files")
+        expected_directories = {self.export}
+        for relative, row in self.created_files.items():
+            target = self.export / relative
+            expected_directories.update(parent for parent in target.parents if parent.is_relative_to(self.export))
+            require("sha256" in row and (allow_partial or row.get("complete") is True)
+                    and self._identity(target) == row["identity"]
+                    and target.stat().st_size == row["bytes"]
+                    and self.chasca.gate.owned._sha256_file(target) == row["sha256"],
+                    "navia_private_export_hash_drift")
+            require(not row.get("complete") or {key: row[key] for key in ("bytes", "sha256")}
+                    == self.planned_files[relative], "navia_private_export_hash_drift")
+        require(set(directories) <= expected_directories, "navia_private_export_unknown_directories")
+
+    def _verify_retained_originals(self):
+        require(self.record.get("status") == "failed" and self.record.get("private_raw_retained") is True,
+                "navia_incomplete_export_requires_retained_failure")
+        prep.owned_job(self.chasca, self.job)
+        for row in [*self.original_pins, *self.pending_originals.values()]:
+            original = self.job / row["path"]
+            self.chasca.gate.managed.assert_unlinked(original)
+            require(original.stat().st_size == row["bytes"]
+                    and self.chasca.gate.owned._sha256_file(original) == row["sha256"],
+                    "navia_partial_export_original_drift")
+
+    def _copy_raw(self, relative, maximum):
+        require(not Path(relative).is_absolute() and ".." not in Path(relative).parts,
+                "navia_capsule_path_invalid")
+        source = self.job / relative
+        self.chasca.gate.managed.assert_unlinked(source)
+        raw = self.chasca.gate.io._read_optional(source, maximum)
+        require(type(raw) is bytes and 0 < len(raw) <= maximum, "navia_capsule_original_missing")
+        receipt = self._write_private(relative, raw, maximum)
+        return {"path": relative, "bytes": receipt["bytes"], "sha256": receipt["sha256"]}
+
+    def export_shared_capture(self):
+        require(self.capsule is None and self.job is not None, "navia_capture_export_once")
+        process = self.record.get("processes", {}).get("navia_exact_capture")
+        require(process is not None and self.chasca.gate.command_passed(process),
+                "navia_capture_process_not_passed")
+        manifest = self.chasca.capture_manifest(self.job, self.prepared)
+        require(manifest["complete"] and manifest["attempted_members"] == 2
+                and len(manifest["files"]) == 4, "navia_capture_not_complete")
+        required = [("prepared/request.json", prep.REQUEST_LIMIT),
+                    ("prepared/set-sources.json", prep.SOURCE_LIMIT),
+                    ("prepared/capsule-contract.json", 32768), ("capture-manifest.json", 32768)]
+        required.extend((row["path"], 128 << 20) for row in manifest["files"])
+        original_pins = []
+        for name, maximum in required:
+            original = self.job / name
+            self.chasca.gate.managed.assert_unlinked(original)
+            require(original.is_file() and 0 < original.stat().st_size <= maximum,
+                    "navia_capsule_original_missing")
+            original_pins.append({"path": name, "bytes": original.stat().st_size,
+                                 "sha256": self.chasca.gate.owned._sha256_file(original)})
+        retention = {"owner": OWNER, "protocol_sha256": self.protocol_sha256,
+            "created_utc": self.created.isoformat(), "expires_utc": self.expires.isoformat(),
+            "files": original_pins}
+        retention_raw = canonical(retention)
+        self.check_budget(len(retention_raw))
+        self.original_pins = original_pins
+        self._plan_writes([("retention.json", retention_raw)])
+        self._reserve_directory()
+        self.retention = self._write_private("retention.json", retention_raw, 32768)
+        self.record["private_export_retention"] = {**self.retention, "owner": OWNER,
+            "expires_utc": self.expires.isoformat()}
+        self.save()
+        rows = [self._copy_raw(name, maximum) for name, maximum in required]
+        require(len(rows) == 8 and len({row["path"] for row in rows}) == 8,
+                "navia_capture_capsule_file_count")
+        require(rows == original_pins, "navia_capture_original_changed_during_export")
+        copied = self.chasca.capture_manifest(self.export, self.prepared)
+        require(copied == manifest, "navia_capture_capsule_binding_drift")
+        require(rows[0]["sha256"] == self.prepared["request_raw_sha256"]
+                and rows[1]["sha256"] == self.prepared["source_bundle_sha256"],
+                "navia_capture_input_hash_drift")
+        contract = json.loads((self.export / "prepared/capsule-contract.json").read_bytes())
+        expected_contract = {"schema_version": 1, "artifact_count": 597,
+            "wearers": self.binding["wearer_order"], "seeds": list(prep.SEEDS),
+            **{key: self.prepared[key] for key in ("request_sha256", "request_raw_sha256",
+                "source_bundle_sha256", "engine_sha256", "engine_binding_sha256")}}
+        require(contract == expected_contract, "navia_capture_capsule_contract_drift")
+        index = {"owner": OWNER, "protocol_sha256": self.protocol_sha256,
+                 "packet_sha256": PACKET_SHA, "created_utc": self.created.isoformat(),
+                 "expires_utc": self.expires.isoformat(), "files": rows,
+                 "prepared": self.prepared, "input_order": self.binding,
+                 "context_sha256": manifest["context_sha256"], "config_sha256": manifest["config_sha256"]}
+        raw = canonical(index)
+        self.capsule = self._write_private("shared-capsule.json", raw, 32768)
+        self.record["private_shared_capture"] = {**self.capsule, "owner": OWNER,
+            "expires_utc": self.expires.isoformat(), "files": 8}
+        self.save()
+
+    def verify_shared_capture(self, *, compare_job=True, allow_pending=False):
+        require(self.capsule is not None, "navia_shared_capture_export_required")
+        require(allow_pending or not self.pending_arms, "navia_private_arm_export_pending")
+        self.verify_retention()
+        index_path = self.export / "shared-capsule.json"
+        self.chasca.gate.managed.assert_unlinked(index_path)
+        raw = self.chasca.gate.io._read_optional(index_path, 32768)
+        require(type(raw) is bytes and len(raw) == self.capsule["bytes"]
+                and sha(raw) == self.capsule["sha256"],
+                "navia_shared_capsule_index_drift")
+        index = json.loads(raw)
+        for row in index["files"]:
+            target = self.export / row["path"]
+            self.chasca.gate.managed.assert_unlinked(target)
+            require(target.stat().st_size == row["bytes"]
+                    and self.chasca.gate.owned._sha256_file(target) == row["sha256"],
+                    "navia_shared_capsule_file_drift")
+        copied = self.chasca.capture_manifest(self.export, self.prepared)
+        if compare_job:
+            require(copied == self.chasca.capture_manifest(self.job, self.prepared),
+                    "navia_shared_capture_changed")
+        for role, binding in self.arms.items():
+            arm = self.export / (role + "-projection.json")
+            self.chasca.gate.managed.assert_unlinked(arm)
+            require(arm.stat().st_size == binding["raw"]["bytes"]
+                    and self.chasca.gate.owned._sha256_file(arm) == binding["raw"]["sha256"]
+                    and self.chasca.gate.io._read_optional(self.export / (role + "-binding.json"), 4096)
+                    == canonical(binding),
+                    "navia_private_arm_export_drift")
+        self._verify_owned_directory(allow_partial=allow_pending)
+        return index
+
+    def verify_retention(self):
+        require(self.retention is not None, "navia_private_retention_missing")
+        raw = self.chasca.gate.io._read_optional(self.export / "retention.json", 32768)
+        require(type(raw) is bytes and len(raw) == self.retention["bytes"]
+                and sha(raw) == self.retention["sha256"], "navia_private_retention_drift")
+        retention = json.loads(raw)
+        require(retention["owner"] == OWNER and retention["protocol_sha256"] == self.protocol_sha256
+                and retention["expires_utc"] == self.expires.isoformat(), "navia_private_retention_drift")
+        return retention
+
+    def scratch(self, job, stage):
+        if self.job is None:
+            job = prep.owned_job(self.chasca, job)
+            self.base_scratch(job, stage)
+            self.allowance(1)
+            require(self.chasca.gate.common._tree_bytes(job) <= SCRATCH_LIMIT,
+                    "navia_combined_scratch_exceeded")
+            return
+        require(Path(job).resolve() == self.job, "navia_sink_job_drift")
+        self.base_scratch(job, stage)
+        self.check_budget()
+        if stage == CAPTURE_STAGE:
+            self.export_shared_capture()
+        if stage == "pair_completed":
+            self.verify_shared_capture()
+            require(set(self.arms) == {"baseline", "candidate"}, "navia_private_arm_exports_missing")
+
+    def export_required(self, role, raw):
+        require(role in ("baseline", "candidate") and role not in self.arms and role not in self.pending_arms,
+                "navia_private_arm_role")
+        self.verify_shared_capture()
+        require(type(raw) is bytes and 0 < len(raw) <= ARM_LIMIT, "navia_private_arm_scope")
+        receipt = {"verified": True, "bytes": len(raw), "sha256": sha(raw)}
+        binding = {"role": role, "protocol_sha256": self.protocol_sha256,
+                   "shared_capsule_sha256": self.capsule["sha256"], "raw": receipt}
+        encoded = canonical(binding)
+        original = self.job / (role + "-projection.json")
+        self.chasca.gate.managed.assert_unlinked(original)
+        require(original.is_file() and original.stat().st_size == len(raw)
+                and self.chasca.gate.owned._sha256_file(original) == receipt["sha256"],
+                "navia_private_arm_original_drift")
+        self.pending_arms[role] = binding
+        self.pending_originals[role] = {"path": role + "-projection.json", "bytes": len(raw), "sha256": sha(raw)}
+        self._plan_writes([(role + "-projection.json", raw), (role + "-binding.json", encoded)])
+        receipt = self._write_private(role + "-projection.json", raw, ARM_LIMIT)
+        self._write_private(role + "-binding.json", encoded, 4096)
+        self.arms[role] = binding
+        del self.pending_arms[role]
+        del self.pending_originals[role]
+        self._publish_ownership("arm_exported")
+        self.record.setdefault("private_arm_exports", {})[role] = binding
+        self.save()
+        return receipt  # W2 requires exactly verified/bytes/sha256, with no added fields.
+
+    def cleanup(self, expected_capsule_sha256):
+        """Controller's explicit release/24h cleaner, using the existing safe cleaner.
+
+        The controller must invoke this by the recorded deadline; constructing
+        these callbacks does not install a schedule or authorize deletion.
+        """
+        self.require_cleanup_release()
+        with self.chasca.gate.managed.run_directory_lease(self.export.parent):
+            if self.capsule is None or self.pending_arms:
+                require(expected_capsule_sha256 == (self.capsule["sha256"] if self.capsule else None),
+                        "navia_private_cleanup_binding")
+                self._verify_retained_originals()
+                self._verify_owned_directory(allow_partial=True)
+            if self.capsule is not None:
+                require(expected_capsule_sha256 == self.capsule["sha256"], "navia_private_cleanup_binding")
+                index = self.verify_shared_capture(compare_job=False, allow_pending=bool(self.pending_arms))
+                require(index["owner"] == OWNER and index["protocol_sha256"] == self.protocol_sha256,
+                        "navia_private_cleanup_owner")
+            removed = self.chasca.gate.managed.remove_owned_job(self.export, self.export.parent)
+            require(not self.export.exists(), "navia_private_cleanup_unconfirmed")
+        return {"owner": OWNER, "removed_bytes": removed, "cleanup_status": "confirmed",
+                "shared_capsule_sha256": expected_capsule_sha256}
+
