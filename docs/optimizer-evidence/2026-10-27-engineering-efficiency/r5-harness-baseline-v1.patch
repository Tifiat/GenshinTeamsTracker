+                    log_path=job/(label+".log"), timeout_seconds=maximum)
+                record["commands"][label] = result
+                export()
+                if not gate.command_passed(result): raise ValueError("dense_command_failed_"+label)
+
+            for arm in ("control", "candidate"):
+                record["builds"] += 1
+                command(arm+"-build", [gate.owned.GO_EXE,"-C",NATIVE,"test","-c","-p=1",
+                    "-mod=readonly","-buildvcs=false","-overlay="+overlays[arm]["path"],
+                    "-o",binaries[arm],"./internal/engineclient"], LIMITS["build_seconds"])
+            parity = {}
+            for arm in ("control", "candidate"):
+                path = job/("receipt-"+arm+"-parity.json")
