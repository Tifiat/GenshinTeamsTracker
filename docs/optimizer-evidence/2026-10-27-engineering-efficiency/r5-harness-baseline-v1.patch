+"""Stage the verified derived engine in an isolated normal engine store."""
+from __future__ import annotations
+
+from dataclasses import replace
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import zipfile
+
+from run_workspace.gcsim.artifact_build import GcsimBuildArtifactResult
+from run_workspace.gcsim import engine_store, runtime_bundle_sync, tree_identity
+from run_workspace.gcsim.source_manifest_build import compute_patched_source_tree_sha256
+from tools.experiments.gcsim.mvp_polish import mechanic_compiler_stage as stage
+from tools.experiments.gcsim.mvp_polish import mechanic_engine_patch as source
+
+ENGINE_ID="gcsim-v2.45.0-mechanic-compiler-20261025"
+
+
+def digest(path: Path)->str:return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def stage_store(job: Path)->tuple[Path,Path,Path]:
+    job=job.resolve(strict=True)
+    receipt=json.loads((stage.OUT/"stage5-producer-v4-engine.json").read_bytes())
+    release=json.loads((stage.OUT/"stage22-final-v1-release.json").read_bytes())
+    if release["status"]!="passed":raise ValueError("mechanic release acceptance incomplete")
+    archive=stage.OUT/receipt["archive"]["path"]
+    if digest(archive)!=receipt["archive"]["sha256"]:raise ValueError("mechanic engine archive changed")
+    store=engine_store.GcsimEngineStore(job/"engine-store")
+    engine=store.engines_dir/ENGINE_ID
+    if engine.exists():raise FileExistsError(engine)
+    with zipfile.ZipFile(archive) as z:
+        for name in z.namelist():(engine/name).resolve().relative_to(engine.resolve())
+        z.extractall(engine)
+    if compute_patched_source_tree_sha256(engine)!=receipt["build"]["source_manifest_patched_tree_sha256"]:raise ValueError("staged mechanic engine source changed")
+    raw_build=receipt["build"]
+    built=GcsimBuildArtifactResult(**raw_build)
+    binding=json.loads((engine/"build/gtt-source-manifest-input.json").read_bytes())
+    old=engine_store.load_engine_manifest(source.ENGINE)
+    files=json.loads(old.patch_metadata["patch_files"]);hashes=json.loads(old.patch_metadata["patch_file_sha256"])
+    if len(files)!=18:raise ValueError("accepted eighteen-patch foundation changed")
+    name="mechanic-owning-source.patch"
+    if name in files:raise ValueError("mechanic patch already registered")
+    patch=stage.OUT/"stage5-producer-v4-owning-source.patch"
+    if digest(patch)!=receipt["patch_sha256"]:raise ValueError("mechanic owning patch changed")
+    shutil.copy2(patch,engine/"build"/name)
+    files.append(name);hashes[name]=receipt["patch_sha256"]
+    metadata={**old.metadata,**built.metadata(),"artifact_sha256":raw_build["artifact_sha256"],"mechanic_producer_receipt":"stage5-producer-v4-engine.json","mechanic_operation_abi":"gtt_mechanic_operations_v1"}
+    patch_metadata={**old.patch_metadata,"patch_files":json.dumps(files,separators=(",",":")),"patch_file_sha256":json.dumps(hashes,sort_keys=True,separators=(",",":")),"patch_stack_sha256":binding["patch_stack_sha256"],"patch_stack_path":str(engine)}
+    manifest=replace(old,engine_id=ENGINE_ID,source_label="accepted unified-health + source mechanic observer",source_path=str(engine),patch_count=len(files),prepared_at_utc=datetime.now(timezone.utc).isoformat(),patch_metadata=patch_metadata,metadata=metadata,engine_tree_hash=tree_identity.directory_sha256(engine,excluded_relative_paths=("gtt_engine_manifest.json",)))
+    engine_store._write_manifest(engine/"gtt_engine_manifest.json",manifest)
+    runtime_bundle_sync._verified_engine(engine,engine_id=ENGINE_ID,expected_artifact_sha=raw_build["artifact_sha256"])
+    store.activate_engine(ENGINE_ID) # isolated pointer inside this managed job
+    consumer=job/"gtt-optimizer.exe"
+    shutil.copy2(stage.OUT/release["consumer_artifact"],consumer)
+    if digest(consumer)!=release["consumer_sha256"]:raise ValueError("staged mechanic consumer changed")
+    bundle=stage.OUT/release["bundled_cache"]["path"]
+    if digest(bundle)!=release["bundled_cache"]["sha256"]:raise ValueError("staged mechanic bundle changed")
+    bundled=job/"bundled-mechanics"
+    with zipfile.ZipFile(bundle) as z:
+        for name in z.namelist():(bundled/name).resolve().relative_to(bundled.resolve())
+        z.extractall(bundled)
+    return store.root_dir,consumer,bundled
diff --git a/tools/experiments/gcsim/mvp_polish/mechanic_compiler_stage.py b/tools/experiments/gcsim/mvp_polish/mechanic_compiler_stage.py
