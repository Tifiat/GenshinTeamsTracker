+        "evidence_source": "native ordinary-verification receipt; null means absent from retained receipt",
+    }
+    response = debug.get("support_response")
+    if not isinstance(response, dict):
+        response = debug.get("response_check")
+    response = response if isinstance(response, dict) else {}
+    support = _support_response_summary(response)
+    search = debug.get("search") if isinstance(debug.get("search"), dict) else {}
