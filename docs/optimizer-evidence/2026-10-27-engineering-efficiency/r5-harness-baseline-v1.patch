+def run_compile_guards(chasca, record, save, *, build, environment, scratch, allowance, protected):
+    """Only existing managed allocation + shared builds + the four zero-engine guards."""
+    def body(job):
+        binaries = build(job)
+        for role in ("baseline", "candidate"):
+            protected()
+            process = chasca.run_phase(job, guard_command(binaries[role]["path"]),
+                "navia_exact_guards_" + role, environment(job), 30, role + "-guards.log",
+                record=record, save=save, allowance=allowance, scratch=scratch)
+            require(chasca.gate.command_passed(process), "navia_provider_guards_failed")
+            raw = chasca.gate.io._read_optional(job / (role + "-guards.log"), 262144)
+            record.setdefault("provider_guards", {})[role] = guard_log(raw)
+            save()
+        record["status"] = "compile_guards_passed"
+        save()
+    try:
+        chasca.gate.run_owned_body(None, record, save, body)
+        protected()
+        require(record.get("status") == "compile_guards_passed" and not record["errors"]
+                and record.get("owned_cleanup_latch") is True
+                and record.get("cleanup_status") == "confirmed"
+                and not tuple(chasca.gate.managed.MANAGED_ROOT.glob("job-*"))
+                and not chasca.gate.retirement._default_process_probe(ROOT), "navia_guard_postflight")
+        record["status"] = "compile_guards_passed_cleanup_confirmed"
+    except BaseException:
+        record["status"] = "failed"
+        record["errors"].append("compile_guard_or_postflight_failed")
+        raise
+    finally:
+        save()  # Existing lifecycle changes cleanup fields after its export.
+    return record
+
