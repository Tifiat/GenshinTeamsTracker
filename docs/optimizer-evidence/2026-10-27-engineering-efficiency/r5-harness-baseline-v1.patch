+                                    "verification_seconds": projection.get("verification_seconds"),
+                                    "raw_search_count": len(panel["raw"]),
+                                    "anchors_count": len(panel.get("anchors", [])),
+                                    "projection_sha256": k.sha(bounded(candidate / "candidate-projection.json"))}
+            command([binary, "-test.run=^TestHealthUnifiedChascaQuality$", "-test.v", "-test.parallel=1",
+                     "-test.timeout=280s"], "chasca-quality", 300, job,
+                    {"GTT_HEALTH_UNIFIED_DIR": str(job), "GTT_HEALTH_UNIFIED_PHASE": "chasca-quality",
+                     "GTT_RULE_CACHE_DIR": str(candidate / "rule-cache")}, deadline)
+            complete.prior.retained.local_pair._verify_named_tests(bounded(job / "chasca-quality.log").decode(),
+                                                                  ["TestHealthUnifiedChascaQuality"])
+            verify_chasca_quality(job, result)
+        else:
+            for arm in ("control", "candidate"):
+                command([sys.executable, "-B", CASE_HELPER, "--job", job, "--case", case_key,
+                         "--stage", "selected", "--arm", arm, "--binding", bindings[arm]],
+                        case_key + "-" + arm, min(600, LIMITS[case_key + "_seconds"]), job,
+                        {"GTT_RULE_CACHE_DIR": str(case / arm / "rule-cache")}, deadline)
+                output = json.loads(bounded(case / arm / "selected-result.json"))
+                if (output.get("schema") != "health_unified_selected_v1" or output.get("success") is not True
+                        or output.get("case_key") != case_key or output.get("arm") != arm
+                        or output.get("request_sha256") != result[arm + "_request_sha256"]
+                        or output.get("engine_binding_sha256") != json.loads(bounded(bindings[arm]))["binding_sha256"]
+                        or output.get("installed_consumer_sha256") != INSTALLED_CONSUMER_SHA):
+                    raise ValueError("unified_selected_result_invalid")
+                result[arm] = {"result_sha256": k.sha(bounded(case / arm / "selected-result.json")),
+                               "setup_seconds": output.get("setup_seconds"),
+                               "search_seconds": output.get("search_seconds"),
+                               "verification_seconds": output.get("verification_seconds"),
+                               "whole_headless_seconds": output.get("whole_headless_seconds"),
+                               **selected_cohort_summary(output)}
+                save()
+            result["descriptive_measured_best_delta_dps"] = (result["candidate"]["measured_best"]["measured_dps"]
+                                                             - result["control"]["measured_best"]["measured_dps"])
+            result["same_engine_comparison"] = False
+            command([binary, "-test.run=^TestHealthUnifiedSelectedQuality$", "-test.v", "-test.parallel=1",
+                     "-test.timeout=280s"], case_key + "-quality", 300, job,
+                    {"GTT_HEALTH_UNIFIED_DIR": str(job), "GTT_HEALTH_UNIFIED_PHASE": "selected-quality",
+                     "GTT_HEALTH_UNIFIED_CASE": case_key,
+                     "GTT_RULE_CACHE_DIR": str(case / "candidate/rule-cache")}, deadline)
+            complete.prior.retained.local_pair._verify_named_tests(bounded(job / (case_key + "-quality.log")).decode(),
+                                                                  ["TestHealthUnifiedSelectedQuality"])
+            verify_selected_quality(job, case_key, result)
+        result["stage_wall_seconds"] = round(time.monotonic() - case_started, 3)
+        result["status"] = "complete"
