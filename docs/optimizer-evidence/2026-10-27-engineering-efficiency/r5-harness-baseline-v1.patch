+++ b/tools/experiments/gcsim/mvp_polish/model_preparation_install.py
@@ -0,0 +1,147 @@
+"""Guarded uptake of the accepted model delta via existing real button gates."""
+from __future__ import annotations
+import argparse
+import difflib
+import json
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+sys.dont_write_bytecode=True
+from tools.experiments.gcsim.mvp_polish import model_preparation_run as measured
+
+model,dense,scope,old,gate=measured.model,measured.dense,measured.scope,measured.installed,measured.gate
+ROOT,NATIVE,EVIDENCE=measured.ROOT,measured.NATIVE,measured.EVIDENCE
+PREFIX='model-preparation-install-v2'
+FREEZE,RESULT=[EVIDENCE/(PREFIX+s) for s in ('-freeze.json','-result.json')]
+ROLLBACK=EVIDENCE/(PREFIX+'-rollback')
+BEFORE='fd2c2cb3e96f04259c8cff51422b883dee1ac57d6d32c0d60d56b07418595ffb'
+LIMITS=dict(old.LIMITS)
+LIMITS.update(compact_members_total=16,policy_n1_total=8,final_n500_total=4,observed_engine_calls_total=28)
+DELTA=('internal/setcontext/neutral.go','internal/seteffects/neutral_binding.go','internal/seteffects/neutral_expressions.go',
+       'internal/seteffects/rule_replay.go','internal/seteffects/rule_world_views.go','internal/seteffects/rule_amount_query.go')
+require=measured.require
+
+
+def pins():
+    return {**old.pins(),**measured.pins(),Path(__file__).relative_to(ROOT).as_posix():old.sha_file(Path(__file__)),
+        measured.RESULT.relative_to(ROOT).as_posix():old.sha_file(measured.RESULT),measured.FREEZE.relative_to(ROOT).as_posix():old.sha_file(measured.FREEZE)}
+
+
+def live_images():
+    base=dense.base_images()
+    require(all(not (NATIVE/n).exists() for n in DELTA[-2:]),'model_new_source_exists')
+    out=model.world_delta({n:dense.read(NATIVE/n) for n in DELTA[:4]})
+    name='internal/seteffects/rule_replay.go';raw=out[name].decode();accepted=base[name].decode()
+    start='\t\targs := []any{}';end='\t\tvalue, err := h.amount(m, q, args)'
+    require(raw.count(start)==raw.count(end)==accepted.count(start)==accepted.count(end)==1,'model_amount_anchor')
+    block=raw[raw.index(start):raw.index(end)+len(end)]
+    require(block==accepted[accepted.index(start):accepted.index(end)+len(end)],'model_live_amount_foreign_change')
+    out[name]=measured.saved.producer.patch_source(out[name],[(block,'\t\tbefore := len(h.mods)\n\t\tvalue, err := h.queryAmount(m, q)')])
+    out[DELTA[-1]]=model.AMOUNT.read_bytes()
+    return out
+
+
+def prepare():
+    require(not FREEZE.exists() and not RESULT.exists() and not ROLLBACK.exists(),'model_install_prepared')
+    result=json.loads(dense.read(measured.RESULT))
+    require(result['status']=='complete_uninstalled' and len(result['pairs'])==3 and result['preservation_exact'],'model_measurement_not_accepted')
+    require(old.sha_file(old.CONSUMER)==BEFORE,'model_consumer_before')
+    product=model.product_images();before={n:old.sha_file(NATIVE/n) for n in DELTA};desired=live_images();native=scope.accepted.K.old.native_map()
+    exclusions=dense.physical_exclusions()
+    require(set(native)-set(product)==set(exclusions),'model_unknown_native_source')
+    plan={'schema':'dense_node_install_v1','limits':LIMITS,'source_pins':pins(),'child_sha256':scope.sha(old.CHILD.encode()),
+        'consumer_before':BEFORE,'engine_sha256':scope.ENGINE_SHA,'candidate_images':len(product),'candidate_map_sha256':scope.sha(dense.canonical(dense.image_hashes(product))),
+        'physical_exclusions':exclusions,'protected_before':scope.accepted.K.protected(),'native_before':native,
+        'native_after':{**native,**{n:scope.sha(b) for n,b in desired.items()}},'live_before':before,'live_after':{n:scope.sha(b) for n,b in desired.items()},
+        'dirty_before':old.dirty_map(),'python_sha256':old.sha_file(Path(sys.executable)),'go_sha256':old.sha_file(gate.owned.GO_EXE),
+        'cases':list(old.CASES),'gate_order':'apply_only_reviewed_source_delta_then_control4_build_atomic_install_installed4_rollback_on_failure',
+        'measurement_result_sha256':old.sha_file(measured.RESULT),'scope':'owned-member world-view reuse plus AJ validation-preserving hit conversion; identical formula/order/quality; accepted AH decoder/health closure',
+        'source_delta':list(DELTA),'physical_UI':'extra clicks waived; real public backend path only'}
+    ROLLBACK.mkdir();scope.accepted.runtime._write_once(ROLLBACK/'previous-gtt-optimizer.exe',dense.read(old.CONSUMER))
+    require(old.sha_file(ROLLBACK/'previous-gtt-optimizer.exe')==BEFORE,'model_rollback_readback')
+    patch='*** Begin Patch\n'
+    for name,raw in desired.items():
+        path=NATIVE/name
+        if path.exists():
+            scope.accepted.runtime._write_once(ROLLBACK/(name.replace('/','__')),dense.read(path))
+            lines=list(difflib.unified_diff(dense.read(path).decode().splitlines(),raw.decode().splitlines(),n=3,lineterm=''))
+            patch+='*** Update File: '+path.relative_to(ROOT).as_posix()+'\n'
+            for line in lines[2:]:patch+=('@@' if line.startswith('@@') else line)+'\n'
+        else:patch+='*** Add File: '+path.relative_to(ROOT).as_posix()+'\n'+''.join('+'+line+'\n' for line in raw.decode().splitlines())
+    patch+='*** End Patch\n'
+    scope.accepted.runtime._write_once(ROLLBACK/'reviewed-source.patch',patch.encode())
+    scope.cases.write_once(ROLLBACK/'beforeimages.json',{'consumer':BEFORE,'live':before})
+    scope.cases.write_once(FREEZE,plan)
+    return {'freeze':str(FREEZE),'sha256':old.sha_file(FREEZE),'source_patch':str(ROLLBACK/'reviewed-source.patch')}
+
+
+def preserve(plan,consumer,source_after=True):
+    expected=dict(plan['protected_before']);expected[str(old.CONSUMER)]=consumer
+    require(scope.accepted.K.protected()==expected,'model_install_protected_drift')
+    require(scope.accepted.K.old.native_map()==plan['native_after' if source_after else 'native_before'],'model_install_native_drift')
+    current=old.dirty_map();allowed={str(Path('native/gcsim_optimizer')/n).replace('\\','/') for n in DELTA}|{old.rel(old.CONSUMER)}
+    require(all(current.get(n,'absent')==v for n,v in plan['dirty_before'].items() if n not in allowed),'model_install_foreign_drift')
+    require(pins()==plan['source_pins'],'model_install_pins')
+
+
+def rollback_sources(plan):
+    for name in DELTA:
+        path=NATIVE/name;actual=old.sha_file(path)
+        require(actual in {plan['live_before'][name],plan['live_after'][name]},'model_source_rollback_cas')
+        if actual==plan['live_before'][name]:continue
+        if plan['live_before'][name]=='absent':path.unlink()
+        else:
+            raw=dense.read(ROLLBACK/(name.replace('/','__')));require(scope.sha(raw)==plan['live_before'][name],'model_beforeimage_hash')
+            # Atomic source recovery mirrors the existing retained installer.
+            temp=path.with_name(path.name+'.model-rollback-stage');require(not temp.exists(),'model_source_rollback_stage');scope.accepted.runtime._write_once(temp,raw)
+            import os
+            os.replace(temp,path)
+    require(scope.accepted.K.old.native_map()==plan['native_before'],'model_source_rollback_inexact')
+
+
+def stage_runtime(job,plan):
+    images=model.product_images();require(scope.sha(dense.canonical(dense.image_hashes(images)))==plan['candidate_map_sha256'],'model_install_closure_drift')
+    require(set(scope.accepted.K.old.native_map())-set(images)==set(plan['physical_exclusions']),'model_install_physical_shape')
+    replace={}
+    for name,raw in images.items():
+        path=job/'runtime-source'/name;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(raw);require(old.sha_file(path)==scope.sha(raw),'model_runtime_source_readback');replace[str(NATIVE/name)]=str(path)
+    replace.update({str(NATIVE/n):'' for n in plan['physical_exclusions']})
+    path=job/'runtime-overlay.json';scope.cases.write_once(path,{'Replace':replace});return path
+
+
+def collect(job,wire,record,arm):
+    rows=old.collect(job,wire,record,arm)
+    root=job/('profile-layout-'+'a'*70)/('saved-runs-'+'b'*70)
+    policy=0
+    for run in root.iterdir():
+        output=json.loads(dense.read(run/'optimizer-output.json'))
+        policy+=int((output.get('adaptive_policy') or {}).get('calls',0))
+    counts=record['arms'][arm]['counts'];counts['policy_ordinary_calls']=policy
+    counts['engine_calls']=counts['captures']+counts['ordinary_calls']+policy
+    require(counts['captures']==8 and counts['ordinary_calls']==2 and policy==4 and counts['engine_calls']==14,'model_exact_button_engine_budget')
+    counts['count_scope']='compact members + policy n1 calls + final n500 calls; failed process count only if logged'
+    return rows
+
+
+def run(expected):
+    plan=json.loads(dense.read(FREEZE))
+    proxy=SimpleNamespace(**{**vars(scope),'CONSUMER_SHA':BEFORE})
+    runner=dense.function_view(old.run,FREEZE=FREEZE,RESULT=RESULT,ROLLBACK=ROLLBACK,PREFIX=PREFIX,LIMITS=LIMITS,
