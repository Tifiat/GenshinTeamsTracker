+"""Accepted-source formula-primary adaptive hybrid overlay.
+
+The 16-proposal selector and ordinary paired feedback are inherited from the
+reviewed adaptive replay. Formula leaders stay on the primary path; one
+deduplicated engine-incumbent refinement may be admitted after each block.
+This module only constructs source images and does not compile or run them.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+from typing import Any
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import adaptive_hybrid_replay as replay
+from tools.experiments.gcsim.mvp_polish import adaptive_no_feedback as no_feedback
+
+
+POLICY = Path(__file__).with_name("adaptive_hybrid_policy_test.go")
+VERIFICATION = Path(__file__).with_name("adaptive_hybrid_verification_test.go")
+SECONDARY = Path(__file__).with_name("adaptive_formula_primary_test.go")
+SOURCE_FILES: tuple[Path, ...] = (Path(__file__), SECONDARY)
+
+
+def _once(source: str, before: str, after: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"expected one source seam: {before!r}")
+    return source.replace(before, after, 1)
+
+
+def _hybrid_end_image() -> bytes:
+    original = POLICY.read_text(encoding="utf-8")
+    start = "// researchHybridEnd measures at most three unique complete builds"
+    end = "\nfunc (p *adaptiveHybridPolicy) measurePair"
+    if original.count(start) != 1:
+        raise ValueError("expected one accepted adaptive feedback function")
+    offset = original.index(start)
+    finish = original.find(end, offset)
+    if finish < 0:
+        raise ValueError("missing adaptive feedback function boundary")
+    return original[offset:finish].encode("utf-8")
+
+
+def _policy_image(feedback_enabled: bool) -> bytes:
+    policy = no_feedback.no_feedback_policy_image()
+    if not feedback_enabled:
+        return policy
+    text = policy.decode("utf-8")
+    text = no_feedback._replace_region(
+        text,
+        "// researchHybridEnd records the disabled feedback decision",
+        "\nfunc (p *adaptiveHybridPolicy) measurePair",
+        _hybrid_end_image().decode("utf-8"),
+    )
+    text = _once(
+        text,
+        '"feedback_enabled":        false,',
+        '"feedback_enabled":        true,',
+    )
+    return text.encode("utf-8")
+
+
+def _coordinator_image(source: bytes, secondary_enabled: bool) -> bytes:
+    text = source.decode("utf-8")
+    if secondary_enabled:
+        text = _once(
+            text,
+            "anchor := researchHybridAnchor(out.Leader)\n\t\t\tpackageChoices",
+            "anchor := researchHybridAnchor(out.Leader)\n\t\t\tresearchFormulaPrimaryBeginBlock(anchor)\n\t\t\tpackageChoices",
+        )
+        text = _once(
+            text,
+            "result, e := solver.RefineCandidates(runCtx, c.Score.Assignment, proposal.actor, min(remaining, cfg.Search.MaxExpandedPerActor))",
+            "researchFormulaPrimaryMarkPrimary(c)\n\t\t\t\tresult, e := solver.RefineCandidates(runCtx, c.Score.Assignment, proposal.actor, min(remaining, cfg.Search.MaxExpandedPerActor))",
+        )
+        text = _once(
+            text,
+            "retain(candidate)\n\t\t\t\t\tpackageChoices[actor]",
+            "researchFormulaPrimaryMarkPrimary(candidate)\n\t\t\t\t\tretain(candidate)\n\t\t\t\t\tpackageChoices[actor]",
+        )
+        text = _once(
+            text,
+            "if e := researchHybridEnd(runCtx, out.Leader); e != nil { return out,e }",
+            "secondaryStep, secondaryErr := researchFormulaPrimarySecondary(runCtx, actor, cfg.MaxSearchExpansions-out.SearchExpansions, cfg.Search.MaxExpandedPerActor, bind, solverFor, retain, record)\n\t\t\tif secondaryErr != nil { return out, secondaryErr }\n\t\t\tout.SearchExpansions += secondaryStep.Expanded\n\t\t\tif e := researchHybridEnd(runCtx, out.Leader); e != nil { return out,e }",
+        )
+    return text.encode("utf-8")
+
+
+def _verification_image(source: bytes) -> bytes:
+    text = source.decode("utf-8")
+    text = _once(
+        text,
+        ' reserve:=func(c Candidate)error{\n  protected[c.Score.Assignment]=true\n  for _,row:=range panel {if row.Score.Assignment==c.Score.Assignment{return nil}}\n  for i:=len(panel)-1;i>=0;i-- {if !protected[panel[i].Score.Assignment]{\n   added=append(added,map[string]any{"added":adaptiveCompact(c),"removed":adaptiveCompact(panel[i])});panel[i]=c;return nil\n  }}\n  return fmt.Errorf("no final slot available for protected incumbent")\n }',
+        ' reserve:=func(c Candidate)error{\n  removed,changed,err:=researchFormulaPrimaryReserve(&panel,protected,c)\n  if err!=nil{return err}\n  if changed{added=append(added,map[string]any{"added":adaptiveCompact(c),"removed":adaptiveCompact(removed)})}\n  return nil\n }',
+    )
+    return _once(
+        text,
+        "if err:=reserve(result.Initial);err!=nil{return nil,err}\n if researchHybrid!=nil && researchHybrid.HasIncumbent {",
+        "if err:=reserve(result.Initial);err!=nil{return nil,err}\n if err:=reserve(result.Leader);err!=nil{return nil,err}\n if researchHybrid!=nil && researchHybrid.HasIncumbent {",
+    ).encode("utf-8")
+
+
+def formula_primary_overlay(
+    *, feedback_enabled: bool = True, secondary_enabled: bool = True
+) -> dict[str, Any]:
+    """Return an in-memory accepted-source overlay for the primary-path arm.
+
+    With both features disabled, this returns the existing no-feedback factory
+    result verbatim. That is a source-construction equivalence only; it is not
+    a claim about an executed comparison.
+    """
+    if not feedback_enabled and not secondary_enabled:
+        return no_feedback.no_feedback_overlay()
+
+    base = no_feedback.no_feedback_overlay()
+    images = dict(base["images"])
+    coordinator = _coordinator_image(
+        images["internal/allsets/neutral_coordinator.go"], secondary_enabled
+    )
+    images["internal/allsets/neutral_coordinator.go"] = coordinator
+    policy = _policy_image(feedback_enabled)
+    verification = _verification_image(VERIFICATION.read_bytes())
+    secondary = SECONDARY.read_bytes()
+    helper = base["helper"]
+    helper_text = helper.decode("utf-8")
+    helper_text = _once(
+        helper_text,
+        'payload["policy"] = researchHybridSummary()',
+        'payload["policy"] = researchFormulaPrimaryPolicySummary()',
+    )
+    helper = helper_text.encode("utf-8")
+
+    overlay_files = {
+        "internal/allsets/zz_adaptive_replay_test.go": helper,
+        "internal/allsets/zz_adaptive_policy_test.go": policy,
+        "internal/allsets/zz_adaptive_verification_test.go": verification,
+        "internal/allsets/zz_adaptive_formula_primary_test.go": secondary,
+    }
+    hashes = {
+        "accepted_source_map_sha256": base["hashes"]["accepted_source_map_sha256"],
+        "replayed_source_map_sha256": replay.k.gate.digest(
+            {relative: replay.k.sha(raw) for relative, raw in images.items()}
+        ),
+        "helper_sha256": replay.k.sha(helper),
+        "policy_sha256": replay.k.sha(policy),
+        "verification_sha256": replay.k.sha(verification),
+        "secondary_helper_sha256": replay.k.sha(secondary),
+    }
+    metadata = {
+        "schema": "adaptive_formula_primary_overlay_v1",
+        "feedback_enabled": feedback_enabled,
+        "secondary_enabled": secondary_enabled,
+        "queue_width": 16,
+        "queue_selection": {"formula": 8, "known_spread": 4, "set_diverse": 4},
+        "neutral_cycles": 2,
+        "formula_leader_remains_primary_anchor": True,
+        "secondary_max_per_block": 1 if secondary_enabled else 0,
+        "secondary_total_max": 8 if secondary_enabled else 0,
+        "secondary_uses_existing_expansion_budget": True,
+        "ordinary_engine_policy_calls_max": 48 if feedback_enabled else 0,
+        "ordinary_engine_policy_seeds": 2,
+        "final_verification_calls": 9,
+        "final_verification_iterations": 500,
+        "final_verification_workers": 4,
+        "protect_initial_formula_leader_and_engine_incumbent": True,
+        "both_features_disabled_source_matches_no_feedback_factory": (
+            not feedback_enabled and not secondary_enabled
+        ),
+        "equivalence_boundary": "source factory only; no runtime equivalence claim",
+        "secondary_route": (
+            "one engine-incumbent RefineCandidates call after the primary queue, before paired feedback"
+            if secondary_enabled
+            else "disabled"
+        ),
+        "source_files": [str(path.resolve()) for path in SOURCE_FILES],
+    }
+    return {
+        "images": images,
+        "helper": helper,
+        "policy": policy,
+        "verification": verification,
+        "overlay_files": overlay_files,
+        "hashes": hashes,
+        "metadata": metadata,
+    }
