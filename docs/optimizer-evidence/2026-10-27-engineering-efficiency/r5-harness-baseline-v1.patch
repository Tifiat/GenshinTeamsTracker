+    results, configs = sorted(root.rglob("result.json")), sorted(root.rglob("config.txt"))
+    if len(results) != calls or len(configs) != calls:
+        raise ValueError("profile_policy_raw_count")
+    actual = {}
+    for result in results:
+        config = result.with_name("config.txt")
+        pair = (k.sha(read_bounded(config)), k.sha(read_bounded(result)))
+        if pair in actual:
+            raise ValueError("profile_duplicate_policy_identity")
+        actual[pair] = result.parent.relative_to(root).as_posix()
+    samples = policy["samples"] or []
+    if sorted(row.get("call") for row in samples) != list(range(1, calls + 1)):
+        raise ValueError("profile_policy_call_sequence")
+    by_kind = {}
+    for kind in ("ordinary_started", "ordinary_finished"):
+        rows = [e for e in events if e.get("type") == kind]
+        if len(rows) != calls or sorted(row.get("call") for row in rows) != list(range(1, calls + 1)):
+            raise ValueError("profile_policy_event_count")
+        by_kind[kind] = {e["call"]: e for e in rows}
+    seeds = json.loads((k.RUN / "request.json").read_bytes())["stochastic"]["seeds"]
+    bindings = []
+    used_pairs = set()
+    for row in samples:
+        pair = (row.get("config_sha256"), row.get("engine_result_sha256"))
+        if pair not in actual or pair in used_pairs or row.get("seed") not in seeds:
+            raise ValueError("profile_policy_result_join")
+        used_pairs.add(pair)
+        for kind in by_kind:
+            event = by_kind[kind][row["call"]]
+            if any(event.get(key) != row.get(key) for key in ("block", "call", "seed", "candidate")):
+                raise ValueError("profile_policy_event_identity")
+        if by_kind["ordinary_finished"][row["call"]].get("error") != "" or row.get("error") is not None or row.get("validation_error") is not None:
+            raise ValueError("profile_policy_sample_failure")
+        bindings.append({**{key: row.get(key) for key in ("block", "call", "seed", "config_sha256", "engine_result_sha256")},
+                         "source_relative_directory": actual[pair]})
+    if used_pairs != set(actual):
+        raise ValueError("profile_unclaimed_policy_result")
+    record["policy_measurement_bindings"] = bindings
