+def _result_summary(
+    payload: dict,
+    request: dict | None = None,
+    *,
+    first_theory_ready_snapshot: dict | None = None,
+    first_theory_ready_elapsed_ms: int | None = None,
+    first_theory_ready_projection_ms: int | None = None,
+) -> dict:
+    result = payload.get("result") if isinstance(payload.get("result"), dict) else {}
+    summary: dict = {
+        "status": str(result.get("status") or payload.get("status") or "unknown"),
+        "result_schema_kind": str(result.get("schema_kind") or result.get("result_kind") or ""),
+    }
+    for key in ("formula_dps", "estimated_dps", "measured_dps"):
+        value = result.get(key)
+        if isinstance(value, (str, int, float)):
+            summary[key] = str(value)
+    measured = result.get("measured")
+    if isinstance(measured, dict):
+        summary["measured"] = {
+            key: str(measured[key])
+            for key in ("dps", "standard_error", "iterations")
+            if key in measured and isinstance(measured[key], (str, int, float))
+        }
+    artifacts_by_id = {
+        int(row["artifact_id"]): row
+        for row in (request or {}).get("artifacts", ())
+        if isinstance(row, dict) and type(row.get("artifact_id")) is int
+    }
+
+    def assignments(rows):
+        output = []
+        for assignment in rows[:20] if isinstance(rows, list) else ():
+            if not isinstance(assignment, dict):
+                continue
+            artifact_id = assignment.get("artifact_id")
+            request_artifact = artifacts_by_id.get(artifact_id) if type(artifact_id) is int else None
+            output.append({
+                "wearer_key": str(assignment.get("wearer_key") or "")[:80],
+                "slot": str(assignment.get("slot") or "")[:24],
+                "artifact_id": artifact_id if type(artifact_id) is int else None,
+                "set_uid": str((request_artifact or {}).get("set_uid") or "")[:80],
+                "main_stat": (request_artifact or {}).get("main_stat"),
+                "substats": list((request_artifact or {}).get("substats") or ())[:4],
+            })
+        return output
+
+    winner = result.get("winner")
+    if isinstance(winner, list):
+        summary["winner_artifact_count"] = len(winner)
+        summary["winner_sha256"] = _result_digest(winner)
+        summary["winner_assignments"] = assignments(winner)
+    counts = {}
+    for key in ("finalists", "candidate_builds", "candidate_packages", "verified_builds"):
+        value = result.get(key)
+        if isinstance(value, list):
+            counts[key] = len(value)
+    if counts:
+        summary["candidate_counts"] = counts
+    candidates = result.get("candidates")
+    if isinstance(candidates, list):
+        counts["verified_builds"] = len(candidates)
+        summary["ordinary_candidate_receipts"] = [
+            {
+                key: candidate[key]
+                for key in (
+                    "rank", "formula_dps", "formula_residual", "set_group_key",
+                    "set_group_rank", "alternative_rank",
+                )
+                if key in candidate and isinstance(candidate[key], (str, int, float))
+            } | {
+                "measured": {
+                    key: candidate["measured"][key]
+                    for key in ("iterations", "dps", "standard_error", "engine_result_sha256")
+                    if key in candidate["measured"]
+                    and isinstance(candidate["measured"][key], (str, int, float))
+                } if isinstance(candidate.get("measured"), dict) else None,
+                "artifacts": assignments(candidate.get("artifacts")),
+            }
+            for candidate in candidates[:8]
+            if isinstance(candidate, dict)
+        ]
+    snapshot = result.get("theory_snapshot") if isinstance(result.get("theory_snapshot"), dict) else None
+    if snapshot is None and isinstance(result.get("verification"), dict):
+        snapshot = result
+    if isinstance(snapshot, dict) and "co_leaders" in snapshot:
+        terminal_summary = _theory_publication_summary(snapshot)
+        summary["theory_families"] = terminal_summary.pop("theory_families")
+        summary["theory_snapshot"] = terminal_summary
+    if first_theory_ready_snapshot is not None:
+        summary["theory_first_ready_snapshot"] = first_theory_ready_snapshot
+        summary["theory_first_ready_elapsed_ms"] = first_theory_ready_elapsed_ms
+        summary["theory_first_ready_projection_ms"] = first_theory_ready_projection_ms
+    elif str(payload.get("mode") or result.get("mode") or "") == "theory":
+        summary["theory_first_ready_snapshot"] = None
+        summary["theory_first_ready_elapsed_ms"] = None
+    return summary
+
