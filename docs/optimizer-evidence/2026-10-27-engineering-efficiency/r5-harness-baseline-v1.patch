+def compare_production_finalists(*, product_result: dict, source_request: dict,
+                                execution_request: dict) -> dict:
+    panel, pins = frozen_panel()
+    if (source_request.get("engine", {}).get("artifact_sha256") != ENGINE_SHA
+            or execution_request.get("engine", {}).get("artifact_sha256") != ENGINE_SHA):
+        raise ValueError("unified_execution_engine_identity_changed")
+    relocated = json.loads(json.dumps(execution_request))
+    relocated["engine"]["binary_path"] = source_request["engine"]["binary_path"]
+    if relocated != source_request:
+        raise ValueError("unified_execution_request_not_path_only")
+    snapshot = product_result.get("neutral_search_finalists")
+    if (not isinstance(snapshot, dict) or snapshot.get("schema") != "neutral_search_finalists_v1"
+            or not isinstance(snapshot.get("rows"), list) or len(snapshot["rows"]) != 9):
+        raise ValueError("unified_production_raw9_missing")
+    observed = snapshot["rows"]
+    context_lineage = []
+    for index, (saved, current) in enumerate(zip(panel["raw"], observed, strict=True)):
+        expected = {
+            "label": f"raw_search_{index:02d}",
+            "score": {"assignment": _assignment(saved["score"]["assignment"]),
+                      "dps": saved["score"]["dps"],
+                      "source": saved["score"]["source"]},
+            "packages": saved["packages"],
+            "config_sha256": saved["config_sha256"],
+        }
+        if (not isinstance(current, dict) or set(current) != set(expected) | {"context_sha256"}
+                or not isinstance(current["context_sha256"], str)
+                or len(current["context_sha256"]) != 64):
+            raise ValueError("unified_production_raw_row_shape_changed")
+        _assignment(current["score"]["assignment"])
+        if {key: value for key, value in current.items() if key != "context_sha256"} != expected:
+            raise ValueError("unified_production_raw_row_differs:" + expected["label"])
+        context_lineage.append({"label": expected["label"], "research_context_sha256": saved["context_sha256"],
+                                "execution_context_sha256": current["context_sha256"]})
+    cohort = product_result.get("verification", {}).get("candidates")
+    if (product_result.get("mode") != "all_sets" or not isinstance(cohort, list)
+            or len(cohort) != 9):
+        raise ValueError("unified_production_product_cohort_invalid")
+    seen = set()
+    labels = []
+    for row in cohort:
+        assignment = _assignment(row.get("assignment"))
+        label = (row.get("rank"), row.get("source"), tuple(tuple(x) for x in assignment))
+        if label in seen:
+            raise ValueError("unified_production_product_cohort_duplicate")
+        seen.add(label)
+        labels.append({"rank": row.get("rank"), "source": row.get("source"),
+                       "assignment_sha256": sha(json.dumps(assignment, separators=(",", ":")).encode())})
+    return {"research_pins": pins, "exact_raw_search_finalists": 9,
+            "source_execution_request_equal_except_engine_binary_path": True,
+            "context_path_lineage": context_lineage,
+            "product_verification_cohort": labels,
+            "global_optimum_proved": False, "no_loss_proved": False}
