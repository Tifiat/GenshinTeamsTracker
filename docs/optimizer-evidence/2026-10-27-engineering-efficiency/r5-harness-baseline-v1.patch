+"""Finite source-only Tigh V2 preparation observer and saved input admission.
+
+Only the original policy's engine transport is replaced by exact archived
+responses. Instrumentation patches erase byte-for-byte to accepted core images.
+"""
+from __future__ import annotations
+
+import gzip
+import json
+import math
+from pathlib import Path
+import sys
+
+sys.dont_write_bytecode = True
+from tools.experiments.gcsim.mvp_polish import dense_node_measure as dense
+
+scope = dense.scope
+ROOT, NATIVE, EVIDENCE = dense.ROOT, dense.NATIVE, dense.EVIDENCE
+HERE = Path(__file__).parent
+HELPER = HERE / "preparation_v2_measure_test.go"
+PREFIX = "preparation-v2-measure-v3"
+LIMITS = {"whole_seconds": 1200, "cleanup_reserve_seconds": 180,
+          "build_seconds": 240, "replay_seconds": 240,
+          "scratch_bytes": 2 << 30, "retained_bytes": 64 << 20,
+          "key_rows": 20000, "builds": 2, "replays": 2, "engine_calls": 0}
+
+
+def files() -> dict:
+    raw = dense.read(EVIDENCE / "candidate-preservation-tighnari-v2-result.json")
+    if scope.sha(raw) != dense.RESULT_SHA:
+        raise ValueError("preparation_parent_result_drift")
+    out = {}
+    for item in json.loads(raw)["export_receipts"]:
+        data = dense.read(Path(item["path"]))
+        if scope.sha(data) != item["sha256"]:
+            raise ValueError("preparation_export_manifest_drift")
+        out.update(json.loads(data)["files"])
+    return out
+
+
+def archived(item: dict) -> bytes:
+    a = item["archive"]
+    packed = dense.read(Path(a["path"]))
+    raw = gzip.decompress(packed)
+    if (scope.sha(packed) != a["compressed_sha256"] or len(packed) != a["compressed_bytes"]
+            or scope.sha(raw) != a["raw_sha256"] or len(raw) != a["raw_bytes"]):
+        raise ValueError("preparation_archive_drift")
+    return raw
+
+
+def inputs() -> dict:
+    all_files = files()
+    names = ["candidate/request.json", "candidate/set-sources.json",
+             "candidate/verification/all-sets-result.json"]
+    captures = [n for n in all_files if n.startswith("candidate/verification/contexts/")
+                and n.endswith(("/config.txt", "/member.json", "/member.json.effects.json"))]
+    policy = [n for n in all_files if n.startswith("candidate/verification/adaptive-policy-runs/")
+              and n.endswith(("/config.txt", "/result.json"))]
+    if len(captures) != 6 or len(policy) != 56:
+        raise ValueError("preparation_saved_input_set")
+    selected = {n.removeprefix("candidate/"): all_files[n]["archive"] for n in sorted(names + captures + policy)}
+    request = json.loads(archived(all_files[names[0]]))
+    output = json.loads(archived(all_files[names[2]]))
+    if (len(request["artifacts"]) != 597 or request["engine"]["artifact_sha256"] != scope.ENGINE_SHA
+            or output["adaptive_policy"]["calls"] != 28
+            or len(output["adaptive_policy"]["samples"]) != 28
+            or output["search_expansions"] != 291346 or len(output["search_work"]) != 161):
+        raise ValueError("preparation_saved_scope")
+    for sample in output["adaptive_policy"]["samples"]:
+        if any(not isinstance(sample.get(k), (int, float)) or not math.isfinite(sample[k]) or sample[k] <= 0
+               for k in ("elapsed_ms", "engine_elapsed_ms")) or sample.get("error") or sample.get("validation_error"):
+            raise ValueError("preparation_saved_policy_duration_or_error")
+    # Eager identity admission includes all policy responses; no numerical run.
+    for name in policy:
+        archived(all_files[name])
+    return {"files": selected, "search_config": output["search_config"],
+        "policy_samples": output["adaptive_policy"]["samples"],
+        "parent_proposal_seconds": output["proposal_seconds"],
+        "parent_search_seconds": output["search_seconds"],
+        "parent_output_sha256": selected["verification/all-sets-result.json"]["raw_sha256"]}
+
+
+def patch_source(raw: bytes, changes: list[tuple[str, str]]) -> bytes:
+    source = raw.decode()
+    for before, after in changes:
+        if source.count(before) != 1:
+            raise ValueError("preparation_hook_anchor:" + before[:80])
+        source = source.replace(before, after, 1)
+    erased = source
+    for before, after in reversed(changes):
+        if erased.count(after) != 1:
+            raise ValueError("preparation_hook_inverse")
+        erased = erased.replace(after, before, 1)
+    if erased.encode() != raw:
+        raise ValueError("preparation_erasure_failed")
+    return source.encode()
+
+
+def overlay(instrumented: bool) -> dict:
+    images = dense.base_images()
+    # Baseline is the exact accepted core that produced the V2 preparation work.
+    # AH changes decoder representation only; replay starts from decoded inputs.
+    common = {"internal/allsets/adaptive_hybrid.go": [
+        ("result, runErr := p.engine.RunOrdinarySeeded(callCtx, prepared.Text, runDirectory, int64(seed))",
+         "result, savedWallMS, runErr := preparationSavedPolicy(callCtx, candidate, prepared.Text, runDirectory, seed, p.block, p.Calls)"),
+        ("wallMS := float64(time.Since(started)) / float64(time.Millisecond)",
+         "_ = started // logical policy budget is restored from the archived call; no new engine wall measurement\n\t\twallMS := savedWallMS"),
+    ],
+    "internal/engineclient/ordinary.go": [
+        ("func (bound BoundEngine) runOrdinary(ctx context.Context, configText, runDirectory string, expectedIterations, workers int, seed int64) (OrdinaryResult, error) {",
+         "func (bound BoundEngine) runOrdinary(ctx context.Context, configText, runDirectory string, expectedIterations, workers int, seed int64) (OrdinaryResult, error) {\n\tpanic(\"fresh engine execution forbidden by saved preparation packet\")"),
+    ],
+    "internal/engineclient/compact.go": [
+        ("func (bound BoundEngine) runCompact(ctx context.Context, configText, runDirectory string, seed uint64, ignoreBurstEnergy, includeEffects bool) (CompactResult, error) {",
+         "func (bound BoundEngine) runCompact(ctx context.Context, configText, runDirectory string, seed uint64, ignoreBurstEnergy, includeEffects bool) (CompactResult, error) {\n\tpanic(\"fresh compact execution forbidden by saved preparation packet\")"),
+    ]}
+    for name, changes in common.items():
+        images[name] = patch_source(images[name], changes)
+    if instrumented:
+        name = "internal/allsets/neutral_coordinator.go"
+        changes = [
+            ('\t"genshinteamstracker/native/gcsim_optimizer/internal/domain"', '\t"genshinteamstracker/native/gcsim_optimizer/internal/domain"\n\t"runtime/pprof"'),
+            ("\t\t\tproposalStarted = time.Now()", "\t\t\tpprof.SetGoroutineLabels(pprof.WithLabels(runCtx, pprof.Labels(\"phase\", \"proposal_preparation\")))\n\t\t\tpreparationObserver.begin(cycle+1, actor)\n\t\t\tproposalStarted = time.Now()"),
+            ("\t\t\tproposalStarted = time.Time{}", "\t\t\tproposalStarted = time.Time{}\n\t\t\tpreparationObserver.end()\n\t\t\tpprof.SetGoroutineLabels(runCtx)"),
+            ("\tbind := func(packs [4]domain.Package, seed domain.Assignment, lane string) (Candidate, bool, error) {", "\tbind := func(packs [4]domain.Package, seed domain.Assignment, lane string) (Candidate, bool, error) {\n\t\tdefer preparationObserver.interval(\"bind_inclusive\")()"),
+            ("\t\tdps, err = panel.EvaluateDPS(dense)", "\t\tstopProbe := preparationObserver.interval(\"bind_full_score\")\n\t\tdps, err = panel.EvaluateDPS(dense)\n\t\tstopProbe()"),
+            ("\tsolverFor := func(c Candidate) (*search.Engine, error) {", "\tsolverFor := func(c Candidate) (*search.Engine, error) {\n\t\tdefer preparationObserver.interval(\"solver_construction\")()"),
+            ("\t\treturn solver, e\n\t}\n\tcandidateMemo :=", "\t\tif e == nil { preparationObserver.solver(solver, c) }\n\t\treturn solver, e\n\t}\n\tcandidateMemo :="),
+            ("\t\tkey := neutralCandidateSearchKey(index, c, cfg.Search, actor, allowance, refine)", "\t\tkey := neutralCandidateSearchKey(index, c, cfg.Search, actor, allowance, refine)\n\t\tprobeStarted := time.Now()\n\t\tprobeReused := false\n\t\tdefer func() { preparationObserver.key(key, c.Context.ConfigSHA256(), time.Since(probeStarted).Nanoseconds(), probeReused) }()"),
+            ("\t\tif len(out.NeutralCycles) > 0 {", "\t\tprobeReused = reused\n\t\tif len(out.NeutralCycles) > 0 {"),
+            ("\t\tseed, e := anchor.Index.PackageSeed(anchor.Score.Assignment, actor, pack, nil)", "\t\tseedStop := preparationObserver.interval(\"package_seed_legal\")\n\t\tseedClosed := false\n\t\tdefer func() { if !seedClosed { seedStop() } }()\n\t\tseed, e := anchor.Index.PackageSeed(anchor.Score.Assignment, actor, pack, nil)"),
+            ("\t\tc, ok, e := bind(packs, seed, \"neutral_package_seed\")", "\t\tseedStop(); seedClosed = true\n\t\tc, ok, e := bind(packs, seed, \"neutral_package_seed\")"),
+            ("\t\tc.Index, e = c.Index.ForPackages(c.Packages, c.Score.Assignment, p.Coordinates())", "\t\tviewStop := preparationObserver.interval(\"post_screen_view\")\n\t\tc.Index, e = c.Index.ForPackages(c.Packages, c.Score.Assignment, p.Coordinates())\n\t\tviewStop()"),
+            ("\t\t\t\tearlyPlan, err = adaptivePolicy.early.block(runCtx, anchor, cycle+1, actor, feasible)", "\t\t\t\tearlyStop := preparationObserver.interval(\"early_utility_inclusive\")\n\t\t\t\tearlyPlan, err = adaptivePolicy.early.block(runCtx, anchor, cycle+1, actor, feasible)\n\t\t\t\tearlyStop()"),
+        ]
+        images[name] = patch_source(images[name], changes)
+        name = "internal/search/candidates.go"
+        images[name] = patch_source(images[name], [
+            ("func (engine *Engine) candidateRun(ctx context.Context, anchor domain.Assignment, actor, allowance int) (*candidateRun, error) {", "func (engine *Engine) candidateRun(ctx context.Context, anchor domain.Assignment, actor, allowance int) (*candidateRun, error) {\n\tprobeStart := time.Now()\n\tdefer func() { if ResearchPreparationSetup != nil { ResearchPreparationSetup(time.Since(probeStart).Nanoseconds()) } }()"),
+        ])
+        name = "internal/search/fgbs.go"
+        images[name] = patch_source(images[name], [
+            ('\t"sort"', '\t"sort"\n\t"time"'),
+            ("func (engine *Engine) score(assignment domain.Assignment) (float64, error) {", "func (engine *Engine) score(assignment domain.Assignment) (float64, error) {\n\tprobeStart := time.Now()\n\tdefer func() { if ResearchPreparationFullScore != nil { ResearchPreparationFullScore(time.Since(probeStart).Nanoseconds()) } }()"),
+        ])
+    extras = {"internal/allsets/zz_preparation_v2_measure_test.go": HELPER.read_bytes()}
+    extras["internal/search/zz_preparation_v2_observer.go"] = b"package search\nvar ResearchPreparationSetup func(int64)\nvar ResearchPreparationFullScore func(int64)\n"
+    extras["internal/engineclient/zz_preparation_v2_identity.go"] = b"package engineclient\n\n// Test-overlay-only access to the accepted owning validator.\nfunc PreparationSavedIdentity(result OrdinaryResult, config string) (ConfigIdentityDiagnostics, error) {\n return validateOrdinaryResultIdentity(result, config, 1, 1)\n}\n"
+    return {"images": images, "extras": extras,
+        "image_map_sha256": scope.sha(dense.canonical(dense.image_hashes(images))),
+        "extra_map_sha256": scope.sha(dense.canonical(dense.image_hashes(extras)))}
