+    "not_required", "unprobed_insufficient_seeds", "unprobed_zero_plan", "failed",
+    "unprobed_seeded_ordinary_unavailable", "completed_proposal_only",
+    "no_observed_gap_not_completeness", "unprobed_fast_mode", "unprobed_user_finish",
+    "unprobed_exact_finalist_limit", "partial_user_finish", "not_in_legacy_control_protocol",
+))
+_ISSUES = frozenset((
+    "unknown_field", "invalid_object", "invalid_array", "array_truncated", "map_truncated",
+    "invalid_hash", "invalid_actor", "invalid_seed", "duplicate_seed", "sample_seed_mismatch",
+    "invalid_number", "invalid_integer", "counter_outside_native_bound", "invalid_boolean",
+    "invalid_enum", "unexpected_iterations", "sample_count_outside_panel", "invalid_projection_flags",
+))
+
+
+def project_support_response(value: Any) -> dict[str, Any]:
+    """Accept a native check or its enclosing receipt; return only safe JSON.
+
+    Missing/invalid values are None, never invented zero/false/paired samples.
+    Collection bounds are applied before visiting entries. Reprojection retains
+    earlier warning flags, including truncation no longer visible in the rows.
+    This is an evidence exporter, not a replacement for native binding checks.
+    """
+    flags = {"unknown": False, "malformed": False, "truncated": False}
+    issues: set[str] = set()
+
+    def note(kind, code):
+        flags[kind] = True
+        issues.add(code)
+
+    def unknown():
+        note("unknown", "unknown_field")
+        return None
+
+    def obj(raw):
+        if raw is None:
+            return unknown()
+        if type(raw) is not dict:
+            note("malformed", "invalid_object")
+            return None
+        return raw
+
+    def rows(raw, limit, project):
+        if raw is None:
+            return unknown()
+        if type(raw) is not list:
+            note("malformed", "invalid_array")
+            return None
+        if len(raw) > limit:
+            note("truncated", "array_truncated")
+        return [project(row) for row in raw[:limit]]
+
+    def integer(raw, minimum=0):
+        if raw is None:
+            return unknown()
+        if type(raw) is not int or not minimum <= raw <= _MAX_INT64:
+            note("malformed", "invalid_integer")
+            return None
+        return raw
+
+    def counter(raw):
+        result = integer(raw)
+        if result is not None and result > MAX_CALLS:
+            note("malformed", "counter_outside_native_bound")
+        return result  # Retain an actual out-of-policy count for inspection.
+
+    def number(raw, signed=False):
+        if raw is None:
+            return unknown()
+        try:
+            valid = type(raw) in (int, float) and math.isfinite(raw) and (signed or raw >= 0)
+        except OverflowError:
+            valid = False
+        if not valid:
+            note("malformed", "invalid_number")
+            return None
+        return raw
+
+    def boolean(raw):
+        if raw is None:
+            return unknown()
+        if type(raw) is not bool:
+            note("malformed", "invalid_boolean")
+            return None
+        return raw
+
+    def digest(raw):
+        if raw is None or raw == "":
+            return unknown()
+        if type(raw) is not str or len(raw) != 64 or _SHA.fullmatch(raw) is None:
+            note("malformed", "invalid_hash")
+            return None
+        return raw
+
+    def actor(raw):
+        if raw is None:
+            return unknown()
+        if type(raw) is not str or len(raw) > 64 or _ACTOR.fullmatch(raw) is None:
+            note("malformed", "invalid_actor")
+            return None
+        return raw
+
+    def enum(raw, allowed):
+        if raw is None or raw == "":
+            return unknown()
+        if type(raw) is not str or len(raw) > 80 or raw not in allowed:
+            note("malformed", "invalid_enum")
+            return None
+        return raw
+
+    def seed_text(raw):
+        if raw is None:
+            return unknown()
+        if type(raw) is not str or len(raw) > 19 or _SEED.fullmatch(raw) is None or int(raw) > _MAX_INT64:
+            note("malformed", "invalid_seed")
+            return None
+        return raw
+
+    def seeds(raw):
+        result = rows(raw, MAX_SAMPLES, lambda item: integer(item, 1))
+        if result is not None and len({item for item in result if item is not None}) < sum(item is not None for item in result):
+            note("malformed", "duplicate_seed")
+        return result
+
+    def bounded_map(raw, limit, key_parser, value_parser):
+        source = obj(raw)
+        if source is None:
+            return None
+        if len(source) > limit:
+            note("truncated", "map_truncated")
+        result = {}
+        for key, item in islice(source.items(), limit):
+            parsed_key = key_parser(key)
+            if parsed_key is not None:
+                result[parsed_key] = value_parser(item)
+        return result
+
+    def actor_values(raw, signed=False):
+        return bounded_map(raw, MAX_ACTORS, actor, lambda item: number(item, signed))
+
+    def binding(raw):
+        source = obj(raw)
+        return {key: digest(source.get(key)) for key in _BINDING_KEYS} if source is not None else None
+
+    def sample(raw):
+        source = obj(raw)
+        if source is None:
+            return None
+        result = {key: number(source.get(key)) for key in (
+            "dps", "standard_deviation", "standard_error", "elapsed_ms", "insufficient_energy_max",
+        )}
+        result.update(seed=integer(source.get("seed"), 1), sample_seed=seed_text(source.get("sample_seed")),
+                      iterations=integer(source.get("iterations"), 1),
+                      dps_delta=number(source.get("dps_delta"), True),
+                      character_dps=actor_values(source.get("character_dps")),
+                      character_dps_delta=actor_values(source.get("character_dps_delta"), True),
+                      config_sha256=digest(source.get("config_sha256")),
+                      engine_result_sha256=digest(source.get("engine_result_sha256")))
+        if result["iterations"] is not None and result["iterations"] != 1:
+            note("malformed", "unexpected_iterations")
+        if result["seed"] is not None and result["sample_seed"] is not None and str(result["seed"]) != result["sample_seed"]:
+            note("malformed", "sample_seed_mismatch")
+        return result
+
+    def perturbation(raw):
+        source = obj(raw)
+        return ({"actor": actor(source.get("actor")), "stat": enum(source.get("stat"), _RAW_STATS),
+                 "delta": number(source.get("delta"), True)} if source is not None else None)
+
+    def perturbation_result(raw):
+        source = obj(raw)
+        return ({"perturbation": perturbation(source.get("perturbation")),
+                 "config_sha256": digest(source.get("config_sha256")),
+                 "samples": rows(source.get("samples"), MAX_SAMPLES, sample),
+                 "mean_dps_delta": number(source.get("mean_dps_delta"), True),
+                 "mean_character_dps_delta": actor_values(source.get("mean_character_dps_delta"), True),
+                 "second_seed_screened": boolean(source.get("second_seed_screened"))} if source is not None else None)
+
+    def direction(raw):
+        source = obj(raw)
+        if source is None:
+            return None
+        result = {key: number(source.get(key), True) for key in (
+            "amount", "mean_dps_change", "minimum_dps_change", "maximum_dps_change",
+            "mean_other_dps_change", "minimum_other_dps_change",
+        )}
+        result.update(binding=binding(source.get("binding")), owner=actor(source.get("owner")),
+                      stat=enum(source.get("stat"), _DIRECTION_STATS),
+                      status=enum(source.get("status"), _DIRECTION_STATUSES),
+                      config_sha256=digest(source.get("config_sha256")),
+                      sample_count=integer(source.get("sample_count")),
+                      seed_dps_changes=bounded_map(source.get("seed_dps_changes"), MAX_SAMPLES, seed_text, lambda item: number(item, True)),
+                      result_sha256_by_seed=bounded_map(source.get("result_sha256_by_seed"), MAX_SAMPLES, seed_text, digest))
+        if result["sample_count"] is not None and result["sample_count"] > MAX_SAMPLES:
+            note("malformed", "sample_count_outside_panel")
+        return result
+
+    source = obj(value)
+    source = source if source is not None else {}
+    previous = source.get("projection") if source.get("schema_kind") == SCHEMA_KIND else None
+    if previous is not None:
+        if type(previous) is dict:
+            for key in flags:
+                if type(previous.get(key)) is bool:
+                    flags[key] |= previous[key]
+                else:
+                    note("malformed", "invalid_projection_flags")
+            old_issues = previous.get("issues")
+            if type(old_issues) is list:
+                if len(old_issues) > len(_ISSUES):
+                    note("truncated", "array_truncated")
+                for code in old_issues[:len(_ISSUES)]:
+                    if type(code) is str and code in _ISSUES:
+                        issues.add(code)
+                    else:
+                        note("malformed", "invalid_projection_flags")
+            else:
+                note("malformed", "invalid_projection_flags")
+        else:
+            note("malformed", "invalid_projection_flags")
+    wrapper_status = source.get("wrapper_status")
+    if "check" in source:
+        wrapper_status = source.get("status")
+        source = obj(source["check"])
+        source = source if source is not None else {}
+    evidence = obj(source.get("evidence"))
+    projected_evidence = None
+    if evidence is not None:
+        projected_evidence = {key: counter(evidence.get(key)) for key in ("call_limit", "attempted_calls", "skipped_calls")}
+        projected_evidence.update({key: boolean(evidence.get(key)) for key in ("screening_enabled", "engine_unchanged", "proposal_evidence_only")})
+        projected_evidence.update(binding=binding(evidence.get("binding")),
+                                  prepared_config_sha256=digest(evidence.get("prepared_config_sha256")),
+                                  probe_config_sha256=digest(evidence.get("probe_config_sha256")),
+                                  baseline=rows(evidence.get("baseline"), MAX_SAMPLES, sample),
+                                  perturbations=rows(evidence.get("perturbations"), MAX_PERTURBATIONS, perturbation_result))
+    response_plan = obj(source.get("plan"))
+    projected_plan = None
+    if response_plan is not None:
+        plan = obj(response_plan.get("plan"))
+        projected_plan = {"required": boolean(response_plan.get("required")), "plan": None}
+        if plan is not None:
+            projected_plan["plan"] = {"request_sha256": digest(plan.get("request_sha256")),
+                                      "seeds": seeds(plan.get("seeds")), "call_limit": counter(plan.get("call_limit")),
+                                      "screen_zero_first_seed": boolean(plan.get("screen_zero_first_seed")),
+                                      "perturbations": rows(plan.get("perturbations"), MAX_PERTURBATIONS, perturbation)}
+    result = {"schema_kind": SCHEMA_KIND,
+              "scope": "local_proposal_observations_not_finalist_verification_or_global_caps",
+              "status": enum(source.get("status"), _STATUSES),
+              "wrapper_status": enum(wrapper_status, _STATUSES) if wrapper_status is not None else None,
+              "elapsed_ms": number(source.get("elapsed_ms")), "binding": binding(source.get("binding")),
+              "selected_seeds": seeds(source.get("selected_seeds")), "plan": projected_plan,
+              "evidence": projected_evidence, "directions": rows(source.get("directions"), MAX_PERTURBATIONS, direction)}
+    result["projection"] = {**flags, "issues": sorted(issues)}
+    return result
