+def sink_state(sink):
+    fields = ("prepared", "request", "binding", "capsule", "retention", "arms", "pending_arms",
+              "pending_originals", "original_pins", "planned_files", "created_files",
+              "directory_created", "directory_identity", "ownership")
+    return {"schema_kind": "gtt_main_navia_private_sink_state_v1", "owner": OWNER,
+        "protocol_sha256": sink.protocol_sha256, "created_utc": sink.created.isoformat(),
+        "expires_utc": sink.expires.isoformat(), "export": str(sink.export),
+        "job": str(sink.job) if sink.job is not None else None,
+        "record": sink.record, "fields": {key: getattr(sink, key) for key in fields}}
