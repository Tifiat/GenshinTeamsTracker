+"""Matched exact-reuse base, opt-in early admission and post-search quality."""
+from pathlib import Path
+from tools.experiments.gcsim.mvp_polish import early_preparation_admission as candidate
+from tools.experiments.gcsim.mvp_polish import preparation_exact_reuse_replay as previous
+
+k = previous.k
+QUALITY_HELPER = Path(__file__).with_name("early_preparation_quality_test.go")
+SOURCE_FILES = tuple(dict.fromkeys((*previous.SOURCE_FILES, Path(candidate.__file__),
+                                  candidate.HELPER, Path(__file__), QUALITY_HELPER)))
+
+
+def _verification(raw):
+    text = raw.decode()
+    restores = []
+    replace = previous.patching._replace_once
+    text = replace(text,
+        'checked,err:=finalists.VerifyWithRenderer(ctx,req,scores,render,filepath.Join(job,role+"-final"),500,4,4,observer)',
+        'checked,err:=researchEarlyQualityVerify(ctx,req,scores,render,filepath.Join(job,role+"-final"),job,observer)', restores)
+    text = replace(text,
+        'if attempted!=9||len(checked.Candidates)!=9{err=fmt.Errorf("nine final measurements were not completed")}',
+        'if researchEarlyQualityEvidence["control_cohort_mismatch"]!=true && (attempted>9||len(checked.Candidates)!=9){err=fmt.Errorf("nine final measurements were not resolved")}', restores)
+    text = replace(text,
+        'if researchHybrid!=nil {\n  if unchanged:=researchHybrid.VerifyUnchanged();unchanged!=nil&&err==nil{err=unchanged}',
+        'out["quality_evidence"]=researchEarlyQualityEvidence\n if researchHybrid!=nil {\n  if unchanged:=researchHybrid.VerifyUnchanged();unchanged!=nil&&err==nil{err=unchanged}', restores)
+    if previous.patching._erase(text, restores).encode() != raw:
+        raise ValueError("early quality verification erasure failed")
+    return text.encode()
+
+
+def _replay(raw):
+    text = raw.decode()
+    restores = []
+    replace = previous.patching._replace_once
+    text = replace(text, 'researchPreparationExactReuseEnabled = arm == "candidate"',
+        'researchPreparationExactReuseEnabled = true\n    if err := researchEarlyPreparationAdmissionBegin(job, arm == "candidate"); err != nil { t.Fatal(err) }', restores)
+    text = replace(text, 't.Cleanup(func() { researchPreparationExactReuseEnabled = false; researchEWholeProfile = nil })',
+        't.Cleanup(func() { researchEarlyPreparationAdmissionEnabled = false; researchPreparationExactReuseEnabled = false; researchEWholeProfile = nil })', restores)
+    text = replace(text, 'payload["experiment_arm"] = arm',
+        'payload["experiment_arm"] = arm\n    if err := researchEarlyPreparationAdmissionFlush(); err != nil { t.Fatal(err) }\n    payload["early_preparation_admission"] = researchEarlyPreparationAdmissionSummary()', restores)
+    text = replace(text, 'ctx, cancel := context.WithTimeout(t.Context(), 420*time.Second)',
+        'phaseDeadline, hasPhaseDeadline := t.Deadline()\n    if !hasPhaseDeadline { t.Fatal("early replay deadline required") }\n    ctx, cancel := context.WithDeadline(t.Context(), phaseDeadline.Add(-15*time.Second))', restores)
+    text = replace(text, '''    payload["final_verification_seconds"] = 0.0
+    payload["verification"] = map[string]any{"disabled_for_profile":true, "result":map[string]any{"candidates":[]any{}}}
+''', '''    if runErr==nil && ctx.Err()==nil {
+      verifyStarted:=time.Now()
+      verified,verifyErr:=adaptiveVerify(t,ctx,req,base,result,job,role)
+      payload["final_verification_seconds"]=time.Since(verifyStarted).Seconds()
+      payload["verification"]=verified
+      if verifyErr!=nil { payload["verification_failure"]=verifyErr.Error(); payload["complete"]=false;runErr=verifyErr }
+    }
+''', restores)
+    if previous.patching._erase(text, restores).encode() != raw:
+        raise ValueError("early admission replay erasure failed")
+    return text.encode()
+
+
+def matched_overlay():
+    base = candidate.early_preparation_admission_overlay()
+    images, overlays = dict(base["images"]), dict(base["overlay_files"])
+    path = "internal/allsets/zz_adaptive_replay_test.go"
+    overlays[path] = _replay(overlays[path])
+    path = "internal/allsets/zz_adaptive_verification_test.go"
+    if path not in overlays:
+        raise ValueError("existing adaptive ordinary verifier overlay missing")
+    overlays[path] = _verification(overlays[path])
+    overlays["internal/allsets/zz_early_preparation_quality_test.go"] = QUALITY_HELPER.read_bytes()
+    hashes = dict(base["hashes"])
+    hashes.update(early_admission_matched_source_map_sha256=k.gate.digest({p:k.sha(v) for p,v in images.items()}),
+                  early_admission_matched_overlay_sha256=k.gate.digest({p:k.sha(v) for p,v in overlays.items()}))
+    return {**base, "images":images, "overlay_files":overlays, "hashes":hashes,
+            "metadata":{"candidate":base["metadata"], "exact_reuse_both":True,
+                        "cpu_profile":False, "arm_order":["control","candidate"],
+                        "quality":"post-search pinned E n500 cohort reuse; <=9 new candidate configs; independent batches; no paired RNG claim",
+                        "control_cohort_mismatch":"quality not established; no automatic extension"},
+            "source_files":tuple(dict.fromkeys((*base["source_files"], *SOURCE_FILES)))}
diff --git a/tools/experiments/gcsim/mvp_polish/early_preparation_admission_run.py b/tools/experiments/gcsim/mvp_polish/early_preparation_admission_run.py
new file mode 100644
--- /dev/null
+++ b/tools/experiments/gcsim/mvp_polish/early_preparation_admission_run.py
@@ -0,0 +1,312 @@
+"""One finite matched early-admission packet with compact public receipts."""
+from __future__ import annotations
+import argparse
+import gzip
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+from tools.experiments.gcsim.mvp_polish import preparation_exact_reuse_run as previous
+from tools.experiments.gcsim.mvp_polish import early_preparation_admission_replay as producer
+
+k, checks, retained, staging = previous.k, previous.checks, previous.retained, previous.staging
+PREFIX = "early-preparation-admission-"
+LIMITS = {**previous.LIMITS, "final_n500":9, "final_n500_candidate_max":9, "final_n500_control":0,
+          "final_workers":4, "final_parallelism_max":4,
+          "new_ordinary_window_seconds_within_candidate_replay":90,"replay_export_margin_seconds":15,
+          "policy_plus_new_final_engine_calls_max":105}
+
+
+def historical_inputs():
+    return [k.EVIDENCE/f"final-pair-whole-final-{kind}-{i:02d}.gz"
+            for kind in ("config","result") for i in range(9)]
+
+
+def source_plan():
+    plan = previous.source_plan()
+    overlay = producer.matched_overlay()
+    pins = dict(plan["source_pins"])
+    for path in (*overlay["source_files"], Path(__file__), Path(__file__).with_name("test_early_preparation_admission_run.py"), *historical_inputs()):
+        pins[path.relative_to(k.ROOT).as_posix()] = k.sha(path.read_bytes())
+    names = plan["contract_names"] + list(producer.candidate.CONTRACT_NAMES) + ["TestAdaptiveHybridContractEarlyPreparationQualityReuse"]
+    if len(names)!=len(set(names)):raise ValueError("early duplicate contract")
+    commands = list(plan["commands"])
+    commands[1] = "<job>/preparation-reuse.exe -test.run=^("+"|".join(names)+")$ -test.v -test.parallel=1 -test.timeout=30s"
+    return {**plan,"schema":"early_preparation_admission_plan_v1","limits":LIMITS,
+            "source_pins":pins,"overlay_hashes":overlay["hashes"],"metadata":overlay["metadata"],
+            "contract_names":names,"commands":commands,
+            "comparison":"Matched exact-reuse control versus heuristic admission; output/membership/work changes, independent ordinary means/SE; no automatic quality equivalence.",
+            "quality":"Pinned E same-frame/config/20IDs/n500/workers4 reuse; at most9 new candidate configurations via product verifier; control mismatch means quality not established; no paired RNG assertion.",
+            "receipt":"Compact command/arm summaries and lossless separate exports; frozen plan stays in READY/freeze, never duplicated into result.",
+            "execution_grant_required":"one_early_preparation_admission_packet"}
+
+
+def stage_ordinary_reuse(job):
+    old=json.loads(gzip.decompress((k.EVIDENCE/"final-pair-whole-candidate-projection.json.gz").read_bytes()))
+    by_config={r["config_sha256"]:r for r in old["verification"]["result"]["candidates"]}
+    entries=[]
+    root=job/"ordinary-reuse";root.mkdir()
+    for i in range(9):
+        config=gzip.decompress((k.EVIDENCE/f"final-pair-whole-final-config-{i:02d}.gz").read_bytes())
+        result=gzip.decompress((k.EVIDENCE/f"final-pair-whole-final-result-{i:02d}.gz").read_bytes())
+        row=by_config[k.sha(config)]
+        if k.sha(result)!=row["engine_result_sha256"] or row["iterations"]!=500:
+            raise ValueError("early historical tuple mismatch")
+        cp,rp=root/f"config-{i:02d}.txt",root/f"result-{i:02d}.json"
+        cp.write_bytes(config);rp.write_bytes(result)
+        entries.append({"config_path":str(cp),"result_path":str(rp),"measurement":row})
+    request=k.RUN/"request.json"
+    source_bundle=json.loads((k.RUN/"set-sources.json").read_bytes())
+    manifest={"request_path":str(request),"request_sha256":k.sha(request.read_bytes()),
+              "catalog_sha256":source_bundle["catalog_sha256"],"entries":entries}
+    (job/"ordinary-reuse.json").write_text(json.dumps(manifest),encoding="utf-8")
+
+
+def export_arm(job, arm, record):
+    root=job/arm
+    if not root.is_dir():return
+    files=[p for p in root.iterdir() if p.is_file()]
+    for folder in (root/"adaptive-policy-runs",root/"candidate-final"):
+        if folder.is_dir():files += [p for p in folder.rglob("*") if p.is_file() and p.name in ("config.txt","result.json")]
+    exports={}
+    for path in sorted(files):
+        relative=path.relative_to(root).as_posix()
+        target=k.EVIDENCE/(PREFIX+arm+"-"+relative.replace("/","__")+".gz")
+        exports[relative]=retained._write_gzip_once(checks.read_bounded(path),target)
+    record["exports"]=exports
+
+
+def validate_arm(job, arm):
+    root=job/arm
+    p=json.loads(checks.read_bounded(root/"candidate-projection.json"))
+    if not p.get("complete") or p.get("provider_calls")!=1 or p.get("experiment_arm")!=arm or p.get("cpu_profiler_started") is not False:
+        raise ValueError("early replay incomplete")
+    if p["performance"].get("PreparedPayloadProgramHits",0)<=0:
+        raise ValueError("early exact reuse not active in both arms")
+    policy=p["policy"];calls=policy.get("calls")
+    if type(calls) is not int or not 0<=calls<=48 or retained._policy_sample_count(policy)!=calls:
+        raise ValueError("early policy budget")
+    temporary={}
+    checks.validate_policy_artifacts(root,policy,temporary)
+    retained._validate_damped_screening(root,p,temporary)
+    retained._validate_final_pair_whole(root,p,temporary)
+    checks.validate_wall(p["wall_profile"],p["run_neutral_seconds"])
+    if list(job.rglob("*.pprof")):raise ValueError("early unexpected profile")
+    secondary=[e for e in policy["events"] if e.get("type")=="secondary_refinement_started"]
+    if len(secondary)>8 or len({e["block"] for e in secondary})!=len(secondary):raise ValueError("early secondary budget")
+    validate_quality(root,arm,p)
+    validate_admission(root,arm,p)
+    return p
+
+
+def validate_quality(root,arm,p):
+    verification=p["verification"];evidence=verification["quality_evidence"]
+    if evidence["paired_rng_claim"] is not False or evidence["independent_batches"] is not True:
+        raise ValueError("early ordinary RNG semantics")
+    fresh=evidence["fresh_attempts"];completed=evidence["fresh_completed"]
+    if type(fresh) is not int or not 0<=fresh<=9 or fresh!=completed or (arm=="control" and fresh):
+        raise ValueError("early fresh ordinary budget")
+    if evidence.get("control_cohort_mismatch"):
+        if arm!="control" or evidence.get("quality_established") is not False:raise ValueError("early control quality gap")
+        return
+    rows=verification["result"]["candidates"]
+    if len(rows)!=9 or len({json.dumps(r["assignment"]) for r in rows})!=9 or len(evidence["historical_reused"])+fresh!=9:
+        raise ValueError("early ordinary panel reconciliation")
+    for row in rows:
+        if row["iterations"]!=500 or any(not math.isfinite(row[f]) or row[f]<0 for f in ("measured_dps","standard_deviation","standard_error")):
+            raise ValueError("early ordinary statistics")
+    # Product ordinary result parser already binds fresh config/wire/n/workers;
+    # actual raw files and the attempted/measured ledger remain lossless exports.
+    ledger=[json.loads(line) for line in (root/"candidate-final-ledger.jsonl").read_bytes().splitlines()]
+    if sum(r["phase"]=="attempted_before_runner" for r in ledger)!=fresh or sum(r["phase"]=="measured" for r in ledger)!=completed:
+        raise ValueError("early ordinary ledger counts")
+    reused={r["config_sha256"]:r for r in evidence["historical_reused"]}
+    old=json.loads(gzip.decompress((k.EVIDENCE/"final-pair-whole-candidate-projection.json.gz").read_bytes()))
+    old_rows={r["config_sha256"]:r for r in old["verification"]["result"]["candidates"]}
+    actual={}
+    for path in (root/"candidate-final").rglob("result.json") if (root/"candidate-final").is_dir() else []:
+        config=checks.read_bounded(path.with_name("config.txt"));raw=checks.read_bounded(path)
+        parsed=json.loads(raw);pair=(k.sha(config),k.sha(raw))
+        if pair in actual:raise ValueError("early duplicate fresh tuple")
+        if parsed["statistics"]["iterations"]!=500 or parsed["simulator_settings"]["number_of_workers"]!=4 or parsed["config_file"]!=config.decode()+"\n":
+            raise ValueError("early fresh ordinary wire/settings")
+        actual[pair]=parsed["statistics"]["dps"]
+    if len(actual)!=fresh:raise ValueError("early fresh raw tuple count")
+    for row in rows:
+        retained.diagnostic._assignment(row["assignment"])
+        if row["config_sha256"] in reused:
+            old_row=old_rows[row["config_sha256"]]
+            if any(row[key]!=old_row[key] for key in ("assignment","measured_dps","standard_deviation","standard_error","engine_result_sha256")):
+                raise ValueError("early historical measurement changed")
+        else:
+            dps=actual[(row["config_sha256"],row["engine_result_sha256"])]
+            if row["measured_dps"]!=dps["mean"] or row["standard_deviation"]!=dps["sd"] or row["standard_error"]!=dps["sd"]/math.sqrt(500):
+                raise ValueError("early fresh scalar/raw mismatch")
+
+
+def validate_admission(root,arm,p):
+    summary=p["early_preparation_admission"];path=root/"early-preparation-admission.jsonl"
+    if summary.get("schema")!="early_preparation_admission_v1" or summary.get("enabled")!=(arm=="candidate"):
+        raise ValueError("early selector arm identity")
+    if arm=="control":
+        if path.exists():raise ValueError("early disabled selector produced ledger")
+        return
+    raw=checks.read_bounded(path)
+    rows=[json.loads(line) for line in raw.splitlines() if line]
+    if summary.get("ledger_sha256")!=k.sha(raw) or summary.get("ledger_rows")!=len(rows) or summary.get("status")!="complete":
+        raise ValueError("early ledger hash/count/completion")
+    expected_total=sum(c["Total"] for c in p["projection"]["neutral_cycles"])
+    if len(rows)!=expected_total:raise ValueError("early full feasible catalog not accounted")
+    blocks=summary["blocks"]
+    if len(blocks)!=8 or {(b["cycle"],b["actor"]) for b in blocks}!={(cycle,actor) for cycle in (1,2) for actor in range(4)}:
+        raise ValueError("early block coverage")
+    identities=set();attempts=prepared=deferred=0
+    for b in blocks:
+        group=[r for r in rows if (r["cycle"],r["actor"])==(b["cycle"],b["actor"])]
+        if len(group)!=b["feasible_packages"] or len({json.dumps(r["anchor_assignment"]) for r in group})!=1:
+            raise ValueError("early block catalog/anchor")
+        for r in group:
+            identity=(r["cycle"],r["actor"],r["package_key"])
+            if identity in identities:raise ValueError("early duplicate package decision")
+            identities.add(identity)
+            mandatory=r["category"]!="two_plus_two" or bool(r["priority_error"]) or "current_package_mandatory" in r["reasons"]
+            if mandatory and not r["initial_admitted"]:raise ValueError("early mandatory route lost")
+            if not r["prepare_attempted"]:
+                if r["decision"]!="early_preparation_heuristic_deferred" or r["preparation_status"]!="not_prepared_unknown" or r["candidate_formula_dps"] is not None:
+                    raise ValueError("early deferred outcome falsely known")
+            attempts+=r["prepare_attempted"]
+            prepared+=r["preparation_status"]=="prepared"
+            deferred+=r["decision"]=="early_preparation_heuristic_deferred"
+        if sum(r["prepare_attempted"] for r in group)!=b["prepare_attempts"] or sum(r["initial_admitted"] for r in group)!=b["initially_admitted_packages"]:
+            raise ValueError("early block admission counts")
+        ranked=sorted([r for r in group if r["rank"] is not None],key=lambda r:r["rank"])
+        if [r["rank"] for r in ranked]!=list(range(1,len(ranked)+1)) or ranked!=sorted(ranked,key=lambda r:(-r["proxy_priority"],r["package_key"])):
+            raise ValueError("early proxy ordering")
+        if any(not r["initial_admitted"] for r in ranked[:math.ceil(b["two_plus_two_packages"]/4)]):raise ValueError("early top quartile lost")
+        if not b["exact_admitted_gain"] and not b["fail_closed_reason"] and any(not r["prepare_attempted"] for r in group):
+            raise ValueError("early no-gain tail not rescued")
+        if b["selector_seconds"]<0 or b["package_priority_dp_calls"]>b["two_plus_two_packages"]:
+            raise ValueError("early selector accounting")
+    if attempts!=summary["prepare_attempts"] or prepared!=summary["prepared"] or deferred!=summary["heuristic_deferred"]:
+        raise ValueError("early aggregate counters")
+    if prepared!=sum(c["Queued"] for c in p["projection"]["neutral_cycles"]):raise ValueError("early prepared/queue join")
+
+
+def compact_arm(p):
+    return {key:p[key] for key in ("run_neutral_seconds","setup_seconds","final_verification_seconds",
+            "wall_profile","search_metrics","performance","early_preparation_admission")}|{
+        "policy_calls":p["policy"]["calls"],"quality_evidence":p["verification"]["quality_evidence"],
+        "semantic_projection_sha256":k.gate.digest(k.gate.semantic(p["projection"]))}
+
+
+def compare(control,candidate):
+    out={"control_search_seconds":control["run_neutral_seconds"],"candidate_search_seconds":candidate["run_neutral_seconds"],
+         "search_change_percent":100*(candidate["run_neutral_seconds"]/control["run_neutral_seconds"]-1),
+         "search_metrics":{"control":control["search_metrics"],"candidate":candidate["search_metrics"]},
+         "same_ordered_output_work_score_bits":k.gate.semantic(control["projection"])==k.gate.semantic(candidate["projection"]),
+         "formula_leaders":{arm:p["projection"]["leader"] for arm,p in (("control",control),("candidate",candidate))},
+         "policy_equal_except_timing":k.gate.semantic(control["policy"])==k.gate.semantic(candidate["policy"]),
+         "ordinary_batches":"independent; historical winner selection bias; overlapping intervals do not prove no loss",
+         "speed_scope":"one fixed-order pair; search wall includes selector cost; new ordinary wall reported separately, historical reuse is not algorithm acceleration"}
+    out["timing_boundaries"]={arm:{"setup_seconds":p["setup_seconds"],"search_seconds":p["run_neutral_seconds"],
+        "preparation_including_selector_seconds":p["wall_profile"]["phase_seconds"]["proposal_preparation"],
+        "selector_seconds":p["early_preparation_admission"].get("selector_seconds",0),
+        "post_search_verification_seconds":p["final_verification_seconds"],
+        "new_ordinary_batch_wall_seconds":p["verification"]["result"].get("total_elapsed_ms",0)/1000,
+        "setup_plus_search_seconds":p["setup_seconds"]+p["run_neutral_seconds"],
+        "setup_search_verification_seconds":p["setup_seconds"]+p["run_neutral_seconds"]+p["final_verification_seconds"]}
+        for arm,p in (("control",control),("candidate",candidate))}
+    panels={arm:p["verification"] for arm,p in (("control",control),("candidate",candidate))}
+    out["quality_established"]=all(v["quality_evidence"].get("quality_established") is True for v in panels.values())
+    if out["quality_established"]:
+        best={arm:max(v["result"]["candidates"],key=lambda r:r["measured_dps"]) for arm,v in panels.items()}
+        a,b=best["control"],best["candidate"]
+        difference=b["measured_dps"]-a["measured_dps"]
+        same_batch=a["engine_result_sha256"]==b["engine_result_sha256"] and a["config_sha256"]==b["config_sha256"]
+        margin=None if same_batch else 1.96*math.hypot(a["standard_error"],b["standard_error"])
+        out["ordinary_best"]={"control":a,"candidate":b,"difference_dps":difference,
+            "same_retained_batch":same_batch,
