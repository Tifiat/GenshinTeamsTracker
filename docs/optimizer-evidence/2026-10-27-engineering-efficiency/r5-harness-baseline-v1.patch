+                    raise ValueError("profile_duplicate_or_scalar")
+                singular[number] = value
+                if number in (7, 8, 14, 15):
+                    indices.add(value)
+            elif number == 13:
+                for index in _repeated(wire, value, budget):
+                    if index > INT64_MAX:
+                        raise ValueError("profile_comment_index")
+                    indices.add(index)
+        if not strings or strings[0] != "" or any(index >= len(strings) for index in indices):
+            raise ValueError("profile_string_table")
+        resolved = [(strings[name], strings[unit]) for name, unit in types]
+        if len(resolved) != 2 or set(resolved) != {("samples", "count"), ("cpu", "nanoseconds")}:
+            raise ValueError("profile_cpu_types")
+        if period_type is None or tuple(strings[index] for index in period_type) != ("cpu", "nanoseconds"):
+            raise ValueError("profile_cpu_period_type")
+        period, duration = singular.get(12, 0), singular.get(10, 0)
+        count = totals[resolved.index(("samples", "count"))]
+        cpu = totals[resolved.index(("cpu", "nanoseconds"))]
+        if not 0 < period <= INT64_MAX or duration <= 0 or count <= 0 or cpu != count * period:
+            raise ValueError("profile_cpu_totals")
+        lost = any(strings[index].rsplit(".", 1)[-1] == "lostProfileEvent" for index in function_names)
+        result.update(
+            status="valid", sample_types=[{"type": name, "unit": unit} for name, unit in resolved],
+            period_type={"type": "cpu", "unit": "nanoseconds"}, period_ns=period,
+            profile_duration_ns=duration, sample_record_count=record_count,
+            weighted_cpu_sample_count=count, total_cpu_ns=cpu,
+            lost_profile_event_present=lost, profile_bytes=len(raw),
+            profile_sha256=hashlib.sha256(raw).hexdigest(),
+        )
+    except (ValueError, UnicodeError, zlib.error, OverflowError):
+        result["errors"] = ["profile_metadata_rejected"]
+    return result
+
+
+def _cost(token: str, *, dot: bool = False) -> int | float:
+    if dot and token == ".":
+        return 0
+    if not _COST_RE.fullmatch(token):
+        raise ValueError("pprof_cpu_value")
+    number = Decimal(token.removesuffix("ns"))
+    if not 0 <= number <= INT64_MAX:
+        raise ValueError("pprof_cpu_bound")
+    return int(number) if number == number.to_integral_value() else float(number)
+
+
+def _percent(token: str, *, maximum: float = 100.05) -> float:
+    if len(token) > 24 or not _PERCENT_RE.fullmatch(token):
+        raise ValueError("pprof_percent")
+    number = float(token[:-1])
+    if not math.isfinite(number) or not 0 <= number <= maximum:
+        raise ValueError("pprof_percent_bound")
+    return number
+
+
+def _symbol(symbol: str) -> str:
+    # Import paths are part of Go function names. Absolute/relative filesystem
+    # paths, addresses, whitespace, and source snippets cannot pass this shape.
+    if (len(symbol) > 512 or ".." in symbol or re.search(r"[0-9a-fA-F]{24,}", symbol)
+            or not re.fullmatch(r"(?:type:)?[A-Za-z_][A-Za-z0-9_./()*\[\],~+{}-]*", symbol)
+            or symbol.startswith(("data/", "Users/", "home/", "tmp/"))
+            or symbol.endswith((".go", ".exe", ".pprof"))):
+        raise ValueError("pprof_unsafe_symbol")
+    return symbol
+
+
+def _report_text(text: str) -> None:
+    _text_bytes(text, MAX_REPORT_BYTES)
+    if not text or not text.endswith("\n"):
+        raise ValueError("pprof_incomplete_report")
+
+
+def parse_top(text: str) -> dict[str, Any]:
+    """Parse the recipe's -top -flat -unit=ns output, stripping all headers."""
+    result = _result(rows=[])
+    try:
+        _report_text(text)
+        column_header = False
+        sample_type = False
+        total: int | float | None = None
+        duration_total: int | float | None = None
+        symbols: set[str] = set()
+        for raw_line in text.splitlines():
+            line = raw_line.strip()
+            if not line:
+                continue
+            if not column_header:
+                if line.split() == ["flat", "flat%", "sum%", "cum", "cum%"]:
+                    column_header = True
+                elif line == "Type: cpu" and not sample_type:
+                    sample_type = True
+                elif line.startswith(("File: ", "Build ID: ", "Time: ", "Doc: ")):
+                    continue
+                elif match := re.fullmatch(r"Duration: [0-9]+(?:\.[0-9]+)?(?:ns|us|µs|ms|s|hrs), Total samples = (\S+)\s+\((\S+)\)", line):
+                    if duration_total is not None:
+                        raise ValueError("top_duplicate_total")
+                    duration_total = _cost(match[1])
+                    # Process-wide CPU can exceed elapsed duration on a
+                    # multicore process; this ratio is not a node percentage.
+                    _percent(match[2], maximum=float(INT64_MAX))
+                elif match := re.fullmatch(r"Showing nodes accounting for (\S+), (\S+) of (\S+) total", line):
+                    if total is not None:
+                        raise ValueError("top_duplicate_total")
+                    shown, total = _cost(match[1]), _cost(match[3])
+                    _percent(match[2])
+                    if shown > total:
+                        raise ValueError("top_shown_total")
+                elif re.fullmatch(r"Showing top [0-9]{1,2} nodes out of [0-9]{1,10}", line):
+                    continue
+                else:
+                    raise ValueError("top_unrecognized_header")
+                continue
+            tokens = line.split()
+            inline = None
+            if len(tokens) == 7 and tokens[-1] in {"(inline)", "(partial-inline)"}:
+                inline = tokens.pop()[1:-1]
+            if len(tokens) != 6 or len(result["rows"]) >= MAX_TOP_ROWS:
+                raise ValueError("top_row_shape_or_bound")
+            flat, cumulative = _cost(tokens[0]), _cost(tokens[3])
+            for index in (1, 2, 4):
+                _percent(tokens[index])
+            symbol = _symbol(tokens[5])
+            if symbol in symbols or cumulative < flat or total is None or cumulative > total:
+                raise ValueError("top_row_values")
+            symbols.add(symbol)
+            result["rows"].append({
+                "symbol": symbol, "flat_ns": flat, "cumulative_ns": cumulative,
+                "flat_display": tokens[0], "cumulative_display": tokens[3],
+                "flat_percent_display": tokens[1], "sum_percent_display": tokens[2],
+                "cumulative_percent_display": tokens[4], "inline": inline,
+            })
+        if (not column_header or not sample_type or not result["rows"] or total is None
+                or duration_total != total or total <= 0
+                or sum(row["flat_ns"] for row in result["rows"]) > total):
+            raise ValueError("top_incomplete")
+        result.update(status="valid", total_cpu_ns=total)
+    except (ValueError, UnicodeError, OverflowError):
+        result["status"] = "partial"
+        result["errors"] = ["top_report_rejected"]
+    return result
+
+
+def parse_focus(text: str) -> dict[str, Any]:
+    """Keep ROUTINE totals/nonzero numeric lines; never return source/path text."""
+    result = _result(routines=[], nonzero_line_count=0)
+    try:
+        _report_text(text)
+        total: int | float | None = None
+        current: dict[str, Any] | None = None
+        needs_totals = False
+        source_rows = 0
+        for raw_line in text.splitlines():
+            line = raw_line.strip()
+            if not line:
+                continue
+            if match := re.fullmatch(r"Total: (\S+)", line):
+                if total is not None or current is not None:
+                    raise ValueError("focus_duplicate_total")
+                total = _cost(match[1])
+                continue
+            if match := re.fullmatch(r"ROUTINE =+ (\S+) in .+", line):
+                if (total is None or needs_totals
+                        or (current is not None and (source_rows == 0 or not current["lines"]))):
+                    raise ValueError("focus_incomplete_routine")
+                symbol = _symbol(match[1])
+                if not _FOCUS_RE.fullmatch(symbol) or len(result["routines"]) >= MAX_TOP_ROWS:
+                    raise ValueError("focus_unexpected_symbol_or_bound")
+                current = {"symbol": symbol, "lines": []}
+                result["routines"].append(current)
+                needs_totals, source_rows = True, 0
+                continue
+            if current is None:
+                raise ValueError("focus_no_routine")
+            if needs_totals:
+                match = re.fullmatch(r"(\S+)\s+(\S+) \(flat, cum\) (\S+) of Total", line)
+                if not match:
+                    raise ValueError("focus_totals_shape")
+                flat, cumulative = _cost(match[1]), _cost(match[2])
+                _percent(match[3])
+                if cumulative < flat or total is None or cumulative > total:
+                    raise ValueError("focus_totals_values")
+                current.update(flat_ns=flat, cumulative_ns=cumulative, flat_display=match[1],
+                               cumulative_display=match[2], cumulative_percent_display=match[3])
+                needs_totals = False
+                continue
+            match = re.fullmatch(r"(\S+)\s+(\S+)\s+([0-9]{1,10}):.*", line)
+            if not match:
+                raise ValueError("focus_source_unavailable_or_malformed")
+            flat, cumulative = _cost(match[1], dot=True), _cost(match[2], dot=True)
+            line_number = int(match[3])
+            if not 0 < line_number <= (1 << 31) - 1 or cumulative < flat or cumulative > current["cumulative_ns"]:
+                raise ValueError("focus_line_values")
+            source_rows += 1
+            if flat or cumulative:
+                result["nonzero_line_count"] += 1
+                if result["nonzero_line_count"] > MAX_FOCUS_LINES:
+                    raise ValueError("focus_line_bound")
+                current["lines"].append({"line": line_number, "flat_ns": flat,
+                                         "cumulative_ns": cumulative,
+                                         "flat_display": match[1], "cumulative_display": match[2]})
+        if (total is None or total <= 0 or not result["routines"] or needs_totals
+                or source_rows == 0 or not current or not current["lines"]):
+            raise ValueError("focus_incomplete")
+        result.update(status="valid", total_cpu_ns=total)
+    except (ValueError, UnicodeError, OverflowError):
+        result["status"] = "partial"
+        result["errors"] = ["focus_report_rejected"]
+    present = {row["symbol"] for row in result["routines"]}
+    result["missing_symbols"] = [
+        {"symbol": symbol, "disposition": "not_sampled_or_inlined"}
+        for symbol in FOCUS_SYMBOLS
+        if not any(found == symbol or found.startswith(symbol + ".") for found in present)
+    ]
+    return result
+
+
+def _outcome_valid(outcome: Any) -> bool:
+    return (type(outcome) is dict and type(outcome.get("returncode")) is int
+            and outcome["returncode"] == 0 and outcome.get("timed_out") is False
+            and "error_class" in outcome and outcome["error_class"] is None)
+
+
+def _pprof_log_valid(log: str, output_path: str | None) -> bool:
+    _text_bytes(log, MAX_LOG_BYTES)
+    if not log.strip():
+        return True
+    # Local Go pprof driver.go writes this one normal message for -output.
+    # The caller supplies the exact owned output path; it is never retained.
+    if output_path is not None:
+        _text_bytes(output_path, MAX_LOG_BYTES)
+        if "\n" in output_path or "\r" in output_path:
+            return False
+        return log.replace("\r\n", "\n") == "Generating report in " + output_path + "\n"
+    return False
+
+
+def _sample_band(samples: float) -> str:
+    if samples <= 0:
+        return "not_sampled_or_inlined"
+    if samples < COARSE_SAMPLE_THRESHOLD:
+        return "insufficient"
+    return "coarse" if samples < FINE_SAMPLE_THRESHOLD else "fine"
+
+
+def collect_profile_evidence(
+    *, go_jsonl: str, summary_json: str | bytes, profile: bytes,
+    go_outcome: dict[str, Any], top_text: str | None = None,
+    focus_text: str | None = None, top_outcome: dict[str, Any] | None = None,
+    focus_outcome: dict[str, Any] | None = None, go_log: str = "",
+    top_log: str = "", focus_log: str = "", top_output_path: str | None = None,
+    focus_output_path: str | None = None,
+) -> dict[str, Any]:
+    """Compose gates without granting execution, retry, or attribution proof.
+
+    Outcomes must explicitly supply returncode, timed_out, and error_class. Logs
+    are bounded. For pprof, only empty/whitespace or its exact normal report
+    message for the caller's owned output path is accepted. Other diagnostics,
+    including symbolization warnings, leave attribution unverified.
+    """
+    result = _result(go_events=collect_go_events(go_jsonl),
+                     summary_validation=parse_summary(summary_json),
+                     metadata=profile_metadata(profile))
+    if not _outcome_valid(go_outcome):
+        result["errors"].append("go_invocation_unverified")
+    try:
+        _text_bytes(go_log, MAX_LOG_BYTES)
+        if go_log.strip():
+            raise ValueError("go_diagnostic_output")
+    except (ValueError, UnicodeError):
+        result["errors"].append("go_log_unverified")
+    if any(result[key]["status"] != "valid" for key in ("go_events", "summary_validation", "metadata")):
+        result["errors"].append("profile_prerequisites_unverified")
+    if result["errors"]:
+        return result
+    summary = result["summary_validation"]["summary"]
+    metadata = result["metadata"]
+    if any(summary[key] != metadata[key] for key in ("profile_bytes", "profile_sha256")):
+        result["errors"].append("profile_summary_identity_mismatch")
+        return result
+    result["status"] = "valid"
+    result["top"] = parse_top(top_text) if top_text is not None else _result("partial", errors=["top_output_missing"], rows=[])
+    result["focus"] = parse_focus(focus_text) if focus_text is not None else parse_focus("")
+    for key, outcome, log, path in (("top", top_outcome, top_log, top_output_path),
+                                    ("focus", focus_outcome, focus_log, focus_output_path)):
+        try:
+            if not _pprof_log_valid(log, path):
+                raise ValueError("pprof_diagnostic_output")
+        except (ValueError, UnicodeError):
+            result["errors"].append(key + "_log_unverified")
+        if not _outcome_valid(outcome):
+            result["errors"].append(key + "_invocation_unverified")
+        if (result[key]["status"] != "valid"
+                or result[key].get("total_cpu_ns") != metadata["total_cpu_ns"]):
+            result["errors"].append(key + "_attribution_unverified")
+    if result["errors"]:
+        result["status"] = "partial"
+    adequate = metadata["weighted_cpu_sample_count"] >= TOTAL_SAMPLE_THRESHOLD
+    lost = metadata["lost_profile_event_present"]
+    result["adequacy"] = {
+        "thresholds": {"total_samples": TOTAL_SAMPLE_THRESHOLD,
+                       "coarse_function_samples": COARSE_SAMPLE_THRESHOLD,
+                       "fine_function_samples": FINE_SAMPLE_THRESHOLD},
+        "total": "sufficient_for_descriptive_cost_ranking" if adequate else "insufficient_descriptive_only",
+        "attribution": "qualified_lost_samples" if lost else "sampled_process_cpu",
+        "cost_ranking_supported": adequate and not lost and result["status"] == "valid",
+        "statistical_guarantee": False,
+        "function_sample_equivalents_use_display_rounding": True,
+        "functions": [],
+    }
+    for row in result["top"]["rows"]:
+        flat = row["flat_ns"] / metadata["period_ns"]
+        cumulative = row["cumulative_ns"] / metadata["period_ns"]
+        result["adequacy"]["functions"].append({
+            "symbol": row["symbol"], "flat_sample_equivalent": flat,
+            "cumulative_sample_equivalent": cumulative,
+            "flat_band": _sample_band(flat), "cumulative_band": _sample_band(cumulative),
+        })
+    if len(json.dumps(result, separators=(",", ":"), allow_nan=False).encode("utf-8")) > MAX_RECEIPT_BYTES:
+        return _result("partial", errors=["collected_evidence_bound"], metadata=metadata,
+                       go_events=result["go_events"], summary_validation=result["summary_validation"])
+    return result
