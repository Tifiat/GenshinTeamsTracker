+def validate_fixture(connection, case, team, rotation, metadata):
+    """SELECT-only core; accepts an in-memory connection for capture-free tests."""
+    try:
+        return _validate(connection, case, team, rotation, metadata)
+    except FixtureAdmissionError: raise
+    except sqlite3.Error: raise FixtureAdmissionError("fixture_schema_invalid") from None
+    except (KeyError, TypeError, ValueError, IndexError, OverflowError, AttributeError):
+        raise FixtureAdmissionError("fixture_metadata_invalid") from None
+
+
+def admit_fixture(db_path, case, team, rotation, metadata, *, owned_root):
+    """Open only the fixed fixture filename inside its already-owned root, read-only."""
+    try:
+        path, root = Path(db_path), Path(owned_root)
+        assert_unlinked(path); assert_unlinked(root)
+        root = root.resolve(strict=True)
+        _require(path.name == f"{case.case_id}-synthetic.db" and path.resolve(strict=True).parent == root
+            and stat.S_ISREG(path.stat().st_mode) and 0 < path.stat().st_size <= 2 * 1024 * 1024, "fixture_path_invalid")
+        with closing(sqlite3.connect(path.resolve(strict=True).as_uri() + "?mode=ro", uri=True)) as connection:
+            return validate_fixture(connection, case, team, rotation, metadata)
+    except FixtureAdmissionError: raise
+    except (OSError, sqlite3.Error, ValueError, TypeError, AttributeError): raise FixtureAdmissionError("fixture_read_failed") from None
