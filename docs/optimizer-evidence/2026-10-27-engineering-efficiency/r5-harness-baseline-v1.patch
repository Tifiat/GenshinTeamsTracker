+def _stage_product_overlay(job: Path, plan: dict) -> Path:
+    images = _accepted_v8_images()
+    for relative in PORT_PATHS:
+        images[relative] = _bounded(K.NATIVE / relative)
+    if {name: sha(raw) for name, raw in images.items()} != plan["accepted_product_images"]:
+        raise ValueError("uptake_product_overlay_changed")
+    replace_paths = {}
+    for relative, raw in images.items():
+        staged = job / "accepted-product-images" / relative
+        staged.parent.mkdir(parents=True, exist_ok=True)
+        staged.write_bytes(raw)
+        replace_paths[str(K.NATIVE / relative)] = str(staged)
+        if relative in PORT_PATHS:
+            retained = job / "product-port-source-images" / relative
+            retained.parent.mkdir(parents=True, exist_ok=True)
+            retained.write_bytes(raw)
+    overlay_path = job / "accepted-product-overlay.json"
+    overlay_path.write_bytes(K.gate.canonical({"Replace": replace_paths}))
+    return overlay_path
