+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--job", type=Path, required=True)
+    parser.add_argument("--case", choices=CASES, required=True)
+    parser.add_argument("--stage", choices=("prepare", "selected"), required=True)
+    parser.add_argument("--arm", choices=("control", "candidate"), required=True)
+    parser.add_argument("--binding", type=Path, required=True)
+    args = parser.parse_args()
+    job = owned_job(args.job)
+    try:
+        binding = binding_input(job, args.binding, args.arm)
+        if args.stage == "prepare":
+            value = prepare(job, args.case, args.arm, binding)
+        else:
+            value = selected(job, args.case, args.arm, binding)
+    except Exception as exc:
