+ROOT = Path(__file__).resolve().parents[4]
+CASE_MANIFEST_PATH = Path(__file__).with_name("case_manifest_v1.json")
+ARCHETYPE_MANIFEST_PATH = ROOT / "tools/experiments/gcsim/mode_matrix/archetype_manifest_v1.json"
+FIXTURE_TIMESTAMP = "2026-01-01T00:00:00+00:00"
+SLOT_KEY_BY_POSITION = {1: "flower", 2: "plume", 3: "sands", 4: "goblet", 5: "circlet"}
+ALLOWED_MAIN_KEYS_BY_POSITION = {
+    1: frozenset({"hp"}),
+    2: frozenset({"atk"}),
+    3: frozenset({"hp_", "atk_", "def_", "enerRech_", "eleMas"}),
