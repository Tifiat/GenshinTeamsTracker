+def _validate_final_pair_whole(job: Path, payload: dict[str, Any], record: dict[str, Any]) -> None:
+    """Join observed final calls without treating partial coverage as complete."""
+    def rows(filename: str, maximum_rows: int) -> tuple[bytes, list[dict[str, Any]]]:
+        raw = (job / filename).read_bytes()
+        if len(raw) > MAX_RAW_EXPORT_BYTES:
+            raise ValueError("final-pair ledger exceeds bounded read")
+        parsed = [json.loads(line) for line in raw.splitlines() if line]
+        if len(parsed) > maximum_rows or any(not isinstance(row, dict) for row in parsed):
+            raise ValueError("final-pair ledger row count/type differs")
+        return raw, parsed
+
+    def identity(row: dict[str, Any], allow_unknown: bool = False) -> None:
+        local_pair._assignment(row.get("input_assignment"), "input_assignment")
+        local_pair._number(row.get("input_dps"), "input_dps")
+        if not isinstance(row.get("packages"), list) or len(row["packages"]) != 4:
+            raise ValueError("four input packages absent")
+        for key in ("context_sha256", "graph_sha256"):
+            if key not in row or (not (allow_unknown and row[key] is None)
+                    and (not isinstance(row[key], str) or re.fullmatch("[0-9a-f]{64}", row[key]) is None)):
+                raise ValueError("explicit context/graph identity absent")
+
+    plan_raw, plans = rows("final-pair-whole-plan.jsonl", 15)
+    invocation_raw, invocations = rows("final-pair-whole-stabilization.jsonl", 14)
+    projection = payload["projection"]
+    retained = json.loads(gzip.decompress(
+        (k.EVIDENCE / "adaptive-damped-whole-candidate-projection.json.gz").read_bytes()))
+    config = projection.get("search_config")
+    if json.dumps(config, sort_keys=True) != json.dumps(retained["projection"]["search_config"], sort_keys=True):
+        raise ValueError("whole Coordinator/Search/Scout config differs from retained D")
+    if (config["MaxGuides"] != 12 or config["FinalistLimit"] != 7
+            or config["MaxSearchExpansions"] != 8000000 or config["Search"]["MaxExpandedPerActor"] != 20000):
+        raise ValueError("frozen whole-D caps differ")
+    if not plans or any(row.get("schema") != "final_pair_whole_plan_v1" for row in plans):
+        raise ValueError("finalist plan schema/snapshot absent")
+    snapshots = [row for row in plans if row.get("event") == "snapshot"]
+    planned = [row for row in plans if row.get("event") == "finalist"]
+    skipped = [row for row in plans if row.get("event") == "not_invoked"]
+    if len(snapshots) != 1 or plans[0] != snapshots[0] or len(plans) != 1 + len(planned) + len(skipped):
+        raise ValueError("finalist plan has missing/unknown events")
+    snapshot = snapshots[0]
+    count = local_pair._integer(snapshot.get("finalist_count"), "finalist_count", 7)
+    budget, cap = config["MaxSearchExpansions"], config["Search"]["MaxExpandedPerActor"]
+    before = local_pair._integer(snapshot.get("global_before"), "global_before", budget)
+    if (snapshot.get("status") != "planned" or snapshot.get("global_budget") != budget
+            or snapshot.get("local_cap") != cap or snapshot.get("finalist_limit") != 7
+            or snapshot.get("search_config") != config["Search"]
+            or [row.get("index") for row in planned] != list(range(count))
+            or plans[1:1 + count] != planned):
+        raise ValueError("fixed snapshot/ordered planned finalists differ")
+    for row in planned:
+        identity(row, allow_unknown=True)
+        local_pair._integer(row.get("index"), "planned.index", 6)
+        if (row.get("status") != "planned" or row.get("global_budget") != budget
+                or any(key not in row or row[key] is not None
+                       for key in ("global_before", "remaining_before", "allowance"))):
+            raise ValueError("unobserved future budgets must be explicit null")
+    if len(invocations) % 2:
+        raise ValueError("started final invocation lacks its completed result")
+    observed = []
+    fields = ("index", "input_assignment", "input_dps", "context_sha256", "graph_sha256", "packages",
+              "global_budget", "global_before", "allowance")
+    for offset in range(0, len(invocations), 2):
+        start, complete = invocations[offset:offset + 2]
+        index = offset // 2
+        for row in (start, complete):
+            for key in ("index", "global_budget", "global_before", "allowance"):
+                local_pair._integer(row.get(key), key)
+        for key in ("stabilization_index", "global_after", "remaining_budget"):
+            local_pair._integer(complete.get(key), key)
+        local_pair._integer(start.get("remaining_before"), "remaining_before")
+        if (start.get("schema") != "final_pair_whole_stabilization_v1"
+                or complete.get("schema") != "final_pair_whole_stabilization_v1"
+                or start.get("event") != "started" or start.get("status") != "started"
+                or complete.get("event") != "completed" or complete.get("status") != "completed"
+                or start.get("index") != index or index >= count
+                or any(start.get(key) != complete.get(key) for key in fields)
+                or complete.get("stabilization_index") != index):
+            raise ValueError("final invocation order/input/index join differs")
+        identity(start)
+        for key in ("input_assignment", "input_dps", "packages"):
+            if start[key] != planned[index][key]:
+                raise ValueError("invoked finalist differs from frozen plan")
+        for key in ("context_sha256", "graph_sha256"):
+            if planned[index][key] is not None and start[key] != planned[index][key]:
+                raise ValueError("hydrated identity differs from known plan identity")
+        remaining = budget - before
+        allowance = min(remaining, cap)
+        if (remaining <= 0 or start.get("global_budget") != budget
+                or start.get("global_before") != before or start.get("remaining_before") != remaining
+                or start.get("allowance") != allowance):
+            raise ValueError("final invocation does not use unchanged shared allowance")
+        _validate_stabilization(complete.get("stabilization"), start["input_assignment"], start["input_dps"], allowance)
+        stabilization = complete["stabilization"]
+        after = before + stabilization["evaluations"]
+        if (complete.get("global_after") != after or complete.get("remaining_budget") != budget - after
+                or complete.get("cancelled") is not False or "error" not in complete or complete["error"] is not None):
+            raise ValueError("final completion budget/error/cancellation differs")
+        local_pair._number(complete.get("elapsed_seconds"), "elapsed_seconds")
+        observed.append(stabilization)
+        before = after
+    if [row.get("index") for row in skipped] != list(range(len(observed), count)):
+        raise ValueError("not-invoked finalists are missing or overlap completed calls")
+    for row in skipped:
+        for key in ("index", "global_budget", "global_before", "remaining_budget"):
+            local_pair._integer(row.get(key), key)
+        if (row.get("status") != "not_invoked" or row.get("global_budget") != budget
+                or row.get("global_before") != before or row.get("remaining_budget") != budget - before
+                or row.get("reason") != "global_budget_exhausted" or before != budget
+                or row.get("cancelled") is not False):
+            raise ValueError("successful skipped finalist lacks actual exhausted budget")
+    actual_stabilizations = projection.get("neutral_stabilization")
+    if actual_stabilizations is None and not observed and "neutral_stabilization" in projection:
+        actual_stabilizations = []  # Go nil slice is valid only when there were no calls.
+    if (actual_stabilizations != observed
+            or projection.get("search_expansions") != before
+            or not isinstance(projection.get("search_stop_reason"), str) or not projection["search_stop_reason"]):
+        raise ValueError("full final outcomes/global budget do not join the normal projection")
+    summary = payload.get("final_pair_whole")
+    if not isinstance(summary, dict) or summary.get("schema") != "final_pair_whole_telemetry_v1":
+        raise ValueError("final-pair telemetry summary absent")
+    expected = {
+        "plan_rows": count, "plan_events": len(plans), "started": len(observed), "completed": len(observed),
+        "not_invoked": len(skipped), "errors": 0, "plan_file": "final-pair-whole-plan.jsonl",
+        "invocation_file": "final-pair-whole-stabilization.jsonl", "plan_bytes": len(plan_raw),
+        "invocation_bytes": len(invocation_raw), "maximum_file_bytes": MAX_RAW_EXPORT_BYTES,
+        "global_budget": budget, "global_before_snapshot": snapshot["global_before"], "local_cap": cap,
+        "finalist_limit": 7, "search_config": config["Search"],
+    }
+    if any(key not in summary or summary[key] != value or type(summary[key]) is not type(value)
+           for key, value in expected.items()):
+        raise ValueError("final-pair summary does not reconcile with actual ledgers")
+    for row in payload["verification"]["result"]["candidates"]:
+        for key in ("formula_dps", "measured_dps", "standard_deviation", "standard_error"):
+            local_pair._number(row.get(key), "measured." + key)
+
+    def prefinal(document: dict[str, Any]) -> list[dict[str, Any]]:
+        result = []
+        for row in document["projection"]["search_work"]:
+            if row.get("lane", "").startswith("neutral_finalist:"):
+                break
+            result.append({key: value for key, value in row.items() if key not in ("CaptureSeconds", "SearchSeconds")})
+        return result
+
+    prior_work, actual_work = prefinal(retained), prefinal(payload)
+    first_difference = next((i for i, (left, right) in enumerate(zip(prior_work, actual_work)) if left != right), None)
+    if first_difference is None and len(prior_work) != len(actual_work):
+        first_difference = min(len(prior_work), len(actual_work))
+    record["prefinal_ordered_work_comparison_to_D"] = {
+        "retained_rows": len(prior_work), "candidate_rows": len(actual_work),
+        "equal_except_timing": prior_work == actual_work, "first_difference_index": first_difference,
+        "interpretation": "Posthoc observation; independent ordinary feedback may diverge. No injected baseline state.",
+    }
+    record["final_pair_observation_audit"] = {
+        "complete": True, "planned": count, "invoked": len(observed), "not_invoked": len(skipped),
+        "global_budget": budget, "global_before_final": snapshot["global_before"], "global_after_final": before,
+        "remaining_global_budget": budget - before, "search_stop_reason": projection["search_stop_reason"],
+        "evaluations": sum(row["evaluations"] for row in observed),
+        "accepted": sum(row["accepted"] for row in observed),
+        "pair_coverage_complete_per_invocation": [row["pair_completion"]["pair_coverage_complete"] for row in observed],
+        "normal_seconds": sum(row["pair_completion"]["normal_stabilize_seconds"] for row in observed),
+        "pair_seconds": sum(row["pair_completion"]["pair_completion_seconds"] for row in observed),
+        "pair_expanded": sum(row["pair_completion"]["pair_expanded"] for row in observed),
+        "plan_raw_sha256": k.sha(plan_raw), "invocations_raw_sha256": k.sha(invocation_raw),
+    }
+
+
+def run(destination: Path, freeze_path: Path) -> dict[str, Any]:
+    started = time.monotonic()
+    if destination.exists():
+        raise FileExistsError(destination)
+    overlay = ablation.final_pair_whole_overlay()
+    inputs = _read_saved_inputs()
+    plan = _frozen_plan(overlay, inputs)
+    frozen = json.loads(freeze_path.read_bytes())
+    if (frozen.get("source_review_status") != "approved" or frozen.get("frozen_plan") != plan
+            or frozen.get("execution_grant") != "one_whole_candidate"):
+        raise ValueError("exact whole-pair freeze and separate one-candidate execution grant required")
+    saved_inputs = inputs
+    pins = _source_pins(overlay)
+    before = k.protected()
+    native_before = k.old.native_map()
+    source_before = {
+        relative: k.sha((k.ROOT / relative).read_bytes())
+        for relative in pins
+        if not relative.startswith(("accepted_", "patched_", "overlay:", "preimage:", "image:"))
+    }
+    active: list[Path | None] = [None]
+    record: dict[str, Any] = {
+        "schema": "final_pair_whole_run_result_v1",
+        "status": "started",
+        "errors": [],
+        "freeze_path": str(freeze_path),
+        "freeze_sha256": k.sha(freeze_path.read_bytes()),
+        "frozen_plan": plan,
+        "saved_input_pins": saved_inputs,
+        "protected_before": before,
+        "accepted_native_map_before_sha256": k.gate.digest(native_before),
+        "source_pins_before": source_before,
+        "managed_jobs_created": 0,
+        "remaining_managed_jobs": None,
+        "baseline_or_hybrid_reruns": 0,
+        "candidate_replays": 0,
+        "build_launches": 0,
+        "contract_launches": 0,
+        "policy_engine_calls": None,
+        "final_measurements": None,
+        "installs": 0,
+        "captures": 0,
+        "retries": 0,
+        "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
+    }
+    if Path(sys.executable).resolve() != (k.ROOT / ".venv/Scripts/python.exe").resolve():
+        raise ValueError("run with the repository .venv/Scripts/python.exe")
+    if tuple(k.gate.managed.MANAGED_ROOT.glob("job-*")):
+        raise RuntimeError("managed-job root is not idle; no attempt started")
+    if k.gate.retirement._default_process_probe(k.ROOT):
+        raise RuntimeError("optimizer process probe is not idle; no attempt started")
+    for target in (
+        destination,
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}candidate-projection.json.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}policy-progress.jsonl.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}final-ledger.jsonl.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}screening.jsonl.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}plan.jsonl.gz",
+        k.EVIDENCE / f"{EVIDENCE_PREFIX}stabilization.jsonl.gz",
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}log-{label}.log.gz" for label in (
+            "formula-primary-compile", "formula-primary-contracts", "formula-primary-candidate",
+        )),
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}final-config-{index:02d}.gz" for index in range(9)),
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}final-result-{index:02d}.gz" for index in range(9)),
+        *(k.EVIDENCE / f"{EVIDENCE_PREFIX}policy-{kind}-{index:02d}.gz" for kind in ("config", "result") for index in range(48)),
+    ):
+        if target.exists():
+            raise FileExistsError(target)
+    with destination.open("xb") as stream:
+        def save() -> None:
+            k.gate.io._save(stream, record)
+
+        def export() -> None:
+            job = active[0]
+            if job is not None:
+                _export_job(job, record)
+            save()
+
+        def body(job: Path) -> None:
+            active[0] = job
+            record["managed_jobs_created"] = 1
+            env, _ = k.gate.common._environment(job)
+            env.update(
+                GOMEMLIMIT="2GiB",
+                GTT_TIGHNARI_ARCHIVED_WHOLE="root_released_once",
+                GTT_TIGHNARI_REPLAY_REPO=str(k.ROOT),
+                GTT_TIGHNARI_REPLAY_ROLE="candidate",
+            )
+            overlay_path, manifest = staging.stage_overlay(job, overlay, native_before)
+            record["staging_manifest"] = manifest
+            binary = job / "adaptive-damped-whole.exe"
+
+            def command(args: list[str], label: str, limit: int) -> None:
+                remaining = WHOLE_SECONDS - (time.monotonic() - started) - CLEANUP_RESERVE_SECONDS
+                if remaining <= 0:
+                    raise TimeoutError("cleanup reserve reached before " + label)
+                timeout = min(limit, remaining)
+                record["stage"] = label
+                record.setdefault("command_timeouts_seconds", {})[label] = timeout
+                save()
+                result = k.gate.owned._run_owned(
+                    args,
+                    command_kind=label,
+                    env=env,
+                    log_path=job / f"{label}.log",
+                    timeout_seconds=timeout,
+                )
+                record.setdefault("commands", {})[label] = result
+                save()
+                if not k.gate.command_passed(result):
+                    log = job / f"{label}.log"
+                    if log.exists():
+                        record["failure_tail"] = log.read_text(encoding="utf-8", errors="replace")[-5000:]
+                        save()
+                    raise RuntimeError(label + " failed")
+
+            go = str(k.gate.owned.GO_EXE)
+            record["build_launches"] = 1
+            save()
+            command(
+                [go, "-C", str(k.NATIVE), "test", "-c", "-p=1", "-mod=readonly", "-buildvcs=false",
+                 "-overlay=" + str(overlay_path), "-o", str(binary), "./internal/allsets"],
+                "formula-primary-compile", COMPILE_SECONDS,
+            )
+            record["binary_sha256"] = k.sha(binary.read_bytes())
+            save()
+            names = plan["focused_contract_names"]
+            record["contract_launches"] = 1
+            save()
+            command(
