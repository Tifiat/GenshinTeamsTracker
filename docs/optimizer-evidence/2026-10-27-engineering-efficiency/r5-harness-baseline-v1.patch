+    installation = GcsimEngineStore(DEFAULT_GCSIM_ENGINE_STORE_DIR).get_active_engine()
+    if installation is None:
+        raise DiagnosticError("no active public GCSIM engine")
+    metadata = installation.manifest.metadata
+    artifact_relative = metadata.get("artifact_relative_path")
+    if not isinstance(artifact_relative, str) or not artifact_relative:
+        raise DiagnosticError("active engine manifest has no artifact-relative path")
+    artifact = Path(artifact_relative)
+    if artifact.is_absolute() or ".." in artifact.parts:
+        raise DiagnosticError("active engine artifact path is invalid")
+    artifact_path = _inside(installation.path / artifact, installation.path)
+    artifact_sha256 = metadata.get("artifact_sha256")
+    if not isinstance(artifact_sha256, str) or _sha256_file(artifact_path) != artifact_sha256:
+        raise DiagnosticError("active engine artifact does not match its manifest")
+    rollback_binary = _inside(ROLLBACK_BINARY, ROOT)
+    rollback_manifest = _inside(ROLLBACK_MANIFEST, ROOT)
+    pins = _git_state()
+    pins.update({
+        "installed_consumer_sha256": _sha256_file(consumer),
+        "engine_artifact_sha256": artifact_sha256,
+        "active_pointer_sha256": _sha256_file(active_pointer),
+        "engine_id": installation.engine_id,
+        "engine_manifest_sha256": _sha256_file(installation.path / "gtt_engine_manifest.json"),
+        "engine_patch_sha256": str(metadata.get("patch_stack_sha256", "")),
+        "engine_source_manifest_sha256": str(metadata.get("source_manifest_body_sha256", "")),
+        "rollback_sha256": _sha256_file(rollback_binary),
+        "rollback_manifest_sha256": _sha256_file(rollback_manifest),
+    })
+    if pins != PROTECTED_RUNTIME_PINS:
+        raise DiagnosticError("protected HEAD, index, runtime, engine, or rollback pin drifted")
+    return pins
