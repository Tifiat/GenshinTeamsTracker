+            "candidate_builds": 1,
+            "actor0_refine_candidates_calls": 1,
+            "actor": 0,
+            "refine_allowance": 20000,
+            "trace_events_max": 50000,
+            "trace_event_bytes_max": 16 << 20,
+            "result_bytes_max": MAX_RESULT_BYTES,
+            "source_pin_file_bytes_max": MAX_SOURCE_PIN_BYTES,
+            "saved_input_file_bytes_max": MAX_SAVED_INPUT_FILE_BYTES,
