+"""One-shot dense-node consumer uptake using existing managed gates/transaction.
+
+The historical button baseline is immutable. Four current-control observations
+anchor four installed-candidate observations; no search/ranking delta is built.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import time
+
+sys.dont_write_bytecode = True
+from tools.experiments.gcsim.mvp_polish import dense_node_measure as dense
+from tools.experiments.gcsim.search_hypotheses import promotion_gate
+from tools.check_optimizer_buttons import button_gate_environment
+
+scope, prior = dense.scope, dense.prior
+ROOT, NATIVE, EVIDENCE = dense.ROOT, dense.NATIVE, dense.EVIDENCE
+gate = scope.accepted.K.gate
+PREFIX = "dense-node-install-v1"
+FREEZE = EVIDENCE / (PREFIX + "-freeze.json")
+RESULT = EVIDENCE / (PREFIX + "-result.json")
+ROLLBACK = EVIDENCE / (PREFIX + "-rollback")
+CONSUMER = NATIVE / "gtt-optimizer.exe"
+LIVE = ("effect_inputs.go", "neutral_inputs.go", "dense_node_lookup.go")
+CASES = ("selected_fast", "all_sets_fast", "selected_verified", "all_sets_verified")
+LIMITS = {"whole_seconds": 1800, "cleanup_reserve_seconds": 180,
+          "build_seconds": 240, "arm_seconds": 540, "case_seconds": 120,
+          "scratch_bytes": 2 << 30, "export_bytes": 512 << 20,
+          "builds": 1, "button_cases": 8, "installs": 1, "retries": 0}
+
+# Reuse the existing public button test. Only its baseline assertion is bound
+# to the explicitly reviewed fresh control; all product execution remains real.
+CHILD = r'''
+import json, os, sys, unittest
+from pathlib import Path
+sys.dont_write_bytecode = True
+from tests.ui.gcsim_browser import test_optimizer_button_backend as test
+from tests.support.optimizer_button_baseline import assert_button_baseline
+job = Path(os.environ["GTT_SCRATCH_DIR"])
+anchor = json.loads(Path(os.environ["GTT_DENSE_CONTROL"]).read_bytes()) if os.environ.get("GTT_DENSE_CONTROL") else None
+rows = []
+def check(row, historical):
+    rows.append(row)
+    (job / "preassert-observations.json").write_text(json.dumps(rows, sort_keys=True), encoding="utf-8")
+    if anchor is not None:
+        case = row["mode"] + ("_fast" if row["fast_mode"] else "_verified")
+        if row["winner_sha256"] != anchor["cases"][case]["winner_sha256"]:
+            raise AssertionError("fresh control winner differs")
+        if row["engine"] != anchor["engine_full"]:
+            raise AssertionError("fresh control engine wire differs")
+        assert_button_baseline(row, anchor)
+test.assert_button_baseline = check
+suite = unittest.defaultTestLoader.loadTestsFromModule(test)
+result = unittest.TextTestRunner(verbosity=2, failfast=True).run(suite)
+sys.exit(0 if result.wasSuccessful() else 2)
+'''
+
+
+def require(ok: bool, code: str) -> None:
+    if not ok:
+        raise ValueError(code)
+
+
+def rel(path: Path) -> str:
+    return path.relative_to(ROOT).as_posix()
+
+
+def sha_file(path: Path) -> str:
+    return scope.sha(dense.read(path)) if path.is_file() else "absent"
+
+
+def live_images() -> dict[str, bytes]:
+    images = {name: dense.read(dense.SOURCE / name) for name in LIVE}
+    # Preserve the unrelated omission in the dirty working source. The runtime
+    # overlay separately retains the archived health call and onheal validator.
+    raw = images["neutral_inputs.go"]
+    guard = b"\tif err := validateNeutralHealthRoots(n, nodes, len(owners)); err != nil { return err }\n"
+    require(raw.count(guard) == 1, "dense_live_guard_shape")
+    images["neutral_inputs.go"] = raw.replace(guard, b"")
+    return images
+
+
+def dirty_map() -> dict[str, str]:
+    paths = subprocess.run(["git", "ls-files", "-m", "-o", "--exclude-standard", "-z"],
+        cwd=ROOT, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout
+    return {name: sha_file(ROOT / name) for name in sorted(set(os.fsdecode(n) for n in paths.split(b"\0") if n))}
+
+
+def pins() -> dict[str, str]:
+    names = [Path(__file__), Path(dense.__file__), Path(prior.__file__),
+        Path(scope.__file__), Path(promotion_gate.__file__),
+        ROOT / "tools/check_optimizer_buttons.py",
+        ROOT / "tests/ui/gcsim_browser/test_optimizer_button_backend.py",
+        ROOT / "tests/support/optimizer_button_fixture.py",
+        ROOT / "tests/support/optimizer_button_baseline.py",
+        ROOT / "tests/fixtures/gcsim_optimizer_go_v1/button_smoke_team_v1.json",
+        ROOT / "tests/fixtures/gcsim_optimizer_go_v1/button_smoke_baseline_v1.json",
+        NATIVE / "go.mod", NATIVE / "go.sum",
+        EVIDENCE / "dense-node-v3-freeze.json", EVIDENCE / "dense-node-v3-result.json"]
+    names += [dense.SOURCE / name for name in dense.DELTA]
+    return {rel(path): sha_file(path) for path in names}
+
+
+def source_map(images: dict[str, bytes]) -> dict[str, str]:
+    return {name: scope.sha(raw) for name, raw in sorted(images.items())}
+
+
+def prepare() -> dict:
+    require(not FREEZE.exists() and not RESULT.exists() and not ROLLBACK.exists(), "dense_install_already_prepared")
+    require(sha_file(CONSUMER) == scope.CONSUMER_SHA, "dense_old_consumer_drift")
+    base = dense.base_images()
+    candidate = {**base, **{"internal/engineclient/" + name: dense.read(dense.SOURCE / name) for name in dense.DELTA}}
+    native = scope.accepted.K.old.native_map()
+    before = {name: sha_file(NATIVE / "internal/engineclient" / name) for name in LIVE}
+    require(before["dense_node_lookup.go"] == "absent" and not (NATIVE / "internal/engineclient/onheal_roots.go").exists(), "dense_foreign_live_shape")
+    desired = source_map(live_images())
+    expected_native = {**native, **{"internal/engineclient/" + k: v for k, v in desired.items()}}
+    plan = {"schema": "dense_node_install_v1", "limits": LIMITS,
+        "source_pins": pins(), "child_sha256": scope.sha(CHILD.encode()),
+        "consumer_before": scope.CONSUMER_SHA, "engine_sha256": scope.ENGINE_SHA,
+        "baseline_images": len(base), "baseline_map_sha256": scope.sha(dense.canonical(source_map(base))),
+        "candidate_images": len(candidate), "candidate_map_sha256": scope.sha(dense.canonical(source_map(candidate))),
+        "physical_exclusions": dense.physical_exclusions(),
+        "protected_before": scope.accepted.K.protected(), "native_before": native,
+        "native_after": expected_native, "live_before": before, "live_after": desired,
+        "dirty_before": dirty_map(), "python_sha256": sha_file(Path(sys.executable)),
+        "go_sha256": sha_file(gate.owned.GO_EXE), "cases": list(CASES),
+        "gate_order": "control4_build_install_verify_after_installed4_rollback_on_failure",
+        "scope": "representation-only AG delta; no HP/DPS/global quality acceptance"}
+    ROLLBACK.mkdir()
+    previous = ROLLBACK / "previous-gtt-optimizer.exe"
+    scope.accepted.runtime._write_once(previous, dense.read(CONSUMER))
+    require(sha_file(previous) == scope.CONSUMER_SHA, "dense_rollback_readback")
+    for name, expected in before.items():
+        if expected != "absent":
+            path = ROLLBACK / name
+            scope.accepted.runtime._write_once(path, dense.read(NATIVE / "internal/engineclient" / name))
+            require(sha_file(path) == expected, "dense_source_beforeimage_readback")
+    scope.cases.write_once(ROLLBACK / "beforeimages.json", {"consumer": scope.CONSUMER_SHA, "live": before})
+    scope.cases.write_once(FREEZE, plan)
+    return {"freeze": str(FREEZE), "sha256": sha_file(FREEZE), "candidate_images": len(candidate), "rollback": str(ROLLBACK)}
+
+
+def preserve(plan: dict, consumer: str, source_after: bool = True) -> None:
+    expected = dict(plan["protected_before"])
+    expected[str(CONSUMER)] = consumer
+    require(scope.accepted.K.protected() == expected, "dense_protected_drift")
+    require(scope.accepted.K.old.native_map() == plan["native_after" if source_after else "native_before"], "dense_native_drift")
+    current = dirty_map()
+    allowed = {rel(NATIVE / "internal/engineclient" / name) for name in LIVE} | {rel(CONSUMER)}
+    require(all(current.get(name, "absent") == sha for name, sha in plan["dirty_before"].items() if name not in allowed), "dense_foreign_dirty_drift")
+    require(pins() == plan["source_pins"], "dense_pin_drift")
+
+
+def rollback_sources(plan: dict) -> None:
+    for name in LIVE:
+        path = NATIVE / "internal/engineclient" / name
+        actual = sha_file(path)
+        require(actual in {plan["live_before"][name], plan["live_after"][name]}, "dense_source_rollback_cas")
+        if actual == plan["live_before"][name]:
+            continue
+        if plan["live_before"][name] == "absent":
+            path.unlink()
+        else:
+            raw = dense.read(ROLLBACK / name)
+            require(scope.sha(raw) == plan["live_before"][name], "dense_beforeimage_drift")
+            temp = path.with_name(path.name + ".dense-rollback-stage")
+            require(not temp.exists(), "dense_source_rollback_stage_exists")
+            scope.accepted.runtime._write_once(temp, raw)
+            os.replace(temp, path)
+    require(scope.accepted.K.old.native_map() == plan["native_before"], "dense_source_rollback_inexact")
+
+
+def stage_runtime(job: Path, plan: dict) -> Path:
+    images = dense.base_images()
+    images.update({"internal/engineclient/" + name: dense.read(dense.SOURCE / name) for name in dense.DELTA})
+    require(scope.sha(dense.canonical(source_map(images))) == plan["candidate_map_sha256"], "dense_build_closure_drift")
+    physical = set(scope.accepted.K.old.native_map())
+    require(physical - set(images) == set(plan["physical_exclusions"]), "dense_build_unknown_physical")
+    replace = {}
+    for name, raw in images.items():
+        target = job / "runtime-source" / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(raw)
+        replace[str(NATIVE / name)] = str(target)
+    replace.update({str(NATIVE / name): "" for name in plan["physical_exclusions"]})
+    overlay = job / "runtime-overlay.json"
+    scope.cases.write_once(overlay, {"Replace": replace})
+    require(json.loads(dense.read(overlay))["Replace"] == replace, "dense_overlay_readback")
+    return overlay
+
+
+def collect(job: Path, wire: dict, record: dict, arm: str) -> list[dict]:
+    rows = json.loads(dense.read(job / "button-gate-measurements.json"))
+    attempted = json.loads(dense.read(job / "preassert-observations.json"))
+    require(rows == attempted and len(rows) == 4, "dense_four_checked_cases_required")
+    root = job / ("profile-layout-" + "a" * 70) / ("saved-runs-" + "b" * 70)
+    counts = {"captures": 0, "ordinary_calls": 0, "support_calls": 0}
+    require(len(list(root.iterdir())) == 4, "dense_four_native_runs_required")
+    for name, row in zip(CASES, rows):
+        require(row["mode"] + ("_fast" if row["fast_mode"] else "_verified") == name, "dense_case_order")
+        require(row["fixture_sha256"] == "65fbb27fffe87acb25bed574a74a7547ae66b6bda25d02d99312c15de8966ba7", "dense_fixture_drift")
+        require(all(row["engine"].get(k) == v for k, v in wire.items()), "dense_engine_wire_drift")
+    for run in root.iterdir():
+        request = json.loads(dense.read(run / "request.json"))
+        output = json.loads(dense.read(run / "optimizer-output.json"))
+        opt = request["result_options"]
+        require(opt == {"set_group_limit": 1, "builds_per_group": 1, "fast_mode": opt["fast_mode"]}, "dense_button_options_drift")
+        require(request["stochastic"]["seeds"] == [742031889,742031890] and len(request["artifacts"]) == 20, "dense_button_input_drift")
+        if run.name.startswith("selected-"):
+            compact = json.loads(dense.read(run / "compact.json"))
+            require(len(compact["members"]) == 2, "dense_selected_capture_count")
+            counts["captures"] += 2
+        else:
+            n, timings = output.get("capture_members"), output.get("provider_timings")
+            require(type(n) is int and 2 <= n <= 98 and len(timings) == n and output.get("search_algorithm") == "neutral_event_effects", "dense_effect_capture_count")
+            sides = list(run.rglob("member.json.effects.json"))
+            require(len(sides) == n and all(p.stat().st_size > 0 for p in sides), "dense_actual_sidecars_required")
+            counts["captures"] += n
+        response = output.get("support_response", {})
+        require(response.get("status") in {"no_observed_gap_not_completeness", "unprobed_fast_mode", "unprobed_exact_finalist_limit"} and response.get("check") is None, "dense_unexpected_response_calls")
+        verification = output.get("verification")
+        if opt["fast_mode"]:
+            require(verification is None, "dense_fast_ordinary_call")
+        else:
+            require(verification["iterations"] == 500 and len(verification["candidates"]) == 1 and verification["candidates"][0]["iterations"] == 500, "dense_ordinary_budget")
+            counts["ordinary_calls"] += 1
+    require(counts["captures"] <= 200 and counts["ordinary_calls"] == 2, "dense_engine_budget")
+    counts["engine_calls"] = counts["captures"] + counts["ordinary_calls"]
+    record.setdefault("arms", {})[arm] = {"observations": rows, "counts": counts}
+    return rows
+
+
+def run(expected_sha: str) -> dict:
+    require(sha_file(FREEZE) == expected_sha, "dense_freeze_digest")
+    plan = json.loads(dense.read(FREEZE))
+    require(plan["schema"] == "dense_node_install_v1" and plan["limits"] == LIMITS and plan["source_pins"] == pins(), "dense_freeze_drift")
+    require(sha_file(Path(sys.executable)) == plan["python_sha256"] and sha_file(gate.owned.GO_EXE) == plan["go_sha256"], "dense_tool_drift")
+    require(not RESULT.exists() and not tuple(gate.managed.MANAGED_ROOT.glob("job-*")) and not gate.retirement._default_process_probe(ROOT), "dense_install_busy")
+    preserve(plan, scope.CONSUMER_SHA)
+    require(sha_file(ROLLBACK / "previous-gtt-optimizer.exe") == scope.CONSUMER_SHA, "dense_durable_rollback_drift")
+    started = time.monotonic()
+    record = {"schema": "dense_node_install_result_v1", "status": "started", "errors": [], "freeze_sha256": expected_sha,
+        "limits": LIMITS, "builds": 0, "installs": 0, "commands": {}, "arms": {}, "exports": {}}
+    active = [None]
+    with RESULT.open("xb") as stream:
+        def save(): gate.io._save(stream, record)
+
+        def export():
+            job = active[0]
+            if job is not None:
+                files = [p for p in job.rglob("*") if p.is_file() and not any(part in {"gocache", "gotmp", "runtime-source"} for part in p.relative_to(job).parts)
+                    and p.suffix in {".json", ".jsonl", ".txt", ".log"}]
+                require(sum(p.stat().st_size for p in files) <= LIMITS["export_bytes"], "dense_export_budget")
+                writer = dense.function_view(scope.accepted.complete.prior.retained._write_gzip_once, MAX_RAW_EXPORT_BYTES=96 << 20)
+                for path in files:
+                    raw = dense.read(path)
+                    key = path.relative_to(job).as_posix()
+                    digest = scope.sha(raw)
+                    token = scope.sha((key + digest).encode())[:24]
+                    if token not in record["exports"]:
+                        target = EVIDENCE / (PREFIX + "__" + token + ".gz")
+                        record["exports"][token] = {"relative_path": key, "archive": writer(raw, target)}
+            save()
+
+        def body(job: Path):
+            active[0] = job
+            binding = prior.stage_fixed_binding(job)
+            wire = json.loads(dense.read(binding))
+            record["engine_wire"] = wire
+            env, _ = gate.common._environment(job)
+            for name in ("gocache", "gotmp", "temp"):
+                (job / name).mkdir(exist_ok=True)
+            env.update(GOMAXPROCS="1", GTT_SCRATCH_DIR=str(job))
+            consumer_sha = [scope.CONSUMER_SHA]
+
+            def command(label, argv, maximum, local_env, cwd):
+                require(time.monotonic() - started + maximum + LIMITS["cleanup_reserve_seconds"] <= LIMITS["whole_seconds"], "dense_remaining_budget")
+                require(gate.common._tree_bytes(job) <= LIMITS["scratch_bytes"], "dense_scratch_budget")
+                preserve(plan, consumer_sha[0])
+                runner = dense.function_view(gate.owned._run_owned, optimizer_process_workdir=lambda _: cwd)
+                row = runner([str(v) for v in argv], command_kind="dense-install-" + label, env=local_env,
+                    log_path=job / (label + ".log"), timeout_seconds=maximum)
+                record["commands"][label] = row
+                export()
+                require(gate.command_passed(row), "dense_command_failed_" + label)
+                preserve(plan, consumer_sha[0])
+
+            def buttons(arm: str, anchor: Path | None):
+                local = button_gate_environment(job, ROOT / "data/gcsim/engines", CONSUMER)
+                local.update({k: v for k, v in env.items() if k in {"GOMAXPROCS", "GOTOOLCHAIN", "GOPROXY", "GOSUMDB"}})
+                local.update(GTT_OPTIMIZER_BUTTON_CASE="", GTT_DENSE_CONTROL=str(anchor) if anchor else "")
+                command(arm, [sys.executable, "-B", "-c", CHILD], LIMITS["arm_seconds"], local, ROOT)
+                return collect(job, wire, record, arm)
+
+            rows = buttons("control", None)
+            anchor = {"schema": "gtt_optimizer_button_baseline_v1", "fixture_sha256": rows[0]["fixture_sha256"],
+                "engine": {k: rows[0]["engine"][k] for k in ("engine_id", "artifact_sha256", "binding_sha256")},
+                "engine_full": rows[0]["engine"], "cases": {name: row for name, row in zip(CASES, rows)}}
+            anchor_path = job / "fresh-control-baseline.json"
+            scope.cases.write_once(anchor_path, anchor)
+            export()
+            # Move only these owned fixture directories inside the same checked
+            # job so the unchanged test can create its fresh candidate fixture.
+            for name in ("button-fixture", "profile-layout-" + "a" * 70):
+                source, target = job / name, job / ("control-" + name)
+                require(source.resolve().parent == job.resolve() and target.resolve().parent == job.resolve() and not target.exists(), "dense_fixture_move_scope")
+                source.rename(target)
+            overlay = stage_runtime(job, plan)
+            binary = job / "dense-gtt-optimizer.exe"
+            record["builds"] = 1
+            command("build", [gate.owned.GO_EXE, "-C", NATIVE, "build", "-p=1", "-mod=readonly", "-buildvcs=false",
+                "-overlay=" + str(overlay), "-o", binary, "./cmd/gtt-optimizer"], LIMITS["build_seconds"], env, NATIVE)
+            candidate_sha = sha_file(binary)
+            record["candidate_sha256"] = candidate_sha
+            scope.cases.write_once(ROLLBACK / "transaction.json", {"freeze_sha256": expected_sha, "previous_sha256": scope.CONSUMER_SHA,
+                "candidate_sha256": candidate_sha, "live_before": plan["live_before"], "live_after": plan["live_after"]})
+            export()
+
+            def verify_after():
+                consumer_sha[0] = candidate_sha
+                record["installs"] = 1
+                save()
+                buttons("installed-candidate", anchor_path)
+                preserve(plan, candidate_sha)
+                context, after_wire = scope.accepted.runtime.prepare_v4.candidate_binding(
+                    ROOT / "data/gcsim/engines/engines" / scope.accepted.runtime.ENGINE_ID)
+                require(context.artifact_sha256 == scope.ENGINE_SHA and after_wire == wire, "dense_final_engine_binding_drift")
+                record["verified_installed_sha256"] = sha_file(CONSUMER)
+                require(record["verified_installed_sha256"] == candidate_sha, "dense_installed_readback")
+                export()
+
+            with gate.retirement._project_mutation_locks(ROOT):
+                promotion_gate.install_candidate(binary, CONSUMER, job, old_sha=scope.CONSUMER_SHA,
+                    candidate_sha=candidate_sha, verify_after=verify_after)
+            record["status"] = "installed_verified_cleanup_pending"
+            export()
+
+        try:
