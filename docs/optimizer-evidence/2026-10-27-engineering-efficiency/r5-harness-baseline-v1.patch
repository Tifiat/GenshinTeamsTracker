+            "actor1": "scrolloftheheroofcindercity:4",
+            "actor2": "deepwoodmemories:4",
+            "actor3_tighnari": "deepwoodmemories:2+nighttimewhispersintheechoingwoods:2",
+            "context_sha256": "d1c033ae150dbd81a236707eacf6e3912517d520e5180770a5c58733997bec41",
+        },
+        "successor_winner": {
+            key: comparison["candidate_winner"][key]
+            for key in ("rank", "assignment_sha256", "config_sha256", "measured_dps", "formula_dps")
+        },
+        "saved_policy_counts": {
+            key: comparison[key]
+            for key in ("blocks_complete", "engine_short_calls_completed", "promotions", "actual_anchor_divergences")
+        },
+        "saved_candidate_search_metrics": comparison["candidate_metrics"],
+        "receipt_old_formula_leader_present_in_candidate_retained_rows": comparison[
+            "old_formula_leader_present_in_candidate_retained_rows"
+        ],
+        "coverage_limit": comparison["retained_rows_note"],
+        "omission_observation": (
+            "The old assignment is absent from the successor's retained finalists and retained search-work rows. "
+            "Its Tighnari package is absent from the actor3 proposals selected in blocks 4 and 8."
+        ),
+        "observed_actor3_selected_blocks": [4, 8],
+        "causal_attribution": (
+            "Unknown: the saved run has no full evaluated-point stream or raw pre-cap queue, so it cannot "
+            "distinguish not generated, pre-queue filtering, queue-cap exclusion, or evaluated then discarded. "
+            "The cap and engine feedback operated together; this pair does not isolate either effect."
+        ),
+    }
