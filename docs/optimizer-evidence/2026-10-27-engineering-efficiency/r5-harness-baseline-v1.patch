+def _compact_neutral_model_stats(value: Any) -> dict[str, Any] | None:
+    """Retain only typed, finite NeutralModelStats counters and elapsed seconds."""
+    if not isinstance(value, Mapping):
+        return None
+
+    output: dict[str, Any] = {}
+
+    def copy_number(target: dict[str, Any], key: str, raw: Any, *, region_count: bool = False) -> None:
+        if key in _NEUTRAL_MODEL_SECONDS_KEYS:
+            if type(raw) not in (int, float) or raw < 0:
+                return
+            try:
+                if not math.isfinite(float(raw)):
+                    return
+            except (OverflowError, ValueError):
+                return
+            target[key] = raw
+            return
+        maximum = (1 << 64) - 1 if region_count else (1 << 63) - 1
+        if type(raw) is int and 0 <= raw <= maximum:
+            target[key] = raw
+
+    for key in _NEUTRAL_MODEL_COUNT_FIELDS:
+        if key in value:
+            copy_number(output, key, value[key])
+    for key in _NEUTRAL_MODEL_SECONDS_FIELDS:
+        if key in value:
+            copy_number(output, key, value[key])
+    for section, keys in _NEUTRAL_MODEL_NESTED_FIELDS.items():
+        raw_section = value.get(section)
+        if not isinstance(raw_section, Mapping):
+            continue
+        compact_section: dict[str, Any] = {}
+        for key in keys:
+            if key in raw_section:
+                copy_number(
