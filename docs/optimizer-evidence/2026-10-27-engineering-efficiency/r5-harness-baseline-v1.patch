+def compare_saved(payload):
+    saved = json.loads(gzip.decompress((k.EVIDENCE / "final-pair-whole-candidate-projection.json.gz").read_bytes()))
+    project = lambda value: k.gate.semantic(value)
+    a, b = project(saved["projection"]), project(payload["projection"])
+    left, right = a["search_work"], b["search_work"]
+    first = next((i for i, (x, y) in enumerate(zip(left, right)) if x != y), None)
+    if first is None and len(left) != len(right):
+        first = min(len(left), len(right))
+    return {"saved_projection_sha256": k.gate.digest(a), "observed_projection_sha256": k.gate.digest(b),
+            "ordered_projection_equal_except_timing": a == b,
+            "saved_work_rows": len(left), "observed_work_rows": len(right), "first_work_difference": first,
+            "search_metrics_equal": saved["search_metrics"] == payload["search_metrics"],
+            "saved_metrics": saved["search_metrics"], "observed_metrics": payload["search_metrics"],
+            "policy_equal_except_timing": project(saved["policy"]) == project(payload["policy"]),
+            "saved_policy_samples": saved["policy"]["samples"], "observed_policy_samples": payload["policy"]["samples"],
+            "interpretation": "Independent policy simulations can diverge; this alone proves neither an instrumentation regression nor quality equivalence."}
