+B_ROLLBACK_BINARY_REL = "native/gcsim_optimizer/gtt-optimizer.exe.pre-native-performance-b-20261015.rollback"
+B_ROLLBACK_MANIFEST_REL = B_ROLLBACK_BINARY_REL + ".json"
+CONSUMER_REL = "native/gcsim_optimizer/gtt-optimizer.exe"
+ENGINE_REL = (
+    "data/gcsim/engines/engines/"
+    "gcsim-v2.45.0-support-impact-20261014/build/gtt-gcsim.exe"
+)
+POINTER_REL = "data/gcsim/engines/active_engine.json"
+RECIPE_REL = "docs/optimizer-evidence/2026-10-15-mvp-polish/native-performance-install-recipe.json"
+B_RECIPE_REL = "docs/optimizer-evidence/2026-10-15-mvp-polish/native-performance-b-install-recipe.json"
+
+OLD_SHA256 = "798f2c1b2a9e5f3b9e164b7713a0658dac8314b85478db6da3dc12bb51cb050d"
+OLD_BYTES = 9_970_688
+CANDIDATE_SHA256 = "ae4d54e521b73355908da1e236fcf6e64dee830800150f59f5a13ed3b7705470"
+CANDIDATE_BYTES = 9_969_152
+B_CANDIDATE_SHA256 = "2e3ed8c58c7dbaf70d63a6b89bde9a2792072861d71d0f3f75129f620476734a"
+B_CANDIDATE_BYTES = 9_988_608
+PREDECESSOR_MANIFEST_SHA256 = "ab8537ddb9d1a1d719db50c5e008f33b32b8672d5d52439a5ac37cb879bcb3ee"
+PREDECESSOR_RECIPE_SHA256 = "47feed570a1d1a076477aa0336939721f312804c3f809ab2bf24d120a25741a7"
+ENGINE_ID = "gcsim-v2.45.0-support-impact-20261014"
+ENGINE_SHA256 = "25576ff110878ec356da2dea7daf33a893e4d65b3efadbd133665e9a4e92978e"
