+"""Common unprofiled, policy-enabled E/control and exact-reuse replay observer.
+
+Both arms receive the same light wall clock and omit only the post-search n500
+panel. Existing profiling code supplies the clock type; no CPU profiler is used.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from tools.experiments.gcsim.mvp_polish import preparation_exact_reuse as candidate
+from tools.experiments.gcsim.mvp_polish import e_whole_profile as clocks
+from tools.experiments.gcsim.mvp_polish import final_pair_whole as original
+from tools.experiments.gcsim.mvp_polish import final_stagnation_pair_completion as patching
+
+k = original.k
+SOURCE_FILES = tuple(dict.fromkeys((*candidate.SOURCE_FILES, Path(__file__),
+                                  Path(clocks.__file__), clocks.PROFILE_HELPER)))
+
+
+def _helper(raw):
+    source = raw.decode()
+    restores = []
+    def replace(before, after):
+        nonlocal source
+        source = patching._replace_once(source, before, after, restores)
+    before = ('\tif !filepath.IsAbs(repo) || !filepath.IsAbs(job) || filepath.Clean(repo) == filepath.Clean(job) || (role != "baseline" && role != "candidate") {\n'
+              '\t\tt.Fatal("archive_environment_invalid")\n\t}\n')
+    replace(before, before + '''
+    arm := os.Getenv("GTT_PREPARATION_REUSE_ARM")
+    if role != "candidate" || (arm != "control" && arm != "candidate") { t.Fatal("reuse_arm_invalid") }
+    job = filepath.Join(job, arm)
+    if err := os.Mkdir(job, 0700); err != nil { t.Fatal("reuse_arm_directory_failed") }
+    researchPreparationExactReuseEnabled = arm == "candidate"
+    researchEWholeProfile = &eWholeProfileState{}
+    t.Cleanup(func() { researchPreparationExactReuseEnabled = false; researchEWholeProfile = nil })
+''')
+    replace('''    result, runErr := RunNeutral(ctx, index, base, sources, provider, saved.Config)
+\trunSeconds := time.Since(started).Seconds()
+''', '''    result, runErr := RunNeutral(ctx, index, base, sources, provider, saved.Config)
+\trunSeconds := time.Since(started).Seconds()
+    wallProfile, wallProfileErr := researchEWholeProfile.clock.partition(runSeconds, runErr)
+''')
+    replace('''\t\t"projection": projection, "performance": result.NeutralModel}
+''', '''\t\t"projection": projection, "performance": result.NeutralModel}
+    payload["experiment_arm"] = arm
+    payload["cpu_profiler_started"] = false
+    payload["wall_profile"] = wallProfile
+    payload["nested_coordinator_timers"] = map[string]any{"neutral_seed_seconds":result.NeutralSeedSeconds, "proposal_seconds":result.ProposalSeconds, "neutral_joint_seconds":result.NeutralJointSeconds, "reported_total_seconds_before_finalizer":result.TotalSeconds}
+    if wallProfileErr != nil { payload["wall_profile_error"] = wallProfileErr.Error(); payload["complete"] = false; if runErr == nil { runErr = wallProfileErr } }
+''')
+    before = '''    if runErr==nil && ctx.Err()==nil {
+      verifyStarted:=time.Now()
+      verified,verifyErr:=adaptiveVerify(t,ctx,req,base,result,job,role)
+      payload["final_verification_seconds"]=time.Since(verifyStarted).Seconds()
+      payload["verification"]=verified
+      if verifyErr!=nil { payload["verification_failure"]=verifyErr.Error(); payload["complete"]=false;runErr=verifyErr }
+    }
+'''
+    replace(before, '''    payload["final_verification_seconds"] = 0.0
+    payload["verification"] = map[string]any{"disabled_for_profile":true, "result":map[string]any{"candidates":[]any{}}}
+''')
+    if len(restores) != 4 or patching._erase(source, restores).encode() != raw:
+        raise ValueError("matched replay observation does not erase to exact E")
+    if "StartCPU(" in source or "runEWholeProfiledNeutral(" in source:
+        raise ValueError("matched replay unexpectedly uses CPU profiling")
+    return source.encode()
+
+
+def matched_overlay():
+    base = candidate.preparation_exact_reuse_overlay()
+    images, overlays = dict(base["images"]), dict(base["overlay_files"])
+    path = "internal/allsets/neutral_coordinator.go"
+    unprofiled = original.final_pair_whole_overlay()
+    observed, erased = clocks._coordinator_image(unprofiled["images"][path])
+    if erased != unprofiled["images"][path]:
+        raise ValueError("common wall clock does not erase to exact E coordinator")
+    expected, erased_candidate = candidate._coordinator_image(observed)
+    if erased_candidate != observed or images[path] != expected:
+        raise ValueError("candidate coordinator differs from exact common wall observation plus opt-in")
+    helper_path = "internal/allsets/zz_adaptive_replay_test.go"
+    overlays[helper_path] = _helper(unprofiled["overlay_files"][helper_path])
+    overlays["internal/allsets/zz_e_whole_profile_test.go"] = clocks.PROFILE_HELPER.read_bytes()
+    hashes = dict(base["hashes"])
+    hashes.update(matched_source_map_sha256=k.gate.digest({p:k.sha(raw) for p,raw in images.items()}),
+                  matched_overlay_sha256=k.gate.digest({p:k.sha(raw) for p,raw in overlays.items()}),
+                  matched_replay_helper_sha256=k.sha(overlays[helper_path]),
+                  matched_observer_coordinator_sha256=k.sha(images[path]))
+    return {**base, "images": images, "overlay_files": overlays, "hashes": hashes,
+            "metadata": {"candidate":base["metadata"], "cpu_profile":False,
+                         "arms":["control","candidate"], "policy_enabled_both":True,
+                         "control_flag":False, "candidate_flag":True,
+                         "common_observer":"same nine disjoint wall intervals; no CPU profiler",
+                         "final_n500_both":0, "common_wall_observer_exact_reuse":True,
+                         "matched_replay_erasure_to_unprofiled_E":True},
+            "source_files":tuple(dict.fromkeys((*base["source_files"], *SOURCE_FILES)))}
