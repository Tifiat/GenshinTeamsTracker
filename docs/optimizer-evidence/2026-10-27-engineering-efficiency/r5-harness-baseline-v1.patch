+        ),
+        "helper_sha256": replay.k.sha(helper),
+        "policy_sha256": replay.k.sha(policy),
+        "verification_sha256": replay.k.sha(verification),
+    }
+    overlay_files = {
+        "internal/allsets/zz_adaptive_replay_test.go": helper,
+        "internal/allsets/zz_adaptive_policy_test.go": policy,
+        "internal/allsets/zz_adaptive_verification_test.go": verification,
+    }
+    return {
+        "images": images,
+        "helper": helper,
+        "policy": policy,
+        "verification": verification,
+        "overlay_files": overlay_files,
+        "hashes": hashes,
+        "metadata": {
+            "schema": "adaptive_no_feedback_overlay_v1",
+            "baseline_arm": False,
+            "feedback_enabled": False,
+            "queue_width": 16,
+            "queue_selection": {"formula": 8, "known_spread": 4, "set_diverse": 4},
+            "neutral_cycles": 2,
+            "ordinary_engine_policy_calls": 0,
+            "ordinary_engine_policy_outcome": "disabled_by_ablation",
+            "final_verification_calls": 9,
+            "final_verification_iterations": 500,
+            "final_verification_workers": 4,
+            "protect_initial_candidate": True,
+            "engine_outcome": "disabled_by_ablation",
+            "policy_change": "formula fallback anchors every block; queue feedback selection and final protection remain unchanged",
+        },
+    }
+
+
+def saved_omission_diagnostic() -> dict[str, Any]:
+    """Return a compact, JSON-serializable diagnosis from the saved pair receipt."""
+    evidence = replay.k.EVIDENCE / "adaptive-hybrid-comparison.json"
+    comparison = json.loads(evidence.read_text(encoding="utf-8"))
