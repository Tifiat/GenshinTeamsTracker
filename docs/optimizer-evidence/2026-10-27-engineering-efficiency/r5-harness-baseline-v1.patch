+"""Accepted-source-only model preparation delta and matched saved replay overlay."""
+from __future__ import annotations
+from pathlib import Path
+from tools.experiments.gcsim.mvp_polish import wire_amount_overlay as wire
+
+saved, HERE = wire.saved, Path(__file__).parent
+patch = saved.producer.patch_source
+PREFIX = "model-preparation-v4"
+WORLD, AMOUNT = HERE / "model_world_cache.go", HERE / "model_amount_query.go"
+
+
+def world_delta(images):
+    images = dict(images)
+    name = "internal/seteffects/rule_replay.go"
+    images[name] = patch(images[name], [
+        ("\tworldView               ruleWorldView", "\tworldCache              *ruleWorldCache\n\tworldView               ruleWorldView"),
+        ("\tout = RuleReplay{Values: make([]RuleValue, len(queries)), Uncertainty: []string{}}", "\treturn c.replayNeutralRulesBound(neutral, choices, queries, symbolic, preparedOrder, nil)\n}\nfunc (c *SourceCatalog) replayNeutralRulesBound(neutral *contracts.NeutralInputs, choices []RuleChoice, queries []RuleQuery, symbolic bool, preparedOrder []int, worldCache *ruleWorldCache) (out RuleReplay) {\n\tout = RuleReplay{Values: make([]RuleValue, len(queries)), Uncertainty: []string{}}"),
+        ("\th.worldAt(neutral.World, 1)", "\th.worldCache = worldCache\n\th.worldAt(neutral.World, 1)"),
+        ("\tvar state []RuleState\n", "\tif cached, ok := h.worldCache.lookup(world, i); ok {\n\t\th.worldView = cached\n\t\th.facts, h.state, h.targets = cached.facts, cached.state, cached.targets\n\t\th.stateComplete = true\n\t\treturn\n\t}\n\tvar state []RuleState\n"),
+        ("\th.facts, h.state, h.targets = h.worldView.facts, h.worldView.state, h.worldView.targets", "\th.worldCache.remember(h.worldView)\n\th.facts, h.state, h.targets = h.worldView.facts, h.worldView.state, h.worldView.targets"),
+    ])
+    name = "internal/seteffects/neutral_binding.go"
+    images[name] = patch(images[name], [
+        ("type neutralBoundMember struct {", "type neutralBoundMember struct {\n\tworldCache *ruleWorldCache"),
+        ("b.catalog.replayNeutralRulesPrepared(member.neutral, choices, queries, false, order)", "b.catalog.replayNeutralRulesBound(member.neutral, choices, queries, false, order, member.worldCache)"),
+    ])
+    name = "internal/seteffects/neutral_expressions.go"
+    images[name] = patch(images[name], [("b.catalog.replayNeutralRulesPrepared(member.neutral, choices, queries, true, order)", "b.catalog.replayNeutralRulesBound(member.neutral, choices, queries, true, order, member.worldCache)")])
+    name = "internal/setcontext/neutral.go"
+    images[name] = patch(images[name], [("\th.compiled.effectCapture = nil", "\tbinding.EnableOwnedWorldViewReuse()\n\th.compiled.effectCapture = nil")])
+    images["internal/seteffects/rule_world_views.go"] = WORLD.read_bytes()
+    return images
+
+
+def product_images():
+    images = saved.dense.base_images()
+    # Installed AH closure, including the accepted health guard/onheal roots.
+    images.update({"internal/engineclient/" + n: saved.dense.read(saved.dense.SOURCE / n) for n in saved.dense.DELTA})
+    images = world_delta(images)
+    name = "internal/seteffects/rule_replay.go"
+    old = '''\t\targs := []any{}
+\t\tswitch q.Kind {
+\t\tcase "attack":
+\t\t\ttyp := strings.TrimPrefix(h.targets[q.Target].Type, "*")
+\t\t\targs = []any{h.wire(q.Attack), ruleRef{kind: "target", index: q.Target, typ: typ}}
+\t\tcase "reaction":
+\t\t\targs = []any{h.wire(q.Attack)}
+\t\t}
+\t\tbefore := len(h.mods)
+\t\tvalue, err := h.amount(m, q, args)'''
+    images[name] = patch(images[name], [(old, "\t\tbefore := len(h.mods)\n\t\tvalue, err := h.queryAmount(m, q)")])
+    images["internal/seteffects/rule_amount_query.go"] = AMOUNT.read_bytes()
+    return images
+
+
+def overlay(candidate: bool):
+    o = wire.overlay(candidate)
+    images, extras = dict(o["images"]), dict(o["extras"])
+    if candidate: images = world_delta(images)
+    name = "internal/seteffects/rule_replay.go"
+    images[name] = patch(images[name], [
+        ("func (h *ruleReplayHost) worldAt(world *contracts.NeutralWorldLedger, order uint64) {", "func (h *ruleReplayHost) worldAt(world *contracts.NeutralWorldLedger, order uint64) {\n\tresearchWorldCalls.Add(1)"),
+        ("\tvar state []RuleState\n", "\tresearchWorldConversions.Add(1)\n\tvar state []RuleState\n"),
+    ])
+    if candidate:
+        name = "internal/seteffects/rule_world_views.go"
+        images[name] = patch(images[name], [
+            ("if len(c.views) >= ruleWorldCacheEntries || units > ruleWorldCacheUnits-c.units { return }", "if len(c.views) >= ruleWorldCacheEntries || units > ruleWorldCacheUnits-c.units { researchWorldCapped.Add(1); return }"),
+            ("c.units += units", "c.units += units\n\tresearchWorldEntries.Add(1); researchWorldUnits.Add(int64(units))"),
+        ])
+    extras["internal/seteffects/zz_model_measure.go"] = b"package seteffects\nimport \"sync/atomic\"\nvar researchWorldCalls, researchWorldConversions, researchWorldEntries, researchWorldUnits, researchWorldCapped atomic.Int64\nfunc ResearchWorldReset(){researchWorldCalls.Store(0);researchWorldConversions.Store(0);researchWorldEntries.Store(0);researchWorldUnits.Store(0);researchWorldCapped.Store(0)}\nfunc ResearchWorldStats()map[string]int64{return map[string]int64{\"calls\":researchWorldCalls.Load(),\"conversions\":researchWorldConversions.Load(),\"cumulative_retained_entries\":researchWorldEntries.Load(),\"cumulative_retained_slots\":researchWorldUnits.Load(),\"cap_skips\":researchWorldCapped.Load()}}\n"
+    helper = extras["internal/allsets/zz_preparation_v2_measure_test.go"].decode()
+    helper = helper.replace("seteffects.ResearchWireReset(); start:=", "seteffects.ResearchWorldReset(); seteffects.ResearchWireReset(); start:=")
+    helper = helper.replace('"wire_metrics":seteffects.ResearchWireSnapshot()', '"world_metrics":seteffects.ResearchWorldStats(),"wire_metrics":seteffects.ResearchWireSnapshot()')
+    helper = helper.replace(' "runtime/pprof"', ' "runtime"\n "runtime/pprof"')
+    helper = helper.replace('seteffects.ResearchWorldReset();', 'var modelMemBefore,modelMemAfter runtime.MemStats;runtime.ReadMemStats(&modelMemBefore);seteffects.ResearchWorldReset();')
+    helper = helper.replace('runSeconds:=time.Since(start).Seconds()', 'runSeconds:=time.Since(start).Seconds();runtime.ReadMemStats(&modelMemAfter)')
+    helper = helper.replace('"world_metrics":seteffects.ResearchWorldStats()', '"memory_metrics":map[string]uint64{"allocated_bytes":modelMemAfter.TotalAlloc-modelMemBefore.TotalAlloc,"allocations":modelMemAfter.Mallocs-modelMemBefore.Mallocs,"heap_before":modelMemBefore.HeapAlloc,"heap_after":modelMemAfter.HeapAlloc},"world_metrics":seteffects.ResearchWorldStats()')
+    extras["internal/allsets/zz_preparation_v2_measure_test.go"] = helper.encode()
+    return {"images": images, "extras": extras,
+        "image_map_sha256": saved.scope.sha(saved.dense.canonical(saved.dense.image_hashes(images))),
+        "extra_map_sha256": saved.scope.sha(saved.dense.canonical(saved.dense.image_hashes(extras)))}
diff --git a/tools/experiments/gcsim/mvp_polish/model_preparation_install.py b/tools/experiments/gcsim/mvp_polish/model_preparation_install.py
