+def _warning_fact_identity(value: Any) -> str:
+    fact = {**value, "code": _warning_code(value)} if isinstance(value, Mapping) else {"code": _warning_code(value)}
+    return json.dumps(_warning_fact_value(fact), sort_keys=True, ensure_ascii=False, separators=(",", ":"), default=repr)
+
+
+def _warning_fact_value(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {key: _warning_fact_value(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_warning_fact_value(item) for item in value]
+    if type(value) is float and value.is_integer():
+        return int(value)
+    return value
