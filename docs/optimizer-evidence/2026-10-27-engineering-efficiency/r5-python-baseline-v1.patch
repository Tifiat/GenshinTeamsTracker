+def _fetch_all_rows_readonly(
+    path: Path,
+) -> tuple[
+    tuple[str, ...],
+    tuple[str, ...],
+    tuple[tuple[tuple[str, SqliteScalar], ...], ...],
+    tuple[tuple[tuple[str, SqliteScalar], ...], ...],
+    tuple[tuple[int, int, str], ...],
