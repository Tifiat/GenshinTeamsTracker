-    *,
-    fingerprint: str,
-    content_fingerprint: str | None = None,
-    source_content_fingerprint: str | None = None,
-    relic_id: int | None,
-    name: str,
-    set_id: int | None,
-    set_name: str | None,
-    set_uid: str | None,
