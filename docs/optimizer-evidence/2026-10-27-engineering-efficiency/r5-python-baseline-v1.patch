+def _format_optimizer_elapsed(elapsed_ms: int) -> str:
+    total_seconds = max(0, int(elapsed_ms) // 1000)
+    hours, remainder = divmod(total_seconds, 3600)
+    minutes, seconds = divmod(remainder, 60)
+    if hours:
