+def count_json_imported_artifacts(
+    conn: sqlite3.Connection,
+    *,
+    source: str | None = "artiscan",
+) -> int:
+    clauses = ["json_imported = 1"]
+    params: list[Any] = []
+    if source:
+        clauses.append("import_source = ?")
+        params.append(source)
+
+    row = conn.execute(
+        f"""
+        SELECT COUNT(*) AS count
+        FROM artifacts
