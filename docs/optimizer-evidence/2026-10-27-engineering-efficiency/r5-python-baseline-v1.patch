-    rarity: int | None,
-    level: int | None,
-    main_property_type: int | None,
-    main_property_name: str | None,
-    main_property_value: str | None,
-    import_source: str | None = None,
-    import_format: str | None = None,
-    import_batch_id: int | None = None,
-    json_imported: bool | None = None,
-    observed_artifact_ids: set[int] | None = None,
-    preferred_artifact_id: int | None = None,
-) -> tuple[int, bool]:
-    now = utc_now()
-
-    observed_ids = observed_artifact_ids or set()
-    existing = None
-    if source_content_fingerprint:
-        candidates = conn.execute(
-            """
-            SELECT id, fingerprint
-            FROM artifacts
-            WHERE source_content_fingerprint = ?
-            ORDER BY id
-            """,
-            (source_content_fingerprint,),
-        ).fetchall()
-        candidates = [row for row in candidates if row["id"] not in observed_ids]
-        exact_fingerprint_candidates = [
-            row
-            for row in candidates
-            if row["fingerprint"] == fingerprint
-            or str(row["fingerprint"]).startswith(f"{fingerprint}:observed-copy:")
