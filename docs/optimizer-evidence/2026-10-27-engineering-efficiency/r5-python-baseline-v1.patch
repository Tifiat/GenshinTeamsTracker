+            report = report_with_smoke(report, smoke)
+        payload = report.to_dict()
+    except Exception as exc:
+        return _with_readiness_summary(
+            {
+                "success": False,
+                "error_category": ERROR_CONFIG_PREPARE_ERROR,
+                "error": str(exc),
