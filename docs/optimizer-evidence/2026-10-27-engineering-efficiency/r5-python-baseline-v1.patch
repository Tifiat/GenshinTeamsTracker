+    def _shutdown_gcsim_run(self, *, wait_ms: int | None = 3000) -> bool:
+        thread = self._gcsim_browser_run_thread
+        if thread is None or not thread.isRunning():
+            return True
+        cancel = getattr(self._gcsim_browser_run_worker, "cancel", None)
+        if callable(cancel):
+            cancel()
+        # Explicit quit avoids relying on a finished->quit callback queued to
+        # this GUI thread while it is waiting for the worker to unwind.
+        thread.requestInterruption()
+        thread.quit()
+        return bool(thread.wait() if wait_ms is None else thread.wait(wait_ms))
+
+    def closeEvent(self, event) -> None:  # noqa: N802 - Qt override
+        thread = self._gcsim_browser_run_thread
+        if thread is not None and thread.isRunning() and not self._gcsim_shutdown_close_pending:
+            self._gcsim_shutdown_close_pending = True
+            # Subscribe before cancellation/join: completion can occur at the
+            # timeout boundary, before wait() reports that it did not join.
+            thread.finished.connect(self._retry_gcsim_shutdown_close)
+        if not self._shutdown_gcsim_run():
+            if thread is not None and thread.isRunning():
+                event.ignore()
+                return
+        self._gcsim_shutdown_close_pending = False
+        super().closeEvent(event)
+
+    def _retry_gcsim_shutdown_close(self) -> None:
+        # A queued finished signal may arrive after close was already accepted
+        # or after the thread's deferred deletion; no thread access is needed.
+        if self._gcsim_shutdown_close_pending:
+            self.close()
+
+    def _on_application_quit(self) -> None:
+        # aboutToQuit cannot veto application teardown. Retain and join the
+        # QThread until its cancelled worker exits; never terminate QThread.
+        self._shutdown_gcsim_run(wait_ms=None)
 
