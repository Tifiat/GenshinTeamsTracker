+
+            PRIMARY KEY (build_id, pos),
+            FOREIGN KEY (build_id) REFERENCES artifact_builds(id) ON DELETE CASCADE,
+            FOREIGN KEY (artifact_id) REFERENCES artifacts(id) ON DELETE CASCADE
+        );
