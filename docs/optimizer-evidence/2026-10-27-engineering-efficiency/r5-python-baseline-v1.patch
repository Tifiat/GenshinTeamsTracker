+def _setup_comment_spans(document, setups):
+    """Return comments attached to removed setup statements by source position.
+
+    Comments inside another statement belong to that statement. A same-line
+    comment after setup belongs to setup; a standalone comment belongs to the
+    next top-level statement, so setup headings are removed while comments
+    before functions, active declarations, and actions remain.
+    """
+    items = tuple(item for item in document.root.get("items") if item.span is not None)
+    setup_ids = {item.node_id for item in setups}
+    comments = []
+    previous_index = -1
+    following_index = 0
+    for token in document.trivia:
+        if token.kind != "comment":
+            continue
+        while following_index < len(items) and items[following_index].span.end <= token.span.start:
+            previous_index = following_index
+            following_index += 1
+        following_candidate = items[following_index] if following_index < len(items) else None
+        containing = (following_candidate if following_candidate is not None
+                      and following_candidate.span.contains(token.span) else None)
+        if containing is not None:
+            # Setup spans are removed in full; comments inside executable
+            # functions/blocks are part of the preserved rotation.
+            continue
+
+        previous = items[previous_index] if previous_index >= 0 else None
+        following = (following_candidate if following_candidate is not None
+                     and following_candidate.span.start >= token.span.end else None)
+        if previous is not None and previous.node_id in setup_ids and _same_line(
+                document.source, previous.span.end, token.span.start):
+            comments.append(token.span)
+            continue
+        if previous is not None and _same_line(document.source, previous.span.end, token.span.start):
+            # Preserve a trailing comment on a non-setup statement even when
+            # the next top-level statement happens to be a setup declaration.
+            continue
+        if following is not None and following.node_id in setup_ids:
+            comments.append(token.span)
+    return tuple(comments)
+
+
+def _same_line(source, left, right):
+    return "\n" not in source[left:right] and "\r" not in source[left:right]
 
 
