+        uri=True,
+        timeout=5.0,
+    )
+    try:
+        connection.execute("PRAGMA query_only = ON")
+        connection.execute("BEGIN")
+        return _fetch_all_rows_from_connection(connection)
+    finally:
+        try:
+            if connection.in_transaction:
+                connection.rollback()
+        finally:
+            connection.close()
