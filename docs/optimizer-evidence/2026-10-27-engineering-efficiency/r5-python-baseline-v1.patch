--- /dev/null
+++ b/run_workspace/gcsim/mechanic_diagnostics.py
@@ -0,0 +1,86 @@
+"""Resolved frozen-mechanic diagnostics path and narrowly scoped user cleanup."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import re
+import stat
+
+from .optimizer_run_retention import DEFAULT_GO_RUN_ROOT
+
+
+_OWNED_RECORD = re.compile(r"^[0-9a-f]{64}\.json$")
+_OWNED_TEMP = re.compile(r"^\.mechanic-tmp-[A-Za-z0-9]+$")
+_REPARSE_POINT = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400)
+
+
+def frozen_mechanics_directory(*, scratch_dir: str | Path | None = None) -> Path:
+    """Return the logger's absolute directory without creating it."""
+
+    if scratch_dir:
+        base = Path(scratch_dir).expanduser().absolute()
+    else:
+        base = DEFAULT_GO_RUN_ROOT.parent
+    return base / "optimizer-diagnostics" / "frozen-mechanics"
+
+
+def _is_link(info: os.stat_result) -> bool:
+    return stat.S_ISLNK(info.st_mode) or bool(
+        getattr(info, "st_file_attributes", 0) & _REPARSE_POINT
+    )
+
+
+def _require_unlinked_ancestors(directory: Path) -> None:
+    current = directory
+    while True:
+        try:
+            info = current.lstat()
+        except FileNotFoundError:
+            pass
+        else:
+            if _is_link(info) or not stat.S_ISDIR(info.st_mode):
+                raise ValueError("frozen mechanics path contains a linked or non-directory component")
+        if current == current.parent:
+            break
+        current = current.parent
+
+
+def create_frozen_mechanics_directory(directory: str | Path) -> Path:
+    """Create the own folder for an explicit Open action only."""
+
+    root = Path(directory).absolute()
+    _require_unlinked_ancestors(root)
+    root.mkdir(parents=True, exist_ok=True)
+    _require_unlinked_ancestors(root)
+    return root
+
+
+def clear_frozen_mechanics(directory: str | Path) -> int:
+    """Delete only direct native-store records and temporary files."""
+
+    root = Path(directory).absolute()
+    try:
+        root_info = root.lstat()
+    except FileNotFoundError:
+        return 0
+    if _is_link(root_info) or not stat.S_ISDIR(root_info.st_mode):
+        raise ValueError("frozen mechanics directory must be a real directory")
+    _require_unlinked_ancestors(root)
+    removed = 0
+    with os.scandir(root) as entries:
+        for entry in entries:
+            if not (_OWNED_RECORD.fullmatch(entry.name) or _OWNED_TEMP.fullmatch(entry.name)):
+                continue
+            info = entry.stat(follow_symlinks=False)
+            if _is_link(info) or not stat.S_ISREG(info.st_mode):
+                continue
+            Path(entry.path).unlink()
+            removed += 1
+    return removed
+
+
+__all__ = [
+    "frozen_mechanics_directory", "create_frozen_mechanics_directory",
+    "clear_frozen_mechanics",
+]
