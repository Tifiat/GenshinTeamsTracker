+def evaluate_gcsim_optimizer_artifact_eligibility(
+    artifact: GcsimOptimizerArtifactRecord,
+    *,
+    wearer: GcsimOptimizerWearerIdentity,
+    four_star_override: (
+        GcsimOptimizerFourStarEligibilityOverride | None
+    ) = None,
+    package_set_uids: Iterable[str] = (),
