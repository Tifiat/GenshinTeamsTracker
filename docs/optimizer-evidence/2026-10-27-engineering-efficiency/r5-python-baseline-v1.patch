+def format_optimizer_warnings(values: Any) -> tuple[str, ...]:
+    """Group localized messages while retaining distinct diagnostic facts.
+
+    Fact identity is determined before localization. Arbitrary receipt details
+    stay in diagnostics; a stable fingerprint distinguishes their evidence.
+    """
+    from localization import tr
+
+    groups: dict[str, list[tuple[Any, str]]] = {}
+    seen: set[str] = set()
+    for value in values or ():
+        identity = _warning_fact_identity(value)
+        if identity in seen:
+            continue
+        seen.add(identity)
+        groups.setdefault(format_optimizer_warning(value), []).append((value, identity))
+    result = []
+    for message, facts in groups.items():
+        if len(facts) > 1 or any(_warning_needs_fact_label(value) for value, _ in facts):
+            labels = "; ".join(_warning_fact_label(value, identity) for value, identity in facts)
+            message += "\n" + tr("gcsim.optimizer.warning.diagnostic_facts").format(facts=labels)
+        result.append(message)
+    return tuple(result)
+
