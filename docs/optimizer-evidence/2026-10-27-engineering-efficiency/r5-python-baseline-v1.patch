+
+ERROR_LOCALE_KEYS = frozenset({GENERIC_ERROR_KEY, *ERROR_CODE_KEYS.values()})
+ISSUE_LOCALE_KEYS = frozenset({UNKNOWN_ISSUE_KEY, *ISSUE_CODE_KEYS.values()})
+
+_PARENT_ISSUE_CODES = frozenset({"character_block_not_ready"})
+_GENERIC_MAPPING_ISSUE_CODES = frozenset({"missing_mapping"})
+_SPECIFIC_MAPPING_CODES = frozenset(
+    {
+        "ambiguous_mapping",
+        "artifact_set_canonical_mapping_missing",
+        "artifact_set_gcsim_key_not_ready",
+        "character_gcsim_key_not_ready",
+        "virtual_character_gcsim_key_missing",
+        "weapon_gcsim_key_not_ready",
+    }
+)
+_ISSUE_CONTAINERS = (
+    "issues",
+    "full_config",
+    "assembly",
+    "prepared_team",
+    "characters",
+    "blocks",
+    "details",
+)
+
+
+def format_optimizer_error(payload: Mapping[str, Any]) -> str:
+    """Return a user-safe localized reason for an optimizer failure payload.
+
+    payload.error is deliberately not rendered: it can contain Python object
+    representations, process stderr, paths, or other diagnostic detail.
+    """
+
+    raw_code = payload.get("error_code")
+    code = raw_code.strip() if isinstance(raw_code, str) else ""
+    locale_key = ERROR_CODE_KEYS.get(code, GENERIC_ERROR_KEY)
+    details = payload.get("error_details")
+
+    if code == "selected_set_package_unsupported":
+        actor = _safe_actor(details)
+        return tr(locale_key, actor=f"{actor}: " if actor else "")
+
+    if code == "selected_config_not_ready":
+        issue_messages = _format_issue_messages(details)
+        if issue_messages:
+            return "\n".join((tr(locale_key), *issue_messages))
+
+    if code in {"rotation_actor_outside_team", "rotation_initial_actor_outside_team"}:
+        actor = _safe_actor(details)
+        if actor:
+            return tr(locale_key, actor=actor)
+        return tr("gcsim.optimizer.error.rotation_setup_invalid")
+
+    return tr(locale_key)
+
+
+def _format_issue_messages(details: Any) -> tuple[str, ...]:
+    issues = _unique_issues(
+        _iter_issue_records(
+            details,
+            issue_collection=isinstance(details, (list, tuple)),
+        )
+    )
+    if not issues:
+        return ()
+
+    cause_issues = [
+        issue
+        for issue in issues
+        if _issue_status(issue) not in _PARENT_ISSUE_CODES
+        | _GENERIC_MAPPING_ISSUE_CODES
+    ]
+    mapping_scopes = tuple(
+        _issue_scope(issue)
+        for issue in cause_issues
+        if _issue_status(issue) in _SPECIFIC_MAPPING_CODES
+    )
+    visible: list[str] = []
+    unknown_added = False
+    for issue in issues:
+        status = _issue_status(issue)
+        if status in _GENERIC_MAPPING_ISSUE_CODES and _has_matching_scope(
+            issue, mapping_scopes
+        ):
+            continue
+        if status in _PARENT_ISSUE_CODES and _has_matching_child_slot(
+            issue, cause_issues
+        ):
+            # This is the assembler's parent-level symptom. A detailed child
+            # issue in the same slot is the actionable cause, so avoid showing
+            # both. A missing/ambiguous slot must not hide another issue.
+            continue
+
+        key = ISSUE_CODE_KEYS.get(status)
+        if key is None:
+            if unknown_added:
+                continue
+            key = UNKNOWN_ISSUE_KEY
+            unknown_added = True
+        item = _safe_label(issue.get("display_name")) or "?"
+        slot_index = _issue_slot_index(issue)
+        slot = (
+            str(slot_index + 1)
+            if type(slot_index) is int and slot_index >= 0
+            else "?"
+        )
+        visible.append(tr(key, item=item, slot=slot))
+    return tuple(visible)
+
+
+def _iter_issue_records(
+    value: Any, *, issue_collection: bool = False
+) -> Iterator[Mapping[str, Any]]:
+    if isinstance(value, Mapping):
+        status = value.get("status")
+        if issue_collection and isinstance(status, str):
+            yield value
+        for key in _ISSUE_CONTAINERS:
+            child = value.get(key)
+            if child is not None:
+                yield from _iter_issue_records(
+                    child,
+                    issue_collection=key == "issues",
+                )
+    elif isinstance(value, (list, tuple)):
+        for child in value:
+            yield from _iter_issue_records(
+                child,
+                issue_collection=issue_collection,
+            )
+
+
+def _unique_issues(
+    issues: Iterator[Mapping[str, Any]],
+) -> tuple[Mapping[str, Any], ...]:
+    seen: set[tuple[str, str, str, str, str]] = set()
+    result: list[Mapping[str, Any]] = []
+    for issue in issues:
+        status = _issue_status(issue)
+        identity = (
+            status,
+            str(issue.get("entity_type") or ""),
+            str(issue.get("project_id") or ""),
+            _safe_label(issue.get("display_name")),
+            str(_issue_slot_index(issue))
+            if _issue_slot_index(issue) is not None
+            else "",
+        )
+        if identity in seen:
+            continue
+        seen.add(identity)
+        result.append(issue)
+    return tuple(result)
+
+
+def _issue_status(issue: Mapping[str, Any]) -> str:
+    value = issue.get("status")
+    return value.strip() if isinstance(value, str) else ""
+
+
+def _issue_scope(issue: Mapping[str, Any]) -> tuple[str, str, str, str]:
+    slot_index = _issue_slot_index(issue)
+    return (
+        str(issue.get("entity_type") or ""),
+        str(issue.get("project_id") or ""),
+        _safe_label(issue.get("display_name")),
+        str(slot_index) if slot_index is not None else "",
+    )
+
+
+def _issue_slot_index(issue: Mapping[str, Any]) -> int | None:
+    slot_index = issue.get("slot_index")
+    if type(slot_index) is int and slot_index >= 0:
+        return slot_index
+    field = issue.get("field")
+    if isinstance(field, str):
+        match = _BLOCK_FIELD_SLOT_RE.search(field)
+        if match:
+            return int(match.group(1))
+    return None
+
+
+def _has_matching_child_slot(
+    parent_issue: Mapping[str, Any],
+    child_issues: list[Mapping[str, Any]],
+) -> bool:
+    parent_slot = _issue_slot_index(parent_issue)
+    if parent_slot is None:
+        return False
+    return any(
+        _issue_status(child) not in _PARENT_ISSUE_CODES
+        and _issue_slot_index(child) == parent_slot
+        for child in child_issues
+    )
+
+
+def _has_matching_scope(
+    issue: Mapping[str, Any],
+    specific_scopes: tuple[tuple[str, str, str, str], ...],
+) -> bool:
+    scope = _issue_scope(issue)
+    meaningful = tuple(index for index, value in enumerate(scope) if value)
+    if any(
+        all(scope[index] == candidate[index] for index in meaningful)
+        and (meaningful or candidate == scope)
+        for candidate in specific_scopes
+    ):
+        return True
+    return not meaningful and len(specific_scopes) == 1
+
+
+def _safe_actor(details: Any) -> str:
+    if not isinstance(details, Mapping):
+        return ""
+    actor = details.get("actor")
+    if not isinstance(actor, str):
+        return ""
+    actor = actor.strip()
+    return actor if _SAFE_ACTOR_RE.fullmatch(actor) else ""
+
+
+def _safe_label(value: Any) -> str:
+    if not isinstance(value, str):
+        return ""
+    return " ".join(value.split())[:100]
+
+
+__all__ = [
+    "ERROR_CODE_KEYS",
+    "ERROR_LOCALE_KEYS",
+    "GENERIC_ERROR_KEY",
+    "ISSUE_CODE_KEYS",
+    "ISSUE_LOCALE_KEYS",
+    "UNKNOWN_ISSUE_KEY",
+    "format_optimizer_error",
+]
