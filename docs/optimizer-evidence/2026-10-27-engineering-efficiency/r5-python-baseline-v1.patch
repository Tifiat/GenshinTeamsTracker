+        );
+
+        CREATE INDEX IF NOT EXISTS idx_artifact_build_gcsim_targets_key
+            ON artifact_build_gcsim_targets(gcsim_character_key);
+        """
+    )
+    init_account_storage(conn)
+    init_account_equipment_storage(conn)
+    init_display_stat_effect_tables(conn)
+    init_character_trait_reference_storage(conn)
+    artifact_columns = {
+        row["name"]
+        for row in conn.execute("PRAGMA table_info(artifacts)").fetchall()
+    }
+    artifact_set_columns = {
+        row["name"]
+        for row in conn.execute("PRAGMA table_info(artifact_sets)").fetchall()
