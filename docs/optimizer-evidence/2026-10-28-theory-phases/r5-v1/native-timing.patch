+package main
+
+import (
+ "context"
+ "encoding/json"
+ "os"
+ "path/filepath"
+ "time"
+ "genshinteamstracker/native/gcsim_optimizer/internal/setcontext"
+)
+
+// Coarse, sequential scope observations only. Nested spans are NOT additive.
+type theoryCoarseSpan struct {
+ Name string `json:"name"`
+ Parent string `json:"parent,omitempty"`
+ StartNS int64 `json:"start_ns"`
+ WallNS int64 `json:"wall_ns"`
+}
+type theoryCoarse struct {
+ started time.Time
+ root string
+ Spans []theoryCoarseSpan `json:"spans"`
+ Stats map[string]setcontext.NeutralModelStats `json:"cumulative_model_stats"`
+ Dropped int `json:"dropped"`
+}
+type theoryCoarseKey struct{}
+func (c *theoryCoarse) begin(name,parent string) func() {
+ start:=time.Now()
+ return func(){
+  if len(c.Spans)>=32 {c.Dropped++;return}
+  c.Spans=append(c.Spans,theoryCoarseSpan{name,parent,start.Sub(c.started).Nanoseconds(),time.Since(start).Nanoseconds()})
+ }
+}
+func theoryCoarseBegin(ctx context.Context,name,parent string) func() {
+ c,_:=ctx.Value(theoryCoarseKey{}).(*theoryCoarse)
+ if c==nil{return func(){}}
+ return c.begin(name,parent)
+}
+func (c *theoryCoarse) snapshot(name string,s setcontext.NeutralModelStats) {
+ if len(c.Stats)>=12 {c.Dropped++;return}
+ if s.R1!=nil {s.R1.Records=nil;s.R1.PackageGuides=nil;s.R1.UnmappedPackageReasons=nil}
+ c.Stats[name]=s
+}
+func (c *theoryCoarse) save() error {
+ raw,err:=json.MarshalIndent(map[string]any{
+  "schema":"theory_coarse_phases_v1","elapsed_ns":time.Since(c.started).Nanoseconds(),
+  "spans":c.Spans,"cumulative_model_stats":c.Stats,"dropped":c.Dropped,
+  "accounting":"First includes checkpoint_fork; offer_response includes support_probes. Cumulative model stats overlap spans. Do not sum inclusive/nested measurements.",
+ },"","  ")
+ if err!=nil{return err}
+ return os.WriteFile(filepath.Join(c.root,"theory-coarse-timings.json"),raw,0600)
+}
--- a/cmd/gtt-optimizer/theory_coarse_test.go
+++ b/cmd/gtt-optimizer/theory_coarse_test.go
@@ -0,0 +1,19 @@
+package main
+
+import("context";"encoding/json";"os";"path/filepath";"testing";"time"
+ "genshinteamstracker/native/gcsim_optimizer/internal/setcontext")
+
+func TestTheoryCoarseScopesAndUnchangedState(t *testing.T){
+ root:=t.TempDir()
+ c:=&theoryCoarse{started:time.Now(),root:root,Stats:map[string]setcontext.NeutralModelStats{}}
+ ctx:=context.WithValue(context.Background(),theoryCoarseKey{},c)
+ end:=c.begin("first","")
+ nested:=theoryCoarseBegin(ctx,"checkpoint_fork","first");nested();end()
+ if len(c.Spans)!=2||c.Spans[0].Parent!="first"||c.Spans[0].WallNS>c.Spans[1].WallNS {t.Fatal("nested accounting lost")}
+ s:=setcontext.NeutralModelStats{};c.snapshot("before",s)
+ if s.Requests!=0{t.Fatal("observation mutated state")}
+ if err:=c.save();err!=nil{t.Fatal(err)}
+ raw,err:=os.ReadFile(filepath.Join(root,"theory-coarse-timings.json"));if err!=nil{t.Fatal(err)}
+ var saved map[string]any;if json.Unmarshal(raw,&saved)!=nil||saved["schema"]!="theory_coarse_phases_v1"{t.Fatal("receipt missing")}
+ for i:=0;i<40;i++{c.begin("bounded","")()};if len(c.Spans)!=32||c.Dropped==0{t.Fatal("unbounded observations")}
+}
--- a/internal/theorysearch/coarse_checkpoint.go
+++ b/internal/theorysearch/coarse_checkpoint.go
@@ -0,0 +1,14 @@
+package theorysearch
+
+import("context";"time")
+type firstCheckpointTimingKey struct{}
+// A single observation around the existing First checkpoint; no search feedback.
+func WithFirstCheckpointTiming(ctx context.Context, observe func(time.Duration)) context.Context {
+ return context.WithValue(ctx,firstCheckpointTimingKey{},observe)
+}
+func firstCheckpointTiming(ctx context.Context) func() {
+ observe,_:=ctx.Value(firstCheckpointTimingKey{}).(func(time.Duration))
+ if observe==nil{return func(){}}
+ started:=time.Now()
+ return func(){observe(time.Since(started))}
+}
