+package setcontext
+
+import (
+	"encoding/hex"
+	"genshinteamstracker/native/gcsim_optimizer/internal/formula"
+	"genshinteamstracker/native/gcsim_optimizer/internal/seteffects"
+	"time"
+)
+
+func (m *NeutralModel) DiagnosePreparation(cases []seteffects.PreparationCase) (*seteffects.PreparationDiagnostic, error) {
+	return m.binding.DiagnosePreparation(cases, func(out seteffects.NeutralExpressions) seteffects.PreparationBindingEvidence {
+		result := seteffects.PreparationBindingEvidence{}
+		if !out.Complete() {
+			result.Error = "unavailable_before_binding"
+			return result
+		}
+		started := time.Now()
+		var program *formula.ParametricProgram
+		var err error
+		if out.SparseEffects != nil {
+			program, err = m.bindMixed(out.Constants, out.SparseEffects)
+		} else if out.Constants != nil {
+			program, err = m.bindConstants(out.Constants)
+		} else {
+			program, err = m.bindProgram(out.Effects)
+		}
+		result.Seconds = time.Since(started).Seconds()
+		if err != nil {
+			result.Error = err.Error()
+			return result
+		}
+		if key, ok := m.r3ProgramKey(program); ok {
+			result.ProgramIdentity = hex.EncodeToString(key[:])
+		}
+		return result
+	})
+}
