@@ -0,0 +1,41 @@
+package gtt
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestEngineInfoAdvertisesTraceV6Once(t *testing.T) {
+	capabilities := Info("fixture").Capabilities
+	counts := make(map[string]int)
+	for _, capability := range capabilities {
+		counts[capability]++
+	}
+	if counts[TraceEquationV4Capability] != 1 || counts[TraceEquationV5Capability] != 1 ||
+		counts[TraceEquationV6Capability] != 1 {
+		t.Fatalf("trace capabilities = %#v", capabilities)
+	}
+	if counts[CompactEquationV1Capability] != 1 {
+		t.Fatalf("compact capability = %#v", capabilities)
+	}
+}
+
+func TestEngineInfoUsesCanonicalSourceManifestCompilerKey(t *testing.T) {
+	payload, err := json.Marshal(EngineInfo{
+		SourceManifestBodySHA256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		SourceCompilerVersion:    "gtt_source_compiler_v1",
+	})
+	if err != nil {
+		t.Fatalf("marshal engine info: %v", err)
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal(payload, &decoded); err != nil {
+		t.Fatalf("decode engine info: %v", err)
+	}
+	if got := decoded["source_manifest_compiler_version"]; got != "gtt_source_compiler_v1" {
+		t.Fatalf("canonical compiler key = %v, want gtt_source_compiler_v1", got)
+	}
+	if _, exists := decoded["source_compiler_version"]; exists {
+		t.Fatal("legacy source_compiler_version alias must not be emitted")
+	}
+}
diff --git a/pkg/gtt/waves.go b/pkg/gtt/waves.go
new file mode 100644
index 0000000000000000000000000000000000000000..f868b884e456bcd8cdc183afee250accb82e411d
--- /dev/null
+++ b/pkg/gtt/waves.go
@@ -0,0 +1,284 @@
+package gtt
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/glog"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/enemy"
+)
+
+const (
+	WaveSchedulerPrototypeCapability  = "gtt_wave_scheduler_prototype"
+	WaveScenarioPayloadCapability     = "gtt_wave_scenario_payload"
+	WavePrototypeDirective            = "gtt_wave_prototype"
+	WaveScenarioSpawnPolicyGroupClear = "group_clear"
+)
+
+var (
+	anyWavePrototypeDirectivePattern = regexp.MustCompile(`(?m)^\s*(?:#|//)\s*gtt_wave_prototype\b.*$`)
+	wavePrototypeDirectivePattern    = regexp.MustCompile(`^\s*(?:#|//)\s*gtt_wave_prototype\s+duplicate_first_target\s*=\s*([0-9]+)\s*$`)
+)
+
+// ApplyConfigDirectives reads GTT-only comment directives from the raw config.
+// Vanilla GCSIM ignores these comments, so regular configs are unchanged unless
+// the prototype directive is explicitly present.
+func ApplyConfigDirectives(raw string, cfg *info.ActionList) error {
+	if cfg == nil {
+		return nil
+	}
+	matches := anyWavePrototypeDirectivePattern.FindAllString(raw, -1)
+	if len(matches) == 0 {
+		return nil
+	}
+	if len(matches) > 1 {
+		return fmt.Errorf("%s accepts exactly one directive, got %d", WavePrototypeDirective, len(matches))
+	}
+	parsed := wavePrototypeDirectivePattern.FindStringSubmatch(matches[0])
+	if parsed == nil {
+		return fmt.Errorf("invalid %s directive; expected '# %s duplicate_first_target=N'", WavePrototypeDirective, WavePrototypeDirective)
+	}
+	extraWaves, err := strconv.Atoi(parsed[1])
+	if err != nil || extraWaves <= 0 {
+		return fmt.Errorf("%s duplicate_first_target must be a positive integer", WavePrototypeDirective)
+	}
+	cfg.Settings.GTTSequentialWavePrototype = true
+	cfg.Settings.GTTSequentialWavePrototypeExtraWaves = extraWaves
+	return nil
+}
+
+type waveScenarioFile struct {
+	SchemaVersion int                `json:"schema_version"`
+	SpawnPolicy   string             `json:"spawn_policy"`
+	Waves         []waveScenarioWave `json:"waves"`
+}
+
+type waveScenarioWave struct {
+	Targets []waveScenarioTarget `json:"targets"`
+}
+
+type waveScenarioTarget struct {
+	Level  *int      `json:"level"`
+	Type   string    `json:"type"`
+	HP     *float64  `json:"hp"`
+	Radius *float64  `json:"radius"`
+	Pos    []float64 `json:"pos"`
+	Resist *float64  `json:"resist"`
+}
+
+// ApplyWaveScenarioFile applies an explicit structured GTT wave scenario. The
+// first scenario wave replaces the parsed config targets; remaining waves are
+// queued for the sequential wave scheduler. Empty path is a no-op so vanilla
+// configs remain unchanged unless this GTT flag is explicitly provided.
+func ApplyWaveScenarioFile(path string, cfg *info.ActionList) error {
+	if cfg == nil || strings.TrimSpace(path) == "" {
+		return nil
+	}
+	payload, err := loadWaveScenarioFile(path)
+	if err != nil {
+		return err
+	}
+	waves, err := payload.enemyWaves()
+	if err != nil {
+		return err
+	}
+	cfg.Targets = cloneWaveProfiles(waves[0])
+	cfg.GTTSequentialWaveScenario = cloneScenarioWaves(waves[1:])
+	cfg.Settings.DamageMode = true
+	cfg.Settings.GTTSequentialWavePrototype = true
+	cfg.Settings.GTTSequentialWavePrototypeExtraWaves = 0
+	return nil
+}
+
+func loadWaveScenarioFile(path string) (waveScenarioFile, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return waveScenarioFile{}, fmt.Errorf("gtt wave scenario: could not read %q: %w", path, err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var payload waveScenarioFile
+	if err := decoder.Decode(&payload); err != nil {
+		return waveScenarioFile{}, fmt.Errorf("gtt wave scenario: invalid JSON in %q: %w", path, err)
+	}
+	return payload, nil
+}
+
+func (payload waveScenarioFile) enemyWaves() ([][]info.EnemyProfile, error) {
+	if payload.SchemaVersion != 1 {
+		return nil, fmt.Errorf("gtt wave scenario: schema_version must be 1")
+	}
+	if payload.SpawnPolicy != WaveScenarioSpawnPolicyGroupClear {
+		return nil, fmt.Errorf("gtt wave scenario: unsupported spawn_policy %q; expected %q", payload.SpawnPolicy, WaveScenarioSpawnPolicyGroupClear)
+	}
+	if len(payload.Waves) == 0 {
+		return nil, fmt.Errorf("gtt wave scenario: waves must contain at least one wave")
+	}
+	waves := make([][]info.EnemyProfile, len(payload.Waves))
+	for waveIndex, wave := range payload.Waves {
+		if len(wave.Targets) == 0 {
+			return nil, fmt.Errorf("gtt wave scenario: waves[%d].targets must contain at least one target", waveIndex)
+		}
+		waves[waveIndex] = make([]info.EnemyProfile, len(wave.Targets))
+		for targetIndex, target := range wave.Targets {
+			profile, err := target.enemyProfile(waveIndex, targetIndex)
+			if err != nil {
+				return nil, err
+			}
+			waves[waveIndex][targetIndex] = profile
+		}
+	}
+	return waves, nil
+}
+
+func (target waveScenarioTarget) enemyProfile(waveIndex int, targetIndex int) (info.EnemyProfile, error) {
+	prefix := fmt.Sprintf("gtt wave scenario: waves[%d].targets[%d]", waveIndex, targetIndex)
+	if target.Level == nil {
+		return info.EnemyProfile{}, fmt.Errorf("%s.level is required", prefix)
+	}
+	if *target.Level < 1 || *target.Level > 100 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.level must be between 1 and 100", prefix)
+	}
+	if strings.TrimSpace(target.Type) == "" {
+		return info.EnemyProfile{}, fmt.Errorf("%s.type is required", prefix)
+	}
+	if target.HP == nil {
+		return info.EnemyProfile{}, fmt.Errorf("%s.hp is required", prefix)
+	}
+	if *target.HP <= 0 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.hp must be greater than 0", prefix)
+	}
+	if target.Radius != nil && *target.Radius <= 0 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.radius must be greater than 0", prefix)
+	}
+	if len(target.Pos) != 0 && len(target.Pos) != 2 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.pos must contain exactly two numbers when provided", prefix)
+	}
+	profile := info.EnemyProfile{
+		Level: *target.Level,
+	}
+	if len(target.Pos) == 2 {
+		profile.Pos.X = target.Pos[0]
+		profile.Pos.Y = target.Pos[1]
+	}
+	if target.Radius != nil {
+		profile.Pos.R = *target.Radius
+	}
+	if err := enemy.ConfigureTarget(&profile, target.Type, enemy.TargetParams{Particles: true}); err != nil {
+		return info.EnemyProfile{}, fmt.Errorf("%s.type %q is invalid: %w", prefix, target.Type, err)
+	}
+	if profile.Pos.R == 0 {
+		profile.Pos.R = 1
+	}
+	profile.HP = *target.HP
+	profile.Modified = true
+	if target.Resist != nil {
+		for attr := range profile.Resist {
+			profile.Resist[attr] = *target.Resist
+		}
+	}
+	return profile, nil
+}
+
+type SequentialWavePrototypeScheduler struct {
+	core      *core.Core
+	prototype info.EnemyProfile
+	remaining int
+	spawned   int
+	waves     [][]info.EnemyProfile
+}
+
+func NewSequentialWavePrototypeScheduler(c *core.Core, cfg *info.ActionList) *SequentialWavePrototypeScheduler {
+	if c == nil || cfg == nil {
+		return nil
+	}
+	if len(cfg.GTTSequentialWaveScenario) > 0 {
+		return &SequentialWavePrototypeScheduler{
+			core:  c,
+			waves: cloneScenarioWaves(cfg.GTTSequentialWaveScenario),
+		}
+	}
+	if !cfg.Settings.GTTSequentialWavePrototype || cfg.Settings.GTTSequentialWavePrototypeExtraWaves <= 0 {
+		return nil
+	}
+	if len(cfg.Targets) == 0 {
+		return nil
+	}
+	return &SequentialWavePrototypeScheduler{
+		core:      c,
+		prototype: cfg.Targets[0].Clone(),
+		remaining: cfg.Settings.GTTSequentialWavePrototypeExtraWaves,
+	}
+}
+
+func (s *SequentialWavePrototypeScheduler) SpawnNextWave() bool {
+	if s == nil {
+		return false
+	}
+	if len(s.waves) > 0 {
+		profiles := cloneWaveProfiles(s.waves[0])
+		s.waves = s.waves[1:]
+		s.spawned++
+		s.spawnProfiles(profiles)
+		s.core.Log.NewEvent("gtt sequential wave scenario spawned group", glog.LogSimEvent, -1).
+			Write("spawned_wave", s.spawned).
+			Write("remaining_waves", len(s.waves)).
+			Write("target_count", len(profiles))
+		return true
+	}
+	if s.remaining <= 0 {
+		return false
+	}
+	profile := s.prototype.Clone()
+	s.spawnProfiles([]info.EnemyProfile{profile})
+	s.remaining--
+	s.spawned++
+	s.core.Log.NewEvent("gtt sequential wave prototype spawned target", glog.LogSimEvent, -1).
+		Write("spawned", s.spawned).
+		Write("remaining", s.remaining)
+	return true
+}
+
+func (s *SequentialWavePrototypeScheduler) spawnProfiles(profiles []info.EnemyProfile) {
+	for idx, profile := range profiles {
+		nextEnemy := enemy.New(s.core, profile.Clone())
+		s.core.Combat.AddEnemy(nextEnemy)
+		if idx == 0 {
+			s.core.Combat.DefaultTarget = nextEnemy.Key()
+			if player := s.core.Combat.Player(); player != nil {
+				player.SetDirection(nextEnemy.Pos())
+			}
+		}
+		s.core.Events.Emit(event.OnEnemyAdded, nextEnemy)
+	}
+}
+
+func cloneScenarioWaves(waves [][]info.EnemyProfile) [][]info.EnemyProfile {
+	if len(waves) == 0 {
+		return nil
+	}
+	clone := make([][]info.EnemyProfile, len(waves))
+	for waveIndex := range waves {
+		clone[waveIndex] = cloneWaveProfiles(waves[waveIndex])
+	}
+	return clone
+}
+
+func cloneWaveProfiles(wave []info.EnemyProfile) []info.EnemyProfile {
+	if len(wave) == 0 {
+		return nil
+	}
+	clone := make([]info.EnemyProfile, len(wave))
+	for i := range wave {
+		clone[i] = wave[i].Clone()
+	}
+	return clone
+}
diff --git a/pkg/gttcompact/builder.go b/pkg/gttcompact/builder.go
new file mode 100644
index 0000000000000000000000000000000000000000..d939791336e70436014b8cfa7bca2dc5d0244619
--- /dev/null
+++ b/pkg/gttcompact/builder.go
@@ -0,0 +1,154 @@
+package gttcompact
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type compiledNode struct {
+	id       uint32
+	baseline float64
+	coords   map[string]struct{}
+}
+
+type nodeBuilder struct {
+	nodes []IRNode
+}
+
+func decimal(value float64) string {
+	if value == 0 {
+		return "0"
+	}
+	return strconv.FormatFloat(value, 'f', -1, 64)
+}
+
+func (b *nodeBuilder) constant(value float64) compiledNode {
+	return b.append(IRNode{Operation: "constant", Inputs: []IRInput{}, Value: decimal(value)}, value, nil)
+}
+
+func (b *nodeBuilder) opaque(value float64) compiledNode {
+	return b.append(IRNode{Operation: "opaque_frozen", Inputs: []IRInput{}, Value: decimal(value)}, value, nil)
+}
+
+func (b *nodeBuilder) artifactDelta(actorKey, statKey string) compiledNode {
+	coordinate := normalizeCoordinate(actorKey, statKey)
+	return b.append(IRNode{Operation: "artifact_stat", Inputs: []IRInput{}, Coordinate: coordinate}, 0, map[string]struct{}{coordinate: {}})
+}
+
+func (b *nodeBuilder) add(values ...compiledNode) compiledNode {
+	return b.commutative("add", 0, values...)
+}
+
+func (b *nodeBuilder) multiply(values ...compiledNode) compiledNode {
+	return b.commutative("multiply", 1, values...)
+}
+
+func (b *nodeBuilder) min(values ...compiledNode) compiledNode {
+	return b.commutative("min", math.Inf(1), values...)
+}
+
+func (b *nodeBuilder) max(values ...compiledNode) compiledNode {
+	return b.commutative("max", math.Inf(-1), values...)
+}
+
+func (b *nodeBuilder) subtract(left, right compiledNode) compiledNode {
+	return b.add(left, b.multiply(b.constant(-1), right))
+}
+
+func (b *nodeBuilder) divide(left, right compiledNode) compiledNode {
+	inverse := b.append(
+		IRNode{Operation: "power", Inputs: []IRInput{{NodeID: right.id, Relation: "base"}, {NodeID: b.constant(-1).id, Relation: "exponent"}}},
+		math.Pow(right.baseline, -1), right.coords,
+	)
+	return b.multiply(left, inverse)
+}
+
+func (b *nodeBuilder) commutative(operation string, identity float64, values ...compiledNode) compiledNode {
+	if len(values) == 0 {
+		return b.constant(identity)
+	}
+	if len(values) == 1 {
+		return values[0]
+	}
+	inputs := make([]IRInput, len(values))
+	coords := make(map[string]struct{})
+	baseline := identity
+	for index, value := range values {
+		inputs[index] = IRInput{NodeID: value.id, Relation: fmt.Sprintf("input/%06d", index)}
+		for coordinate := range value.coords {
+			coords[coordinate] = struct{}{}
+		}
+		switch operation {
+		case "add":
+			baseline += value.baseline
+		case "multiply":
+			baseline *= value.baseline
+		case "min":
+			baseline = math.Min(baseline, value.baseline)
+		case "max":
+			baseline = math.Max(baseline, value.baseline)
+		}
+	}
+	sort.Slice(inputs, func(i, j int) bool { return inputs[i].NodeID < inputs[j].NodeID })
+	for index := range inputs {
+		inputs[index].Relation = fmt.Sprintf("input/%06d", index)
+	}
+	return b.append(IRNode{Operation: operation, Inputs: inputs}, baseline, coords)
+}
+
+func (b *nodeBuilder) append(node IRNode, baseline float64, coords map[string]struct{}) compiledNode {
+	node.NodeID = uint32(len(b.nodes) + 1)
+	if node.Inputs == nil {
+		node.Inputs = []IRInput{}
+	}
+	b.nodes = append(b.nodes, node)
+	return compiledNode{id: node.NodeID, baseline: baseline, coords: cloneCoords(coords)}
+}
+
+func cloneCoords(values map[string]struct{}) map[string]struct{} {
+	out := make(map[string]struct{}, len(values))
+	for value := range values {
+		out[value] = struct{}{}
+	}
+	return out
+}
+
+func sortedCoords(values map[string]struct{}) []string {
+	out := make([]string, 0, len(values))
+	for value := range values {
+		out = append(out, value)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func normalizeCoordinate(actorKey, statKey string) string {
+	replacer := strings.NewReplacer(
+		"%", "_percent", " ", "_", "+", "_plus_", "'", "", "(", "_", ")", "_",
+	)
+	actor := strings.Trim(replacer.Replace(strings.ToLower(actorKey)), "_")
+	stat := strings.Trim(replacer.Replace(strings.ToLower(statKey)), "_")
+	aliases := map[string]string{
+		"cr": "crit_rate", "cd": "crit_damage", "dmg_percent": "damage_bonus",
+		"heal": "healing_bonus", "atk_percent": "atk_percent", "hp_percent": "hp_percent", "def_percent": "def_percent",
+	}
+	if alias, ok := aliases[stat]; ok {
+		stat = alias
+	}
+	if strings.HasSuffix(stat, "_percent") && stat != "atk_percent" && stat != "hp_percent" && stat != "def_percent" {
+		stat = strings.TrimSuffix(stat, "_percent") + "_damage_bonus"
+	}
+	return actor + "." + stat
+}
+
+func hashJSON(value any) string {
+	payload, _ := json.Marshal(value)
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:])
+}
diff --git a/pkg/gttcompact/compile.go b/pkg/gttcompact/compile.go
new file mode 100644
index 0000000000000000000000000000000000000000..b67ea046281a88c53a1f1c2bec13eacef3c4901e
--- /dev/null
+++ b/pkg/gttcompact/compile.go
@@ -0,0 +1,97 @@
+package gttcompact
+
+import (
+	"fmt"
+	"math"
+	"runtime"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func CompileSeedMember(buffer optstats.GTTTraceEquationBuffer, characterKeys []string) (IRSeedMember, Audit, error) {
+	started := time.Now()
+	var startMemory, checkpointMemory, endMemory runtime.MemStats
+	runtime.ReadMemStats(&startMemory)
+	peakHeap := startMemory.HeapInuse
+	if buffer.Seed <= 0 || buffer.DurationFrames <= 0 || len(buffer.Hits) == 0 {
+		return IRSeedMember{}, Audit{}, fmt.Errorf("compact adapter requires one positive-seed executed trace")
+	}
+	if len(characterKeys) == 0 {
+		return IRSeedMember{}, Audit{}, fmt.Errorf("compact adapter requires character keys")
+	}
+	builder := &nodeBuilder{nodes: make([]IRNode, 0, len(buffer.Hits)*32)}
+	support := compileSupportProgram(builder, buffer, characterKeys)
+	runtime.ReadMemStats(&checkpointMemory)
+	if checkpointMemory.HeapInuse > peakHeap {
+		peakHeap = checkpointMemory.HeapInuse
+	}
+	channels, unknown, baseline := compileChannels(builder, buffer, characterKeys, support)
+	runtime.ReadMemStats(&checkpointMemory)
+	if checkpointMemory.HeapInuse > peakHeap {
+		peakHeap = checkpointMemory.HeapInuse
+	}
+	if math.IsNaN(baseline) || math.IsInf(baseline, 0) || baseline < 0 {
+		return IRSeedMember{}, Audit{}, fmt.Errorf("compact adapter produced invalid baseline")
+	}
+	reasons := sortedUnknown(unknown)
+	boundaries := make([]IROpaqueBoundary, 0, len(reasons))
+	for index, reason := range reasons {
+		node := builder.opaque(0)
+		boundaries = append(boundaries, IROpaqueBoundary{
+			BoundaryID: fmt.Sprintf("opaque/%06d", index+1), NodeID: node.id,
+			ReasonCode: normalizeReason(reason), BaselineDamage: decimal(baseline),
+			BaselineDamageShare: func() string {
+				if baseline == 0 {
+					return "0"
+				}
+				return "1"
+			}(),
+		})
+	}
+	sort.Slice(channels, func(i, j int) bool { return channels[i].ChannelID < channels[j].ChannelID })
+	topology := hashJSON(struct {
+		Seed           int64 `json:"seed"`
+		DurationFrames int   `json:"duration_frames"`
+		Topology       any   `json:"topology"`
+		Guard          any   `json:"guard"`
+	}{buffer.Seed, buffer.DurationFrames, buffer.TopologyEvents, buffer.GuardSummary()})
+	member := IRSeedMember{
+		Seed: uint64(buffer.Seed), DurationMS: int64(math.Round(float64(buffer.DurationFrames) * 1000 / 60)),
+		TopologySHA256: topology, Nodes: builder.nodes, Channels: channels, OpaqueBoundaries: boundaries,
+	}
+	audit := Audit{
+		SourceHitCount: len(buffer.Hits), AncestorStateEventCount: len(support.ancestorIDs),
+		NodeCount: len(builder.nodes), ChannelCount: len(channels), OpaqueReasonCount: len(reasons),
+		BaselineDamage: baseline,
+	}
+	runtime.ReadMemStats(&endMemory)
+	if endMemory.HeapInuse > peakHeap {
+		peakHeap = endMemory.HeapInuse
+	}
+	audit.AdapterElapsedNS = time.Since(started).Nanoseconds()
+	audit.HeapInuseStartBytes = startMemory.HeapInuse
+	audit.HeapInusePeakBytes = peakHeap
+	audit.HeapInuseEndBytes = endMemory.HeapInuse
+	audit.TotalAllocDeltaBytes = endMemory.TotalAlloc - startMemory.TotalAlloc
+	return member, audit, nil
+}
+
+func normalizeReason(value string) string {
+	value = strings.ToLower(value)
+	var out strings.Builder
+	for _, char := range value {
+		if (char >= 'a' && char <= 'z') || (char >= '0' && char <= '9') || char == '_' || char == '-' {
+			out.WriteRune(char)
+		} else {
+			out.WriteByte('_')
+		}
+	}
+	result := strings.Trim(out.String(), "_")
+	if result == "" {
+		return "unknown_compact_boundary"
+	}
+	return result
+}
