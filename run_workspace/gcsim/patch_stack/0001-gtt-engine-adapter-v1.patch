 	modifier.LogAdd("enemy", -1, &mod, e.Core.Log, overwrote, oldEvt)
+	e.gttRecordTargetModifier("resistance", mod.Key(), sourceID, provider, displacedSourceID, displaced, overwrote)
 }
 
 func (e *Enemy) AddDefMod(mod info.DefMod) {
+	sourceID := e.gttTargetModifierSourceID()
+	provider, displaced, displacedSourceID := e.gttPrepareTargetModifier(&mod, sourceID)
 	mod.SetExpiry(e.Core.F)
 	overwrote, oldEvt := modifier.Add[modifier.Mod](&e.mods, &mod, e.Core.F)
 	modifier.LogAdd("enemy", -1, &mod, e.Core.Log, overwrote, oldEvt)
