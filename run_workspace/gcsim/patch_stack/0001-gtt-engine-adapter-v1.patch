+
+func TestGTTStatResponseRequestValidation(t *testing.T) {
+	request := GTTStatResponseRequest{
+		SchemaVersion:     GTTStatResponseSchemaVersion,
+		ContextSHA256:     strings.Repeat("a", 64),
+		Objective:         gttResponseObjectiveDPS,
+		Iterations:        8,
+		Workers:           4,
+		MasterSeed:        "123",
+		IgnoreBurstEnergy: true,
+		BaselineChanges: []GTTStatResponseChange{
+			{CharacterIndex: 0, Stat: "cr", Mode: "set", Value: 0.95},
+		},
+		Interventions: []GTTStatResponseIntervention{
+			{
+				ID: "furina/hp",
+				Changes: []GTTStatResponseChange{
+					{CharacterIndex: 1, Stat: "hp%", Mode: gttResponseChangeAdd, Value: 0.466},
+				},
+			},
+		},
+	}
+	if err := request.validate(4); err != nil {
+		t.Fatalf("valid request rejected: %v", err)
+	}
+
+	request.Interventions[0].Changes[0].Stat = "base_hp"
+	if err := request.validate(4); err == nil {
+		t.Fatal("base stat change should be rejected")
+	}
+}
+
+func TestGTTSetResponseChangeValidation(t *testing.T) {
+	request := GTTStatResponseRequest{
+		SchemaVersion:     GTTStatResponseSchemaVersion,
+		ContextSHA256:     strings.Repeat("b", 64),
+		Objective:         gttResponseObjectiveDPS,
+		Iterations:        8,
+		Workers:           1,
+		MasterSeed:        "123",
+		IgnoreBurstEnergy: true,
+		Interventions: []GTTStatResponseIntervention{
+			{
+				ID: "bennett/noblesse",
+				Changes: []GTTStatResponseChange{
+					{CharacterIndex: 3, SetKey: "noblesse", SetCount: testIntPtr(4)},
+				},
+			},
+		},
+	}
+	if err := request.validate(4); err != nil {
+		t.Fatalf("valid set response rejected: %v", err)
+	}
+	request.Interventions[0].Changes[0].SetCount = testIntPtr(3)
+	if err := request.validate(4); err == nil {
+		t.Fatal("invalid set count should be rejected")
+	}
+}
+
+func TestGTTSetCountCanonicalPresenceAndValidation(t *testing.T) {
+	statOnly := GTTStatResponseChange{CharacterIndex: 0, Stat: "cr", Mode: "add", Value: 0.1}
+	payload, err := json.Marshal(statOnly)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(payload), "set_key") || strings.Contains(string(payload), "set_count") {
+		t.Fatalf("stat-only change leaked set fields: %s", payload)
+	}
+	for _, count := range []int{0, 2, 4} {
+		original := GTTStatResponseChange{CharacterIndex: 0, SetKey: "noblesse", SetCount: testIntPtr(count)}
+		payload, err := json.Marshal(original)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(payload), `"set_count":`+strconv.Itoa(count)) {
+			t.Fatalf("explicit set_count lost: %s", payload)
+		}
+		var decoded GTTStatResponseChange
+		if err := json.Unmarshal(payload, &decoded); err != nil {
+			t.Fatal(err)
+		}
+		if decoded.SetCount == nil || *decoded.SetCount != count {
+			t.Fatalf("set_count %d did not survive decode", count)
+		}
+		if err := validateGTTStatResponseChanges("test", []GTTStatResponseChange{decoded}, 4, false); err != nil {
+			t.Fatalf("set_count %d rejected: %v", count, err)
+		}
+	}
+	if err := validateGTTStatResponseChanges("test", []GTTStatResponseChange{{CharacterIndex: 0, SetKey: "noblesse"}}, 4, false); err == nil {
+		t.Fatal("set_key without set_count accepted")
+	}
+	if err := validateGTTStatResponseChanges("test", []GTTStatResponseChange{{CharacterIndex: 0, SetCount: testIntPtr(0)}}, 4, false); err == nil {
+		t.Fatal("set_count without set_key accepted")
+	}
+}
+
+func TestGTTCrossLanguageCanonicalHashesForStatAndEffectContracts(t *testing.T) {
+	statExpected := map[int]string{
+		0: "6a6ad6409975f3c564d30f396144b76782ac6d6406fcfe6f9a734a79ecfa508a",
+		2: "194252b86707c1179f0a4f7041ebf8d980c65c5263c27aa8ae65ee8991291baa",
+		4: "5132909fd5d181e8121df46719be5f49907db7a8558938a25376f6225783ffcb",
+	}
+	effectExpected := map[int]string{
+		0: "611e5326f3997205adc9efb576240bcacd44e310adecc17951604ff5e9d43dc6",
+		2: "dd8e17ac6da6026081f843d26dbfaed66d5842931591cadd0b332eccbb85f0f5",
+		4: "f68d12357cc4b4208df53ed0a49befa9601b6f2959bd2f419cfc81925fc368c5",
+	}
+	for _, count := range []int{0, 2, 4} {
+		t.Run(strconv.Itoa(count), func(t *testing.T) {
+			interventions := []GTTStatResponseIntervention{{
+				ID:      "set-" + strconv.Itoa(count),
+				Changes: []GTTStatResponseChange{{CharacterIndex: 0, SetKey: "noblesse", SetCount: testIntPtr(count)}},
+			}}
+			stat := GTTStatResponseRequest{SchemaVersion: 2, ContextSHA256: strings.Repeat("a", 64), Objective: "dps", Iterations: 8, Workers: 1, MasterSeed: "123", IgnoreBurstEnergy: true, BaselineChanges: []GTTStatResponseChange{}, Interventions: interventions}
+			effect := GTTEffectObservationRequest{SchemaVersion: 1, ContextSHA256: strings.Repeat("a", 64), Objective: "dps", Iterations: 8, Workers: 1, MasterSeed: "123", IgnoreBurstEnergy: true, BaselineChanges: []GTTStatResponseChange{}, Interventions: interventions}
+			statHash, err := canonicalSHA256(stat)
+			if err != nil {
+				t.Fatal(err)
+			}
+			effectHash, err := canonicalSHA256(effect)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if statHash != statExpected[count] {
+				t.Fatalf("stat hash %s != Python %s", statHash, statExpected[count])
+			}
+			if effectHash != effectExpected[count] {
+				t.Fatalf("effect hash %s != Python %s", effectHash, effectExpected[count])
+			}
+		})
+	}
+}
+
+func testIntPtr(value int) *int { return &value }
+
+func TestGTTStatResponsePairedDeltaUsesSeedAlignedDifferences(t *testing.T) {
+	baseline := []GTTStatResponseSample{
+		responseTestSample("1", 10, 100, []float64{60, 40}),
+		responseTestSample("2", 20, 200, []float64{120, 80}),
+	}
+	variant := []GTTStatResponseSample{
+		responseTestSample("1", 9, 108, []float64{72, 36}),
+		responseTestSample("2", 18, 216, []float64{144, 72}),
+	}
+
+	delta := summarizeGTTStatResponsePairedDelta(baseline, variant)
+	if got, want := delta.TeamExpectedDPS.Mean, 2.0; math.Abs(got-want) > 1e-12 {
+		t.Fatalf("team paired DPS mean = %v, want %v", got, want)
+	}
+	if got, want := delta.DurationSeconds.Mean, -1.5; got != want {
+		t.Fatalf("duration paired mean = %v, want %v", got, want)
+	}
+	if got, want := delta.CharacterExpectedDPS[1].Mean, 0.0; got != want {
+		t.Fatalf("second character paired DPS mean = %v, want %v", got, want)
+	}
+}
+
+func TestGTTStatResponseSeedPanelMustMatch(t *testing.T) {
+	baseline := []GTTStatResponseSample{{Seed: "1"}, {Seed: "2"}}
+	variant := []GTTStatResponseSample{{Seed: "1"}, {Seed: "3"}}
+	if err := requireSameSeedPanel(baseline, variant); err == nil {
+		t.Fatal("mismatched seed panel should fail")
+	}
+}
+
+func responseTestSample(seed string, duration float64, damage float64, characterDamage []float64) GTTStatResponseSample {
+	characterDPS := make([]float64, len(characterDamage))
+	for i, value := range characterDamage {
+		characterDPS[i] = value / duration
+	}
+	return GTTStatResponseSample{
+		Seed:                    seed,
+		DurationFrames:          int(duration * 60),
+		DurationSeconds:         duration,
+		TeamExpectedDamage:      damage,
+		TeamExpectedDPS:         damage / duration,
+		CharacterExpectedDamage: characterDamage,
+		CharacterExpectedDPS:    characterDPS,
+	}
+}
