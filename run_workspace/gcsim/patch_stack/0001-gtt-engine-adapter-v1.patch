+}
+
+func (e *Enemy) gttTargetModifierSourceID() string {
+	if !e.Core.GTTTrace.Enabled() {
+		return ""
+	}
+	return gttsource.CaptureCaller(gttsource.KindModifierAmount, 2)
+}
+
+func (e *Enemy) gttPrepareTargetModifier(
+	mod modifier.Mod,
+	sourceID string,
+) (gtttrace.Provider, *gtttrace.Provider, *string) {
+	provider := e.Core.GTTTrace.Current()
+	if !provider.Complete() {
+		provider = gtttrace.UnknownProvider("unattributed", mod.Key())
+	}
+	mod.SetGTTSource(provider)
+	mod.SetGTTSourceID(sourceID)
+	index := modifier.Find(&e.mods, mod.Key())
+	if index < 0 {
+		return provider, nil, nil
+	}
+	old := e.mods[index]
+	if old.Expiry() != -1 && old.Expiry() <= e.Core.F {
+		return provider, nil, nil
+	}
+	displaced := old.GTTSource()
+	displacedSourceID := old.GTTSourceID()
+	return provider, &displaced, &displacedSourceID
+}
+
+func (e *Enemy) gttRecordTargetModifier(
+	channel string,
+	key string,
+	sourceID string,
+	provider gtttrace.Provider,
+	displacedSourceID *string,
+	displaced *gtttrace.Provider,
+	overwrote bool,
+) {
+	transition := "activation"
+	if overwrote {
+		transition = "replacement_refresh"
+	}
+	e.Core.GTTTrace.RecordModifierTransition(gtttrace.ModifierTransition{
+		Frame: e.Core.F, Channel: channel, RecipientIndex: int(e.Key()),
+		ModifierKey: key, Transition: transition, SourceID: sourceID, Provider: provider,
+		DisplacedSourceID: displacedSourceID, DisplacedProvider: displaced,
+	})
