+func (r *Runtime) CompleteTaskExecution(
+	callID, taskID, queueID string,
+	queueSequence, enqueueFrame, delayFrames, executeByFrame, executionFrame int,
+	sourceID, sourceOccurrenceID string,
+	provider Provider,
+	numericPayload []NumericPayload,
+) {
+	if !r.Enabled() || callID == "" || taskID == "" {
+		return
+	}
+	if len(r.stateEventStack) > 0 && r.stateEventStack[len(r.stateEventStack)-1] == callID {
+		r.stateEventStack = r.stateEventStack[:len(r.stateEventStack)-1]
+	}
+	if len(r.taskNumericContexts) > 0 {
+		r.taskNumericContexts = r.taskNumericContexts[:len(r.taskNumericContexts)-1]
+	}
+	r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventTaskExecuteExit, SourceID: optionalString(sourceID),
+		SourceOccurrenceID: optionalString(sourceOccurrenceID), Provider: provider,
+		TaskID: optionalString(taskID), CallID: optionalString(callID), QueueID: optionalString(queueID),
+		QueueSequence: optionalInt(queueSequence), EnqueueFrame: optionalInt(enqueueFrame),
+		DelayFrames: optionalInt(delayFrames), ExecuteByFrame: optionalInt(executeByFrame),
+		NumericPayload: numericPayload, ParentEventID: optionalString(callID),
+		Value:            optionalFloat(float64(executionFrame)),
+		UncertaintyCodes: []string{"task_candidate_dependency_incomplete"},
+	})
+}
+
+func (r *Runtime) RecordStatusRead(ownerIndex int, key, mode, sourceID string, expiryFrame int, value float64, result *bool) string {
+	if !r.Enabled() || ownerIndex < 0 || key == "" || mode == "" || !finite(value) {
+		return ""
+	}
+	return r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventStatusRead, SourceID: optionalString(sourceID),
+		OwnerIndex: optionalInt(ownerIndex), Key: optionalString(key), Operation: optionalString(mode),
+		ExpiryFrame: optionalInt(expiryFrame), Value: optionalFloat(value), Result: result,
+		UncertaintyCodes: []string{"status_candidate_dependency_incomplete"},
+	})
+}
+
+func (r *Runtime) RecordStatusAdd(ownerIndex int, key, sourceID string, previousExpiry, expiryFrame int, overwrote bool) string {
+	if !r.Enabled() || ownerIndex < 0 || key == "" {
+		return ""
+	}
+	return r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventStatusAdd, SourceID: optionalString(sourceID),
+		OwnerIndex: optionalInt(ownerIndex), Key: optionalString(key),
+		Before: optionalFloat(float64(previousExpiry)), After: optionalFloat(float64(expiryFrame)),
+		ExpiryFrame: optionalInt(expiryFrame), Result: optionalBool(overwrote),
+		UncertaintyCodes: []string{"status_candidate_dependency_incomplete"},
+	})
+}
+
+func (r *Runtime) RecordStatusDelete(ownerIndex int, key, sourceID string, previousExpiry int, existed, wasActive bool) string {
+	if !r.Enabled() || ownerIndex < 0 || key == "" {
+		return ""
+	}
+	return r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventStatusDelete, SourceID: optionalString(sourceID),
+		OwnerIndex: optionalInt(ownerIndex), Key: optionalString(key),
+		Before: optionalFloat(float64(previousExpiry)), Result: optionalBool(existed),
+		Accepted:         optionalBool(wasActive),
+		UncertaintyCodes: []string{"status_candidate_dependency_incomplete"},
+	})
+}
+
+func (r *Runtime) healthOperationExists(operationID string) bool {
+	_, ok := r.healthOperation(operationID)
+	return ok
+}
+
+func (r *Runtime) healthOperation(operationID string) (HealthOperation, bool) {
+	if r == nil || operationID == "" {
+		return HealthOperation{}, false
+	}
+	for index := range r.healthOperations {
+		if r.healthOperations[index].OperationID == operationID {
+			return r.healthOperations[index], true
+		}
+	}
+	return HealthOperation{}, false
+}
+
+func optionalString(value string) *string {
+	if value == "" {
+		return nil
+	}
+	return &value
+}
+
+func optionalInt(value int) *int { return &value }
+
+func optionalFloat(value float64) *float64 { return &value }
+
+func optionalBool(value bool) *bool { return &value }
+
+func cloneStrings(values []string) []string {
+	if values == nil {
+		return []string{}
+	}
+	return append([]string{}, values...)
+}
+
+func cloneNumericPayloads(values []NumericPayload) []NumericPayload {
+	if values == nil {
+		return []NumericPayload{}
+	}
+	out := append([]NumericPayload{}, values...)
+	for index := range out {
+		out[index].Reference = cloneNumericRef(out[index].Reference)
+	}
+	return out
+}
+
+func cloneNumericRefs(values []NumericRef) []NumericRef {
+	if values == nil {
+		return []NumericRef{}
+	}
+	out := append([]NumericRef{}, values...)
+	for index := range out {
+		out[index] = cloneNumericRef(out[index])
+	}
+	return out
+}
+
+func cloneNumericRef(value NumericRef) NumericRef {
+	value.EventID = cloneString(value.EventID)
+	value.HealthOperationID = cloneString(value.HealthOperationID)
+	value.FieldKey = cloneString(value.FieldKey)
+	value.LiteralValue = cloneFloat(value.LiteralValue)
+	return value
+}
+
+func cloneNumericMap(values map[string]float64) map[string]float64 {
+	if values == nil {
+		return map[string]float64{}
+	}
+	out := make(map[string]float64, len(values))
+	for key, value := range values {
+		out[key] = value
+	}
+	return out
+}
+
+func cloneSourceValueParameters(values []SourceValueParameter) []SourceValueParameter {
+	if values == nil {
+		return []SourceValueParameter{}
+	}
+	out := append([]SourceValueParameter{}, values...)
+	for index := range out {
+		out[index].ActorIndex = cloneInt(out[index].ActorIndex)
+		out[index].ActorKey = cloneString(out[index].ActorKey)
+		out[index].StatKey = cloneString(out[index].StatKey)
+	}
+	return out
+}
+
+func finite(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func numericClose(left, right float64) bool {
+	tolerance := 1e-9 * math.Max(1, math.Max(math.Abs(left), math.Abs(right)))
+	return math.Abs(left-right) <= tolerance
+}
+
+func numericProducerKind(kind string) bool {
+	switch kind {
+	case StateEventSlotRegister, StateEventNumericStateRead, StateEventNumericEval,
+		StateEventMaxHPRead, StateEventHealthFieldBinding:
+		return true
+	default:
+		return false
+	}
+}
+
+func normalizeEvidence(complete bool, codes []string) (bool, []string) {
+	canonical := canonicalStrings(codes)
+	if complete && len(canonical) == 0 {
+		return true, canonical
+	}
+	if len(canonical) == 0 {
+		canonical = []string{"state_event_candidate_dependency_incomplete"}
+	}
+	return false, canonical
+}
