new file mode 100644
index 0000000000000000000000000000000000000000..401d2bc1e77efa5985ee928403b6bad94cd88599
--- /dev/null
+++ b/pkg/gttsourcegen/canonical.go
@@ -0,0 +1,79 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strconv"
+)
+
+// CanonicalJSON returns compact JSON with recursively sorted object keys and
+// ASCII-only string escapes. It is the one byte representation used for all
+// build-time source hashes.
+func CanonicalJSON(value any) ([]byte, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.UseNumber()
+	var normalized any
+	if err := decoder.Decode(&normalized); err != nil {
+		return nil, err
+	}
+	var out bytes.Buffer
+	if err := appendCanonicalJSON(&out, normalized); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
+
+func appendCanonicalJSON(out *bytes.Buffer, value any) error {
+	switch value := value.(type) {
+	case nil:
+		out.WriteString("null")
+	case bool:
+		if value {
+			out.WriteString("true")
+		} else {
+			out.WriteString("false")
+		}
+	case string:
+		out.WriteString(strconv.QuoteToASCII(value))
+	case json.Number:
+		out.WriteString(value.String())
+	case []any:
+		out.WriteByte('[')
+		for index, element := range value {
+			if index > 0 {
+				out.WriteByte(',')
+			}
+			if err := appendCanonicalJSON(out, element); err != nil {
+				return err
+			}
+		}
+		out.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(value))
+		for key := range value {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		out.WriteByte('{')
+		for index, key := range keys {
+			if index > 0 {
+				out.WriteByte(',')
+			}
+			out.WriteString(strconv.QuoteToASCII(key))
+			out.WriteByte(':')
+			if err := appendCanonicalJSON(out, value[key]); err != nil {
+				return err
+			}
+		}
+		out.WriteByte('}')
+	default:
+		return fmt.Errorf("unsupported canonical JSON value %T", value)
+	}
+	return nil
+}
diff --git a/pkg/gttsourcegen/forwarded_attack.go b/pkg/gttsourcegen/forwarded_attack.go
new file mode 100644
index 0000000000000000000000000000000000000000..17c940d2335e12619f8f99e572ed562b60127397
--- /dev/null
+++ b/pkg/gttsourcegen/forwarded_attack.go
@@ -0,0 +1,283 @@
+package gttsourcegen
+
+import (
+	"crypto/sha256"
+	"go/ast"
+	"go/token"
+	pathpkg "path"
+	"strconv"
+	"strings"
+)
+
+const (
+	maxForwardedAttackCallDepth    = 5
+	maxForwardedAttackAlternatives = 16
+)
+
+type forwardedAttackFunction struct {
+	rel          string
+	packageDir   string
+	receiverType string
+	receiverName string
+	decl         *ast.FuncDecl
+	parameters   []string
+}
+
+type forwardedAttackSummary struct {
+	parameterIndex      int
+	callDepth           int
+	readFrameExpression string
+}
+
+// augmentForwardedAttackCandidates follows only unambiguous same-receiver
+// method parameters that reach QueueAttack. It is intentionally bounded and
+// does not attempt whole-program type inference or dynamic dispatch.
+func augmentForwardedAttackCandidates(
+	fset *token.FileSet,
+	files []parsedSourceFile,
+	candidates []sourceCandidate,
+) ([]sourceCandidate, error) {
+	methods := make(map[string][]forwardedAttackFunction)
+	functions := make([]forwardedAttackFunction, 0, 256)
+	for _, source := range files {
+		for _, declaration := range source.file.Decls {
+			fn, ok := declaration.(*ast.FuncDecl)
+			if !ok || fn.Body == nil {
+				continue
+			}
+			receiverType, receiverName := receiverIdentity(fset, fn)
+			if receiverType == "" || receiverName == "" {
+				continue
+			}
+			function := forwardedAttackFunction{
+				rel: source.rel, packageDir: pathpkg.Dir(source.rel),
+				receiverType: receiverType, receiverName: receiverName,
+				decl: fn, parameters: namedParameters(fn),
+			}
+			functions = append(functions, function)
+			key := methodLookupKey(function.packageDir, receiverType, fn.Name.Name)
+			methods[key] = append(methods[key], function)
+		}
+	}
+
+	summaries := make(map[*ast.FuncDecl]map[int]forwardedAttackSummary)
+	for index := range functions {
+		function := &functions[index]
+		bindings := collectBindings(function.decl.Body)
+		ast.Inspect(function.decl.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok || !isDirectQueueAttackCall(call) || len(call.Args) == 0 {
+				return true
+			}
+			resolved := resolveExpr(call.Args[0], bindings, nil)
+			parameterIndex := parameterNameIndex(resolved, function.parameters)
+			if parameterIndex < 0 {
+				return true
+			}
+			frame, err := queueReadFrameExpression(fset, call)
+			if err != nil {
+				return true
+			}
+			addForwardedSummary(summaries, function.decl, forwardedAttackSummary{
+				parameterIndex: parameterIndex, callDepth: 1,
+				readFrameExpression: frame,
+			})
+			return true
+		})
+	}
+
+	// Propagate sink summaries through at most five same-receiver calls. A
+	// visited method/parameter pair is represented by the summary map, so a
+	// recursive cycle cannot expand the search.
+	for depth := 2; depth <= maxForwardedAttackCallDepth+1; depth++ {
+		changed := false
+		for index := range functions {
+			function := &functions[index]
+			bindings := collectBindings(function.decl.Body)
+			ast.Inspect(function.decl.Body, func(node ast.Node) bool {
+				call, ok := node.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				callee, ok := resolveSameReceiverAttackMethod(call, *function, methods)
+				if !ok {
+					return true
+				}
+				for _, summary := range summaries[callee.decl] {
+					if summary.callDepth != depth-1 || summary.parameterIndex >= len(call.Args) {
+						continue
+					}
+					resolved := resolveExpr(call.Args[summary.parameterIndex], bindings, nil)
+					parameterIndex := parameterNameIndex(resolved, function.parameters)
+					if parameterIndex < 0 {
+						continue
+					}
+					frame := rebindReceiverRoot(
+						summary.readFrameExpression, callee.receiverName, function.receiverName,
+					)
+					if frame == "" {
+						continue
+					}
+					if addForwardedSummary(summaries, function.decl, forwardedAttackSummary{
+						parameterIndex: parameterIndex, callDepth: depth,
+						readFrameExpression: frame,
+					}) {
+						changed = true
+					}
+				}
+				return true
+			})
+		}
+		if !changed {
+			break
+		}
+	}
+
+	type origin struct {
+		candidate sourceCandidate
+		groupKey  string
+	}
+	origins := make([]origin, 0, 32)
+	counts := make(map[string]int)
+	seen := make(map[string]bool)
+	for index := range functions {
+		function := &functions[index]
+		bindings := collectBindings(function.decl.Body)
+		ast.Inspect(function.decl.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			callee, ok := resolveSameReceiverAttackMethod(call, *function, methods)
+			if !ok {
+				return true
+			}
+			for _, summary := range summaries[callee.decl] {
+				if summary.parameterIndex >= len(call.Args) {
+					continue
+				}
+				root := resolveAttackInfo(call.Args[summary.parameterIndex], bindings)
+				originKey := function.rel + "|" + strconv.Itoa(int(call.Pos())) + "|" + strconv.Itoa(summary.parameterIndex)
+				if root == nil || seen[originKey] {
+					continue
+				}
+				seen[originKey] = true
+				compiled := describeForwardedQueuedAttack(fset, root, bindings)
+				if summary.callDepth > maxForwardedAttackCallDepth {
+					compiled = opaqueTemplate("forwarded_attack_depth_budget_exceeded")
+				}
+				astHash, err := hashAST(fset, root)
+				if err != nil {
+					astHash = strings.Repeat("0", sha256.Size*2)
+					compiled = opaqueTemplate("ast_render_failed")
+				}
+				position := fset.Position(call.Pos())
+				groupKey := methodLookupKey(callee.packageDir, callee.receiverType, callee.decl.Name.Name) + "|" + strconv.Itoa(summary.parameterIndex)
+				counts[groupKey]++
+				origins = append(origins, origin{groupKey: groupKey, candidate: sourceCandidate{
+					kind: KindQueuedAttack, relativeFile: function.rel,
+					line: position.Line, column: position.Column,
+					enclosingSymbol: enclosingSymbol(fset, function.decl),
+					root:            root, astSHA256: astHash, template: compiled,
+					forwardedAttack: &forwardedAttackPlan{
+						ArgumentIndex: summary.parameterIndex,
+						ReadFrameExpression: rebindReceiverRoot(
+							summary.readFrameExpression, callee.receiverName, function.receiverName,
+						),
+						CallDepth: summary.callDepth,
+					},
+				}})
+			}
+			return true
+		})
+	}
+	for _, found := range origins {
+		candidate := found.candidate
+		if counts[found.groupKey] > maxForwardedAttackAlternatives {
+			candidate.template = opaqueTemplate("forwarded_attack_alternative_budget_exceeded")
+		}
+		candidates = append(candidates, candidate)
+	}
+	return candidates, nil
+}
+
+func namedParameters(fn *ast.FuncDecl) []string {
+	if fn == nil || fn.Type.Params == nil {
+		return []string{}
+	}
+	result := make([]string, 0, len(fn.Type.Params.List))
+	for _, field := range fn.Type.Params.List {
+		for _, name := range field.Names {
+			result = append(result, name.Name)
+		}
+	}
+	return result
+}
+
+func parameterNameIndex(expr ast.Expr, parameters []string) int {
+	ident, ok := expr.(*ast.Ident)
+	if !ok {
+		return -1
+	}
+	for index, name := range parameters {
+		if ident.Name == name {
+			return index
+		}
+	}
+	return -1
+}
+
+func isDirectQueueAttackCall(call *ast.CallExpr) bool {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	return ok && strings.HasPrefix(selector.Sel.Name, "QueueAttack")
+}
+
+func resolveSameReceiverAttackMethod(
+	call *ast.CallExpr,
+	owner forwardedAttackFunction,
+	methods map[string][]forwardedAttackFunction,
+) (forwardedAttackFunction, bool) {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return forwardedAttackFunction{}, false
+	}
+	receiver, ok := selector.X.(*ast.Ident)
+	if !ok || receiver.Name != owner.receiverName {
+		return forwardedAttackFunction{}, false
+	}
+	matches := methods[methodLookupKey(owner.packageDir, owner.receiverType, selector.Sel.Name)]
+	if len(matches) != 1 || matches[0].decl == owner.decl {
+		return forwardedAttackFunction{}, false
+	}
+	return matches[0], true
+}
+
+func addForwardedSummary(
+	summaries map[*ast.FuncDecl]map[int]forwardedAttackSummary,
+	decl *ast.FuncDecl,
+	summary forwardedAttackSummary,
+) bool {
+	if summaries[decl] == nil {
+		summaries[decl] = make(map[int]forwardedAttackSummary)
+	}
+	previous, exists := summaries[decl][summary.parameterIndex]
+	if exists && previous.callDepth <= summary.callDepth {
+		return false
+	}
+	summaries[decl][summary.parameterIndex] = summary
+	return true
+}
+
+func rebindReceiverRoot(expression, from, to string) string {
+	if expression == "" || from == "" || to == "" {
+		return ""
+	}
+	if expression == from {
+		return to
+	}
+	prefix := from + "."
+	if !strings.HasPrefix(expression, prefix) {
+		return ""
+	}
+	return to + expression[len(from):]
+}
diff --git a/pkg/gttsourcegen/forwarded_attack_test.go b/pkg/gttsourcegen/forwarded_attack_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0a82976603d4a2aa85a8fa8297889838328482c4
--- /dev/null
+++ b/pkg/gttsourcegen/forwarded_attack_test.go
@@ -0,0 +1,122 @@
+package gttsourcegen
+
+import (
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestForwardedAttackCarriesGenericFormulaAndExplicitIdentity(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) queueAttack(ai info.AttackInfo) {
+	c.Core.QueueAttack(ai)
+}
+func (c *char) attack() {
+	count := c.consumeAllies()
+	damageMultiplier := 1 + 0.1*float64(count)
+	ai := info.AttackInfo{FlatDmg: ratio[0] * c.MaxHP() * damageMultiplier}
+	c.queueAttack(ai)
+}
+`)
+	manifest := generateFixture(t, root)
+	entry := findEntry(t, manifest, KindQueuedAttack, "(*char).attack")
+	if entry.Template.Status != TemplateSupported || entry.forwardedAttack == nil {
+		t.Fatalf("forwarded attack not supported: %#v", entry)
+	}
+	if entry.forwardedAttack.CallDepth != 1 || entry.forwardedAttack.ArgumentIndex != 0 || entry.forwardedAttack.ReadFrameExpression != "c.Core.F" {
+		t.Fatalf("forwarded plan mismatch: %#v", entry.forwardedAttack)
+	}
+	if len(entry.parameterPlans) != 3 {
+		t.Fatalf("parameter plans=%#v", entry.parameterPlans)
+	}
+	foundCandidateHP := false
+	foundFrozenRuntime := false
+	for _, parameter := range entry.parameterPlans {
+		if parameter.Kind == "candidate_stat" && parameter.StatKey == "max_hp" && parameter.ActorExpression == "c" {
+			foundCandidateHP = true
+		}
+		if parameter.Kind == "frozen_runtime_state" && parameter.SourceExpression == "damageMultiplier" && !parameter.CandidateDependencyComplete {
+			foundFrozenRuntime = true
+		}
+	}
+	if !foundCandidateHP || !foundFrozenRuntime {
+		t.Fatalf("forwarded parameter semantics missing: %#v", entry.parameterPlans)
+	}
+
+	overlay, err := BuildOverlay(OverlayOptions{
+		ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay"),
+	}, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(overlay.Files) != 1 {
+		t.Fatalf("overlay files=%d", len(overlay.Files))
+	}
+	rewritten := string(overlay.Files[0].Contents)
+	for _, wanted := range []string{
+		"GTTTraceSourceID:", "GTTTraceSourceTemplateSHA256:",
+		"float64(damageMultiplier)", `Kind: "candidate_stat"`,
+		`Kind: "frozen_runtime_state"`, `ReadFrame: c.Core.F`,
+	} {
+		if !strings.Contains(rewritten, wanted) {
+			t.Fatalf("forwarded overlay lacks %q:\n%s", wanted, rewritten)
+		}
+	}
+	if _, err := parser.ParseFile(token.NewFileSet(), "source.go", overlay.Files[0].Contents, 0); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestForwardedAttackDepthBudgetFailsClosed(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) sink(ai info.AttackInfo) { c.Core.QueueAttack(ai) }
+func (c *char) hop4(ai info.AttackInfo) { c.sink(ai) }
+func (c *char) hop3(ai info.AttackInfo) { c.hop4(ai) }
+func (c *char) hop2(ai info.AttackInfo) { c.hop3(ai) }
+func (c *char) hop1(ai info.AttackInfo) { c.hop2(ai) }
+func (c *char) hop0(ai info.AttackInfo) { c.hop1(ai) }
+func (c *char) allowed() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()}
+	c.hop1(ai)
+}
+func (c *char) overflow() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()}
+	c.hop0(ai)
+}
+func (c *char) cycleA(ai info.AttackInfo) { c.cycleB(ai) }
+func (c *char) cycleB(ai info.AttackInfo) { c.cycleA(ai) }
+func (c *char) cycleOrigin() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()}
+	c.cycleA(ai)
+}
+`)
+	manifest := generateFixture(t, root)
+	allowed := findEntry(t, manifest, KindQueuedAttack, "(*char).allowed")
+	if allowed.Template.Status != TemplateSupported || allowed.forwardedAttack == nil || allowed.forwardedAttack.CallDepth != 5 {
+		t.Fatalf("depth-five attack not accepted: %#v", allowed)
+	}
+	overflow := findEntry(t, manifest, KindQueuedAttack, "(*char).overflow")
+	if overflow.Template.Status != TemplateOpaqueFrozen || overflow.Template.StopReasonCode == nil || *overflow.Template.StopReasonCode != "forwarded_attack_depth_budget_exceeded" {
+		t.Fatalf("depth overflow did not fail closed: %#v", overflow.Template)
+	}
+	for _, entry := range manifest.Entries {
+		if entry.Locator.EnclosingSymbol == "(*char).cycleOrigin" && entry.Locator.Seam == KindQueuedAttack {
+			t.Fatalf("cycle unexpectedly produced a forwarded attack: %#v", entry)
+		}
+	}
+}
+
+func TestNumericExpressionDepthBudgetFailsClosed(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) attack() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()*2*2*2*2*2*2*2*2*2*2*2*2*2}
+	c.Core.QueueAttack(ai)
+}
+`)
+	entry := findEntry(t, generateFixture(t, root), KindQueuedAttack, "(*char).attack")
+	if entry.Template.Status != TemplateOpaqueFrozen || entry.Template.StopReasonCode == nil || *entry.Template.StopReasonCode != "numeric_expression_depth_budget_exceeded" {
+		t.Fatalf("numeric depth overflow did not fail closed: %#v", entry.Template)
+	}
+}
diff --git a/pkg/gttsourcegen/generator_test.go b/pkg/gttsourcegen/generator_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..0a59cb66dede7680e045764c8d0b4ec064fac89d
--- /dev/null
+++ b/pkg/gttsourcegen/generator_test.go
@@ -0,0 +1,428 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+const syntheticSource = `package fixture
+import "example/info"
+type char struct {
+	cur float64
+	maximum float64
+	buff []float64
+	value float64
+}
+func (c *char) sources() {
+	ratio := burstRatio[c.TalentLvlBurst()]
+	c.AddAttackMod(info.AttackMod{Amount: func(atk *info.AttackEvent, target info.Target) []float64 {
+		if !c.Active() { return nil }
+		c.buff[0] = min(c.cur, c.maximum) * ratio
+		return c.buff
+	}})
+	ai := info.AttackInfo{FlatDmg: bubble[c.TalentLvlSkill()] * c.MaxHP()}
+	c.Core.QueueAttack(ai)
+	c.Core.Events.Subscribe(1, func(args ...any) { c.value = unknown(args) })
+	c.Core.Tasks.Add(func() { c.value++ }, 1)
+}
+func (c *char) simple() {
+	c.AddAttackMod(info.AttackMod{Amount: func(atk *info.AttackEvent, target info.Target) []float64 {
+		c.buff[0] = min(c.cur, c.maximum) * 2
+		return c.buff
+	}})
+}
+`
+
+func TestExactManifestTemplatesAndDeterminism(t *testing.T) {
+	root := writeModule(t, syntheticSource)
+	first := generateFixture(t, root)
+	second := generateFixture(t, root)
+	body, err := RenderManifestBody(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bodyAgain, _ := RenderManifestBody(second)
+	if !bytes.Equal(body, bodyAgain) || first.ManifestBodySHA256 != second.ManifestBodySHA256 {
+		t.Fatal("manifest generation is not deterministic")
+	}
+	if bytes.Contains(body, []byte("manifest_body_sha256")) {
+		t.Fatal("body contains its own hash")
+	}
+	var top map[string]json.RawMessage
+	if err := json.Unmarshal(body, &top); err != nil {
+		t.Fatal(err)
+	}
+	wantKeys := []string{"build_flags", "compiler_version", "entries", "formula_identities", "go_toolchain", "kind", "patch_stack_sha256", "patched_source_tree_sha256", "patches", "pristine_source_tree_sha256", "schema_version", "trace_capability", "trace_schema_version", "upstream_ref", "upstream_repo"}
+	for _, key := range wantKeys {
+		if _, ok := top[key]; !ok {
+			t.Fatalf("manifest body lacks %s", key)
+		}
+	}
+	if len(top) != len(wantKeys) {
+		t.Fatalf("manifest body has unexpected top-level fields: %s", body)
+	}
+	sum := sha256.Sum256(body)
+	if first.ManifestBodySHA256 != hex.EncodeToString(sum[:]) {
+		t.Fatal("body hash is not over exact canonical output")
+	}
+	for index, entry := range first.Entries {
+		if index > 0 && first.Entries[index-1].SourceID >= entry.SourceID {
+			t.Fatal("entries are not strictly source_id sorted")
+		}
+		if !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(entry.SourceID) || !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(entry.Template.TemplateSHA256) {
+			t.Fatalf("invalid identity hashes: %#v", entry)
+		}
+		identityBody, err := CanonicalJSON(struct {
+			SourceIDSchema  int    `json:"source_id_schema"`
+			ModulePath      string `json:"module_path"`
+			EnclosingSymbol string `json:"enclosing_symbol"`
+			Seam            string `json:"seam"`
+			Ordinal         int    `json:"ordinal"`
+		}{1, entry.Locator.ModulePath, entry.Locator.EnclosingSymbol, entry.Locator.Seam, entry.Locator.Ordinal})
+		if err != nil {
+			t.Fatal(err)
+		}
+		identitySum := sha256.Sum256(identityBody)
+		if entry.SourceID != hex.EncodeToString(identitySum[:]) {
+			t.Fatal("source ID preimage contract mismatch")
+		}
+		assertTemplateContract(t, entry.Template)
+	}
+	var rawBody struct {
+		Entries []map[string]json.RawMessage `json:"entries"`
+	}
+	if err := json.Unmarshal(body, &rawBody); err != nil || len(rawBody.Entries) == 0 {
+		t.Fatalf("decode entries: %v", err)
+	}
+	for _, key := range []string{"source_id", "locator", "source_node_sha256", "template"} {
+		if _, ok := rawBody.Entries[0][key]; !ok {
+			t.Fatalf("entry lacks exact field %s", key)
+		}
+	}
+	if len(rawBody.Entries[0]) != 4 {
+		t.Fatalf("entry has extra fields: %#v", rawBody.Entries[0])
+	}
+	guarded := findEntry(t, first, KindModifierAmount, "(*char).sources")
+	if guarded.Template.Status != TemplateSupported || guarded.Template.Nodes[len(guarded.Template.Nodes)-1].Operator != "SELECT" || guarded.modifierOutput == nil {
+		t.Fatalf("guarded modifier should compile to a conditional output: %#v", guarded.Template)
+	}
+	simple := findEntry(t, first, KindModifierAmount, "(*char).simple")
+	if simple.Template.Status != TemplateSupported || simple.Template.Nodes[len(simple.Template.Nodes)-1].Operator != "MUL" {
+		t.Fatalf("simple modifier not compiled: %#v", simple.Template)
+	}
+	queued := findEntry(t, first, KindQueuedAttack, "(*char).sources")
+	if queued.Template.Status != TemplateSupported || len(queued.parameterPlans) != 2 {
+		t.Fatalf("HP attack not compiled: %#v", queued.Template)
+	}
+	if queued.parameterPlans[0].Kind != "frozen_source_value" || queued.parameterPlans[0].ReadMode != "constant" || queued.parameterPlans[0].ActorExpression != "" {
+		t.Fatalf("frozen source invariant broken: %#v", queued.parameterPlans[0])
+	}
+	if queued.parameterPlans[1].Kind != "candidate_stat" || queued.parameterPlans[1].StatKey != "max_hp" || queued.parameterPlans[1].ActorExpression != "c" {
+		t.Fatalf("candidate stat invariant broken: %#v", queued.parameterPlans[1])
+	}
+	generated, err := RenderLookupGo(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := parser.ParseFile(token.NewFileSet(), "generated_manifest.go", generated, 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"generatedSourceManifestBodySHA256", "generatedSourceCompilerVersion", "generatedSourceIDByLookupKey", "generatedTemplateSHA256BySourceID"} {
+		if !bytes.Contains(generated, []byte(name)) {
+			t.Fatalf("generated Go lacks %s", name)
+		}
+	}
+}
