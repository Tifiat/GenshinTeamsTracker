+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"math"
+	"sort"
+)
+
+func (c *supportCompiler) compileArtifactStatRead(event gtttrace.StateEvent) compiledNode {
+	observed := valueOr(event.Value, 0)
+	if event.OwnerIndex == nil || *event.OwnerIndex < 0 || *event.OwnerIndex >= len(c.characterKeys) || event.Key == nil || !artifactVariableStat(*event.Key) {
+		c.markUnknown("artifact_stat_read_binding_unresolved")
+		return c.b.constant(observed)
+	}
+	key := *event.Key
+	actor := c.characterKeys[*event.OwnerIndex]
+	node := c.b.add(c.b.constant(observed), c.b.artifactDelta(actor, key))
+	for _, id := range event.ModifierEvalIDs {
+		if candidate, ok := c.eventOutputs[id][key]; ok {
+			node = c.b.add(node, c.b.subtract(candidate, c.b.constant(c.eventByID[id].Output[key])))
+		}
+	}
+	return node
+}
+
+func attackFieldDelta(attempt info.GTTTraceCallbackAttempt, field string) float64 {
+	switch field {
+	case "FlatDmg":
+		return attempt.FlatDmgDelta
+	case "BaseDmgBonus":
+		return attempt.BaseDmgBonusDelta
+	}
+	return 0
+}
+
+func hasFlatWriteReceipt(hit info.GTTTraceHit) bool {
+	for _, write := range allNumericWrites(hit) {
+		if write.Field == "FlatDmg" {
+			return true
+		}
+	}
+	return false
+}
+
+// Live captures carry the full ledger. Older serialized captures carry only
+// callback subsets; retain that old, explicitly partial compatibility path.
+func allNumericWrites(hit info.GTTTraceHit) []info.GTTNumericFieldWrite {
+	if hit.NumericFieldWrites != nil {
+		return hit.NumericFieldWrites
+	}
+	var out []info.GTTNumericFieldWrite
+	for _, attempt := range hit.CallbackAttempts {
+		out = append(out, attempt.NumericWrites...)
+	}
+	return out
+}
+
+func attackFieldInitial(hit info.GTTTraceHit, field string, terminal float64) float64 {
+	callbackOrders := map[int]bool{}
+	for _, attempt := range hit.CallbackAttempts {
+		terminal -= attackFieldDelta(attempt, field)
+		for _, w := range attempt.NumericWrites {
+			callbackOrders[w.Order] = true
+		}
+	}
+	for _, w := range hit.NumericFieldWrites {
+		if w.Field == field && !callbackOrders[w.Order] {
+			terminal -= w.After - w.Before
+		}
+	}
+	return terminal
+}
+
+// Compose the observed sequence, including replacement/multiplication. A
+// missing write or inconsistent ledger freezes the field, never silently
+// assumes all callbacks were additive. Unknown operands can remain local
+// constants while the known incoming producer still changes.
+func (c *directCompiler) compileAttackField(hit info.GTTTraceHit, field string, initial compiledNode, terminal float64) compiledNode {
+	fail := func(reason string) compiledNode {
+		c.unknown["attack_field_"+reason+":"+field] = struct{}{}
+		return c.b.constant(terminal)
+	}
+	var writes []info.GTTNumericFieldWrite
+	for _, attempt := range hit.CallbackAttempts {
+		observed := attackFieldDelta(attempt, field)
+		covered := 0.0
+		for _, write := range attempt.NumericWrites {
+			if write.Field == field {
+				covered += write.After - write.Before
+			}
+		}
+		if !closeEnough(observed, covered) {
+			return fail("unobserved_write")
+		}
+	}
+	for _, write := range allNumericWrites(hit) {
+		if write.Field == field {
+			writes = append(writes, write)
+		}
+	}
+	sort.SliceStable(writes, func(i, j int) bool { return writes[i].Order < writes[j].Order })
+	current := initial
+	for i, write := range writes {
+		if i > 0 && writes[i-1].Order == write.Order {
+			return fail("duplicate_write")
+		}
+		if !closeEnough(current.baseline, write.Before) {
+			return fail("predecessor_mismatch")
+		}
+		operand := c.b.constant(write.Operand)
+		resolved := false
+		if write.Recipe != nil && closeEnough(write.Recipe.Observed, write.Operand) {
+			budget := 512
+			operand = c.compileNumericRecipePart(info.GTTTraceHit{NumericRecipe: write.Recipe}, "", true, 0, &budget)
+			resolved = true
+		} else if write.Reference.Kind == "event" && write.Reference.EventID != nil {
+			id := *write.Reference.EventID
+			if write.Reference.FieldKey != nil {
+				operand, resolved = c.support.eventOutputs[id][*write.Reference.FieldKey]
+			} else {
+				operand, resolved = c.support.eventNodes[id]
+			}
+		} else if write.Reference.Kind == "literal" && write.Reference.LiteralValue != nil {
+			operand = c.b.constant(*write.Reference.LiteralValue)
+			resolved = true
+		}
+		if !resolved || !closeEnough(operand.baseline, write.Operand) {
+			return fail("operand_unresolved")
+		}
+		switch write.Operation {
+		case "assign":
+			current = operand
+		case "add":
+			current = c.b.add(current, operand)
+		case "subtract":
+			current = c.b.subtract(current, operand)
+		case "multiply":
+			current = c.b.multiply(current, operand)
+		case "divide":
+			if operand.baseline == 0 {
+				return fail("zero_divisor")
+			}
+			current = c.b.divide(current, operand)
+		default:
+			return fail("operation_unresolved")
+		}
+		if math.IsNaN(current.baseline) || math.IsInf(current.baseline, 0) || !closeEnough(current.baseline, write.After) {
+			return fail("arithmetic_mismatch")
+		}
+	}
+	if !closeEnough(current.baseline, terminal) {
+		return fail("terminal_mismatch")
+	}
+	return current
+}
+
+func (c *directCompiler) compileTerminalFlat(hit info.GTTTraceHit, actor string, dynamic map[string]compiledNode) compiledNode {
+	producer := hit
+	producer.FlatDmg = attackFieldInitial(hit, "FlatDmg", hit.FlatDmg)
+	initial := c.compileFlatDamage(producer, actor, dynamic)
+	return c.compileAttackField(hit, "FlatDmg", initial, hit.FlatDmg)
+}
+
+func (c *directCompiler) compileBaseBonus(hit info.GTTTraceHit) compiledNode {
+	initial := c.b.constant(attackFieldInitial(hit, "BaseDmgBonus", hit.BaseDmgBonus))
+	return c.compileAttackField(hit, "BaseDmgBonus", initial, hit.BaseDmgBonus)
+}
+
+func (c *directCompiler) compileTalentMultiplier(hit info.GTTTraceHit) compiledNode {
+	for _, attempt := range hit.CallbackAttempts {
+		for _, write := range attempt.NumericWrites {
+			if write.Field == "BaseDmgBonus" {
+				return c.b.multiply(c.b.constant(hit.Mult), c.b.add(c.b.constant(1), c.compileBaseBonus(hit)))
+			}
+		}
+	}
+	return c.b.constant(hit.Mult * (1 + hit.BaseDmgBonus))
+}
