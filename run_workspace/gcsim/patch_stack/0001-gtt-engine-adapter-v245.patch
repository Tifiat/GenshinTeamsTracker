diff --git a/cmd/gtt-source-manifest/main.go b/cmd/gtt-source-manifest/main.go
new file mode 100644
--- /dev/null
+++ b/cmd/gtt-source-manifest/main.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/gttsourcegen"
+)
+
+type stringList []string
+
+func (values *stringList) String() string { return strings.Join(*values, ",") }
+func (values *stringList) Set(value string) error {
+	for _, part := range strings.Split(value, ",") {
+		if part = strings.TrimSpace(part); part != "" {
+			*values = append(*values, part)
+		}
+	}
+	return nil
+}
+
+func main() {
+	if err := run(os.Args[1:], os.Getenv, os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, "gtt-source-manifest:", err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, getenv func(string) string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("gtt-source-manifest", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	var root, bindingIn, jsonOut, goOut, overlayOut, overlayDir string
+	var includes stringList
+	var includeTests bool
+	flags.StringVar(&root, "root", "", "module root (env GTT_SOURCE_ROOT)")
+	flags.StringVar(&root, "module-root", "", "alias for -root")
+	flags.StringVar(&bindingIn, "binding-in", "", "frozen binding input JSON (env GTT_SOURCE_BINDING_IN)")
+	flags.StringVar(&jsonOut, "json-out", "", "canonical body output (env GTT_SOURCE_JSON_OUT)")
+	flags.StringVar(&jsonOut, "manifest-out", "", "alias for -json-out")
+	flags.StringVar(&goOut, "go-out", "", "generated package gttsource output (env GTT_SOURCE_GO_OUT)")
+	flags.StringVar(&overlayOut, "overlay-out", "", "Go overlay JSON output (env GTT_SOURCE_OVERLAY_OUT)")
+	flags.StringVar(&overlayDir, "overlay-dir", "", "overlay replacement root (env GTT_SOURCE_OVERLAY_DIR)")
+	flags.Var(&includes, "include", "module-relative scan path; repeat or comma-separate")
+	flags.BoolVar(&includeTests, "include-tests", false, "scan *_test.go files")
+	if err := flags.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return err
+	}
+	if flags.NArg() != 0 {
+		return fmt.Errorf("unexpected positional arguments: %s", strings.Join(flags.Args(), " "))
+	}
+	root = firstNonEmpty(root, getenv("GTT_SOURCE_ROOT"), ".")
+	bindingIn = firstNonEmpty(bindingIn, getenv("GTT_SOURCE_BINDING_IN"))
+	jsonOut = firstNonEmpty(jsonOut, getenv("GTT_SOURCE_JSON_OUT"))
+	goOut = firstNonEmpty(goOut, getenv("GTT_SOURCE_GO_OUT"))
+	overlayOut = firstNonEmpty(overlayOut, getenv("GTT_SOURCE_OVERLAY_OUT"))
+	overlayDir = firstNonEmpty(overlayDir, getenv("GTT_SOURCE_OVERLAY_DIR"))
+	if bindingIn == "" || jsonOut == "" || goOut == "" {
+		return errors.New("-binding-in, -json-out, and -go-out are required")
+	}
+	if (overlayOut == "") != (overlayDir == "") {
+		return errors.New("-overlay-out and -overlay-dir must be supplied together")
+	}
+	bindingData, err := os.ReadFile(bindingIn)
+	if err != nil {
+		return fmt.Errorf("read -binding-in: %w", err)
+	}
+	var binding gttsourcegen.BindingInput
+	decoder := json.NewDecoder(strings.NewReader(string(bindingData)))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&binding); err != nil {
+		return fmt.Errorf("decode -binding-in: %w", err)
+	}
+	manifest, err := gttsourcegen.Generate(gttsourcegen.Options{
+		ModuleRoot: root, Includes: includes, IncludeTests: includeTests, Binding: binding,
+	})
+	if err != nil {
+		return err
+	}
+	body, err := gttsourcegen.RenderManifestBody(manifest)
+	if err != nil {
+		return err
+	}
+	lookup, err := gttsourcegen.RenderLookupGo(manifest)
+	if err != nil {
+		return err
+	}
+	if err := writeOutput(jsonOut, append(body, '\n')); err != nil {
+		return fmt.Errorf("write -json-out: %w", err)
+	}
+	if err := writeOutput(goOut, lookup); err != nil {
+		return fmt.Errorf("write -go-out: %w", err)
+	}
+	if overlayOut != "" {
+		overlay, err := gttsourcegen.BuildOverlay(gttsourcegen.OverlayOptions{ModuleRoot: root, OverlayDir: overlayDir}, manifest)
+		if err != nil {
+			return err
+		}
+		for _, file := range overlay.Files {
+			if err := writeOutput(file.ReplacementPath, file.Contents); err != nil {
+				return err
+			}
+		}
+		if err := writeOutput(overlayOut, append(overlay.JSON, '\n')); err != nil {
+			return err
+		}
+	}
+	fmt.Fprintf(stdout, "manifest_sha256=%s sources=%d\n", manifest.ManifestBodySHA256, len(manifest.Entries))
+	return nil
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, value := range values {
+		if strings.TrimSpace(value) != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func writeOutput(path string, data []byte) error {
+	absolute, err := filepath.Abs(path)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(absolute), 0o755); err != nil {
+		return err
+	}
+	return os.WriteFile(absolute, data, 0o644)
+}
diff --git a/cmd/gtt-source-manifest/main_test.go b/cmd/gtt-source-manifest/main_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/gtt-source-manifest/main_test.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gttsourcegen"
+)
+
+func TestFrozenFlagsWriteCanonicalOutputs(t *testing.T) {
+	root := t.TempDir()
+	mustWrite(t, filepath.Join(root, "go.mod"), []byte("module fixture.test\n\ngo 1.25\n"))
+	mustWrite(t, filepath.Join(root, "source.go"), []byte(`package fixture
+func f(c *char) { ai := info.AttackInfo{FlatDmg:c.MaxHP()}; c.Core.QueueAttack(ai) }
+`))
+	build := filepath.Join(root, "build")
+	bindingPath := filepath.Join(build, "binding.json")
+	binding := gttsourcegen.BindingInput{
+		SchemaVersion: 1, Kind: gttsourcegen.BindingInputKind,
+		UpstreamRepo: "https://example.test/repo.git", UpstreamRef: "abc",
+		PristineSourceTreeSHA256: strings.Repeat("a", 64),
+		Patches:                  []gttsourcegen.PatchIdentity{}, PatchStackSHA256: strings.Repeat("b", 64),
+		TraceSchemaVersion: 6, TraceCapability: "gtt_trace_equation_v6",
+		FormulaIdentities: []gttsourcegen.FormulaIdentity{{ID: gttsourcegen.IRVersion, SHA256: gttsourcegen.IRSHA256}},
+		GoToolchain:       gttsourcegen.GoToolchain{Version: "go1.25.0", OS: "windows", Arch: "amd64"},
+		BuildFlags:        []string{"-trimpath"},
+	}
+	data, _ := json.Marshal(binding)
+	mustWrite(t, bindingPath, data)
+	jsonOut := filepath.Join(build, "manifest.json")
+	goOut := filepath.Join(build, "generated.go")
+	var stdout, stderr bytes.Buffer
+	err := run([]string{"-root", root, "-binding-in", bindingPath, "-json-out", jsonOut, "-go-out", goOut}, func(string) string { return "" }, &stdout, &stderr)
+	if err != nil {
+		t.Fatalf("run: %v, stderr=%s", err, stderr.String())
+	}
+	manifestData, err := os.ReadFile(jsonOut)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(manifestData, []byte("manifest_body_sha256")) || !bytes.Contains(manifestData, []byte(`"kind":"gtt.source_manifest.body"`)) {
+		t.Fatalf("unexpected canonical output: %s", manifestData)
+	}
+	generated, err := os.ReadFile(goOut)
+	if err != nil || !bytes.Contains(generated, []byte("generatedSourceIDByLookupKey")) {
+		t.Fatalf("generated Go missing: %v", err)
+	}
+	if !strings.Contains(stdout.String(), "manifest_sha256=") {
+		t.Fatalf("stdout=%q", stdout.String())
+	}
+	stderr.Reset()
+	if err := run([]string{"-h"}, func(string) string { return "" }, &stdout, &stderr); err != nil {
+		t.Fatal(err)
+	}
+	for _, flagName := range []string{"-root", "-binding-in", "-json-out", "-go-out", "-overlay-out", "-overlay-dir"} {
+		if !strings.Contains(stderr.String(), flagName) {
+			t.Fatalf("help lacks frozen flag %s: %s", flagName, stderr.String())
+		}
+	}
+}
+
+func mustWrite(t *testing.T, path string, data []byte) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
