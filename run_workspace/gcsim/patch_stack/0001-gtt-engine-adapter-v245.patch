+
+// Synthetic receipts test generic dispatch, not any particular game reaction.
+func TestGOB11AOperatorUsesProducerReceiptNotTagOrDisplayName(t *testing.T) {
+	atk := &info.AttackEvent{}
+	atk.Snapshot.GTTReactionFormula = &info.GTTTraceReactionFormula{
+		FormulaID:     info.GTTTraceTransformativeFormulaID,
+		FormulaSHA256: info.GTTTraceTransformativeFormulaSHA256,
+		OperatorID:    "spawn_damage_attack",
+	}
+	for _, tag := range []attacks.AttackTag{attacks.AttackTagNormal, attacks.AttackTag(99999)} {
+		atk.Info.AttackTag = tag
+		atk.Info.Abil = "unseen renamed ability"
+		if got := gttTraceReactionOperatorID(atk); got != "spawn_damage_attack" {
+			t.Fatalf("tag %d: got %s", tag, got)
+		}
+	}
+	atk.Snapshot.GTTReactionFormula.FormulaID = "unknown_producer"
+	if got := gttTraceReactionOperatorID(atk); got != "opaque_custom" {
+		t.Fatalf("unknown receipt became %s", got)
+	}
+	atk.Snapshot.GTTReactionFormula = nil
+	atk.Info.Amped = true
+	if got := gttTraceReactionOperatorID(atk); got != "multiply_parent_hit" {
+		t.Fatal(got)
+	}
+	atk.Info.Amped = false
+	atk.Info.Catalyzed = true
+	if got := gttTraceReactionOperatorID(atk); got != "add_flat_to_parent_hit_before_bonuses" {
+		t.Fatal(got)
+	}
+}
+
+func TestGOB11ACalculationPathIsObservedAndTraceOffIsInert(t *testing.T) {
+	atk := &info.AttackEvent{}
+	gttTraceCalculationPath(atk, info.GTTTraceFormulaDirectReaction, false)
+	if atk.GTTTraceHit != nil {
+		t.Fatal("disabled trace produced a hit")
+	}
+	for _, tc := range []struct {
+		kind          string
+		bonus         bool
+		initial, want string
+	}{
+		{info.GTTTraceFormulaStandard, true, "none", "none"},
+		{info.GTTTraceFormulaStandard, false, "none", "opaque_custom"},
+		{info.GTTTraceFormulaStandard, false, "spawn_damage_attack", "spawn_damage_attack"},
+		{info.GTTTraceFormulaDirectReaction, false, "none", "opaque_custom"},
+	} {
+		atk.GTTTraceHit = &info.GTTTraceHit{ReactionOperatorID: tc.initial}
+		gttTraceCalculationPath(atk, tc.kind, tc.bonus)
+		if atk.GTTTraceHit.FormulaKind != tc.kind || atk.GTTTraceHit.ReactionOperatorID != tc.want {
+			t.Fatalf("%+v: %+v", tc, atk.GTTTraceHit)
+		}
+	}
+}
