+func (c *CharWrapper) gttRecordModifierEval(
+	channel, modifierKey, sourceID string,
+	provider gtttrace.Provider,
+	expiryFrame int,
+	amount []float64,
+	inputs []gtttrace.NumericRef,
+) string {
+	if !c.gttTrace.Enabled() {
+		return ""
+	}
+	output := make(map[string]float64)
+	for stat, value := range amount {
+		name := attributes.Stat(stat).String()
+		if name != "" && (value != 0 || c.gttTrace.HasSavedStatCell(&amount[stat])) {
+			output[name] = value
+		}
+	}
+	return c.gttTrace.RecordModifierEval(
+		channel, modifierKey, c.Index(), sourceID, provider, expiryFrame,
+		amount != nil, output, inputs,
+		gtttrace.IncompleteEvidence("modifier_candidate_dependency_incomplete"),
+	)
