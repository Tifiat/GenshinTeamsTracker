+package gttcompact
+
+import "testing"
+
+// Boundary with the UI/native inventory contract, not a list of useful stats
+// per character. ER can affect damage while burst energy remains ignored.
+func TestArtifactStatCoordinatesMatchInventoryContract(t *testing.T) {
+	for key, want := range map[string]string{
+		"hp": "hp", "atk": "atk", "def": "def", "hp%": "hp_percent", "atk%": "atk_percent", "def%": "def_percent",
+		"em": "em", "er": "energy_recharge", "cr": "crit_rate", "cd": "crit_damage", "heal": "healing_bonus",
+		"phys%": "physical_damage_bonus", "pyro%": "pyro_damage_bonus", "hydro%": "hydro_damage_bonus",
+		"electro%": "electro_damage_bonus", "cryo%": "cryo_damage_bonus", "anemo%": "anemo_damage_bonus", "geo%": "geo_damage_bonus", "dendro%": "dendro_damage_bonus",
+	} {
+		if !artifactVariableStat(key) {
+			t.Errorf("artifact stat frozen: %s", key)
+		}
+		if got := normalizeCoordinate("actor", key); got != "actor."+want {
+			t.Errorf("%s -> %s, want %s", key, got, want)
+		}
+	}
+	for _, key := range []string{"base_atk", "base_hp", "base_def", "n/a", "atkspd%"} {
+		if artifactVariableStat(key) {
+			t.Errorf("non-artifact stat promoted: %s", key)
+		}
+	}
+}
