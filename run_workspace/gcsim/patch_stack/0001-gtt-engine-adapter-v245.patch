+func (r *Runtime) appendStateEvent(row StateEvent) string {
+	if !r.Enabled() {
+		return ""
+	}
+	row.SequenceIndex = len(r.stateEvents)
+	row.EventID = r.nextStateEventID()
+	if row.Frame < 0 {
+		row.Frame = r.Frame()
+	}
+	if row.Provider == (Provider{}) {
+		row.Provider = r.Current()
+	} else {
+		row.Provider = NormalizeProvider(row.Provider)
+	}
+	row.SourceID = r.validOptionalSourceID(row.SourceID)
+	row.SourceOccurrenceID = r.validOptionalOccurrenceID(row.SourceOccurrenceID)
+	if row.SourceOccurrenceID == nil {
+		row.SourceOccurrenceID = r.matchingCurrentOccurrence(row.SourceID, row.Provider)
+	}
+	if row.ParentEventID == nil && len(r.stateEventStack) > 0 {
+		row.ParentEventID = optionalString(r.stateEventStack[len(r.stateEventStack)-1])
+	}
+	if row.HealthOperationID == nil && len(r.healthContextStack) > 0 {
+		row.HealthOperationID = optionalString(r.healthContextStack[len(r.healthContextStack)-1])
+	}
+	row.SourceID = cloneString(row.SourceID)
+	row.SourceOccurrenceID = cloneString(row.SourceOccurrenceID)
+	row.ParentEventID = cloneString(row.ParentEventID)
+	row.HealthOperationID = cloneString(row.HealthOperationID)
+	row.TaskID = cloneString(row.TaskID)
+	row.CallID = cloneString(row.CallID)
+	row.SlotID = cloneString(row.SlotID)
+	row.Channel = cloneString(row.Channel)
+	row.Key = cloneString(row.Key)
+	row.Operation = cloneString(row.Operation)
+	row.TemplateSHA256 = cloneString(row.TemplateSHA256)
+	row.Before = cloneFloat(row.Before)
+	row.Value = cloneFloat(row.Value)
+	row.After = cloneFloat(row.After)
+	row.Result = cloneBool(row.Result)
+	row.Accepted = cloneBool(row.Accepted)
+	row.EnqueueFrame = cloneInt(row.EnqueueFrame)
+	row.DelayFrames = cloneInt(row.DelayFrames)
+	row.ExecuteByFrame = cloneInt(row.ExecuteByFrame)
+	row.QueueID = cloneString(row.QueueID)
+	row.QueueSequence = cloneInt(row.QueueSequence)
+	row.ExpiryFrame = cloneInt(row.ExpiryFrame)
+	row.OwnerIndex = cloneInt(row.OwnerIndex)
+	row.TargetIndex = cloneInt(row.TargetIndex)
+	row.BoundEventID = cloneString(row.BoundEventID)
+	row.Inputs = cloneNumericRefs(row.Inputs)
+	row.ModifierEvalIDs = cloneStrings(row.ModifierEvalIDs)
+	row.Parameters = cloneSourceValueParameters(row.Parameters)
+	row.NumericPayload = cloneNumericPayloads(row.NumericPayload)
+	row.Output = cloneNumericMap(row.Output)
+	row.CandidateDependencyComplete, row.UncertaintyCodes = normalizeEvidence(
+		row.CandidateDependencyComplete, row.UncertaintyCodes,
+	)
+	row.Authoritative = false
+	r.stateEvents = append(r.stateEvents, row)
+	if numericProducerKind(row.Kind) {
+		for index := range r.numericDependencyCaptures {
+			r.numericDependencyCaptures[index].ids = append(r.numericDependencyCaptures[index].ids, row.EventID)
+		}
+	}
+	return row.EventID
+}
+
+// matchingCurrentOccurrence links a V6 state row to the inherited V4/V5
+// occurrence ledger only when both ledgers describe the same source and
+// provider. A state operation may carry its own source identity while running
+// inside a different callback occurrence; inventing that cross-source link is
+// worse than leaving the optional occurrence relation empty.
+func (r *Runtime) matchingCurrentOccurrence(sourceID *string, provider Provider) *string {
+	if sourceID == nil {
+		return nil
+	}
+	occurrenceID := r.CurrentOccurrenceID()
+	index, ok := r.occurrenceIndex[occurrenceID]
+	if !ok || index < 0 || index >= len(r.sourceOccurrences) {
+		return nil
+	}
+	occurrence := r.sourceOccurrences[index]
+	if occurrence.SourceID != *sourceID || occurrence.Provider != provider {
+		return nil
+	}
+	return optionalString(occurrenceID)
+}
+
+func (r *Runtime) validOptionalSourceID(value *string) *string {
+	if value == nil || !validSHA256(*value) {
+		return nil
+	}
+	return value
+}
+
+func (r *Runtime) validOptionalOccurrenceID(value *string) *string {
+	if value == nil {
+		return nil
+	}
+	if _, ok := r.occurrenceIndex[*value]; !ok {
+		return nil
+	}
+	return value
+}
+
+func (r *Runtime) StateSlots() []StateSlot {
+	if r == nil || len(r.stateSlots) == 0 {
+		return []StateSlot{}
+	}
+	out := make([]StateSlot, len(r.stateSlots))
+	for index, row := range r.stateSlots {
+		row.UncertaintyCodes = cloneStrings(row.UncertaintyCodes)
+		out[index] = row
+	}
+	return out
+}
+
+func (r *Runtime) CurrentHealthOperationID() string {
+	if !r.Enabled() || len(r.healthContextStack) == 0 {
+		return ""
+	}
+	return r.healthContextStack[len(r.healthContextStack)-1]
+}
+
+// CurrentHealthChangePercentRefs recognizes the generic normalized health
+// change used by event consumers: effective event amount / max HP * 100.
+// A mismatched value fails open to a literal, so unrelated callback values do
+// not acquire a false health dependency.
+func (r *Runtime) CurrentHealthChangePercentRefs(observed float64) []NumericRef {
+	if r == nil || !r.Enabled() || !finite(observed) {
+		return []NumericRef{LiteralRef(observed)}
+	}
+	operationID := r.CurrentHealthOperationID()
+	operation, ok := r.healthOperation(operationID)
+	if !ok || !finite(operation.EventEffectiveAmount) || !finite(operation.MaxHPAfter) || operation.MaxHPAfter <= 0 {
+		return []NumericRef{LiteralRef(observed)}
+	}
+	expected := operation.EventEffectiveAmount / operation.MaxHPAfter * 100
+	tolerance := 1e-9 * math.Max(1, math.Max(math.Abs(expected), math.Abs(observed)))
+	if math.Abs(expected-observed) > tolerance {
+		return []NumericRef{LiteralRef(observed)}
+	}
+	return []NumericRef{
+		HealthFieldRef(operationID, "event_effective_amount"),
+		HealthFieldRef(operationID, "max_hp_after"),
+		LiteralRef(100),
+	}
+}
+
+// RecordCurrentHealthChangePercentEval turns a structurally proven normalized
+// health change into an executable numeric DAG. A runtime mismatch remains an
+// opaque source expression, preserving the previous fail-open behavior without
+// assigning an unrelated health operation a false dependency.
+func (r *Runtime) RecordCurrentHealthChangePercentEval(
+	sourceID string,
+	observed float64,
+	evidence DependencyEvidence,
+) string {
+	refs := r.CurrentHealthChangePercentRefs(observed)
+	if len(refs) != 3 || refs[0].Kind != "health_field" || refs[1].Kind != "health_field" ||
+		refs[2].Kind != "literal" || refs[0].HealthOperationID == nil ||
+		refs[1].HealthOperationID == nil || *refs[0].HealthOperationID != *refs[1].HealthOperationID {
+		return r.RecordNumericEval(sourceID, "source_expression", refs, observed, evidence)
+	}
+	operation, ok := r.healthOperation(*refs[0].HealthOperationID)
+	if !ok || operation.MaxHPAfter <= 0 {
+		return r.RecordNumericEval(sourceID, "source_expression", refs, observed, evidence)
+	}
+	ratio := operation.EventEffectiveAmount / operation.MaxHPAfter
+	divideID := r.RecordNumericEval(sourceID, "divide", refs[:2], ratio, evidence)
+	if divideID == "" {
+		return ""
+	}
+	return r.RecordNumericEval(
+		sourceID,
+		"multiply",
+		[]NumericRef{EventRef(divideID), refs[2]},
+		observed,
+		evidence,
+	)
+}
