@@ -0,0 +1,52 @@
+package gtt
+
+import (
+	"encoding/json"
+	"io"
+
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+)
+
+const (
+	PatchVersion                = "gtt-compact-equation-v1"
+	TraceEquationV1Capability   = "gtt_trace_equation_v1"
+	TraceEquationV2Capability   = "gtt_trace_equation_v2"
+	TraceEquationV3Capability   = "gtt_trace_equation_v3"
+	TraceEquationV4Capability   = "gtt_trace_equation_v4"
+	TraceEquationV5Capability   = "gtt_trace_equation_v5"
+	TraceEquationV6Capability   = "gtt_trace_equation_v6"
+	CompactEquationV1Capability = "gtt_compact_equation_v1"
+	EffectInputsV1Capability    = "gtt_effect_inputs_v1"
+	SourceManifestV1Capability  = "gtt_source_manifest_v1"
+	TraceProvenanceV1Capability = "gtt_trace_provenance_v1"
+)
+
+type EngineInfo struct {
+	GTTEngine                bool     `json:"gtt_engine"`
+	GTTPatchVersion          string   `json:"gtt_patch_version"`
+	Capabilities             []string `json:"capabilities"`
+	SequentialWaves          bool     `json:"sequential_waves"`
+	WaveSchedulerStage       string   `json:"wave_scheduler_stage,omitempty"`
+	UpstreamVersion          string   `json:"upstream_version,omitempty"`
+	SourceManifestBodySHA256 string   `json:"source_manifest_body_sha256,omitempty"`
+	SourceCompilerVersion    string   `json:"source_manifest_compiler_version,omitempty"`
+}
+
+func Info(upstreamVersion string) EngineInfo {
+	return EngineInfo{
+		GTTEngine:                true,
+		GTTPatchVersion:          PatchVersion,
+		Capabilities:             []string{"gtt_engine_marker", WaveScenarioPayloadCapability, TraceEquationV2Capability, TraceEquationV3Capability, TraceEquationV4Capability, TraceEquationV5Capability, TraceEquationV6Capability, CompactEquationV1Capability, EffectInputsV1Capability, SourceManifestV1Capability, TraceProvenanceV1Capability},
+		SequentialWaves:          true,
+		WaveSchedulerStage:       "scenario_payload_v1",
+		UpstreamVersion:          upstreamVersion,
+		SourceManifestBodySHA256: gttsource.ManifestBodySHA256(),
+		SourceCompilerVersion:    gttsource.CompilerVersion(),
+	}
+}
+
+func WriteInfo(w io.Writer, upstreamVersion string) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetEscapeHTML(false)
+	return encoder.Encode(Info(upstreamVersion))
+}
