@@ -0,0 +1,1110 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	pathpkg "path"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const traceImportPath = "github.com/genshinsim/gcsim/pkg/gtttrace"
+const traceImportAlias = "gtttracev6"
+
+func v6InstrumentationEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	rel string,
+	file *ast.File,
+	wanted []SourceEntry,
+) ([]textEdit, bool, error) {
+	edits := make([]textEdit, 0, 64)
+	needsImport := false
+	entryByCall := make(map[string]SourceEntry)
+	stateByLine := make(map[int]SourceEntry)
+	resolvedTasks := make(map[string]SourceEntry)
+	ordinaryCalls := make(map[string]struct {
+		entry SourceEntry
+		plan  ordinaryHelperPlan
+	})
+	ordinaryBodies := make(map[string]struct {
+		entry SourceEntry
+		plan  ordinaryHelperPlan
+	})
+	eventCallbackUses := make(map[string]int)
+	taskCallbackUses := make(map[string]int)
+	for _, entry := range wanted {
+		if entry.RelativeFile == rel {
+			switch entry.Locator.Seam {
+			case KindTaskCallback, KindModifierAmount, KindEventCallback:
+				entryByCall[entry.Locator.Seam+"|"+strconv.Itoa(entry.Line)] = entry
+			case KindStateOperation:
+				stateByLine[entry.Line] = entry
+			}
+		}
+		if entry.Locator.Seam == KindTaskCallback && entry.callback != nil && entry.callback.ResolvedFile == rel && entry.callback.ResolvedMethodName != "" {
+			key := entry.callback.ResolvedMethodName + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+			resolvedTasks[key] = entry
+		}
+		if entry.Locator.Seam == KindTaskCallback && entry.callback != nil {
+			callbackKey := entry.callback.ResolvedFile + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+			taskCallbackUses[callbackKey]++
+		}
+		if entry.Locator.Seam == KindEventCallback && entry.callback != nil {
+			callbackKey := entry.callback.ResolvedFile + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+			eventCallbackUses[callbackKey]++
+			for _, helper := range entry.callback.OrdinaryHelpers {
+				callKey := helper.CallFile + "|" + strconv.Itoa(helper.CallLine) + "|" + strconv.Itoa(helper.CallColumn)
+				ordinaryCalls[callKey] = struct {
+					entry SourceEntry
+					plan  ordinaryHelperPlan
+				}{entry: entry, plan: helper}
+				bodyKey := helper.ResolvedFile + "|" + helper.MethodName + "|" + strconv.Itoa(helper.ResolvedLine)
+				ordinaryBodies[bodyKey] = struct {
+					entry SourceEntry
+					plan  ordinaryHelperPlan
+				}{entry: entry, plan: helper}
+			}
+		}
+	}
+
+	for _, declaration := range file.Decls {
+		fn, ok := declaration.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		receiverType, receiver := receiverIdentity(fset, fn)
+		if receiver == "" {
+			continue
+		}
+		scope := receiverScope(pathpkg.Dir(rel), receiverType)
+		bindings := collectBindings(fn.Body)
+
+		ordinaryBodyKey := rel + "|" + fn.Name.Name + "|" + strconv.Itoa(fset.Position(fn.Pos()).Line)
+		if owned, exists := ordinaryBodies[ordinaryBodyKey]; exists {
+			traceExpr, traceOK := entryTraceExpression(receiver, owned.entry)
+			if !traceOK {
+				continue
+			}
+			helperEdits := guardEvidenceEdits(
+				fset, tokenFile, data, fn.Body, traceExpr,
+				traceExpr+".CurrentSourceID()", "helper_"+strconv.Itoa(owned.plan.ResolvedLine),
+			)
+			edits = append(edits, helperEdits...)
+			needsImport = needsImport || len(helperEdits) > 0
+		}
+
+		ast.Inspect(fn.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			position := fset.Position(call.Pos())
+			key := rel + "|" + strconv.Itoa(position.Line) + "|" + strconv.Itoa(position.Column)
+			owned, exists := ordinaryCalls[key]
+			if !exists {
+				return true
+			}
+			traceExpr, traceOK := entryTraceExpression(receiver, owned.entry)
+			if !traceOK {
+				return true
+			}
+			callEdits, callErr := ordinaryHelperCallEdits(
+				fset, tokenFile, data, fn.Body, call, owned.entry, owned.plan, traceExpr,
+			)
+			if callErr == nil {
+				edits = append(edits, callEdits...)
+				needsImport = true
+			}
+			return true
+		})
+
+		// Direct state operations own their own structural source IDs.
+		ast.Inspect(fn.Body, func(node ast.Node) bool {
+			if nested, ok := node.(*ast.FuncLit); ok {
+				_ = nested
+				return false
+			}
+			assignment, ok := node.(*ast.AssignStmt)
+			if !ok {
+				return true
+			}
+			entry, exists := stateByLine[fset.Position(assignment.Pos()).Line]
+			if !exists || entry.stateOperation == nil || !entry.stateOperation.Numeric || assignment.Tok != token.ASSIGN {
+				return true
+			}
+			traceExpr, traceOK := entryTraceExpression(receiver, entry)
+			if !traceOK {
+				return true
+			}
+			writeEdits, writeErr := numericStateWriteEdits(
+				fset, tokenFile, data, assignment, receiver, traceExpr,
+				entry.stateOperation.ScopeKey, strconv.Quote(entry.SourceID), entry.SourceID[:10], bindings,
+				entry.stateOperation.NumericFields, nil,
+			)
+			if writeErr != nil {
+				return true
+			}
+			edits = append(edits, writeEdits...)
+			needsImport = true
+			return true
+		})
+
+		// Resolved receiver method returning a closure. Runtime CurrentSourceID
+		// selects the actual task call-site identity, so one method body remains
+		// valid when several structurally distinct task sites reuse it.
+		methodKey := fn.Name.Name + "|" + strconv.Itoa(fset.Position(fn.Pos()).Line)
+		if entry, exists := resolvedTasks[methodKey]; exists {
+			traceExpr, traceOK := entryTraceExpression(receiver, entry)
+			if !traceOK {
+				continue
+			}
+			closure := directlyReturnedClosure(fn)
+			if closure != nil {
+				dynamicSource := traceExpr + ".CurrentSourceID()"
+				callbackEdits, callbackImport := callbackBodyEdits(
+					fset, tokenFile, data, closure.Body, receiver, traceExpr,
+					entry.callback.ScopeKey, dynamicSource, entry.SourceID[:10], collectBindings(closure.Body),
+					entry.callback.StateFields, numericFormalParameterNames(fn, entry.callback.NumericPayloads),
+				)
+				edits = append(edits, callbackEdits...)
+				needsImport = needsImport || callbackImport
+			}
+		}
+
+		ast.Inspect(fn.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			kind, root, _, matched := describeSeamCall(fset, call, bindings)
+			if !matched {
+				return true
+			}
+			line := fset.Position(call.Pos()).Line
+			entry, exists := entryByCall[kind+"|"+strconv.Itoa(line)]
+			if !exists {
+				return true
+			}
+			traceExpr, traceOK := entryTraceExpression(receiver, entry)
+			if !traceOK {
+				return true
+			}
+			switch kind {
+			case KindTaskCallback:
+				taskEdits, taskImport, taskErr := taskPayloadEdits(fset, tokenFile, data, fn, call, entry, traceExpr)
+				if taskErr == nil {
+					edits = append(edits, taskEdits...)
+					needsImport = needsImport || taskImport
+				}
+				if callback, ok := root.(*ast.FuncLit); ok && entry.callback != nil {
+					callbackKey := entry.callback.ResolvedFile + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+					if taskCallbackUses[callbackKey] != 1 {
+						return true
+					}
+					callbackEdits, callbackImport := callbackBodyEdits(
+						fset, tokenFile, data, callback.Body, receiver, traceExpr,
+						entry.callback.ScopeKey, strconv.Quote(entry.SourceID), entry.SourceID[:10], collectBindings(callback.Body),
+						entry.callback.StateFields, nil,
+					)
+					edits = append(edits, callbackEdits...)
+					needsImport = needsImport || callbackImport
+				}
+			case KindModifierAmount:
+				if entry.savedVector != nil || entry.capturedScalar != nil {
+					break
+				}
+				modifierEdits, modifierImport, modifierErr := modifierAmountEdits(
+					fset, tokenFile, data, root, entry, receiver, traceExpr, scope,
+				)
+				if modifierErr == nil {
+					edits = append(edits, modifierEdits...)
+					needsImport = needsImport || modifierImport
+				}
+			case KindEventCallback:
+				if callback, ok := root.(*ast.FuncLit); ok && entry.callback != nil {
+					callbackKey := entry.callback.ResolvedFile + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+					// One closure registered at several event seams has no runtime
+					// discriminator inside its body. Do not attach one subscription's
+					// source identity to every invocation or emit overlapping edits.
+					if eventCallbackUses[callbackKey] != 1 {
+						return true
+					}
+					guardEdits := guardEvidenceEdits(
+						fset, tokenFile, data, callback.Body, traceExpr,
+						strconv.Quote(entry.SourceID), entry.SourceID[:10],
+					)
+					edits = append(edits, guardEdits...)
+					needsImport = needsImport || len(guardEdits) > 0
+					fieldEdits := attackFieldEdits(fset, tokenFile, file, callback.Body, traceExpr, strconv.Quote(entry.SourceID), entry.SourceID[:10])
+					edits = append(edits, fieldEdits...)
+					needsImport = needsImport || len(fieldEdits) > 0
+				}
+			}
+			return true
+		})
+	}
+	return edits, needsImport, nil
+}
+
+func entryTraceExpression(receiver string, entry SourceEntry) (string, bool) {
+	path := strings.TrimSpace(entry.traceRuntimePath)
+	if receiver == "" || path == "" {
+		return "", false
+	}
+	expression := receiver + "." + path
+	return expression, safeSelectorChain(expression)
+}
+
+func ordinaryHelperCallEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	body *ast.BlockStmt,
+	call *ast.CallExpr,
+	entry SourceEntry,
+	plan ordinaryHelperPlan,
+	traceExpr string,
+) ([]textEdit, error) {
+	statement := containingStatement(body, call)
+	expressionStatement, ok := statement.(*ast.ExprStmt)
+	if !ok || expressionStatement.X != call {
+		return nil, fmt.Errorf("ordinary helper call is not a direct expression statement")
+	}
+	if len(call.Args) != len(plan.ParameterNames) {
+		return nil, fmt.Errorf("ordinary helper argument count changed after discovery")
+	}
+	indent := indentationBefore(data, tokenFile.Offset(statement.Pos()))
+	prefix := "gttV6_helper_" + entry.SourceID[:10] + "_" + strconv.Itoa(plan.CallLine)
+	arguments := make([]string, len(call.Args))
+	payloads := make([]string, 0, len(plan.NumericParameters))
+	numericParameters := integerAllowlist(plan.NumericParameters)
+	bindings := collectBindings(containingBindingScope(body, call))
+	var replacement strings.Builder
+	for index, argument := range call.Args {
+		_, numeric := numericParameters[index]
+		if !numeric && isNilIdent(argument) {
+			arguments[index] = rootText(fset, argument)
+			continue
+		}
+		valueName := prefix + "_arg_" + strconv.Itoa(index)
+		fmt.Fprintf(&replacement, "%s := %s\n%s", valueName, rootText(fset, argument), indent)
+		arguments[index] = valueName
+		if !numeric {
+			continue
+		}
+		eventName := prefix + "_event_" + strconv.Itoa(index)
+		if healthChangePercentExpression(argument, bindings) {
+			fmt.Fprintf(&replacement, "%s := %s.RecordCurrentHealthChangePercentEval(%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				eventName, traceExpr, strconv.Quote(entry.SourceID), valueName, traceImportAlias,
+				strconv.Quote("ordinary_helper_argument_dependency_incomplete"), indent,
+			)
+		} else {
+			inputRefs := "[]" + traceImportAlias + ".NumericRef{" + traceImportAlias + ".LiteralRef(float64(" + valueName + "))}"
+			fmt.Fprintf(&replacement, "%s := %s.RecordNumericEval(%s,%s,%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				eventName, traceExpr, strconv.Quote(entry.SourceID), strconv.Quote("source_expression"),
+				inputRefs, valueName, traceImportAlias,
+				strconv.Quote("ordinary_helper_argument_dependency_incomplete"), indent,
+			)
+		}
+		payloads = append(payloads, fmt.Sprintf("{Key:%s,Value:float64(%s),Reference:%s.EventRef(%s)}",
+			strconv.Quote("arg:"+strconv.Itoa(index)), valueName, traceImportAlias, eventName))
+	}
+	restoreName := prefix + "_restore"
+	fmt.Fprintf(&replacement, "%s := %s.EnterHelperNumericArguments([]%s.NumericPayload{%s})\n%s",
+		restoreName, traceExpr, traceImportAlias, strings.Join(payloads, ","), indent)
+	fmt.Fprintf(&replacement, "%s(%s)\n%s%s()",
+		rootText(fset, call.Fun), strings.Join(arguments, ","), indent, restoreName)
+	return []textEdit{{
+		start: tokenFile.Offset(statement.Pos()), end: tokenFile.Offset(statement.End()),
+		replacement: replacement.String(),
+	}}, nil
+}
+
+func containingBindingScope(body *ast.BlockStmt, target ast.Node) *ast.BlockStmt {
+	best := body
+	ast.Inspect(body, func(node ast.Node) bool {
+		literal, ok := node.(*ast.FuncLit)
+		if !ok || literal.Body.Pos() > target.Pos() || literal.Body.End() < target.End() {
+			return true
+		}
+		if best == body || literal.Body.End()-literal.Body.Pos() < best.End()-best.Pos() {
+			best = literal.Body
+		}
+		return true
+	})
+	return best
+}
+
+func healthChangePercentExpression(expr ast.Expr, bindings bindingSet) bool {
+	hasEventArgument := false
+	hasMaxHPRead := false
+	resolving := make(map[string]bool)
+	var inspectExpression func(ast.Expr)
+	inspectExpression = func(current ast.Expr) {
+		if current == nil {
+			return
+		}
+		ast.Inspect(current, func(node ast.Node) bool {
+			if ident, ok := node.(*ast.Ident); ok {
+				if ident.Name == "args" {
+					hasEventArgument = true
+				}
+				if defs := bindings[ident.Name]; len(defs) == 1 && !resolving[ident.Name] {
+					resolving[ident.Name] = true
+					inspectExpression(defs[0])
+					delete(resolving, ident.Name)
+				}
+			}
+			if call, ok := node.(*ast.CallExpr); ok && len(call.Args) == 0 {
+				if selector, selectorOK := call.Fun.(*ast.SelectorExpr); selectorOK && selector.Sel.Name == "MaxHP" {
+					hasMaxHPRead = true
+				}
+			}
+			return !(hasEventArgument && hasMaxHPRead)
+		})
+	}
+	inspectExpression(expr)
+	return hasEventArgument && hasMaxHPRead
+}
+
+func taskPayloadEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	fn *ast.FuncDecl,
+	call *ast.CallExpr,
+	entry SourceEntry,
+	traceExpr string,
+) ([]textEdit, bool, error) {
+	if entry.callback == nil || len(entry.callback.PayloadExpressions) == 0 || len(call.Args) < 2 {
+		return nil, false, nil
+	}
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	callback, callbackOK := call.Args[0].(*ast.CallExpr)
+	if !callbackOK {
+		return nil, false, fmt.Errorf("task payload source %s callback is not a bounded method call", entry.LookupKey)
+	}
+	callbackSelector, selectorOK := callback.Fun.(*ast.SelectorExpr)
+	if !ok || selector.Sel.Name != "Add" || !receiverContains(selector.X, "tasks") || !selectorOK || len(callback.Args) != len(entry.callback.PayloadExpressions) {
+		return nil, false, fmt.Errorf("task payload source %s is outside the bounded method-call shape", entry.LookupKey)
+	}
+	statement := containingStatement(fn.Body, call)
+	if statement == nil {
+		return nil, false, fmt.Errorf("task payload source %s has no statement", entry.LookupKey)
+	}
+	indent := indentationBefore(data, tokenFile.Offset(statement.Pos()))
+	prefix := "gttV6_" + entry.SourceID[:10] + "_"
+	var declarations strings.Builder
+	callbackArgs := make([]string, len(callback.Args))
+	payloadRows := make([]string, 0, len(entry.callback.NumericPayloads))
+	numericPayloads := integerAllowlist(entry.callback.NumericPayloads)
+	for index, argument := range callback.Args {
+		_, numeric := numericPayloads[index]
+		if !numeric && isNilIdent(argument) {
+			callbackArgs[index] = rootText(fset, argument)
+			continue
+		}
+		valueName := prefix + "payload_" + strconv.Itoa(index)
+		fmt.Fprintf(&declarations, "%s := %s\n%s", valueName, rootText(fset, argument), indent)
+		callbackArgs[index] = valueName
+		if !numeric {
+			continue
+		}
+		eventName := prefix + "payload_event_" + strconv.Itoa(index)
+		reference := traceImportAlias + ".LiteralRef(float64(" + valueName + "))"
+		if parameterIndex, ok := directMethodParameterIndex(fn, argument); ok {
+			reference = traceExpr + ".CurrentHelperNumericRef(" + strconv.Quote("arg:"+strconv.Itoa(parameterIndex)) + ",float64(" + valueName + "))"
+		}
+		fmt.Fprintf(&declarations, "%s := %s.RecordNumericEval(%s,%s,[]%s.NumericRef{%s},float64(%s),%s.IncompleteEvidence(%s))\n%s",
+			eventName, traceExpr, strconv.Quote(entry.SourceID), strconv.Quote("task_payload"), traceImportAlias,
+			reference, valueName, traceImportAlias, strconv.Quote("task_payload_source_expression_unbound"), indent,
+		)
+		payloadRows = append(payloadRows, fmt.Sprintf("{Key:%s,Value:float64(%s),Reference:%s.EventRef(%s)}",
+			strconv.Quote("arg:"+strconv.Itoa(index)), valueName, traceImportAlias, eventName))
+	}
+	rewrittenCallback := rootText(fset, callbackSelector) + "(" + strings.Join(callbackArgs, ",") + ")"
+	rewrittenCall := rootText(fset, selector.X) + ".AddSourceNumericPayloads(" + rewrittenCallback + "," +
+		rootText(fset, call.Args[1]) + "," + strconv.Quote(entry.SourceID) + ",[]" + traceImportAlias + ".NumericPayload{" + strings.Join(payloadRows, ",") + "})"
+	return []textEdit{
+		{start: tokenFile.Offset(statement.Pos()), end: tokenFile.Offset(statement.Pos()), replacement: declarations.String()},
+		{start: tokenFile.Offset(call.Pos()), end: tokenFile.Offset(call.End()), replacement: rewrittenCall},
+	}, true, nil
+}
+
+func integerAllowlist(values []int) map[int]struct{} {
+	result := make(map[int]struct{}, len(values))
+	for _, value := range values {
+		if value >= 0 {
+			result[value] = struct{}{}
+		}
+	}
+	return result
+}
+
+func directMethodParameterIndex(fn *ast.FuncDecl, expression ast.Expr) (int, bool) {
+	ident, ok := expression.(*ast.Ident)
+	if !ok || fn == nil || fn.Type.Params == nil {
+		return 0, false
+	}
+	index := 0
+	for _, field := range fn.Type.Params.List {
+		for _, name := range field.Names {
+			if name.Name == ident.Name {
+				return index, true
+			}
+			index++
+		}
+	}
+	return 0, false
+}
+
+func numericFormalParameterNames(fn *ast.FuncDecl, numericPositions []int) map[string]int {
+	result := make(map[string]int, len(numericPositions))
+	if fn == nil || fn.Type.Params == nil {
+		return result
+	}
+	allowlist := integerAllowlist(numericPositions)
+	index := 0
+	for _, field := range fn.Type.Params.List {
+		for _, name := range field.Names {
+			if _, numeric := allowlist[index]; numeric {
+				result[name.Name] = index
+			}
+			index++
+		}
+	}
+	return result
+}
+
+func callbackBodyEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	body *ast.BlockStmt,
+	receiver, traceExpr, scope, sourceExpr, prefix string,
+	bindings bindingSet,
+	numericFields []string,
+	taskParameters map[string]int,
+) ([]textEdit, bool) {
+	edits := guardEvidenceEdits(fset, tokenFile, data, body, traceExpr, sourceExpr, prefix)
+	needsImport := len(edits) > 0
+	ast.Inspect(body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		assignment, ok := node.(*ast.AssignStmt)
+		if !ok || len(assignment.Lhs) != 1 || len(assignment.Rhs) != 1 {
+			return true
+		}
+		if parameter, parameterOK := assignment.Lhs[0].(*ast.Ident); parameterOK {
+			if parameterEdits, traced := taskNumericParameterWriteEdits(
+				fset, tokenFile, data, assignment, parameter, traceExpr, sourceExpr,
+				prefix+"_"+strconv.Itoa(fset.Position(assignment.Pos()).Line), bindings, taskParameters,
+			); traced {
+				edits = append(edits, parameterEdits...)
+				needsImport = true
+				return true
+			}
+		}
+		if assignment.Tok != token.ASSIGN {
+			return true
+		}
+		selector, ok := assignment.Lhs[0].(*ast.SelectorExpr)
+		ident, receiverOK := selectorRootIdent(selector)
+		if !ok || !receiverOK || ident != receiver {
+			return true
+		}
+		compiled := compileNumericTemplate(fset, assignment.Rhs[0], bindings)
+		if compiled.template.Status != TemplateSupported {
+			return true
+		}
+		writeEdits, err := numericStateWriteEdits(
+			fset, tokenFile, data, assignment, receiver, traceExpr, scope,
+			sourceExpr, prefix+"_"+strconv.Itoa(fset.Position(assignment.Pos()).Line), bindings,
+			numericFields, taskParameters,
+		)
+		if err == nil {
+			edits = append(edits, writeEdits...)
+			needsImport = true
+		}
+		return true
+	})
+	return edits, needsImport
+}
+
+func taskNumericParameterWriteEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	assignment *ast.AssignStmt,
+	parameter *ast.Ident,
+	traceExpr, sourceExpr, prefix string,
+	bindings bindingSet,
+	taskParameters map[string]int,
+) ([]textEdit, bool) {
+	parameterIndex, parameterOK := taskParameters[parameter.Name]
+	if !parameterOK {
+		return nil, false
+	}
+	referenced := referencedTaskNumericParameters(assignment.Rhs[0], taskParameters)
+	dependsOnPriorValue := assignment.Tok != token.ASSIGN
+	if assignment.Tok == token.ASSIGN {
+		for _, candidate := range referenced {
+			if candidate.name == parameter.Name {
+				dependsOnPriorValue = true
+				break
+			}
+		}
+	}
+	if !dependsOnPriorValue {
+		return nil, false
+	}
+	indent := indentationBefore(data, tokenFile.Offset(assignment.Pos()))
+	beforeName := "gttV6_" + prefix + "_task_before"
+	var out strings.Builder
+	fmt.Fprintf(&out, "%s := %s\n%s", beforeName, parameter.Name, indent)
+	fmt.Fprintf(&out, "%s %s %s\n%s", parameter.Name, assignment.Tok.String(), rootText(fset, assignment.Rhs[0]), indent)
+	leaves := make(map[string]numericTraceLeaf, len(taskParameters))
+	for name, index := range taskParameters {
+		value := name
+		if name == parameter.Name {
+			value = beforeName
+		}
+		leaves[name] = numericTraceLeaf{
+			valueExpr: value,
+			referenceExpr: fmt.Sprintf("%s.CurrentTaskNumericRef(%s,float64(%s))",
+				traceExpr, strconv.Quote("arg:"+strconv.Itoa(index)), value),
+		}
+	}
+	compiled := compileNumericTemplate(fset, assignment.Rhs[0], bindings)
+	traceCode, root, err := numericTraceTemplateEvents(
+		compiled, leaves, traceExpr, sourceExpr, prefix+"_task_rhs", indent,
+	)
+	if err != nil {
+		return nil, false
+	}
+	out.WriteString(traceCode)
+	if assignment.Tok != token.ASSIGN {
+		operator, ok := numericAssignmentOperator(assignment.Tok)
+		if !ok {
+			return nil, false
+		}
+		evalName := "gttV6_" + prefix + "_task_eval"
+		beforeRef := leaves[parameter.Name].referenceExpr
+		fmt.Fprintf(&out, "%s := %s.RecordNumericEval(%s,%s,[]%s.NumericRef{%s,%s},float64(%s),%s.IncompleteEvidence(%s))\n%s",
+			evalName, traceExpr, sourceExpr, strconv.Quote(operator), traceImportAlias,
+			beforeRef, root.referenceExpr, parameter.Name, traceImportAlias,
+			strconv.Quote("task_numeric_transition_dependency_incomplete"), indent)
+		root = numericTraceLeaf{valueExpr: parameter.Name, referenceExpr: traceImportAlias + ".EventRef(" + evalName + ")"}
+	}
+	fmt.Fprintf(&out, "%s.UpdateTaskNumericArgument(%s,float64(%s),%s)",
+		traceExpr, strconv.Quote("arg:"+strconv.Itoa(parameterIndex)), parameter.Name, root.referenceExpr)
+	return []textEdit{{
+		start: tokenFile.Offset(assignment.Pos()), end: tokenFile.Offset(assignment.End()), replacement: out.String(),
+	}}, true
+}
+
+type numericTraceLeaf struct {
+	valueExpr     string
+	referenceExpr string
+}
+
+func numericAssignmentOperator(operator token.Token) (string, bool) {
+	value, ok := map[token.Token]string{
+		token.ADD_ASSIGN: "add",
+		token.SUB_ASSIGN: "subtract",
+		token.MUL_ASSIGN: "multiply",
+		token.QUO_ASSIGN: "divide",
+	}[operator]
+	return value, ok
+}
+
+func numericTraceTemplateEvents(
+	compiled templateCompilation,
+	leaves map[string]numericTraceLeaf,
+	traceExpr, sourceExpr, prefix, indent string,
+) (string, numericTraceLeaf, error) {
+	if compiled.template.Status != TemplateSupported || compiled.template.RootNodeID == nil {
+		return "", numericTraceLeaf{}, fmt.Errorf("numeric trace expression is opaque")
+	}
+	parameterByKey := make(map[string]parameterPlan, len(compiled.parameters))
+	for _, parameter := range compiled.parameters {
+		parameterByKey[parameter.ParameterKey] = parameter
+	}
+	nodes := make([]numericTraceLeaf, len(compiled.template.Nodes))
+	var out strings.Builder
+	for _, node := range compiled.template.Nodes {
+		switch node.Operator {
+		case "PARAM":
+			if node.ParameterKey == nil {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace PARAM has nil key")
+			}
+			parameter, exists := parameterByKey[*node.ParameterKey]
+			if !exists {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace PARAM plan is missing")
+			}
+			leaf, exists := leaves[parameter.SourceExpression]
+			if !exists || leaf.valueExpr == "" || leaf.referenceExpr == "" {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace leaf %s is unbound", parameter.SourceExpression)
+			}
+			nodes[node.NodeID] = leaf
+		case "CONST":
+			if node.ConstantValue == nil {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace CONST has nil value")
+			}
+			value := strconv.FormatFloat(*node.ConstantValue, 'g', -1, 64)
+			nodes[node.NodeID] = numericTraceLeaf{
+				valueExpr:     value,
+				referenceExpr: traceImportAlias + ".LiteralRef(" + value + ")",
+			}
+		default:
+			children := make([]numericTraceLeaf, len(node.InputNodeIDs))
+			for index, childID := range node.InputNodeIDs {
+				if childID < 0 || childID >= node.NodeID || nodes[childID].valueExpr == "" {
+					return "", numericTraceLeaf{}, fmt.Errorf("numeric trace child is invalid")
+				}
+				children[index] = nodes[childID]
+			}
+			operation, expression, err := numericTraceOperation(node.Operator, children)
+			if err != nil {
+				return "", numericTraceLeaf{}, err
+			}
+			valueName := "gttV6_" + prefix + "_node_" + strconv.Itoa(node.NodeID)
+			eventName := valueName + "_event"
+			refs := make([]string, len(children))
+			for index, child := range children {
+				refs[index] = child.referenceExpr
+			}
+			fmt.Fprintf(&out, "%s := %s\n%s", valueName, expression, indent)
+			fmt.Fprintf(&out, "%s := %s.RecordNumericEval(%s,%s,[]%s.NumericRef{%s},float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				eventName, traceExpr, sourceExpr, strconv.Quote(operation), traceImportAlias,
+				strings.Join(refs, ","), valueName, traceImportAlias,
+				strconv.Quote("numeric_expression_candidate_dependency_incomplete"), indent)
+			nodes[node.NodeID] = numericTraceLeaf{
+				valueExpr:     valueName,
+				referenceExpr: traceImportAlias + ".EventRef(" + eventName + ")",
+			}
+		}
+	}
+	root := *compiled.template.RootNodeID
+	if root < 0 || root >= len(nodes) || nodes[root].valueExpr == "" {
+		return "", numericTraceLeaf{}, fmt.Errorf("numeric trace root is invalid")
+	}
+	return out.String(), nodes[root], nil
+}
+
+func numericTraceOperation(
+	operator string,
+	children []numericTraceLeaf,
+) (string, string, error) {
+	if len(children) != 2 {
+		return "", "", fmt.Errorf("numeric trace operator %s has unsupported arity", operator)
+	}
+	left, right := children[0].valueExpr, children[1].valueExpr
+	switch operator {
+	case "ADD":
+		return "add", "(" + left + " + " + right + ")", nil
+	case "SUB":
+		return "subtract", "(" + left + " - " + right + ")", nil
+	case "MUL":
+		return "multiply", "(" + left + " * " + right + ")", nil
+	case "DIV":
+		return "divide", "(" + left + " / " + right + ")", nil
+	case "MIN":
+		return "min", "min(" + left + "," + right + ")", nil
+	case "MAX":
+		return "max", "max(" + left + "," + right + ")", nil
+	default:
+		return "", "", fmt.Errorf("numeric trace operator %s is unsupported", operator)
+	}
+}
+
+func numericStateWriteEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	assignment *ast.AssignStmt,
+	receiver, traceExpr, scope, sourceExpr, prefix string,
+	bindings bindingSet,
+	allowedFields []string,
+	taskParameters map[string]int,
+) ([]textEdit, error) {
+	selector, ok := assignment.Lhs[0].(*ast.SelectorExpr)
+	if !ok || assignment.Tok != token.ASSIGN {
+		return nil, fmt.Errorf("numeric state write outside direct assignment shape")
+	}
+	indent := indentationBefore(data, tokenFile.Offset(assignment.Pos()))
+	referencedFields := receiverFields(assignment.Rhs[0], receiver)
+	fields := make(map[string]struct{}, len(referencedFields)+1)
+	for field := range referencedFields {
+		fields[field] = struct{}{}
+	}
+	fields[selector.Sel.Name] = struct{}{}
+	ordered := sortedFieldSet(fields)
+	if err := validateNumericFieldAllowlist(ordered, allowedFields); err != nil {
+		return nil, err
+	}
+	valueByField := make(map[string]string, len(ordered))
+	eventByField := make(map[string]string, len(ordered))
+	slotByField := make(map[string]string, len(ordered))
+	var out strings.Builder
+	for index, field := range ordered {
+		valueName := "gttV6_" + prefix + "_read_" + strconv.Itoa(index)
+		slotName := "gttV6_" + prefix + "_slot_" + strconv.Itoa(index)
+		valueByField[field], slotByField[field] = valueName, slotName
+		fmt.Fprintf(&out, "%s := %s.%s\n%s", valueName, receiver, field, indent)
+		fmt.Fprintf(&out, "%s := %s.RegisterNumericStateSlot(%s,%s.Current(),%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+			slotName, traceExpr, strconv.Quote(scope), traceExpr, strconv.Quote(field), valueName,
+			traceImportAlias, strconv.Quote("state_slot_candidate_dependency_incomplete"), indent)
+		if _, referenced := referencedFields[field]; referenced {
+			eventName := "gttV6_" + prefix + "_read_event_" + strconv.Itoa(index)
+			eventByField[field] = eventName
+			fmt.Fprintf(&out, "%s := %s.RecordNumericStateRead(%s,%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				eventName, traceExpr, slotName, sourceExpr, valueName, traceImportAlias,
+				strconv.Quote("state_read_candidate_dependency_incomplete"), indent)
+		}
+	}
+	rhs := rootText(fset, assignment.Rhs[0])
+	rhs, err := replaceReceiverFieldSelectors(rhs, receiver, valueByField)
+	if err != nil {
+		return nil, err
+	}
+	afterName := "gttV6_" + prefix + "_after"
+	// Assign first, then read the field back. This preserves the declared field
+	// type for untyped constants (for example 300 into a float64 field) while
+	// still evaluating the gameplay expression exactly once.
+	fmt.Fprintf(&out, "%s.%s = %s\n%s", receiver, selector.Sel.Name, rhs, indent)
+	fmt.Fprintf(&out, "%s := %s.%s\n%s", afterName, receiver, selector.Sel.Name, indent)
+	leaves := make(map[string]numericTraceLeaf, len(ordered)+len(taskParameters))
+	for _, field := range ordered {
+		eventName, referenced := eventByField[field]
+		if !referenced {
+			continue
+		}
+		leaves[receiver+"."+field] = numericTraceLeaf{
+			valueExpr:     valueByField[field],
+			referenceExpr: traceImportAlias + ".EventRef(" + eventName + ")",
+		}
+	}
+	for name, index := range taskParameters {
+		leaves[name] = numericTraceLeaf{
+			valueExpr: name,
+			referenceExpr: fmt.Sprintf("%s.CurrentTaskNumericRef(%s,float64(%s))",
+				traceExpr, strconv.Quote("arg:"+strconv.Itoa(index)), name),
+		}
+	}
+	compiled := compileNumericTemplate(fset, assignment.Rhs[0], bindings)
+	traceCode, root, err := numericTraceTemplateEvents(
+		compiled, leaves, traceExpr, sourceExpr, prefix+"_state", indent,
+	)
+	if err != nil {
+		return nil, err
+	}
+	out.WriteString(traceCode)
+	fmt.Fprintf(&out, "%s.RecordNumericStateWriteWithInputs(%s,%s,float64(%s),float64(%s),[]%s.NumericRef{%s},%s.IncompleteEvidence(%s))\n%s",
+		traceExpr, slotByField[selector.Sel.Name], sourceExpr, valueByField[selector.Sel.Name], afterName,
+		traceImportAlias, root.referenceExpr,
+		traceImportAlias, strconv.Quote("state_write_candidate_dependency_incomplete"), indent)
+	return []textEdit{{
+		start: tokenFile.Offset(assignment.Pos()), end: tokenFile.Offset(assignment.End()), replacement: out.String(),
+	}}, nil
+}
+
+type taskNumericParameter struct {
+	name  string
+	index int
+}
+
+func referencedTaskNumericParameters(expr ast.Expr, parameters map[string]int) []taskNumericParameter {
+	if expr == nil || len(parameters) == 0 {
+		return []taskNumericParameter{}
+	}
+	found := make(map[string]int)
+	ast.Inspect(expr, func(node ast.Node) bool {
+		ident, ok := node.(*ast.Ident)
+		if !ok {
+			return true
+		}
+		if index, exists := parameters[ident.Name]; exists {
+			found[ident.Name] = index
+		}
+		return true
+	})
+	result := make([]taskNumericParameter, 0, len(found))
+	for name, index := range found {
+		result = append(result, taskNumericParameter{name: name, index: index})
+	}
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].index != result[j].index {
+			return result[i].index < result[j].index
+		}
+		return result[i].name < result[j].name
+	})
+	return result
+}
+
+func modifierAmountEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	root ast.Node,
+	entry SourceEntry,
+	receiver, traceExpr, scope string,
+) ([]textEdit, bool, error) {
+	fn, ok := root.(*ast.FuncLit)
+	if !ok {
+		return nil, false, fmt.Errorf("modifier %s root is not a function", entry.LookupKey)
+	}
+	output, reason := findModifierOutput(fn.Body)
+	if output == nil {
+		return nil, false, fmt.Errorf("modifier %s output: %s", entry.LookupKey, reason)
+	}
+	statement := containingStatement(fn.Body, output.value)
+	if statement == nil {
+		return nil, false, fmt.Errorf("modifier %s output statement missing", entry.LookupKey)
+	}
+	indent := indentationBefore(data, tokenFile.Offset(statement.Pos()))
+	prefix := "gttV6_" + entry.SourceID[:10]
+	fields := sortedFieldSet(receiverFields(output.value, receiver))
+	if err := validateNumericFieldAllowlist(fields, entry.modifierOutput.StateFields); err != nil {
+		return nil, false, err
+	}
+	var declarations strings.Builder
+	valueByField := make(map[string]string)
+	eventNames := make([]string, 0, len(fields))
+	leaves := make(map[string]numericTraceLeaf, len(fields)+len(entry.parameterPlans))
+	for index, field := range fields {
+		valueName := prefix + "_read_" + strconv.Itoa(index)
+		slotName := prefix + "_slot_" + strconv.Itoa(index)
+		eventName := prefix + "_read_event_" + strconv.Itoa(index)
+		valueByField[field] = valueName
+		eventNames = append(eventNames, eventName)
+		fmt.Fprintf(&declarations, "%s := %s.%s\n%s", valueName, receiver, field, indent)
+		fmt.Fprintf(&declarations, "%s := %s.RegisterNumericStateSlot(%s,%s.Current(),%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+			slotName, traceExpr, strconv.Quote(scope), traceExpr, strconv.Quote(field), valueName,
+			traceImportAlias, strconv.Quote("modifier_state_slot_candidate_dependency_incomplete"), indent)
+		fmt.Fprintf(&declarations, "%s := %s.RecordNumericStateRead(%s,%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+			eventName, traceExpr, slotName, strconv.Quote(entry.SourceID), valueName,
+			traceImportAlias, strconv.Quote("modifier_state_read_candidate_dependency_incomplete"), indent)
+		leaves[receiver+"."+field] = numericTraceLeaf{
+			valueExpr:     valueName,
+			referenceExpr: traceImportAlias + ".EventRef(" + eventName + ")",
+		}
+	}
+	expression := rootText(fset, output.value)
+	expression, err := replaceReceiverFieldSelectors(expression, receiver, valueByField)
+	if err != nil {
+		return nil, false, err
+	}
+	outputName := prefix + "_output"
+	fmt.Fprintf(&declarations, "%s := %s\n%s", outputName, expression, indent)
+
+	compiled := compileNumericTemplate(fset, output.value, collectBindings(fn.Body))
+	entryParameters := make(map[string]parameterPlan, len(entry.parameterPlans))
+	for _, parameter := range entry.parameterPlans {
+		entryParameters[parameter.ParameterKey] = parameter
+	}
+	replayableParameters := true
+	for _, parameter := range compiled.parameters {
+		if _, exists := leaves[parameter.SourceExpression]; exists {
+			continue
+		}
+		sourceParameter := parameter
+		if canonical, exists := entryParameters[parameter.ParameterKey]; exists &&
+			canonical.Kind == "frozen_source_value" {
+			sourceParameter = canonical
+		}
+		if sourceParameter.Kind != "frozen_source_value" {
+			replayableParameters = false
+			break
+		}
+	}
+	if !replayableParameters {
+		compiled = opaqueTemplate("modifier_live_parameter_not_replayable")
+	}
+	var parameterDeclarations strings.Builder
+	for _, parameter := range compiled.parameters {
+		if _, exists := leaves[parameter.SourceExpression]; exists {
+			continue
+		}
+		sourceParameter := parameter
+		if canonical, exists := entryParameters[parameter.ParameterKey]; exists &&
+			canonical.Kind == "frozen_source_value" {
+			sourceParameter = canonical
+		}
+		valueName := prefix + "_frozen_" + sanitizeIdentifier(parameter.ParameterKey)
+		fmt.Fprintf(&parameterDeclarations, "%s := float64(%s)\n%s", valueName, sourceParameter.SourceExpression, indent)
+		leaves[parameter.SourceExpression] = numericTraceLeaf{
+			valueExpr:     valueName,
+			referenceExpr: traceImportAlias + ".LiteralRef(" + valueName + ")",
+		}
+	}
+	traceCode, numericRoot, traceErr := numericTraceTemplateEvents(
+		compiled, leaves, traceExpr, strconv.Quote(entry.SourceID), prefix+"_modifier", indent,
+	)
+	if traceErr == nil && traceCode != "" {
+		declarations.WriteString(parameterDeclarations.String())
+		declarations.WriteString(traceCode)
+		fmt.Fprintf(&declarations, "_ = %s\n%s", numericRoot.referenceExpr, indent)
+	} else {
+		evalName := prefix + "_eval"
+		refs := make([]string, len(eventNames))
+		for index, eventName := range eventNames {
+			refs[index] = traceImportAlias + ".EventRef(" + eventName + ")"
+		}
+		fmt.Fprintf(&declarations, "%s := %s.RecordSourceNumericEval(%s,%s,nil,%s,[]%s.NumericRef{%s},float64(%s),%s.IncompleteEvidence(%s))\n%s",
+			evalName, traceExpr, strconv.Quote(entry.SourceID), strconv.Quote(entry.Template.TemplateSHA256),
+			strconv.Quote("source_expression"), traceImportAlias, strings.Join(refs, ","), outputName,
+			traceImportAlias, strconv.Quote("modifier_source_parameter_binding_incomplete"), indent)
+		fmt.Fprintf(&declarations, "_ = %s\n%s", evalName, indent)
+	}
+	edits := []textEdit{
+		{start: tokenFile.Offset(statement.Pos()), end: tokenFile.Offset(statement.Pos()), replacement: declarations.String()},
+		{start: tokenFile.Offset(output.value.Pos()), end: tokenFile.Offset(output.value.End()), replacement: outputName},
+	}
+	edits = append(edits, guardEvidenceEdits(
+		fset, tokenFile, data, fn.Body, traceExpr, strconv.Quote(entry.SourceID), entry.SourceID[:10],
+	)...)
+	return edits, true, nil
+}
+
+func validateNumericFieldAllowlist(fields, allowed []string) error {
+	allowlist := make(map[string]struct{}, len(allowed))
+	for _, field := range allowed {
+		allowlist[field] = struct{}{}
+	}
+	for _, field := range fields {
+		if _, ok := allowlist[field]; !ok {
+			return fmt.Errorf("receiver field %s lacks scalar numeric type proof", field)
+		}
+	}
+	return nil
+}
+
+func replaceReceiverFieldSelectors(
+	expression, receiver string,
+	replacements map[string]string,
+) (string, error) {
+	parsedSet := token.NewFileSet()
+	parsed, err := parser.ParseExprFrom(parsedSet, "gtt-v6-expression.go", expression, parser.SkipObjectResolution)
+	if err != nil {
+		return "", fmt.Errorf("parse receiver field expression: %w", err)
+	}
+	tokenFile := parsedSet.File(parsed.Pos())
+	if tokenFile == nil {
+		return "", fmt.Errorf("receiver field expression token file missing")
+	}
+	edits := make([]textEdit, 0, len(replacements))
+	ast.Inspect(parsed, func(node ast.Node) bool {
+		selector, ok := node.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		ident, ok := selector.X.(*ast.Ident)
+		if !ok || ident.Name != receiver {
+			return true
+		}
+		replacement, ok := replacements[selector.Sel.Name]
+		if !ok {
+			return true
+		}
+		edits = append(edits, textEdit{
+			start:       tokenFile.Offset(selector.Pos()),
+			end:         tokenFile.Offset(selector.End()),
+			replacement: replacement,
+		})
+		return true
+	})
+	rewritten, err := applyTextEdits([]byte(expression), edits)
+	if err != nil {
+		return "", err
+	}
+	return string(rewritten), nil
+}
+
+func guardEvidenceEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	body *ast.BlockStmt,
+	traceExpr, sourceExpr, prefix string,
+) []textEdit {
+	edits := make([]textEdit, 0, 4)
+	if body == nil {
+		return edits
+	}
+	elseIfNodes := make(map[*ast.IfStmt]struct{})
+	ast.Inspect(body, func(node ast.Node) bool {
+		ifStmt, ok := node.(*ast.IfStmt)
+		if !ok {
+			return true
+		}
+		if nested, ok := ifStmt.Else.(*ast.IfStmt); ok {
+			elseIfNodes[nested] = struct{}{}
+		}
+		return true
+	})
+	ast.Inspect(body, func(node ast.Node) bool {
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		ifStmt, ok := node.(*ast.IfStmt)
+		if !ok || ifStmt.Init != nil {
+			return true
+		}
+		// An else-if is not a statement-list position: inserting a declaration
+		// before its `if` would produce `else <declaration> if`. Keep that
+		// branch opaque instead of emitting invalid Go or rewriting control flow.
+		if _, nested := elseIfNodes[ifStmt]; nested {
+			return true
+		}
+		indent := indentationBefore(data, tokenFile.Offset(ifStmt.Pos()))
+		name := "gttV6_" + prefix + "_guard_" + strconv.Itoa(fset.Position(ifStmt.Pos()).Line)
+		declaration := name + " := " + rootText(fset, ifStmt.Cond) + "\n" + indent +
+			traceExpr + ".RecordGuard(" + sourceExpr + "," + strconv.Quote("observed") + ",nil," + name + "," +
+			traceImportAlias + ".IncompleteEvidence(" + strconv.Quote("guard_operand_dependency_incomplete") + "))\n" + indent
+		edits = append(edits,
+			textEdit{start: tokenFile.Offset(ifStmt.Pos()), end: tokenFile.Offset(ifStmt.Pos()), replacement: declaration},
+			textEdit{start: tokenFile.Offset(ifStmt.Cond.Pos()), end: tokenFile.Offset(ifStmt.Cond.End()), replacement: name},
+		)
+		return true
+	})
+	return edits
+}
+
+func ensureTraceImportEdit(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	file *ast.File,
+) (*textEdit, error) {
+	for _, spec := range file.Imports {
+		path, err := strconv.Unquote(spec.Path.Value)
+		if err != nil {
+			return nil, err
+		}
+		if path == traceImportPath {
+			if spec.Name != nil && spec.Name.Name == traceImportAlias {
+				return nil, nil
+			}
+			return nil, fmt.Errorf("trace import already exists without reserved overlay alias")
+		}
+	}
+	for _, declaration := range file.Decls {
+		imports, ok := declaration.(*ast.GenDecl)
+		if !ok || imports.Tok != token.IMPORT {
+			continue
+		}
+		insert := tokenFile.Offset(imports.End())
+		return &textEdit{start: insert, end: insert, replacement: "\nimport " + traceImportAlias + " " + strconv.Quote(traceImportPath)}, nil
+	}
+	packageEnd := tokenFile.Offset(file.Name.End())
+	_ = fset
+	_ = data
+	return &textEdit{start: packageEnd, end: packageEnd, replacement: "\n\nimport " + traceImportAlias + " " + strconv.Quote(traceImportPath)}, nil
+}
