+func (c *Core) gttTraceAttackProvider(attack info.AttackInfo) gtttrace.Provider {
+	provider := c.GTTTrace.Current()
+	if provider.Complete() {
+		return provider
+	}
+	return gtttrace.UnknownProvider("unattributed_attack", attack.Abil)
