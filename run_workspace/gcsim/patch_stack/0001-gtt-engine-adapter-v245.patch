+	taskPrefix := "gttV6_" + task.SourceID[:10] + "_payload_"
+	if !bytes.Contains(combined, []byte("float64("+taskPrefix+"0)")) {
+		t.Fatal("numeric task payload was not traced")
+	}
+	if bytes.Contains(combined, []byte("float64("+taskPrefix+"1)")) {
+		t.Fatal("pointer task payload reached numeric trace")
+	}
+	if bytes.Contains(combined, []byte(taskPrefix+"2 := nil")) {
+		t.Fatal("untyped nil task payload was staged without a type")
+	}
+	helperPrefix := "gttV6_helper_" + eventEntry.SourceID[:10] + "_" + strconv.Itoa(helper.CallLine) + "_arg_"
+	if !bytes.Contains(combined, []byte("float64("+helperPrefix+"0)")) {
+		t.Fatal("numeric helper argument was not traced")
+	}
+	if bytes.Contains(combined, []byte("float64("+helperPrefix+"1)")) {
+		t.Fatal("pointer helper argument reached numeric trace")
+	}
+	if bytes.Contains(combined, []byte(helperPrefix+"2 := nil")) {
+		t.Fatal("untyped nil helper argument was staged without a type")
+	}
+}
