+
+func (c *Core) gttTraceQueuedAttack(
+	attack *info.AttackInfo,
+	callerSkip int,
+) (gtttrace.Provider, string, string, string) {
+	provider := c.gttTraceAttackProvider(*attack)
+	if !c.GTTTrace.Enabled() {
+		return provider, "", "", ""
+	}
+	sourceID := attack.GTTTraceSourceID
+	if !gttsource.ValidID(sourceID) {
+		sourceID = gttsource.CaptureCaller(gttsource.KindQueuedAttack, callerSkip+1)
+	}
+	parentOccurrenceID := c.GTTTrace.EnsureCurrentOccurrence()
+	occurrenceID := c.GTTTrace.RecordSourceOccurrence(
+		gttsource.KindQueuedAttack, sourceID, c.F, provider, parentOccurrenceID,
+	)
+	return provider, sourceID, occurrenceID, parentOccurrenceID
