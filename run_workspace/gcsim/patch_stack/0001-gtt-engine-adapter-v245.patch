@@ -0,0 +1,26 @@
+package task
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestTaskRestoresCapturedProvider(t *testing.T) {
+	frame := 0
+	runtime := gtttrace.NewRuntime()
+	runtime.Enable()
+	handler := New(&frame, runtime)
+	provider := gtttrace.NewProvider("set", "scroll", 2, 4)
+	restore := runtime.Enter(provider)
+	var observed gtttrace.Provider
+	handler.Add(func() { observed = runtime.Current() }, 0)
+	restore()
+	handler.Run()
+	if observed != provider {
+		t.Fatalf("task provider = %#v, want %#v", observed, provider)
+	}
+	if runtime.Current().Known {
+		t.Fatal("task provider leaked after execution")
+	}
+}
