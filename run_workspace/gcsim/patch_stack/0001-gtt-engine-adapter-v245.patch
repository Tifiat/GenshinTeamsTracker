+		return mod.Amount()
+	}
+	restore := c.gttTrace.EnterSource(mod.GTTSource(), mod.GTTSourceID())
+	capture := c.gttTrace.BeginNumericDependencyCapture()
+	leaveAmount := c.gttTrace.EnterModifierAmount()
+	amount := mod.Amount()
+	leaveAmount()
+	inputs := c.gttTrace.EndNumericDependencyCapture(capture)
+	restore()
+	c.gttRecordModifierEval("stat", mod.Key(), mod.GTTSourceID(), mod.GTTSource(), mod.Expiry(), amount, inputs)
+	return amount
