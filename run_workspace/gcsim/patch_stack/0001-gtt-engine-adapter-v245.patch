+package optstats
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"reflect"
+	"sort"
+	"strconv"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+type GTTTraceTopologyEvent struct {
+	EventID     uint64 `json:"event_id"`
+	Frame       int    `json:"frame"`
+	Phase       string `json:"phase"`
+	Kind        string `json:"kind"`
+	SubjectKey  int    `json:"subject_key"`
+	StateSHA256 string `json:"state_sha256"`
+}
+
+type GTTTraceGuardSummary struct {
+	HitCount                    int            `json:"hit_count"`
+	TopologyEventCount          int            `json:"topology_event_count"`
+	UnsupportedHitCount         int            `json:"unsupported_hit_count"`
+	UnsupportedCount            int            `json:"unsupported_count"`
+	FormulaKindCounts           map[string]int `json:"formula_kind_counts"`
+	ReactionOperatorCounts      map[string]int `json:"reaction_operator_counts"`
+	FormulaComplete             bool           `json:"formula_complete"`
+	FlatDmgProvenanceComplete   bool           `json:"flat_dmg_provenance_complete"`
+	AttackModProvenanceComplete bool           `json:"attack_mod_provenance_complete"`
+	ReactionTopologyComplete    bool           `json:"reaction_topology_complete"`
+	ProviderIdentityComplete    bool           `json:"provider_identity_complete"`
+	ExactReplayEligible         bool           `json:"exact_replay_eligible"`
+}
+
+type GTTTraceEquationBuffer struct {
+	DurationFrames      int                           `json:"-"`
+	Seed                int64                         `json:"-"`
+	Hits                []info.GTTTraceHit            `json:"hits"`
+	TopologyEvents      []GTTTraceTopologyEvent       `json:"topology_events"`
+	Unsupported         []string                      `json:"unsupported"`
+	ProviderTransitions []gtttrace.ModifierTransition `json:"provider_transitions"`
+	SourceOccurrences   []gtttrace.SourceOccurrence   `json:"source_occurrences"`
+	SourceValueBindings []gtttrace.SourceValueBinding `json:"source_value_bindings"`
+	HealthOperations    []gtttrace.HealthOperation    `json:"health_operations"`
+	StateSlots          []gtttrace.StateSlot          `json:"state_slots"`
+	StateEvents         []gtttrace.StateEvent         `json:"state_events"`
+	nextAttackID        uint64
+	nextHitID           uint64
+	nextEventID         uint64
+}
+
+func PrepareOptimizerTraceEquation(core *core.Core) {
+	core.GTTTrace.Enable()
+}
+
+func OptimizerTraceEquation(core *core.Core) (CollectorCustomStats[GTTTraceEquationBuffer], error) {
+	out := GTTTraceEquationBuffer{
+		Hits:                make([]info.GTTTraceHit, 0),
+		TopologyEvents:      make([]GTTTraceTopologyEvent, 0),
+		Unsupported:         make([]string, 0),
+		ProviderTransitions: make([]gtttrace.ModifierTransition, 0),
+		SourceOccurrences:   make([]gtttrace.SourceOccurrence, 0),
+		SourceValueBindings: make([]gtttrace.SourceValueBinding, 0),
+		HealthOperations:    make([]gtttrace.HealthOperation, 0),
+		StateSlots:          make([]gtttrace.StateSlot, 0),
+		StateEvents:         make([]gtttrace.StateEvent, 0),
+	}
+	core.Events.Subscribe(event.OnApplyAttack, func(args ...any) {
+		attack := args[0].(*info.AttackEvent)
+		if !attack.GTTTraceProvider.Complete() {
+			provider := core.GTTTrace.Current()
+			if !provider.Complete() {
+				provider = gtttrace.UnknownProvider("unattributed_attack", attack.Info.Abil)
+			}
+			attack.GTTTraceProvider = provider
+		}
+		out.nextAttackID++
+		attack.GTTTraceContext = &info.GTTTraceAttackContext{AttackID: out.nextAttackID}
+	}, "gtt-trace-equation-attack")
+	core.Events.Subscribe(event.OnEnemyDamage, func(args ...any) {
+		target := args[0].(info.Target)
+		if target.Type() != info.TargettableEnemy {
+			return
+		}
+		attack := args[1].(*info.AttackEvent)
+		actualDamage := args[2].(float64)
+		trace := attack.GTTTraceHit
+		if trace == nil {
+			trace = opaqueTraceHit(core, target, attack, actualDamage)
+		}
+		out.nextHitID++
+		trace.HitID = out.nextHitID
+		terminalEventID := "hit:" + strconv.FormatUint(trace.HitID, 10)
+		bindSourceTraceTerminal(core, attack, trace, terminalEventID)
+		if trace.ReportedDamage != actualDamage {
+			trace.AddUnsupported("reported_damage_event_mismatch")
+		}
+		trace.ReportedDamage = actualDamage
+		if trace.FormulaKind == "" {
+			trace.FormulaKind = info.GTTTraceFormulaOpaqueCustom
+			trace.Completeness.FormulaComplete = false
+			trace.AddUnsupported("terminal_formula_not_instrumented")
+		}
+		trace.FormulaSHA256 = info.GTTTraceFormulaSHA256()
+		sort.Strings(trace.Unsupported)
+		out.Hits = append(out.Hits, *trace)
+
+		if !reflect.DeepEqual(trace.AuraBefore, trace.AuraAfterReaction) {
+			out.addTopology(core.F, "reaction", "aura_state_changed", int(target.Key()), trace.AuraAfterReaction)
+		}
+		if !reflect.DeepEqual(trace.AuraAfterReaction, trace.AuraAfterAttachment) {
+			out.addTopology(core.F, "attachment", "aura_state_changed", int(target.Key()), trace.AuraAfterAttachment)
+		}
+		if trace.Killed {
+			out.addTopology(core.F, "damage", "target_death", int(target.Key()), struct {
+				TargetKey int     `json:"target_key"`
+				HPAfter   float64 `json:"hp_after"`
+			}{int(target.Key()), trace.HPAfter})
+		}
+	}, "gtt-trace-equation-damage")
+	return &out, nil
+}
+
+func opaqueTraceHit(core *core.Core, target info.Target, attack *info.AttackEvent, actualDamage float64) *info.GTTTraceHit {
+	stats := make(map[string]float64)
+	for stat := attributes.Stat(0); stat < attributes.EndStatType; stat++ {
+		name := stat.String()
+		if name != "" {
+			stats[name] = attack.Snapshot.Stats[stat]
+		}
+	}
+	hit := &info.GTTTraceHit{
+		Frame:                      core.F,
+		SourceFrame:                attack.SourceFrame,
+		SnapshotFrame:              attack.Snapshot.SourceFrame,
+		ActorIndex:                 attack.Info.ActorIndex,
+		DamageSrc:                  int(attack.Info.DamageSrc),
+		Ability:                    attack.Info.Abil,
+		AttackTag:                  int(attack.Info.AttackTag),
+		Element:                    attack.Info.Element.String(),
+		TargetKey:                  int(target.Key()),
+		TargetType:                 int(target.Type()),
+		FormulaKind:                info.GTTTraceFormulaOpaqueCustom,
+		ReactionOperatorID:         "opaque_custom",
+		DamageMode:                 core.Flags.DamageMode,
+		HPCapActive:                core.Flags.DamageMode,
+		ReportedDamage:             actualDamage,
+		SourceID:                   attack.GTTTraceSourceID,
+		SourceOccurrenceID:         attack.GTTTraceSourceOccurrenceID,
+		SnapshotStats:              stats,
+		AttackMods:                 make([]info.GTTTraceAttackModAttempt, 0),
+		StatContributions:          make([]info.GTTTraceStatContribution, 0),
+		CallbackAttempts:           make([]info.GTTTraceCallbackAttempt, 0),
+		TargetModContributions:     make([]info.GTTTraceTargetModContribution, 0),
+		ReactionBonusContributions: make([]info.GTTTraceReactionBonusContribution, 0),
+		AuraBefore:                 make([]info.GTTTraceAuraRow, 0),
+		AuraAfterReaction:          make([]info.GTTTraceAuraRow, 0),
+		AuraAfterAttachment:        make([]info.GTTTraceAuraRow, 0),
+		Unsupported:                []string{"terminal_formula_not_instrumented"},
+	}
+	if attack.GTTTraceContext != nil {
+		hit.AttackID = attack.GTTTraceContext.AttackID
+	}
+	hit.Provider = attack.GTTTraceProvider
+	hit.StatContributions = append(hit.StatContributions, attack.Snapshot.GTTStatContributions...)
+	hit.Completeness.ProviderIdentityComplete = attack.GTTTraceProvider.Complete()
+	if !hit.Completeness.ProviderIdentityComplete {
+		hit.AddUnsupported("attack_provider_unattributed")
+	}
+	return hit
+}
+
+func (b *GTTTraceEquationBuffer) addTopology(frame int, phase, kind string, subject int, state any) {
+	b.nextEventID++
+	b.TopologyEvents = append(b.TopologyEvents, GTTTraceTopologyEvent{
+		EventID: b.nextEventID, Frame: frame, Phase: phase, Kind: kind,
+		SubjectKey: subject, StateSHA256: traceSHA256(state),
+	})
+}
+
+func traceSHA256(value any) string {
+	payload, err := json.Marshal(value)
+	if err != nil {
+		return ""
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:])
+}
+
+func (b GTTTraceEquationBuffer) GuardSummary() GTTTraceGuardSummary {
+	summary := GTTTraceGuardSummary{
+		HitCount: len(b.Hits), TopologyEventCount: len(b.TopologyEvents),
+		UnsupportedCount: len(b.Unsupported), FormulaKindCounts: make(map[string]int),
+		ReactionOperatorCounts: make(map[string]int), FormulaComplete: len(b.Hits) > 0,
+		FlatDmgProvenanceComplete: len(b.Hits) > 0, AttackModProvenanceComplete: len(b.Hits) > 0,
+		ReactionTopologyComplete: len(b.Hits) > 0, ProviderIdentityComplete: len(b.Hits) > 0,
+	}
+	for _, hit := range b.Hits {
+		summary.FormulaKindCounts[hit.FormulaKind]++
+		summary.ReactionOperatorCounts[hit.ReactionOperatorID]++
+		if len(hit.Unsupported) > 0 {
+			summary.UnsupportedHitCount++
+		}
+		summary.FormulaComplete = summary.FormulaComplete && hit.Completeness.FormulaComplete
+		summary.FlatDmgProvenanceComplete = summary.FlatDmgProvenanceComplete && hit.Completeness.FlatDmgProvenanceComplete
+		summary.AttackModProvenanceComplete = summary.AttackModProvenanceComplete && hit.Completeness.AttackModProvenanceComplete
+		summary.ReactionTopologyComplete = summary.ReactionTopologyComplete && hit.Completeness.ReactionTopologyComplete
+		summary.ProviderIdentityComplete = summary.ProviderIdentityComplete && hit.Completeness.ProviderIdentityComplete
+	}
+	summary.ExactReplayEligible = summary.FormulaComplete && summary.FlatDmgProvenanceComplete &&
+		summary.AttackModProvenanceComplete && summary.ReactionTopologyComplete &&
+		summary.ProviderIdentityComplete && len(b.Unsupported) == 0
+	return summary
+}
+
+func (b GTTTraceEquationBuffer) Flush(core *core.Core) GTTTraceEquationBuffer {
+	b.DurationFrames = core.F
+	b.Seed = core.Seed
+	b.ProviderTransitions = core.GTTTrace.ModifierTransitions()
+	b.SourceOccurrences = core.GTTTrace.SourceOccurrences()
+	b.SourceValueBindings = core.GTTTrace.SourceValueBindings()
+	b.HealthOperations = core.GTTTrace.HealthOperations()
+	b.StateSlots = core.GTTTrace.StateSlots()
+	b.StateEvents = core.GTTTrace.StateEvents()
+	seen := map[string]bool{
+		"gadget_wave_state_lineage_not_instrumented": true,
+		"provider_transition_timeline_incomplete":    true,
+	}
+	for _, hit := range b.Hits {
+		for _, code := range hit.Unsupported {
+			seen[code] = true
+		}
+	}
+	b.Unsupported = b.Unsupported[:0]
+	for code := range seen {
+		b.Unsupported = append(b.Unsupported, code)
+	}
+	sort.Strings(b.Unsupported)
+	return b
+}
+
+func bindSourceTraceTerminal(
+	core *core.Core,
+	attack *info.AttackEvent,
+	hit *info.GTTTraceHit,
+	terminalEventID string,
+) {
+	core.GTTTrace.BindOccurrenceTerminal(hit.SourceOccurrenceID, terminalEventID)
+	for _, row := range hit.StatContributions {
+		core.GTTTrace.BindOccurrenceTerminal(row.SourceOccurrenceID, terminalEventID)
+	}
+	for _, row := range hit.CallbackAttempts {
+		core.GTTTrace.BindOccurrenceTerminal(row.SourceOccurrenceID, terminalEventID)
+	}
+	for _, row := range hit.TargetModContributions {
+		core.GTTTrace.BindOccurrenceTerminal(row.SourceOccurrenceID, terminalEventID)
+	}
+	for _, row := range hit.ReactionBonusContributions {
+		core.GTTTrace.BindOccurrenceTerminal(row.SourceOccurrenceID, terminalEventID)
+	}
+	terminal := terminalEventID
+	for providerIndex, row := range hit.AttackMods {
+		core.GTTTrace.BindOccurrenceTerminal(row.SourceOccurrenceID, terminalEventID)
+		if row.SourceTemplateSHA256 == "" || len(row.SourceParameters) == 0 {
+			continue
+		}
+		keys := make([]string, 0, len(row.Delta))
+		for key := range row.Delta {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		providerSequenceIndex := providerIndex
+		for _, key := range keys {
+			core.GTTTrace.RecordSourceValueBinding(
+				row.SourceOccurrenceID, row.SourceTemplateSHA256,
+				"attack_mod_stat", &terminal, &providerSequenceIndex,
+				key, row.Delta[key], row.SourceParameters,
+			)
+		}
+	}
+	if attack.GTTTraceSourceTemplateSHA256 == "" || len(attack.GTTTraceSourceParameters) == 0 {
+		return
+	}
+	core.GTTTrace.RecordSourceValueBinding(
+		attack.GTTTraceSourceOccurrenceID, attack.GTTTraceSourceTemplateSHA256,
+		"terminal_flat_dmg", &terminal, nil, "flat_dmg", hit.FlatDmg,
+		attack.GTTTraceSourceParameters,
+	)
+}
diff --git a/pkg/optimization/optstats/trace_equation_health_test.go b/pkg/optimization/optstats/trace_equation_health_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/optimization/optstats/trace_equation_health_test.go
@@ -0,0 +1,49 @@
+package optstats
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestFlushAddsHealthWithoutChangingInheritedEvidenceCollections(t *testing.T) {
+	c, err := core.New(core.Opt{Seed: 7})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.GTTTrace.Enable()
+	buffer := GTTTraceEquationBuffer{
+		Hits:           []info.GTTTraceHit{{HitID: 1, Ability: "sentinel"}},
+		TopologyEvents: []GTTTraceTopologyEvent{{EventID: 1, Frame: 3, Kind: "sentinel"}},
+		Unsupported:    []string{}, ProviderTransitions: []gtttrace.ModifierTransition{},
+		SourceOccurrences: []gtttrace.SourceOccurrence{}, SourceValueBindings: []gtttrace.SourceValueBinding{},
+		HealthOperations: []gtttrace.HealthOperation{},
+	}
+	wantHits := append([]info.GTTTraceHit{}, buffer.Hits...)
+	wantTopology := append([]GTTTraceTopologyEvent{}, buffer.TopologyEvents...)
+	wantTransitions := append([]gtttrace.ModifierTransition{}, buffer.ProviderTransitions...)
+	wantOccurrences := append([]gtttrace.SourceOccurrence{}, buffer.SourceOccurrences...)
+	wantBindings := append([]gtttrace.SourceValueBinding{}, buffer.SourceValueBindings...)
+
+	sequence, _ := c.GTTTrace.BeginHealthOperation()
+	c.GTTTrace.CompleteHealthOperation(sequence, gtttrace.HealthOperation{
+		Kind: gtttrace.HealthOperationDrain, Frame: 3,
+		Provider: gtttrace.UnknownProvider("fixture", "health"), TargetIndex: 0,
+		ModifierContributions: []gtttrace.HealthModifierContribution{},
+		UncertaintyCodes:      []string{"fixture_incomplete"},
+	})
+	flushed := buffer.Flush(c)
+	if !reflect.DeepEqual(flushed.Hits, wantHits) ||
+		!reflect.DeepEqual(flushed.TopologyEvents, wantTopology) ||
+		!reflect.DeepEqual(flushed.ProviderTransitions, wantTransitions) ||
+		!reflect.DeepEqual(flushed.SourceOccurrences, wantOccurrences) ||
+		!reflect.DeepEqual(flushed.SourceValueBindings, wantBindings) {
+		t.Fatal("health flush changed an inherited v4 evidence collection")
+	}
+	if len(flushed.HealthOperations) != 1 || flushed.HealthOperations[0].OperationID != "health-operation:0" {
+		t.Fatalf("health operations = %#v", flushed.HealthOperations)
+	}
+}
