@@ -0,0 +1,36 @@
+package gttcompact
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+func TestNumericRecipeVariableInputsAndNoInventedBonus(t *testing.T) {
+	hit := info.GTTTraceHit{ActorIndex: 0, ScalingStatKind: "hp", ScalingStatValue: 1000,
+		SnapshotStats: map[string]float64{"base_hp": 800, "em": 100}, RawCritRate: .5, CritDamage: 1,
+		NumericRecipe: &info.GTTNumericRecipe{Version: info.GTTNumericRecipeVersion, SourceSHA256: strings.Repeat("a", 64),
+			Inputs: []info.GTTNumericInput{{Kind: "scaling", Value: 1000}, {Kind: "snapshot_stat", StatKey: "em", Value: 100}},
+			Nodes:  []info.GTTNumericNode{{Op: "INPUT", Input: 0}, {Op: "INPUT", Input: 1}, {Op: "ADD", Args: []int{0, 1}}}, Root: 2, Observed: 1100}}
+	c := &directCompiler{b: &nodeBuilder{}, characterKeys: []string{"arbitrary"}, unknown: map[string]struct{}{}}
+	n := c.compileNumericRecipe(hit, "arbitrary")
+	if n.baseline != 1650 || len(n.coords) != 5 {
+		t.Fatalf("wrong baseline/coordinates: %+v reasons=%v", n, c.unknown)
+	}
+	for coordinate := range n.coords {
+		if strings.Contains(coordinate, "dmg%") || strings.Contains(coordinate, "hydro%") {
+			t.Fatal("invented damage bonus")
+		}
+	}
+	// A malformed/unsupported recipe must freeze locally, not panic or discard
+	// otherwise known channels. Binding mismatches cannot pass baseline-only.
+	hit.NumericRecipe.Inputs[1].Value = 200
+	n = c.compileNumericRecipe(hit, "arbitrary")
+	if len(n.coords) != 0 {
+		t.Fatal("mismatched stat provenance became variable")
+	}
+	if _, ok := c.unknown["numeric_recipe_snapshot_binding_mismatch"]; !ok {
+		t.Fatal(c.unknown)
+	}
+}
diff --git a/pkg/gttcompact/reaction_bonus.go b/pkg/gttcompact/reaction_bonus.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/reaction_bonus.go
@@ -0,0 +1,28 @@
+package gttcompact
+
+import "github.com/genshinsim/gcsim/pkg/gtttrace"
+
+// The EM value belongs to its original live producer read, including any
+// cross-owner stat modifiers. A valid ref already contains the owner's delta;
+// adding the delta again here would count it twice. Old traces stay explicit.
+func (c *directCompiler) reactionMasteryNode(observed float64, ref gtttrace.NumericRef, actor string) compiledNode {
+	if ref.Kind == "event" && ref.EventID != nil {
+		if n, ok := c.support.eventNodes[*ref.EventID]; ok && closeEnough(n.baseline, observed) {
+			return n
+		}
+	}
+	c.unknown["reaction_em_external_dependencies_frozen"] = struct{}{}
+	return c.b.add(c.b.constant(observed), c.b.artifactDelta(actor, "em"))
+}
+
+// The central reader supplies an observed sum of actual modifier outputs.
+// Keep its graph ancestry when available, never infer it from a buff name.
+func (c *directCompiler) reactionBonusNode(observed float64, ref gtttrace.NumericRef) compiledNode {
+	if ref.Kind == "event" && ref.EventID != nil {
+		if n, ok := c.support.eventNodes[*ref.EventID]; ok && closeEnough(n.baseline, observed) {
+			return n
+		}
+	}
+	c.unknown["reaction_bonus_dependencies_frozen"] = struct{}{}
+	return c.b.constant(observed)
+}
diff --git a/pkg/gttcompact/reaction_bonus_test.go b/pkg/gttcompact/reaction_bonus_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/reaction_bonus_test.go
@@ -0,0 +1,65 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"math"
+	"testing"
+)
+
+func TestReactionBonusSumKeepsForeignOwnerAndUnknownRemainder(t *testing.T) {
+	rt := gtttrace.NewRuntime()
+	rt.Enable()
+	stat := rt.RecordArtifactStatRead(1, "em", 200, nil)
+	product := rt.RecordNumericEval("", "multiply", []gtttrace.NumericRef{gtttrace.EventRef(stat), gtttrace.LiteralRef(.002)}, .4, gtttrace.IncompleteEvidence("test"))
+	mod := rt.RecordModifierEval("reaction_bonus", "renamable", 0, "", gtttrace.Provider{}, 100, true, map[string]float64{"reaction_bonus": .4}, []gtttrace.NumericRef{gtttrace.EventRef(product)}, gtttrace.IncompleteEvidence("test"))
+	unknown := rt.RecordModifierEval("reaction_bonus", "unknown", 0, "", gtttrace.Provider{}, 100, true, map[string]float64{"reaction_bonus": .3}, nil, gtttrace.IncompleteEvidence("unknown"))
+	sum := rt.RecordNumericEval("", "add", []gtttrace.NumericRef{gtttrace.EventOutputRef(mod, "reaction_bonus"), gtttrace.EventOutputRef(unknown, "reaction_bonus")}, .7, gtttrace.IncompleteEvidence("test"))
+	for _, cloud := range []bool{false, true} {
+		hit := info.GTTTraceHit{ActorIndex: 0, ReactionBonusRef: gtttrace.EventRef(sum)}
+		if cloud {
+			hit = info.GTTTraceHit{ActorIndex: 0, ContributorGroup: &info.GTTContributorGroup{Contributors: []info.GTTContributor{{Hit: hit}}}}
+		}
+		b := &nodeBuilder{}
+		buffer := optstats.GTTTraceEquationBuffer{StateEvents: rt.StateEvents(), Hits: []info.GTTTraceHit{hit}}
+		p := compileSupportProgram(b, buffer, []string{"recipient", "provider"})
+		c := &directCompiler{b: b, support: p, unknown: map[string]struct{}{}}
+		node := c.reactionBonusNode(.7, gtttrace.EventRef(sum))
+		got := evalContributorGraph(t, b, node, map[string]float64{"provider.em": 50})
+		if math.Abs(got-.8) > 1e-12 {
+			t.Fatalf("lost foreign owner cloud=%v %g", cloud, got)
+		}
+		bad := c.reactionBonusNode(.9, gtttrace.EventRef(sum))
+		if bad.baseline != .9 || len(bad.coords) != 0 {
+			t.Fatal("mismatched receipt accepted")
+		}
+	}
+}
+
+func TestReactionMasteryKeepsOriginalReadAndCrossOwnerWithoutDoubleDelta(t *testing.T) {
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	provider := r.RecordArtifactStatRead(1, "em", 200, nil)
+	amount := r.RecordNumericEval("", "multiply", []gtttrace.NumericRef{gtttrace.EventRef(provider), gtttrace.LiteralRef(.2)}, 40, gtttrace.IncompleteEvidence("test"))
+	mod := r.RecordModifierEval("stat", "renamable", 0, "", gtttrace.Provider{}, 100, true, map[string]float64{"em": 40}, []gtttrace.NumericRef{gtttrace.EventRef(amount)}, gtttrace.IncompleteEvidence("test"))
+	read := r.RecordArtifactStatRead(0, "em", 140, []string{mod})
+	hit := info.GTTTraceHit{ReactionFormula: &info.GTTTraceReactionFormula{ElementalMasteryRef: gtttrace.EventRef(read)}}
+	b := &nodeBuilder{}
+	p := compileSupportProgram(b, optstats.GTTTraceEquationBuffer{StateEvents: r.StateEvents(), Hits: []info.GTTTraceHit{hit}}, []string{"trigger", "support"})
+	c := &directCompiler{b: b, support: p, unknown: map[string]struct{}{}}
+	n := c.reactionMasteryNode(140, gtttrace.EventRef(read), "trigger")
+	if got := evalContributorGraph(t, b, n, map[string]float64{"trigger.em": 50, "support.em": 100}); math.Abs(got-210) > 1e-12 {
+		t.Fatal(got)
+	}
+	if len(c.unknown) != 0 {
+		t.Fatal(c.unknown)
+	}
+	legacy := c.reactionMasteryNode(140, gtttrace.NumericRef{}, "trigger")
+	if got := evalContributorGraph(t, b, legacy, map[string]float64{"trigger.em": 50, "support.em": 100}); got != 190 {
+		t.Fatal(got)
+	}
+	if _, ok := c.unknown["reaction_em_external_dependencies_frozen"]; !ok {
+		t.Fatal("missing old-trace boundary")
+	}
+}
diff --git a/pkg/gttcompact/reaction_path_test.go b/pkg/gttcompact/reaction_path_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/reaction_path_test.go
@@ -0,0 +1,46 @@
+package gttcompact
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+// Synthetic terminal receipts isolate classification from game mechanics. These
+// numbers are not character tuning: a direct-reaction path must never silently
+// enter the standard talent formula when no dependency compiler supports it.
+func TestGOB11ADirectReactionDoesNotBecomeStandardDamage(t *testing.T) {
+	hit := info.GTTTraceHit{
+		HitID: 1, ActorIndex: 0, FormulaKind: "direct_lunar", Element: "electro",
+		Mult: 2, ScalingStatKind: "atk", ScalingStatValue: 100, FlatDmg: 50,
+		BaseDamage: 600, EM: 1000, EMBonus: 2, AmpTotal: 3,
+		UncappedDamage: 1850, ReportedDamage: 1850,
+		Completeness:  info.GTTTraceCompleteness{FormulaComplete: true},
+		SnapshotStats: map[string]float64{"base_atk": 100, "em": 1000},
+		DefMod:        1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+	}
+	for _, kind := range []string{"direct_lunar", info.GTTTraceFormulaDirectReaction, "future_formula"} {
+		hit.FormulaKind = kind
+		ordinary := info.GTTTraceHit{
+			HitID: 2, ActorIndex: 0, FormulaKind: info.GTTTraceFormulaStandard,
+			Completeness: info.GTTTraceCompleteness{FormulaComplete: true}, UncappedDamage: 100,
+			Mult: 1, ScalingStatKind: "atk", ScalingStatValue: 100,
+			SnapshotStats: map[string]float64{"base_atk": 100},
+			DefMod:        1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+		}
+		member, _, err := CompileSeedMember(optstats.GTTTraceEquationBuffer{
+			Seed: 101, DurationFrames: 60, Hits: []info.GTTTraceHit{hit, ordinary},
+		}, []string{"synthetic_actor"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		channel := member.Channels[0]
+		if channel.BaselineDamage != "1850" || len(channel.ResponseCoordinates) != 0 || len(member.OpaqueBoundaries) == 0 {
+			t.Fatalf("%s must retain observed damage with an explicit local freeze; got %+v", kind, channel)
+		}
+		if member.Channels[1].BaselineDamage != "100" || len(member.Channels[1].ResponseCoordinates) == 0 {
+			t.Fatalf("%s broke the unrelated standard formula", kind)
+		}
+	}
+}
