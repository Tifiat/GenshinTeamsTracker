@@ -0,0 +1,109 @@
+package info
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+// Internal GP-2b receipt. The operation/operand come from the executed source
+// assignment. It is not an additive-delta assumption or a gameplay registry.
+type GTTNumericFieldWrite struct {
+	Field, Operation, OccurrenceID string
+	Order                          int
+	Before, After, Operand         float64
+	Reference                      gtttrace.NumericRef
+	Recipe                         *GTTNumericRecipe
+}
+
+// Original scalar producer, before later field writes. Internal live-buffer
+// evidence; old serialized traces retain their existing diagnosed boundary.
+type GTTFlatProducer struct {
+	Value     float64
+	Reference gtttrace.NumericRef
+}
+
+// NonExtraStat is a distinct central getter, not an alias for Stat. Its
+// original evaluation filters Extra modifiers before collecting ancestry.
+func GTTReadNonExtraStat(owner any, stat attributes.Stat, fallback func() float64) (float64, gtttrace.NumericRef) {
+	if c, ok := owner.(interface {
+		GTTNonExtraStat(attributes.Stat) (float64, string)
+	}); ok {
+		v, id := c.GTTNonExtraStat(stat)
+		if id != "" {
+			return v, gtttrace.EventRef(id)
+		}
+		return v, gtttrace.LiteralRef(v)
+	}
+	return fallback(), gtttrace.NumericRef{}
+}
+
+func GTTReadSavedScalar(rt *gtttrace.Runtime, source string, value *float64) float64 {
+	rt.ReadScalarCell(source, value)
+	return *value
+}
+
+func GTTReadStatVector(rt *gtttrace.Runtime, source string, values []float64) []float64 {
+	if rt.Enabled() {
+		for k, v := range values {
+			if v != 0 || rt.HasSavedStatCell(&values[k]) {
+				rt.ReadStatCell(source, attributes.Stat(k).String(), &values[k])
+			}
+		}
+	}
+	return values
+}
+
+func GTTRecordAttackFieldWrite(a *AttackEvent, rt *gtttrace.Runtime, field, op string, before, after, operand float64, ref gtttrace.NumericRef, recipe ...*GTTNumericRecipe) {
+	if a == nil || rt == nil || !rt.Enabled() {
+		return
+	}
+	write := GTTNumericFieldWrite{
+		Field: field, Operation: op, Order: len(a.GTTNumericFieldWrites),
+		OccurrenceID: rt.EnsureCurrentOccurrence(), Before: before, After: after, Operand: operand, Reference: ref,
+	}
+	if len(recipe) == 1 {
+		write.Recipe = recipe[0]
+	}
+	a.GTTNumericFieldWrites = append(a.GTTNumericFieldWrites, write)
+	if a.GTTTraceHit != nil {
+		a.GTTTraceHit.NumericFieldWrites = append(a.GTTTraceHit.NumericFieldWrites, write)
+	}
+}
+
+// Typed central getter interfaces prove ownership at runtime. Fallback calls
+// the original getter exactly once; unknown objects do not acquire character
+// semantics just because a method happens to be named Stat/MaxHP.
+func GTTReadTotalAtk(owner any, fallback func() float64) (float64, gtttrace.NumericRef) {
+	if c, ok := owner.(interface {
+		GTTTotalAtk() (float64, gtttrace.NumericRef)
+	}); ok {
+		return c.GTTTotalAtk()
+	}
+	return fallback(), gtttrace.NumericRef{}
+}
+
+func GTTReadMaxHP(owner any, fallback func() float64) (float64, gtttrace.NumericRef) {
+	if c, ok := owner.(interface{ GTTMaxHP() (float64, string) }); ok {
+		v, id := c.GTTMaxHP()
+		if id != "" {
+			return v, gtttrace.EventOutputRef(id, "max_hp")
+		}
+		return v, gtttrace.LiteralRef(v)
+	}
+	v := fallback()
+	return v, gtttrace.LiteralRef(v)
+}
+
+func GTTReadStat(owner any, stat attributes.Stat, fallback func() float64) (float64, gtttrace.NumericRef) {
+	if c, ok := owner.(interface {
+		GTTStat(attributes.Stat) (float64, string)
+	}); ok {
+		v, id := c.GTTStat(stat)
+		if id != "" {
+			return v, gtttrace.EventRef(id)
+		}
+		return v, gtttrace.LiteralRef(v)
+	}
+	v := fallback()
+	return v, gtttrace.LiteralRef(v)
+}
diff --git a/pkg/core/info/gtt_contributor_group.go b/pkg/core/info/gtt_contributor_group.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/info/gtt_contributor_group.go
@@ -0,0 +1,77 @@
+package info
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+// Internal observer ABI: independent crits, descending realized damage, then
+// rank weights read from the producer. The final attack owner is only a label.
+const GTTContributorGroupVersion = "gtt_contributor_rank_v1"
+
+type GTTContributor struct {
+	Hit                     GTTTraceHit
+	PreCrit, Realized, Roll float64
+	IsCrit                  bool
+	CritRate, CritDamage    float64
+}
+
+type GTTContributorGroup struct {
+	Version, SourceSHA256 string
+	Contributors          []GTTContributor
+	Weights               []float64
+	ObservedFlat          float64
+}
+
+func GTTNewContributorGroup(rt *gtttrace.Runtime) *GTTContributorGroup {
+	if !rt.Enabled() {
+		return nil
+	}
+	return &GTTContributorGroup{}
+}
+
+// A participant snapshot is captured after its original callbacks. It retains
+// foreign-provider writes/stat ancestry without running those callbacks again.
+func GTTContributorHit(group *GTTContributorGroup, a *AttackEvent) *GTTTraceHit {
+	if group == nil || a == nil {
+		return nil
+	}
+	h := &GTTTraceHit{
+		ActorIndex: a.Info.ActorIndex, FlatDmg: a.Info.FlatDmg,
+		BaseDmgBonus: a.Info.BaseDmgBonus, FlatProducer: a.Info.GTTFlatProducer,
+		NumericFieldWrites: append([]GTTNumericFieldWrite(nil), a.GTTNumericFieldWrites...),
+		CallbackAttempts:   append([]GTTTraceCallbackAttempt(nil), a.GTTTraceCallbackAttempts...),
+		StatContributions:  append([]GTTTraceStatContribution(nil), a.Snapshot.GTTStatContributions...),
+		SnapshotStats:      make(map[string]float64),
+		RawCritRate:        a.Snapshot.Stats[attributes.CR], CritDamage: a.Snapshot.Stats[attributes.CD],
+	}
+	for k, v := range a.Snapshot.Stats {
+		h.SnapshotStats[attributes.Stat(k).String()] = v
+	}
+	return h
+}
+
+func GTTRecordContributor(group *GTTContributorGroup, h *GTTTraceHit, preCrit, realized, roll float64, isCrit bool, cr, cd float64) {
+	if group == nil || h == nil {
+		return
+	}
+	group.Contributors = append(group.Contributors, GTTContributor{Hit: *h, PreCrit: preCrit, Realized: realized, Roll: roll, IsCrit: isCrit, CritRate: cr, CritDamage: cd})
+}
+
+// Build marker. The source verifier must prove the bounded reducer protocol.
+// Without its seal these observations are diagnostic, never a variable formula.
+func GTTSealContributorGroup(group *GTTContributorGroup, collection any, weights []float64, observed float64) {
+	GTTAttachContributorGroup(group, weights, observed, "")
+}
+
+func GTTAttachContributorGroup(group *GTTContributorGroup, weights []float64, observed float64, sourceSHA string) {
+	if group == nil {
+		return
+	}
+	group.Weights = append([]float64(nil), weights...)
+	group.ObservedFlat = observed
+	group.SourceSHA256 = sourceSHA
+	if sourceSHA != "" {
+		group.Version = GTTContributorGroupVersion
+	}
+}
