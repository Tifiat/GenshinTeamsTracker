+package optimization
+
+// GOB-11 regression: arbitrary post-producer callbacks must be a local boundary,
+// not a fatal trace error. No character or reaction-name semantics are assumed.
+import (
+	"github.com/genshinsim/gcsim/pkg/core/combat"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"testing"
+)
+
+type terminalBoundarySource struct{}
+
+func (terminalBoundarySource) Index() int                         { return 0 }
+func (terminalBoundarySource) ReactBonus(info.AttackInfo) float64 { return 0 }
+func (terminalBoundarySource) ReactBonusWithTrace(info.AttackInfo, *info.GTTTraceHit) float64 {
+	return 0
+}
+
+func TestReactionTerminalBoundaryValidation(t *testing.T) {
+	parent, target := uint64(1), 0
+	damage, snap := combat.CalcReactionDmg(90, terminalBoundarySource{}, info.AttackInfo{}, 100, 2,
+		info.GTTTraceReactionContext{Enabled: true, ReactionType: "synthetic", ReadFrame: 1,
+			ReadMode: info.GTTTraceReactionReadLive, ReadPhase: info.GTTTraceReactionReadLiveTrigger,
+			ParentAttackID: &parent, ParentTargetKey: &target, ChildRole: "synthetic"})
+	hit := info.GTTTraceHit{ActorIndex: 0, CharLevel: 90, SnapshotFrame: 1,
+		ReactionFormula: snap.GTTReactionFormula, ReactionOperatorID: "spawn_damage_attack",
+		SnapshotStats: map[string]float64{"em": 100}, ParentAttackID: &parent, ParentTargetKey: &target,
+		FlatDmg: damage, Completeness: info.GTTTraceCompleteness{FlatDmgProvenanceComplete: true}}
+	if err := validateGTTTraceReactionFormula(hit); err != nil {
+		t.Fatal(err)
+	}
+	hit.FlatDmg += 1000
+	if err := validateGTTTraceReactionFormula(hit); err == nil {
+		t.Fatal("unmarked terminal drift accepted")
+	}
+	hit.Unsupported = []string{"transformative_reaction_formula_mismatch"}
+	if err := validateGTTTraceReactionFormula(hit); err == nil {
+		t.Fatal("false completeness accepted")
+	}
+	hit.Completeness.FlatDmgProvenanceComplete = false
+	if err := validateGTTTraceReactionFormula(hit); err != nil {
+		t.Fatal(err)
+	}
+	hit.ReactionFormula.CoreDamage++
+	if err := validateGTTTraceReactionFormula(hit); err == nil {
+		t.Fatal("corrupt producer accepted")
+	}
+}
