@@ -0,0 +1,61 @@
+package optimization
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/gttcompact"
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+)
+
+// A separate opt-in product output, never a debug-stderr protocol. Its digest
+// binds the exact member file bytes (including newline), NOT a canonical object
+// digest in the consumer. Context, source/config, seed and initialization order
+// remain explicit. Neither a port nor its observed value is a set-effect proof.
+type GTTEffectInputs struct {
+	SchemaVersion            int                          `json:"schema_version"`
+	Capability               string                       `json:"capability"`
+	MemberContentSHA256      string                       `json:"member_content_sha256"`
+	ContextSHA256            string                       `json:"context_sha256"`
+	InputConfigSHA256        string                       `json:"input_config_sha256"`
+	SourceConfigSHA256       string                       `json:"source_config_sha256"`
+	SourceManifestBodySHA256 string                       `json:"source_manifest_body_sha256"`
+	Seed                     string                       `json:"seed"`
+	CharacterKeys            []string                     `json:"character_keys"`
+	EffectInputs             []gttcompact.EffectInput     `json:"effect_inputs"`
+	ResistanceInputs         []gttcompact.ResistanceInput `json:"resistance_inputs"`
+}
+
+func encodeGTTEffectInputs(member []byte, request GTTTraceEquationRequest, inputConfig, config string, owners []string, audit gttcompact.Audit) ([]byte, error) {
+	digest := sha256.Sum256(member)
+	effects, resistance := audit.EffectInputs, audit.ResistanceInputs
+	if effects == nil {
+		effects = []gttcompact.EffectInput{}
+	}
+	if resistance == nil {
+		resistance = []gttcompact.ResistanceInput{}
+	}
+	return json.Marshal(GTTEffectInputs{
+		SchemaVersion: 1, Capability: gtt.EffectInputsV1Capability,
+		MemberContentSHA256: hex.EncodeToString(digest[:]),
+		ContextSHA256:       request.ContextSHA256, InputConfigSHA256: traceTextSHA256(inputConfig), SourceConfigSHA256: traceTextSHA256(config),
+		SourceManifestBodySHA256: gttsource.ManifestBodySHA256(),
+		Seed:                     request.Seed, CharacterKeys: append([]string(nil), owners...),
+		EffectInputs: effects, ResistanceInputs: resistance,
+	})
+}
+
+func writeGTTEffectInputs(path string, member []byte, request GTTTraceEquationRequest, inputConfig, config string, owners []string, audit gttcompact.Audit) error {
+	payload, err := encodeGTTEffectInputs(member, request, inputConfig, config, owners, audit)
+	if err != nil {
+		return fmt.Errorf("gtt effect inputs: encode: %w", err)
+	}
+	if err := os.WriteFile(path+".effects.json", append(payload, '\n'), 0o644); err != nil {
+		return fmt.Errorf("gtt effect inputs: write: %w", err)
+	}
+	return nil
+}
