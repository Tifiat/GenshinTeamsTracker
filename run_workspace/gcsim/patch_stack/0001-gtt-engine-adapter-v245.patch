+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"strconv"
+)
+
+// Capture the original typed receiver at the original evaluation position.
+// The narrow local case requires one definition and one use in the same block;
+// reassignments, aliases, escaping references and shared consumers stay on the
+// existing explicitly frozen path. Loop iterations get distinct local receipts.
+func typedHealthInputEdits(fs *token.FileSet, tf *token.File, data []byte, file *ast.File, fn *ast.FuncDecl, lit *ast.CompositeLit, entry SourceEntry, rt string) ([]textEdit, bool) {
+	qual := vectorInfoAlias(file)
+	if qual == "" || expressionQualifier(lit.Type) != qual {
+		return nil, false
+	}
+	field := compositeKeyValue(lit, entry.healthInput.ValueField)
+	if field == nil {
+		return nil, false
+	}
+	stmt := containingStatement(fn.Body, lit)
+	if stmt == nil {
+		return nil, false
+	}
+	original := field.Value
+	at := stmt
+	if id, ok := original.(*ast.Ident); ok {
+		var block *ast.BlockStmt
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			b, ok := n.(*ast.BlockStmt)
+			if ok && b.Pos() < stmt.Pos() && b.End() > stmt.End() {
+				if block == nil || b.End()-b.Pos() < block.End()-block.Pos() {
+					block = b
+				}
+			}
+			return true
+		})
+		if block == nil {
+			return nil, false
+		}
+		uses := 0
+		ast.Inspect(block, func(n ast.Node) bool {
+			if v, ok := n.(*ast.Ident); ok && v.Name == id.Name {
+				uses++
+			}
+			return true
+		})
+		if uses != 2 {
+			return nil, false
+		}
+		var definition *ast.AssignStmt
+		for _, s := range block.List {
+			a, ok := s.(*ast.AssignStmt)
+			if !ok || a.Tok != token.DEFINE || len(a.Lhs) != 1 || len(a.Rhs) != 1 || a.End() >= stmt.Pos() {
+				continue
+			}
+			name, ok := a.Lhs[0].(*ast.Ident)
+			if ok && name.Name == id.Name {
+				definition = a
+			}
+		}
+		if definition == nil {
+			return nil, false
+		}
+		original = definition.Rhs[0]
+		at = definition
+	}
+	// Stat APIs are typed again at runtime. Arbitrary arithmetic leaves remain
+	// explicitly frozen, never guessed from an equal value or a variable name.
+	if !hasFieldStatInput(original, nil, fs) {
+		return nil, false
+	}
+	prefix := fmt.Sprintf("gttHealthInput_%d", field.Pos())
+	expr := fieldExpression{fset: fs, rt: rt, source: strconv.Quote(entry.SourceID), prefix: prefix, info: qual, constants: sourceNamedConstants(file)}
+	value, err := expr.emit(original, 0)
+	if err != nil {
+		return nil, false
+	}
+	event := prefix + "_event"
+	capture := fmt.Sprintf("func()float64{if !%s.Enabled(){return %s};%s\n%s=%s.RecordNumericEval(%s,\"identity\",[]%s.NumericRef{%s},float64(%s),%s.IncompleteEvidence(\"health_input_branch_schedule_frozen\"));return float64(%s)}()", rt, rootText(fs, original), expr.code.String(), event, rt, strconv.Quote(entry.SourceID), traceImportAlias, value.ref, value.value, traceImportAlias, value.value)
+	metadata := healthMetadataInsertion(data, tf, lit, entry, "nil") + "GTTTraceInputEventID:" + event + ","
+	return []textEdit{
+		{start: tf.Offset(at.Pos()), end: tf.Offset(at.Pos()), replacement: "var " + event + " string;\n" + indentationBefore(data, tf.Offset(at.Pos()))},
+		{start: tf.Offset(original.Pos()), end: tf.Offset(original.End()), replacement: capture},
+		{start: tf.Offset(lit.Rbrace), end: tf.Offset(lit.Rbrace), replacement: metadata},
+	}, true
+}
diff --git a/pkg/gttsourcegen/health_input_test.go b/pkg/gttsourcegen/health_input_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/health_input_test.go
@@ -0,0 +1,72 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strings"
+	"testing"
+)
+
+func TestTypedHealthInputOriginalReceiverAndPosition(t *testing.T) {
+	local := `package arbitrary
+import "github.com/genshinsim/gcsim/pkg/core/info"
+func (p *provider) tick(ratio float64) {
+ for _, recipient := range p.Core.Player.Chars() {
+  amount := recipient.MaxHP()*ratio
+  changeState()
+  p.Core.Player.Drain(info.DrainInfo{ActorIndex:recipient.Index(),Amount:amount})
+ }
+}`
+	for _, tc := range []struct {
+		name, src string
+		want      bool
+	}{
+		{"loop local", local, true},
+		{"renamed", strings.ReplaceAll(local, "recipient", "other"), true},
+		{"reassigned", strings.Replace(local, "changeState()", "amount=42;changeState()", 1), false},
+		{"address escape", strings.Replace(local, "changeState()", "escape(&amount)", 1), false},
+		{"second consumer", strings.Replace(local, "changeState()", "consume(amount)", 1), false},
+		{"unknown receiver method", strings.ReplaceAll(local, ".MaxHP()", ".Unknown()"), false},
+		{"unrelated info package", strings.Replace(local, "github.com/genshinsim/gcsim/pkg/core/info", "example/info", 1), false},
+		{"direct field", strings.Replace(strings.Replace(local, "amount := recipient.MaxHP()*ratio", "", 1), "Amount:amount", "Amount:recipient.MaxHP()*ratio", 1), true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			file, err := parser.ParseFile(fs, "test.go", tc.src, parser.SkipObjectResolution)
+			if err != nil {
+				t.Fatal(err)
+			}
+			fn := file.Decls[1].(*ast.FuncDecl)
+			var lit *ast.CompositeLit
+			ast.Inspect(fn, func(n ast.Node) bool {
+				if v, ok := n.(*ast.CompositeLit); ok {
+					lit = v
+				}
+				return true
+			})
+			entry := SourceEntry{SourceID: strings.Repeat("a", 64), healthInput: &healthInputPlan{ValueField: "Amount"}}
+			edits, ok := typedHealthInputEdits(fs, fs.File(file.Pos()), []byte(tc.src), file, fn, lit, entry, "p.Core.GTTTrace")
+			if ok != tc.want {
+				t.Fatal(ok)
+			}
+			if !ok {
+				return
+			}
+			out, err := applyTextEdits([]byte(tc.src), edits)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = parser.ParseFile(token.NewFileSet(), "out.go", out, 0); err != nil {
+				t.Fatal(err, string(out))
+			}
+			text := string(out)
+			if strings.Count(text, "GTTReadMaxHP(") != 1 || strings.Count(text, "GTTTraceInputEventID:") != 1 || !strings.Contains(text, "health_input_branch_schedule_frozen") {
+				t.Fatal(text)
+			}
+			if tc.name == "loop local" && strings.Index(text, "GTTReadMaxHP(") > strings.Index(text, "changeState()") {
+				t.Fatal("getter moved after state change")
+			}
+		})
+	}
+}
diff --git a/pkg/gttsourcegen/ir.go b/pkg/gttsourcegen/ir.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/ir.go
@@ -0,0 +1,661 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"math"
+	"strconv"
+	"strings"
+	"unicode"
+)
+
+const (
+	maxNumericExpressionDepth = 12
+	maxNumericExpressionNodes = 64
+)
+
+type templateCompilation struct {
+	template       SliceTemplate
+	parameters     []parameterPlan
+	modifierOutput *modifierOutputPlan
+	healthInput    *healthInputPlan
+	callback       *callbackPlan
+	stateOperation *stateOperationPlan
+}
+
+type expressionCompiler struct {
+	fset                      *token.FileSet
+	bindings                  bindingSet
+	resolving                 map[string]bool
+	nodes                     []TemplateNode
+	parameters                []parameterPlan
+	paramNode                 map[string]int
+	stopReason                string
+	depth                     int
+	allowFrozenConversions    bool
+	frozenConversionFallbacks int
+	allowTypedFlatStat        bool
+	flatStatLocal             string
+}
+
+func describeModifierAmount(fset *token.FileSet, root ast.Expr, bindings bindingSet) templateCompilation {
+	fn, ok := root.(*ast.FuncLit)
+	if !ok {
+		return opaqueTemplate("modifier_amount_not_function_literal")
+	}
+	output, reason := findModifierOutput(fn.Body)
+	if output == nil {
+		return opaqueTemplate(reason)
+	}
+	compiler := newExpressionCompiler(fset, bindings)
+	valueNode, ok := compiler.compile(output.value)
+	if !ok {
+		return opaqueTemplate(compiler.stopReason)
+	}
+	rootNode := valueNode
+	if output.guard != nil {
+		guardNode, ok := compiler.compilePredicate(output.guard)
+		if !ok {
+			return opaqueTemplate(compiler.stopReason)
+		}
+		if !output.guardActiveWhen {
+			guardNode = compiler.addNode("NOT", []int{guardNode}, nil, nil)
+		}
+		zero := 0.0
+		zeroNode := compiler.addNode("CONST", nil, &zero, nil)
+		rootNode = compiler.addNode("SELECT", []int{guardNode, valueNode, zeroNode}, nil, nil)
+	}
+	compiled := compiler.finish(rootNode)
+	compiled.modifierOutput = &modifierOutputPlan{
+		Expression:          rootText(fset, output.value),
+		OutputKeyExpression: rootText(fset, output.outputKey),
+		GuardExpression:     rootText(fset, output.guard),
+		GuardActiveWhen:     output.guardActiveWhen,
+		InactiveIsNil:       output.inactiveIsNil,
+	}
+	return compiled
+}
+
+type modifierOutputMatch struct {
+	value           ast.Expr
+	outputKey       ast.Expr
+	guard           ast.Expr
+	guardActiveWhen bool
+	inactiveIsNil   bool
+}
+
+// findModifierOutput accepts two bounded shapes only:
+//   - an optional whole-function early nil/zero return guard followed by one
+//     indexed stat-vector assignment; or
+//   - one whole-function if returning a scalar and a zero/nil fallback.
+//
+// Nested/ambiguous control flow remains opaque.
+func findModifierOutput(body *ast.BlockStmt) (*modifierOutputMatch, string) {
+	if body == nil {
+		return nil, "modifier_body_missing"
+	}
+	statements := body.List
+	var guard ast.Expr
+	guardActiveWhen := true
+	inactiveIsNil := false
+	start := 0
+	if len(statements) > 0 {
+		ifStmt, ok := statements[0].(*ast.IfStmt)
+		if ok && ifStmt.Init == nil && ifStmt.Else == nil && len(ifStmt.Body.List) == 1 {
+			if returned, ok := ifStmt.Body.List[0].(*ast.ReturnStmt); ok && len(returned.Results) == 1 && isNilOrNumericZero(returned.Results[0]) {
+				guard = ifStmt.Cond
+				guardActiveWhen = false
+				inactiveIsNil = isNilIdent(returned.Results[0])
+				start = 1
+			}
+		}
+	}
+
+	indexed := make([]*ast.AssignStmt, 0, 1)
+	for _, statement := range statements[start:] {
+		switch value := statement.(type) {
+		case *ast.AssignStmt:
+			if len(value.Lhs) == 1 && len(value.Rhs) == 1 {
+				if _, ok := value.Lhs[0].(*ast.IndexExpr); ok {
+					if value.Tok != token.ASSIGN {
+						return nil, "modifier_compound_output"
+					}
+					indexed = append(indexed, value)
+				}
+			}
+		case *ast.IfStmt, *ast.ForStmt, *ast.RangeStmt, *ast.SwitchStmt, *ast.TypeSwitchStmt, *ast.SelectStmt, *ast.GoStmt, *ast.DeferStmt:
+			// Any control flow beyond the accepted leading guard is ambiguous.
+			return nil, "modifier_nested_control_flow"
+		}
+	}
+	if len(indexed) == 1 {
+		index := indexed[0].Lhs[0].(*ast.IndexExpr)
+		return &modifierOutputMatch{
+			value: indexed[0].Rhs[0], outputKey: index.Index, guard: guard,
+			guardActiveWhen: guardActiveWhen, inactiveIsNil: inactiveIsNil,
+		}, ""
+	}
+	if len(indexed) > 1 {
+		return nil, "modifier_output_assignment_count"
+	}
+
+	// Scalar output: if cond { return expr }; return 0/nil.
+	if len(statements) == 2 {
+		ifStmt, ok := statements[0].(*ast.IfStmt)
+		fallback, fallbackOK := statements[1].(*ast.ReturnStmt)
+		if ok && ifStmt.Init == nil && ifStmt.Else == nil && len(ifStmt.Body.List) == 1 && fallbackOK && len(fallback.Results) == 1 && isNilOrNumericZero(fallback.Results[0]) {
+			returned, returnOK := ifStmt.Body.List[0].(*ast.ReturnStmt)
+			if returnOK && len(returned.Results) == 1 && !isNilIdent(returned.Results[0]) {
+				return &modifierOutputMatch{
+					value: returned.Results[0], guard: ifStmt.Cond,
+					guardActiveWhen: true, inactiveIsNil: isNilIdent(fallback.Results[0]),
+				}, ""
+			}
+		}
+	}
+	return nil, "modifier_output_assignment_count"
+}
+
+func isNilIdent(expr ast.Expr) bool {
+	ident, ok := expr.(*ast.Ident)
+	return ok && ident.Name == "nil"
+}
+
+func isNilOrNumericZero(expr ast.Expr) bool {
+	if isNilIdent(expr) {
+		return true
+	}
+	literal, ok := expr.(*ast.BasicLit)
+	if !ok || (literal.Kind != token.INT && literal.Kind != token.FLOAT) {
+		return false
+	}
+	number, err := strconv.ParseFloat(strings.ReplaceAll(literal.Value, "_", ""), 64)
+	return err == nil && number == 0
+}
+
+func describeQueuedAttack(fset *token.FileSet, root ast.Expr, bindings bindingSet) templateCompilation {
+	flatDamage := compositeField(root, "FlatDmg", bindings)
+	if composite, ok := root.(*ast.CompositeLit); ok {
+		if field := compositeKeyValue(composite, "FlatDmg"); field != nil {
+			// Preserve the use-site local; eager alias expansion loses its read time.
+			flatDamage = field.Value
+		}
+	}
+	if flatDamage == nil {
+		return opaqueTemplate("attack_info_flat_dmg_not_explicit")
+	}
+	compiler := newExpressionCompiler(fset, bindings)
+	compiler.allowTypedFlatStat = true
+	rootNode, ok := compiler.compile(flatDamage)
+	if !ok {
+		return opaqueTemplate(compiler.stopReason)
+	}
+	// SUPPORTED describes a closed template over its explicit parameters.
+	// External modifier ancestry is incomplete on each typed parameter, not
+	// an unbound node in the template. Preserve the existing two-level contract.
+	return compiler.finish(rootNode)
+}
+
+func describeHealthInput(fset *token.FileSet, root ast.Expr, bindings bindingSet, valueField string) templateCompilation {
+	value := compositeField(root, valueField, bindings)
+	if value == nil {
+		return opaqueTemplate("health_input_value_not_explicit")
+	}
+	compiled := compileNumericTemplate(fset, value, bindings)
+	compiled.healthInput = &healthInputPlan{ValueField: valueField}
+	return compiled
+}
+
+func describeCallback(fset *token.FileSet, root ast.Expr, _ bindingSet, kind string) templateCompilation {
+	compiled := opaqueTemplate(kind + "_semantic_boundary")
+	switch value := root.(type) {
+	case *ast.FuncLit:
+		compiled.callback = &callbackPlan{ResolvedLine: fset.Position(value.Pos()).Line}
+	case *ast.CallExpr:
+		selector, ok := value.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return compiled
+		}
+		payloads := make([]string, len(value.Args))
+		for index, arg := range value.Args {
+			payloads[index] = rootText(fset, arg)
+		}
+		compiled.callback = &callbackPlan{
+			ResolvedMethodName: selector.Sel.Name,
+			ResolvedReceiver:   rootText(fset, selector.X),
+			PayloadExpressions: payloads,
+		}
+	}
+	return compiled
+}
+
+func compileNumericTemplate(fset *token.FileSet, expr ast.Expr, bindings bindingSet) templateCompilation {
+	compiler := newExpressionCompiler(fset, bindings)
+	root, ok := compiler.compile(expr)
+	if !ok {
+		return opaqueTemplate(compiler.stopReason)
+	}
+	return compiler.finish(root)
+}
+
+func compileForwardedNumericTemplate(fset *token.FileSet, expr ast.Expr, bindings bindingSet) templateCompilation {
+	compiler := newExpressionCompiler(fset, bindings)
+	compiler.allowFrozenConversions = true
+	root, ok := compiler.compile(expr)
+	if !ok {
+		return opaqueTemplate(compiler.stopReason)
+	}
+	return compiler.finish(root)
+}
+
+func describeForwardedQueuedAttack(fset *token.FileSet, root ast.Expr, bindings bindingSet) templateCompilation {
+	flatDamage := compositeField(root, "FlatDmg", bindings)
+	if flatDamage == nil {
+		return opaqueTemplate("attack_info_flat_dmg_not_explicit")
+	}
+	return compileForwardedNumericTemplate(fset, flatDamage, bindings)
+}
+
+func newExpressionCompiler(fset *token.FileSet, bindings bindingSet) *expressionCompiler {
+	return &expressionCompiler{
+		fset: fset, bindings: bindings, resolving: make(map[string]bool),
+		paramNode: make(map[string]int),
+	}
+}
+
+func (compiler *expressionCompiler) finish(root int) templateCompilation {
+	if len(compiler.nodes) > maxNumericExpressionNodes {
+		return opaqueTemplate("numeric_expression_node_budget_exceeded")
+	}
+	parameterKeys := make([]string, 0, len(compiler.parameters))
+	for _, parameter := range compiler.parameters {
+		parameterKeys = append(parameterKeys, parameter.ParameterKey)
+	}
+	sortStringsUnique(parameterKeys)
+	rootNodeID := root
+	return templateCompilation{
+		template: SliceTemplate{
+			Status: TemplateSupported, Nodes: compiler.nodes, RootNodeID: &rootNodeID,
+			ParameterKeys: parameterKeys, DependenciesComplete: true,
+		},
+		parameters: compiler.parameters,
+	}
+}
+
+func opaqueTemplate(reason string) templateCompilation {
+	if reason == "" {
+		reason = "unsupported_source_root"
+	}
+	reason = lowerSnake(reason)
+	return templateCompilation{template: SliceTemplate{
+		Status: TemplateOpaqueFrozen, Nodes: []TemplateNode{}, RootNodeID: nil,
+		ParameterKeys: []string{}, DependenciesComplete: false, StopReasonCode: &reason,
+	}}
+}
+
+func (compiler *expressionCompiler) compile(expr ast.Expr) (int, bool) {
+	if compiler.depth >= maxNumericExpressionDepth {
+		return compiler.fail("numeric_expression_depth_budget_exceeded")
+	}
+	compiler.depth++
+	defer func() { compiler.depth-- }()
+	switch value := expr.(type) {
+	case *ast.ParenExpr:
+		return compiler.compile(value.X)
+	case *ast.BasicLit:
+		if value.Kind != token.INT && value.Kind != token.FLOAT {
+			return compiler.fail("non_numeric_constant")
+		}
+		number, err := strconv.ParseFloat(strings.ReplaceAll(value.Value, "_", ""), 64)
+		if err != nil || math.IsNaN(number) || math.IsInf(number, 0) {
+			return compiler.fail("invalid_numeric_constant")
+		}
+		return compiler.addNode("CONST", nil, &number, nil), true
+	case *ast.Ident:
+		if value.Name == "true" || value.Name == "false" || value.Name == "nil" {
+			return compiler.fail("non_numeric_identifier")
+		}
+		if defs := compiler.bindings[value.Name]; len(defs) == 1 && !compiler.resolving[value.Name] && len(compiler.bindings["@gtt/address/"+value.Name]) == 0 {
+			nodeCount := len(compiler.nodes)
+			parameterCount := len(compiler.parameters)
+			previousStopReason := compiler.stopReason
+			previousFallbacks := compiler.frozenConversionFallbacks
+			previousParamNodes := cloneParamNodes(compiler.paramNode)
+			compiler.resolving[value.Name] = true
+			previousLocal := compiler.flatStatLocal
+			compiler.flatStatLocal = value.Name
+			id, ok := compiler.compile(defs[0])
+			compiler.flatStatLocal = previousLocal
+			delete(compiler.resolving, value.Name)
+			// Reusing an already computed getter alias is safe. Reusing a compound
+			// local as the value of an inner getter is not: it applies the outer
+			// arithmetic twice. Keep that complete local frozen until its original
+			// evaluation can supply a numeric dependency receipt.
+			if compiler.allowTypedFlatStat && hasFlatStatParameters(compiler.parameters[parameterCount:]) && !directFlatStatAlias(defs[0]) {
+				compiler.nodes = compiler.nodes[:nodeCount]
+				compiler.parameters = compiler.parameters[:parameterCount]
+				compiler.paramNode = previousParamNodes
+				compiler.stopReason = previousStopReason
+				compiler.frozenConversionFallbacks = previousFallbacks
+				return compiler.parameter(value, "frozen_runtime_state", "", "", false), true
+			}
+			if ok && compiler.allowFrozenConversions && compiler.frozenConversionFallbacks > previousFallbacks && !hasCandidateParameters(compiler.parameters[parameterCount:]) {
+				compiler.nodes = compiler.nodes[:nodeCount]
+				compiler.parameters = compiler.parameters[:parameterCount]
+				compiler.paramNode = previousParamNodes
+				compiler.stopReason = previousStopReason
+				compiler.frozenConversionFallbacks = previousFallbacks
+				return compiler.parameter(value, "frozen_runtime_state", "", "", false), true
+			}
+			return id, ok
+		}
+		return compiler.parameter(value, "frozen_runtime_state", "", "", false), true
+	case *ast.SelectorExpr:
+		kind := "frozen_source_value"
+		actor := ""
+		complete := true
+		if startsLower(value.Sel.Name) {
+			kind = "frozen_runtime_state"
+			actor = ""
+			complete = false
+		}
+		return compiler.parameter(value, kind, actor, "", complete), true
+	case *ast.IndexExpr:
+		if !isPureOperand(value) {
+			return compiler.fail("impure_table_lookup")
+		}
+		return compiler.parameter(value, "frozen_source_value", "", "", true), true
+	case *ast.BinaryExpr:
+		operator := ""
+		switch value.Op {
+		case token.ADD:
+			operator = "ADD"
+		case token.SUB:
+			operator = "SUB"
+		case token.MUL:
+			operator = "MUL"
+		case token.QUO:
+			operator = "DIV"
+		default:
+			return compiler.fail("unsupported_binary_operator")
+		}
+		left, ok := compiler.compile(value.X)
+		if !ok {
+			return 0, false
+		}
+		right, ok := compiler.compile(value.Y)
+		if !ok {
+			return 0, false
+		}
+		return compiler.addNode(operator, []int{left, right}, nil, nil), true
+	case *ast.CallExpr:
+		if compiler.allowTypedFlatStat {
+			if id, ok := compiler.compileTypedFlatStat(value); ok {
+				return id, true
+			}
+		}
+		if ident, ok := value.Fun.(*ast.Ident); ok && numericBuiltinType(ident) && len(value.Args) == 1 {
+			if !compiler.allowFrozenConversions {
+				return compiler.fail("unsupported_call")
+			}
+			return compiler.compileNumericConversion(value)
+		}
+		if ident, ok := value.Fun.(*ast.Ident); ok && (ident.Name == "min" || ident.Name == "max") && len(value.Args) == 2 {
+			left, ok := compiler.compile(value.Args[0])
+			if !ok {
+				return 0, false
+			}
+			right, ok := compiler.compile(value.Args[1])
+			if !ok {
+				return 0, false
+			}
+			return compiler.addNode(strings.ToUpper(ident.Name), []int{left, right}, nil, nil), true
+		}
+		if selector, ok := value.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == "Abs" && len(value.Args) == 1 {
+			input, ok := compiler.compile(value.Args[0])
+			if !ok {
+				return 0, false
+			}
+			return compiler.addNode("ABS", []int{input}, nil, nil), true
+		}
+		selector, ok := value.Fun.(*ast.SelectorExpr)
+		if !ok || len(value.Args) != 0 {
+			return compiler.fail("unsupported_call")
+		}
+		actor := rootText(compiler.fset, selector.X)
+		switch selector.Sel.Name {
+		case "MaxHP":
+			return compiler.parameter(value, "candidate_stat", actor, "max_hp", true), true
+		case "TotalATK":
+			return compiler.parameter(value, "candidate_stat", actor, "total_atk", true), true
+		case "TotalDEF":
+			return compiler.parameter(value, "candidate_stat", actor, "total_def", true), true
+		case "CurrentHP":
+			return compiler.parameter(value, "frozen_runtime_state", actor, "current_hp", false), true
+		default:
+			return compiler.fail("unsupported_call")
+		}
+	default:
+		return compiler.fail(fmt.Sprintf("unsupported_ast_%T", expr))
+	}
+}
+
+// compileNumericConversion first preserves a stat-aware arithmetic child. If
+// the child crosses an unsupported runtime seam, the conversion's observed
+// numeric value remains usable as one frozen runtime parameter instead of
+// making the entire parent damage expression opaque.
+func (compiler *expressionCompiler) compileNumericConversion(call *ast.CallExpr) (int, bool) {
+	nodeCount := len(compiler.nodes)
+	parameterCount := len(compiler.parameters)
+	previousStopReason := compiler.stopReason
+	previousParamNodes := cloneParamNodes(compiler.paramNode)
+	if child, ok := compiler.compile(call.Args[0]); ok {
+		return child, true
+	}
+	if !compiler.allowFrozenConversions {
+		return 0, false
+	}
+	compiler.nodes = compiler.nodes[:nodeCount]
+	compiler.parameters = compiler.parameters[:parameterCount]
+	compiler.paramNode = previousParamNodes
+	compiler.stopReason = previousStopReason
+	compiler.frozenConversionFallbacks++
+	return compiler.parameter(call, "frozen_runtime_state", "", "", false), true
+}
+
+func cloneParamNodes(values map[string]int) map[string]int {
+	cloned := make(map[string]int, len(values))
+	for key, value := range values {
+		cloned[key] = value
+	}
+	return cloned
+}
+
+func hasCandidateParameters(parameters []parameterPlan) bool {
+	for _, parameter := range parameters {
+		if parameter.Kind == "candidate_stat" {
+			return true
+		}
+	}
+	return false
+}
+
+func (compiler *expressionCompiler) compilePredicate(expr ast.Expr) (int, bool) {
+	switch value := expr.(type) {
+	case *ast.ParenExpr:
+		return compiler.compilePredicate(value.X)
+	case *ast.UnaryExpr:
+		if value.Op != token.NOT {
+			return compiler.fail("unsupported_guard_unary_operator")
+		}
+		child, ok := compiler.compilePredicate(value.X)
+		if !ok {
+			return 0, false
+		}
+		return compiler.addNode("NOT", []int{child}, nil, nil), true
+	case *ast.BinaryExpr:
+		operator := ""
+		switch value.Op {
+		case token.LAND:
+			operator = "AND"
+		case token.LOR:
+			operator = "OR"
+		case token.EQL:
+			operator = "EQ"
+		case token.NEQ:
+			operator = "NE"
+		case token.LSS:
+			operator = "LT"
+		case token.LEQ:
+			operator = "LE"
+		case token.GTR:
+			operator = "GT"
+		case token.GEQ:
+			operator = "GE"
+		default:
+			return compiler.fail("unsupported_guard_binary_operator")
+		}
+		var left, right int
+		var ok bool
+		if value.Op == token.LAND || value.Op == token.LOR {
+			left, ok = compiler.compilePredicate(value.X)
+			if !ok {
+				return 0, false
+			}
+			right, ok = compiler.compilePredicate(value.Y)
+		} else {
+			left, ok = compiler.compile(value.X)
+			if !ok {
+				return 0, false
+			}
+			right, ok = compiler.compile(value.Y)
+		}
+		if !ok {
+			return 0, false
+		}
+		return compiler.addNode(operator, []int{left, right}, nil, nil), true
+	case *ast.Ident, *ast.SelectorExpr, *ast.CallExpr:
+		return compiler.parameter(expr, "frozen_runtime_state", "", "", false), true
+	default:
+		return compiler.fail(fmt.Sprintf("unsupported_guard_ast_%T", expr))
+	}
+}
+
+func (compiler *expressionCompiler) parameter(expr ast.Expr, kind, actor, stat string, complete bool) int {
+	readMode := "live"
+	if kind == "frozen_source_value" {
+		actor = ""
+		stat = ""
+		complete = true
+		readMode = "constant"
+	}
+	source := rootText(compiler.fset, expr)
+	identity := strings.Join([]string{kind, source, actor, stat}, "|")
+	if existing, ok := compiler.paramNode[identity]; ok {
+		return existing
+	}
+	key := "p" + strconv.Itoa(len(compiler.parameters))
+	compiler.parameters = append(compiler.parameters, parameterPlan{
+		ParameterKey: key, Kind: kind, SourceExpression: source, ActorExpression: actor,
+		StatKey: stat, ReadMode: readMode, CandidateDependencyComplete: complete,
+	})
+	id := compiler.addNode("PARAM", nil, nil, &key)
+	compiler.paramNode[identity] = id
+	return id
+}
+
+func (compiler *expressionCompiler) addNode(operator string, inputs []int, constant *float64, parameter *string) int {
+	id := len(compiler.nodes)
+	if inputs == nil {
+		inputs = []int{}
+	}
+	compiler.nodes = append(compiler.nodes, TemplateNode{
+		NodeID: id, Operator: operator, InputNodeIDs: inputs,
+		ConstantValue: constant, ParameterKey: parameter,
+	})
+	return id
+}
+
+func (compiler *expressionCompiler) fail(reason string) (int, bool) {
+	if compiler.stopReason == "" {
+		compiler.stopReason = lowerSnake(reason)
+	}
+	return 0, false
+}
+
+func callbackAssignments(body *ast.BlockStmt) []*ast.AssignStmt {
+	result := make([]*ast.AssignStmt, 0, 2)
+	ast.Inspect(body, func(node ast.Node) bool {
+		if node == nil {
+			return true
+		}
+		if fn, ok := node.(*ast.FuncLit); ok && fn.Body != body {
+			return false
+		}
+		if assignment, ok := node.(*ast.AssignStmt); ok {
+			result = append(result, assignment)
+		}
+		return true
+	})
+	return result
+}
+
+func isPureOperand(expr ast.Expr) bool {
+	switch value := expr.(type) {
+	case *ast.BasicLit, *ast.Ident:
+		return true
+	case *ast.ParenExpr:
+		return isPureOperand(value.X)
+	case *ast.SelectorExpr:
+		return isPureOperand(value.X)
+	case *ast.IndexExpr:
+		return isPureOperand(value.X) && isPureOperand(value.Index)
+	case *ast.CallExpr:
+		selector, ok := value.Fun.(*ast.SelectorExpr)
+		return ok && len(value.Args) == 0 && strings.HasPrefix(selector.Sel.Name, "TalentLvl")
+	default:
+		return false
+	}
+}
+
+func inferActorExpression(fset *token.FileSet, expr ast.Expr) string {
+	actor := ""
+	ast.Inspect(expr, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return actor == ""
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if ok && strings.HasPrefix(selector.Sel.Name, "TalentLvl") {
+			actor = rootText(fset, selector.X)
+			return false
+		}
+		return actor == ""
+	})
+	return actor
+}
+
+func startsLower(value string) bool {
+	for _, char := range value {
+		return unicode.IsLower(char)
+	}
+	return false
+}
+
+func lowerSnake(value string) string {
+	value = strings.ToLower(value)
+	var out strings.Builder
+	lastUnderscore := false
+	for _, char := range value {
+		valid := unicode.IsLetter(char) || unicode.IsDigit(char)
+		if valid {
+			out.WriteRune(char)
+			lastUnderscore = false
+		} else if !lastUnderscore && out.Len() > 0 {
+			out.WriteByte('_')
+			lastUnderscore = true
+		}
+	}
+	return strings.Trim(out.String(), "_")
+}
diff --git a/pkg/gttsourcegen/local_vector.go b/pkg/gttsourcegen/local_vector.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/local_vector.go
@@ -0,0 +1,152 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+)
+
+// Closure-captured local []float64 vectors. Prove the allocation and every use
+// in the containing function; writes are bounded and alias/address escapes
+// reject the plan. Does not promote a similarly named foreign slice API.
+func bindLocalVectors(fs *token.FileSet, files []parsedSourceFile, candidates []sourceCandidate) {
+	for i := range candidates {
+		c := &candidates[i]
+		if c.kind != KindModifierAmount || c.savedVector != nil || c.traceRuntimePath == "" || c.template.template.Status == TemplateSupported {
+			continue
+		}
+		literal, ok := c.root.(*ast.FuncLit)
+		if !ok {
+			continue
+		}
+		ret := singleVectorReturn(literal)
+		if ret == nil {
+			continue
+		}
+		id, ok := ret.Results[0].(*ast.Ident)
+		if !ok || id.Name == "nil" {
+			continue
+		}
+		var file *ast.File
+		var owner *ast.FuncDecl
+		for _, s := range files {
+			if s.rel == c.relativeFile {
+				file = s.file
+				for _, d := range file.Decls {
+					if fn, ok := d.(*ast.FuncDecl); ok && fn.Pos() < literal.Pos() && fn.End() > literal.End() {
+						owner = fn
+					}
+				}
+			}
+		}
+		if owner == nil || vectorInfoAlias(file) == "" {
+			continue
+		}
+		var init *ast.AssignStmt
+		for _, stmt := range owner.Body.List {
+			a, ok := stmt.(*ast.AssignStmt)
+			if !ok || a.Tok != token.DEFINE || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+				continue
+			}
+			name, ok := a.Lhs[0].(*ast.Ident)
+			if !ok || name.Name != id.Name {
+				continue
+			}
+			call, ok := a.Rhs[0].(*ast.CallExpr)
+			if ok && rootText(fs, call.Fun) == "make" && len(call.Args) == 2 && rootText(fs, call.Args[0]) == "[]float64" {
+				init = a
+			}
+		}
+		if init == nil {
+			continue
+		}
+		parents := vectorParents(owner)
+		valid := true
+		pos := fs.Position(ret.Pos())
+		plan := &savedVectorPlan{Field: id.Name, Receiver: receiverName(owner), ReturnLine: pos.Line, ReturnColumn: pos.Column, Local: true}
+		ast.Inspect(owner, func(n ast.Node) bool {
+			use, ok := n.(*ast.Ident)
+			if !ok || use.Name != id.Name {
+				return true
+			}
+			switch p := parents[use].(type) {
+			case *ast.SelectorExpr:
+				if p.Sel != use {
+					valid = false
+				}
+			case *ast.AssignStmt:
+				if p != init {
+					valid = false
+				}
+			case *ast.ReturnStmt:
+				if p != ret {
+					valid = false
+				}
+			case *ast.IndexExpr:
+				if p.X != use {
+					valid = false
+					break
+				}
+				if u, ok := parents[p].(*ast.UnaryExpr); ok && u.Op == token.AND {
+					valid = false
+				}
+				if _, ok := parents[p].(*ast.IncDecStmt); ok {
+					valid = false
+				}
+				if a, ok := parents[p].(*ast.AssignStmt); ok {
+					for _, lhs := range a.Lhs {
+						if lhs != p {
+							continue
+						}
+						if a.Tok != token.ASSIGN || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+							valid = false
+							break
+						}
+						at := fs.Position(a.Pos())
+						plan.Writes = append(plan.Writes, savedVectorWrite{File: c.relativeFile, Line: at.Line, Column: at.Column, Receiver: receiverName(owner)})
+					}
+				}
+			default:
+				valid = false
+			}
+			return true
+		})
+		if valid && len(plan.Writes) > 0 && len(plan.Writes) <= 16 {
+			c.savedVector = plan
+			c.template = opaqueTemplate("modifier_saved_vector_runtime_receipt")
+		}
+	}
+}
+
+func localVectorRefs(fs *token.FileSet, file *ast.File, entries []SourceEntry, at token.Pos, rt string) map[string]string {
+	refs := map[string]string{}
+	for _, e := range entries {
+		if e.savedVector == nil || !e.savedVector.Local {
+			continue
+		}
+		for _, d := range file.Decls {
+			fn, ok := d.(*ast.FuncDecl)
+			if !ok || fn.Pos() > at || fn.End() < at {
+				continue
+			}
+			line := fs.Position(fn.Pos()).Line
+			end := fs.Position(fn.End()).Line
+			if e.savedVector.ReturnLine < line || e.savedVector.ReturnLine > end {
+				continue
+			}
+			ast.Inspect(fn.Body, func(n ast.Node) bool {
+				if ix, ok := n.(*ast.IndexExpr); ok && rootText(fs, ix.X) == e.savedVector.Field {
+					// Index must be a pure official enum selector, not a repeated function.
+					if s, ok := ix.Index.(*ast.SelectorExpr); ok {
+						if p := sourceImportAliases(file)[rootText(fs, s.X)]; p == "github.com/genshinsim/gcsim/pkg/core/attributes" {
+							text := rootText(fs, ix)
+							refs[text] = fmt.Sprintf("%s.StatCellReference(&%s)", rt, text)
+						}
+					}
+				}
+				return true
+			})
+		}
+	}
+	return refs
+}
diff --git a/pkg/gttsourcegen/model.go b/pkg/gttsourcegen/model.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/model.go
@@ -0,0 +1,304 @@
+// Package gttsourcegen builds deterministic source identities and shallow
+// numeric slice templates for the GTT trace seams.
+package gttsourcegen
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+const (
+	ManifestSchemaVersion  = 1
+	BindingInputKind       = "gtt.source_manifest.binding_input"
+	ManifestBodyKind       = "gtt.source_manifest.body"
+	DefaultCompilerVersion = "gtt_source_compiler_v2"
+	IRVersion              = "gtt_source_ir_v2"
+	// IRSHA256 identifies the canonical V2 operator/seam contract. Its exact
+	// preimage is asserted in generator_test.go; changing either the supported
+	// operations or source seams therefore requires an explicit identity bump.
+	IRSHA256             = "8b8dfcb9cb97e2b06145638e47ba915a6016a11f956708d7de7ee826ae730792"
+	KindModifierAmount   = "modifier_amount"
+	KindEventCallback    = "event_callback"
+	KindTaskCallback     = "task_callback"
+	KindQueuedAttack     = "queued_attack"
+	KindHealthInput      = "health_input"
+	KindStateOperation   = "state_operation"
+	TemplateSupported    = "SUPPORTED"
+	TemplateOpaqueFrozen = "OPAQUE_FROZEN"
+)
+
+type PatchIdentity struct {
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+}
+
+type FormulaIdentity struct {
+	ID     string `json:"id"`
+	SHA256 string `json:"sha256"`
+}
+
+type GoToolchain struct {
+	Version string `json:"version"`
+	OS      string `json:"os"`
+	Arch    string `json:"arch"`
+}
+
+type BindingInput struct {
+	SchemaVersion            int               `json:"schema_version"`
+	Kind                     string            `json:"kind"`
+	UpstreamRepo             string            `json:"upstream_repo"`
+	UpstreamRef              string            `json:"upstream_ref"`
+	PristineSourceTreeSHA256 string            `json:"pristine_source_tree_sha256"`
+	Patches                  []PatchIdentity   `json:"patches"`
+	PatchStackSHA256         string            `json:"patch_stack_sha256"`
+	TraceSchemaVersion       int               `json:"trace_schema_version"`
+	TraceCapability          string            `json:"trace_capability"`
+	FormulaIdentities        []FormulaIdentity `json:"formula_identities"`
+	GoToolchain              GoToolchain       `json:"go_toolchain"`
+	BuildFlags               []string          `json:"build_flags"`
+}
+
+func (binding BindingInput) Validate() error {
+	if binding.SchemaVersion != ManifestSchemaVersion || binding.Kind != BindingInputKind {
+		return fmt.Errorf("binding input must have schema_version=1 and kind=%q", BindingInputKind)
+	}
+	if binding.UpstreamRepo == "" || binding.UpstreamRef == "" {
+		return errors.New("binding input upstream_repo and upstream_ref are required")
+	}
+	for label, value := range map[string]string{
+		"pristine_source_tree": binding.PristineSourceTreeSHA256,
+		"patch_stack":          binding.PatchStackSHA256,
+	} {
+		if err := validateSHA256(label, value); err != nil {
+			return err
+		}
+	}
+	for index, patch := range binding.Patches {
+		if patch.Path == "" {
+			return fmt.Errorf("patches[%d].path is required", index)
+		}
+		if err := validateSHA256(fmt.Sprintf("patches[%d]", index), patch.SHA256); err != nil {
+			return err
+		}
+	}
+	if binding.TraceSchemaVersion != 6 || binding.TraceCapability != "gtt_trace_equation_v6" {
+		return errors.New("binding input must select trace schema 6 and gtt_trace_equation_v6")
+	}
+	foundIR := false
+	for index, identity := range binding.FormulaIdentities {
+		if identity.ID == "" {
+			return fmt.Errorf("formula_identities[%d].id is required", index)
+		}
+		if err := validateSHA256(fmt.Sprintf("formula_identities[%d]", index), identity.SHA256); err != nil {
+			return err
+		}
+		if identity.ID == IRVersion {
+			if identity.SHA256 != IRSHA256 {
+				return fmt.Errorf("%s formula identity SHA-256 must be %s", IRVersion, IRSHA256)
+			}
+			foundIR = true
+		}
+	}
+	if !foundIR {
+		return fmt.Errorf("formula_identities must contain %q", IRVersion)
+	}
+	if binding.GoToolchain.Version == "" || binding.GoToolchain.OS == "" || binding.GoToolchain.Arch == "" {
+		return errors.New("go_toolchain version/os/arch are required")
+	}
+	if len(binding.BuildFlags) != 1 || binding.BuildFlags[0] != "-trimpath" {
+		return errors.New("build_flags must be exactly [\"-trimpath\"]")
+	}
+	return nil
+}
+
+func validateSHA256(label, value string) error {
+	if len(value) != sha256.Size*2 || value != strings.ToLower(value) {
+		return fmt.Errorf("%s SHA-256 must be 64 lowercase hexadecimal characters", label)
+	}
+	if _, err := hex.DecodeString(value); err != nil {
+		return fmt.Errorf("%s SHA-256: %w", label, err)
+	}
+	return nil
+}
+
+type SourceLocator struct {
+	ModulePath      string `json:"module_path"`
+	EnclosingSymbol string `json:"enclosing_symbol"`
+	Seam            string `json:"seam"`
+	Ordinal         int    `json:"ordinal"`
+}
+
+type TemplateNode struct {
+	NodeID        int      `json:"node_id"`
+	Operator      string   `json:"operator"`
+	InputNodeIDs  []int    `json:"input_node_ids"`
+	ConstantValue *float64 `json:"constant_value"`
+	ParameterKey  *string  `json:"parameter_key"`
+}
+
+type SliceTemplate struct {
+	Status               string         `json:"status"`
+	Nodes                []TemplateNode `json:"nodes"`
+	RootNodeID           *int           `json:"root_node_id"`
+	ParameterKeys        []string       `json:"parameter_keys"`
+	DependenciesComplete bool           `json:"dependencies_complete"`
+	StopReasonCode       *string        `json:"stop_reason_code"`
+	TemplateSHA256       string         `json:"template_sha256"`
+}
+
+type parameterPlan struct {
+	ParameterKey                string
+	Kind                        string
+	SourceExpression            string
+	ActorExpression             string
+	StatKey                     string
+	StatKeyExpression           string // build-local, proven attributes enum .String()
+	ReadMode                    string
+	CandidateDependencyComplete bool
+}
+
+// modifierOutputPlan is deliberately build-local. The canonical template
+// describes the numeric result while this plan tells the overlay which result
+// expression and stat-vector key must be evaluated exactly once.
+type modifierOutputPlan struct {
+	Expression          string
+	OutputKeyExpression string
+	GuardExpression     string
+	GuardActiveWhen     bool
+	InactiveIsNil       bool
+	StateFields         []string
+}
+
+type healthInputPlan struct {
+	ValueField string
+}
+
+type callbackPlan struct {
+	ResolvedMethodName string
+	ResolvedReceiver   string
+	ResolvedFile       string
+	ResolvedLine       int
+	ScopeKey           string
+	PayloadExpressions []string
+	NumericPayloads    []int
+	StateFields        []string
+	OrdinaryHelpers    []ordinaryHelperPlan
+}
+
+// ordinaryHelperPlan is build-local structural metadata. It deliberately
+// carries no game identity: a direct same-receiver call is resolved from the
+// parsed package and is limited to one ordinary method hop.
+type ordinaryHelperPlan struct {
+	CallFile            string
+	CallLine            int
+	CallColumn          int
+	MethodName          string
+	ReceiverExpression  string
+	ResolvedFile        string
+	ResolvedLine        int
+	ResolvedReceiver    string
+	ScopeKey            string
+	ParameterNames      []string
+	NumericParameters   []int
+	ArgumentExpressions []string
+}
+
+type stateOperationPlan struct {
+	ReceiverExpression string
+	FieldName          string
+	ValueExpression    string
+	AssignmentToken    string
+	ScopeKey           string
+	Numeric            bool
+	NumericFields      []string
+}
+
+// forwardedAttackPlan is build-local provenance for an AttackInfo value that
+// crosses a bounded same-receiver helper chain before QueueAttack. The source
+// ID must be attached at the construction site because runtime caller capture
+// would otherwise identify only the shared helper sink.
+type forwardedAttackPlan struct {
+	ArgumentIndex       int
+	ReadFrameExpression string
+	CallDepth           int
+}
+
+type SourceEntry struct {
+	SourceID         string        `json:"source_id"`
+	Locator          SourceLocator `json:"locator"`
+	SourceNodeSHA256 string        `json:"source_node_sha256"`
+	Template         SliceTemplate `json:"template"`
+
+	LookupKey          string               `json:"-"`
+	RelativeFile       string               `json:"-"`
+	Line               int                  `json:"-"`
+	Column             int                  `json:"-"`
+	parameterPlans     []parameterPlan      `json:"-"`
+	modifierOutput     *modifierOutputPlan  `json:"-"`
+	savedVector        *savedVectorPlan     `json:"-"`
+	capturedScalar     *capturedScalarPlan  `json:"-"`
+	healthInput        *healthInputPlan     `json:"-"`
+	callback           *callbackPlan        `json:"-"`
+	stateOperation     *stateOperationPlan  `json:"-"`
+	forwardedAttack    *forwardedAttackPlan `json:"-"`
+	flatHelper         *flatHelperPlan      `json:"-"`
+	traceRuntimePath   string               `json:"-"`
+	traceRuntimeReason string               `json:"-"`
+}
+
+type Manifest struct {
+	SchemaVersion            int               `json:"schema_version"`
+	Kind                     string            `json:"kind"`
+	CompilerVersion          string            `json:"compiler_version"`
+	UpstreamRepo             string            `json:"upstream_repo"`
+	UpstreamRef              string            `json:"upstream_ref"`
+	PristineSourceTreeSHA256 string            `json:"pristine_source_tree_sha256"`
+	Patches                  []PatchIdentity   `json:"patches"`
+	PatchStackSHA256         string            `json:"patch_stack_sha256"`
+	PatchedSourceTreeSHA256  string            `json:"patched_source_tree_sha256"`
+	TraceSchemaVersion       int               `json:"trace_schema_version"`
+	TraceCapability          string            `json:"trace_capability"`
+	FormulaIdentities        []FormulaIdentity `json:"formula_identities"`
+	GoToolchain              GoToolchain       `json:"go_toolchain"`
+	BuildFlags               []string          `json:"build_flags"`
+	Entries                  []SourceEntry     `json:"entries"`
+
+	ManifestBodySHA256 string `json:"-"`
+}
+
+type sliceTemplateHashBody struct {
+	SliceTemplateSchema  int            `json:"slice_template_schema"`
+	Status               string         `json:"status"`
+	Nodes                []TemplateNode `json:"nodes"`
+	RootNodeID           *int           `json:"root_node_id"`
+	ParameterKeys        []string       `json:"parameter_keys"`
+	DependenciesComplete bool           `json:"dependencies_complete"`
+	StopReasonCode       *string        `json:"stop_reason_code"`
+}
+
+func templateHashBody(template SliceTemplate) sliceTemplateHashBody {
+	return sliceTemplateHashBody{
+		SliceTemplateSchema: 1, Status: template.Status, Nodes: template.Nodes,
+		RootNodeID: template.RootNodeID, ParameterKeys: template.ParameterKeys,
+		DependenciesComplete: template.DependenciesComplete,
+		StopReasonCode:       template.StopReasonCode,
+	}
+}
+
+func sortStringsUnique(values []string) []string {
+	if len(values) == 0 {
+		return []string{}
+	}
+	sort.Strings(values)
+	out := values[:0]
+	for _, value := range values {
+		if len(out) == 0 || out[len(out)-1] != value {
+			out = append(out, value)
+		}
+	}
+	return out
+}
diff --git a/pkg/gttsourcegen/mutable_binding_test.go b/pkg/gttsourcegen/mutable_binding_test.go
new file mode 100644
