+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"testing"
+)
+
+func TestAttackFieldOrderedCompositionAndForeignOwner(t *testing.T) {
+	b := &nodeBuilder{}
+	c := &directCompiler{b: b, unknown: map[string]struct{}{}, support: supportProgram{eventNodes: map[string]compiledNode{}}}
+	c.support.eventNodes["foreign"] = b.add(b.constant(5), b.artifactDelta("provider", "em"))
+	c.support.eventNodes["factor"] = b.constant(2)
+	a := info.GTTTraceCallbackAttempt{FlatDmgDelta: 20, NumericWrites: []info.GTTNumericFieldWrite{
+		{Field: "FlatDmg", Operation: "add", Order: 0, Before: 10, After: 15, Operand: 5, Reference: gtttrace.EventRef("foreign")},
+		{Field: "FlatDmg", Operation: "multiply", Order: 1, Before: 15, After: 30, Operand: 2, Reference: gtttrace.EventRef("factor")},
+	}}
+	hit := info.GTTTraceHit{CallbackAttempts: []info.GTTTraceCallbackAttempt{a}}
+	original := b.add(b.constant(10), b.artifactDelta("trigger", "em"))
+	got := c.compileAttackField(hit, "FlatDmg", original, 30)
+	if got.baseline != 30 || len(got.coords) != 2 {
+		t.Fatalf("lost producer/provider: %+v", got)
+	}
+	hit.CallbackAttempts[0].NumericWrites[1].Operation = "assign"
+	hit.CallbackAttempts[0].NumericWrites[1].After = 2
+	hit.CallbackAttempts[0].FlatDmgDelta = -8
+	got = c.compileAttackField(hit, "FlatDmg", original, 2)
+	if got.baseline != 2 || len(got.coords) != 0 {
+		t.Fatal("overwrite must remove prior dependencies")
+	}
+	hit.CallbackAttempts[0].NumericWrites = nil
+	got = c.compileAttackField(hit, "FlatDmg", original, 2)
+	if got.baseline != 2 || len(got.coords) != 0 {
+		t.Fatal("unobserved write must freeze")
+	}
+}
diff --git a/pkg/gttcompact/builder.go b/pkg/gttcompact/builder.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/builder.go
@@ -0,0 +1,175 @@
+package gttcompact
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type compiledNode struct {
+	id       uint32
+	baseline float64
+	coords   map[string]struct{}
+}
+
+type nodeBuilder struct {
+	nodes            []IRNode
+	resistanceInputs []ResistanceInput
+}
+
+func decimal(value float64) string {
+	if value == 0 {
+		return "0"
+	}
+	return strconv.FormatFloat(value, 'f', -1, 64)
+}
+
+func (b *nodeBuilder) constant(value float64) compiledNode {
+	return b.append(IRNode{Operation: "constant", Inputs: []IRInput{}, Value: decimal(value)}, value, nil)
+}
+
+func (b *nodeBuilder) opaque(value float64) compiledNode {
+	return b.append(IRNode{Operation: "opaque_frozen", Inputs: []IRInput{}, Value: decimal(value)}, value, nil)
+}
+
+func (b *nodeBuilder) artifactDelta(actorKey, statKey string) compiledNode {
+	coordinate := normalizeCoordinate(actorKey, statKey)
+	return b.append(IRNode{Operation: "artifact_stat", Inputs: []IRInput{}, Coordinate: coordinate}, 0, map[string]struct{}{coordinate: {}})
+}
+
+func (b *nodeBuilder) add(values ...compiledNode) compiledNode {
+	return b.commutative("add", 0, values...)
+}
+
+func (b *nodeBuilder) multiply(values ...compiledNode) compiledNode {
+	return b.commutative("multiply", 1, values...)
+}
+
+func (b *nodeBuilder) min(values ...compiledNode) compiledNode {
+	return b.commutative("min", math.Inf(1), values...)
+}
+
+func (b *nodeBuilder) max(values ...compiledNode) compiledNode {
+	return b.commutative("max", math.Inf(-1), values...)
+}
+
+// Pure numeric branch only. Input order is semantic, not commutative. Both
+// value expressions must be total/side-effect-free as proven by the source slice.
+func (b *nodeBuilder) selectLT(left, right, yes, no compiledNode) compiledNode {
+	baseline := no.baseline
+	if left.baseline < right.baseline {
+		baseline = yes.baseline
+	}
+	coords := map[string]struct{}{}
+	values := []compiledNode{left, right, yes, no}
+	inputs := make([]IRInput, 4)
+	for i, v := range values {
+		inputs[i] = IRInput{NodeID: v.id, Relation: fmt.Sprintf("input/%06d", i)}
+		for k := range v.coords {
+			coords[k] = struct{}{}
+		}
+	}
+	return b.append(IRNode{Operation: "select_lt", Inputs: inputs}, baseline, coords)
+}
+
+func (b *nodeBuilder) subtract(left, right compiledNode) compiledNode {
+	return b.add(left, b.multiply(b.constant(-1), right))
+}
+
+func (b *nodeBuilder) divide(left, right compiledNode) compiledNode {
+	inverse := b.append(
+		IRNode{Operation: "power", Inputs: []IRInput{{NodeID: right.id, Relation: "base"}, {NodeID: b.constant(-1).id, Relation: "exponent"}}},
+		math.Pow(right.baseline, -1), right.coords,
+	)
+	return b.multiply(left, inverse)
+}
+
+func (b *nodeBuilder) commutative(operation string, identity float64, values ...compiledNode) compiledNode {
+	if len(values) == 0 {
+		return b.constant(identity)
+	}
+	if len(values) == 1 {
+		return values[0]
+	}
+	inputs := make([]IRInput, len(values))
+	coords := make(map[string]struct{})
+	baseline := identity
+	for index, value := range values {
+		inputs[index] = IRInput{NodeID: value.id, Relation: fmt.Sprintf("input/%06d", index)}
+		for coordinate := range value.coords {
+			coords[coordinate] = struct{}{}
+		}
+		switch operation {
+		case "add":
+			baseline += value.baseline
+		case "multiply":
+			baseline *= value.baseline
+		case "min":
+			baseline = math.Min(baseline, value.baseline)
+		case "max":
+			baseline = math.Max(baseline, value.baseline)
+		}
+	}
+	sort.Slice(inputs, func(i, j int) bool { return inputs[i].NodeID < inputs[j].NodeID })
+	for index := range inputs {
+		inputs[index].Relation = fmt.Sprintf("input/%06d", index)
+	}
+	return b.append(IRNode{Operation: operation, Inputs: inputs}, baseline, coords)
+}
+
+func (b *nodeBuilder) append(node IRNode, baseline float64, coords map[string]struct{}) compiledNode {
+	node.NodeID = uint32(len(b.nodes) + 1)
+	if node.Inputs == nil {
+		node.Inputs = []IRInput{}
+	}
+	b.nodes = append(b.nodes, node)
+	return compiledNode{id: node.NodeID, baseline: baseline, coords: cloneCoords(coords)}
+}
+
+func cloneCoords(values map[string]struct{}) map[string]struct{} {
+	out := make(map[string]struct{}, len(values))
+	for value := range values {
+		out[value] = struct{}{}
+	}
+	return out
+}
+
+func sortedCoords(values map[string]struct{}) []string {
+	out := make([]string, 0, len(values))
+	for value := range values {
+		out = append(out, value)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func normalizeCoordinate(actorKey, statKey string) string {
+	replacer := strings.NewReplacer(
+		"%", "_percent", " ", "_", "+", "_plus_", "'", "", "(", "_", ")", "_",
+	)
+	actor := strings.Trim(replacer.Replace(strings.ToLower(actorKey)), "_")
+	stat := strings.Trim(replacer.Replace(strings.ToLower(statKey)), "_")
+	aliases := map[string]string{
+		"cr": "crit_rate", "cd": "crit_damage", "dmg_percent": "damage_bonus",
+		"er": "energy_recharge", "phys_percent": "physical_damage_bonus",
+		"heal": "healing_bonus", "atk_percent": "atk_percent", "hp_percent": "hp_percent", "def_percent": "def_percent",
+	}
+	if alias, ok := aliases[stat]; ok {
+		stat = alias
+	}
+	if strings.HasSuffix(stat, "_percent") && stat != "atk_percent" && stat != "hp_percent" && stat != "def_percent" {
+		stat = strings.TrimSuffix(stat, "_percent") + "_damage_bonus"
+	}
+	return actor + "." + stat
+}
+
+func hashJSON(value any) string {
+	payload, _ := json.Marshal(value)
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:])
+}
diff --git a/pkg/gttcompact/compile.go b/pkg/gttcompact/compile.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/compile.go
@@ -0,0 +1,100 @@
+package gttcompact
+
+import (
+	"fmt"
+	"math"
+	"runtime"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func CompileSeedMember(buffer optstats.GTTTraceEquationBuffer, characterKeys []string) (IRSeedMember, Audit, error) {
+	started := time.Now()
+	var startMemory, checkpointMemory, endMemory runtime.MemStats
+	runtime.ReadMemStats(&startMemory)
+	peakHeap := startMemory.HeapInuse
+	if buffer.Seed <= 0 || buffer.DurationFrames <= 0 || len(buffer.Hits) == 0 {
+		return IRSeedMember{}, Audit{}, fmt.Errorf("compact adapter requires one positive-seed executed trace")
+	}
+	if len(characterKeys) == 0 {
+		return IRSeedMember{}, Audit{}, fmt.Errorf("compact adapter requires character keys")
+	}
+	builder := &nodeBuilder{nodes: make([]IRNode, 0, len(buffer.Hits)*32)}
+	support := compileSupportProgram(builder, buffer, characterKeys)
+	runtime.ReadMemStats(&checkpointMemory)
+	if checkpointMemory.HeapInuse > peakHeap {
+		peakHeap = checkpointMemory.HeapInuse
+	}
+	channels, unknown, baseline := compileChannels(builder, buffer, characterKeys, support)
+	runtime.ReadMemStats(&checkpointMemory)
+	if checkpointMemory.HeapInuse > peakHeap {
+		peakHeap = checkpointMemory.HeapInuse
+	}
+	if math.IsNaN(baseline) || math.IsInf(baseline, 0) || baseline < 0 {
+		return IRSeedMember{}, Audit{}, fmt.Errorf("compact adapter produced invalid baseline")
+	}
+	reasons := sortedUnknown(unknown)
+	boundaries := make([]IROpaqueBoundary, 0, len(reasons))
+	for index, reason := range reasons {
+		node := builder.opaque(0)
+		boundaries = append(boundaries, IROpaqueBoundary{
+			BoundaryID: fmt.Sprintf("opaque/%06d", index+1), NodeID: node.id,
+			ReasonCode: normalizeReason(reason), BaselineDamage: decimal(baseline),
+			BaselineDamageShare: func() string {
+				if baseline == 0 {
+					return "0"
+				}
+				return "1"
+			}(),
+		})
+	}
+	sort.Slice(channels, func(i, j int) bool { return channels[i].ChannelID < channels[j].ChannelID })
+	topology := hashJSON(struct {
+		Seed           int64 `json:"seed"`
+		DurationFrames int   `json:"duration_frames"`
+		Topology       any   `json:"topology"`
+		Guard          any   `json:"guard"`
+	}{buffer.Seed, buffer.DurationFrames, buffer.TopologyEvents, buffer.GuardSummary()})
+	member := IRSeedMember{
+		Seed: uint64(buffer.Seed), DurationMS: int64(math.Round(float64(buffer.DurationFrames) * 1000 / 60)),
+		TopologySHA256: topology, Nodes: builder.nodes, Channels: channels, OpaqueBoundaries: boundaries,
+	}
+	resistanceInputs := builder.usedResistanceInputs(channels)
+	audit := Audit{
+		ResistanceInputs: resistanceInputs,
+		EffectInputs:     collectEffectInputs(buffer, characterKeys, support),
+		SourceHitCount:   len(buffer.Hits), AncestorStateEventCount: len(support.ancestorIDs),
+		NodeCount: len(builder.nodes), ChannelCount: len(channels), OpaqueReasonCount: len(reasons),
+		BaselineDamage: baseline,
+	}
+	runtime.ReadMemStats(&endMemory)
+	if endMemory.HeapInuse > peakHeap {
+		peakHeap = endMemory.HeapInuse
+	}
+	audit.AdapterElapsedNS = time.Since(started).Nanoseconds()
+	audit.HeapInuseStartBytes = startMemory.HeapInuse
+	audit.HeapInusePeakBytes = peakHeap
+	audit.HeapInuseEndBytes = endMemory.HeapInuse
+	audit.TotalAllocDeltaBytes = endMemory.TotalAlloc - startMemory.TotalAlloc
+	return member, audit, nil
+}
+
+func normalizeReason(value string) string {
+	value = strings.ToLower(value)
+	var out strings.Builder
+	for _, char := range value {
+		if (char >= 'a' && char <= 'z') || (char >= '0' && char <= '9') || char == '_' || char == '-' {
+			out.WriteRune(char)
+		} else {
+			out.WriteByte('_')
+		}
+	}
+	result := strings.Trim(out.String(), "_")
+	if result == "" {
+		return "unknown_compact_boundary"
+	}
+	return result
+}
