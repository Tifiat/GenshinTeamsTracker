+func findEntry(t *testing.T, manifest Manifest, seam, symbol string) SourceEntry {
+	t.Helper()
+	for _, entry := range manifest.Entries {
+		if entry.Locator.Seam == seam && entry.Locator.EnclosingSymbol == symbol {
+			return entry
+		}
+	}
+	t.Fatalf("entry %s %s not found", seam, symbol)
+	return SourceEntry{}
+}
