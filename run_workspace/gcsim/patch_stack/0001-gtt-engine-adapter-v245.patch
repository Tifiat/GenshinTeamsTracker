+package gtttrace
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestProviderKnownDistinguishesOwnerZeroFromUnknown(t *testing.T) {
+	known := NewProvider("set", "scroll", 0, 4)
+	if !known.Complete() {
+		t.Fatal("known provider for owner zero must be complete")
+	}
+	unknown := UnknownProvider("unattributed_modifier", "scroll-buff")
+	if unknown.Complete() {
+		t.Fatal("unknown provider must remain incomplete")
+	}
+}
+
+func TestRuntimeRestoresNestedProvider(t *testing.T) {
+	runtime := NewRuntime()
+	runtime.Enable()
+	outer := NewProvider("character", "furina", 0, 0)
+	inner := NewProvider("set", "goldentroupe", 0, 4)
+	restoreOuter := runtime.Enter(outer)
+	restoreInner := runtime.Enter(inner)
+	if got := runtime.Current(); got != inner {
+		t.Fatalf("current provider = %#v, want %#v", got, inner)
+	}
+	restoreInner()
+	if got := runtime.Current(); got != outer {
+		t.Fatalf("restored provider = %#v, want %#v", got, outer)
+	}
+	restoreOuter()
+	if runtime.Current().Known {
+		t.Fatal("provider stack must be empty after restoring outer scope")
+	}
+}
+
+func TestModifierTransitionReceiptUsesCanonicalOrder(t *testing.T) {
+	runtime := NewRuntime()
+	runtime.Enable()
+	provider := NewProvider("set", "scroll", 2, 4)
+	runtime.RecordModifierTransition(ModifierTransition{
+		Frame: 10, Channel: "stat", RecipientIndex: 2,
+		ModifierKey: "z", Transition: "activation", Provider: provider,
+	})
+	runtime.RecordModifierTransition(ModifierTransition{
+		Frame: 5, Channel: "stat", RecipientIndex: 2,
+		ModifierKey: "a", Transition: "activation", Provider: provider,
+	})
+	rows := runtime.ModifierTransitions()
+	if len(rows) != 2 || rows[0].Frame != 5 || rows[1].Frame != 10 {
+		t.Fatalf("non-canonical transition order: %#v", rows)
+	}
+}
+
+func TestHelperNumericArgumentsAreNestedAndFailOpen(t *testing.T) {
+	runtime := NewRuntime()
+	runtime.Enable()
+	outerEvent := runtime.RecordNumericEval(
+		testSourceID, "source_expression", []NumericRef{LiteralRef(12.5)}, 12.5,
+		IncompleteEvidence("test_source_incomplete"),
+	)
+	restoreOuter := runtime.EnterHelperNumericArguments([]NumericPayload{{
+		Key: "arg:0", Value: 12.5, Reference: EventRef(outerEvent),
+	}})
+	outer := runtime.CurrentHelperNumericRef("arg:0", 12.5)
+	if outer.EventID == nil || *outer.EventID != outerEvent {
+		t.Fatalf("outer helper reference = %#v", outer)
+	}
+	restoreInner := runtime.EnterHelperNumericArguments([]NumericPayload{{
+		Key: "arg:0", Value: 7, Reference: LiteralRef(7),
+	}})
+	inner := runtime.CurrentHelperNumericRef("arg:0", 7)
+	if inner.LiteralValue == nil || *inner.LiteralValue != 7 {
+		t.Fatalf("inner helper reference = %#v", inner)
+	}
+	restoreInner()
+	restored := runtime.CurrentHelperNumericRef("arg:0", 12.5)
+	if restored.EventID == nil || *restored.EventID != outerEvent {
+		t.Fatalf("restored helper reference = %#v", restored)
+	}
+	mismatch := runtime.CurrentHelperNumericRef("arg:0", 99)
+	if mismatch.LiteralValue == nil || *mismatch.LiteralValue != 99 {
+		t.Fatalf("mismatched helper reference must fail open: %#v", mismatch)
+	}
+	restoreOuter()
+}
+
+func TestTaskNumericArgumentsRemainAvailableOnlyDuringExecution(t *testing.T) {
+	runtime := NewRuntime()
+	runtime.Enable()
+	frame := 12
+	runtime.BindFrame(&frame)
+	eventID := runtime.RecordNumericEval(
+		testSourceID, "source_expression", []NumericRef{LiteralRef(3.5)}, 3.5,
+		IncompleteEvidence("test_source_incomplete"),
+	)
+	payload := []NumericPayload{{
+		Key: "arg:0", Value: 3.5, Reference: EventRef(eventID),
+	}}
+	provider := NewProvider("character", "fixture", 0, 0)
+	callID := runtime.BeginTaskExecution(
+		"task:1", "task-queue:1", 0, 10, 2, 12, 12,
+		testSourceID, "", provider, payload,
+	)
+	current := runtime.CurrentTaskNumericRef("arg:0", 3.5)
+	if current.EventID == nil || *current.EventID != eventID {
+		t.Fatalf("task reference = %#v", current)
+	}
+	transitionID := runtime.RecordNumericEval(
+		testSourceID, "state_transition", []NumericRef{current}, 7,
+		IncompleteEvidence("test_task_transition_incomplete"),
+	)
+	runtime.UpdateTaskNumericArgument("arg:0", 7, EventRef(transitionID))
+	updated := runtime.CurrentTaskNumericRef("arg:0", 7)
+	if updated.EventID == nil || *updated.EventID != transitionID {
+		t.Fatalf("updated task reference = %#v", updated)
+	}
+	runtime.CompleteTaskExecution(
+		callID, "task:1", "task-queue:1", 0, 10, 2, 12, 12,
+		testSourceID, "", provider, payload,
+	)
+	after := runtime.CurrentTaskNumericRef("arg:0", 3.5)
+	if after.LiteralValue == nil || *after.LiteralValue != 3.5 {
+		t.Fatalf("completed task must not leak numeric context: %#v", after)
+	}
+}
+
+func TestCurrentHealthChangePercentRefsMatchOnlyActiveNormalizedChange(t *testing.T) {
+	runtime := NewRuntime()
+	runtime.Enable()
+	frame := 12
+	runtime.BindFrame(&frame)
+	sequence, operationID := runtime.BeginHealthOperation()
+	runtime.CompleteHealthOperation(sequence, HealthOperation{
+		Kind: HealthOperationHeal, Frame: frame, TargetIndex: 0,
+		EventEffectiveAmount: 240, MaxHPAfter: 15000,
+		UncertaintyCodes: []string{"test_health_incomplete"},
+	})
+	restore := runtime.EnterHealthOperation(operationID)
+	refs := runtime.CurrentHealthChangePercentRefs(1.6)
+	if len(refs) != 3 || refs[0].HealthOperationID == nil || *refs[0].HealthOperationID != operationID ||
+		refs[0].FieldKey == nil || *refs[0].FieldKey != "event_effective_amount" ||
+		refs[1].FieldKey == nil || *refs[1].FieldKey != "max_hp_after" {
+		t.Fatalf("health change refs = %#v", refs)
+	}
+	eventID := runtime.RecordCurrentHealthChangePercentEval(
+		testSourceID, 1.6, IncompleteEvidence("test_health_percent_incomplete"),
+	)
+	events := runtime.StateEvents()
+	if len(events) < 2 || eventID != events[len(events)-1].EventID ||
+		events[len(events)-2].Operation == nil || *events[len(events)-2].Operation != "divide" ||
+		events[len(events)-1].Operation == nil || *events[len(events)-1].Operation != "multiply" {
+		t.Fatalf("health change executable events = %#v", events)
+	}
+	mismatch := runtime.CurrentHealthChangePercentRefs(9.9)
+	if len(mismatch) != 1 || mismatch[0].LiteralValue == nil || *mismatch[0].LiteralValue != 9.9 {
+		t.Fatalf("mismatched health change must fail open: %#v", mismatch)
+	}
+	restore()
+	after := runtime.CurrentHealthChangePercentRefs(1.6)
+	if len(after) != 1 || after[0].LiteralValue == nil || *after[0].LiteralValue != 1.6 {
+		t.Fatalf("health context must not leak: %#v", after)
+	}
+}
+
+func TestStateEventOnlyInheritsMatchingSourceOccurrence(t *testing.T) {
+	runtime := NewRuntime()
+	runtime.Enable()
+	frame := 12
+	runtime.BindFrame(&frame)
+	provider := NewProvider("character", "fixture", 0, 0)
+	occurrenceID := runtime.RecordSourceOccurrence("event_callback", testSourceID, frame, provider, "")
+	restore := runtime.EnterSourceOccurrence(provider, testSourceID, occurrenceID, "")
+	defer restore()
+
+	runtime.RecordNumericEval(
+		testSourceID, "matching", []NumericRef{LiteralRef(1)}, 1,
+		IncompleteEvidence("matching_test_incomplete"),
+	)
+	otherSourceID := strings.Repeat("f", 64)
+	runtime.RecordNumericEval(
+		otherSourceID, "nested_state_operation", []NumericRef{LiteralRef(2)}, 2,
+		IncompleteEvidence("nested_test_incomplete"),
+	)
+	rows := runtime.StateEvents()
+	if len(rows) != 2 || rows[0].SourceOccurrenceID == nil || *rows[0].SourceOccurrenceID != occurrenceID {
+		t.Fatalf("matching source occurrence was not retained: %#v", rows)
+	}
+	if rows[1].SourceOccurrenceID != nil || rows[1].SourceID == nil || *rows[1].SourceID != otherSourceID {
+		t.Fatalf("cross-source occurrence must remain absent: %#v", rows[1])
+	}
+}
