+	receipt.ReactionBonusContributions = append(
+		[]info.GTTTraceReactionBonusContribution(nil),
+		receipt.ReactionBonusContributions...,
+	)
+	snap.GTTReactionFormula = &receipt
+	return snap
 }
+
+func CalcCatalyzeDmg(lvl int, src reactionBonusSrc, atk info.AttackInfo, em float64, captures ...*info.GTTNumericCapture) float64 {
+	var bonus float64
+	if len(captures) == 1 && captures[0] != nil {
+		bonus = src.ReactBonusWithTrace(atk, &captures[0].Hit)
+	} else {
+		bonus = src.ReactBonus(atk)
+	}
+	levelBase := CalcReactionBaseDmg(lvl)
+	value := (1 + ((5 * em) / (1200 + em)) + bonus) * levelBase
+	if len(captures) == 1 && captures[0] != nil {
+		capture := captures[0]
+		info.GTTTraceCaptureNumeric(&capture.Hit, value,
+			info.GTTNumericInput{Kind: "reference", Value: em, Reference: capture.InputReference},
+			info.GTTNumericInput{Kind: "reference", Value: bonus, Reference: capture.Hit.ReactionBonusRef},
+			info.GTTNumericInput{Kind: "fixed", Value: levelBase})
+	}
+	return value
+}
