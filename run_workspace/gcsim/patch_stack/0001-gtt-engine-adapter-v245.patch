+func (c *CharWrapper) gttPrepareModifier(
+	channel string,
+	mod modifier.Mod,
+	sourceID string,
+) (gtttrace.Provider, *gtttrace.Provider, *string) {
+	provider := c.gttTrace.Current()
+	if !provider.Complete() {
+		provider = gtttrace.UnknownProvider("unattributed_modifier", mod.Key())
+	}
+	mod.SetGTTSource(provider)
+	mod.SetGTTSourceID(sourceID)
+	index := modifier.Find(&c.mods, mod.Key())
+	if index < 0 {
+		return provider, nil, nil
+	}
+	old := c.mods[index]
+	if old.Expiry() != -1 && old.Expiry() <= *c.f {
+		return provider, nil, nil
+	}
+	displaced := old.GTTSource()
+	displacedSourceID := old.GTTSourceID()
+	return provider, &displaced, &displacedSourceID
+}
+
+func (c *CharWrapper) gttRecordModifier(
+	channel string,
+	key string,
+	sourceID string,
+	provider gtttrace.Provider,
+	displacedSourceID *string,
+	displaced *gtttrace.Provider,
+	overwrote bool,
+) {
+	transition := "activation"
+	if overwrote {
+		transition = "replacement_refresh"
+	}
+	c.gttTrace.RecordModifierTransition(gtttrace.ModifierTransition{
+		Frame: *c.f, Channel: channel, RecipientIndex: c.Index(),
+		ModifierKey: key, Transition: transition, SourceID: sourceID, Provider: provider,
+		DisplacedSourceID: displacedSourceID, DisplacedProvider: displaced,
+	})
