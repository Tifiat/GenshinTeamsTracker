+
+func (e *Enemy) gttTraceBeginHit(atk *info.AttackEvent, grpMult float64) {
+	if atk.GTTTraceContext == nil {
+		return
+	}
+	atk.GTTTraceHit = &info.GTTTraceHit{
+		FlatProducer:               atk.Info.GTTFlatProducer,
+		ContributorGroup:           atk.Info.GTTContributorGroup,
+		NumericFieldWrites:         append([]info.GTTNumericFieldWrite(nil), atk.GTTNumericFieldWrites...),
+		AttackID:                   atk.GTTTraceContext.AttackID,
+		Frame:                      e.Core.F,
+		SourceFrame:                atk.SourceFrame,
+		SnapshotFrame:              atk.Snapshot.SourceFrame,
+		ActorIndex:                 atk.Info.ActorIndex,
+		DamageSrc:                  int(atk.Info.DamageSrc),
+		Ability:                    atk.Info.Abil,
+		AttackTag:                  int(atk.Info.AttackTag),
+		Element:                    atk.Info.Element.String(),
+		TargetKey:                  int(e.Key()),
+		TargetType:                 int(e.Type()),
+		TargetLevel:                e.Level,
+		ReactionOperatorID:         "none",
+		DamageGroupMultiplier:      grpMult,
+		DamageMode:                 e.Core.Flags.DamageMode,
+		HPCapActive:                e.Core.Flags.DamageMode,
+		Provider:                   atk.GTTTraceProvider,
+		SourceID:                   atk.GTTTraceSourceID,
+		SourceOccurrenceID:         atk.GTTTraceSourceOccurrenceID,
+		SnapshotStats:              make(map[string]float64),
+		StatContributions:          append(make([]info.GTTTraceStatContribution, 0, len(atk.Snapshot.GTTStatContributions)), atk.Snapshot.GTTStatContributions...),
+		CallbackAttempts:           append(make([]info.GTTTraceCallbackAttempt, 0, len(atk.GTTTraceCallbackAttempts)), atk.GTTTraceCallbackAttempts...),
+		TargetModContributions:     make([]info.GTTTraceTargetModContribution, 0),
+		ReactionBonusContributions: make([]info.GTTTraceReactionBonusContribution, 0),
+		AttackMods:                 make([]info.GTTTraceAttackModAttempt, 0),
+		AuraBefore:                 make([]info.GTTTraceAuraRow, 0),
+		AuraAfterReaction:          make([]info.GTTTraceAuraRow, 0),
+		AuraAfterAttachment:        make([]info.GTTTraceAuraRow, 0),
+		Unsupported:                make([]string, 0),
+		Completeness: info.GTTTraceCompleteness{
+			FormulaComplete:             false,
+			FlatDmgProvenanceComplete:   true,
+			AttackModProvenanceComplete: true,
+			ReactionTopologyComplete:    true,
+			ProviderIdentityComplete:    atk.GTTTraceProvider.Complete(),
+		},
+	}
+	gttTraceBindReactionFormula(atk)
+	if !atk.GTTTraceProvider.Complete() {
+		atk.GTTTraceHit.AddUnsupported("attack_provider_unattributed")
+	}
+	if len(atk.GTTTraceCallbackAttempts) > 0 {
+		atk.GTTTraceHit.AddUnsupported("untyped_callback_state_effects_unmodeled")
+	}
+	if len(atk.Callbacks) > 0 {
+		atk.GTTTraceHit.AddUnsupported("post_damage_callback_state_effects_unmodeled")
+	}
+	for _, row := range atk.Snapshot.GTTStatContributions {
+		if !row.Provider.Complete() {
+			atk.GTTTraceHit.Completeness.ProviderIdentityComplete = false
+			atk.GTTTraceHit.AddUnsupported("stat_mod_provider_unattributed")
+		}
+	}
+	if len(atk.Snapshot.GTTStatContributions) > 0 {
+		atk.GTTTraceHit.AddUnsupported("stat_mod_dependency_expression_collapsed")
+	}
+	for _, row := range atk.GTTTraceCallbackAttempts {
+		if !row.Provider.Complete() {
+			atk.GTTTraceHit.Completeness.ProviderIdentityComplete = false
+			atk.GTTTraceHit.AddUnsupported("callback_provider_unattributed")
+		}
+		if row.TopologyChanged {
+			atk.GTTTraceHit.Completeness.ReactionTopologyComplete = false
+			atk.GTTTraceHit.AddUnsupported("callback_changed_attack_topology")
+		}
+	}
+}
+
+func (e *Enemy) gttTraceCaptureAttackInput(atk *info.AttackEvent) {
+	trace := atk.GTTTraceHit
+	if trace == nil {
+		return
+	}
+	trace.ActorIndex = atk.Info.ActorIndex
+	trace.DamageSrc = int(atk.Info.DamageSrc)
+	trace.Ability = atk.Info.Abil
+	trace.AttackTag = int(atk.Info.AttackTag)
+	trace.Element = atk.Info.Element.String()
+	trace.Mult = atk.Info.Mult
+	trace.FlatDmg = atk.Info.FlatDmg
+	trace.UseDef = atk.Info.UseDef
+	trace.UseHP = atk.Info.UseHP
+	trace.UseEM = atk.Info.UseEM
+	trace.BaseDmgBonus = atk.Info.BaseDmgBonus
+	trace.Elevation = atk.Info.Elevation
+	trace.IgnoreDefPercent = atk.Info.IgnoreDefPercent
+	trace.Amped = atk.Info.Amped
+	trace.AmpMult = atk.Info.AmpMult
+	trace.AmpType = string(atk.Info.AmpType)
+	trace.Catalyzed = atk.Info.Catalyzed
+	trace.ICDTag = int(atk.Info.ICDTag)
+	trace.ICDGroup = int(atk.Info.ICDGroup)
+	trace.CharLevel = atk.Snapshot.CharLvl
+	trace.HitWeakPoint = atk.Info.HitWeakPoint
+	trace.SnapshotStats = make(map[string]float64)
+	for stat := attributes.Stat(0); stat < attributes.EndStatType; stat++ {
+		name := stat.String()
+		if name != "" {
+			trace.SnapshotStats[name] = atk.Snapshot.Stats[stat]
+		}
+	}
+	trace.ReactionOperatorID = gttTraceReactionOperatorID(atk)
+	transformativeFormulaComplete := gttTraceTransformativeFormulaComplete(atk)
+	if trace.ReactionFormula != nil && !transformativeFormulaComplete {
+		trace.AddUnsupported("transformative_reaction_formula_mismatch")
+	}
+	trace.Completeness.FlatDmgProvenanceComplete = atk.Info.FlatDmg == 0 || transformativeFormulaComplete
+	trace.Completeness.AttackModProvenanceComplete = len(trace.AttackMods) == 0
+	trace.AddUnsupported("multiplier_source_expression_not_instrumented")
+	if atk.Info.FlatDmg != 0 && !transformativeFormulaComplete {
+		trace.AddUnsupported("flat_dmg_expression_collapsed")
+	}
+	if len(trace.AttackMods) > 0 {
+		trace.AddUnsupported("attack_mod_closure_expression_collapsed")
+	}
+}
+
+// Record the calculation branch actually taken by GCSIM. The damage-bonus
+// flag comes from that executed branch, not a second list of attack tags.
+func gttTraceCalculationPath(atk *info.AttackEvent, kind string, damageBonusApplied bool) {
+	trace := atk.GTTTraceHit
+	if trace == nil {
+		return
+	}
+	trace.FormulaKind = kind
+	if kind == info.GTTTraceFormulaDirectReaction {
+		trace.ReactionOperatorID = "opaque_custom"
+	} else if !damageBonusApplied && trace.ReactionOperatorID == "none" {
+		// Flat non-stat damage without a producer receipt has no proven artifact
+		// dependency. Preserve the hit, but do not invent normal talent scaling.
+		trace.ReactionOperatorID = "opaque_custom"
+		if trace.ContributorGroup == nil || trace.ContributorGroup.Version != info.GTTContributorGroupVersion {
+			trace.AddUnsupported("nonstat_formula_provenance_missing")
+		}
+	}
+}
+
+func gttTraceBindReactionFormula(atk *info.AttackEvent) {
+	trace := atk.GTTTraceHit
+	if trace == nil || atk.Snapshot.GTTReactionFormula == nil {
+		return
+	}
+	receipt := *atk.Snapshot.GTTReactionFormula
+	receipt.ReactionBonusContributions = append(
+		make([]info.GTTTraceReactionBonusContribution, 0, len(receipt.ReactionBonusContributions)),
+		receipt.ReactionBonusContributions...,
+	)
+	receipt.AuraSourceIndices = append(
+		make([]int, 0, len(receipt.AuraSourceIndices)),
+		receipt.AuraSourceIndices...,
+	)
+	receipt.ParentAttackID = gttTraceCopyPointer(receipt.ParentAttackID)
+	receipt.ParentTargetKey = gttTraceCopyPointer(receipt.ParentTargetKey)
+	receipt.PersistentStateID = gttTraceCopyPointer(receipt.PersistentStateID)
+	receipt.PersistentRevision = gttTraceCopyPointer(receipt.PersistentRevision)
+	receipt.GadgetID = gttTraceCopyPointer(receipt.GadgetID)
+	receipt.GadgetCreatorIndex = gttTraceCopyPointer(receipt.GadgetCreatorIndex)
+	receipt.GadgetConverterIndex = gttTraceCopyPointer(receipt.GadgetConverterIndex)
+	receipt.GadgetResolutionReason = gttTraceCopyPointer(receipt.GadgetResolutionReason)
+
+	trace.ReactionFormula = &receipt
+	trace.ParentAttackID = gttTraceCopyPointer(receipt.ParentAttackID)
+	trace.ParentTargetKey = gttTraceCopyPointer(receipt.ParentTargetKey)
+	trace.ReactionBonusContributions = append(
+		trace.ReactionBonusContributions,
+		receipt.ReactionBonusContributions...,
+	)
+	for _, row := range receipt.ReactionBonusContributions {
+		if !row.Provider.Complete() {
+			trace.Completeness.ProviderIdentityComplete = false
+			trace.AddUnsupported("reaction_bonus_provider_unattributed")
+		}
+	}
+}
+
+func gttTraceCopyPointer[T any](value *T) *T {
+	if value == nil {
+		return nil
+	}
+	copy := *value
+	return &copy
+}
+
+func gttTraceTransformativeFormulaComplete(atk *info.AttackEvent) bool {
+	trace := atk.GTTTraceHit
+	if trace == nil || trace.ReactionFormula == nil {
+		return false
+	}
+	receipt := trace.ReactionFormula
+	if receipt.FormulaID != info.GTTTraceTransformativeFormulaID ||
+		receipt.FormulaSHA256 != info.GTTTraceTransformativeFormulaSHA256 ||
+		receipt.OperatorID != "spawn_damage_attack" ||
+		receipt.OperatorID != trace.ReactionOperatorID ||
+		(receipt.ReadMode != info.GTTTraceReactionReadLive && receipt.ReadMode != info.GTTTraceReactionReadSnapshot) ||
+		strings.TrimSpace(receipt.ReadPhase) == "" ||
+		receipt.ReadFrame != atk.Snapshot.SourceFrame ||
+		receipt.OwnerIndex != atk.Info.ActorIndex ||
+		receipt.Level != atk.Snapshot.CharLvl ||
+		receipt.ElementalMastery != atk.Snapshot.Stats[attributes.EM] ||
+		receipt.ConstructedFlatDmg != atk.Info.FlatDmg ||
+		receipt.LevelBase <= 0 || receipt.ElementalMastery < 0 ||
+		receipt.EMCurveNumerator != 16 || receipt.EMCurveDenominatorOffset != 2000 ||
+		receipt.Coefficient <= 0 || strings.TrimSpace(receipt.ChildRole) == "" ||
+		receipt.ChildOrdinal < 0 || receipt.ParentAttackID == nil ||
+		*receipt.ParentAttackID == 0 || receipt.ParentTargetKey == nil ||
+		!gttTracePointerEqual(trace.ParentAttackID, receipt.ParentAttackID) ||
+		!gttTracePointerEqual(trace.ParentTargetKey, receipt.ParentTargetKey) ||
+		receipt.ReactionBonusContributions == nil || receipt.AuraSourceIndices == nil {
+		return false
+	}
+	switch receipt.ReadPhase {
+	case info.GTTTraceReactionReadLiveTrigger,
+		info.GTTTraceReactionReadPersistentUpdate,
+		info.GTTTraceReactionReadGadgetRupture,
+		info.GTTTraceReactionReadGadgetConversion:
+	default:
+		return false
+	}
+	for _, value := range []float64{
+		receipt.LevelBase,
+		receipt.ElementalMastery,
+		receipt.EMCurveNumerator,
+		receipt.EMCurveDenominatorOffset,
+		receipt.ReactionBonus,
+		receipt.CoreDamage,
+		receipt.Coefficient,
+		receipt.ConstructedFlatDmg,
+	} {
+		if !gttTraceFormulaFinite(value) {
+			return false
+		}
+	}
+	bonusFromProviders := 0.0
+	for _, row := range receipt.ReactionBonusContributions {
+		if strings.TrimSpace(row.ModifierKey) == "" || !gttTraceFormulaFinite(row.Value) {
+			return false
+		}
+		bonusFromProviders += row.Value
+	}
+	if !gttTraceFormulaClose(bonusFromProviders, receipt.ReactionBonus) {
+		return false
+	}
+	denominator := receipt.EMCurveDenominatorOffset + receipt.ElementalMastery
+	if denominator == 0 || !gttTraceFormulaFinite(denominator) {
+		return false
+	}
+	reconstructedCore := (1 +
+		(receipt.EMCurveNumerator*receipt.ElementalMastery)/denominator +
+		receipt.ReactionBonus) * receipt.LevelBase
+	reconstructedFlatDmg := receipt.Coefficient * reconstructedCore
+	return gttTraceFormulaClose(reconstructedCore, receipt.CoreDamage) &&
+		gttTraceFormulaClose(reconstructedFlatDmg, receipt.ConstructedFlatDmg)
+}
+
+func gttTracePointerEqual[T comparable](left, right *T) bool {
+	return (left == nil && right == nil) ||
+		(left != nil && right != nil && *left == *right)
+}
+
+func gttTraceFormulaFinite(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func gttTraceFormulaClose(left, right float64) bool {
+	if !gttTraceFormulaFinite(left) || !gttTraceFormulaFinite(right) {
+		return false
+	}
+	scale := math.Max(1, math.Max(math.Abs(left), math.Abs(right)))
+	return math.Abs(left-right) <= 1e-12*scale
+}
+
+func (e *Enemy) gttTraceAura() []info.GTTTraceAuraRow {
+	values := e.GetDurability()
+	out := make([]info.GTTTraceAuraRow, 0, len(values))
+	for index, durability := range values {
+		name := info.ReactionModKey(index).String()
+		if name == "" {
+			continue
+		}
+		out = append(out, info.GTTTraceAuraRow{
+			Element:    name,
+			Durability: float64(durability),
+		})
+	}
+	return out
+}
+
+func gttTraceAuraActive(rows []info.GTTTraceAuraRow) bool {
+	for _, row := range rows {
+		if row.Durability > float64(info.ZeroDur) {
+			return true
+		}
+	}
+	return false
+}
+
+func (e *Enemy) gttTraceFinalizeReactionGuard(atk *info.AttackEvent) {
+	trace := atk.GTTTraceHit
+	if trace == nil {
+		return
+	}
+	if trace.ReactionOperatorID == "opaque_custom" {
+		trace.AddUnsupported("unknown_reaction_operator")
+	}
+	if (trace.ReactionOperatorID == "spawn_damage_attack" || trace.ReactionOperatorID == "opaque_custom") &&
+		!gttTraceTransformativeFormulaComplete(atk) {
+		trace.AddUnsupported("reaction_bonus_provider_paths_incomplete")
+	}
+	reactionRelevant := (atk.Info.Element != attributes.Physical && trace.DurabilityInitial > 0) || atk.Reacted ||
+		trace.ReactionOperatorID != "none" || gttTraceAuraActive(trace.AuraBefore) ||
+		gttTraceAuraActive(trace.AuraAfterReaction)
+	trace.Completeness.ReactionTopologyComplete = trace.Completeness.ReactionTopologyComplete && !reactionRelevant
+	if reactionRelevant {
+		trace.AddUnsupported("reaction_topology_aggregate_only")
+	}
+	if trace.ReactionOperatorID != "none" && !gttTraceTransformativeFormulaComplete(atk) {
+		trace.AddUnsupported("reaction_parent_lineage_not_instrumented")
+	}
+}
+
+func gttTraceReactionOperatorID(atk *info.AttackEvent) string {
+	if atk.Info.Amped {
+		return "multiply_parent_hit"
+	}
+	if atk.Info.Catalyzed {
+		return "add_flat_to_parent_hit_before_bonuses"
+	}
+	// Only the generic producer supplies operator semantics. A matching label
+	// alone is insufficient; the full receipt is still validated separately.
+	if receipt := atk.Snapshot.GTTReactionFormula; receipt != nil {
+		if receipt.FormulaID == info.GTTTraceTransformativeFormulaID &&
+			receipt.FormulaSHA256 == info.GTTTraceTransformativeFormulaSHA256 &&
+			receipt.OperatorID == "spawn_damage_attack" {
+			return receipt.OperatorID
+		}
+		return "opaque_custom"
+	}
+	return "none"
+}
