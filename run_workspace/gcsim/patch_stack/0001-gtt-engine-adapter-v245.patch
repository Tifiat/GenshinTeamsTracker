+package gtt
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestEngineInfoAdvertisesTraceV6Once(t *testing.T) {
+	capabilities := Info("fixture").Capabilities
+	counts := make(map[string]int)
+	for _, capability := range capabilities {
+		counts[capability]++
+	}
+	if counts[TraceEquationV4Capability] != 1 || counts[TraceEquationV5Capability] != 1 ||
+		counts[TraceEquationV6Capability] != 1 {
+		t.Fatalf("trace capabilities = %#v", capabilities)
+	}
+	if counts[CompactEquationV1Capability] != 1 {
+		t.Fatalf("compact capability = %#v", capabilities)
+	}
+}
+
+func TestEngineInfoUsesCanonicalSourceManifestCompilerKey(t *testing.T) {
+	payload, err := json.Marshal(EngineInfo{
+		SourceManifestBodySHA256: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		SourceCompilerVersion:    "gtt_source_compiler_v1",
+	})
+	if err != nil {
+		t.Fatalf("marshal engine info: %v", err)
+	}
+	var decoded map[string]any
+	if err := json.Unmarshal(payload, &decoded); err != nil {
+		t.Fatalf("decode engine info: %v", err)
+	}
+	if got := decoded["source_manifest_compiler_version"]; got != "gtt_source_compiler_v1" {
+		t.Fatalf("canonical compiler key = %v, want gtt_source_compiler_v1", got)
+	}
+	if _, exists := decoded["source_compiler_version"]; exists {
+		t.Fatal("legacy source_compiler_version alias must not be emitted")
+	}
+}
diff --git a/pkg/gtt/waves.go b/pkg/gtt/waves.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtt/waves.go
@@ -0,0 +1,220 @@
+package gtt
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/glog"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/enemy"
+)
+
+const (
+	WaveScenarioPayloadCapability     = "gtt_wave_scenario_payload"
+	WaveScenarioSpawnPolicyGroupClear = "group_clear"
+)
+
+type waveScenarioFile struct {
+	SchemaVersion int                `json:"schema_version"`
+	SpawnPolicy   string             `json:"spawn_policy"`
+	Waves         []waveScenarioWave `json:"waves"`
+}
+
+type waveScenarioWave struct {
+	Targets []waveScenarioTarget `json:"targets"`
+}
+
+type waveScenarioTarget struct {
+	Level  *int      `json:"level"`
+	Type   string    `json:"type"`
+	HP     *float64  `json:"hp"`
+	Radius *float64  `json:"radius"`
+	Pos    []float64 `json:"pos"`
+	Resist *float64  `json:"resist"`
+}
+
+// ApplyWaveScenarioFile applies an explicit structured GTT wave scenario. The
+// first scenario wave replaces the parsed config targets; remaining waves are
+// queued for the sequential wave scheduler. Empty path is a no-op so vanilla
+// configs remain unchanged unless this GTT flag is explicitly provided.
+func ApplyWaveScenarioFile(path string, cfg *info.ActionList) error {
+	if cfg == nil || strings.TrimSpace(path) == "" {
+		return nil
+	}
+	payload, err := loadWaveScenarioFile(path)
+	if err != nil {
+		return err
+	}
+	waves, err := payload.enemyWaves()
+	if err != nil {
+		return err
+	}
+	cfg.Targets = cloneWaveProfiles(waves[0])
+	cfg.GTTSequentialWaveScenario = cloneScenarioWaves(waves[1:])
+	cfg.Settings.DamageMode = true
+	return nil
+}
+
+func loadWaveScenarioFile(path string) (waveScenarioFile, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return waveScenarioFile{}, fmt.Errorf("gtt wave scenario: could not read %q: %w", path, err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var payload waveScenarioFile
+	if err := decoder.Decode(&payload); err != nil {
+		return waveScenarioFile{}, fmt.Errorf("gtt wave scenario: invalid JSON in %q: %w", path, err)
+	}
+	return payload, nil
+}
+
+func (payload waveScenarioFile) enemyWaves() ([][]info.EnemyProfile, error) {
+	if payload.SchemaVersion != 1 {
+		return nil, fmt.Errorf("gtt wave scenario: schema_version must be 1")
+	}
+	if payload.SpawnPolicy != WaveScenarioSpawnPolicyGroupClear {
+		return nil, fmt.Errorf("gtt wave scenario: unsupported spawn_policy %q; expected %q", payload.SpawnPolicy, WaveScenarioSpawnPolicyGroupClear)
+	}
+	if len(payload.Waves) == 0 {
+		return nil, fmt.Errorf("gtt wave scenario: waves must contain at least one wave")
+	}
+	waves := make([][]info.EnemyProfile, len(payload.Waves))
+	for waveIndex, wave := range payload.Waves {
+		if len(wave.Targets) == 0 {
+			return nil, fmt.Errorf("gtt wave scenario: waves[%d].targets must contain at least one target", waveIndex)
+		}
+		waves[waveIndex] = make([]info.EnemyProfile, len(wave.Targets))
+		for targetIndex, target := range wave.Targets {
+			profile, err := target.enemyProfile(waveIndex, targetIndex)
+			if err != nil {
+				return nil, err
+			}
+			waves[waveIndex][targetIndex] = profile
+		}
+	}
+	return waves, nil
+}
+
+func (target waveScenarioTarget) enemyProfile(waveIndex int, targetIndex int) (info.EnemyProfile, error) {
+	prefix := fmt.Sprintf("gtt wave scenario: waves[%d].targets[%d]", waveIndex, targetIndex)
+	if target.Level == nil {
+		return info.EnemyProfile{}, fmt.Errorf("%s.level is required", prefix)
+	}
+	if *target.Level < 1 || *target.Level > 100 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.level must be between 1 and 100", prefix)
+	}
+	if strings.TrimSpace(target.Type) == "" {
+		return info.EnemyProfile{}, fmt.Errorf("%s.type is required", prefix)
+	}
+	if target.HP == nil {
+		return info.EnemyProfile{}, fmt.Errorf("%s.hp is required", prefix)
+	}
+	if *target.HP <= 0 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.hp must be greater than 0", prefix)
+	}
+	if target.Radius != nil && *target.Radius <= 0 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.radius must be greater than 0", prefix)
+	}
+	if len(target.Pos) != 0 && len(target.Pos) != 2 {
+		return info.EnemyProfile{}, fmt.Errorf("%s.pos must contain exactly two numbers when provided", prefix)
+	}
+	profile := info.EnemyProfile{
+		Level:  *target.Level,
+		Resist: make(attributes.ElementMap),
+	}
+	if len(target.Pos) == 2 {
+		profile.Pos.X = target.Pos[0]
+		profile.Pos.Y = target.Pos[1]
+	}
+	if target.Radius != nil {
+		profile.Pos.R = *target.Radius
+	}
+	if err := enemy.ConfigureTarget(&profile, target.Type, enemy.TargetParams{Particles: true}); err != nil {
+		return info.EnemyProfile{}, fmt.Errorf("%s.type %q is invalid: %w", prefix, target.Type, err)
+	}
+	if profile.Pos.R == 0 {
+		profile.Pos.R = 1
+	}
+	profile.HP = *target.HP
+	profile.Modified = true
+	if target.Resist != nil {
+		for attr := range profile.Resist {
+			profile.Resist[attr] = *target.Resist
+		}
+	}
+	return profile, nil
+}
+
+type SequentialWaveScheduler struct {
+	core    *core.Core
+	spawned int
+	waves   [][]info.EnemyProfile
+}
+
+func NewSequentialWaveScheduler(c *core.Core, cfg *info.ActionList) *SequentialWaveScheduler {
+	if c == nil || cfg == nil || len(cfg.GTTSequentialWaveScenario) == 0 {
+		return nil
+	}
+	return &SequentialWaveScheduler{
+		core:  c,
+		waves: cloneScenarioWaves(cfg.GTTSequentialWaveScenario),
+	}
+}
+
+func (s *SequentialWaveScheduler) SpawnNextWave() bool {
+	if s == nil || len(s.waves) == 0 {
+		return false
+	}
+	profiles := cloneWaveProfiles(s.waves[0])
+	s.waves = s.waves[1:]
+	s.spawned++
+	s.spawnProfiles(profiles)
+	s.core.Log.NewEvent("gtt sequential wave scenario spawned group", glog.LogSimEvent, -1).
+		Write("spawned_wave", s.spawned).
+		Write("remaining_waves", len(s.waves)).
+		Write("target_count", len(profiles))
+	return true
+}
+
+func (s *SequentialWaveScheduler) spawnProfiles(profiles []info.EnemyProfile) {
+	for idx, profile := range profiles {
+		nextEnemy := enemy.New(s.core, profile.Clone())
+		s.core.Combat.AddEnemy(nextEnemy)
+		if idx == 0 {
+			s.core.Combat.DefaultTarget = nextEnemy.Key()
+			if player := s.core.Combat.Player(); player != nil {
+				player.SetDirection(nextEnemy.Pos())
+			}
+		}
+		s.core.Events.Emit(event.OnEnemyAdded, nextEnemy)
+	}
+}
+
+func cloneScenarioWaves(waves [][]info.EnemyProfile) [][]info.EnemyProfile {
+	if len(waves) == 0 {
+		return nil
+	}
+	clone := make([][]info.EnemyProfile, len(waves))
+	for waveIndex := range waves {
+		clone[waveIndex] = cloneWaveProfiles(waves[waveIndex])
+	}
+	return clone
+}
+
+func cloneWaveProfiles(wave []info.EnemyProfile) []info.EnemyProfile {
+	if len(wave) == 0 {
+		return nil
+	}
+	clone := make([]info.EnemyProfile, len(wave))
+	for i := range wave {
+		clone[i] = wave[i].Clone()
+	}
+	return clone
+}
