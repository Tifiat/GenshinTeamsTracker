+
+func (c *Core) gttTraceBindAttackCallbacks(ae *info.AttackEvent) {
+	if ae.GTTTraceCallbacksBound {
+		return
+	}
+	for index, callback := range ae.Callbacks {
+		if callback != nil {
+			ae.Callbacks[index] = c.gttTraceWrapAttackCallback(
+				ae.GTTTraceProvider, ae.GTTTraceSourceID, ae.GTTTraceSourceOccurrenceID, callback,
+			)
+		}
+	}
+	ae.GTTTraceCallbacksBound = true
+}
+
+func (c *Core) gttTraceWrapAttackCallback(
+	provider gtttrace.Provider,
+	sourceID string,
+	occurrenceID string,
+	callback info.AttackCBFunc,
+) info.AttackCBFunc {
+	if !c.GTTTrace.Enabled() {
+		return callback
+	}
+	return func(cb info.AttackCB) {
+		restore := c.GTTTrace.EnterSourceOccurrence(provider, sourceID, occurrenceID, "")
+		defer restore()
+		callback(cb)
+	}
+}
