+func (r *Runtime) BeginNumericDependencyCapture() int {
+	if !r.Enabled() {
+		return -1
+	}
+	r.nextNumericDependencyCaptureToken++
+	token := r.nextNumericDependencyCaptureToken
+	r.numericDependencyCaptures = append(
+		r.numericDependencyCaptures,
+		numericDependencyCapture{token: token, ids: []string{}},
+	)
+	return token
+}
+
+func (r *Runtime) EndNumericDependencyCapture(token int) []NumericRef {
+	if !r.Enabled() || len(r.numericDependencyCaptures) == 0 {
+		return []NumericRef{}
+	}
+	index := len(r.numericDependencyCaptures) - 1
+	capture := r.numericDependencyCaptures[index]
+	if capture.token != token {
+		return []NumericRef{}
+	}
+	r.numericDependencyCaptures = r.numericDependencyCaptures[:index]
+	refs := make([]NumericRef, 0, len(capture.ids))
+	for _, eventID := range capture.ids {
+		refs = append(refs, EventRef(eventID))
+	}
+	return refs
+}
+
+func (r *Runtime) EnterModifierAmount() func() {
+	if !r.Enabled() {
+		return func() {}
+	}
+	r.modifierAmountDepth++
+	return func() { r.modifierAmountDepth-- }
+}
+
+func (r *Runtime) BeginModifierEvalCapture() int {
+	if !r.Enabled() {
+		return -1
+	}
+	r.nextModifierCaptureToken++
+	token := r.nextModifierCaptureToken
+	r.modifierEvalCaptures = append(r.modifierEvalCaptures, modifierEvalCapture{token: token, ids: []string{}, depth: r.modifierAmountDepth})
+	return token
