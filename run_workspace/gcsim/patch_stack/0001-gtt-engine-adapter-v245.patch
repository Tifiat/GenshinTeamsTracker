+package gtttrace
+
+import "testing"
+
+const testSourceID = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+const testTemplateSHA = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
+
+func TestSourceOccurrenceParentAndValueBinding(t *testing.T) {
+	frame := 12
+	runtime := NewRuntime()
+	runtime.BindFrame(&frame)
+	runtime.Enable()
+	provider := NewProvider("character", "fixture", 0, 0)
+
+	parent := runtime.RecordSourceOccurrence("task_callback", testSourceID, frame, provider, "")
+	restore := runtime.EnterSourceOccurrence(provider, testSourceID, parent, "")
+	frame = 13
+	child := runtime.RecordSourceOccurrence("queued_attack", testSourceID, frame, provider, "")
+	restore()
+
+	terminal := "hit:1"
+	runtime.BindOccurrenceTerminal(child, terminal)
+	actor := 0
+	stat := "hp"
+	binding := runtime.RecordSourceValueBinding(
+		child, testTemplateSHA, "terminal_flat_dmg", &terminal, nil,
+		"flat_dmg", 123.5,
+		[]SourceValueParameter{{
+			ParameterKey: "max_hp", Kind: "candidate_stat", ObservedValue: 1000,
+			ActorIndex: &actor, StatKey: &stat, ReadMode: "live", ReadFrame: frame,
+			CandidateDependencyComplete: true,
+		}},
+	)
+	if binding != "source-binding:1:0" {
+		t.Fatalf("binding ID = %q", binding)
+	}
+	rows := runtime.SourceOccurrences()
+	if len(rows) != 2 || rows[1].ParentOccurrenceID == nil || *rows[1].ParentOccurrenceID != parent {
+		t.Fatalf("unexpected occurrence lineage: %#v", rows)
+	}
+	if rows[1].TerminalEventID == nil || *rows[1].TerminalEventID != terminal {
+		t.Fatalf("terminal binding missing: %#v", rows[1])
+	}
+	bindings := runtime.SourceValueBindings()
+	if len(bindings) != 1 || bindings[0].OccurrenceID != child || len(bindings[0].Parameters) != 1 {
+		t.Fatalf("unexpected value bindings: %#v", bindings)
+	}
+}
diff --git a/pkg/gtttrace/stat_vector.go b/pkg/gtttrace/stat_vector.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/stat_vector.go
@@ -0,0 +1,79 @@
+package gtttrace
+
+// Addresses retain backing arrays until this trace ends: an old receipt cannot
+// accidentally bind a newly allocated array at a recycled address. No unsafe
+// pointers, gameplay identities or global cross-simulation storage are used.
+type savedStatCell struct {
+	value     float64
+	reference NumericRef
+}
+
+const maxSavedStatCells = 4096
+
+// Numeric consumers of a proven local vector use its original immutable ref.
+// An unobserved write never inherits the old derivative merely by address.
+func (r *Runtime) StatCellReference(cell *float64) NumericRef {
+	if cell == nil {
+		return NumericRef{}
+	}
+	if r.Enabled() {
+		if row, ok := r.savedStatCells[cell]; ok && row.value == *cell {
+			return row.reference
+		}
+	}
+	return EventRef(r.RecordNumericEval("", "frozen_attack_operand", nil, *cell, IncompleteEvidence("stat_cell_write_unobserved")))
+}
+
+// A scalar closure cell has no invented artifact-stat/output key.
+func (r *Runtime) ReadScalarCell(source string, cell *float64) {
+	if !r.Enabled() || cell == nil {
+		return
+	}
+	row, ok := r.savedStatCells[cell]
+	ref := row.reference
+	reason := "captured_scalar_schedule_frozen"
+	if !ok || row.value != *cell {
+		ref = LiteralRef(*cell)
+		reason = "captured_scalar_write_unobserved"
+	}
+	r.RecordNumericEval(source, "identity", []NumericRef{ref}, *cell, IncompleteEvidence(reason))
+}
+
+func (r *Runtime) StoreStatCell(cell *float64, reference NumericRef) {
+	if !r.Enabled() || cell == nil {
+		return
+	}
+	if r.savedStatCells == nil {
+		r.savedStatCells = make(map[*float64]savedStatCell)
+	}
+	if _, known := r.savedStatCells[cell]; !known && len(r.savedStatCells) >= maxSavedStatCells {
+		return
+	}
+	r.savedStatCells[cell] = savedStatCell{value: *cell, reference: reference}
+}
+
+func (r *Runtime) HasSavedStatCell(cell *float64) bool {
+	if !r.Enabled() || cell == nil {
+		return false
+	}
+	row, ok := r.savedStatCells[cell]
+	return ok && row.value == *cell
+}
+
+func (r *Runtime) ReadStatCell(source, key string, cell *float64) {
+	if !r.Enabled() || cell == nil {
+		return
+	}
+	row, ok := r.savedStatCells[cell]
+	evidence := IncompleteEvidence("saved_stat_vector_schedule_frozen")
+	ref := row.reference
+	if !ok || row.value != *cell {
+		ref = LiteralRef(*cell)
+		evidence = IncompleteEvidence("saved_stat_vector_write_unobserved")
+	}
+	// Explicit output key avoids matching two equal-valued stats by number.
+	r.appendStateEvent(StateEvent{Frame: r.Frame(), Kind: StateEventNumericEval,
+		SourceID: optionalString(source), Operation: optionalString("identity"), Key: optionalString(key),
+		Value: optionalFloat(*cell), Output: map[string]float64{key: *cell}, Inputs: []NumericRef{ref},
+		CandidateDependencyComplete: false, UncertaintyCodes: evidence.UncertaintyCodes})
+}
diff --git a/pkg/gtttrace/stat_vector_test.go b/pkg/gtttrace/stat_vector_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/stat_vector_test.go
@@ -0,0 +1,77 @@
+package gtttrace
+
+import "testing"
+
+func TestSavedStatCellsKeepTimeIdentityAndBoundaries(t *testing.T) {
+	r := NewRuntime()
+	r.Enable()
+	first := []float64{5, 0}
+	producer := r.RecordNumericEval("origin", "identity", []NumericRef{LiteralRef(5)}, 5, IncompleteEvidence("test"))
+	r.StoreStatCell(&first[0], EventRef(producer))
+	r.StoreStatCell(&first[1], LiteralRef(0))
+	token := r.BeginNumericDependencyCapture()
+	alias := first
+	r.ReadStatCell("read", "a", &alias[0])
+	r.ReadStatCell("read", "b", &alias[1])
+	refs := r.EndNumericDependencyCapture(token)
+	if len(refs) != 2 {
+		t.Fatal(refs)
+	}
+	events := r.StateEvents()
+	old := events[len(events)-2]
+	if old.Key == nil || *old.Key != "a" || old.Inputs[0].EventID == nil || *old.Inputs[0].EventID != producer {
+		t.Fatal(old)
+	}
+	// Changing the stored producer does not rewrite past event inputs.
+	first[0] = 9
+	r.StoreStatCell(&first[0], LiteralRef(9))
+	r.ReadStatCell("read", "a", &first[0])
+	if *old.Inputs[0].EventID != producer {
+		t.Fatal("retroactive update")
+	}
+	// A new allocation never inherits an old array's expression.
+	next := []float64{9, 0}
+	if r.HasSavedStatCell(&next[0]) {
+		t.Fatal("allocation alias")
+	}
+	r.ReadStatCell("read", "a", &next[0])
+	last := r.StateEvents()
+	if last[len(last)-1].UncertaintyCodes[0] != "saved_stat_vector_write_unobserved" {
+		t.Fatal(last)
+	}
+	// Detect unsupported overwrites; equality is required at the read boundary.
+	first[0] = 22
+	if r.HasSavedStatCell(&first[0]) {
+		t.Fatal("stale value")
+	}
+	r.ReadStatCell("read", "a", &first[0])
+	last = r.StateEvents()
+	if last[len(last)-1].Inputs[0].Kind != "literal" {
+		t.Fatal("stale provenance")
+	}
+	// Even a same-number overwrite must erase the old dependency when the
+	// source writer is unsupported. Numerical equality is not provenance.
+	r.StoreStatCell(&first[0], EventRef(producer))
+	r.StoreStatCell(&first[0], NumericRef{})
+	if ref := r.StatCellReference(&first[0]); ref.EventID != nil {
+		t.Fatal("phantom producer after opaque overwrite", ref)
+	}
+	var disabled *Runtime
+	disabled.StoreStatCell(&first[0], LiteralRef(22))
+	disabled.ReadStatCell("", "", &first[0])
+	if disabled.HasSavedStatCell(&first[0]) {
+		t.Fatal("disabled")
+	}
+}
+
+func TestSavedStatCellBudget(t *testing.T) {
+	r := NewRuntime()
+	r.Enable()
+	cells := make([]float64, maxSavedStatCells+1)
+	for i := range cells {
+		r.StoreStatCell(&cells[i], LiteralRef(0))
+	}
+	if len(r.savedStatCells) != maxSavedStatCells || r.HasSavedStatCell(&cells[len(cells)-1]) {
+		t.Fatal("budget")
+	}
+}
