+			"pkg/gtttrace/runtime.go",
+		},
+		Binding: testBinding(),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	modifierOperators := make(map[string]bool)
+	stateFields := make(map[string]bool)
+	resolvedGainTask := false
+	resolvedOrdinaryHelper := false
+	for _, entry := range manifest.Entries {
+		switch entry.Locator.Seam {
+		case KindModifierAmount:
+			if entry.Template.Status == TemplateSupported {
+				for operator := range templateOperators(entry.Template) {
+					modifierOperators[operator] = true
+				}
+			}
+		case KindStateOperation:
+			if entry.stateOperation != nil {
+				stateFields[entry.stateOperation.FieldName] = true
+			}
+		case KindTaskCallback:
+			if entry.callback != nil && entry.callback.ResolvedMethodName == "addFanfareFunc" {
+				resolvedGainTask = containsString(entry.callback.StateFields, "curFanfare") &&
+					containsString(entry.callback.StateFields, "maxC2Fanfare")
+			}
+		case KindEventCallback:
+			if entry.callback != nil {
+				for _, helper := range entry.callback.OrdinaryHelpers {
+					if helper.MethodName == "queueFanfareGain" && helper.ResolvedFile == "internal/characters/furina/burst.go" {
+						resolvedOrdinaryHelper = true
+					}
+				}
+			}
+		}
+	}
+	for _, operator := range []string{"SUB", "MAX", "MIN", "MUL", "SELECT"} {
+		if !modifierOperators[operator] {
+			t.Fatalf("real modifier plan lacks %s: %#v", operator, modifierOperators)
+		}
+	}
+	for _, field := range []string{"curFanfare", "maxQFanfare", "maxC2Fanfare"} {
+		if !stateFields[field] {
+			t.Fatalf("real direct state plan lacks %s: %#v", field, stateFields)
+		}
+	}
+	if !resolvedGainTask {
+		t.Fatal("real receiver method returning gain closure was not resolved structurally")
+	}
+	if !resolvedOrdinaryHelper {
+		t.Fatal("real ordinary receiver helper was not resolved structurally")
+	}
+}
