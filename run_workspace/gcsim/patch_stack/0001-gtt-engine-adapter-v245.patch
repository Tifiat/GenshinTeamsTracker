@@ -0,0 +1,55 @@
+package character
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/glog"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/modifier"
+	"testing"
+)
+
+func TestReactionBonusCaptureUsesActualSingleEvaluation(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		f := 10
+		rt := gtttrace.NewRuntime()
+		if enabled {
+			rt.Enable()
+		}
+		c := &CharWrapper{f: &f, index: 0, gttTrace: rt, log: glog.New(&f, 1)}
+		calls := 0
+		m := &ReactBonusMod{Base: modifier.NewBase("arbitrary", -1), Amount: func(info.AttackInfo) float64 {
+			calls++
+			rt.RecordNumericEval("", "literal", nil, .4, gtttrace.IncompleteEvidence("test"))
+			return .4
+		}}
+		m.SetExpiry(f)
+		c.mods = []modifier.Mod{m}
+		trace := &info.GTTTraceHit{}
+		if got := c.ReactBonusWithTrace(info.AttackInfo{}, trace); got != .4 || calls != 1 {
+			t.Fatal(got, calls)
+		}
+		if enabled {
+			if trace.ReactionBonusRef.EventID == nil {
+				t.Fatal("sum reference missing")
+			}
+			rows := rt.StateEvents()
+			row := rows[len(rows)-1]
+			if row.Operation == nil || *row.Operation != "add" || len(row.Inputs) != 1 || row.Inputs[0].FieldKey == nil || *row.Inputs[0].FieldKey != "reaction_bonus" {
+				t.Fatal("sum bindings", row)
+			}
+		} else if trace.ReactionBonusRef.EventID != nil || len(rt.StateEvents()) != 0 {
+			t.Fatal("disabled tracing changed")
+		}
+		c.mods = nil
+		if got := c.ReactBonusWithTrace(info.AttackInfo{}, trace); got != 0 || calls != 1 {
+			t.Fatal("empty modifiers", got, calls)
+		}
+		if enabled {
+			rows := rt.StateEvents()
+			last := rows[len(rows)-1]
+			if last.Operation == nil || *last.Operation != "literal" || len(last.Inputs) != 0 || last.Value == nil || *last.Value != 0 {
+				t.Fatal("empty sum must be a literal, not zero-arity add")
+			}
+		}
+	}
+}
