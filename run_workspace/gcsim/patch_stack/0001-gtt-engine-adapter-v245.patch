+func gttHealthHealType(value info.HealType) string {
+	switch value {
+	case info.HealTypeAbsolute:
+		return gtttrace.HealthHealTypeAbsolute
+	case info.HealTypePercent:
+		return gtttrace.HealthHealTypePercent
+	default:
+		return "invalid"
+	}
+}
+
+func gttHealthOptionalIndex(value int) *int {
+	if value < 0 {
+		return nil
+	}
+	cloned := value
+	return &cloned
+}
+
+func gttHealthOptionalString(value string) *string {
+	if value == "" {
+		return nil
+	}
+	cloned := value
+	return &cloned
+}
+
+func gttHealthProviderUncertainty(provider gtttrace.Provider) []string {
+	if provider.Complete() {
+		return nil
+	}
+	return []string{"health_provider_unattributed"}
+}
+
+func gttHealthClose(left, right float64) bool {
+	if math.IsNaN(left) || math.IsNaN(right) || math.IsInf(left, 0) || math.IsInf(right, 0) {
+		return false
+	}
+	scale := math.Max(1, math.Max(math.Abs(left), math.Abs(right)))
+	return math.Abs(left-right) <= 1e-10*scale
+}
