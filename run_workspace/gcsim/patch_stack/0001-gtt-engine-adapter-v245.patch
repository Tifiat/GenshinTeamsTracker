new file mode 100644
--- /dev/null
+++ b/pkg/core/player/character/gtt_nonextra_test.go
@@ -0,0 +1,113 @@
+package character
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/modifier"
+	"testing"
+)
+
+func TestStatReadCapturesOnlyDirectModifierAmounts(t *testing.T) {
+	for _, sameOwner := range []bool{false, true} {
+		f := 0
+		r := gtttrace.NewRuntime()
+		r.Enable()
+		c := &CharWrapper{index: 0, f: &f, gttTrace: r}
+		provider := &CharWrapper{index: 1, f: &f, gttTrace: r}
+		if sameOwner {
+			provider = c
+		}
+		provider.BaseStats[attributes.ATK] = 100
+		calls := 0
+		inner := &StatMod{Base: modifier.NewBase("inner", -1), AffectedStat: attributes.ATK,
+			Amount: func() []float64 {
+				calls++
+				v := make([]float64, attributes.EndStatType)
+				v[attributes.ATK] = 20
+				return v
+			}}
+		inner.SetExpiry(f)
+		provider.mods = append(provider.mods, inner)
+		outer := &StatMod{Base: modifier.NewBase("outer", -1), AffectedStat: attributes.EM,
+			Amount: func() []float64 {
+				value, _ := provider.GTTStat(attributes.ATK)
+				v := make([]float64, attributes.EndStatType)
+				v[attributes.EM] = value / 2
+				return v
+			}}
+		outer.SetExpiry(f)
+		c.mods = append(c.mods, outer)
+		value, _ := c.GTTStat(attributes.EM)
+		if value != 60 || calls != 1 {
+			t.Fatal(value, calls)
+		}
+		rows := r.StateEvents()
+		byID := map[string]gtttrace.StateEvent{}
+		reads := 0
+		for _, row := range rows {
+			byID[row.EventID] = row
+			if row.Operation == nil || *row.Operation != "artifact_stat_read" {
+				continue
+			}
+			reads++
+			if len(row.ModifierEvalIDs) != 1 {
+				t.Fatal("nested modifier leaked into getter", row)
+			}
+			mod := byID[row.ModifierEvalIDs[0]]
+			want := "inner"
+			if *row.Key == "em" {
+				want = "outer"
+			}
+			if mod.Key == nil || *mod.Key != want || *mod.OwnerIndex != *row.OwnerIndex {
+				t.Fatal(row, mod)
+			}
+		}
+		if reads != 2 {
+			t.Fatal("nested dependency lost", reads)
+		}
+	}
+}
+
+func TestGTTNonExtraStatKeepsFilterAndSingleEvaluation(t *testing.T) {
+	f := 0
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	c := &CharWrapper{index: 2, f: &f, gttTrace: r}
+	c.BaseStats[attributes.EM] = 100
+	normalCalls, extraCalls := 0, 0
+	vector := func(v float64) []float64 {
+		out := make([]float64, attributes.EndStatType)
+		out[attributes.EM] = v
+		return out
+	}
+	normal := &StatMod{Base: modifier.NewBase("ordinary", -1), AffectedStat: attributes.EM,
+		Amount: func() []float64 { normalCalls++; return vector(25) }}
+	extra := &StatMod{Base: modifier.NewBase("shared", -1), AffectedStat: attributes.EM, Extra: true,
+		Amount: func() []float64 { extraCalls++; return vector(900) }}
+	normal.SetExpiry(f)
+	extra.SetExpiry(f)
+	c.mods = []modifier.Mod{normal, extra}
+	got, id := c.GTTNonExtraStat(attributes.EM)
+	if got != 125 || id == "" || normalCalls != 1 || extraCalls != 0 {
+		t.Fatal(got, id, normalCalls, extraCalls)
+	}
+	rows := r.StateEvents()
+	row := rows[len(rows)-1]
+	if row.OwnerIndex == nil || *row.OwnerIndex != 2 || len(row.ModifierEvalIDs) != 1 {
+		t.Fatal("owner/filter ancestry", row)
+	}
+	if got := c.Stat(attributes.EM); got != 1025 {
+		t.Fatal("ordinary Stat changed", got)
+	}
+	normalCalls, extraCalls = 0, 0
+	selected, ids := c.GTTSelectStat(true, attributes.EM)
+	if selected[attributes.EM] != 125 || len(ids) != 1 || normalCalls != 1 || extraCalls != 0 {
+		t.Fatal("selected container repeated or included Extra", selected, ids, normalCalls, extraCalls)
+	}
+	c.gttTrace = nil
+	normalCalls, extraCalls = 0, 0
+	got, id = c.GTTNonExtraStat(attributes.EM)
+	if got != 125 || id != "" || normalCalls != 1 || extraCalls != 0 {
+		t.Fatal("disabled", got, id)
+	}
+}
