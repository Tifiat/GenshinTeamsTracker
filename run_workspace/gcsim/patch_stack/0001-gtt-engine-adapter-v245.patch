+package gttcompact
+
+// GOB-11 pins the safe boundary; later work must replace this freeze with a
+// proven generic producer-to-terminal dependency, not a character-specific fix.
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"testing"
+)
+
+func TestModifiedReactionFreezesOnlyItsChannel(t *testing.T) {
+	modified := info.GTTTraceHit{ActorIndex: 0, FormulaKind: info.GTTTraceFormulaStandard,
+		ReactionFormula: &info.GTTTraceReactionFormula{}, FlatDmg: 1000,
+		DefMod: 1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+		UncappedDamage: 1000, Completeness: info.GTTTraceCompleteness{FormulaComplete: true},
+		Unsupported: []string{"transformative_reaction_formula_mismatch"}}
+	ordinary := info.GTTTraceHit{ActorIndex: 0, FormulaKind: info.GTTTraceFormulaStandard,
+		ScalingStatKind: "atk", ScalingStatValue: 100, Mult: 1,
+		SnapshotStats: map[string]float64{"base_atk": 100},
+		DefMod:        1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1, UncappedDamage: 100,
+		Completeness: info.GTTTraceCompleteness{FormulaComplete: true}}
+	b := &nodeBuilder{}
+	rows, reasons, _ := compileChannels(b, optstats.GTTTraceEquationBuffer{Hits: []info.GTTTraceHit{modified, ordinary}}, []string{"actor"}, supportProgram{})
+	if len(rows) != 2 || rows[0].Kind != "reaction" || len(rows[0].ResponseCoordinates) != 0 || len(rows[1].ResponseCoordinates) == 0 {
+		t.Fatalf("boundary leaked or discarded another channel: %+v", rows)
+	}
+	if _, ok := reasons["reaction_terminal_dependency_not_compiled"]; !ok {
+		t.Fatal("missing diagnostic")
+	}
+}
diff --git a/pkg/gttcompact/recipe_ancestors.go b/pkg/gttcompact/recipe_ancestors.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/recipe_ancestors.go
@@ -0,0 +1,30 @@
+package gttcompact
+
+import "github.com/genshinsim/gcsim/pkg/core/info"
+
+func recipeAncestorEventIDs(root *info.GTTNumericRecipe) []string {
+	var out []string
+	budget := 512
+	seen := map[*info.GTTNumericRecipe]bool{}
+	var visit func(*info.GTTNumericRecipe, int)
+	visit = func(r *info.GTTNumericRecipe, depth int) {
+		if r == nil || seen[r] || depth > 5 {
+			return
+		}
+		seen[r] = true
+		budget -= len(r.Nodes) + len(r.Inputs) + 1
+		if budget < 0 {
+			return
+		}
+		for _, p := range r.Inputs {
+			if p.Kind == "reference" && p.Reference.EventID != nil {
+				out = append(out, *p.Reference.EventID)
+			}
+			if p.Kind == "nested_recipe" {
+				visit(p.Recipe, depth+1)
+			}
+		}
+	}
+	visit(root, 0)
+	return out
+}
diff --git a/pkg/gttcompact/recipe_operand_test.go b/pkg/gttcompact/recipe_operand_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/recipe_operand_test.go
@@ -0,0 +1,72 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"strings"
+	"testing"
+)
+
+func testOperandRecipe(input info.GTTNumericInput, factor, observed float64) *info.GTTNumericRecipe {
+	return &info.GTTNumericRecipe{Version: info.GTTNumericRecipeVersion, SourceSHA256: strings.Repeat("a", 64), Observed: observed, Root: 2, Inputs: []info.GTTNumericInput{input}, Nodes: []info.GTTNumericNode{{Op: "INPUT", Input: 0}, {Op: "CONST", Value: factor}, {Op: "MUL", Args: []int{0, 1}}}}
+}
+
+func TestNestedRecipeBetweenOrderedCallbackWrites(t *testing.T) {
+	b := &nodeBuilder{}
+	c := &directCompiler{b: b, unknown: map[string]struct{}{}, support: supportProgram{eventNodes: map[string]compiledNode{}}}
+	c.support.eventNodes["stat"] = b.add(b.constant(3), b.artifactDelta("actual_owner", "em"))
+	child := testOperandRecipe(info.GTTNumericInput{Kind: "reference", Value: 3, Reference: gtttrace.EventRef("stat")}, 2, 6)
+	outer := testOperandRecipe(info.GTTNumericInput{Kind: "nested_recipe", Value: 6, Recipe: child}, 3, 18)
+	writes := []info.GTTNumericFieldWrite{
+		{Field: "FlatDmg", Operation: "add", Order: 0, Before: 10, After: 11, Operand: 1, Reference: gtttrace.LiteralRef(1)},
+		{Field: "FlatDmg", Operation: "add", Order: 1, Before: 11, After: 29, Operand: 18, Recipe: outer},
+		{Field: "FlatDmg", Operation: "multiply", Order: 2, Before: 29, After: 58, Operand: 2, Reference: gtttrace.LiteralRef(2)},
+	}
+	hit := info.GTTTraceHit{NumericFieldWrites: writes, CallbackAttempts: []info.GTTTraceCallbackAttempt{{FlatDmgDelta: 1, NumericWrites: writes[:1]}, {FlatDmgDelta: 29, NumericWrites: writes[2:]}}}
+	if initial := attackFieldInitial(hit, "FlatDmg", 58); initial != 10 {
+		t.Fatal("outside write omitted or doubled", initial)
+	}
+	got := c.compileAttackField(hit, "FlatDmg", b.constant(10), 58)
+	if got.baseline != 58 || len(got.coords) != 1 {
+		t.Fatal(got)
+	}
+	if _, ok := got.coords["actual_owner.em"]; !ok {
+		t.Fatal("last trigger replaced input owner")
+	}
+	if refs := recipeAncestorEventIDs(outer); len(refs) != 1 || refs[0] != "stat" {
+		t.Fatal(refs)
+	}
+	// A missing inner formula freezes only that input, retaining other writes.
+	outer.Inputs[0].Recipe = nil
+	got = c.compileAttackField(hit, "FlatDmg", b.add(b.constant(10), b.artifactDelta("producer", "hp")), 58)
+	if got.baseline != 58 || len(got.coords) != 1 {
+		t.Fatal("unknown child broke known producer", got)
+	}
+	if _, ok := c.unknown["numeric_recipe_child_unresolved"]; !ok {
+		t.Fatal("silent boundary")
+	}
+}
+
+func TestNestedRecipeCycleAndMalformedNodeStayBounded(t *testing.T) {
+	b := &nodeBuilder{}
+	c := &directCompiler{b: b, unknown: map[string]struct{}{}}
+	r := testOperandRecipe(info.GTTNumericInput{Kind: "nested_recipe", Value: 4}, 1, 4)
+	r.Inputs[0].Recipe = r
+	budget := 512
+	got := c.compileNumericRecipePart(info.GTTTraceHit{NumericRecipe: r}, "", true, 0, &budget)
+	if got.baseline != 4 || len(got.coords) != 0 {
+		t.Fatal("cycle corrupted value")
+	}
+	if _, ok := c.unknown["numeric_recipe_nested_budget"]; !ok {
+		t.Fatal("missing cycle boundary")
+	}
+	if refs := recipeAncestorEventIDs(r); len(refs) != 0 {
+		t.Fatal(refs)
+	}
+	r.Nodes[2].Args = []int{0, 9}
+	budget = 512
+	got = c.compileNumericRecipePart(info.GTTTraceHit{NumericRecipe: r}, "", true, 0, &budget)
+	if got.baseline != 4 {
+		t.Fatal("bad node corrupted value")
+	}
+}
