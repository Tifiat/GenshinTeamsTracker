+++ b/pkg/gtttrace/health_test.go
@@ -0,0 +1,69 @@
+package gtttrace
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestHealthOperationsUseIndependentStableOrdering(t *testing.T) {
+	frame := 42
+	runtime := NewRuntime()
+	runtime.BindFrame(&frame)
+	runtime.Enable()
+	legacyOccurrences := runtime.SourceOccurrences()
+	legacyBindings := runtime.SourceValueBindings()
+	legacyTransitions := runtime.ModifierTransitions()
+
+	outerIndex, outerID := runtime.BeginHealthOperation()
+	innerIndex, innerID := runtime.BeginHealthOperation()
+	runtime.CompleteHealthOperation(innerIndex, HealthOperation{
+		Kind: HealthOperationDrain, Frame: frame,
+		Provider: UnknownProvider("test", "inner"), TargetIndex: 1,
+		ModifierContributions: []HealthModifierContribution{}, UncertaintyCodes: []string{"z", "a", "z"},
+	})
+	runtime.CompleteHealthOperation(outerIndex, HealthOperation{
+		Kind: HealthOperationHeal, Frame: frame,
+		Provider: UnknownProvider("test", "outer"), TargetIndex: 0,
+		ModifierContributions: []HealthModifierContribution{{
+			ContributionID: outerID + ":modifier:0", ModifierKey: "bonus",
+			Provider: UnknownProvider("test", "bonus"),
+		}},
+		UncertaintyCodes: []string{"b", "a"},
+	})
+
+	rows := runtime.HealthOperations()
+	if len(rows) != 2 || rows[0].SequenceIndex != 0 || rows[0].OperationID != outerID ||
+		rows[1].SequenceIndex != 1 || rows[1].OperationID != innerID {
+		t.Fatalf("unstable health identities: %#v", rows)
+	}
+	if got := rows[0].UncertaintyCodes; !reflect.DeepEqual(got, []string{"a", "b"}) {
+		t.Fatalf("uncertainty codes = %#v", got)
+	}
+	if got := rows[1].UncertaintyCodes; !reflect.DeepEqual(got, []string{"a", "z"}) {
+		t.Fatalf("nested uncertainty codes = %#v", got)
+	}
+	if !reflect.DeepEqual(runtime.SourceOccurrences(), legacyOccurrences) ||
+		!reflect.DeepEqual(runtime.SourceValueBindings(), legacyBindings) ||
+		!reflect.DeepEqual(runtime.ModifierTransitions(), legacyTransitions) {
+		t.Fatal("health ledger changed an inherited v4 collection")
+	}
+
+	rows[0].UncertaintyCodes[0] = "mutated"
+	rows[0].ModifierContributions[0].ModifierKey = "mutated"
+	again := runtime.HealthOperations()
+	if again[0].UncertaintyCodes[0] != "a" || again[0].ModifierContributions[0].ModifierKey != "bonus" {
+		t.Fatal("HealthOperations did not return a deep copy")
+	}
+}
+
+func TestHealthOperationsDisabledRuntimeIsEmpty(t *testing.T) {
+	runtime := NewRuntime()
+	index, operationID := runtime.BeginHealthOperation()
+	if index != -1 || operationID != "" {
+		t.Fatalf("disabled identity = %d/%q", index, operationID)
+	}
+	runtime.CompleteHealthOperation(0, HealthOperation{Kind: HealthOperationHeal})
+	if rows := runtime.HealthOperations(); rows == nil || len(rows) != 0 {
+		t.Fatalf("disabled rows = %#v", rows)
+	}
+}
diff --git a/pkg/gtttrace/numeric_return.go b/pkg/gtttrace/numeric_return.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/numeric_return.go
@@ -0,0 +1,55 @@
+package gtttrace
+
+// A capture belongs to one original call, not to the method's last invocation.
+// Nested calls cannot overwrite another capture; panic unwinds the stack too.
+type numericReturnCapture struct {
+	helper, source string
+	value          float64
+	reference      NumericRef
+	writes         int
+}
+
+func CaptureNumericReturn(r *Runtime, helper, source string, call func() float64) (float64, NumericRef) {
+	if !r.Enabled() {
+		v := call()
+		return v, NumericRef{}
+	}
+	depth := len(r.numericReturnCaptures)
+	if depth >= 5 {
+		v := call()
+		return v, r.frozenReturn(source, v, "helper_return_depth_boundary")
+	}
+	c := &numericReturnCapture{helper: helper, source: source}
+	r.numericReturnCaptures = append(r.numericReturnCaptures, c)
+	defer func() { r.numericReturnCaptures = r.numericReturnCaptures[:depth] }()
+	v := call()
+	if c.writes != 1 || c.value != v {
+		return v, r.frozenReturn(source, v, "helper_return_reference_missing_or_ambiguous")
+	}
+	// The executed return is known. Candidate-dependent branch changes are not
+	// inferred from the scalar receipt and stay an explicit local boundary.
+	id := r.RecordNumericEval(source, "add", []NumericRef{c.reference, LiteralRef(0)}, v, IncompleteEvidence("helper_return_control_flow_frozen"))
+	return v, EventRef(id)
+}
+
+func (r *Runtime) frozenReturn(source string, v float64, reason string) NumericRef {
+	return EventRef(r.RecordNumericEval(source, "frozen_attack_operand", nil, v, IncompleteEvidence(reason)))
+}
+
+func (r *Runtime) NumericReturnSource(helper string) (string, bool) {
+	if !r.Enabled() || len(r.numericReturnCaptures) == 0 {
+		return "", false
+	}
+	c := r.numericReturnCaptures[len(r.numericReturnCaptures)-1]
+	return c.source, c.helper == helper
+}
+
+func (r *Runtime) RecordNumericReturn(helper string, value float64, ref NumericRef) {
+	if _, ok := r.NumericReturnSource(helper); !ok {
+		return
+	}
+	c := r.numericReturnCaptures[len(r.numericReturnCaptures)-1]
+	c.writes++
+	c.value = value
+	c.reference = ref
+}
diff --git a/pkg/gtttrace/numeric_return_test.go b/pkg/gtttrace/numeric_return_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/numeric_return_test.go
@@ -0,0 +1,58 @@
+package gtttrace
+
+import "testing"
+
+func TestNumericReturnCaptureIsInvocationLocal(t *testing.T) {
+	r := NewRuntime()
+	r.Enable()
+	frame := 0
+	r.BindFrame(&frame)
+	calls := 0
+	v, ref := CaptureNumericReturn(r, "outer", "", func() float64 {
+		calls++
+		inner, _ := CaptureNumericReturn(r, "inner", "", func() float64 { r.RecordNumericReturn("inner", 7, LiteralRef(7)); return 7 })
+		r.RecordNumericReturn("outer", inner+3, LiteralRef(inner+3))
+		return inner + 3
+	})
+	if calls != 1 || v != 10 || ref.Kind != "event" || len(r.numericReturnCaptures) != 0 {
+		t.Fatal(v, ref, calls)
+	}
+	_, ref = CaptureNumericReturn(r, "outer", "", func() float64 { return 20 })
+	last := r.stateEvents[len(r.stateEvents)-1]
+	if ref.Kind != "event" || last.Operation == nil || *last.Operation != "frozen_attack_operand" {
+		t.Fatal("stale return was reused")
+	}
+	func() {
+		defer func() { _ = recover() }()
+		CaptureNumericReturn(r, "panic", "", func() float64 { panic("test") })
+	}()
+	if len(r.numericReturnCaptures) != 0 {
+		t.Fatal("panic leaked capture")
+	}
+	var disabled *Runtime
+	v, ref = CaptureNumericReturn(disabled, "x", "", func() float64 { calls++; return 3 })
+	if v != 3 || ref.Kind != "" || calls != 2 {
+		t.Fatal("disabled capture altered call")
+	}
+}
+
+func TestNumericReturnRejectsDuplicateOrMismatchedReturn(t *testing.T) {
+	for _, duplicate := range []bool{false, true} {
+		r := NewRuntime()
+		r.Enable()
+		frame := 0
+		r.BindFrame(&frame)
+		CaptureNumericReturn(r, "key", "", func() float64 {
+			r.RecordNumericReturn("key", 1, LiteralRef(1))
+			if duplicate {
+				r.RecordNumericReturn("key", 1, LiteralRef(1))
+				return 1
+			}
+			return 2
+		})
+		last := r.stateEvents[len(r.stateEvents)-1]
+		if *last.Operation != "frozen_attack_operand" {
+			t.Fatal("ambiguous return accepted")
+		}
+	}
+}
diff --git a/pkg/gtttrace/runtime.go b/pkg/gtttrace/runtime.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/runtime.go
@@ -0,0 +1,572 @@
+// Package gtttrace contains the opt-in, per-simulation source context used by
+// GTT trace-equation instrumentation. It deliberately has no dependency on the
+// simulator so core/event/task/modifier packages can share it without cycles.
+package gtttrace
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+)
+
+// Provider identifies the code-owned source that created an effect.
+// PieceCount is meaningful only for artifact sets.
+type Provider struct {
+	Known      bool   `json:"known"`
+	Kind       string `json:"kind"`
+	Key        string `json:"key"`
+	OwnerIndex int    `json:"owner_index"`
+	PieceCount int    `json:"piece_count"`
+}
+
+func NewProvider(kind, key string, ownerIndex, pieceCount int) Provider {
+	return Provider{
+		Known: true, Kind: kind, Key: key, OwnerIndex: ownerIndex,
+		PieceCount: pieceCount,
+	}
+}
+
+func UnknownProvider(kind, key string) Provider {
+	return Provider{Known: false, Kind: kind, Key: key, OwnerIndex: -1}
+}
+
+func NormalizeProvider(provider Provider) Provider {
+	if provider.Known {
+		return provider
+	}
+	kind := provider.Kind
+	if kind == "" {
+		kind = "unattributed"
+	}
+	key := provider.Key
+	if key == "" {
+		key = "unknown"
+	}
+	return UnknownProvider(kind, key)
+}
+
+func (p Provider) Complete() bool {
+	if !p.Known || p.Kind == "" || p.Key == "" {
+		return false
+	}
+	if (p.Kind == "character" || p.Kind == "weapon" || p.Kind == "set") && p.OwnerIndex < 0 {
+		return false
+	}
+	if p.Kind == "set" {
+		return p.PieceCount > 0
+	}
+	return true
+}
+
+type ModifierTransition struct {
+	Frame             int       `json:"frame"`
+	Channel           string    `json:"channel"`
+	RecipientIndex    int       `json:"recipient_index"`
+	ModifierKey       string    `json:"modifier_key"`
+	Transition        string    `json:"transition"`
+	SourceID          string    `json:"-"`
+	Provider          Provider  `json:"provider"`
+	DisplacedSourceID *string   `json:"-"`
+	DisplacedProvider *Provider `json:"displaced_provider"`
+}
+
+type ExecutionFrame struct {
+	Provider           Provider
+	SourceID           string
+	OccurrenceID       string
+	ParentOccurrenceID string
+	PendingSeam        string
+	PendingFrame       int
+}
+
+type SourceOccurrence struct {
+	SequenceIndex      int      `json:"sequence_index"`
+	OccurrenceID       string   `json:"occurrence_id"`
+	SourceID           string   `json:"source_id"`
+	Seam               string   `json:"seam"`
+	Frame              int      `json:"frame"`
+	ParentOccurrenceID *string  `json:"parent_occurrence_id"`
+	Provider           Provider `json:"provider"`
+	TerminalEventID    *string  `json:"terminal_event_id"`
+}
+
+type SourceValueParameter struct {
+	ParameterKey                string  `json:"parameter_key"`
+	Kind                        string  `json:"kind"`
+	ObservedValue               float64 `json:"observed_value"`
+	ActorIndex                  *int    `json:"actor_index"`
+	ActorKey                    *string `json:"actor_key"`
+	StatKey                     *string `json:"stat_key"`
+	ReadMode                    string  `json:"read_mode"`
+	ReadFrame                   int     `json:"read_frame"`
+	CandidateDependencyComplete bool    `json:"candidate_dependency_complete"`
+}
+
+type SourceValueBinding struct {
+	BindingID             string                 `json:"binding_id"`
+	OccurrenceID          string                 `json:"occurrence_id"`
+	TemplateSHA256        string                 `json:"template_sha256"`
+	OutputKind            string                 `json:"output_kind"`
+	TerminalEventID       *string                `json:"terminal_event_id"`
+	ProviderSequenceIndex *int                   `json:"provider_sequence_index"`
+	OutputKey             string                 `json:"output_key"`
+	ObservedValue         float64                `json:"observed_value"`
+	Parameters            []SourceValueParameter `json:"parameters"`
+}
+
+// Runtime belongs to exactly one core. Simulations may run concurrently, but
+// a single core executes its event/task callbacks serially.
+type Runtime struct {
+	enabled                           bool
+	frame                             *int
+	stack                             []ExecutionFrame
+	transitions                       []ModifierTransition
+	nextNodeID                        uint64
+	sourceOccurrences                 []SourceOccurrence
+	sourceValueBindings               []SourceValueBinding
+	healthOperations                  []HealthOperation
+	stateSlots                        []StateSlot
+	stateEvents                       []StateEvent
+	occurrenceIndex                   map[string]int
+	bindingOrdinals                   map[string]int
+	stateSlotIndex                    map[string]int
+	stateSlotValues                   map[string]float64
+	stateEventStack                   []string
+	healthContextStack                []string
+	modifierEvalCaptures              []modifierEvalCapture
+	modifierAmountDepth               int
+	nextModifierCaptureToken          int
+	numericDependencyCaptures         []numericDependencyCapture
+	nextNumericDependencyCaptureToken int
+	helperNumericContexts             [][]NumericPayload
+	numericReturnCaptures             []*numericReturnCapture
+	savedStatCells                    map[*float64]savedStatCell
+	taskNumericContexts               [][]NumericPayload
+	nextTaskQueueID                   uint64
+	nextTaskID                        uint64
+}
+
+func (r *Runtime) BindFrame(frame *int) {
+	if r != nil {
+		r.frame = frame
+	}
+}
+
+func (r *Runtime) Frame() int {
+	if r == nil || r.frame == nil {
+		return -1
+	}
+	return *r.frame
+}
+
+// NextNodeID returns a simulation-local stable identity for traced persistent
+// state and gadgets. Zero is reserved for tracing-disabled execution.
+func (r *Runtime) NextNodeID() uint64 {
+	if !r.Enabled() {
+		return 0
+	}
+	r.nextNodeID++
+	return r.nextNodeID
+}
+
+func NewRuntime() *Runtime {
+	return &Runtime{
+		stack:                     make([]ExecutionFrame, 0, 8),
+		transitions:               make([]ModifierTransition, 0, 32),
+		sourceOccurrences:         make([]SourceOccurrence, 0, 256),
+		sourceValueBindings:       make([]SourceValueBinding, 0, 256),
+		healthOperations:          make([]HealthOperation, 0, 64),
+		stateSlots:                make([]StateSlot, 0, 16),
+		stateEvents:               make([]StateEvent, 0, 512),
+		occurrenceIndex:           make(map[string]int),
+		bindingOrdinals:           make(map[string]int),
+		stateSlotIndex:            make(map[string]int),
+		stateSlotValues:           make(map[string]float64),
+		stateEventStack:           make([]string, 0, 16),
+		healthContextStack:        make([]string, 0, 4),
+		modifierEvalCaptures:      make([]modifierEvalCapture, 0, 4),
+		numericDependencyCaptures: make([]numericDependencyCapture, 0, 4),
+		helperNumericContexts:     make([][]NumericPayload, 0, 4),
+		taskNumericContexts:       make([][]NumericPayload, 0, 4),
+	}
+}
+
+func (r *Runtime) Enable() {
+	if r != nil {
+		r.enabled = true
+	}
+}
+
+func (r *Runtime) Enabled() bool {
+	return r != nil && r.enabled
+}
+
+func (r *Runtime) Current() Provider {
+	if !r.Enabled() {
+		return Provider{}
+	}
+	if len(r.stack) == 0 {
+		return UnknownProvider("unattributed_context", "no_active_provider")
+	}
+	return r.stack[len(r.stack)-1].Provider
+}
+
+func (r *Runtime) CurrentSourceID() string {
+	if !r.Enabled() || len(r.stack) == 0 {
+		return ""
+	}
+	return r.stack[len(r.stack)-1].SourceID
+}
+
+func (r *Runtime) CurrentOccurrenceID() string {
+	if !r.Enabled() || len(r.stack) == 0 {
+		return ""
+	}
+	return r.stack[len(r.stack)-1].OccurrenceID
+}
+
+// EnsureCurrentOccurrence materializes a lazily-entered callback only when a
+// traced descendant or value actually needs its lineage. This prevents idle
+// per-frame hooks from inflating the trace by thousands of rows.
+func (r *Runtime) EnsureCurrentOccurrence() string {
+	if !r.Enabled() || len(r.stack) == 0 {
+		return ""
+	}
+	return r.ensureFrameOccurrence(len(r.stack) - 1)
+}
+
+// Enter installs provider until the returned restore function is called.
+func (r *Runtime) Enter(provider Provider) func() {
+	return r.EnterSource(provider, "")
+}
+
+// EnterSource installs a runtime owner and a separately versioned code-source
+// identity. Unknown source identity is represented by the empty string and is
+// never synthesized from provider/modifier/ability names.
+func (r *Runtime) EnterSource(provider Provider, sourceID string) func() {
+	return r.EnterSourceOccurrence(provider, sourceID, "", "")
+}
+
+func (r *Runtime) EnterLazySourceOccurrence(
+	provider Provider,
+	sourceID string,
+	seam string,
+	frame int,
+) func() {
+	if !r.Enabled() {
+		return func() {}
+	}
+	provider = NormalizeProvider(provider)
+	if !gttsource.ValidID(sourceID) || !validSourceSeam(seam) {
+		sourceID = ""
+		seam = ""
+	}
+	depth := len(r.stack)
+	r.stack = append(r.stack, ExecutionFrame{
+		Provider: provider, SourceID: sourceID,
+		PendingSeam: seam, PendingFrame: frame,
+	})
+	return func() {
+		if len(r.stack) >= depth {
+			r.stack = r.stack[:depth]
+		}
+	}
+}
+
+func (r *Runtime) EnterSourceOccurrence(
+	provider Provider,
+	sourceID string,
+	occurrenceID string,
+	parentOccurrenceID string,
+) func() {
+	if !r.Enabled() {
+		return func() {}
+	}
+	provider = NormalizeProvider(provider)
+	if !gttsource.ValidID(sourceID) {
+		sourceID = ""
+	}
+	if parentOccurrenceID == "" && len(r.stack) > 0 {
+		parentOccurrenceID = r.stack[len(r.stack)-1].OccurrenceID
+	}
+	depth := len(r.stack)
+	r.stack = append(r.stack, ExecutionFrame{
+		Provider: provider, SourceID: sourceID,
+		OccurrenceID: occurrenceID, ParentOccurrenceID: parentOccurrenceID,
+	})
+	return func() {
+		if len(r.stack) >= depth {
+			r.stack = r.stack[:depth]
+		}
+	}
+}
+
+func (r *Runtime) RecordSourceOccurrence(
+	seam string,
+	sourceID string,
+	frame int,
+	provider Provider,
+	parentOccurrenceID string,
+) string {
+	if !r.Enabled() || !gttsource.ValidID(sourceID) || !validSourceSeam(seam) {
+		return ""
+	}
+	if parentOccurrenceID == "" {
+		parentOccurrenceID = r.EnsureCurrentOccurrence()
+	}
+	if parentOccurrenceID != "" {
+		if _, ok := r.occurrenceIndex[parentOccurrenceID]; !ok {
+			parentOccurrenceID = ""
+		}
+	}
+	sequenceIndex := len(r.sourceOccurrences)
+	occurrenceID := "source-occurrence:" + strconv.Itoa(sequenceIndex)
+	row := SourceOccurrence{
+		SequenceIndex: sequenceIndex,
+		OccurrenceID:  occurrenceID,
+		SourceID:      sourceID,
+		Seam:          seam,
+		Frame:         frame,
+		Provider:      NormalizeProvider(provider),
+	}
+	if parentOccurrenceID != "" {
+		parent := parentOccurrenceID
+		row.ParentOccurrenceID = &parent
+	}
+	r.occurrenceIndex[occurrenceID] = sequenceIndex
+	r.sourceOccurrences = append(r.sourceOccurrences, row)
+	return occurrenceID
+}
+
+func (r *Runtime) ensureFrameOccurrence(index int) string {
+	if index < 0 || index >= len(r.stack) {
+		return ""
+	}
+	frame := &r.stack[index]
+	if frame.OccurrenceID != "" {
+		return frame.OccurrenceID
+	}
+	if frame.PendingSeam == "" || !gttsource.ValidID(frame.SourceID) {
+		if index > 0 {
+			return r.ensureFrameOccurrence(index - 1)
+		}
+		return ""
+	}
+	parentOccurrenceID := frame.ParentOccurrenceID
+	if parentOccurrenceID == "" && index > 0 {
+		parentOccurrenceID = r.ensureFrameOccurrence(index - 1)
+	}
+	occurrenceID := r.recordSourceOccurrence(
+		frame.PendingSeam, frame.SourceID, frame.PendingFrame,
+		frame.Provider, parentOccurrenceID,
+	)
+	frame.OccurrenceID = occurrenceID
+	frame.ParentOccurrenceID = parentOccurrenceID
+	return occurrenceID
+}
+
+func (r *Runtime) recordSourceOccurrence(
+	seam string,
+	sourceID string,
+	frame int,
+	provider Provider,
+	parentOccurrenceID string,
+) string {
+	sequenceIndex := len(r.sourceOccurrences)
+	occurrenceID := "source-occurrence:" + strconv.Itoa(sequenceIndex)
+	row := SourceOccurrence{
+		SequenceIndex: sequenceIndex,
+		OccurrenceID:  occurrenceID,
+		SourceID:      sourceID,
+		Seam:          seam,
+		Frame:         frame,
+		Provider:      NormalizeProvider(provider),
+	}
+	if parentOccurrenceID != "" {
+		parent := parentOccurrenceID
+		row.ParentOccurrenceID = &parent
+	}
+	r.occurrenceIndex[occurrenceID] = sequenceIndex
+	r.sourceOccurrences = append(r.sourceOccurrences, row)
+	return occurrenceID
+}
+
+func (r *Runtime) BindOccurrenceTerminal(occurrenceID, terminalEventID string) {
+	if !r.Enabled() || occurrenceID == "" || terminalEventID == "" {
+		return
+	}
+	index, ok := r.occurrenceIndex[occurrenceID]
+	if !ok {
+		return
+	}
+	terminal := terminalEventID
+	r.sourceOccurrences[index].TerminalEventID = &terminal
+}
+
+func (r *Runtime) RecordSourceValueBinding(
+	occurrenceID string,
+	templateSHA256 string,
+	outputKind string,
+	terminalEventID *string,
+	providerSequenceIndex *int,
+	outputKey string,
+	observedValue float64,
+	parameters []SourceValueParameter,
+) string {
+	if !r.Enabled() || !validSHA256(templateSHA256) || !validOutputKind(outputKind) || outputKey == "" {
+		return ""
+	}
+	occurrenceSequence, ok := r.occurrenceIndex[occurrenceID]
+	if !ok {
+		return ""
+	}
+	ordinal := r.bindingOrdinals[occurrenceID]
+	r.bindingOrdinals[occurrenceID] = ordinal + 1
+	bindingID := "source-binding:" + strconv.Itoa(occurrenceSequence) + ":" + strconv.Itoa(ordinal)
+	clonedParameters := append(make([]SourceValueParameter, 0, len(parameters)), parameters...)
+	r.sourceValueBindings = append(r.sourceValueBindings, SourceValueBinding{
+		BindingID: bindingID, OccurrenceID: occurrenceID, TemplateSHA256: templateSHA256,
+		OutputKind: outputKind, TerminalEventID: cloneString(terminalEventID),
+		ProviderSequenceIndex: cloneInt(providerSequenceIndex), OutputKey: outputKey,
+		ObservedValue: observedValue, Parameters: clonedParameters,
+	})
+	return bindingID
+}
+
+func (r *Runtime) SourceOccurrences() []SourceOccurrence {
+	if r == nil || len(r.sourceOccurrences) == 0 {
+		return []SourceOccurrence{}
+	}
+	out := make([]SourceOccurrence, len(r.sourceOccurrences))
+	copy(out, r.sourceOccurrences)
+	return out
+}
+
+func (r *Runtime) SourceValueBindings() []SourceValueBinding {
+	if r == nil || len(r.sourceValueBindings) == 0 {
+		return []SourceValueBinding{}
+	}
+	out := make([]SourceValueBinding, len(r.sourceValueBindings))
+	copy(out, r.sourceValueBindings)
+	for index := range out {
+		out[index].Parameters = append([]SourceValueParameter{}, out[index].Parameters...)
+	}
+	return out
+}
+
+func validSourceSeam(seam string) bool {
+	switch seam {
+	case gttsource.KindModifierAmount, gttsource.KindEventCallback,
+		gttsource.KindTaskCallback, gttsource.KindQueuedAttack:
+		return true
+	default:
+		return false
+	}
+}
+
+func validOutputKind(kind string) bool {
+	switch kind {
+	case "attack_mod_stat", "terminal_flat_dmg", "diagnostic_scalar":
+		return true
+	default:
+		return false
+	}
+}
+
+func validSHA256(value string) bool {
+	if len(value) != 64 {
+		return false
+	}
+	for _, char := range value {
+		if (char < '0' || char > '9') && (char < 'a' || char > 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func cloneString(value *string) *string {
+	if value == nil {
+		return nil
+	}
+	cloned := *value
+	return &cloned
+}
+
+func cloneInt(value *int) *int {
+	if value == nil {
+		return nil
+	}
+	cloned := *value
+	return &cloned
+}
+
+func (r *Runtime) RecordModifierTransition(row ModifierTransition) {
+	if !r.Enabled() {
+		return
+	}
+	row.Provider = NormalizeProvider(row.Provider)
+	if !gttsource.ValidID(row.SourceID) {
+		row.SourceID = ""
+	}
+	if row.DisplacedSourceID != nil {
+		displacedSourceID := *row.DisplacedSourceID
+		if !gttsource.ValidID(displacedSourceID) {
+			displacedSourceID = ""
+		}
+		row.DisplacedSourceID = &displacedSourceID
+	}
+	if row.DisplacedProvider != nil {
+		displaced := NormalizeProvider(*row.DisplacedProvider)
+		row.DisplacedProvider = &displaced
+	}
+	r.transitions = append(r.transitions, row)
+}
+
+func (r *Runtime) ModifierTransitions() []ModifierTransition {
+	if r == nil || len(r.transitions) == 0 {
+		return []ModifierTransition{}
+	}
+	out := make([]ModifierTransition, len(r.transitions))
+	copy(out, r.transitions)
+	// Initialization of independent set factories may originate from Go maps.
+	// The receipt is an evidence catalog, not an execution log, so emit a
+	// canonical order while leaving actual simulator execution untouched.
+	sort.SliceStable(out, func(i, j int) bool {
+		left, right := out[i], out[j]
+		if left.Frame != right.Frame {
+			return left.Frame < right.Frame
+		}
+		if left.Channel != right.Channel {
+			return left.Channel < right.Channel
+		}
+		if left.RecipientIndex != right.RecipientIndex {
+			return left.RecipientIndex < right.RecipientIndex
+		}
+		if left.ModifierKey != right.ModifierKey {
+			return left.ModifierKey < right.ModifierKey
+		}
+		if left.Transition != right.Transition {
+			return left.Transition < right.Transition
+		}
+		// Preserve the frozen v2/v3 wire ordering. Source IDs are additive v4
+		// evidence and must not reorder an existing provider-transition array.
+		leftKey := providerSortKey(left.Provider) + "\x00" + optionalProviderSortKey(left.DisplacedProvider)
+		rightKey := providerSortKey(right.Provider) + "\x00" + optionalProviderSortKey(right.DisplacedProvider)
+		return leftKey < rightKey
+	})
+	return out
+}
+
+func providerSortKey(p Provider) string {
+	return fmt.Sprintf("%t\x00%s\x00%s\x00%011d\x00%011d", p.Known, p.Kind, p.Key, p.OwnerIndex, p.PieceCount)
+}
+
+func optionalProviderSortKey(p *Provider) string {
+	if p == nil {
+		return "<nil>"
+	}
+	return providerSortKey(*p)
+}
