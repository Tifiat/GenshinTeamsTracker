@@ -0,0 +1,33 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"testing"
+)
+
+// A foreign stat read belongs to its typed receiver, never to the callback
+// provider. The same rule must bind the reusable base-HP snapshot.
+func TestMaxHPTypedOwnerNotExecutingProvider(t *testing.T) {
+	owner := 1
+	event := gtttrace.StateEvent{EventID: "foreign-hp", OwnerIndex: &owner, Provider: gtttrace.Provider{Key: "caller"}, Output: map[string]float64{"base_hp": 1000, "hp%": .2, "hp": 100, "max_hp": 1300}}
+	c := supportCompiler{b: &nodeBuilder{}, characterKeys: []string{"caller", "receiver"}, unknown: map[string]struct{}{}, eventOutputs: map[string]map[string]compiledNode{}}
+	actor, ok := c.maxHPOwner(event)
+	if !ok || actor != "receiver" {
+		t.Fatal(actor, ok)
+	}
+	c.compileMaxHPRead(event)
+	root := c.eventOutputs[event.EventID]["max_hp"]
+	if got := evalContributorGraph(t, c.b, root, map[string]float64{"receiver.hp_percent": .5, "caller.hp_percent": 99}); got != 1800 {
+		t.Fatal(got)
+	}
+	for _, index := range []*int{nil, func() *int { v := -1; return &v }(), func() *int { v := 2; return &v }()} {
+		event.OwnerIndex = index
+		c.compileMaxHPRead(event)
+		if got := evalContributorGraph(t, c.b, c.eventOutputs[event.EventID]["max_hp"], map[string]float64{"caller.hp_percent": 99, "receiver.hp_percent": .5}); got != 1300 {
+			t.Fatal(got)
+		}
+		if _, ok := c.unknown["max_hp_stat_owner_unresolved"]; !ok {
+			t.Fatal("missing explicit owner boundary")
+		}
+	}
+}
diff --git a/pkg/gttcompact/model.go b/pkg/gttcompact/model.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/model.go
@@ -0,0 +1,65 @@
+// Package gttcompact compiles the opt-in equation trace into the stable,
+// engine-neutral seed-member boundary consumed by GenshinTeamsTracker. It owns
+// no artifact search or candidate ranking.
+package gttcompact
+
+type IRInput struct {
+	NodeID   uint32 `json:"node_id"`
+	Relation string `json:"relation"`
+}
+
+type IRNode struct {
+	NodeID     uint32    `json:"node_id"`
+	Operation  string    `json:"operation"`
+	Inputs     []IRInput `json:"inputs"`
+	Value      string    `json:"value,omitempty"`
+	Coordinate string    `json:"coordinate,omitempty"`
+}
+
+type IRChannel struct {
+	ChannelID           string   `json:"channel_id"`
+	Kind                string   `json:"kind"`
+	ActorKey            string   `json:"actor_key"`
+	AttackTag           string   `json:"attack_tag"`
+	DamageType          string   `json:"damage_type"`
+	RootNodeID          uint32   `json:"root_node_id"`
+	HitCount            int      `json:"hit_count"`
+	BaselineDamage      string   `json:"baseline_damage"`
+	ResponseCoordinates []string `json:"response_coordinates"`
+}
+
+type IROpaqueBoundary struct {
+	BoundaryID          string `json:"boundary_id"`
+	NodeID              uint32 `json:"node_id"`
+	ReasonCode          string `json:"reason_code"`
+	BaselineDamage      string `json:"baseline_damage"`
+	BaselineDamageShare string `json:"baseline_damage_share"`
+}
+
+type IRSeedMember struct {
+	Seed             uint64             `json:"seed"`
+	DurationMS       int64              `json:"duration_ms"`
+	TopologySHA256   string             `json:"topology_sha256"`
+	Nodes            []IRNode           `json:"nodes"`
+	Channels         []IRChannel        `json:"channels"`
+	OpaqueBoundaries []IROpaqueBoundary `json:"opaque_boundaries"`
+}
+
+// Audit is not serialized into the optimizer contract. The engine command may
+// include it in a GOB-2 receipt, and tests use it to prove that compaction did
+// not silently discard an executed path.
+type Audit struct {
+	ResistanceInputs        []ResistanceInput `json:"resistance_inputs,omitempty"`
+	EffectInputs            []EffectInput
+	SourceHitCount          int
+	AncestorStateEventCount int
+	NodeCount               int
+	ChannelCount            int
+	OpaqueReasonCount       int
+	BaselineDamage          float64
+	AdapterElapsedNS        int64
+	HeapInuseStartBytes     uint64
+	HeapInusePeakBytes      uint64
+	HeapInuseEndBytes       uint64
+	TotalAllocDeltaBytes    uint64
+}
diff --git a/pkg/gttcompact/numeric_recipe.go b/pkg/gttcompact/numeric_recipe.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/numeric_recipe.go
@@ -0,0 +1,183 @@
+package gttcompact
+
+import (
+	"encoding/hex"
+	"math"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+func (c *directCompiler) compileNumericRecipe(hit info.GTTTraceHit, actor string) compiledNode {
+	budget := 512
+	return c.compileNumericRecipePart(hit, actor, false, 0, &budget)
+}
+
+func (c *directCompiler) compileNumericRecipePart(hit info.GTTTraceHit, actor string, operand bool, depth int, budget *int, preCrit ...bool) compiledNode {
+	scalar := operand || (len(preCrit) == 1 && preCrit[0])
+	r := hit.NumericRecipe
+	fail := func(reason string) compiledNode {
+		c.unknown["numeric_recipe_"+reason] = struct{}{}
+		if scalar && r != nil {
+			return c.b.constant(r.Observed)
+		}
+		return c.b.constant(expectedFallbackDamage(hit))
+	}
+	if r == nil || r.Version != info.GTTNumericRecipeVersion || len(r.Nodes) == 0 || len(r.Nodes) > 128 || len(r.Inputs) > 32 {
+		return fail("invalid_contract")
+	}
+	*budget -= len(r.Nodes) + len(r.Inputs) + 1
+	if depth > 5 || *budget < 0 {
+		return fail("nested_budget")
+	}
+	hash, err := hex.DecodeString(r.SourceSHA256)
+	if err != nil || len(hash) != 32 || (!operand && (hit.ActorIndex < 0 || hit.ActorIndex >= len(c.characterKeys))) {
+		return fail("invalid_provenance")
+	}
+	dynamic := c.dynamicStatDeltas(hit)
+	stat := func(key string, value float64) compiledNode {
+		n := c.b.add(c.b.constant(value), c.b.artifactDelta(actor, key))
+		if delta, ok := dynamic[key]; ok {
+			n = c.b.add(n, delta)
+		}
+		return n
+	}
+	inputs := make([]compiledNode, len(r.Inputs))
+	for i, p := range r.Inputs {
+		if math.IsNaN(p.Value) || math.IsInf(p.Value, 0) {
+			return fail("nonfinite_input")
+		}
+		n := c.b.constant(p.Value)
+		if operand && p.Kind != "reference" && p.Kind != "nested_recipe" && p.Kind != "fixed" && p.Kind != "frozen" {
+			return fail("operand_binding_kind")
+		}
+		switch p.Kind {
+		case "context_resistance_multiplier":
+			if operand || !closeEnough(p.Value, hit.ResMod) {
+				return fail("context_resistance_binding")
+			}
+			n = c.resistanceInput(hit)
+		case "fixed":
+			// Explicit fixed input: e.g. level data outside artifact coordinates.
+		case "reference":
+			resolved := false
+			if p.Reference.Kind == "event" && p.Reference.EventID != nil {
+				if p.Reference.FieldKey != nil {
+					n, resolved = c.support.eventOutputs[*p.Reference.EventID][*p.Reference.FieldKey]
+				} else {
+					n, resolved = c.support.eventNodes[*p.Reference.EventID]
+				}
+			} else if p.Reference.Kind == "literal" && p.Reference.LiteralValue != nil {
+				n = c.b.constant(*p.Reference.LiteralValue)
+				resolved = true
+			}
+			if !resolved || !closeEnough(n.baseline, p.Value) {
+				c.unknown["numeric_recipe_reference_unresolved"] = struct{}{}
+				n = c.b.constant(p.Value)
+			}
+		case "nested_recipe":
+			if p.Recipe == nil || !closeEnough(p.Recipe.Observed, p.Value) {
+				c.unknown["numeric_recipe_child_unresolved"] = struct{}{}
+			} else {
+				n = c.compileNumericRecipePart(info.GTTTraceHit{NumericRecipe: p.Recipe}, "", true, depth+1, budget)
+			}
+		case "scaling":
+			if !closeEnough(p.Value, hit.ScalingStatValue) {
+				return fail("scaling_binding_mismatch")
+			}
+			switch hit.ScalingStatKind {
+			case "atk":
+				n = c.scalingStat(p.Value, hit.SnapshotStats["base_atk"], actor, "atk%", "atk", dynamic)
+			case "hp":
+				n = c.scalingStat(p.Value, hit.SnapshotStats["base_hp"], actor, "hp%", "hp", dynamic)
+			case "def":
+				n = c.scalingStat(p.Value, hit.SnapshotStats["base_def"], actor, "def%", "def", dynamic)
+			case "em":
+				n = stat("em", p.Value)
+			default:
+				return fail("scaling_kind_unbound")
+			}
+		case "snapshot_stat":
+			observed, ok := hit.SnapshotStats[p.StatKey]
+			if !ok || !artifactVariableStat(p.StatKey) || !closeEnough(observed, p.Value) {
+				return fail("snapshot_binding_mismatch")
+			}
+			n = stat(p.StatKey, p.Value)
+		case "flat_damage":
+			if !closeEnough(p.Value, hit.FlatDmg) {
+				return fail("flat_binding_mismatch")
+			}
+			n = c.compileTerminalFlat(hit, actor, dynamic)
+		case "attack_field":
+			if p.StatKey != "BaseDmgBonus" || !closeEnough(p.Value, hit.BaseDmgBonus) {
+				return fail("attack_field_binding_mismatch")
+			}
+			n = c.compileBaseBonus(hit)
+		case "frozen":
+			// Keep the local source boundary explicit, including a zero baseline:
+			// zero observed value does not prove candidate independence.
+			c.unknown["numeric_recipe_input_frozen:"+p.Source] = struct{}{}
+		default:
+			return fail("input_kind_unbound")
+		}
+		inputs[i] = n
+	}
+	nodes := make([]compiledNode, len(r.Nodes))
+	for i, row := range r.Nodes {
+		for _, id := range row.Args {
+			if id < 0 || id >= i {
+				return fail("node_order_invalid")
+			}
+		}
+		var n compiledNode
+		switch row.Op {
+		case "CONST":
+			if len(row.Args) != 0 || math.IsNaN(row.Value) || math.IsInf(row.Value, 0) {
+				return fail("constant_invalid")
+			}
+			n = c.b.constant(row.Value)
+		case "INPUT":
+			if len(row.Args) != 0 || row.Input < 0 || row.Input >= len(inputs) {
+				return fail("input_invalid")
+			}
+			n = inputs[row.Input]
+		case "ADD", "SUB", "MUL", "DIV":
+			if len(row.Args) != 2 {
+				return fail("arity_invalid")
+			}
+			a, b := nodes[row.Args[0]], nodes[row.Args[1]]
+			switch row.Op {
+			case "ADD":
+				n = c.b.add(a, b)
+			case "SUB":
+				n = c.b.subtract(a, b)
+			case "MUL":
+				n = c.b.multiply(a, b)
+			case "DIV":
+				if b.baseline == 0 {
+					return fail("zero_divisor")
+				}
+				n = c.b.divide(a, b)
+			}
+		default:
+			return fail("operator_unsupported")
+		}
+		if math.IsNaN(n.baseline) || math.IsInf(n.baseline, 0) {
+			return fail("nonfinite_node")
+		}
+		nodes[i] = n
+	}
+	if r.Root < 0 || r.Root >= len(nodes) || !closeEnough(nodes[r.Root].baseline, r.Observed) {
+		return fail("baseline_mismatch")
+	}
+	if scalar {
+		return nodes[r.Root]
+	}
+	cr, cd := stat("cr", hit.RawCritRate), stat("cd", hit.CritDamage)
+	crit := c.b.add(c.b.constant(1), c.b.multiply(c.b.min(c.b.constant(1), c.b.max(c.b.constant(0), cr)), cd))
+	if hit.HitWeakPoint {
+		crit = c.b.add(c.b.constant(1), cd)
+	}
+	// No damage-type bonus is invented here. Only upstream recipe operations
+	// are replayed; expected crit replaces the terminal engine RNG separately.
+	return c.b.multiply(nodes[r.Root], crit)
+}
