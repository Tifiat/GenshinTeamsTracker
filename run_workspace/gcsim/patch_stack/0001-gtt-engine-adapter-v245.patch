+++ b/pkg/gttsourcegen/contributor_group_test.go
@@ -0,0 +1,60 @@
+package gttsourcegen
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestContributorProtocolFullTree(t *testing.T) {
+	data, err := os.ReadFile(filepath.Join("..", "reactable", "lunarcharged.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert := func(name string, src []byte, want bool) {
+		t.Helper()
+		out, e := rewriteContributorGroups("renamed/producer.go", src)
+		if e != nil {
+			t.Fatal(name, e)
+		}
+		s := string(out)
+		// Check the replacement directly, independent of gofmt spaces.
+		line := ""
+		for _, l := range strings.Split(s, "\n") {
+			if strings.Contains(l, "GTTAttachContributorGroup(") {
+				line = l
+			}
+		}
+		sealed := line != "" && !strings.Contains(line, `,""`) && !strings.Contains(line, `, ""`)
+		if sealed != want {
+			t.Fatalf("%s sealed=%v want=%v line=%s", name, sealed, want, line)
+		}
+	}
+	assert("official", data, true)
+	lcr, err := os.ReadFile(filepath.Join("..", "reactable", "lunarcrystallize.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	assert("free function indexed reducer", lcr, true)
+	assert("free function renamed", []byte(strings.NewReplacer("core *core.Core", "sim *core.Core", "core.", "sim.", "*sim.Core", "*core.Core", "contributions", "rows", "lcrContributorMult", "weights").Replace(string(lcr))), true)
+	assert("incorrect pointer alias", []byte(strings.Replace(string(lcr), "&contributions[i]", "&contributions[0]", 1)), false)
+	assert("pointer mutation", []byte(strings.Replace(string(lcr), "contr := &contributions[i]", "contr := &contributions[i]; contr.dmg += 10", 1)), false)
+	renamed := strings.NewReplacer("contributions", "items", "lcContribution", "partRow", "totalDmg", "amount", "preCrit", "before", "isCrit", "critical", "lcContributorMult", "ranks").Replace(string(data))
+	assert("renamed", []byte(renamed), true)
+	assert("new weights", []byte(strings.Replace(string(data), "0.6, 0.3, 0.05, 0.05", "0.51, 0.27, 0.17, 0.05", 1)), true)
+	for name, pair := range map[string][2]string{
+		"dynamic weights":   {"[]float64{0.6, 0.3, 0.05, 0.05}", "loadWeights()"},
+		"ascending":         {"j.dmg - i.dmg", "i.dmg - j.dmg"},
+		"crit scale":        {"(1 + cd)", "(1 + 2*cd)"},
+		"coupled roll":      {"r.core.Rand.Float64()", "0.5"},
+		"changed reduction": {"contr.dmg * lcContributorMult[i]", "contr.dmg + lcContributorMult[i]"},
+		"extra write":       {"preCrit := totalDmg", "totalDmg += 10\n preCrit := totalDmg\n totalDmg += 20"},
+	} {
+		changed := strings.ReplaceAll(string(data), pair[0], pair[1])
+		if changed == string(data) {
+			t.Fatal("mutation missed", name)
+		}
+		assert(name, []byte(changed), false)
+	}
+}
diff --git a/pkg/gttsourcegen/flat_helper.go b/pkg/gttsourcegen/flat_helper.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/flat_helper.go
@@ -0,0 +1,240 @@
+package gttsourcegen
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"go/ast"
+	"go/token"
+	"path"
+	"strconv"
+	"strings"
+)
+
+// Build-local proof: a zero-argument scalar method on the same typed receiver,
+// directly used as FlatDmg. No gameplay identifiers participate in selection.
+type flatHelperPlan struct {
+	File, Method, Key string
+	Line              int
+}
+
+func bindFlatHelpers(fset *token.FileSet, files []parsedSourceFile, candidates []sourceCandidate) {
+	methods := map[string][]receiverMethod{}
+	functions := []enclosingFunction{}
+	for _, source := range files {
+		for _, decl := range source.file.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok || fn.Body == nil {
+				continue
+			}
+			typ, receiver := receiverIdentity(fset, fn)
+			functions = append(functions, enclosingFunction{rel: source.rel, packageDir: path.Dir(source.rel), receiverType: typ, receiverName: receiver, decl: fn})
+			if typ != "" {
+				key := methodLookupKey(path.Dir(source.rel), typ, fn.Name.Name)
+				methods[key] = append(methods[key], receiverMethod{rel: source.rel, decl: fn, receiverName: receiver})
+			}
+		}
+	}
+	for i := range candidates {
+		c := &candidates[i]
+		if c.kind != KindQueuedAttack || c.traceRuntimePath == "" || c.forwardedAttack != nil || c.template.template.Status == TemplateSupported {
+			continue
+		}
+		if c.template.template.StopReasonCode == nil || *c.template.template.StopReasonCode != "unsupported_call" {
+			continue
+		}
+		owner := findEnclosingFunction(fset, functions, c.relativeFile, c.line)
+		if owner == nil {
+			continue
+		}
+		lit, ok := c.root.(*ast.CompositeLit)
+		if !ok {
+			continue
+		}
+		field := compositeKeyValue(lit, "FlatDmg")
+		if field == nil {
+			continue
+		}
+		call, ok := field.Value.(*ast.CallExpr)
+		if !ok || len(call.Args) != 0 {
+			continue
+		}
+		method, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			continue
+		}
+		receiver, ok := method.X.(*ast.Ident)
+		if !ok || receiver.Name != owner.receiverName {
+			continue
+		}
+		matches := methods[methodLookupKey(owner.packageDir, owner.receiverType, method.Sel.Name)]
+		if len(matches) != 1 || matches[0].decl == owner.decl || !boundedScalarReturn(matches[0].decl) {
+			continue
+		}
+		m := matches[0]
+		sum := sha256.Sum256([]byte(m.rel + "|" + rootText(fset, m.decl)))
+		c.flatHelper = &flatHelperPlan{File: m.rel, Method: m.decl.Name.Name, Line: fset.Position(m.decl.Pos()).Line, Key: fmt.Sprintf("%x", sum)}
+	}
+}
+
+func boundedScalarReturn(fn *ast.FuncDecl) bool {
+	if fn.Type.Params.NumFields() != 0 || fn.Type.Results == nil || len(fn.Type.Results.List) != 1 || len(fn.Type.Results.List[0].Names) != 0 {
+		return false
+	}
+	typ, ok := fn.Type.Results.List[0].Type.(*ast.Ident)
+	if !ok || typ.Name != "float64" {
+		return false
+	}
+	returns, visits := 0, 0
+	valid := true
+	ast.Inspect(fn.Body, func(n ast.Node) bool {
+		if n == nil {
+			return true
+		}
+		visits++
+		if visits > 128 {
+			valid = false
+			return false
+		}
+		switch v := n.(type) {
+		case *ast.FuncLit, *ast.ForStmt, *ast.RangeStmt, *ast.GoStmt, *ast.DeferStmt, *ast.BranchStmt:
+			valid = false
+			return false
+		case *ast.ReturnStmt:
+			returns++
+			if len(v.Results) != 1 {
+				valid = false
+			}
+		}
+		return true
+	})
+	return valid && returns > 0 && returns <= 8
+}
+
+func flatHelperCallEdits(fset *token.FileSet, tf *token.File, data []byte, fn *ast.FuncDecl, lit *ast.CompositeLit, entry SourceEntry) ([]textEdit, error) {
+	field := compositeKeyValue(lit, "FlatDmg")
+	statement := containingStatement(fn.Body, lit)
+	if field == nil || statement == nil || compositeKeyValue(lit, "GTTFlatProducer") != nil {
+		return nil, fmt.Errorf("flat helper call shape changed")
+	}
+	rt, ok := entryTraceExpression(receiverName(fn), entry)
+	if !ok {
+		return nil, fmt.Errorf("flat helper trace owner unavailable")
+	}
+	qual := expressionQualifier(lit.Type)
+	prefix := "gttFlatReturn_" + entry.SourceID[:12]
+	// Only metadata storage is declared before the statement. The helper call
+	// stays at its original field position, after any earlier field effects.
+	decl := fmt.Sprintf("var %s *%s.GTTFlatProducer;\n%s", prefix, qual, indentationBefore(data, tf.Offset(statement.Pos())))
+	call := fmt.Sprintf("func()float64{value,ref := %s.CaptureNumericReturn(%s,%q,%q,func()float64{return %s});if ref.Kind!=\"\"{%s=&%s.GTTFlatProducer{Value:value,Reference:ref}};return value}()", traceImportAlias, rt, entry.flatHelper.Key, entry.SourceID, rootText(fset, field.Value), prefix, qual)
+	metadata := ",GTTFlatProducer:" + prefix + ","
+	// A literal may already end in a comma; insert after its last field using
+	// the same delimiter contract as the existing source-metadata overlay.
+	if len(lit.Elts) > 0 {
+		last := tf.Offset(lit.Elts[len(lit.Elts)-1].End())
+		end := tf.Offset(lit.Rbrace)
+		for _, b := range data[last:end] {
+			if b == ',' {
+				metadata = metadata[1:]
+				break
+			}
+		}
+	}
+	return []textEdit{{start: tf.Offset(statement.Pos()), end: tf.Offset(statement.Pos()), replacement: decl},
+		{start: tf.Offset(field.Value.Pos()), end: tf.Offset(field.Value.End()), replacement: call},
+		{start: tf.Offset(lit.Rbrace), end: tf.Offset(lit.Rbrace), replacement: metadata}}, nil
+}
+
+func flatHelperBodyEdits(fset *token.FileSet, tf *token.File, data []byte, rel string, file *ast.File, wanted []SourceEntry) ([]textEdit, bool, error) {
+	byLine := map[int]SourceEntry{}
+	for _, entry := range wanted {
+		if entry.flatHelper != nil && entry.flatHelper.File == rel {
+			byLine[entry.flatHelper.Line] = entry
+		}
+	}
+	if len(byLine) == 0 {
+		return nil, false, nil
+	}
+	infoAlias := ""
+	for alias, p := range sourceImportAliases(file) {
+		if p == "github.com/genshinsim/gcsim/pkg/core/info" {
+			infoAlias = alias
+		}
+	}
+	edits := []textEdit{}
+	needInfo := infoAlias == ""
+	usesInfo := false
+	if needInfo {
+		infoAlias = "gttreturninfo"
+	}
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok {
+			continue
+		}
+		entry, ok := byLine[fset.Position(fn.Pos()).Line]
+		if !ok {
+			continue
+		}
+		rt, ok := entryTraceExpression(receiverName(fn), entry)
+		if !ok {
+			return nil, false, fmt.Errorf("flat helper runtime unavailable")
+		}
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			ret, ok := n.(*ast.ReturnStmt)
+			if !ok {
+				return true
+			}
+			prefix := "gttReturn_" + entry.flatHelper.Key[:10] + "_" + strconv.Itoa(tf.Offset(ret.Pos()))
+			emit := fieldExpression{fset: fset, rt: rt, source: prefix + "_source", prefix: prefix, info: infoAlias, refs: map[string]string{}, constants: flatHelperConstants(file, fn)}
+			value, err := emit.emit(ret.Results[0], 0)
+			if err != nil {
+				return false
+			}
+			usesInfo = usesInfo || strings.Contains(emit.code.String(), infoAlias+".")
+			// Leave the original return as the non-captured path. Only the branch
+			// that actually executes evaluates its expression, exactly once.
+			code := fmt.Sprintf("if %s_source,%s_ok := %s.NumericReturnSource(%q);%s_ok{\n_ = %s_source\n%s\n%s.RecordNumericReturn(%q,float64(%s),%s);return float64(%s)\n}\n%s", prefix, prefix, rt, entry.flatHelper.Key, prefix, prefix, emit.code.String(), rt, entry.flatHelper.Key, value.value, value.ref, value.value, rootText(fset, ret))
+			edits = append(edits, textEdit{start: tf.Offset(ret.Pos()), end: tf.Offset(ret.End()), replacement: code})
+			return false
+		})
+	}
+	if len(edits) == 0 {
+		return nil, false, nil
+	}
+	if needInfo && usesInfo {
+		at := tf.Offset(file.Name.End())
+		edits = append(edits, textEdit{start: at, end: at, replacement: "\nimport " + infoAlias + " \"github.com/genshinsim/gcsim/pkg/core/info\""})
+	}
+	return edits, true, nil
+}
+
+func flatHelperConstants(file *ast.File, fn *ast.FuncDecl) map[string]bool {
+	constants := map[string]bool{}
+	for _, decl := range file.Decls {
+		if g, ok := decl.(*ast.GenDecl); ok && g.Tok == token.CONST {
+			for _, s := range g.Specs {
+				for _, n := range s.(*ast.ValueSpec).Names {
+					constants[n.Name] = true
+				}
+			}
+		}
+	}
+	ast.Inspect(fn.Body, func(n ast.Node) bool {
+		switch v := n.(type) {
+		case *ast.AssignStmt:
+			if v.Tok == token.DEFINE {
+				for _, lhs := range v.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok {
+						delete(constants, id.Name)
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			for _, id := range v.Names {
+				delete(constants, id.Name)
+			}
+		}
+		return true
+	})
+	return constants
+}
diff --git a/pkg/gttsourcegen/flat_helper_test.go b/pkg/gttsourcegen/flat_helper_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/flat_helper_test.go
@@ -0,0 +1,108 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestFlatHelperShapeAndOriginalReturn(t *testing.T) {
+	for _, body := range []string{`if c.Base.Stage<4{return 0};return c.Stat(attrs.EM)*.25`, `return 0`} {
+		src := []byte(`package x;import attrs "github.com/genshinsim/gcsim/pkg/core/attributes";func(c *odd)calculation()float64{` + body + `}`)
+		fs := token.NewFileSet()
+		f, e := parser.ParseFile(fs, "x.go", src, 0)
+		if e != nil {
+			t.Fatal(e)
+		}
+		fn := f.Decls[1].(*ast.FuncDecl)
+		if !boundedScalarReturn(fn) {
+			t.Fatal("bounded scalar rejected")
+		}
+		entry := SourceEntry{traceRuntimePath: "Core.Trace", flatHelper: &flatHelperPlan{File: "x.go", Method: "calculation", Line: 1, Key: strings.Repeat("a", 64)}}
+		edits, _, e := flatHelperBodyEdits(fs, fs.File(f.Pos()), src, "x.go", f, []SourceEntry{entry})
+		if e != nil {
+			t.Fatal(e)
+		}
+		out, e := applyTextEdits(src, edits)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if _, e = parser.ParseFile(token.NewFileSet(), "generated.go", out, 0); e != nil {
+			t.Fatal(e)
+		}
+		if !strings.Contains(string(out), "RecordNumericReturn") || !strings.Contains(string(out), "return 0") {
+			t.Fatal("original return lost")
+		}
+		if body == `return 0` && strings.Contains(string(out), "gttreturninfo") {
+			t.Fatal("unused info import")
+		}
+	}
+	fs := token.NewFileSet()
+	f, _ := parser.ParseFile(fs, "x.go", `package x;func(c *odd)loop()float64{for{};return 0}`, 0)
+	if boundedScalarReturn(f.Decls[0].(*ast.FuncDecl)) {
+		t.Fatal("loop accepted")
+	}
+}
+
+func TestFlatHelperFullTreeReturnPath(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	manifest, e := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if e != nil {
+		t.Fatal(e)
+	}
+	overlay, e := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")}, manifest)
+	if e != nil {
+		t.Fatal(e)
+	}
+	wanted := map[string]string{"internal/characters/kuki/skill.go": "CaptureNumericReturn", "internal/characters/kuki/asc.go": "GTTReadStat"}
+	for _, f := range overlay.Files {
+		if token, ok := wanted[f.RelativeFile]; ok {
+			if !strings.Contains(string(f.Contents), token) {
+				t.Fatal(f.RelativeFile + " missing " + token)
+			}
+			delete(wanted, f.RelativeFile)
+		}
+	}
+	if len(wanted) != 0 {
+		t.Fatal(wanted)
+	}
+}
+
+func TestFlatHelperCallRetainsFieldEvaluationPosition(t *testing.T) {
+	src := []byte(`package x;func(c *odd)run(){a:=info.AttackInfo{Other:c.before(),FlatDmg:c.calculation(),Last:c.after()};_ = a}`)
+	fs := token.NewFileSet()
+	f, err := parser.ParseFile(fs, "x.go", src, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fn := f.Decls[0].(*ast.FuncDecl)
+	lit := fn.Body.List[0].(*ast.AssignStmt).Rhs[0].(*ast.CompositeLit)
+	e := SourceEntry{SourceID: strings.Repeat("b", 64), traceRuntimePath: "Core.Trace", flatHelper: &flatHelperPlan{Key: "helper"}}
+	edits, err := flatHelperCallEdits(fs, fs.File(f.Pos()), src, fn, lit, e)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := applyTextEdits(src, edits)
+	if err != nil {
+		t.Fatal(err)
+	}
+	generated, err := parser.ParseFile(token.NewFileSet(), "out.go", out, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := generated.Decls[0].(*ast.FuncDecl).Body.List
+	if _, ok := body[0].(*ast.DeclStmt); !ok {
+		t.Fatal("helper evaluated before literal")
+	}
+	literal := body[1].(*ast.AssignStmt).Rhs[0].(*ast.CompositeLit)
+	flat := compositeKeyValue(literal, "FlatDmg").Value.(*ast.CallExpr)
+	if _, ok := flat.Fun.(*ast.FuncLit); !ok {
+		t.Fatal("helper moved out of original field")
+	}
+	if strings.Count(string(out), "c.calculation()") != 1 || !strings.Contains(string(out), `if ref.Kind!=""`) {
+		t.Fatal("call repeated or disabled metadata allocated")
+	}
+}
diff --git a/pkg/gttsourcegen/flat_stat.go b/pkg/gttsourcegen/flat_stat.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/flat_stat.go
@@ -0,0 +1,114 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"strconv"
+)
+
+// Preserve the getter's external modifier ancestry, not just owner + artifact
+// delta. Execute at the original composite field position, exactly once.
+func directFlatStatEdits(fs *token.FileSet, tf *token.File, data []byte, fn *ast.FuncDecl, lit *ast.CompositeLit, entry SourceEntry, explicitSourceID bool) ([]textEdit, error) {
+	flat := compositeKeyValue(lit, "FlatDmg")
+	statement := containingStatement(fn.Body, lit)
+	rt, ok := entryTraceExpression(receiverName(fn), entry)
+	if flat == nil || statement == nil || !ok || compositeKeyValue(lit, "GTTFlatProducer") != nil {
+		return nil, fmt.Errorf("direct flat stat producer shape changed")
+	}
+	qual := expressionQualifier(lit.Type)
+	prefix := "gttFlatStat_" + entry.SourceID[:12]
+	expr := fieldExpression{fset: fs, rt: rt, source: strconv.Quote(entry.SourceID), prefix: prefix, info: qual}
+	value, err := expr.emit(flat.Value, 0)
+	if err != nil {
+		return nil, err
+	}
+	decl := fmt.Sprintf("var %s *%s.GTTFlatProducer;\n%s", prefix, qual, indentationBefore(data, tf.Offset(statement.Pos())))
+	call := fmt.Sprintf("func()float64{if !%s.Enabled(){return %s};%s\n%s=&%s.GTTFlatProducer{Value:%s,Reference:%s};return %s}()", rt, rootText(fs, flat.Value), expr.code.String(), prefix, qual, value.value, value.ref, value.value)
+	metadata := ",GTTFlatProducer:" + prefix + ","
+	if explicitSourceID {
+		metadata += "GTTTraceSourceID:" + strconv.Quote(entry.SourceID) + ","
+	}
+	if len(lit.Elts) > 0 {
+		for _, b := range data[tf.Offset(lit.Elts[len(lit.Elts)-1].End()):tf.Offset(lit.Rbrace)] {
+			if b == ',' {
+				metadata = metadata[1:]
+				break
+			}
+		}
+	}
+	return []textEdit{{start: tf.Offset(statement.Pos()), end: tf.Offset(statement.Pos()), replacement: decl},
+		{start: tf.Offset(flat.Value.Pos()), end: tf.Offset(flat.Value.End()), replacement: call},
+		{start: tf.Offset(lit.Rbrace), end: tf.Offset(lit.Rbrace), replacement: metadata}}, nil
+}
+
+// Enable only the official typed attribute API for the original flat producer.
+// This is an integration seam, not a character/stat-benefit classification.
+func bindFlatStatImports(bindings bindingSet, file *ast.File) {
+	for alias, path := range sourceImportAliases(file) {
+		if path == "github.com/genshinsim/gcsim/pkg/core/attributes" && len(bindings[alias]) == 0 {
+			bindings["@gtt/flat-stat/"+alias] = []ast.Expr{ast.NewIdent(alias)}
+		}
+	}
+}
+
+func (c *expressionCompiler) compileTypedFlatStat(call *ast.CallExpr) (int, bool) {
+	method, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || method.Sel.Name != "Stat" || len(call.Args) != 1 {
+		return 0, false
+	}
+	stat, ok := call.Args[0].(*ast.SelectorExpr)
+	if !ok {
+		return 0, false
+	}
+	qualifier, ok := stat.X.(*ast.Ident)
+	if !ok || len(c.bindings["@gtt/flat-stat/"+qualifier.Name]) == 0 {
+		return 0, false
+	}
+	actor := rootText(c.fset, method.X)
+	if !safeSelectorChain(actor) {
+		return 0, false
+	}
+	expression := rootText(c.fset, call.Args[0]) + ".String()"
+	observed := rootText(c.fset, call)
+	if c.flatStatLocal != "" {
+		observed = c.flatStatLocal
+	}
+	// Distinct reads must not collapse merely because they call the same getter.
+	key := "p" + strconv.Itoa(len(c.parameters))
+	c.parameters = append(c.parameters, parameterPlan{ParameterKey: key, Kind: "candidate_stat",
+		SourceExpression: observed, ActorExpression: actor, StatKey: expression,
+		StatKeyExpression: expression, ReadMode: "live", CandidateDependencyComplete: false})
+	return c.addNode("PARAM", nil, nil, &key), true
+}
+
+func parameterStatExpression(p parameterPlan) string {
+	if p.StatKeyExpression != "" {
+		return p.StatKeyExpression
+	}
+	return strconv.Quote(p.StatKey)
+}
+
+func directFlatStatAlias(expr ast.Expr) bool {
+	if p, ok := expr.(*ast.ParenExpr); ok {
+		return directFlatStatAlias(p.X)
+	}
+	if _, ok := expr.(*ast.Ident); ok {
+		return true
+	}
+	call, ok := expr.(*ast.CallExpr)
+	if !ok {
+		return false
+	}
+	method, ok := call.Fun.(*ast.SelectorExpr)
+	return ok && method.Sel.Name == "Stat" && len(call.Args) == 1
+}
+
+func hasFlatStatParameters(parameters []parameterPlan) bool {
+	for _, p := range parameters {
+		if p.StatKeyExpression != "" {
+			return true
+		}
+	}
+	return false
+}
diff --git a/pkg/gttsourcegen/flat_stat_test.go b/pkg/gttsourcegen/flat_stat_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/flat_stat_test.go
@@ -0,0 +1,121 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strings"
+	"testing"
+)
+
+func TestFlatStatGetterAliasesPreserveValues(t *testing.T) {
+	for _, tc := range []struct {
+		name, body string
+		want       []string
+	}{
+		{"direct", `ai:=info.AttackInfo{FlatDmg:c.Stat(a.EM)*.25}`, []string{"c.Stat(a.EM)"}},
+		{"local", `em:=c.Stat(a.EM);ai:=info.AttackInfo{FlatDmg:em*.25}`, []string{"em"}},
+		{"two reads", `first:=c.Stat(a.EM);second:=c.Stat(a.EM);ai:=info.AttackInfo{FlatDmg:first+second}`, []string{"first", "second"}},
+		{"compound local", `flat:=c.Stat(a.EM)*.25;ai:=info.AttackInfo{FlatDmg:flat*2}`, []string{}},
+		{"alias of compound", `flat:=c.Stat(a.EM)*.25;alias:=flat;ai:=info.AttackInfo{FlatDmg:alias}`, []string{}},
+		{"alias", `first:=(c.Stat(a.EM));second:=first;ai:=info.AttackInfo{FlatDmg:second}`, []string{"first"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			src := `package x; import a "github.com/genshinsim/gcsim/pkg/core/attributes";func(c *char)f(){` + tc.body + `;c.Core.QueueAttack(ai)}`
+			fset := token.NewFileSet()
+			file, err := parser.ParseFile(fset, "test.go", src, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			entries, err := scanFile(fset, "test.go", file)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(entries) != 1 || entries[0].template.template.Status != TemplateSupported {
+				t.Fatalf("unexpected entries: %+v", entries)
+			}
+			if !entries[0].template.template.DependenciesComplete {
+				t.Fatal("a supported template must bind every parameter; external ancestry is a separate flag")
+			}
+			got := []string{}
+			for _, p := range entries[0].template.parameters {
+				if p.StatKeyExpression != "" {
+					got = append(got, p.SourceExpression)
+					if p.StatKeyExpression != "a.EM.String()" || p.ActorExpression != "c" || p.CandidateDependencyComplete {
+						t.Fatalf("wrong typed proof: %+v", p)
+					}
+				}
+			}
+			if strings.Join(got, "|") != strings.Join(tc.want, "|") {
+				t.Fatalf("reads %v, want %v", got, tc.want)
+			}
+			// Wrong imports cannot turn a similarly named method into an artifact stat.
+			wrong := strings.Replace(src, "github.com/genshinsim/gcsim/pkg/core/attributes", "example/attributes", 1)
+			fs := token.NewFileSet()
+			f, _ := parser.ParseFile(fs, "wrong.go", wrong, 0)
+			binding := collectBindings(f.Decls[1].(*ast.FuncDecl).Body)
+			bindFlatStatImports(binding, f)
+			if len(binding["@gtt/flat-stat/a"]) != 0 {
+				t.Fatal("foreign attributes import accepted")
+			}
+		})
+	}
+}
+
+func TestFlatStatOverlayDoesNotRepeatGetter(t *testing.T) {
+	for _, body := range []string{
+		`ai:=info.AttackInfo{FlatDmg:c.Stat(a.EM)*.25}`,
+		`first:=c.Stat(a.EM);second:=c.Stat(a.EM);ai:=info.AttackInfo{FlatDmg:first+second}`,
+		`flat:=c.Stat(a.EM)*.25;ai:=info.AttackInfo{FlatDmg:flat*2}`,
+	} {
+		src := []byte(`package x; import a "github.com/genshinsim/gcsim/pkg/core/attributes";func(c *char)f(){` + body + `;c.Core.QueueAttack(ai)}`)
+		fset := token.NewFileSet()
+		file, err := parser.ParseFile(fset, "test.go", src, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		candidates, err := scanFile(fset, "test.go", file)
+		if err != nil {
+			t.Fatal(err)
+		}
+		entries, err := finalizeCandidates(candidates)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var composite *ast.CompositeLit
+		ast.Inspect(file, func(n ast.Node) bool {
+			if lit, ok := n.(*ast.CompositeLit); ok {
+				composite = lit
+			}
+			return true
+		})
+		fn := file.Decls[1].(*ast.FuncDecl)
+		edits, err := queuedAttackEdits(fset, fset.File(file.Pos()), src, fn, composite, entries[0], "c.Core.F", true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		output, err := applyTextEdits(src, edits)
+		if err != nil {
+			t.Fatal(err)
+		}
+		changed, err := parser.ParseFile(token.NewFileSet(), "changed.go", output, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		count := func(root ast.Node) int {
+			n := 0
+			ast.Inspect(root, func(node ast.Node) bool {
+				if call, ok := node.(*ast.CallExpr); ok {
+					if method, ok := call.Fun.(*ast.SelectorExpr); ok && method.Sel.Name == "Stat" {
+						n++
+					}
+				}
+				return true
+			})
+			return n
+		}
+		if count(file) != count(changed) {
+			t.Fatalf("getter repeated: %s", output)
+		}
+	}
+}
diff --git a/pkg/gttsourcegen/forwarded_attack.go b/pkg/gttsourcegen/forwarded_attack.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/forwarded_attack.go
@@ -0,0 +1,283 @@
+package gttsourcegen
+
+import (
+	"crypto/sha256"
+	"go/ast"
+	"go/token"
+	pathpkg "path"
+	"strconv"
+	"strings"
+)
+
+const (
+	maxForwardedAttackCallDepth    = 5
+	maxForwardedAttackAlternatives = 16
+)
+
+type forwardedAttackFunction struct {
+	rel          string
+	packageDir   string
+	receiverType string
+	receiverName string
+	decl         *ast.FuncDecl
+	parameters   []string
+}
+
+type forwardedAttackSummary struct {
+	parameterIndex      int
+	callDepth           int
+	readFrameExpression string
+}
+
+// augmentForwardedAttackCandidates follows only unambiguous same-receiver
+// method parameters that reach QueueAttack. It is intentionally bounded and
+// does not attempt whole-program type inference or dynamic dispatch.
+func augmentForwardedAttackCandidates(
+	fset *token.FileSet,
+	files []parsedSourceFile,
+	candidates []sourceCandidate,
+) ([]sourceCandidate, error) {
+	methods := make(map[string][]forwardedAttackFunction)
+	functions := make([]forwardedAttackFunction, 0, 256)
+	for _, source := range files {
+		for _, declaration := range source.file.Decls {
+			fn, ok := declaration.(*ast.FuncDecl)
+			if !ok || fn.Body == nil {
+				continue
+			}
+			receiverType, receiverName := receiverIdentity(fset, fn)
+			if receiverType == "" || receiverName == "" {
+				continue
+			}
+			function := forwardedAttackFunction{
+				rel: source.rel, packageDir: pathpkg.Dir(source.rel),
+				receiverType: receiverType, receiverName: receiverName,
+				decl: fn, parameters: namedParameters(fn),
+			}
+			functions = append(functions, function)
+			key := methodLookupKey(function.packageDir, receiverType, fn.Name.Name)
+			methods[key] = append(methods[key], function)
+		}
+	}
+
+	summaries := make(map[*ast.FuncDecl]map[int]forwardedAttackSummary)
+	for index := range functions {
+		function := &functions[index]
+		bindings := collectBindings(function.decl.Body)
+		ast.Inspect(function.decl.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok || !isDirectQueueAttackCall(call) || len(call.Args) == 0 {
+				return true
+			}
+			resolved := resolveExpr(call.Args[0], bindings, nil)
+			parameterIndex := parameterNameIndex(resolved, function.parameters)
+			if parameterIndex < 0 {
+				return true
+			}
+			frame, err := queueReadFrameExpression(fset, call)
+			if err != nil {
+				return true
+			}
+			addForwardedSummary(summaries, function.decl, forwardedAttackSummary{
+				parameterIndex: parameterIndex, callDepth: 1,
+				readFrameExpression: frame,
+			})
+			return true
+		})
+	}
+
+	// Propagate sink summaries through at most five same-receiver calls. A
+	// visited method/parameter pair is represented by the summary map, so a
+	// recursive cycle cannot expand the search.
+	for depth := 2; depth <= maxForwardedAttackCallDepth+1; depth++ {
+		changed := false
+		for index := range functions {
+			function := &functions[index]
+			bindings := collectBindings(function.decl.Body)
+			ast.Inspect(function.decl.Body, func(node ast.Node) bool {
+				call, ok := node.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				callee, ok := resolveSameReceiverAttackMethod(call, *function, methods)
+				if !ok {
+					return true
+				}
+				for _, summary := range summaries[callee.decl] {
+					if summary.callDepth != depth-1 || summary.parameterIndex >= len(call.Args) {
+						continue
+					}
+					resolved := resolveExpr(call.Args[summary.parameterIndex], bindings, nil)
+					parameterIndex := parameterNameIndex(resolved, function.parameters)
+					if parameterIndex < 0 {
+						continue
+					}
+					frame := rebindReceiverRoot(
+						summary.readFrameExpression, callee.receiverName, function.receiverName,
+					)
+					if frame == "" {
+						continue
+					}
+					if addForwardedSummary(summaries, function.decl, forwardedAttackSummary{
+						parameterIndex: parameterIndex, callDepth: depth,
+						readFrameExpression: frame,
+					}) {
+						changed = true
+					}
+				}
+				return true
+			})
+		}
+		if !changed {
+			break
+		}
+	}
+
+	type origin struct {
+		candidate sourceCandidate
+		groupKey  string
+	}
+	origins := make([]origin, 0, 32)
+	counts := make(map[string]int)
+	seen := make(map[string]bool)
+	for index := range functions {
+		function := &functions[index]
+		bindings := collectBindings(function.decl.Body)
+		ast.Inspect(function.decl.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			callee, ok := resolveSameReceiverAttackMethod(call, *function, methods)
+			if !ok {
+				return true
+			}
+			for _, summary := range summaries[callee.decl] {
+				if summary.parameterIndex >= len(call.Args) {
+					continue
+				}
+				root := resolveAttackInfo(call.Args[summary.parameterIndex], bindings)
+				originKey := function.rel + "|" + strconv.Itoa(int(call.Pos())) + "|" + strconv.Itoa(summary.parameterIndex)
+				if root == nil || seen[originKey] {
+					continue
+				}
+				seen[originKey] = true
+				compiled := describeForwardedQueuedAttack(fset, root, bindings)
+				if summary.callDepth > maxForwardedAttackCallDepth {
+					compiled = opaqueTemplate("forwarded_attack_depth_budget_exceeded")
+				}
+				astHash, err := hashAST(fset, root)
+				if err != nil {
+					astHash = strings.Repeat("0", sha256.Size*2)
+					compiled = opaqueTemplate("ast_render_failed")
+				}
+				position := fset.Position(call.Pos())
+				groupKey := methodLookupKey(callee.packageDir, callee.receiverType, callee.decl.Name.Name) + "|" + strconv.Itoa(summary.parameterIndex)
+				counts[groupKey]++
+				origins = append(origins, origin{groupKey: groupKey, candidate: sourceCandidate{
+					kind: KindQueuedAttack, relativeFile: function.rel,
+					line: position.Line, column: position.Column,
+					enclosingSymbol: enclosingSymbol(fset, function.decl),
+					root:            root, astSHA256: astHash, template: compiled,
+					forwardedAttack: &forwardedAttackPlan{
+						ArgumentIndex: summary.parameterIndex,
+						ReadFrameExpression: rebindReceiverRoot(
+							summary.readFrameExpression, callee.receiverName, function.receiverName,
+						),
+						CallDepth: summary.callDepth,
+					},
+				}})
+			}
+			return true
+		})
+	}
+	for _, found := range origins {
+		candidate := found.candidate
+		if counts[found.groupKey] > maxForwardedAttackAlternatives {
+			candidate.template = opaqueTemplate("forwarded_attack_alternative_budget_exceeded")
+		}
+		candidates = append(candidates, candidate)
+	}
+	return candidates, nil
+}
+
+func namedParameters(fn *ast.FuncDecl) []string {
+	if fn == nil || fn.Type.Params == nil {
+		return []string{}
+	}
+	result := make([]string, 0, len(fn.Type.Params.List))
+	for _, field := range fn.Type.Params.List {
+		for _, name := range field.Names {
+			result = append(result, name.Name)
+		}
+	}
+	return result
+}
+
+func parameterNameIndex(expr ast.Expr, parameters []string) int {
+	ident, ok := expr.(*ast.Ident)
+	if !ok {
+		return -1
+	}
+	for index, name := range parameters {
+		if ident.Name == name {
+			return index
+		}
+	}
+	return -1
+}
+
+func isDirectQueueAttackCall(call *ast.CallExpr) bool {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	return ok && strings.HasPrefix(selector.Sel.Name, "QueueAttack")
+}
+
+func resolveSameReceiverAttackMethod(
+	call *ast.CallExpr,
+	owner forwardedAttackFunction,
+	methods map[string][]forwardedAttackFunction,
+) (forwardedAttackFunction, bool) {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return forwardedAttackFunction{}, false
+	}
+	receiver, ok := selector.X.(*ast.Ident)
+	if !ok || receiver.Name != owner.receiverName {
+		return forwardedAttackFunction{}, false
+	}
+	matches := methods[methodLookupKey(owner.packageDir, owner.receiverType, selector.Sel.Name)]
+	if len(matches) != 1 || matches[0].decl == owner.decl {
+		return forwardedAttackFunction{}, false
+	}
+	return matches[0], true
+}
+
+func addForwardedSummary(
+	summaries map[*ast.FuncDecl]map[int]forwardedAttackSummary,
+	decl *ast.FuncDecl,
+	summary forwardedAttackSummary,
+) bool {
+	if summaries[decl] == nil {
+		summaries[decl] = make(map[int]forwardedAttackSummary)
+	}
+	previous, exists := summaries[decl][summary.parameterIndex]
+	if exists && previous.callDepth <= summary.callDepth {
+		return false
+	}
+	summaries[decl][summary.parameterIndex] = summary
+	return true
+}
+
+func rebindReceiverRoot(expression, from, to string) string {
+	if expression == "" || from == "" || to == "" {
+		return ""
+	}
+	if expression == from {
+		return to
+	}
+	prefix := from + "."
+	if !strings.HasPrefix(expression, prefix) {
+		return ""
+	}
+	return to + expression[len(from):]
+}
diff --git a/pkg/gttsourcegen/forwarded_attack_test.go b/pkg/gttsourcegen/forwarded_attack_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/forwarded_attack_test.go
@@ -0,0 +1,122 @@
+package gttsourcegen
+
+import (
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestForwardedAttackCarriesGenericFormulaAndExplicitIdentity(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) queueAttack(ai info.AttackInfo) {
+	c.Core.QueueAttack(ai)
+}
+func (c *char) attack() {
+	count := c.consumeAllies()
+	damageMultiplier := 1 + 0.1*float64(count)
+	ai := info.AttackInfo{FlatDmg: ratio[0] * c.MaxHP() * damageMultiplier}
+	c.queueAttack(ai)
+}
+`)
+	manifest := generateFixture(t, root)
+	entry := findEntry(t, manifest, KindQueuedAttack, "(*char).attack")
+	if entry.Template.Status != TemplateSupported || entry.forwardedAttack == nil {
+		t.Fatalf("forwarded attack not supported: %#v", entry)
+	}
+	if entry.forwardedAttack.CallDepth != 1 || entry.forwardedAttack.ArgumentIndex != 0 || entry.forwardedAttack.ReadFrameExpression != "c.Core.F" {
+		t.Fatalf("forwarded plan mismatch: %#v", entry.forwardedAttack)
+	}
+	if len(entry.parameterPlans) != 3 {
+		t.Fatalf("parameter plans=%#v", entry.parameterPlans)
+	}
+	foundCandidateHP := false
+	foundFrozenRuntime := false
+	for _, parameter := range entry.parameterPlans {
+		if parameter.Kind == "candidate_stat" && parameter.StatKey == "max_hp" && parameter.ActorExpression == "c" {
+			foundCandidateHP = true
+		}
+		if parameter.Kind == "frozen_runtime_state" && parameter.SourceExpression == "damageMultiplier" && !parameter.CandidateDependencyComplete {
+			foundFrozenRuntime = true
+		}
+	}
+	if !foundCandidateHP || !foundFrozenRuntime {
+		t.Fatalf("forwarded parameter semantics missing: %#v", entry.parameterPlans)
+	}
+
+	overlay, err := BuildOverlay(OverlayOptions{
+		ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay"),
+	}, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(overlay.Files) != 1 {
+		t.Fatalf("overlay files=%d", len(overlay.Files))
+	}
+	rewritten := string(overlay.Files[0].Contents)
+	for _, wanted := range []string{
+		"GTTTraceSourceID:", "GTTTraceSourceTemplateSHA256:",
