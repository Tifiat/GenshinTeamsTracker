diff --git a/pkg/gttsourcegen/v6_trace_root.go b/pkg/gttsourcegen/v6_trace_root.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/v6_trace_root.go
@@ -0,0 +1,214 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	pathpkg "path"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const maxTraceRuntimePathDepth = 8
+
+type traceTypeRef struct {
+	packagePath string
+	name        string
+}
+
+func (r traceTypeRef) key() string {
+	return r.packagePath + "." + r.name
+}
+
+type traceStructField struct {
+	selector string
+	target   traceTypeRef
+}
+
+type traceStructDecl struct {
+	packagePath string
+	fields      []traceStructField
+}
+
+type traceRuntimeIndex struct {
+	modulePath  string
+	structs     map[string]traceStructDecl
+	runtimeType string
+}
+
+func buildTraceRuntimeIndex(modulePath string, files []parsedSourceFile) traceRuntimeIndex {
+	index := traceRuntimeIndex{
+		modulePath:  strings.TrimSuffix(strings.TrimSpace(modulePath), "/"),
+		structs:     make(map[string]traceStructDecl),
+		runtimeType: strings.TrimSuffix(strings.TrimSpace(modulePath), "/") + "/pkg/gtttrace.Runtime",
+	}
+	for _, source := range files {
+		packagePath := index.packagePath(pathpkg.Dir(source.rel))
+		imports := sourceImportAliases(source.file)
+		for _, declaration := range source.file.Decls {
+			general, ok := declaration.(*ast.GenDecl)
+			if !ok {
+				continue
+			}
+			for _, spec := range general.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				body, ok := typeSpec.Type.(*ast.StructType)
+				if !ok {
+					continue
+				}
+				row := traceStructDecl{packagePath: packagePath, fields: make([]traceStructField, 0, len(body.Fields.List))}
+				for _, field := range body.Fields.List {
+					target, ok := traceFieldType(packagePath, imports, field.Type)
+					if !ok {
+						continue
+					}
+					if len(field.Names) == 0 {
+						row.fields = append(row.fields, traceStructField{selector: target.name, target: target})
+						continue
+					}
+					for _, name := range field.Names {
+						row.fields = append(row.fields, traceStructField{selector: name.Name, target: target})
+					}
+				}
+				sort.Slice(row.fields, func(i, j int) bool {
+					if row.fields[i].selector != row.fields[j].selector {
+						return row.fields[i].selector < row.fields[j].selector
+					}
+					return row.fields[i].target.key() < row.fields[j].target.key()
+				})
+				index.structs[(traceTypeRef{packagePath: packagePath, name: typeSpec.Name.Name}).key()] = row
+			}
+		}
+	}
+	return index
+}
+
+func (i traceRuntimeIndex) packagePath(packageDir string) string {
+	if packageDir == "." || packageDir == "" {
+		return i.modulePath
+	}
+	return i.modulePath + "/" + strings.TrimPrefix(packageDir, "./")
+}
+
+func (i traceRuntimeIndex) resolve(packageDir, receiverType string) (string, string) {
+	root := traceTypeRef{
+		packagePath: i.packagePath(packageDir),
+		name:        strings.TrimPrefix(strings.TrimSpace(receiverType), "*"),
+	}
+	if root.name == "" {
+		return "", "trace_runtime_path_unresolved"
+	}
+	paths := make(map[string]struct{})
+	i.walk(root, root.packagePath, nil, make(map[string]bool), paths, 0)
+	ordered := make([]string, 0, len(paths))
+	for path := range paths {
+		ordered = append(ordered, path)
+	}
+	sort.Strings(ordered)
+	if len(ordered) == 0 {
+		return "", "trace_runtime_path_unresolved"
+	}
+	shortestDepth := selectorPathDepth(ordered[0])
+	shortest := ordered[:0]
+	for _, path := range ordered {
+		depth := selectorPathDepth(path)
+		if depth < shortestDepth {
+			shortestDepth = depth
+			shortest = shortest[:0]
+		}
+		if depth == shortestDepth {
+			shortest = append(shortest, path)
+		}
+	}
+	if len(shortest) == 1 {
+		return shortest[0], ""
+	}
+	return "", "trace_runtime_path_ambiguous"
+}
+
+func selectorPathDepth(path string) int {
+	if path == "" {
+		return 0
+	}
+	return strings.Count(path, ".") + 1
+}
+
+func (i traceRuntimeIndex) walk(
+	current traceTypeRef,
+	rootPackage string,
+	path []string,
+	visiting map[string]bool,
+	paths map[string]struct{},
+	depth int,
+) {
+	if depth > maxTraceRuntimePathDepth || visiting[current.key()] {
+		return
+	}
+	if current.key() == i.runtimeType {
+		if len(path) > 0 {
+			paths[strings.Join(path, ".")] = struct{}{}
+		}
+		return
+	}
+	declaration, ok := i.structs[current.key()]
+	if !ok {
+		return
+	}
+	visiting[current.key()] = true
+	defer delete(visiting, current.key())
+	for _, field := range declaration.fields {
+		if declaration.packagePath != rootPackage && !ast.IsExported(field.selector) {
+			continue
+		}
+		nextPath := append(append([]string{}, path...), field.selector)
+		i.walk(field.target, rootPackage, nextPath, visiting, paths, depth+1)
+	}
+}
+
+func sourceImportAliases(file *ast.File) map[string]string {
+	result := make(map[string]string, len(file.Imports))
+	for _, spec := range file.Imports {
+		importPath, err := strconv.Unquote(spec.Path.Value)
+		if err != nil || importPath == "" {
+			continue
+		}
+		alias := pathpkg.Base(importPath)
+		if spec.Name != nil {
+			alias = spec.Name.Name
+		}
+		if alias == "_" || alias == "." || alias == "" {
+			continue
+		}
+		result[alias] = importPath
+	}
+	return result
+}
+
+func traceFieldType(packagePath string, imports map[string]string, expression ast.Expr) (traceTypeRef, bool) {
+	switch value := expression.(type) {
+	case *ast.StarExpr:
+		return traceFieldType(packagePath, imports, value.X)
+	case *ast.ParenExpr:
+		return traceFieldType(packagePath, imports, value.X)
+	case *ast.IndexExpr:
+		return traceFieldType(packagePath, imports, value.X)
+	case *ast.IndexListExpr:
+		return traceFieldType(packagePath, imports, value.X)
+	case *ast.Ident:
+		return traceTypeRef{packagePath: packagePath, name: value.Name}, value.Name != ""
+	case *ast.SelectorExpr:
+		alias, ok := value.X.(*ast.Ident)
+		if !ok {
+			return traceTypeRef{}, false
+		}
+		importPath, ok := imports[alias.Name]
+		if !ok {
+			return traceTypeRef{}, false
+		}
+		return traceTypeRef{packagePath: importPath, name: value.Sel.Name}, value.Sel.Name != ""
+	default:
+		return traceTypeRef{}, false
+	}
+}
