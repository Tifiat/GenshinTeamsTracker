@@ -0,0 +1,44 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+)
+
+// An old initializer must never become a constant or a phantom derivative.
+func TestMutatedNumericBindingRetainsObservedValue(t *testing.T) {
+	for _, body := range []string{`x:=10.;x+=3`, `x:=10.;x++`, `x:=10.;x,y=read();_ = y`, `x:=10.;mutate(&x)`} {
+		fs := token.NewFileSet()
+		f, e := parser.ParseFile(fs, "x.go", "package x;func run(){"+body+";_ = x}", 0)
+		if e != nil {
+			t.Fatal(e)
+		}
+		fn := f.Decls[0].(*ast.FuncDecl)
+		binding := collectBindings(fn.Body)
+		c := newExpressionCompiler(fs, binding)
+		_, ok := c.compile(ast.NewIdent("x"))
+		if !ok {
+			t.Fatal(c.stopReason)
+		}
+		if len(c.parameters) != 1 || c.parameters[0].Kind != "frozen_runtime_state" || c.parameters[0].SourceExpression != "x" {
+			t.Fatalf("stale initializer %s: %#v", body, c.parameters)
+		}
+	}
+}
+
+func TestModifierLoopsAndCompoundWritesAreNotCompleteTemplates(t *testing.T) {
+	for _, body := range []string{`x:=0.;for _,n:=range xs{x+=n};m[a.EM]=x;return m`, `m[a.EM]+=2;return m`} {
+		fs := token.NewFileSet()
+		f, e := parser.ParseFile(fs, "x.go", "package x;var f=func()[]float64{"+body+"}", 0)
+		if e != nil {
+			t.Fatal(e)
+		}
+		fn := f.Decls[0].(*ast.GenDecl).Specs[0].(*ast.ValueSpec).Values[0].(*ast.FuncLit)
+		c := describeModifierAmount(fs, fn, collectBindings(fn.Body))
+		if c.template.Status == TemplateSupported {
+			t.Fatal("unproven mutation accepted", body)
+		}
+	}
+}
diff --git a/pkg/gttsourcegen/numeric_recipe.go b/pkg/gttsourcegen/numeric_recipe.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/numeric_recipe.go
@@ -0,0 +1,269 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strconv"
+	"strings"
+)
+
+// This bounded backward slice follows scalar assignment versions, not names
+// of attacks, characters or reactions. Registered observer inputs are explicit
+// cut points. Unknown calls/control flow fail closed at this receipt only.
+type numericSlice struct {
+	fset      *token.FileSet
+	fn        *ast.FuncDecl
+	inputs    map[string]int
+	nodes     []string
+	visits    int
+	captureAt token.Pos
+}
+
+func (s *numericSlice) lastWrite(name string, before token.Pos) token.Pos {
+	var last token.Pos
+	ast.Inspect(s.fn.Body, func(n ast.Node) bool {
+		if n == nil || n.Pos() >= before {
+			return false
+		}
+		if _, ok := n.(*ast.FuncLit); ok {
+			return false
+		}
+		if a, ok := n.(*ast.AssignStmt); ok && a.End() < before {
+			for _, lhs := range a.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok && id.Name == name && a.Pos() > last {
+					last = a.Pos()
+				}
+			}
+		}
+		if a, ok := n.(*ast.IncDecStmt); ok && a.End() < before {
+			if id, ok := a.X.(*ast.Ident); ok && id.Name == name && a.Pos() > last {
+				last = a.Pos()
+			}
+		}
+		return true
+	})
+	return last
+}
+
+func (s *numericSlice) node(op string, args []int, value string, input int) (int, error) {
+	if len(s.nodes) >= 128 {
+		return 0, fmt.Errorf("numeric recipe node budget")
+	}
+	parts := make([]string, len(args))
+	for i, v := range args {
+		parts[i] = strconv.Itoa(v)
+	}
+	if value == "" {
+		value = "0"
+	}
+	n := fmt.Sprintf("{Op:%q, Args:[]int{%s}, Value:%s, Input:%d}", op, strings.Join(parts, ","), value, input)
+	s.nodes = append(s.nodes, n)
+	return len(s.nodes) - 1, nil
+}
+
+func (s *numericSlice) expr(e ast.Expr, before token.Pos, depth int) (int, error) {
+	s.visits++
+	if depth > 48 || s.visits > 256 {
+		return 0, fmt.Errorf("numeric recipe traversal budget")
+	}
+	if input, ok := s.inputs[rootText(s.fset, e)]; ok {
+		if id, ok := e.(*ast.Ident); ok && s.lastWrite(id.Name, before) != s.lastWrite(id.Name, s.captureAt) {
+			return 0, fmt.Errorf("numeric input mutated after use: %s", id.Name)
+		}
+		return s.node("INPUT", nil, "", input)
+	}
+	switch v := e.(type) {
+	case *ast.ParenExpr:
+		return s.expr(v.X, before, depth+1)
+	case *ast.BasicLit:
+		if v.Kind != token.INT && v.Kind != token.FLOAT {
+			break
+		}
+		if _, err := strconv.ParseFloat(v.Value, 64); err != nil {
+			return 0, err
+		}
+		return s.node("CONST", nil, v.Value, 0)
+	case *ast.BinaryExpr:
+		op := map[token.Token]string{token.ADD: "ADD", token.SUB: "SUB", token.MUL: "MUL", token.QUO: "DIV"}[v.Op]
+		if op == "" {
+			break
+		}
+		a, err := s.expr(v.X, before, depth+1)
+		if err != nil {
+			return 0, err
+		}
+		b, err := s.expr(v.Y, before, depth+1)
+		if err != nil {
+			return 0, err
+		}
+		return s.node(op, []int{a, b}, "", 0)
+	case *ast.UnaryExpr:
+		if v.Op == token.ADD {
+			return s.expr(v.X, before, depth+1)
+		}
+		if v.Op != token.SUB {
+			break
+		}
+		a, err := s.expr(v.X, before, depth+1)
+		if err != nil {
+			return 0, err
+		}
+		zero, err := s.node("CONST", nil, "0", 0)
+		if err != nil {
+			return 0, err
+		}
+		return s.node("SUB", []int{zero, a}, "", 0)
+	case *ast.Ident:
+		// Only top-level straight-line definitions are replayable. Any nested
+		// write to this name before the use is ambiguous (unless a registered
+		// input cut above), including writes in a branch that wasn't executed.
+		var latest *ast.AssignStmt
+		for _, stmt := range s.fn.Body.List {
+			if stmt.Pos() >= before {
+				break
+			}
+			if a, ok := stmt.(*ast.AssignStmt); ok && a.End() < before && len(a.Lhs) == 1 && len(a.Rhs) == 1 {
+				if id, ok := a.Lhs[0].(*ast.Ident); ok && id.Name == v.Name {
+					latest = a
+					continue
+				}
+			}
+			ambiguous := false
+			ast.Inspect(stmt, func(n ast.Node) bool {
+				if n == nil || n.Pos() >= before {
+					return false
+				}
+				if _, ok := n.(*ast.FuncLit); ok {
+					return false
+				}
+				if a, ok := n.(*ast.AssignStmt); ok {
+					for _, lhs := range a.Lhs {
+						if id, ok := lhs.(*ast.Ident); ok && id.Name == v.Name {
+							ambiguous = true
+						}
+					}
+				}
+				if a, ok := n.(*ast.IncDecStmt); ok {
+					if id, ok := a.X.(*ast.Ident); ok && id.Name == v.Name {
+						ambiguous = true
+					}
+				}
+				return true
+			})
+			if ambiguous {
+				return 0, fmt.Errorf("numeric recipe ambiguous write: %s", v.Name)
+			}
+		}
+		if latest == nil {
+			break
+		}
+		if latest.Tok == token.DEFINE || latest.Tok == token.ASSIGN {
+			return s.expr(latest.Rhs[0], latest.Pos(), depth+1)
+		}
+		op := map[token.Token]string{token.ADD_ASSIGN: "ADD", token.SUB_ASSIGN: "SUB", token.MUL_ASSIGN: "MUL", token.QUO_ASSIGN: "DIV"}[latest.Tok]
+		if op == "" {
+			break
+		}
+		a, err := s.expr(v, latest.Pos(), depth+1)
+		if err != nil {
+			return 0, err
+		}
+		b, err := s.expr(latest.Rhs[0], latest.Pos(), depth+1)
+		if err != nil {
+			return 0, err
+		}
+		return s.node(op, []int{a, b}, "", 0)
+	}
+	return 0, fmt.Errorf("numeric recipe unsupported expression: %s", rootText(s.fset, e))
+}
+
+func rewriteNumericRecipes(rel string, data []byte) ([]byte, error) {
+	if !bytes.Contains(data, []byte("info.GTTTraceCaptureNumeric(")) {
+		return data, nil
+	}
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, rel, data, parser.SkipObjectResolution)
+	if err != nil {
+		return nil, err
+	}
+	tf := fset.File(file.Pos())
+	var edits []textEdit
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || rootText(fset, selector) != "info.GTTTraceCaptureNumeric" {
+				return true
+			}
+			if len(call.Args) < 3 {
+				err = fmt.Errorf("numeric recipe inputs missing")
+				return false
+			}
+			s := numericSlice{fset: fset, fn: fn, inputs: map[string]int{}, captureAt: call.Pos()}
+			var inputs []string
+			for i, arg := range call.Args[2:] {
+				lit, ok := arg.(*ast.CompositeLit)
+				if !ok || rootText(fset, lit.Type) != "info.GTTNumericInput" {
+					err = fmt.Errorf("numeric input type")
+					return false
+				}
+				var fields []string
+				var expression string
+				for _, el := range lit.Elts {
+					kv, ok := el.(*ast.KeyValueExpr)
+					if !ok {
+						err = fmt.Errorf("numeric input fields")
+						return false
+					}
+					key := rootText(fset, kv.Key)
+					if key == "Value" {
+						expression = rootText(fset, kv.Value)
+						if !isPureOperand(kv.Value) {
+							err = fmt.Errorf("numeric input may evaluate gameplay")
+							return false
+						}
+					}
+					fields = append(fields, rootText(fset, kv))
+				}
+				if expression == "" {
+					err = fmt.Errorf("numeric input value missing")
+					return false
+				}
+				if _, exists := s.inputs[expression]; exists {
+					err = fmt.Errorf("numeric input duplicate")
+					return false
+				}
+				s.inputs[expression] = i
+				fields = append(fields, fmt.Sprintf("Source:%q", expression))
+				inputs = append(inputs, "{"+strings.Join(fields, ",")+"}")
+			}
+			root, sliceErr := s.expr(call.Args[1], call.Pos(), 0)
+			if sliceErr != nil {
+				// Leave marker intact: observed damage stays usable, with an
+				// explicit local freeze. No broken overlay/build for a new shape.
+				replacement := fmt.Sprintf("info.GTTTraceNumericUnsupported(%s,%q)", rootText(fset, call.Args[0]), "numeric_recipe_source_slice_unsupported: "+sliceErr.Error())
+				edits = append(edits, textEdit{tf.Offset(call.Pos()), tf.Offset(call.End()), replacement})
+				return false
+			}
+			digest := fmt.Sprintf("%x", sha256.Sum256(data[tf.Offset(fn.Pos()):tf.Offset(fn.End())]))
+			replacement := fmt.Sprintf("info.GTTTraceAttachNumeric(%s, info.GTTNumericRecipe{Version:info.GTTNumericRecipeVersion, SourceSHA256:%q, Nodes:[]info.GTTNumericNode{%s}, Root:%d, Inputs:[]info.GTTNumericInput{%s}, Observed:%s})", rootText(fset, call.Args[0]), digest, strings.Join(s.nodes, ","), root, strings.Join(inputs, ","), rootText(fset, call.Args[1]))
+			edits = append(edits, textEdit{tf.Offset(call.Pos()), tf.Offset(call.End()), replacement})
+			return false
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+	return applyTextEdits(data, edits)
+}
diff --git a/pkg/gttsourcegen/numeric_recipe_test.go b/pkg/gttsourcegen/numeric_recipe_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/numeric_recipe_test.go
@@ -0,0 +1,117 @@
+package gttsourcegen
+
+import (
+	"go/parser"
+	"go/token"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestNumericRecipeScalarVersionsAndRenaming(t *testing.T) {
+	source := `package arbitrary
+func notAGameplayName() {
+ x := seed * (1 + 7 * amount / (311 + amount))
+ x += extra
+ x *= multiplier
+ result := x
+ info.GTTTraceCaptureNumeric(hit, result,
+ info.GTTNumericInput{Kind:"scaling",Value:seed},
+ info.GTTNumericInput{Kind:"snapshot_stat",StatKey:"em",Value:amount},
+ info.GTTNumericInput{Kind:"frozen",Value:extra},
+ info.GTTNumericInput{Kind:"frozen",Value:multiplier})
+}`
+	for _, src := range []string{source, strings.ReplaceAll(source, "x", "renamed")} {
+		got, err := rewriteNumericRecipes("test.go", []byte(src))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(got), "info.GTTTraceAttachNumeric(") || !strings.Contains(string(got), "Value:311") || strings.Contains(string(got), "unsupported") {
+			t.Fatal(string(got))
+		}
+		if _, err := parser.ParseFile(token.NewFileSet(), "test.go", got, 0); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestNumericRecipeUnknownControlFlowFreezes(t *testing.T) {
+	for _, computation := range []string{
+		"x := seed; if flag { x *= 2 }; result := x",
+		"x := seed; x++; result := x",
+		"result := unknownHelper(seed)",
+		"result := seed * 3; seed += 1",
+	} {
+		src := "package a\nfunc f(){" + computation + "; info.GTTTraceCaptureNumeric(hit,result,info.GTTNumericInput{Kind:\"scaling\",Value:seed})}"
+		got, err := rewriteNumericRecipes("test.go", []byte(src))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(got), "numeric_recipe_source_slice_unsupported") {
+			t.Fatal(string(got))
+		}
+	}
+}
+
+func TestNumericRecipeFullEngineCalculation(t *testing.T) {
+	src, err := os.ReadFile("../enemy/damage.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := rewriteNumericRecipes("damage.go", src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(got), "info.GTTTraceAttachNumeric(") || strings.Contains(string(got), "numeric_recipe_source_slice_unsupported") {
+		t.Fatal("actual calculation did not produce a recipe")
+	}
+	if strings.Count(string(got), `Kind: "context_resistance_multiplier"`) + strings.Count(string(got), `Kind:"context_resistance_multiplier"`) != 1 {
+		t.Fatal("source contextual input marker not preserved by full engine rewrite")
+	}
+	// Constants and operation order are parsed from the supplied source. The
+	// same adapter must follow a future changed curve without editing GTT.
+	changed := strings.Replace(string(src), "(6 * em) / (2000 + em)", "(9 * em) / (1731 + em)", 1)
+	got, err = rewriteNumericRecipes("damage.go", []byte(changed))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(got), "Value:1731") {
+		t.Fatal("source coefficient was not followed")
+	}
+}
+
+func TestNumericRecipeArraySyntaxIsNotIndependence(t *testing.T) {
+	for _, text := range []string{"snapshot.Stats[attributes.EM]", "data.LevelTable[currentState]"} {
+		src := "package a\nfunc f(){ result := seed * " + text + "; info.GTTTraceCaptureNumeric(hit,result,info.GTTNumericInput{Kind:\"scaling\",Value:seed}) }"
+		got, err := rewriteNumericRecipes("test.go", []byte(src))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(got), "numeric_recipe_source_slice_unsupported") {
+			t.Fatalf("unbound array silently independent: %s", got)
+		}
+	}
+}
+
+func TestNumericRecipeNestedUpstreamAdditions(t *testing.T) {
+	for _, row := range []struct{ path, old, next, want string }{
+		{"../reactable/catalyze.go", "1.15 * base", "7.25 * base", "Value:7.25"},
+		{"../core/combat/reaction.go", "1200 + em", "1739 + em", "Value:1739"},
+	} {
+		src, err := os.ReadFile(row.path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		changed := strings.Replace(string(src), row.old, row.next, 1)
+		if changed == string(src) {
+			t.Fatal("fixture source changed", row.path)
+		}
+		out, err := rewriteNumericRecipes(row.path, []byte(changed))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(out), row.want) || strings.Contains(string(out), "numeric_recipe_source_slice_unsupported") {
+			t.Fatal("source addition/curve not followed", row.path)
+		}
+	}
+}
diff --git a/pkg/gttsourcegen/overlay.go b/pkg/gttsourcegen/overlay.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/overlay.go
@@ -0,0 +1,837 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"fmt"
+	"go/ast"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+)
+
+type OverlayOptions struct {
+	ModuleRoot string
+	OverlayDir string
+}
+
+type OverlayFile struct {
+	RelativeFile    string
+	OriginalPath    string
+	ReplacementPath string
+	Contents        []byte
+}
+
+type OverlayResult struct {
+	Files []OverlayFile
+	JSON  []byte
+}
+
+type goOverlay struct {
+	Replace map[string]string `json:"Replace"`
+}
+
+type textEdit struct {
+	start       int
+	end         int
+	replacement string
+}
+
+type sharedAttackRoot struct {
+	entry            SourceEntry
+	readFrame        string
+	explicitSourceID bool
+}
+
+// BuildOverlay constructs a Go build overlay without mutating the source tree.
+// Only structurally supported source roots are rewritten. Every rewrite stages
+// source expressions before metadata attachment so simulator expressions keep
+// their original single-evaluation semantics.
+func BuildOverlay(opts OverlayOptions, manifest Manifest) (OverlayResult, error) {
+	root, err := filepath.Abs(strings.TrimSpace(opts.ModuleRoot))
+	if err != nil {
+		return OverlayResult{}, fmt.Errorf("overlay module root: %w", err)
+	}
+	overlayDir, err := filepath.Abs(strings.TrimSpace(opts.OverlayDir))
+	if err != nil {
+		return OverlayResult{}, fmt.Errorf("overlay directory: %w", err)
+	}
+	if strings.TrimSpace(opts.OverlayDir) == "" {
+		return OverlayResult{}, fmt.Errorf("overlay directory is required")
+	}
+
+	byFile := make(map[string][]SourceEntry)
+	snapshotEntries := make(map[string][]SourceEntry)
+	// Engine adapter seam, not a gameplay dispatch table. The recipe compiler
+	// follows marked scalar calculations regardless of function/reaction names.
+	if _, err := os.Stat(filepath.Join(root, "pkg", "enemy", "damage.go")); err == nil {
+		byFile["pkg/enemy/damage.go"] = nil
+	}
+	for _, rel := range []string{"pkg/core/combat/reaction.go", "pkg/reactable/catalyze.go", "pkg/reactable/lunarcharged.go", "pkg/reactable/lunarcrystallize.go"} {
+		if _, err := os.Stat(filepath.Join(root, filepath.FromSlash(rel))); err == nil {
+			byFile[rel] = nil
+		}
+	}
+	for _, entry := range manifest.Entries {
+		if entry.Locator.Seam == KindQueuedAttack && entry.traceRuntimePath != "" {
+			snapshotEntries[entry.RelativeFile] = append(snapshotEntries[entry.RelativeFile], entry)
+			if _, ok := byFile[entry.RelativeFile]; !ok {
+				byFile[entry.RelativeFile] = nil
+			}
+		}
+		switch entry.Locator.Seam {
+		case KindQueuedAttack:
+			if entry.flatHelper == nil && (entry.Template.Status != TemplateSupported || len(entry.parameterPlans) == 0) {
+				continue
+			}
+		case KindHealthInput:
+			if entry.Template.Status != TemplateSupported || entry.healthInput == nil {
+				continue
+			}
+		case KindModifierAmount:
+			if entry.savedVector == nil && entry.capturedScalar == nil && (entry.Template.Status != TemplateSupported || entry.modifierOutput == nil) {
+				continue
+			}
+		case KindEventCallback, KindTaskCallback:
+			if entry.callback == nil {
+				continue
+			}
+		case KindStateOperation:
+			if entry.stateOperation == nil {
+				continue
+			}
+		default:
+			continue
+		}
+		byFile[entry.RelativeFile] = append(byFile[entry.RelativeFile], entry)
+		if entry.savedVector != nil {
+			for _, write := range entry.savedVector.Writes {
+				if write.File != entry.RelativeFile {
+					byFile[write.File] = append(byFile[write.File], entry)
+				}
+			}
+		}
+		if entry.flatHelper != nil && entry.flatHelper.File != entry.RelativeFile {
+			byFile[entry.flatHelper.File] = append(byFile[entry.flatHelper.File], entry)
+		}
+		if entry.callback != nil && entry.callback.ResolvedFile != "" && entry.callback.ResolvedFile != entry.RelativeFile {
+			byFile[entry.callback.ResolvedFile] = append(byFile[entry.callback.ResolvedFile], entry)
+		}
+		if entry.callback != nil {
+			for _, helper := range entry.callback.OrdinaryHelpers {
+				if helper.ResolvedFile != "" && helper.ResolvedFile != entry.RelativeFile {
+					byFile[helper.ResolvedFile] = append(byFile[helper.ResolvedFile], entry)
+				}
+			}
+		}
+	}
+	rels := make([]string, 0, len(byFile))
+	for rel := range byFile {
+		rels = append(rels, rel)
+	}
+	sort.Strings(rels)
+
+	result := OverlayResult{Files: make([]OverlayFile, 0, len(rels))}
+	replacements := make(map[string]string, len(rels))
+	for _, rel := range rels {
+		original := filepath.Join(root, filepath.FromSlash(rel))
+		data, err := os.ReadFile(original)
+		if err != nil {
+			return OverlayResult{}, fmt.Errorf("read overlay source %s: %w", rel, err)
+		}
+		rewritten, err := rewriteOverlayFileWithSnapshots(rel, data, byFile[rel], snapshotEntries[rel])
+		if err != nil {
+			return OverlayResult{}, fmt.Errorf("rewrite %s: %w", rel, err)
+		}
+		rewritten, err = rewriteNumericRecipes(rel, rewritten)
+		if err != nil {
+			return OverlayResult{}, fmt.Errorf("numeric recipe %s: %w", rel, err)
+		}
+		rewritten, err = rewriteContributorGroups(rel, rewritten)
+		if err != nil {
+			return OverlayResult{}, fmt.Errorf("contributor group %s: %w", rel, err)
+		}
+		replacement := filepath.Join(overlayDir, filepath.FromSlash(rel))
+		replacements[filepath.Clean(original)] = filepath.Clean(replacement)
+		result.Files = append(result.Files, OverlayFile{
+			RelativeFile: rel, OriginalPath: filepath.Clean(original),
+			ReplacementPath: filepath.Clean(replacement), Contents: rewritten,
+		})
+	}
+	result.JSON, err = CanonicalJSON(goOverlay{Replace: replacements})
+	if err != nil {
+		return OverlayResult{}, fmt.Errorf("canonical overlay: %w", err)
+	}
+	return result, nil
+}
+
+func rewriteOverlayFile(rel string, data []byte, wanted []SourceEntry) ([]byte, error) {
+	return rewriteOverlayFileWithSnapshots(rel, data, wanted, nil)
+}
+
+func rewriteOverlayFileWithSnapshots(rel string, data []byte, wanted, snapshotEntries []SourceEntry) ([]byte, error) {
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, rel, data, parser.SkipObjectResolution)
+	if err != nil {
+		return nil, err
+	}
+	tokenFile := fset.File(file.Pos())
+	if tokenFile == nil {
+		return nil, fmt.Errorf("missing token file")
+	}
+	wantedByLine := make(map[string]SourceEntry, len(wanted))
+	for _, entry := range wanted {
+		if entry.RelativeFile != rel || (entry.Locator.Seam != KindQueuedAttack && entry.Locator.Seam != KindHealthInput) {
+			continue
+		}
+		key := entry.Locator.Seam + "|" + strconv.Itoa(entry.Line)
+		if previous, exists := wantedByLine[key]; exists {
+			return nil, fmt.Errorf("ambiguous %s line %d (%s and %s)", entry.Locator.Seam, entry.Line, previous.SourceID, entry.SourceID)
+		}
+		wantedByLine[key] = entry
+	}
+
+	edits := make([]textEdit, 0, len(wanted)*4)
+	snapshotEdits := snapshotFlatEdits(fset, tokenFile, file, snapshotEntries)
+	edits = append(edits, snapshotEdits...)
+	directives := make(map[int]int)
+	found := make(map[string]bool, len(wanted))
+	rootSeen := make(map[token.Pos]sharedAttackRoot)
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		bindings := collectBindings(fn.Body)
+		ast.Inspect(fn.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			line := fset.Position(call.Pos()).Line
+			forwardedKey := KindQueuedAttack + "|" + strconv.Itoa(line)
+			if entry, exists := wantedByLine[forwardedKey]; exists && entry.forwardedAttack != nil {
+				plan := entry.forwardedAttack
+				if plan.ArgumentIndex < 0 || plan.ArgumentIndex >= len(call.Args) {
+					err = fmt.Errorf("forwarded entry %s argument index is no longer valid", entry.LookupKey)
+					return false
+				}
+				attackRoot := resolveAttackInfo(call.Args[plan.ArgumentIndex], bindings)
+				composite, compositeOK := attackRoot.(*ast.CompositeLit)
+				if !compositeOK {
+					err = fmt.Errorf("forwarded entry %s no longer resolves to AttackInfo composite", entry.LookupKey)
+					return false
+				}
+				readFrame := plan.ReadFrameExpression
+				if readFrame == "" || !safeSelectorChain(readFrame) {
+					err = fmt.Errorf("forwarded entry %s has invalid read frame", entry.LookupKey)
+					return false
+				}
+				if previous, already := rootSeen[composite.Pos()]; already {
+					if !reflect.DeepEqual(previous.entry.Template, entry.Template) || !reflect.DeepEqual(previous.entry.parameterPlans, entry.parameterPlans) || previous.readFrame != readFrame || !previous.explicitSourceID {
+						err = fmt.Errorf("AttackInfo root shared by %s and %s has conflicting forwarded plans", previous.entry.LookupKey, entry.LookupKey)
+						return false
+					}
+					found[forwardedKey] = true
+					return true
+				}
+				rootSeen[composite.Pos()] = sharedAttackRoot{entry: entry, readFrame: readFrame, explicitSourceID: true}
+				rootEdits, editErr := queuedAttackEdits(fset, tokenFile, data, fn, composite, entry, readFrame, true)
+				if editErr != nil {
+					err = editErr
+					return false
+				}
+				edits = append(edits, rootEdits...)
+				found[forwardedKey] = true
+				return true
+			}
+			kind, _, _, matched := describeSeamCall(fset, call, bindings)
+			if matched {
+				statement := containingStatement(fn.Body, call)
+				if statement != nil {
+					start := lineStart(data, tokenFile.Offset(statement.Pos()))
+					line := fset.Position(call.Pos()).Line
+					if existing, exists := directives[start]; !exists || line < existing {
+						directives[start] = line
+					}
+				}
+			}
+			if kind != KindQueuedAttack && kind != KindHealthInput {
+				return true
+			}
+			entry, ok := wantedByLine[kind+"|"+strconv.Itoa(line)]
+			if !ok {
+				return true
+			}
+			if kind == KindHealthInput {
+				root := resolveHealthInfo(call.Args[0], bindings, selectorFinalName(call.Fun))
+				composite, ok := root.(*ast.CompositeLit)
+				if !ok {
+					err = fmt.Errorf("supported entry %s no longer resolves to health info composite", entry.LookupKey)
+					return false
+				}
+				rootEdits, editErr := healthInputEdits(fset, tokenFile, data, file, fn, composite, entry)
+				if editErr != nil {
+					err = editErr
+					return false
+				}
+				edits = append(edits, rootEdits...)
+				found[kind+"|"+strconv.Itoa(line)] = true
+				return true
+			}
+			attackRoot := resolveAttackInfo(call.Args[0], bindings)
+			composite, ok := attackRoot.(*ast.CompositeLit)
+			if !ok {
+				err = fmt.Errorf("supported entry %s no longer resolves to AttackInfo composite", entry.LookupKey)
+				return false
+			}
+			readFrame, frameErr := queueReadFrameExpression(fset, call)
+			if frameErr != nil {
+				err = frameErr
+				return false
+			}
+			if previous, exists := rootSeen[composite.Pos()]; exists {
+				if !reflect.DeepEqual(previous.entry.Template, entry.Template) || !reflect.DeepEqual(previous.entry.parameterPlans, entry.parameterPlans) || previous.readFrame != readFrame || previous.explicitSourceID {
+					err = fmt.Errorf("AttackInfo root shared by %s and %s has conflicting template, parameter, or read-frame plans", previous.entry.LookupKey, entry.LookupKey)
+					return false
+				}
+				found[kind+"|"+strconv.Itoa(line)] = true
+				return true
+			}
+			rootSeen[composite.Pos()] = sharedAttackRoot{entry: entry, readFrame: readFrame}
+			rootEdits, editErr := queuedAttackEdits(fset, tokenFile, data, fn, composite, entry, readFrame, false)
+			if editErr != nil {
+				err = editErr
+				return false
+			}
+			edits = append(edits, rootEdits...)
+			found[kind+"|"+strconv.Itoa(line)] = true
+			return true
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+	for key, entry := range wantedByLine {
+		if !found[key] {
+			return nil, fmt.Errorf("supported entry not found: %s", entry.LookupKey)
+		}
+	}
+	v6Edits, needsTraceImport, v6Err := v6InstrumentationEdits(fset, tokenFile, data, rel, file, wanted)
+	if v6Err != nil {
+		return nil, v6Err
+	}
+	edits = append(edits, v6Edits...)
+	vectorEdits, vectorTrace, vectorErr := savedVectorEdits(fset, tokenFile, data, rel, file, wanted)
+	if vectorErr != nil {
+		return nil, vectorErr
+	}
+	edits = append(edits, vectorEdits...)
+	scalarEdits, scalarTrace, scalarErr := capturedScalarEdits(fset, tokenFile, rel, file, wanted)
+	if scalarErr != nil {
+		return nil, scalarErr
+	}
+	edits = append(edits, scalarEdits...)
+	vectorTrace = vectorTrace || scalarTrace
+	needsTraceImport = needsTraceImport || vectorTrace
+	needsTraceImport = needsTraceImport || len(snapshotEdits) > 0
+	helperEdits, helperTrace, helperErr := flatHelperBodyEdits(fset, tokenFile, data, rel, file, wanted)
+	if helperErr != nil {
+		return nil, helperErr
+	}
+	edits = append(edits, helperEdits...)
+	needsTraceImport = needsTraceImport || helperTrace
+	for _, edit := range edits {
+		if strings.Contains(edit.replacement, traceImportAlias+".") {
+			needsTraceImport = true
+		}
+	}
+	for _, entry := range wanted {
+		if entry.RelativeFile == rel && entry.flatHelper != nil {
+			needsTraceImport = true
+		}
+	}
+	if needsTraceImport {
+		importEdit, importErr := ensureTraceImportEdit(fset, tokenFile, data, file)
+		if importErr != nil {
+			return nil, importErr
+		}
+		if importEdit != nil {
+			edits = append(edits, *importEdit)
+		}
+	}
+	for offset, originalLine := range directives {
+		edits = append(edits, textEdit{
+			start: offset, end: offset,
+			replacement: "//line " + rel + ":" + strconv.Itoa(originalLine) + "\n",
+		})
+	}
+	rewritten, err := applyTextEdits(data, edits)
+	if err != nil {
+		return nil, err
+	}
+	formatted, err := format.Source(rewritten)
+	if err != nil {
+		return nil, fmt.Errorf("format rewritten source: %w", err)
+	}
+	return formatted, nil
+}
+
+func healthInputEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	file *ast.File,
+	fn *ast.FuncDecl,
+	composite *ast.CompositeLit,
+	entry SourceEntry,
+) ([]textEdit, error) {
+	if entry.healthInput == nil {
+		return nil, fmt.Errorf("supported health entry %s has no input plan", entry.LookupKey)
+	}
+	value := compositeKeyValue(composite, entry.healthInput.ValueField)
+	if value == nil {
+		return nil, fmt.Errorf("supported health entry %s has no %s field", entry.LookupKey, entry.healthInput.ValueField)
+	}
+	for _, reserved := range []string{"GTTTraceSourceID", "GTTTraceSourceTemplateSHA256", "GTTTraceSourceParameters", "GTTTraceInputEventID"} {
+		if compositeKeyValue(composite, reserved) != nil {
+			return nil, fmt.Errorf("health info already contains %s", reserved)
+		}
+	}
+	statement := containingStatement(fn.Body, composite)
+	if statement == nil {
+		return nil, fmt.Errorf("health info has no containing statement")
+	}
+	infoQualifier := expressionQualifier(composite.Type)
+	if infoQualifier == "" {
+		return nil, fmt.Errorf("health info type must have a package qualifier")
+	}
+	receiver := receiverName(fn)
+	traceExpression, traceOK := entryTraceExpression(receiver, entry)
+	if !traceOK {
+		return nil, fmt.Errorf("health input cannot resolve trace runtime: %s", entry.traceRuntimeReason)
+	}
+	if edits, ok := typedHealthInputEdits(fset, tokenFile, data, file, fn, composite, entry, traceExpression); ok {
+		return edits, nil
+	}
+	prefix := "gttSource_" + entry.SourceID[:12] + "_"
+	plans := append([]parameterPlan(nil), entry.parameterPlans...)
+	sort.Slice(plans, func(i, j int) bool { return plans[i].ParameterKey < plans[j].ParameterKey })
+	tempByKey := make(map[string]string, len(plans))
+	actorTemp := make(map[string]string)
+	statTemp := make(map[string]string)
+	var declarations strings.Builder
+	indent := indentationBefore(data, tokenFile.Offset(statement.Pos()))
+	frameExpression := ""
+	if len(plans) > 0 {
+		frameExpression = prefix + "frame"
+		fmt.Fprintf(&declarations, "%s := %s.Frame()\n%s", frameExpression, traceExpression, indent)
+	}
+	for _, parameter := range plans {
+		name := prefix + sanitizeIdentifier(parameter.ParameterKey)
+		tempByKey[parameter.ParameterKey] = name
+		fmt.Fprintf(&declarations, "%s := float64(%s)\n%s", name, parameter.SourceExpression, indent)
+		if parameter.ActorExpression != "" {
+			if !safeSelectorChain(parameter.ActorExpression) {
+				return nil, fmt.Errorf("parameter %s actor expression is not a safe selector chain", parameter.ParameterKey)
+			}
+			if _, exists := actorTemp[parameter.ActorExpression]; !exists {
+				actorName := prefix + "actor_" + strconv.Itoa(len(actorTemp))
+				actorTemp[parameter.ActorExpression] = actorName
+				fmt.Fprintf(&declarations, "%s_index := %s.Index()\n%s", actorName, parameter.ActorExpression, indent)
+				fmt.Fprintf(&declarations, "%s_key := %s.Base.Key.String()\n%s", actorName, parameter.ActorExpression, indent)
+			}
+		}
+		if parameter.StatKey != "" {
+			if _, exists := statTemp[parameter.StatKey]; !exists {
+				statName := prefix + "stat_" + strconv.Itoa(len(statTemp))
+				statTemp[parameter.StatKey] = statName
+				fmt.Fprintf(&declarations, "%s := %s\n%s", statName, parameterStatExpression(parameter), indent)
+			}
+		}
+	}
+	if entry.Template.RootNodeID == nil {
+		return nil, fmt.Errorf("supported health template has nil root")
+	}
+	rendered, err := renderTemplateExpression(entry.Template.Nodes, *entry.Template.RootNodeID, tempByKey)
+	if err != nil {
+		return nil, err
+	}
+	inputTemp := prefix + "input"
+	inputExpression := rendered
+	if _, precomputed := value.Value.(*ast.Ident); precomputed {
+		// Preserve an already-computed local as the gameplay input. Parameter
+		// reads remain diagnostic evidence, while the original value is neither
+		// discarded nor recomputed for the actual Heal/Drain call.
+		inputExpression = "float64(" + rootText(fset, value.Value) + ")"
+	}
+	fmt.Fprintf(&declarations, "%s := float64(%s)\n%s", inputTemp, inputExpression, indent)
+	parameters, err := renderParameterSlice(infoQualifier, frameExpression, plans, tempByKey, actorTemp, statTemp)
+	if err != nil {
+		return nil, err
+	}
+	metadata := healthMetadataInsertion(data, tokenFile, composite, entry, parameters)
+	return []textEdit{
+		{start: tokenFile.Offset(statement.Pos()), end: tokenFile.Offset(statement.Pos()), replacement: declarations.String()},
+		{start: tokenFile.Offset(value.Value.Pos()), end: tokenFile.Offset(value.Value.End()), replacement: inputTemp},
+		{start: tokenFile.Offset(composite.Rbrace), end: tokenFile.Offset(composite.Rbrace), replacement: metadata},
+	}, nil
+}
+
+func healthMetadataInsertion(data []byte, tokenFile *token.File, composite *ast.CompositeLit, entry SourceEntry, parameters string) string {
+	rbrace := tokenFile.Offset(composite.Rbrace)
+	prefix := ""
+	if len(composite.Elts) > 0 {
+		lastEnd := tokenFile.Offset(composite.Elts[len(composite.Elts)-1].End())
+		if !bytes.Contains(data[lastEnd:rbrace], []byte(",")) {
+			prefix = ","
+		}
+	}
+	return prefix + "GTTTraceSourceID:" + strconv.Quote(entry.SourceID) +
+		",GTTTraceSourceTemplateSHA256:" + strconv.Quote(entry.Template.TemplateSHA256) +
+		",GTTTraceSourceParameters:" + parameters + ","
+}
+
+func selectorFinalName(expr ast.Expr) string {
+	selector, _ := expr.(*ast.SelectorExpr)
+	if selector == nil {
+		return ""
+	}
+	return selector.Sel.Name
+}
+
+func queuedAttackEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	fn *ast.FuncDecl,
+	composite *ast.CompositeLit,
+	entry SourceEntry,
+	readFrame string,
+	explicitSourceID bool,
+) ([]textEdit, error) {
+	if entry.flatHelper != nil {
+		return flatHelperCallEdits(fset, tokenFile, data, fn, composite, entry)
+	}
+	flat := compositeKeyValue(composite, "FlatDmg")
+	if flat == nil {
+		return nil, fmt.Errorf("supported entry %s has no FlatDmg field", entry.LookupKey)
+	}
+	if pureStatInput(fset, flat.Value) && entry.traceRuntimePath != "" {
+		return directFlatStatEdits(fset, tokenFile, data, fn, composite, entry, explicitSourceID)
+	}
+	for _, reserved := range []string{"GTTTraceSourceID", "GTTTraceSourceTemplateSHA256", "GTTTraceSourceParameters"} {
+		if compositeKeyValue(composite, reserved) != nil {
+			return nil, fmt.Errorf("AttackInfo already contains %s", reserved)
+		}
+	}
+	statement := containingStatement(fn.Body, composite)
+	if statement == nil {
+		return nil, fmt.Errorf("AttackInfo has no containing statement")
+	}
+	infoQualifier := expressionQualifier(composite.Type)
+	if infoQualifier == "" {
+		return nil, fmt.Errorf("AttackInfo type must have a package qualifier")
+	}
+	prefix := "gttSource_" + entry.SourceID[:12] + "_"
+	plans := append([]parameterPlan(nil), entry.parameterPlans...)
+	sort.Slice(plans, func(i, j int) bool { return plans[i].ParameterKey < plans[j].ParameterKey })
+	tempByKey := make(map[string]string, len(plans))
+	var declarations strings.Builder
+	indent := indentationBefore(data, tokenFile.Offset(statement.Pos()))
+	actorTemp := make(map[string]string)
+	statTemp := make(map[string]string)
+	for _, parameter := range plans {
+		if parameter.SourceExpression == "" {
+			return nil, fmt.Errorf("parameter %s has empty source expression", parameter.ParameterKey)
+		}
+		name := prefix + sanitizeIdentifier(parameter.ParameterKey)
+		tempByKey[parameter.ParameterKey] = name
+		fmt.Fprintf(&declarations, "%s := float64(%s)\n%s", name, parameter.SourceExpression, indent)
+		if parameter.ActorExpression != "" {
+			if !safeSelectorChain(parameter.ActorExpression) {
+				return nil, fmt.Errorf("parameter %s actor expression is not a safe selector chain", parameter.ParameterKey)
+			}
+			if _, exists := actorTemp[parameter.ActorExpression]; !exists {
+				actorName := prefix + "actor_" + strconv.Itoa(len(actorTemp))
+				actorTemp[parameter.ActorExpression] = actorName
+				fmt.Fprintf(&declarations, "%s_index := %s.Index()\n%s", actorName, parameter.ActorExpression, indent)
+				fmt.Fprintf(&declarations, "%s_key := %s.Base.Key.String()\n%s", actorName, parameter.ActorExpression, indent)
+			}
+		}
+		if parameter.StatKey != "" {
+			if _, exists := statTemp[parameter.StatKey]; !exists {
+				statName := prefix + "stat_" + strconv.Itoa(len(statTemp))
+				statTemp[parameter.StatKey] = statName
+				fmt.Fprintf(&declarations, "%s := %s\n%s", statName, parameterStatExpression(parameter), indent)
+			}
+		}
+	}
+	if entry.Template.RootNodeID == nil {
+		return nil, fmt.Errorf("supported template has nil root")
+	}
+	renderedExpression, err := renderTemplateExpression(entry.Template.Nodes, *entry.Template.RootNodeID, tempByKey)
+	if err != nil {
+		return nil, err
+	}
+	parameters, err := renderParameterSlice(infoQualifier, readFrame, plans, tempByKey, actorTemp, statTemp)
+	if err != nil {
+		return nil, err
+	}
+	metadata := compositeMetadataInsertion(data, tokenFile, composite, entry, parameters, explicitSourceID)
+	return []textEdit{
+		{start: tokenFile.Offset(statement.Pos()), end: tokenFile.Offset(statement.Pos()), replacement: declarations.String()},
+		{start: tokenFile.Offset(flat.Value.Pos()), end: tokenFile.Offset(flat.Value.End()), replacement: renderedExpression},
+		{start: tokenFile.Offset(composite.Rbrace), end: tokenFile.Offset(composite.Rbrace), replacement: metadata},
+	}, nil
+}
+
+func renderParameterSlice(
+	infoQualifier string,
+	readFrame string,
+	parameters []parameterPlan,
+	tempByKey map[string]string,
+	actorTemp map[string]string,
+	statTemp map[string]string,
+) (string, error) {
+	var out strings.Builder
+	fmt.Fprintf(&out, "[]%s.GTTTraceSourceParameter{", infoQualifier)
+	if len(parameters) > 0 && (readFrame == "" || !safeSelectorChain(readFrame)) {
+		return "", fmt.Errorf("supported parameter overlay cannot resolve a nonnegative read frame")
+	}
+	for _, parameter := range parameters {
+		value, ok := tempByKey[parameter.ParameterKey]
+		if !ok {
+			return "", fmt.Errorf("missing temporary for parameter %s", parameter.ParameterKey)
+		}
+		actor := "nil"
+		actorKey := "nil"
+		if parameter.ActorExpression != "" {
+			actor = "&" + actorTemp[parameter.ActorExpression] + "_index"
+			actorKey = "&" + actorTemp[parameter.ActorExpression] + "_key"
+		}
+		stat := "nil"
+		if parameter.StatKey != "" {
+			stat = "&" + statTemp[parameter.StatKey]
+		}
+		frame := readFrame
+		fmt.Fprintf(&out, "{ParameterKey:%s,Kind:%s,ObservedValue:%s,ActorIndex:%s,ActorKey:%s,StatKey:%s,ReadMode:%s,ReadFrame:%s,CandidateDependencyComplete:%t},",
+			strconv.Quote(parameter.ParameterKey), strconv.Quote(parameter.Kind), value,
+			actor, actorKey, stat, strconv.Quote(parameter.ReadMode), frame,
+			parameter.CandidateDependencyComplete,
+		)
+	}
+	out.WriteByte('}')
+	return out.String(), nil
+}
+
+func queueReadFrameExpression(fset *token.FileSet, call *ast.CallExpr) (string, error) {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return "", fmt.Errorf("queued attack call has no selector receiver")
+	}
+	frame := rootText(fset, selector.X) + ".F"
+	if !safeSelectorChain(frame) {
+		return "", fmt.Errorf("queued attack receiver cannot provide a stable read frame: %s", rootText(fset, selector.X))
+	}
+	return frame, nil
+}
+
+func compositeMetadataInsertion(data []byte, tokenFile *token.File, composite *ast.CompositeLit, entry SourceEntry, parameters string, explicitSourceID bool) string {
+	rbrace := tokenFile.Offset(composite.Rbrace)
+	prefix := ""
+	if len(composite.Elts) > 0 {
+		lastEnd := tokenFile.Offset(composite.Elts[len(composite.Elts)-1].End())
+		if !bytes.Contains(data[lastEnd:rbrace], []byte(",")) {
+			prefix = ","
+		}
+	}
+	if explicitSourceID {
+		prefix += "GTTTraceSourceID:" + strconv.Quote(entry.SourceID) + ","
+	}
+	return prefix + "GTTTraceSourceTemplateSHA256:" + strconv.Quote(entry.Template.TemplateSHA256) +
+		",GTTTraceSourceParameters:" + parameters + ","
+}
+
+func renderTemplateExpression(nodes []TemplateNode, root int, parameters map[string]string) (string, error) {
+	if root < 0 || root >= len(nodes) || nodes[root].NodeID != root {
+		return "", fmt.Errorf("invalid template root %d", root)
+	}
+	node := nodes[root]
+	if node.Operator == "PARAM" {
+		if node.ParameterKey == nil {
+			return "", fmt.Errorf("PARAM node %d has nil key", root)
+		}
+		value, ok := parameters[*node.ParameterKey]
+		if !ok {
+			return "", fmt.Errorf("template references unknown parameter %q", *node.ParameterKey)
+		}
+		return value, nil
+	}
+	if node.Operator == "CONST" {
+		if node.ConstantValue == nil {
+			return "", fmt.Errorf("CONST node %d has nil value", root)
+		}
+		return strconv.FormatFloat(*node.ConstantValue, 'g', -1, 64), nil
+	}
+	children := make([]string, len(node.InputNodeIDs))
+	for index, child := range node.InputNodeIDs {
+		value, err := renderTemplateExpression(nodes, child, parameters)
+		if err != nil {
+			return "", err
+		}
+		children[index] = value
+	}
+	binary := map[string]string{"ADD": "+", "SUB": "-", "MUL": "*", "DIV": "/"}
+	if operator, ok := binary[node.Operator]; ok && len(children) == 2 {
+		return "(" + children[0] + " " + operator + " " + children[1] + ")", nil
+	}
+	switch node.Operator {
+	case "MIN", "MAX":
+		if len(children) == 2 {
+			return strings.ToLower(node.Operator) + "(" + strings.Join(children, ",") + ")", nil
+		}
+	case "ABS":
+		if len(children) == 1 {
+			return "math.Abs(" + children[0] + ")", nil
+		}
+	}
+	return "", fmt.Errorf("unsupported rendered template operation %s", node.Operator)
+}
+
+func compositeKeyValue(composite *ast.CompositeLit, field string) *ast.KeyValueExpr {
+	for _, element := range composite.Elts {
+		keyValue, ok := element.(*ast.KeyValueExpr)
+		if !ok {
+			continue
+		}
+		key, ok := keyValue.Key.(*ast.Ident)
+		if ok && key.Name == field {
+			return keyValue
+		}
+	}
+	return nil
+}
+
+func containingStatement(body *ast.BlockStmt, target ast.Node) ast.Stmt {
+	var best ast.Stmt
+	ast.Inspect(body, func(node ast.Node) bool {
+		statement, ok := node.(ast.Stmt)
+		if !ok || statement.Pos() > target.Pos() || statement.End() < target.End() {
+			return true
+		}
+		if best == nil || statement.End()-statement.Pos() < best.End()-best.Pos() {
+			best = statement
+		}
+		return true
+	})
+	return best
+}
+
+func expressionQualifier(expr ast.Expr) string {
+	switch value := expr.(type) {
+	case *ast.SelectorExpr:
+		if ident, ok := value.X.(*ast.Ident); ok {
+			return ident.Name
+		}
+	case *ast.IndexExpr:
+		return expressionQualifier(value.X)
+	case *ast.IndexListExpr:
+		return expressionQualifier(value.X)
+	}
+	return ""
+}
+
+func receiverName(fn *ast.FuncDecl) string {
+	if fn.Recv == nil || len(fn.Recv.List) == 0 || len(fn.Recv.List[0].Names) == 0 {
+		return ""
+	}
+	return fn.Recv.List[0].Names[0].Name
+}
+
+func safeSelectorChain(value string) bool {
+	if value == "" {
+		return false
+	}
+	for index, part := range strings.Split(value, ".") {
+		if part == "" {
+			return false
+		}
+		for offset, char := range part {
+			if !(unicode.IsLetter(char) || char == '_' || (offset > 0 && unicode.IsDigit(char))) {
+				return false
+			}
+		}
+		if index == 0 && part == "_" {
+			return false
+		}
+	}
+	return true
+}
+
+func sanitizeIdentifier(value string) string {
+	var out strings.Builder
+	for index, char := range value {
+		if unicode.IsLetter(char) || char == '_' || (index > 0 && unicode.IsDigit(char)) {
+			out.WriteRune(char)
+		} else {
+			out.WriteByte('_')
+		}
+	}
+	if out.Len() == 0 {
+		return "value"
+	}
+	return out.String()
+}
+
+func indentationBefore(data []byte, offset int) string {
+	start := lineStart(data, offset)
+	indent := data[start:offset]
+	for _, char := range indent {
+		if char != ' ' && char != '\t' {
+			return ""
+		}
+	}
+	return string(indent)
+}
+
+func lineStart(data []byte, offset int) int {
+	if offset > len(data) {
+		offset = len(data)
+	}
+	for offset > 0 && data[offset-1] != '\n' {
+		offset--
+	}
+	return offset
+}
+
+func applyTextEdits(data []byte, edits []textEdit) ([]byte, error) {
+	sort.SliceStable(edits, func(i, j int) bool {
+		if edits[i].start != edits[j].start {
+			return edits[i].start > edits[j].start
+		}
+		if edits[i].end != edits[j].end {
+			return edits[i].end > edits[j].end
+		}
+		return edits[i].replacement < edits[j].replacement
+	})
+	result := append([]byte(nil), data...)
+	lastStart := len(data) + 1
+	for _, edit := range edits {
+		if edit.start < 0 || edit.end < edit.start || edit.end > len(data) {
+			return nil, fmt.Errorf("invalid text edit [%d,%d)", edit.start, edit.end)
+		}
+		if edit.end > lastStart {
+			return nil, fmt.Errorf("overlapping text edits at %d", edit.start)
+		}
+		result = append(result[:edit.start], append([]byte(edit.replacement), result[edit.end:]...)...)
+		lastStart = edit.start
+	}
+	return result, nil
+}
diff --git a/pkg/gttsourcegen/pure_locals.go b/pkg/gttsourcegen/pure_locals.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/pure_locals.go
@@ -0,0 +1,386 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"strconv"
+)
+
+// Bounded scalar SSA slice. Only literal arithmetic, already-executed typed
+// stat reads, and pure numeric branches are replayed. No loop, call, task or
+// modifier eligibility branch is speculatively executed.
+type pureLocalNode struct {
+	op, text  string
+	args      []*pureLocalNode
+	input     *ast.AssignStmt
+	reduction *ast.RangeStmt
+}
+type pureLocalState struct {
+	fs     *token.FileSet
+	inputs map[*ast.AssignStmt]*pureLocalNode
+	budget int
+}
+
+func (s *pureLocalState) expression(e ast.Expr, env map[string]*pureLocalNode) *pureLocalNode {
+	s.budget++
+	if s.budget > 512 {
+		return nil
+	}
+	switch v := e.(type) {
+	case *ast.Ident:
+		return env[v.Name]
+	case *ast.BasicLit:
+		if v.Kind == token.INT || v.Kind == token.FLOAT {
+			return &pureLocalNode{op: "constant", text: v.Value}
+		}
+	case *ast.ParenExpr:
+		return s.expression(v.X, env)
+	case *ast.UnaryExpr:
+		if v.Op == token.SUB {
+			a := s.expression(v.X, env)
+			if a != nil {
+				return &pureLocalNode{op: "multiply", args: []*pureLocalNode{{op: "constant", text: "-1"}, a}}
+			}
+		}
+	case *ast.BinaryExpr:
+		op := map[token.Token]string{token.ADD: "add", token.SUB: "subtract", token.MUL: "multiply", token.QUO: "divide"}[v.Op]
+		if op == "" {
+			return nil
+		}
+		a, b := s.expression(v.X, env), s.expression(v.Y, env)
+		if a == nil || b == nil {
+			return nil
+		}
+		if op == "divide" {
+			if b.op != "constant" {
+				return nil
+			}
+			n, e := strconv.ParseFloat(b.text, 64)
+			if e != nil || n == 0 {
+				return nil
+			}
+		}
+		return &pureLocalNode{op: op, args: []*pureLocalNode{a, b}}
+	}
+	return nil
+}
+
+func copyPureEnv(env map[string]*pureLocalNode) map[string]*pureLocalNode {
+	out := map[string]*pureLocalNode{}
+	for k, v := range env {
+		out[k] = v
+	}
+	return out
+}
+
+func (s *pureLocalState) statement(stmt ast.Stmt, env map[string]*pureLocalNode, allowRead bool) bool {
+	switch v := stmt.(type) {
+	case *ast.AssignStmt:
+		if len(v.Lhs) != 1 || len(v.Rhs) != 1 {
+			return false
+		}
+		id, ok := v.Lhs[0].(*ast.Ident)
+		if !ok {
+			return false
+		}
+		if !allowRead && v.Tok == token.DEFINE && env[id.Name] != nil {
+			return false
+		}
+		if allowRead && v.Tok == token.DEFINE {
+			if pureStatInput(s.fs, v.Rhs[0]) {
+				n := &pureLocalNode{op: "input", input: v, text: id.Name}
+				s.inputs[v] = n
+				env[id.Name] = n
+				return true
+			}
+		}
+		n := s.expression(v.Rhs[0], env)
+		if n == nil {
+			return false
+		}
+		if v.Tok != token.ASSIGN && v.Tok != token.DEFINE {
+			op := map[token.Token]string{token.ADD_ASSIGN: "add", token.SUB_ASSIGN: "subtract", token.MUL_ASSIGN: "multiply"}[v.Tok]
+			old := env[id.Name]
+			if op == "" || old == nil {
+				return false
+			}
+			n = &pureLocalNode{op: op, args: []*pureLocalNode{old, n}}
+		}
+		env[id.Name] = n
+		return true
+	case *ast.DeclStmt:
+		g, ok := v.Decl.(*ast.GenDecl)
+		if !ok || g.Tok != token.VAR {
+			return false
+		}
+		for _, spec := range g.Specs {
+			value, ok := spec.(*ast.ValueSpec)
+			if !ok || rootText(s.fs, value.Type) != "float64" || len(value.Values) != 0 {
+				return false
+			}
+			for _, id := range value.Names {
+				env[id.Name] = &pureLocalNode{op: "constant", text: "0"}
+			}
+		}
+		return true
+	case *ast.IfStmt:
+		if v.Init != nil {
+			return false
+		}
+		cond, ok := v.Cond.(*ast.BinaryExpr)
+		if !ok {
+			return false
+		}
+		a, b := s.expression(cond.X, env), s.expression(cond.Y, env)
+		if a == nil || b == nil {
+			return false
+		}
+		reverse := false
+		switch cond.Op {
+		case token.LSS:
+		case token.GTR:
+			a, b = b, a
+		case token.LEQ:
+			a, b = b, a
+			reverse = true
+		case token.GEQ:
+			reverse = true
+		default:
+			return false
+		}
+		yes, no := copyPureEnv(env), copyPureEnv(env)
+		for _, st := range v.Body.List {
+			if !s.statement(st, yes, false) {
+				return false
+			}
+		}
+		if v.Else != nil {
+			body, ok := v.Else.(*ast.BlockStmt)
+			if !ok {
+				return false
+			}
+			for _, st := range body.List {
+				if !s.statement(st, no, false) {
+					return false
+				}
+			}
+		}
+		for k, old := range env {
+			y, n := yes[k], no[k]
+			if y == nil || n == nil {
+				return false
+			}
+			if y == old && n == old {
+				continue
+			}
+			if reverse {
+				y, n = n, y
+			}
+			env[k] = &pureLocalNode{op: "select_lt", args: []*pureLocalNode{a, b, y, n}}
+		}
+		return true
+	case *ast.RangeStmt:
+		return allowRead && s.reduction(v, env)
+	}
+	return false
+}
+
+// Unsupported writes poison the affected local, including loops and address
+// escapes. Skipping an unrelated scheduling call cannot create a dependency.
+func invalidatePureLocals(stmt ast.Stmt, env map[string]*pureLocalNode) {
+	ast.Inspect(stmt, func(n ast.Node) bool {
+		switch v := n.(type) {
+		case *ast.AssignStmt:
+			for _, lhs := range v.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok {
+					delete(env, id.Name)
+				}
+			}
+		case *ast.IncDecStmt:
+			if id, ok := v.X.(*ast.Ident); ok {
+				delete(env, id.Name)
+			}
+		case *ast.ValueSpec:
+			for _, id := range v.Names {
+				delete(env, id.Name)
+			}
+		case *ast.UnaryExpr:
+			if v.Op == token.AND {
+				if id, ok := v.X.(*ast.Ident); ok {
+					delete(env, id.Name)
+				}
+			}
+		}
+		return true
+	})
+}
+
+type pureLocalEmitter struct {
+	field      *fieldExpression
+	serial     int
+	memo       map[*pureLocalNode]fieldValue
+	used       map[*ast.AssignStmt]bool
+	reductions map[*ast.RangeStmt]*pureLocalNode
+}
+
+func (e *pureLocalEmitter) emit(n *pureLocalNode) (fieldValue, error) {
+	if v, ok := e.memo[n]; ok {
+		return v, nil
+	}
+	e.serial++
+	serial := e.serial
+	if e.serial > 256 {
+		return fieldValue{}, fmt.Errorf("pure scalar slice budget")
+	}
+	if n.op == "constant" {
+		v := fieldValue{value: "float64(" + n.text + ")", ref: traceImportAlias + ".LiteralRef(float64(" + n.text + "))"}
+		e.memo[n] = v
+		return v, nil
+	}
+	if n.op == "input" {
+		p := fmt.Sprintf("gttPureInput_%d", n.input.Pos())
+		v := fieldValue{value: p + "_value", ref: p + "_ref"}
+		e.used[n.input] = true
+		e.memo[n] = v
+		return v, nil
+	}
+	if n.reduction != nil {
+		p := fmt.Sprintf("gttPureReduction_%d", n.reduction.Pos())
+		v := fieldValue{value: p + "_value", ref: p + "_ref"}
+		e.reductions[n.reduction] = n
+		e.memo[n] = v
+		return v, nil
+	}
+	args := []fieldValue{}
+	for _, a := range n.args {
+		v, err := e.emit(a)
+		if err != nil {
+			return fieldValue{}, err
+		}
+		args = append(args, v)
+	}
+	name := fmt.Sprintf("%s_pure_%d", e.field.prefix, serial)
+	expression := ""
+	if n.op == "select_lt" {
+		expression = fmt.Sprintf("func()float64{if %s<%s{return %s};return %s}()", args[0].value, args[1].value, args[2].value, args[3].value)
+	} else {
+		op := map[string]string{"add": "+", "subtract": "-", "multiply": "*", "divide": "/"}[n.op]
+		expression = "(" + args[0].value + op + args[1].value + ")"
+	}
+	references := ""
+	for i, a := range args {
+		if i > 0 {
+			references += ","
+		}
+		references += a.ref
+	}
+	fmt.Fprintf(&e.field.code, "%s:=%s;\n%s_ref:=%s.EventRef(%s.RecordNumericEval(%s,%q,[]%s.NumericRef{%s},%s,%s.IncompleteEvidence(\"pure_scalar_observed_schedule\")));\n", name, expression, name, traceImportAlias, e.field.rt, e.field.source, n.op, traceImportAlias, references, name, traceImportAlias)
+	v := fieldValue{value: name, ref: name + "_ref"}
+	e.memo[n] = v
+	return v, nil
+}
+
+func pureLocalValue(fs *token.FileSet, tf *token.File, file *ast.File, at token.Pos, rhs ast.Expr, field *fieldExpression) (fieldValue, []textEdit, bool) {
+	// A callback has its own execution time and lexical scope. Do not reuse
+	// the enclosing registration function's scalar environment inside it.
+	var block *ast.BlockStmt
+	ast.Inspect(file, func(n ast.Node) bool {
+		if n == nil || n.Pos() > at || n.End() < at {
+			return false
+		}
+		if b, ok := n.(*ast.BlockStmt); ok {
+			block = b
+		}
+		return true
+	})
+	if block == nil {
+		return fieldValue{}, nil, false
+	}
+	s := pureLocalState{fs: fs, inputs: map[*ast.AssignStmt]*pureLocalNode{}}
+	env := map[string]*pureLocalNode{}
+	for _, stmt := range block.List {
+		if stmt.End() >= at {
+			break
+		}
+		next := copyPureEnv(env)
+		if s.statement(stmt, next, true) {
+			env = next
+		} else {
+			invalidatePureLocals(stmt, env)
+		}
+	}
+	node := s.expression(rhs, env)
+	if node == nil {
+		return fieldValue{}, nil, false
+	}
+	emitter := pureLocalEmitter{field: field, memo: map[*pureLocalNode]fieldValue{}, used: map[*ast.AssignStmt]bool{}, reductions: map[*ast.RangeStmt]*pureLocalNode{}}
+	value, err := emitter.emit(node)
+	if err != nil || len(emitter.used)+len(emitter.reductions) == 0 {
+		return fieldValue{}, nil, false
+	}
+	edits := []textEdit{}
+	for loop, node := range emitter.reductions {
+		edit, err := emitPureReduction(fs, tf, file, field, loop, node)
+		if err != nil {
+			return fieldValue{}, nil, false
+		}
+		edits = append(edits, edit)
+	}
+	for input := range emitter.used {
+		prefix := fmt.Sprintf("gttPureInput_%d", input.Pos())
+		capture := fieldExpression{fset: fs, rt: field.rt, source: field.source, prefix: prefix, info: field.info, refs: map[string]string{}, constants: sourceNamedConstants(file)}
+		v, err := capture.emit(input.Rhs[0], 0)
+		if err != nil {
+			return fieldValue{}, nil, false
+		}
+		// Getter executes once in the actual source location; frozen copy and ref
+		// survive later scalar reassignment. No original branch is re-run.
+		code := fmt.Sprintf("%s\n%s := %s\n%s_value := %s\n%s_ref := %s\n", capture.code.String(), rootText(fs, input.Lhs[0]), v.value, prefix, v.value, prefix, v.ref)
+		edits = append(edits, textEdit{start: tf.Offset(input.Pos()), end: tf.Offset(input.End()), replacement: code})
+	}
+	return value, edits, true
+}
+
+// Accept an arithmetic expression of observed stat getters and numeric
+// literals. Capture the original RHS once, not the getter again at the later
+// vector write. Unknown calls, local reads and index side effects are denied.
+func pureStatInput(fs *token.FileSet, e ast.Expr) bool {
+	reads := 0
+	budget := 0
+	var valid func(ast.Expr) bool
+	valid = func(e ast.Expr) bool {
+		budget++
+		if budget > 64 {
+			return false
+		}
+		switch v := e.(type) {
+		case *ast.BasicLit:
+			return v.Kind == token.INT || v.Kind == token.FLOAT
+		case *ast.ParenExpr:
+			return valid(v.X)
+		case *ast.UnaryExpr:
+			return (v.Op == token.ADD || v.Op == token.SUB) && valid(v.X)
+		case *ast.BinaryExpr:
+			if v.Op != token.ADD && v.Op != token.SUB && v.Op != token.MUL && v.Op != token.QUO {
+				return false
+			}
+			return valid(v.X) && valid(v.Y)
+		case *ast.CallExpr:
+			m, ok := v.Fun.(*ast.SelectorExpr)
+			if !ok || (m.Sel.Name != "Stat" && m.Sel.Name != "NonExtraStat") || len(v.Args) != 1 || !safeSelectorChain(rootText(fs, m.X)) {
+				return false
+			}
+			// Only a pure enum selector; no extra getter or state mutation in
+			// the key. Runtime interfaces establish actual character ownership.
+			key, ok := v.Args[0].(*ast.SelectorExpr)
+			if !ok || !safeSelectorChain(rootText(fs, key)) {
+				return false
+			}
+			reads++
+			return true
+		}
+		return false
+	}
+	return valid(e) && reads > 0
+}
diff --git a/pkg/gttsourcegen/pure_locals_test.go b/pkg/gttsourcegen/pure_locals_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/pure_locals_test.go
@@ -0,0 +1,93 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPureLocalsNestedCapsAndSingleGetter(t *testing.T) {
+	src := `package x
+ import(info "github.com/genshinsim/gcsim/pkg/core/info";a "github.com/genshinsim/gcsim/pkg/core/attributes")
+ func(q *provider)tick(){
+ em:=q.Stat(a.EM)
+ var amount float64
+ if em>123 { em-=123;amount=em*.002;if amount>.7{amount=.7} }
+ q.bank[a.DmgP]=amount
+ }`
+	for _, tc := range []struct {
+		name, source string
+		want         bool
+	}{
+		{"caps", src, true},
+		{"shadow", strings.Replace(src, "em-=123", "em:=123;_ = em", 1), false},
+		{"loop", strings.Replace(src, "if em>123", "for em>123", 1), false},
+		{"effectful branch", strings.Replace(src, "amount=.7", "amount=q.Stat(a.EM)", 1), false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			f, err := parser.ParseFile(fs, "x.go", tc.source, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			fn := f.Decls[1].(*ast.FuncDecl)
+			write := fn.Body.List[len(fn.Body.List)-1].(*ast.AssignStmt)
+			expr := fieldExpression{fset: fs, rt: "q.Core.GTTTrace", source: `"test"`, prefix: "probe", info: "info"}
+			value, edits, ok := pureLocalValue(fs, fs.File(f.Pos()), f, write.Pos(), write.Rhs[0], &expr)
+			if ok != tc.want {
+				t.Fatal("supported", ok)
+			}
+			if !ok {
+				return
+			}
+			if len(edits) != 1 || !strings.Contains(expr.code.String(), "select_lt") {
+				t.Fatal("missing single captured input/branch")
+			}
+			edits = append(edits, textEdit{start: fs.File(f.Pos()).Offset(write.Pos()), end: fs.File(f.Pos()).Offset(write.End()), replacement: expr.code.String() + ";_ = " + value.value})
+			result, err := applyTextEdits([]byte(tc.source), edits)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = parser.ParseFile(token.NewFileSet(), "out.go", result, 0); err != nil {
+				t.Fatal(err, string(result))
+			}
+			if strings.Count(string(result), "q.Stat(") != 1 {
+				t.Fatal("getter repeated")
+			}
+		})
+	}
+}
+
+func TestDependencyVectorFullTreeWitnesses(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	m, err := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay, err := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")}, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wanted := map[string][]string{"internal/characters/nahida/asc.go": {"select_lt", "GTTReadStatVector", "GTTReadStat"}, "internal/weapons/catalyst/wanderingevenstar/wanderingevenstar.go": {"StatCellReference", "GTTReadNonExtraStat", "GTTReadStatVector"}}
+	wanted["pkg/simulation/setup.go"] = []string{"GTTSelectStats", "GTTStatsTotalRef"}
+	wanted["internal/characters/tighnari/asc.go"] = []string{"select_lt", "GTTReadStatVector", "GTTReadStat"}
+	wanted["internal/characters/kinich/asc.go"] = []string{"GTTReadTotalAtk", "RecordNumericReturn"}
+	wanted["internal/characters/kuki/skill.go"] = []string{"gttFlatStat_", "GTTReadStat", "GTTFlatProducer"}
+	wanted["internal/characters/nahida/asc.go"] = append(wanted["internal/characters/nahida/asc.go"], "pure_reduction_observed_membership", "GTTReadNonExtraStat")
+	for _, f := range overlay.Files {
+		if tokens, ok := wanted[f.RelativeFile]; ok {
+			for _, token := range tokens {
+				if !strings.Contains(string(f.Contents), token) {
+					t.Fatalf("%s missing %s", f.RelativeFile, token)
+				}
+			}
+			delete(wanted, f.RelativeFile)
+		}
+	}
+	if len(wanted) != 0 {
+		t.Fatal("missing files", wanted)
+	}
+}
diff --git a/pkg/gttsourcegen/pure_reduction.go b/pkg/gttsourcegen/pure_reduction.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/pure_reduction.go
@@ -0,0 +1,104 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+)
+
+// Observe an actual fixed-membership range reduction. Only one typed stat
+// getter and one pure extrema assignment are allowed. Every visited input is
+// retained, including losing values, so changing the maximum's owner works.
+// Iteration membership and timing remain the observed schedule boundary.
+func (s *pureLocalState) reduction(loop *ast.RangeStmt, env map[string]*pureLocalNode) bool {
+	if loop.Tok != token.DEFINE || len(loop.Body.List) != 2 {
+		return false
+	}
+	item, ok := loop.Value.(*ast.Ident)
+	if !ok || item.Name == "_" {
+		return false
+	}
+	read, ok := loop.Body.List[0].(*ast.AssignStmt)
+	if !ok || read.Tok != token.DEFINE || len(read.Lhs) != 1 || len(read.Rhs) != 1 {
+		return false
+	}
+	sample, ok := read.Lhs[0].(*ast.Ident)
+	if !ok || sample.Name == item.Name {
+		return false
+	}
+	call, ok := read.Rhs[0].(*ast.CallExpr)
+	if !ok || !pureStatInput(s.fs, call) {
+		return false
+	}
+	getter, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || rootText(s.fs, getter.X) != item.Name {
+		return false
+	}
+	branch, ok := loop.Body.List[1].(*ast.IfStmt)
+	if !ok || branch.Init != nil || branch.Else != nil || len(branch.Body.List) != 1 {
+		return false
+	}
+	cmp, ok := branch.Cond.(*ast.BinaryExpr)
+	if !ok {
+		return false
+	}
+	assign, ok := branch.Body.List[0].(*ast.AssignStmt)
+	if !ok || assign.Tok != token.ASSIGN || len(assign.Lhs) != 1 || len(assign.Rhs) != 1 || rootText(s.fs, assign.Rhs[0]) != sample.Name {
+		return false
+	}
+	accumulator, ok := assign.Lhs[0].(*ast.Ident)
+	if !ok || accumulator.Name == sample.Name || accumulator.Name == item.Name {
+		return false
+	}
+	old := env[accumulator.Name]
+	// Literal initial accumulators only: no replay of arbitrary pre-loop state.
+	if old == nil || old.op != "constant" {
+		return false
+	}
+	if key, ok := loop.Key.(*ast.Ident); ok && (key.Name == accumulator.Name || key.Name == sample.Name) {
+		return false
+	}
+	left, right := rootText(s.fs, cmp.X), rootText(s.fs, cmp.Y)
+	op := ""
+	if left == sample.Name && right == accumulator.Name {
+		if cmp.Op == token.GTR || cmp.Op == token.GEQ {
+			op = "max"
+		}
+		if cmp.Op == token.LSS || cmp.Op == token.LEQ {
+			op = "min"
+		}
+	} else if right == sample.Name && left == accumulator.Name {
+		if cmp.Op == token.LSS || cmp.Op == token.LEQ {
+			op = "max"
+		}
+		if cmp.Op == token.GTR || cmp.Op == token.GEQ {
+			op = "min"
+		}
+	}
+	if op == "" {
+		return false
+	}
+	env[accumulator.Name] = &pureLocalNode{op: op, text: accumulator.Name, input: read, reduction: loop, args: []*pureLocalNode{old}}
+	return true
+}
+
+func emitPureReduction(fs *token.FileSet, tf *token.File, file *ast.File, field *fieldExpression, loop *ast.RangeStmt, node *pureLocalNode) (textEdit, error) {
+	prefix := fmt.Sprintf("gttPureReduction_%d", loop.Pos())
+	input := node.input
+	capture := fieldExpression{fset: fs, rt: field.rt, source: field.source, prefix: prefix + "_input", info: field.info, refs: map[string]string{}, constants: sourceNamedConstants(file)}
+	value, err := capture.emit(input.Rhs[0], 0)
+	if err != nil {
+		return textEdit{}, err
+	}
+	// Keep the original loop, getter position and branch. Only attach arithmetic
+	// provenance after its original update; never evaluate the getter twice.
+	key := ""
+	if loop.Key != nil {
+		key = rootText(fs, loop.Key) + ", "
+	}
+	header := "for " + key + rootText(fs, loop.Value) + " := range " + rootText(fs, loop.X) + " {"
+	initial := fmt.Sprintf("%s_value:=float64(%s)\n%s_ref:=%s.LiteralRef(%s_value)\n", prefix, node.args[0].text, prefix, traceImportAlias, prefix)
+	tail := capture.code.String() + "\n" + rootText(fs, input.Lhs[0]) + ":=" + value.value + "\n" + rootText(fs, loop.Body.List[1]) + "\n"
+	tail += fmt.Sprintf("%s_ref=%s.EventRef(%s.RecordNumericEval(%s,%q,[]%s.NumericRef{%s_ref,%s},%s,%s.IncompleteEvidence(\"pure_reduction_observed_membership\")))\n%s_value=%s\n}", prefix, traceImportAlias, field.rt, field.source, node.op, traceImportAlias, prefix, value.ref, node.text, traceImportAlias, prefix, node.text)
+	return textEdit{start: tf.Offset(loop.Pos()), end: tf.Offset(loop.End()), replacement: initial + header + "\n" + tail}, nil
+}
diff --git a/pkg/gttsourcegen/pure_reduction_test.go b/pkg/gttsourcegen/pure_reduction_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/pure_reduction_test.go
@@ -0,0 +1,62 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strings"
+	"testing"
+)
+
+func TestPureStatExtremaReduction(t *testing.T) {
+	src := `package x
+ import(info "github.com/genshinsim/gcsim/pkg/core/info";a "github.com/genshinsim/gcsim/pkg/core/attributes")
+ func(q *provider)tick(){
+ var best float64
+ team:=q.Core.Player.Chars()
+ for _, member:=range team { score:=member.NonExtraStat(a.EM);if score>best {best=score} }
+ best=.25*best
+ if best>250 {best=250}
+ q.bank[a.EM]=best
+ }`
+	for _, tc := range []struct {
+		name, source string
+		want         bool
+	}{
+		{"max", src, true},
+		{"min", strings.Replace(src, "score>best", "score<best", 1), true},
+		{"loop side effect", strings.Replace(src, "best=score", "best=score;q.mutate()", 1), false},
+		{"loop break", strings.Replace(src, "best=score", "best=score;break", 1), false},
+		{"shadow", strings.Replace(src, "best=score", "best:=score", 1), false},
+		{"wrong getter", strings.Replace(src, "member.NonExtraStat", "q.NonExtraStat", 1), false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			f, err := parser.ParseFile(fs, "x.go", tc.source, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			fn := f.Decls[1].(*ast.FuncDecl)
+			write := fn.Body.List[len(fn.Body.List)-1].(*ast.AssignStmt)
+			expr := fieldExpression{fset: fs, rt: "q.Core.GTTTrace", source: `"test"`, prefix: "probe", info: "info"}
+			value, edits, ok := pureLocalValue(fs, fs.File(f.Pos()), f, write.Pos(), write.Rhs[0], &expr)
+			if ok != tc.want {
+				t.Fatal(ok)
+			}
+			if !ok {
+				return
+			}
+			if len(edits) != 1 || strings.Count(edits[0].replacement, "GTTReadNonExtraStat") != 1 || !strings.Contains(expr.code.String(), "select_lt") {
+				t.Fatal(edits, expr.code.String())
+			}
+			edits = append(edits, textEdit{start: fs.File(f.Pos()).Offset(write.Pos()), end: fs.File(f.Pos()).Offset(write.End()), replacement: expr.code.String() + ";_ = " + value.value})
+			result, err := applyTextEdits([]byte(tc.source), edits)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = parser.ParseFile(token.NewFileSet(), "out.go", result, 0); err != nil {
+				t.Fatal(err, string(result))
+			}
+		})
+	}
+}
diff --git a/pkg/gttsourcegen/render.go b/pkg/gttsourcegen/render.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/render.go
@@ -0,0 +1,130 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"go/format"
+	"sort"
+	"strconv"
+)
+
+// RenderManifestBody returns exactly the canonical bytes identified by
+// ManifestBodySHA256. A caller may append one newline when writing the file.
+func RenderManifestBody(manifest Manifest) ([]byte, error) {
+	body, err := CanonicalJSON(manifest)
+	if err != nil {
+		return nil, fmt.Errorf("canonical manifest body: %w", err)
+	}
+	sum := sha256.Sum256(body)
+	actual := hex.EncodeToString(sum[:])
+	if manifest.ManifestBodySHA256 != "" && manifest.ManifestBodySHA256 != actual {
+		return nil, fmt.Errorf("manifest body hash mismatch: have %s, rendered %s", manifest.ManifestBodySHA256, actual)
+	}
+	return body, nil
+}
+
+// RenderLookupGo returns a deterministic generated implementation for package
+// gttsource. Runtime code wraps these deliberately unexported values.
+func RenderLookupGo(manifest Manifest) ([]byte, error) {
+	if _, err := RenderManifestBody(manifest); err != nil {
+		return nil, err
+	}
+	entries := append([]SourceEntry(nil), manifest.Entries...)
+	sort.Slice(entries, func(i, j int) bool { return entries[i].LookupKey < entries[j].LookupKey })
+	seenLookup := make(map[string]struct{}, len(entries))
+	seenID := make(map[string]struct{}, len(entries))
+	for _, entry := range entries {
+		if _, exists := seenLookup[entry.LookupKey]; exists {
+			return nil, fmt.Errorf("duplicate generated lookup key %q", entry.LookupKey)
+		}
+		seenLookup[entry.LookupKey] = struct{}{}
+		if err := validateSHA256("source ID", entry.SourceID); err != nil {
+			return nil, err
+		}
+		if err := validateSHA256("template", entry.Template.TemplateSHA256); err != nil {
+			return nil, err
+		}
+		seenID[entry.SourceID] = struct{}{}
+	}
+
+	var out bytes.Buffer
+	out.WriteString("// Code generated by cmd/gtt-source-manifest; DO NOT EDIT.\n\npackage gttsource\n\n")
+	fmt.Fprintf(&out, "const generatedSourceManifestBodySHA256 = %s\n", strconv.Quote(manifest.ManifestBodySHA256))
+	fmt.Fprintf(&out, "const generatedSourceCompilerVersion = %s\n\n", strconv.Quote(manifest.CompilerVersion))
+	out.WriteString("var generatedSourceIDByLookupKey = map[string]string{\n")
+	for _, entry := range entries {
+		fmt.Fprintf(&out, "\t%s: %s,\n", strconv.Quote(entry.LookupKey), strconv.Quote(entry.SourceID))
+	}
+	out.WriteString("}\n\n")
+	out.WriteString("var generatedTemplateSHA256BySourceID = map[string]string{\n")
+	ids := make([]string, 0, len(seenID))
+	templateByID := make(map[string]string, len(entries))
+	for _, entry := range entries {
+		if existing, ok := templateByID[entry.SourceID]; ok && existing != entry.Template.TemplateSHA256 {
+			return nil, fmt.Errorf("source ID %s has conflicting templates", entry.SourceID)
+		}
+		templateByID[entry.SourceID] = entry.Template.TemplateSHA256
+	}
+	for id := range templateByID {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		fmt.Fprintf(&out, "\t%s: %s,\n", strconv.Quote(id), strconv.Quote(templateByID[id]))
+	}
+	out.WriteString("}\n\n")
+	out.WriteString("var generatedCompactTemplateBySourceID = map[string]CompactTemplate{\n")
+	entryByID := make(map[string]SourceEntry, len(entries))
+	for _, entry := range entries {
+		if existing, ok := entryByID[entry.SourceID]; ok && existing.Template.TemplateSHA256 != entry.Template.TemplateSHA256 {
+			return nil, fmt.Errorf("source ID %s has conflicting compact templates", entry.SourceID)
+		}
+		entryByID[entry.SourceID] = entry
+	}
+	for _, id := range ids {
+		template := entryByID[id].Template
+		fmt.Fprintf(&out, "\t%s: {Status: %s, DependenciesComplete: %t, TemplateSHA256: %s, ",
+			strconv.Quote(id), strconv.Quote(template.Status), template.DependenciesComplete, strconv.Quote(template.TemplateSHA256))
+		if template.RootNodeID == nil {
+			out.WriteString("RootNodeID: nil, ")
+		} else {
+			fmt.Fprintf(&out, "RootNodeID: compactInt(%d), ", *template.RootNodeID)
+		}
+		if template.StopReasonCode == nil {
+			out.WriteString("StopReasonCode: nil, ")
+		} else {
+			fmt.Fprintf(&out, "StopReasonCode: compactString(%s), ", strconv.Quote(*template.StopReasonCode))
+		}
+		out.WriteString("ParameterKeys: []string{")
+		for _, key := range template.ParameterKeys {
+			fmt.Fprintf(&out, "%s,", strconv.Quote(key))
+		}
+		out.WriteString("}, Nodes: []CompactTemplateNode{")
+		for _, node := range template.Nodes {
+			fmt.Fprintf(&out, "{NodeID:%d,Operator:%s,InputNodeIDs:[]int{", node.NodeID, strconv.Quote(node.Operator))
+			for _, input := range node.InputNodeIDs {
+				fmt.Fprintf(&out, "%d,", input)
+			}
+			out.WriteString("},")
+			if node.ConstantValue != nil {
+				fmt.Fprintf(&out, "ConstantValue:compactFloat(%s),", strconv.FormatFloat(*node.ConstantValue, 'g', -1, 64))
+			}
+			if node.ParameterKey != nil {
+				fmt.Fprintf(&out, "ParameterKey:compactString(%s),", strconv.Quote(*node.ParameterKey))
+			}
+			out.WriteString("},")
+		}
+		out.WriteString("}},\n")
+	}
+	out.WriteString("}\n\n")
+	out.WriteString("func compactInt(value int) *int { return &value }\n")
+	out.WriteString("func compactFloat(value float64) *float64 { return &value }\n")
+	out.WriteString("func compactString(value string) *string { return &value }\n")
+	formatted, err := format.Source(out.Bytes())
+	if err != nil {
+		return nil, fmt.Errorf("format generated lookup: %w", err)
+	}
+	return formatted, nil
+}
diff --git a/pkg/gttsourcegen/saved_vector.go b/pkg/gttsourcegen/saved_vector.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/saved_vector.go
@@ -0,0 +1,349 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"path"
+	"strconv"
+	"strings"
+)
+
+type savedVectorWrite struct {
+	File         string
+	Line, Column int
+	Receiver     string
+}
+type savedVectorPlan struct {
+	Local                    bool
+	Field, Receiver          string
+	ReturnLine, ReturnColumn int
+	Writes                   []savedVectorWrite
+}
+
+// Eligibility guards stay in gameplay. Only the one non-nil vector return is
+// observed; another non-nil result or a nested callback rejects this shape.
+func singleVectorReturn(f *ast.FuncLit) *ast.ReturnStmt {
+	var result *ast.ReturnStmt
+	valid := true
+	ast.Inspect(f.Body, func(n ast.Node) bool {
+		if _, ok := n.(*ast.FuncLit); ok {
+			return false
+		}
+		if ret, ok := n.(*ast.ReturnStmt); ok {
+			if len(ret.Results) != 1 {
+				valid = false
+				return false
+			}
+			if id, ok := ret.Results[0].(*ast.Ident); ok && id.Name == "nil" {
+				return false
+			}
+			if result != nil {
+				valid = false
+			}
+			result = ret
+		}
+		return true
+	})
+	if !valid {
+		return nil
+	}
+	return result
+}
+
+func sourceNamedConstants(file *ast.File) map[string]bool {
+	constants := map[string]bool{}
+	for _, d := range file.Decls {
+		if g, ok := d.(*ast.GenDecl); ok && g.Tok == token.CONST {
+			for _, sp := range g.Specs {
+				if v, ok := sp.(*ast.ValueSpec); ok {
+					for _, name := range v.Names {
+						constants[name.Name] = true
+					}
+				}
+			}
+		}
+	}
+	ast.Inspect(file, func(n ast.Node) bool {
+		if a, ok := n.(*ast.AssignStmt); ok && a.Tok == token.DEFINE {
+			for _, lhs := range a.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok {
+					delete(constants, id.Name)
+				}
+			}
+		}
+		return true
+	})
+	return constants
+}
+
+// Bounded pilot: a direct []float64 receiver field returned by a modifier
+// closure. Follow writes across the same parsed receiver type/package. Whole
+// vector escapes, unknown replacements and compound writes fail closed.
+func bindSavedVectors(fs *token.FileSet, files []parsedSourceFile, candidates []sourceCandidate) {
+	functions := []enclosingFunction{}
+	byFile := map[string]parsedSourceFile{}
+	for _, s := range files {
+		byFile[s.rel] = s
+		for _, d := range s.file.Decls {
+			f, ok := d.(*ast.FuncDecl)
+			if !ok || f.Body == nil {
+				continue
+			}
+			typ, receiver := receiverIdentity(fs, f)
+			functions = append(functions, enclosingFunction{rel: s.rel, packageDir: path.Dir(s.rel), receiverType: typ, receiverName: receiver, decl: f})
+		}
+	}
+	returns := map[token.Pos]bool{}
+	for _, c := range candidates {
+		if c.kind != KindModifierAmount {
+			continue
+		}
+		if f, ok := c.root.(*ast.FuncLit); ok {
+			if ret := singleVectorReturn(f); ret != nil {
+				returns[ret.Pos()] = true
+			}
+		}
+	}
+	for i := range candidates {
+		c := &candidates[i]
+		if c.kind != KindModifierAmount || c.traceRuntimePath == "" || c.template.template.Status == TemplateSupported {
+			continue
+		}
+		f, ok := c.root.(*ast.FuncLit)
+		if !ok {
+			continue
+		}
+		ret := singleVectorReturn(f)
+		if ret == nil {
+			continue
+		}
+		selector, ok := ret.Results[0].(*ast.SelectorExpr)
+		if !ok {
+			continue
+		}
+		owner := findEnclosingFunction(fs, functions, c.relativeFile, c.line)
+		if owner == nil || rootText(fs, selector.X) != owner.receiverName || vectorInfoAlias(byFile[c.relativeFile].file) == "" {
+			continue
+		}
+		field := selector.Sel.Name
+		typed := false
+		for _, s := range files {
+			if path.Dir(s.rel) != owner.packageDir {
+				continue
+			}
+			for _, d := range s.file.Decls {
+				gd, ok := d.(*ast.GenDecl)
+				if !ok {
+					continue
+				}
+				for _, sp := range gd.Specs {
+					ts, ok := sp.(*ast.TypeSpec)
+					if !ok || ts.Name.Name != strings.TrimPrefix(owner.receiverType, "*") {
+						continue
+					}
+					st, ok := ts.Type.(*ast.StructType)
+					if !ok {
+						continue
+					}
+					for _, row := range st.Fields.List {
+						for _, name := range row.Names {
+							if name.Name == field && rootText(fs, row.Type) == "[]float64" {
+								typed = true
+							}
+						}
+					}
+				}
+			}
+		}
+		if !typed {
+			continue
+		}
+		returnPos := fs.Position(ret.Pos())
+		plan := &savedVectorPlan{Field: field, Receiver: owner.receiverName, ReturnLine: returnPos.Line, ReturnColumn: returnPos.Column}
+		valid := true
+		for _, fn := range functions {
+			if fn.packageDir != owner.packageDir || fn.receiverType != owner.receiverType {
+				continue
+			}
+			source := byFile[fn.rel]
+			parents := vectorParents(fn.decl.Body)
+			ast.Inspect(fn.decl.Body, func(n ast.Node) bool {
+				sel, ok := n.(*ast.SelectorExpr)
+				if !ok || rootText(fs, sel.X) != fn.receiverName || sel.Sel.Name != field {
+					return true
+				}
+				switch parent := parents[sel].(type) {
+				case *ast.IndexExpr:
+					if parent.X != sel {
+						valid = false
+						break
+					}
+					if unary, ok := parents[parent].(*ast.UnaryExpr); ok && unary.Op == token.AND {
+						valid = false
+					}
+					if _, ok := parents[parent].(*ast.IncDecStmt); ok {
+						valid = false
+					}
+					if a, ok := parents[parent].(*ast.AssignStmt); ok {
+						for _, lhs := range a.Lhs {
+							if lhs != parent {
+								continue
+							}
+							if a.Tok != token.ASSIGN || len(a.Lhs) != 1 || len(a.Rhs) != 1 || vectorInfoAlias(source.file) == "" {
+								valid = false
+								break
+							}
+							pos := fs.Position(a.Pos())
+							plan.Writes = append(plan.Writes, savedVectorWrite{File: fn.rel, Line: pos.Line, Column: pos.Column, Receiver: fn.receiverName})
+						}
+					}
+				case *ast.AssignStmt:
+					if len(parent.Lhs) != 1 || len(parent.Rhs) != 1 || parent.Lhs[0] != sel || parent.Tok != token.ASSIGN {
+						valid = false
+						break
+					}
+					call, ok := parent.Rhs[0].(*ast.CallExpr)
+					if !ok || rootText(fs, call.Fun) != "make" || len(call.Args) != 2 || rootText(fs, call.Args[0]) != "[]float64" {
+						valid = false
+					}
+				case *ast.ReturnStmt:
+					if !returns[parent.Pos()] {
+						valid = false
+					}
+				default:
+					valid = false
+				}
+				return true
+			})
+		}
+		if valid && len(plan.Writes) > 0 && len(plan.Writes) <= 16 {
+			c.savedVector = plan
+			// A vector is not a scalar source template. Keep its explicit runtime-
+			// receipt boundary instead of inventing a fake scalar PARAM template.
+			c.template = opaqueTemplate("modifier_saved_vector_runtime_receipt")
+		}
+	}
+}
+
+func vectorInfoAlias(file *ast.File) string {
+	for alias, p := range sourceImportAliases(file) {
+		if p == "github.com/genshinsim/gcsim/pkg/core/info" {
+			return alias
+		}
+	}
+	return ""
+}
+
+func vectorParents(root ast.Node) map[ast.Node]ast.Node {
+	result := map[ast.Node]ast.Node{}
+	stack := []ast.Node{}
+	ast.Inspect(root, func(n ast.Node) bool {
+		if n == nil {
+			stack = stack[:len(stack)-1]
+			return false
+		}
+		if len(stack) > 0 {
+			result[n] = stack[len(stack)-1]
+		}
+		stack = append(stack, n)
+		return true
+	})
+	return result
+}
+
+func savedVectorEdits(fs *token.FileSet, tf *token.File, data []byte, rel string, file *ast.File, wanted []SourceEntry) ([]textEdit, bool, error) {
+	writes := map[string]struct {
+		entry SourceEntry
+		write savedVectorWrite
+	}{}
+	readLines := map[string]SourceEntry{}
+	for _, entry := range wanted {
+		if entry.savedVector == nil {
+			continue
+		}
+		if entry.RelativeFile == rel {
+			readLines[fmt.Sprintf("%d:%d", entry.savedVector.ReturnLine, entry.savedVector.ReturnColumn)] = entry
+		}
+		for _, write := range entry.savedVector.Writes {
+			if write.File == rel {
+				key := fmt.Sprintf("%d:%d", write.Line, write.Column)
+				// One real write can feed multiple modifier instances. Instrument once.
+				if _, ok := writes[key]; !ok {
+					writes[key] = struct {
+						entry SourceEntry
+						write savedVectorWrite
+					}{entry, write}
+				}
+			}
+		}
+	}
+	if len(writes) == 0 && len(readLines) == 0 {
+		return nil, false, nil
+	}
+	alias := vectorInfoAlias(file)
+	if alias == "" {
+		return nil, false, fmt.Errorf("saved vector info import missing")
+	}
+	edits := []textEdit{}
+	inputEdits := map[int]textEdit{}
+	var emitErr error
+	ast.Inspect(file, func(n ast.Node) bool {
+		if emitErr != nil {
+			return false
+		}
+		switch stmt := n.(type) {
+		case *ast.ReturnStmt:
+			pos := fs.Position(stmt.Pos())
+			entry, ok := readLines[fmt.Sprintf("%d:%d", pos.Line, pos.Column)]
+			if !ok || len(stmt.Results) != 1 {
+				return true
+			}
+			rt, ok := entryTraceExpression(entry.savedVector.Receiver, entry)
+			if !ok {
+				emitErr = fmt.Errorf("vector trace path missing")
+				return false
+			}
+			expression := fmt.Sprintf("%s.GTTReadStatVector(%s,%q,%s)", alias, rt, entry.SourceID, rootText(fs, stmt.Results[0]))
+			edits = append(edits, textEdit{start: tf.Offset(stmt.Results[0].Pos()), end: tf.Offset(stmt.Results[0].End()), replacement: expression})
+		case *ast.AssignStmt:
+			pos := fs.Position(stmt.Pos())
+			owned, ok := writes[fmt.Sprintf("%d:%d", pos.Line, pos.Column)]
+			if !ok {
+				return true
+			}
+			rt, ok := entryTraceExpression(owned.write.Receiver, owned.entry)
+			if !ok {
+				emitErr = fmt.Errorf("vector write trace missing")
+				return false
+			}
+			prefix := fmt.Sprintf("gttVector_%d_%d", pos.Line, pos.Column)
+			expr := fieldExpression{fset: fs, rt: rt, source: strconv.Quote(owned.entry.SourceID), prefix: prefix, info: alias, refs: localVectorRefs(fs, file, wanted, stmt.Pos(), rt), constants: sourceNamedConstants(file)}
+			value, extra, pure := pureLocalValue(fs, tf, file, stmt.Pos(), stmt.Rhs[0], &expr)
+			var err error
+			if pure {
+				for _, edit := range extra {
+					inputEdits[edit.start] = edit
+				}
+			} else {
+				expr.code.Reset()
+				value, err = expr.emit(stmt.Rhs[0], 0)
+			}
+			if err != nil {
+				// Unknown scalar syntax is a local boundary, not a build failure.
+				// Explicitly replace any old cell ref even if its value is unchanged.
+				expr.code.Reset()
+				value = fieldValue{value: rootText(fs, stmt.Rhs[0]), ref: traceImportAlias + ".NumericRef{}"}
+			}
+			// Go evaluates the indexed LHS address before RHS calls; keep that order.
+			code := fmt.Sprintf("if !%s.Enabled() {%s} else {\n%s_ptr := &%s\n%s\n*%s_ptr=%s\n%s.StoreStatCell(%s_ptr,%s)\n}",
+				rt, rootText(fs, stmt), prefix, rootText(fs, stmt.Lhs[0]), expr.code.String(), prefix, value.value, rt, prefix, value.ref)
+			edits = append(edits, textEdit{start: tf.Offset(stmt.Pos()), end: tf.Offset(stmt.End()), replacement: code})
+		}
+		return true
+	})
+	for _, edit := range inputEdits {
+		edits = append(edits, edit)
+	}
+	return edits, len(writes) > 0, emitErr
+}
diff --git a/pkg/gttsourcegen/saved_vector_test.go b/pkg/gttsourcegen/saved_vector_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/saved_vector_test.go
@@ -0,0 +1,131 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestSavedVectorRenamedAndEscapeBoundaries(t *testing.T) {
+	source := `package arbitrary
+ import(
+  info "github.com/genshinsim/gcsim/pkg/core/info"
+  a "github.com/genshinsim/gcsim/pkg/core/attributes"
+ )
+ type owner struct{bank []float64}
+ func (x *owner) refresh() {
+  x.bank=make([]float64,a.EndStatType)
+  x.bank[a.EM]=x.NonExtraStat(a.EM)*.37
+  ally.AddStatMod(character.StatMod{Amount:func()[]float64{return x.bank}})
+ }`
+	for name, src := range map[string]string{
+		"normal":        source,
+		"renamed":       strings.NewReplacer("owner", "provider", "bank", "stored", "refresh", "grant", "x.", "q.", "(x ", "(q ").Replace(source),
+		"escaped":       strings.Replace(source, "x.bank[a.EM]=", "alias:=x.bank;_ = alias; x.bank[a.EM]=", 1),
+		"compound":      strings.Replace(source, "x.bank[a.EM]=", "x.bank[a.EM]+=", 1),
+		"unknown reset": strings.Replace(source, "make([]float64,a.EndStatType)", "unknown()", 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			f, e := parser.ParseFile(fs, "demo.go", src, 0)
+			if e != nil {
+				t.Fatal(e)
+			}
+			candidates, e := scanFile(fs, "demo.go", f)
+			if e != nil {
+				t.Fatal(e)
+			}
+			for i := range candidates {
+				candidates[i].traceRuntimePath = "Core.GTTTrace"
+			}
+			bindSavedVectors(fs, []parsedSourceFile{{rel: "demo.go", file: f}}, candidates)
+			plans := 0
+			for _, c := range candidates {
+				if c.savedVector != nil {
+					plans++
+				}
+			}
+			want := name == "normal" || name == "renamed"
+			if (plans == 1) != want {
+				t.Fatalf("plans=%d", plans)
+			}
+			if !want {
+				return
+			}
+			entries, e := finalizeCandidates(candidates)
+			if e != nil {
+				t.Fatal(e)
+			}
+			edits, _, e := savedVectorEdits(fs, fs.File(f.Pos()), []byte(src), "demo.go", f, entries)
+			if e != nil {
+				t.Fatal(e)
+			}
+			out, e := applyTextEdits([]byte(src), edits)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if _, e = parser.ParseFile(token.NewFileSet(), "rewritten.go", out, 0); e != nil {
+				t.Fatal(e)
+			}
+			for _, s := range []string{"StoreStatCell", "GTTReadNonExtraStat", "GTTReadStatVector", ".37"} {
+				if !strings.Contains(string(out), s) {
+					t.Fatal(s)
+				}
+			}
+			// Address binding precedes the captured getter in the traced branch.
+			if strings.Index(string(out), "_ptr :=") > strings.Index(string(out), "GTTReadNonExtraStat") {
+				t.Fatal("LHS evaluated after RHS")
+			}
+			// One getter in each branch; no extra gameplay invocation.
+			fs2 := token.NewFileSet()
+			tree, _ := parser.ParseFile(fs2, "out.go", out, 0)
+			calls := 0
+			ast.Inspect(tree, func(n ast.Node) bool {
+				if c, ok := n.(*ast.CallExpr); ok {
+					if s, ok := c.Fun.(*ast.SelectorExpr); ok && s.Sel.Name == "NonExtraStat" {
+						calls++
+					}
+				}
+				return true
+			})
+			if calls != 2 {
+				t.Fatal("getter call sites", calls)
+			}
+		})
+	}
+}
+
+func TestSavedVectorFullTree(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	m, e := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if e != nil {
+		t.Fatal(e)
+	}
+	found := false
+	for _, entry := range m.Entries {
+		if entry.RelativeFile == "internal/characters/sucrose/asc.go" && entry.savedVector != nil && entry.savedVector.Field == "a4Buff" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("saved vector producer not bound")
+	}
+	o, e := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")}, m)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, f := range o.Files {
+		if f.RelativeFile == "internal/characters/sucrose/asc.go" {
+			for _, s := range []string{"GTTReadNonExtraStat", "StoreStatCell", "GTTReadStatVector"} {
+				if !strings.Contains(string(f.Contents), s) {
+					t.Fatal(s)
+				}
+			}
+			return
+		}
+	}
+	t.Fatal("producer overlay missing")
+}
diff --git a/pkg/gttsourcegen/scan.go b/pkg/gttsourcegen/scan.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/scan.go
@@ -0,0 +1,782 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"io/fs"
+	"os"
+	pathpkg "path"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type Options struct {
+	ModuleRoot   string
+	Includes     []string
+	IncludeTests bool
+	Binding      BindingInput
+}
+
+type bindingSet map[string][]ast.Expr
+
+type parsedSourceFile struct {
+	rel  string
+	file *ast.File
+}
+
+type sourceCandidate struct {
+	kind               string
+	relativeFile       string
+	line               int
+	column             int
+	enclosingSymbol    string
+	root               ast.Node
+	astSHA256          string
+	template           templateCompilation
+	rootBindingName    string
+	traceRuntimePath   string
+	traceRuntimeReason string
+	forwardedAttack    *forwardedAttackPlan
+	flatHelper         *flatHelperPlan
+	savedVector        *savedVectorPlan
+	capturedScalar     *capturedScalarPlan
+}
+
+// Generate scans the requested module-relative Go source and returns a fully
+// hashed manifest. The scan is syntax-based by design; unsupported dataflow is
+// retained as an explicit OPAQUE_FROZEN description.
+func Generate(opts Options) (Manifest, error) {
+	if err := opts.Binding.Validate(); err != nil {
+		return Manifest{}, fmt.Errorf("binding input: %w", err)
+	}
+	root, err := filepath.Abs(strings.TrimSpace(opts.ModuleRoot))
+	if err != nil {
+		return Manifest{}, fmt.Errorf("module root: %w", err)
+	}
+	info, err := os.Stat(root)
+	if err != nil {
+		return Manifest{}, fmt.Errorf("module root: %w", err)
+	}
+	if !info.IsDir() {
+		return Manifest{}, errors.New("module root must be a directory")
+	}
+	modulePath, err := readModulePath(filepath.Join(root, "go.mod"))
+	if err != nil {
+		return Manifest{}, err
+	}
+	files, err := collectGoFiles(root, opts.Includes, opts.IncludeTests)
+	if err != nil {
+		return Manifest{}, err
+	}
+
+	fset := token.NewFileSet()
+	candidates := make([]sourceCandidate, 0, 256)
+	parsedFiles := make([]parsedSourceFile, 0, len(files))
+	for _, rel := range files {
+		absolute := filepath.Join(root, filepath.FromSlash(rel))
+		data, err := os.ReadFile(absolute)
+		if err != nil {
+			return Manifest{}, fmt.Errorf("read %s: %w", rel, err)
+		}
+		parsed, err := parser.ParseFile(fset, absolute, data, parser.SkipObjectResolution)
+		if err != nil {
+			return Manifest{}, fmt.Errorf("parse %s: %w", rel, err)
+		}
+		parsedFiles = append(parsedFiles, parsedSourceFile{rel: rel, file: parsed})
+		fileCandidates, err := scanFile(fset, rel, parsed)
+		if err != nil {
+			return Manifest{}, err
+		}
+		if len(fileCandidates) == 0 {
+			continue
+		}
+		candidates = append(candidates, fileCandidates...)
+	}
+	candidates, err = augmentForwardedAttackCandidates(fset, parsedFiles, candidates)
+	if err != nil {
+		return Manifest{}, err
+	}
+	candidates, err = augmentV6Candidates(fset, parsedFiles, candidates, modulePath)
+	if err != nil {
+		return Manifest{}, err
+	}
+	bindFlatHelpers(fset, parsedFiles, candidates)
+	bindSavedVectors(fset, parsedFiles, candidates)
+	bindLocalVectors(fset, parsedFiles, candidates)
+	bindCapturedScalars(fset, parsedFiles, candidates, modulePath)
+
+	entries, err := finalizeCandidates(candidates)
+	if err != nil {
+		return Manifest{}, err
+	}
+	patchedTreeSHA, err := hashPatchedSourceTree(root)
+	if err != nil {
+		return Manifest{}, err
+	}
+	manifest := Manifest{
+		SchemaVersion: ManifestSchemaVersion, Kind: ManifestBodyKind,
+		CompilerVersion: DefaultCompilerVersion,
+		UpstreamRepo:    opts.Binding.UpstreamRepo, UpstreamRef: opts.Binding.UpstreamRef,
+		PristineSourceTreeSHA256: opts.Binding.PristineSourceTreeSHA256,
+		Patches:                  opts.Binding.Patches, PatchStackSHA256: opts.Binding.PatchStackSHA256,
+		PatchedSourceTreeSHA256: patchedTreeSHA,
+		TraceSchemaVersion:      opts.Binding.TraceSchemaVersion, TraceCapability: opts.Binding.TraceCapability,
+		FormulaIdentities: opts.Binding.FormulaIdentities, GoToolchain: opts.Binding.GoToolchain,
+		BuildFlags: opts.Binding.BuildFlags, Entries: entries,
+	}
+	bodyJSON, err := CanonicalJSON(manifest)
+	if err != nil {
+		return Manifest{}, fmt.Errorf("marshal manifest body: %w", err)
+	}
+	bodySum := sha256.Sum256(bodyJSON)
+	manifest.ManifestBodySHA256 = hex.EncodeToString(bodySum[:])
+	return manifest, nil
+}
+
+func readModulePath(goModPath string) (string, error) {
+	data, err := os.ReadFile(goModPath)
+	if err != nil {
+		return "", fmt.Errorf("read go.mod: %w", err)
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "module" {
+			return fields[1], nil
+		}
+	}
+	return "", errors.New("go.mod does not declare a module path")
+}
+
+func hashPatchedSourceTree(root string) (string, error) {
+	type treeFile struct {
+		Path   string `json:"path"`
+		SHA256 string `json:"sha256"`
+	}
+	tree := struct {
+		SchemaVersion int        `json:"schema_version"`
+		Files         []treeFile `json:"files"`
+	}{SchemaVersion: 1, Files: []treeFile{}}
+	err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		rel, err := filepath.Rel(root, path)
+		if err != nil {
+			return err
+		}
+		rel = filepath.ToSlash(rel)
+		if entry.IsDir() {
+			if rel != "." {
+				for _, part := range strings.Split(rel, "/") {
+					if part == ".git" || part == "build" {
+						return filepath.SkipDir
+					}
+				}
+			}
+			return nil
+		}
+		if entry.Type()&os.ModeSymlink != 0 || rel == "pkg/gttsource/generated_manifest.go" {
+			return nil
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() {
+			return nil
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		sum := sha256.Sum256(data)
+		tree.Files = append(tree.Files, treeFile{Path: rel, SHA256: hex.EncodeToString(sum[:])})
+		return nil
+	})
+	if err != nil {
+		return "", fmt.Errorf("hash patched source tree: %w", err)
+	}
+	sort.Slice(tree.Files, func(i, j int) bool { return tree.Files[i].Path < tree.Files[j].Path })
+	canonical, err := CanonicalJSON(tree)
+	if err != nil {
+		return "", fmt.Errorf("canonical patched source tree: %w", err)
+	}
+	sum := sha256.Sum256(canonical)
+	return hex.EncodeToString(sum[:]), nil
+}
+
+func collectGoFiles(root string, includes []string, includeTests bool) ([]string, error) {
+	starts := includes
+	if len(starts) == 0 {
+		starts = []string{"."}
+	}
+	seen := make(map[string]struct{})
+	files := make([]string, 0, 1024)
+	for _, start := range starts {
+		absolute, relStart, err := resolveModulePath(root, start)
+		if err != nil {
+			return nil, err
+		}
+		stat, err := os.Stat(absolute)
+		if err != nil {
+			return nil, fmt.Errorf("include %q: %w", start, err)
+		}
+		if !stat.IsDir() {
+			if isGoSource(relStart, includeTests) {
+				if _, ok := seen[relStart]; !ok {
+					seen[relStart] = struct{}{}
+					files = append(files, relStart)
+				}
+			}
+			continue
+		}
+		err = filepath.WalkDir(absolute, func(path string, entry fs.DirEntry, walkErr error) error {
+			if walkErr != nil {
+				return walkErr
+			}
+			if entry.IsDir() {
+				if path != absolute && shouldSkipDir(entry.Name()) {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+			rel, err := filepath.Rel(root, path)
+			if err != nil {
+				return err
+			}
+			rel = filepath.ToSlash(rel)
+			if !isGoSource(rel, includeTests) {
+				return nil
+			}
+			if _, ok := seen[rel]; !ok {
+				seen[rel] = struct{}{}
+				files = append(files, rel)
+			}
+			return nil
+		})
+		if err != nil {
+			return nil, fmt.Errorf("walk include %q: %w", start, err)
+		}
+	}
+	sort.Strings(files)
+	return files, nil
+}
+
+func resolveModulePath(root, requested string) (string, string, error) {
+	requested = strings.TrimSpace(requested)
+	if requested == "" {
+		return "", "", errors.New("include path must not be empty")
+	}
+	absolute := requested
+	if !filepath.IsAbs(absolute) {
+		absolute = filepath.Join(root, filepath.FromSlash(requested))
+	}
+	absolute, err := filepath.Abs(absolute)
+	if err != nil {
+		return "", "", err
+	}
+	rel, err := filepath.Rel(root, absolute)
+	if err != nil {
+		return "", "", err
+	}
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", "", fmt.Errorf("include path %q escapes module root", requested)
+	}
+	return absolute, filepath.ToSlash(rel), nil
+}
+
+func shouldSkipDir(name string) bool {
+	switch name {
+	case ".git", ".hg", ".svn", "build", "node_modules", "vendor":
+		return true
+	}
+	return strings.HasPrefix(name, ".")
+}
+
+func isGoSource(rel string, includeTests bool) bool {
+	if rel == "pkg/gttsource/generated_manifest.go" {
+		return false
+	}
+	if !strings.HasSuffix(rel, ".go") {
+		return false
+	}
+	return includeTests || !strings.HasSuffix(rel, "_test.go")
+}
+
+func scanFile(fset *token.FileSet, rel string, file *ast.File) ([]sourceCandidate, error) {
+	result := make([]sourceCandidate, 0, 16)
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		enclosing := enclosingSymbol(fset, fn)
+		bindings := collectBindings(fn.Body)
+		bindFlatStatImports(bindings, file)
+		functionStart := len(result)
+		ast.Inspect(fn.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			kind, root, template, matched := describeSeamCall(fset, call, bindings)
+			if !matched {
+				return true
+			}
+			if root == nil {
+				root = call
+			}
+			position := fset.Position(call.Pos())
+			astHash, err := hashAST(fset, root)
+			if err != nil {
+				template = opaqueTemplate("ast_render_failed")
+				astHash = strings.Repeat("0", sha256.Size*2)
+			}
+			result = append(result, sourceCandidate{
+				kind:            kind,
+				relativeFile:    rel,
+				line:            position.Line,
+				column:          position.Column,
+				enclosingSymbol: enclosing,
+				root:            root,
+				astSHA256:       astHash, template: template,
+				rootBindingName: queuedRootBindingName(kind, call),
+			})
+			return true
+		})
+		markMutableSharedAttackRoots(fn.Body, result[functionStart:])
+	}
+	return result, nil
+}
+
+func queuedRootBindingName(kind string, call *ast.CallExpr) string {
+	if kind != KindQueuedAttack || len(call.Args) == 0 {
+		return ""
+	}
+	expr := call.Args[0]
+	for {
+		switch value := expr.(type) {
+		case *ast.ParenExpr:
+			expr = value.X
+		case *ast.UnaryExpr:
+			if value.Op != token.AND {
+				return ""
+			}
+			expr = value.X
+		default:
+			ident, _ := expr.(*ast.Ident)
+			if ident == nil {
+				return ""
+			}
+			return ident.Name
+		}
+	}
+}
+
+func markMutableSharedAttackRoots(body *ast.BlockStmt, candidates []sourceCandidate) {
+	groups := make(map[token.Pos][]int)
+	for index := range candidates {
+		if candidates[index].kind == KindQueuedAttack && candidates[index].root != nil {
+			groups[candidates[index].root.Pos()] = append(groups[candidates[index].root.Pos()], index)
+		}
+	}
+	for _, indices := range groups {
+		if len(indices) < 2 {
+			continue
+		}
+		name := candidates[indices[0]].rootBindingName
+		if name == "" || !hasFlatDamageMutation(body, name) {
+			continue
+		}
+		for _, index := range indices {
+			candidates[index].template = opaqueTemplate("shared_attack_info_flat_dmg_mutation")
+		}
+	}
+}
+
+func hasFlatDamageMutation(body *ast.BlockStmt, bindingName string) bool {
+	found := false
+	ast.Inspect(body, func(node ast.Node) bool {
+		assignment, ok := node.(*ast.AssignStmt)
+		if !ok {
+			return !found
+		}
+		for _, lhs := range assignment.Lhs {
+			selector, ok := lhs.(*ast.SelectorExpr)
+			if !ok || selector.Sel.Name != "FlatDmg" {
+				continue
+			}
+			ident, ok := selector.X.(*ast.Ident)
+			if ok && ident.Name == bindingName {
+				found = true
+				return false
+			}
+		}
+		return !found
+	})
+	return found
+}
+
+func describeSeamCall(
+	fset *token.FileSet,
+	call *ast.CallExpr,
+	bindings bindingSet,
+) (string, ast.Node, templateCompilation, bool) {
+	selector, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return "", nil, templateCompilation{}, false
+	}
+	name := selector.Sel.Name
+	switch {
+	case strings.HasPrefix(name, "Add") && strings.HasSuffix(name, "Mod") && len(call.Args) > 0:
+		modRoot := resolveExpr(call.Args[0], bindings, nil)
+		amount := compositeField(modRoot, "Amount", bindings)
+		if amount == nil {
+			amount = modRoot
+		}
+		return KindModifierAmount, amount, describeModifierAmount(fset, amount, bindings), true
+	case name == "Subscribe" && receiverContains(selector.X, "events") && len(call.Args) > 1:
+		callback := resolveExpr(call.Args[1], bindings, nil)
+		return KindEventCallback, callback, describeCallback(fset, callback, bindings, "event_callback"), true
+	case isTaskCall(selector) && len(call.Args) > 0:
+		callback := resolveExpr(call.Args[0], bindings, nil)
+		return KindTaskCallback, callback, describeCallback(fset, callback, bindings, "task_callback"), true
+	case (name == "Heal" || name == "Drain") && len(call.Args) > 0:
+		root := resolveHealthInfo(call.Args[0], bindings, name)
+		if root == nil {
+			return KindHealthInput, resolveExpr(call.Args[0], bindings, nil), opaqueTemplate("health_input_composite_unresolved"), true
+		}
+		field := "Src"
+		if name == "Drain" {
+			field = "Amount"
+		}
+		return KindHealthInput, root, describeHealthInput(fset, root, bindings, field), true
+	case strings.HasPrefix(name, "QueueAttack") && len(call.Args) > 0:
+		attackRoot := resolveAttackInfo(call.Args[0], bindings)
+		if attackRoot == nil {
+			attackRoot = resolveExpr(call.Args[0], bindings, nil)
+		}
+		return KindQueuedAttack, attackRoot, describeQueuedAttack(fset, attackRoot, bindings), true
+	default:
+		return "", nil, templateCompilation{}, false
+	}
+}
+
+func resolveHealthInfo(expr ast.Expr, bindings bindingSet, method string) ast.Expr {
+	root := resolveExpr(expr, bindings, nil)
+	composite, ok := root.(*ast.CompositeLit)
+	if !ok {
+		return nil
+	}
+	wanted := "HealInfo"
+	if method == "Drain" {
+		wanted = "DrainInfo"
+	}
+	if expressionFinalName(composite.Type) != wanted {
+		return nil
+	}
+	return composite
+}
+
+func receiverContains(expr ast.Expr, wanted string) bool {
+	found := false
+	ast.Inspect(expr, func(node ast.Node) bool {
+		switch value := node.(type) {
+		case *ast.Ident:
+			if strings.EqualFold(value.Name, wanted) {
+				found = true
+				return false
+			}
+		case *ast.SelectorExpr:
+			if strings.EqualFold(value.Sel.Name, wanted) {
+				found = true
+				return false
+			}
+		}
+		return !found
+	})
+	return found
+}
+
+func isTaskCall(selector *ast.SelectorExpr) bool {
+	switch selector.Sel.Name {
+	case "QueueCharTask", "QueueEnemyTask":
+		return true
+	case "Add":
+		return receiverContains(selector.X, "tasks") || receiverContains(selector.X, "queue")
+	default:
+		return false
+	}
+}
+
+func collectBindings(body *ast.BlockStmt) bindingSet {
+	all := make(bindingSet)
+	mutated := map[string]bool{}
+	ast.Inspect(body, func(node ast.Node) bool {
+		switch value := node.(type) {
+		case *ast.AssignStmt:
+			if value.Tok != token.ASSIGN && value.Tok != token.DEFINE {
+				for _, lhs := range value.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok {
+						mutated[id.Name] = true
+					}
+				}
+				return true
+			}
+			if len(value.Lhs) != len(value.Rhs) {
+				for _, lhs := range value.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok {
+						mutated[id.Name] = true
+					}
+				}
+				return true
+			}
+			for index, lhs := range value.Lhs {
+				ident, ok := lhs.(*ast.Ident)
+				if ok && ident.Name != "_" {
+					all[ident.Name] = append(all[ident.Name], value.Rhs[index])
+				}
+			}
+		case *ast.ValueSpec:
+			if len(value.Names) != len(value.Values) {
+				return true
+			}
+			for index, ident := range value.Names {
+				if ident.Name != "_" {
+					all[ident.Name] = append(all[ident.Name], value.Values[index])
+				}
+			}
+		case *ast.IncDecStmt:
+			if id, ok := value.X.(*ast.Ident); ok {
+				mutated[id.Name] = true
+			}
+		case *ast.UnaryExpr:
+			if value.Op == token.AND {
+				if id, ok := value.X.(*ast.Ident); ok {
+					all["@gtt/address/"+id.Name] = []ast.Expr{id}
+				}
+			}
+		}
+		return true
+	})
+	// An initializer is not the final value after +=, ++ or a multi-result
+	// assignment. Two sentinels make generic alias resolution fail closed.
+	for name := range mutated {
+		all[name] = []ast.Expr{nil, nil}
+	}
+	return all
+}
+
+func resolveExpr(expr ast.Expr, bindings bindingSet, seen map[string]bool) ast.Expr {
+	switch value := expr.(type) {
+	case *ast.ParenExpr:
+		return resolveExpr(value.X, bindings, seen)
+	case *ast.UnaryExpr:
+		if value.Op == token.AND {
+			return resolveExpr(value.X, bindings, seen)
+		}
+	case *ast.Ident:
+		defs := bindings[value.Name]
+		if len(defs) != 1 {
+			return expr
+		}
+		if seen == nil {
+			seen = make(map[string]bool)
+		}
+		if seen[value.Name] {
+			return expr
+		}
+		seen[value.Name] = true
+		resolved := resolveExpr(defs[0], bindings, seen)
+		delete(seen, value.Name)
+		return resolved
+	}
+	return expr
+}
+
+func compositeField(expr ast.Expr, field string, bindings bindingSet) ast.Expr {
+	expr = resolveExpr(expr, bindings, nil)
+	composite, ok := expr.(*ast.CompositeLit)
+	if !ok {
+		return nil
+	}
+	for _, element := range composite.Elts {
+		keyValue, ok := element.(*ast.KeyValueExpr)
+		if !ok {
+			continue
+		}
+		key, ok := keyValue.Key.(*ast.Ident)
+		if ok && key.Name == field {
+			return resolveExpr(keyValue.Value, bindings, nil)
+		}
+	}
+	return nil
+}
+
+func resolveAttackInfo(expr ast.Expr, bindings bindingSet) ast.Expr {
+	root := resolveExpr(expr, bindings, nil)
+	composite, ok := root.(*ast.CompositeLit)
+	if !ok {
+		return nil
+	}
+	if expressionFinalName(composite.Type) == "AttackInfo" {
+		return composite
+	}
+	if nested := compositeField(composite, "Info", bindings); nested != nil {
+		return nested
+	}
+	return nil
+}
+
+func expressionFinalName(expr ast.Expr) string {
+	switch value := expr.(type) {
+	case *ast.Ident:
+		return value.Name
+	case *ast.SelectorExpr:
+		return value.Sel.Name
+	case *ast.IndexExpr:
+		return expressionFinalName(value.X)
+	case *ast.IndexListExpr:
+		return expressionFinalName(value.X)
+	}
+	return ""
+}
+
+func enclosingSymbol(fset *token.FileSet, fn *ast.FuncDecl) string {
+	if fn.Recv == nil || len(fn.Recv.List) == 0 {
+		return fn.Name.Name
+	}
+	receiver := rootText(fset, fn.Recv.List[0].Type)
+	return "(" + receiver + ")." + fn.Name.Name
+}
+
+func hashAST(fset *token.FileSet, node ast.Node) (string, error) {
+	var buffer bytes.Buffer
+	if err := printer.Fprint(&buffer, fset, node); err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(buffer.Bytes())
+	return hex.EncodeToString(sum[:]), nil
+}
+
+func rootText(fset *token.FileSet, node any) string {
+	if node == nil {
+		return ""
+	}
+	var buffer bytes.Buffer
+	if err := printer.Fprint(&buffer, fset, node); err != nil {
+		return "<unprintable>"
+	}
+	return buffer.String()
+}
+
+func finalizeCandidates(candidates []sourceCandidate) ([]SourceEntry, error) {
+	sort.Slice(candidates, func(i, j int) bool {
+		left, right := candidates[i], candidates[j]
+		if left.relativeFile != right.relativeFile {
+			return left.relativeFile < right.relativeFile
+		}
+		if left.line != right.line {
+			return left.line < right.line
+		}
+		if left.column != right.column {
+			return left.column < right.column
+		}
+		if left.kind != right.kind {
+			return left.kind < right.kind
+		}
+		return left.astSHA256 < right.astSHA256
+	})
+
+	lookupSeen := make(map[string]sourceCandidate, len(candidates))
+	ordinalByScope := make(map[string]int)
+	sourceIDSeen := make(map[string]string, len(candidates))
+	entries := make([]SourceEntry, 0, len(candidates))
+	for _, candidate := range candidates {
+		if err := validatePortableModulePath(candidate.relativeFile); err != nil {
+			return nil, err
+		}
+		lookupKey := candidate.kind + "|" + candidate.relativeFile + "|" + strconv.Itoa(candidate.line)
+		if previous, ok := lookupSeen[lookupKey]; ok {
+			return nil, fmt.Errorf(
+				"ambiguous source lookup %q: columns %d and %d in %s",
+				lookupKey, previous.column, candidate.column, candidate.enclosingSymbol,
+			)
+		}
+		lookupSeen[lookupKey] = candidate
+
+		scope := candidate.kind + "|" + candidate.relativeFile + "|" + candidate.enclosingSymbol
+		ordinal := ordinalByScope[scope]
+		ordinalByScope[scope] = ordinal + 1
+		locator := SourceLocator{
+			ModulePath: candidate.relativeFile, EnclosingSymbol: candidate.enclosingSymbol,
+			Seam: candidate.kind, Ordinal: ordinal,
+		}
+		sourceIdentityBytes, err := CanonicalJSON(struct {
+			SourceIDSchema  int    `json:"source_id_schema"`
+			ModulePath      string `json:"module_path"`
+			EnclosingSymbol string `json:"enclosing_symbol"`
+			Seam            string `json:"seam"`
+			Ordinal         int    `json:"ordinal"`
+		}{1, locator.ModulePath, locator.EnclosingSymbol, locator.Seam, locator.Ordinal})
+		if err != nil {
+			return nil, fmt.Errorf("canonical source identity for %s: %w", lookupKey, err)
+		}
+		sum := sha256.Sum256(sourceIdentityBytes)
+		sourceID := hex.EncodeToString(sum[:])
+		if previous, ok := sourceIDSeen[sourceID]; ok {
+			return nil, fmt.Errorf("source ID collision %s between %s and %s", sourceID, previous, lookupKey)
+		}
+		sourceIDSeen[sourceID] = lookupKey
+
+		templateBytes, err := CanonicalJSON(templateHashBody(candidate.template.template))
+		if err != nil {
+			return nil, fmt.Errorf("canonicalize template for %s: %w", lookupKey, err)
+		}
+		templateSum := sha256.Sum256(templateBytes)
+		candidate.template.template.TemplateSHA256 = hex.EncodeToString(templateSum[:])
+		entries = append(entries, SourceEntry{
+			SourceID: sourceID, Locator: locator, SourceNodeSHA256: candidate.astSHA256,
+			Template:     candidate.template.template,
+			LookupKey:    lookupKey,
+			RelativeFile: candidate.relativeFile, Line: candidate.line, Column: candidate.column,
+			parameterPlans:     candidate.template.parameters,
+			modifierOutput:     candidate.template.modifierOutput,
+			healthInput:        candidate.template.healthInput,
+			callback:           candidate.template.callback,
+			stateOperation:     candidate.template.stateOperation,
+			forwardedAttack:    candidate.forwardedAttack,
+			flatHelper:         candidate.flatHelper,
+			savedVector:        candidate.savedVector,
+			capturedScalar:     candidate.capturedScalar,
+			traceRuntimePath:   candidate.traceRuntimePath,
+			traceRuntimeReason: candidate.traceRuntimeReason,
+		})
+	}
+	sort.Slice(entries, func(i, j int) bool { return entries[i].SourceID < entries[j].SourceID })
+	return entries, nil
+}
+
+func validatePortableModulePath(value string) error {
+	if value == "" || value == "." || strings.Contains(value, "\\") || strings.Contains(value, ":") || strings.ContainsRune(value, '\x00') {
+		return fmt.Errorf("non-portable module-relative path %q", value)
+	}
+	if strings.HasPrefix(value, "/") || pathpkg.Clean(value) != value || strings.HasPrefix(value, "../") || !strings.HasSuffix(value, ".go") {
+		return fmt.Errorf("non-portable module-relative path %q", value)
+	}
+	for _, part := range strings.Split(value, "/") {
+		if part == "" || part == "." || part == ".." {
+			return fmt.Errorf("non-portable module-relative path %q", value)
+		}
+	}
+	return nil
+}
diff --git a/pkg/gttsourcegen/select_stats.go b/pkg/gttsourcegen/select_stats.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/select_stats.go
@@ -0,0 +1,132 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"strings"
+)
+
+// Bind a unique local selected-stats container and its scalar total in the
+// innermost executed block/case. Foreign getters fall back at the typed runtime
+// interface; ambiguous mutable locals are not granted character ownership.
+func selectStatsRefs(fs *token.FileSet, tf *token.File, file *ast.File, at token.Pos, rt string) (map[string]string, []textEdit) {
+	refs := map[string]string{}
+	edits := []textEdit{}
+	alias := vectorInfoAlias(file)
+	attr := ""
+	for a, p := range sourceImportAliases(file) {
+		if p == "github.com/genshinsim/gcsim/pkg/core/attributes" {
+			attr = a
+		}
+	}
+	if alias == "" || attr == "" {
+		return refs, edits
+	}
+	var statements []ast.Stmt
+	span := int(^uint(0) >> 1)
+	ast.Inspect(file, func(n ast.Node) bool {
+		if n == nil || n.Pos() > at || n.End() < at {
+			return false
+		}
+		var list []ast.Stmt
+		switch v := n.(type) {
+		case *ast.BlockStmt:
+			list = v.List
+		case *ast.CaseClause:
+			list = v.Body
+		}
+		if list != nil && int(n.End()-n.Pos()) < span {
+			span = int(n.End() - n.Pos())
+			statements = list
+		}
+		return true
+	})
+	writes := map[string]int{}
+	for _, stmt := range statements {
+		ast.Inspect(stmt, func(n ast.Node) bool {
+			switch v := n.(type) {
+			case *ast.AssignStmt:
+				for _, lhs := range v.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok {
+						writes[id.Name]++
+					}
+				}
+			case *ast.UnaryExpr:
+				if v.Op == token.AND {
+					if id, ok := v.X.(*ast.Ident); ok {
+						writes[id.Name] += 2
+					}
+				}
+			}
+			return true
+		})
+	}
+	type container struct {
+		stmt   *ast.AssignStmt
+		call   *ast.CallExpr
+		method *ast.SelectorExpr
+		origin string
+	}
+	containers := map[string]container{}
+	used := map[string]bool{}
+	for _, stmt := range statements {
+		if stmt.End() >= at {
+			break
+		}
+		a, ok := stmt.(*ast.AssignStmt)
+		if !ok || a.Tok != token.DEFINE || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+			continue
+		}
+		id, ok := a.Lhs[0].(*ast.Ident)
+		if !ok || writes[id.Name] != 1 {
+			continue
+		}
+		call, ok := a.Rhs[0].(*ast.CallExpr)
+		if !ok {
+			continue
+		}
+		method, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			continue
+		}
+		if method.Sel.Name == "SelectStat" && len(call.Args) >= 2 && safeSelectorChain(rootText(fs, method.X)) {
+			mode := rootText(fs, call.Args[0])
+			valid := mode == "true" || mode == "false"
+			for _, arg := range call.Args[1:] {
+				s, ok := arg.(*ast.SelectorExpr)
+				valid = valid && ok
+				if ok {
+					valid = valid && rootText(fs, s.X) == attr
+				}
+			}
+			if valid {
+				containers[id.Name] = container{a, call, method, fmt.Sprintf("gttStatsOrigin_%d", a.Pos())}
+			}
+			continue
+		}
+		saved, ok := containers[rootText(fs, method.X)]
+		if !ok || len(call.Args) != 0 {
+			continue
+		}
+		keys := map[string][]string{"TotalATK": {"BaseATK", "ATKP", "ATK"}, "MaxHP": {"BaseHP", "HPP", "HP"}, "TotalDEF": {"BaseDEF", "DEFP", "DEF"}}[method.Sel.Name]
+		if len(keys) != 3 {
+			continue
+		}
+		for i := range keys {
+			keys[i] = attr + "." + keys[i]
+		}
+		refs[id.Name] = fmt.Sprintf("%s.GTTStatsTotalRef(%s,%s,%s,%s,%s)", alias, rt, saved.origin, rootText(fs, method.X), strings.Join(keys, ","), id.Name)
+		used[rootText(fs, method.X)] = true
+	}
+	for name := range used {
+		s := containers[name]
+		keys := []string{}
+		for _, a := range s.call.Args[1:] {
+			keys = append(keys, rootText(fs, a))
+		}
+		code := fmt.Sprintf("%s,%s := %s.GTTSelectStats(%s,%s,%s,[]%s.Stat{%s},func()%s.Stats{return %s})", name, s.origin, alias, rt, rootText(fs, s.method.X), rootText(fs, s.call.Args[0]), attr, strings.Join(keys, ","), attr, rootText(fs, s.call))
+		edits = append(edits, textEdit{start: tf.Offset(s.stmt.Pos()), end: tf.Offset(s.stmt.End()), replacement: code})
+	}
+	return refs, edits
+}
diff --git a/pkg/gttsourcegen/snapshot_flat.go b/pkg/gttsourcegen/snapshot_flat.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/snapshot_flat.go
@@ -0,0 +1,204 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strconv"
+	"strings"
+)
+
+// A typed original AttackInfo.FlatDmg assignment after a snapshot. This is
+// separate from later AttackEvent callback writes. Restrict the pilot to
+// single-assignment locals in one lexical block; ambiguous aliases stay opaque.
+func snapshotFlatEdits(fs *token.FileSet, tf *token.File, file *ast.File, entries []SourceEntry) []textEdit {
+	infoAlias := vectorInfoAlias(file)
+	attrAlias := ""
+	for alias, p := range sourceImportAliases(file) {
+		if p == "github.com/genshinsim/gcsim/pkg/core/attributes" {
+			attrAlias = alias
+		}
+	}
+	if infoAlias == "" || attrAlias == "" {
+		return nil
+	}
+	edits := []textEdit{}
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		rt := ""
+		source := ""
+		for _, e := range entries {
+			if e.Line < fs.Position(fn.Pos()).Line || e.Line > fs.Position(fn.End()).Line {
+				continue
+			}
+			if r, ok := entryTraceExpression(receiverName(fn), e); ok {
+				rt = r
+				source = strconv.Quote(e.SourceID)
+				break
+			}
+		}
+		if rt == "" {
+			continue
+		}
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			if _, ok := n.(*ast.FuncLit); ok {
+				return false
+			}
+			block, ok := n.(*ast.BlockStmt)
+			if !ok {
+				return true
+			}
+			writes := map[string]int{}
+			escaped := map[string]bool{}
+			ast.Inspect(block, func(n ast.Node) bool {
+				if _, ok := n.(*ast.FuncLit); ok {
+					return false
+				}
+				if a, ok := n.(*ast.AssignStmt); ok {
+					for _, lhs := range a.Lhs {
+						if id, ok := lhs.(*ast.Ident); ok {
+							writes[id.Name]++
+						}
+					}
+				}
+				if v, ok := n.(*ast.ValueSpec); ok {
+					for _, id := range v.Names {
+						writes[id.Name]++
+					}
+				}
+				if v, ok := n.(*ast.IncDecStmt); ok {
+					if id, ok := v.X.(*ast.Ident); ok {
+						writes[id.Name]++
+					}
+				}
+				if v, ok := n.(*ast.UnaryExpr); ok && v.Op == token.AND {
+					if id, ok := v.X.(*ast.Ident); ok {
+						escaped[id.Name] = true
+					}
+				}
+				return true
+			})
+			attacks := map[string]bool{}
+			snapshots := map[string]bool{}
+			refs := map[string]string{}
+			aliases := map[string]ast.Expr{}
+			constants := sourceNamedConstants(file)
+			for _, stmt := range block.List {
+				a, ok := stmt.(*ast.AssignStmt)
+				if !ok || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+					continue
+				}
+				if id, ok := a.Lhs[0].(*ast.Ident); ok && a.Tok == token.DEFINE && writes[id.Name] == 1 {
+					if lit, ok := a.Rhs[0].(*ast.CompositeLit); ok && rootText(fs, lit.Type) == infoAlias+".AttackInfo" {
+						attacks[id.Name] = true
+					}
+					if escaped[id.Name] {
+						continue
+					}
+					if call, ok := a.Rhs[0].(*ast.CallExpr); ok {
+						if method, ok := call.Fun.(*ast.SelectorExpr); ok && method.Sel.Name == "Snapshot" && rootText(fs, method.X) == receiverName(fn) && len(call.Args) == 1 {
+							snapshots[id.Name] = true
+						}
+					}
+					if ix, ok := a.Rhs[0].(*ast.IndexExpr); ok {
+						sel, yes := ix.X.(*ast.SelectorExpr)
+						key, typed := ix.Index.(*ast.SelectorExpr)
+						if yes && typed && sel.Sel.Name == "Stats" && rootText(fs, key.X) == attrAlias && snapshots[rootText(fs, sel.X)] {
+							// Type-checking the generated helper proves this really is info.Snapshot;
+							// the helper independently verifies recorded owner/value at runtime.
+							refs[id.Name] = fmt.Sprintf("%s.GTTSnapshotStatRef(%s,%s,%s,%s)", infoAlias, rt, rootText(fs, sel.X), rootText(fs, ix.Index), id.Name)
+						}
+					}
+					aliases[id.Name] = a.Rhs[0]
+					continue
+				}
+				lhs, ok := a.Lhs[0].(*ast.SelectorExpr)
+				if !ok || lhs.Sel.Name != "FlatDmg" || a.Tok != token.ASSIGN {
+					continue
+				}
+				id, ok := lhs.X.(*ast.Ident)
+				if !ok || !attacks[id.Name] {
+					continue
+				}
+				// Expand only side-effect-free local arithmetic. Calls/indexes used as
+				// coefficients stay at the original RHS position, never replayed getters.
+				used := false
+				var expand func(ast.Expr, int) string
+				expand = func(e ast.Expr, depth int) string {
+					if depth > 12 {
+						return rootText(fs, e)
+					}
+					if v, ok := e.(*ast.Ident); ok {
+						if _, ok := refs[v.Name]; ok {
+							used = true
+							return v.Name
+						}
+						if value, ok := aliases[v.Name]; ok && snapshotImmutableArithmetic(value, aliases, refs, constants, 0) {
+							return "(" + expand(value, depth+1) + ")"
+						}
+					}
+					switch v := e.(type) {
+					case *ast.BinaryExpr:
+						return "(" + expand(v.X, depth+1) + v.Op.String() + expand(v.Y, depth+1) + ")"
+					case *ast.ParenExpr:
+						return "(" + expand(v.X, depth+1) + ")"
+					}
+					return rootText(fs, e)
+				}
+				expression := expand(a.Rhs[0], 0)
+				if !used {
+					continue
+				}
+				// Parsed expression positions belong to a separate set, so bind textual
+				// refs with a fresh expression file set as expected by rootText.
+				exprFS := token.NewFileSet()
+				tree, err := parser.ParseExprFrom(exprFS, "expression.go", expression, 0)
+				if err != nil {
+					continue
+				}
+				prefix := fmt.Sprintf("gttSnapshotFlat_%d", tf.Offset(a.Pos()))
+				emitter := fieldExpression{fset: exprFS, rt: rt, source: source, prefix: prefix, info: infoAlias, refs: refs, constants: sourceNamedConstants(file)}
+				value, err := emitter.emit(tree, 0)
+				if err != nil {
+					continue
+				}
+				code := fmt.Sprintf("if !%s.Enabled(){%s}else{\n%s\n%s.FlatDmg=float64(%s)\n%s.GTTFlatProducer=&%s.GTTFlatProducer{Value:%s.FlatDmg,Reference:%s}\n}", rt, rootText(fs, a), emitter.code.String(), id.Name, value.value, id.Name, infoAlias, id.Name, value.ref)
+				edits = append(edits, textEdit{start: tf.Offset(a.Pos()), end: tf.Offset(a.End()), replacement: code})
+			}
+			return true
+		})
+	}
+	return edits
+}
+
+// Expanding a saved expression is safe only when all its leaves are immutable
+// in this block. Pure syntax alone is not enough: a local used to initialize
+// the alias may have changed between initialization and damage construction.
+func snapshotImmutableArithmetic(e ast.Expr, aliases map[string]ast.Expr, refs map[string]string, constants map[string]bool, depth int) bool {
+	if depth > 12 {
+		return false
+	}
+	switch v := e.(type) {
+	case *ast.BasicLit:
+		return true
+	case *ast.Ident:
+		if _, ok := refs[v.Name]; ok {
+			return true
+		}
+		if constants[v.Name] {
+			return true
+		}
+		if value, ok := aliases[v.Name]; ok {
+			return snapshotImmutableArithmetic(value, aliases, refs, constants, depth+1)
+		}
+	case *ast.ParenExpr:
+		return snapshotImmutableArithmetic(v.X, aliases, refs, constants, depth+1)
+	case *ast.BinaryExpr:
+		return strings.Contains("+-*/", v.Op.String()) && snapshotImmutableArithmetic(v.X, aliases, refs, constants, depth+1) && snapshotImmutableArithmetic(v.Y, aliases, refs, constants, depth+1)
+	}
+	return false
+}
diff --git a/pkg/gttsourcegen/snapshot_flat_test.go b/pkg/gttsourcegen/snapshot_flat_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/snapshot_flat_test.go
@@ -0,0 +1,104 @@
+package gttsourcegen
+
+import (
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestSnapshotFlatAssignmentGenericAndAmbiguous(t *testing.T) {
+	original := `package arbitrary
+ import ("github.com/genshinsim/gcsim/pkg/core/info"; a "github.com/genshinsim/gcsim/pkg/core/attributes")
+ func (x *provider) run(){
+ shot:=info.AttackInfo{}
+ saved:=x.Snapshot(&shot)
+ input:=saved.Stats[a.EM]
+ shot.FlatDmg=input*3.25
+ x.Core.QueueAttackWithSnap(shot,saved)
+ }`
+	for _, tc := range []struct {
+		name, src string
+		want      bool
+	}{
+		{"renamed", original, true},
+		{"ambiguous local", strings.Replace(original, "shot.FlatDmg=", "input=123;shot.FlatDmg=", 1), false},
+		{"address escape", strings.Replace(original, "shot.FlatDmg=", "mutate(&input);shot.FlatDmg=", 1), false},
+		{"foreign import", strings.Replace(original, "github.com/genshinsim/gcsim/pkg/core/attributes", "example/attributes", 1), false},
+		{"not snapshot", strings.Replace(original, "x.Snapshot", "x.Unrelated", 1), false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			file, err := parser.ParseFile(fs, "x.go", tc.src, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			edits := snapshotFlatEdits(fs, fs.File(file.Pos()), file, []SourceEntry{{Line: 8, SourceID: strings.Repeat("a", 64), traceRuntimePath: "Core.GTTTrace"}})
+			if (len(edits) > 0) != tc.want {
+				t.Fatal("edits", len(edits))
+			}
+			if !tc.want {
+				return
+			}
+			out, err := applyTextEdits([]byte(tc.src), edits)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = parser.ParseFile(token.NewFileSet(), "out.go", out, 0); err != nil {
+				t.Fatal(err)
+			}
+			if strings.Count(string(out), "x.Snapshot(") != 1 || !strings.Contains(string(out), "GTTSnapshotStatRef") || !strings.Contains(string(out), "GTTFlatProducer") {
+				t.Fatal(string(out))
+			}
+		})
+	}
+}
+
+func TestSnapshotAliasDoesNotRecomputeChangedLocal(t *testing.T) {
+	src := `package x
+ import("github.com/genshinsim/gcsim/pkg/core/info"; a "github.com/genshinsim/gcsim/pkg/core/attributes")
+ func (c *provider) run(){
+ ai:=info.AttackInfo{}
+ snap:=c.Snapshot(&ai)
+ em:=snap.Stats[a.EM]
+ scale:=2.0
+ saved:=scale*3
+ scale=7
+ ai.FlatDmg=em+saved
+ _=scale
+ }`
+	fs := token.NewFileSet()
+	f, err := parser.ParseFile(fs, "x.go", src, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	edits := snapshotFlatEdits(fs, fs.File(f.Pos()), f, []SourceEntry{{Line: 10, SourceID: strings.Repeat("a", 64), traceRuntimePath: "Core.GTTTrace"}})
+	if len(edits) != 1 {
+		t.Fatal("missing independent EM expression")
+	}
+	if strings.Contains(edits[0].replacement, "scale") || !strings.Contains(edits[0].replacement, "saved") {
+		t.Fatal("saved scalar recomputed after mutation", edits[0].replacement)
+	}
+}
+
+func TestSnapshotFlatFullTree(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	m, err := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay, err := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")}, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range overlay.Files {
+		if f.RelativeFile == "internal/characters/nahida/skill.go" {
+			if !strings.Contains(string(f.Contents), "GTTSnapshotStatRef") || !strings.Contains(string(f.Contents), "GTTFlatProducer") {
+				t.Fatal("missing original snapshot flat producer")
+			}
+			return
+		}
+	}
+	t.Fatal("missing overlay")
+}
diff --git a/pkg/gttsourcegen/v6_discovery.go b/pkg/gttsourcegen/v6_discovery.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/v6_discovery.go
@@ -0,0 +1,522 @@
+package gttsourcegen
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"go/ast"
+	"go/token"
+	pathpkg "path"
+	"sort"
+	"strings"
+)
+
+type receiverMethod struct {
+	rel          string
+	packageName  string
+	packageDir   string
+	imports      map[string]string
+	receiverType string
+	receiverName string
+	decl         *ast.FuncDecl
+	closure      *ast.FuncLit
+}
+
+type enclosingFunction struct {
+	rel          string
+	packageName  string
+	packageDir   string
+	receiverType string
+	receiverName string
+	decl         *ast.FuncDecl
+}
+
+// augmentV6Candidates performs a deliberately bounded, same-package static
+// slice. It resolves only unambiguous receiver methods that directly return a
+// closure and discovers receiver fields structurally; it never switches on a
+// character, set, field, status, or mechanic name.
+func augmentV6Candidates(
+	fset *token.FileSet,
+	files []parsedSourceFile,
+	candidates []sourceCandidate,
+	modulePath string,
+) ([]sourceCandidate, error) {
+	traceRoots := buildTraceRuntimeIndex(modulePath, files)
+	numericTypes := buildScalarNumericTypeIndex(modulePath, files)
+	methods := make(map[string][]receiverMethod)
+	functions := make([]enclosingFunction, 0, 256)
+	for _, source := range files {
+		imports := sourceImportAliases(source.file)
+		for _, declaration := range source.file.Decls {
+			fn, ok := declaration.(*ast.FuncDecl)
+			if !ok || fn.Body == nil {
+				continue
+			}
+			receiverType, receiver := receiverIdentity(fset, fn)
+			function := enclosingFunction{
+				rel: source.rel, packageName: source.file.Name.Name,
+				packageDir:   pathpkg.Dir(source.rel),
+				receiverType: receiverType, receiverName: receiver, decl: fn,
+			}
+			functions = append(functions, function)
+			if receiverType == "" {
+				continue
+			}
+			closure := directlyReturnedClosure(fn)
+			key := methodLookupKey(pathpkg.Dir(source.rel), receiverType, fn.Name.Name)
+			methods[key] = append(methods[key], receiverMethod{
+				rel: source.rel, packageName: source.file.Name.Name,
+				packageDir: pathpkg.Dir(source.rel), imports: imports,
+				receiverType: receiverType, receiverName: receiver,
+				decl: fn, closure: closure,
+			})
+		}
+	}
+
+	derivedFields := make(map[string]map[string]struct{})
+	callbackMethods := make(map[*ast.FuncDecl]struct{})
+	for index := range candidates {
+		candidate := &candidates[index]
+		owner := findEnclosingFunction(fset, functions, candidate.relativeFile, candidate.line)
+		if owner == nil || owner.receiverName == "" {
+			continue
+		}
+		candidate.traceRuntimePath, candidate.traceRuntimeReason = traceRoots.resolve(owner.packageDir, owner.receiverType)
+		freezeUnprovenParameterActors(candidate, owner.receiverName)
+		if candidate.kind == KindHealthInput && candidate.traceRuntimePath == "" {
+			candidate.template = opaqueTemplate(candidate.traceRuntimeReason)
+		}
+		scope := receiverScope(owner.packageDir, owner.receiverType)
+		if candidate.kind == KindModifierAmount || candidate.kind == KindEventCallback {
+			fields := receiverFields(candidate.root, owner.receiverName)
+			if candidate.kind == KindModifierAmount {
+				if fn, ok := candidate.root.(*ast.FuncLit); ok {
+					if output, _ := findModifierOutput(fn.Body); output != nil {
+						fields = receiverFields(output.value, owner.receiverName)
+					}
+				}
+			}
+			numericFields := numericTypes.filterReceiverFields(owner.packageDir, owner.receiverType, fields)
+			mergeFieldSet(derivedFields, scope, numericFields)
+			if candidate.kind == KindModifierAmount && candidate.template.template.Status == TemplateSupported {
+				if reason := numericTypes.validateReceiverFields(owner.packageDir, owner.receiverType, fields); reason != "" {
+					candidate.template = opaqueTemplate(reason)
+				} else if candidate.template.modifierOutput != nil {
+					candidate.template.modifierOutput.StateFields = sortedFieldSet(numericFields)
+				}
+			}
+		}
+		if candidate.kind == KindEventCallback && candidate.template.callback != nil {
+			callback, ok := candidate.root.(*ast.FuncLit)
+			if !ok {
+				candidate.template.template = opaqueTemplate("event_callback_root_not_literal").template
+				continue
+			}
+			helpers, reason := resolveOrdinaryHelpers(
+				fset, callback.Body, candidate.relativeFile, owner, methods, numericTypes,
+			)
+			candidate.template.callback.ScopeKey = scope
+			candidate.template.callback.OrdinaryHelpers = helpers
+			if reason != "" {
+				candidate.template.template = opaqueTemplate(reason).template
+			}
+			for _, helper := range helpers {
+				matches := methods[methodLookupKey(owner.packageDir, owner.receiverType, helper.MethodName)]
+				if len(matches) == 1 {
+					fields := receiverFields(matches[0].decl.Body, matches[0].receiverName)
+					numericFields := numericTypes.filterReceiverFields(owner.packageDir, owner.receiverType, fields)
+					mergeFieldSet(derivedFields, scope, numericFields)
+				}
+			}
+		}
+		if candidate.kind != KindTaskCallback || candidate.template.callback == nil {
+			continue
+		}
+		plan := candidate.template.callback
+		if fn, ok := candidate.root.(*ast.FuncLit); ok {
+			fields := receiverFields(fn.Body, owner.receiverName)
+			numericFields := numericTypes.filterReceiverFields(owner.packageDir, owner.receiverType, fields)
+			plan.ResolvedFile = candidate.relativeFile
+			plan.ResolvedLine = fset.Position(fn.Pos()).Line
+			plan.ScopeKey = scope
+			plan.StateFields = sortedFieldSet(numericFields)
+			mergeFieldSet(derivedFields, scope, numericFields)
+			continue
+		}
+		if plan.ResolvedMethodName == "" || plan.ResolvedReceiver != owner.receiverName {
+			candidate.template.callback = nil
+			continue
+		}
+		matches := methods[methodLookupKey(owner.packageDir, owner.receiverType, plan.ResolvedMethodName)]
+		if len(matches) != 1 || matches[0].closure == nil {
+			candidate.template.callback = nil
+			candidate.template.template = opaqueTemplate("task_callback_method_closure_ambiguous").template
+			continue
+		}
+		method := matches[0]
+		_, numericPayloads := numericTypes.methodParameterProof(method)
+		plan.NumericPayloads = numericPayloads
+		fields := receiverFields(method.closure.Body, method.receiverName)
+		numericFields := numericTypes.filterReceiverFields(owner.packageDir, owner.receiverType, fields)
+		plan.ResolvedFile = method.rel
+		plan.ResolvedLine = fset.Position(method.decl.Pos()).Line
+		plan.ScopeKey = scope
+		plan.StateFields = sortedFieldSet(numericFields)
+		mergeFieldSet(derivedFields, scope, numericFields)
+		callbackMethods[method.decl] = struct{}{}
+	}
+
+	// Candidate state fields must both occur in a discovered source slice and
+	// have a direct receiver assignment somewhere in the same receiver scope.
+	for _, function := range functions {
+		if function.receiverName == "" {
+			continue
+		}
+		if _, callbackOwned := callbackMethods[function.decl]; callbackOwned {
+			// Writes in a returned closure are owned by the task source ID.
+			continue
+		}
+		scope := receiverScope(function.packageDir, function.receiverType)
+		wanted := derivedFields[scope]
+		if len(wanted) == 0 {
+			continue
+		}
+		bindings := collectBindings(function.decl.Body)
+		traceRuntimePath, traceRuntimeReason := traceRoots.resolve(function.packageDir, function.receiverType)
+		var walk func([]ast.Stmt) error
+		walk = func(statements []ast.Stmt) error {
+			for _, statement := range statements {
+				switch value := statement.(type) {
+				case *ast.AssignStmt:
+					if len(value.Lhs) != 1 || len(value.Rhs) != 1 {
+						continue
+					}
+					selector, ok := value.Lhs[0].(*ast.SelectorExpr)
+					ident, receiverOK := selectorRootIdent(selector)
+					if !ok || !receiverOK || ident != function.receiverName {
+						continue
+					}
+					if _, relevant := wanted[selector.Sel.Name]; !relevant {
+						continue
+					}
+					compiled := compileNumericTemplate(fset, value.Rhs[0], bindings)
+					numeric := compiled.template.Status == TemplateSupported
+					numericFields := receiverFields(value.Rhs[0], function.receiverName)
+					numericFields[selector.Sel.Name] = struct{}{}
+					if numeric {
+						if reason := numericTypes.validateReceiverFields(function.packageDir, function.receiverType, numericFields); reason != "" {
+							compiled = opaqueTemplate(reason)
+							numeric = false
+						}
+					}
+					compiled.stateOperation = &stateOperationPlan{
+						ReceiverExpression: function.receiverName,
+						FieldName:          selector.Sel.Name,
+						ValueExpression:    rootText(fset, value.Rhs[0]),
+						AssignmentToken:    value.Tok.String(),
+						ScopeKey:           scope,
+						Numeric:            numeric,
+						NumericFields:      sortedFieldSet(numericFields),
+					}
+					astHash, err := hashAST(fset, value)
+					if err != nil {
+						astHash = strings.Repeat("0", sha256.Size*2)
+						compiled = opaqueTemplate("ast_render_failed")
+					}
+					position := fset.Position(value.Pos())
+					candidates = append(candidates, sourceCandidate{
+						kind: KindStateOperation, relativeFile: function.rel,
+						line: position.Line, column: position.Column,
+						enclosingSymbol: enclosingSymbol(fset, function.decl),
+						root:            value, astSHA256: astHash, template: compiled,
+						traceRuntimePath:   traceRuntimePath,
+						traceRuntimeReason: traceRuntimeReason,
+					})
+				case *ast.BlockStmt:
+					if err := walk(value.List); err != nil {
+						return err
+					}
+				case *ast.IfStmt:
+					if err := walk(value.Body.List); err != nil {
+						return err
+					}
+					if block, ok := value.Else.(*ast.BlockStmt); ok {
+						if err := walk(block.List); err != nil {
+							return err
+						}
+					}
+				case *ast.ForStmt:
+					if err := walk(value.Body.List); err != nil {
+						return err
+					}
+				case *ast.RangeStmt:
+					if err := walk(value.Body.List); err != nil {
+						return err
+					}
+				}
+			}
+			return nil
+		}
+		if err := walk(function.decl.Body.List); err != nil {
+			return nil, err
+		}
+	}
+	return candidates, nil
+}
+
+// freezeUnprovenParameterActors keeps the observed numeric value available to
+// the trace while refusing to claim an artifact-controlled character stat
+// unless the expression is read directly from the enclosing character
+// receiver. Local snapshots and helper-owned stat vectors can expose the same
+// method names without exposing Index/Base character identity.
+func freezeUnprovenParameterActors(candidate *sourceCandidate, receiver string) {
+	if candidate == nil || receiver == "" {
+		return
+	}
+	for index := range candidate.template.parameters {
+		parameter := &candidate.template.parameters[index]
+		if parameter.ActorExpression == "" || parameter.ActorExpression == receiver {
+			continue
+		}
+		parameter.Kind = "frozen_runtime_state"
+		parameter.ActorExpression = ""
+		parameter.StatKey = ""
+		parameter.ReadMode = "live"
+		parameter.CandidateDependencyComplete = false
+	}
+}
+
+func resolveOrdinaryHelpers(
+	fset *token.FileSet,
+	body *ast.BlockStmt,
+	callFile string,
+	owner *enclosingFunction,
+	methods map[string][]receiverMethod,
+	numericTypes scalarNumericTypeIndex,
+) ([]ordinaryHelperPlan, string) {
+	if body == nil || owner == nil || owner.receiverName == "" {
+		return []ordinaryHelperPlan{}, "ordinary_receiver_helper_owner_missing"
+	}
+	plans := make([]ordinaryHelperPlan, 0, 2)
+	reason := ""
+	ast.Inspect(body, func(node ast.Node) bool {
+		if reason != "" {
+			return false
+		}
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		receiver, ok := selector.X.(*ast.Ident)
+		if !ok || receiver.Name != owner.receiverName {
+			return true
+		}
+		key := methodLookupKey(owner.packageDir, owner.receiverType, selector.Sel.Name)
+		matches := methods[key]
+		if len(matches) == 0 {
+			// Embedded/runtime methods are outside this same-package resolver.
+			return true
+		}
+		if len(matches) != 1 {
+			reason = "ordinary_receiver_helper_static_slice_ambiguous"
+			return false
+		}
+		method := matches[0]
+		if method.decl == owner.decl {
+			reason = "ordinary_receiver_helper_recursion_unresolved"
+			return false
+		}
+		parameters, numericParameters := numericTypes.methodParameterProof(method)
+		if len(parameters) != len(call.Args) {
+			reason = "ordinary_receiver_helper_parameter_shape_unresolved"
+			return false
+		}
+		if nestedOrdinaryHelperUnresolved(method, methods) {
+			reason = "ordinary_receiver_helper_nested_unresolved"
+			return false
+		}
+		position := fset.Position(call.Pos())
+		arguments := make([]string, len(call.Args))
+		for index, argument := range call.Args {
+			arguments[index] = rootText(fset, argument)
+		}
+		plans = append(plans, ordinaryHelperPlan{
+			CallFile: callFile, CallLine: position.Line, CallColumn: position.Column,
+			MethodName: selector.Sel.Name, ReceiverExpression: receiver.Name,
+			ResolvedFile: method.rel, ResolvedLine: fset.Position(method.decl.Pos()).Line,
+			ResolvedReceiver: method.receiverName,
+			ScopeKey:         receiverScope(owner.packageDir, owner.receiverType),
+			ParameterNames:   parameters, NumericParameters: numericParameters,
+			ArgumentExpressions: arguments,
+		})
+		return true
+	})
+	if reason != "" {
+		return []ordinaryHelperPlan{}, reason
+	}
+	sort.Slice(plans, func(i, j int) bool {
+		if plans[i].CallLine != plans[j].CallLine {
+			return plans[i].CallLine < plans[j].CallLine
+		}
+		return plans[i].CallColumn < plans[j].CallColumn
+	})
+	return plans, ""
+}
+
+func nestedOrdinaryHelperUnresolved(
+	method receiverMethod,
+	methods map[string][]receiverMethod,
+) bool {
+	unresolved := false
+	ast.Inspect(method.decl.Body, func(node ast.Node) bool {
+		if unresolved {
+			return false
+		}
+		if _, nested := node.(*ast.FuncLit); nested {
+			return false
+		}
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		receiver, ok := selector.X.(*ast.Ident)
+		if !ok || receiver.Name != method.receiverName {
+			return true
+		}
+		matches := methods[methodLookupKey(method.packageDir, method.receiverType, selector.Sel.Name)]
+		if len(matches) == 0 {
+			return true
+		}
+		// A directly returned closure is already covered by the bounded task
+		// callback resolver and does not consume a second ordinary-helper hop.
+		if len(matches) != 1 || matches[0].closure == nil {
+			unresolved = true
+			return false
+		}
+		return true
+	})
+	return unresolved
+}
+
+func receiverIdentity(fset *token.FileSet, fn *ast.FuncDecl) (string, string) {
+	if fn.Recv == nil || len(fn.Recv.List) != 1 || len(fn.Recv.List[0].Names) != 1 {
+		return "", ""
+	}
+	return rootText(fset, fn.Recv.List[0].Type), fn.Recv.List[0].Names[0].Name
+}
+
+func directlyReturnedClosure(fn *ast.FuncDecl) *ast.FuncLit {
+	if fn.Type.Results == nil || len(fn.Type.Results.List) != 1 {
+		return nil
+	}
+	if _, ok := fn.Type.Results.List[0].Type.(*ast.FuncType); !ok {
+		return nil
+	}
+	if len(fn.Body.List) != 1 {
+		return nil
+	}
+	returned, ok := fn.Body.List[0].(*ast.ReturnStmt)
+	if !ok || len(returned.Results) != 1 {
+		return nil
+	}
+	closure, _ := returned.Results[0].(*ast.FuncLit)
+	return closure
+}
+
+func methodLookupKey(packageDir, receiverType, method string) string {
+	return receiverScope(packageDir, receiverType) + "|" + method
+}
+
+func receiverScope(packageDir, receiverType string) string {
+	return packageDir + "|" + strings.TrimPrefix(receiverType, "*")
+}
+
+func findEnclosingFunction(
+	fset *token.FileSet,
+	functions []enclosingFunction,
+	rel string,
+	line int,
+) *enclosingFunction {
+	for index := range functions {
+		fn := &functions[index]
+		if fn.rel != rel {
+			continue
+		}
+		start := fset.Position(fn.decl.Pos()).Line
+		end := fset.Position(fn.decl.End()).Line
+		if line >= start && line <= end {
+			return fn
+		}
+	}
+	return nil
+}
+
+func receiverFields(root ast.Node, receiver string) map[string]struct{} {
+	fields := make(map[string]struct{})
+	if root == nil || receiver == "" {
+		return fields
+	}
+	ast.Inspect(root, func(node ast.Node) bool {
+		selector, ok := node.(*ast.SelectorExpr)
+		if !ok {
+			return true
+		}
+		ident, ok := selector.X.(*ast.Ident)
+		if ok && ident.Name == receiver && startsLower(selector.Sel.Name) {
+			fields[selector.Sel.Name] = struct{}{}
+		}
+		return true
+	})
+	return fields
+}
+
+func selectorRootIdent(selector *ast.SelectorExpr) (string, bool) {
+	if selector == nil {
+		return "", false
+	}
+	ident, ok := selector.X.(*ast.Ident)
+	if !ok {
+		return "", false
+	}
+	return ident.Name, true
+}
+
+func mergeFieldSet(target map[string]map[string]struct{}, scope string, values map[string]struct{}) {
+	if len(values) == 0 {
+		return
+	}
+	if target[scope] == nil {
+		target[scope] = make(map[string]struct{})
+	}
+	for value := range values {
+		target[scope][value] = struct{}{}
+	}
+}
+
+func sortedFieldSet(values map[string]struct{}) []string {
+	out := make([]string, 0, len(values))
+	for value := range values {
+		out = append(out, value)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// Compile-time assertion that state-operation hashes remain lowercase hex even
+// when a caller replaces hashAST with an error path during testing.
+var _ = hex.EncodeToString
+
+var _ = fmt.Sprintf
+
+var _ token.Token
diff --git a/pkg/gttsourcegen/v6_numeric_types.go b/pkg/gttsourcegen/v6_numeric_types.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/v6_numeric_types.go
@@ -0,0 +1,419 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	pathpkg "path"
+	"sort"
+	"strings"
+)
+
+const maxScalarNumericFieldDepth = 8
+
+type scalarTypeKind uint8
+
+const (
+	scalarTypeUnresolved scalarTypeKind = iota
+	scalarTypeNumericBuiltin
+	scalarTypeNamed
+	scalarTypePointerNamed
+	scalarTypeNonScalar
+)
+
+type scalarTypeExpression struct {
+	kind   scalarTypeKind
+	target traceTypeRef
+}
+
+type scalarStructField struct {
+	selector string
+	typeExpr scalarTypeExpression
+	embedded bool
+}
+
+type scalarTypeDeclaration struct {
+	packagePath string
+	isStruct    bool
+	underlying  scalarTypeExpression
+	fields      []scalarStructField
+}
+
+// scalarNumericTypeIndex is a deliberately bounded syntax index. It proves
+// only scalar Go types that are directly convertible to float64. Missing type
+// declarations, ambiguous promotion, pointers and all composite types fail
+// closed instead of being emitted into a numeric trace overlay.
+type scalarNumericTypeIndex struct {
+	modulePath string
+	types      map[string]scalarTypeDeclaration
+}
+
+func buildScalarNumericTypeIndex(modulePath string, files []parsedSourceFile) scalarNumericTypeIndex {
+	index := scalarNumericTypeIndex{
+		modulePath: strings.TrimSuffix(strings.TrimSpace(modulePath), "/"),
+		types:      make(map[string]scalarTypeDeclaration),
+	}
+	for _, source := range files {
+		packagePath := index.packagePath(pathpkg.Dir(source.rel))
+		imports := sourceImportAliases(source.file)
+		for _, declaration := range source.file.Decls {
+			general, ok := declaration.(*ast.GenDecl)
+			if !ok {
+				continue
+			}
+			for _, spec := range general.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				row := scalarTypeDeclaration{packagePath: packagePath}
+				if body, ok := typeSpec.Type.(*ast.StructType); ok {
+					row.isStruct = true
+					row.fields = make([]scalarStructField, 0, len(body.Fields.List))
+					for _, field := range body.Fields.List {
+						typeExpr := parseScalarTypeExpression(packagePath, imports, field.Type)
+						if len(field.Names) == 0 {
+							selector := embeddedFieldSelector(field.Type)
+							if selector != "" {
+								row.fields = append(row.fields, scalarStructField{
+									selector: selector,
+									typeExpr: typeExpr,
+									embedded: true,
+								})
+							}
+							continue
+						}
+						for _, name := range field.Names {
+							row.fields = append(row.fields, scalarStructField{
+								selector: name.Name,
+								typeExpr: typeExpr,
+							})
+						}
+					}
+					sort.Slice(row.fields, func(left, right int) bool {
+						if row.fields[left].selector != row.fields[right].selector {
+							return row.fields[left].selector < row.fields[right].selector
+						}
+						return row.fields[left].typeExpr.target.key() < row.fields[right].typeExpr.target.key()
+					})
+				} else {
+					row.underlying = parseScalarTypeExpression(packagePath, imports, typeSpec.Type)
+				}
+				ref := traceTypeRef{packagePath: packagePath, name: typeSpec.Name.Name}
+				index.types[ref.key()] = row
+			}
+		}
+	}
+	return index
+}
+
+func (i scalarNumericTypeIndex) packagePath(packageDir string) string {
+	if packageDir == "." || packageDir == "" {
+		return i.modulePath
+	}
+	return i.modulePath + "/" + strings.TrimPrefix(packageDir, "./")
+}
+
+func (i scalarNumericTypeIndex) filterReceiverFields(
+	packageDir, receiverType string,
+	fields map[string]struct{},
+) map[string]struct{} {
+	result := make(map[string]struct{}, len(fields))
+	for field := range fields {
+		if i.receiverFieldReason(packageDir, receiverType, field) == "" {
+			result[field] = struct{}{}
+		}
+	}
+	return result
+}
+
+func (i scalarNumericTypeIndex) validateReceiverFields(
+	packageDir, receiverType string,
+	fields map[string]struct{},
+) string {
+	ordered := sortedFieldSet(fields)
+	for _, field := range ordered {
+		if reason := i.receiverFieldReason(packageDir, receiverType, field); reason != "" {
+			return reason
+		}
+	}
+	return ""
+}
+
+func (i scalarNumericTypeIndex) receiverFieldReason(packageDir, receiverType, field string) string {
+	receiverName := receiverBaseTypeName(receiverType)
+	if receiverName == "" || strings.TrimSpace(field) == "" {
+		return "receiver_field_type_unresolved"
+	}
+	root := traceTypeRef{packagePath: i.packagePath(packageDir), name: receiverName}
+	expression, reason := i.resolveFieldExpression(root, field)
+	if reason != "" {
+		return reason
+	}
+	numeric, resolved := i.isScalarNumeric(expression, make(map[string]bool))
+	if !resolved {
+		return "receiver_field_type_unresolved"
+	}
+	if !numeric {
+		return "receiver_field_type_not_scalar_numeric"
+	}
+	return ""
+}
+
+func (i scalarNumericTypeIndex) methodParameterProof(method receiverMethod) ([]string, []int) {
+	if method.decl == nil || method.decl.Type.Params == nil {
+		return []string{}, []int{}
+	}
+	names := make([]string, 0, len(method.decl.Type.Params.List))
+	numeric := make([]int, 0, len(method.decl.Type.Params.List))
+	for _, field := range method.decl.Type.Params.List {
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		expression := parseScalarTypeExpression(i.packagePath(method.packageDir), method.imports, field.Type)
+		isNumeric, resolved := i.isScalarNumeric(expression, make(map[string]bool))
+		for offset := 0; offset < count; offset++ {
+			name := ""
+			if len(field.Names) > 0 {
+				name = field.Names[offset].Name
+			}
+			index := len(names)
+			names = append(names, name)
+			if resolved && isNumeric {
+				numeric = append(numeric, index)
+			}
+		}
+	}
+	return names, numeric
+}
+
+type scalarFieldSearchNode struct {
+	ref      traceTypeRef
+	visiting map[string]bool
+}
+
+func (i scalarNumericTypeIndex) resolveFieldExpression(root traceTypeRef, fieldName string) (scalarTypeExpression, string) {
+	level := []scalarFieldSearchNode{{ref: root, visiting: map[string]bool{root.key(): true}}}
+	for depth := 0; depth <= maxScalarNumericFieldDepth && len(level) > 0; depth++ {
+		matches := make([]scalarTypeExpression, 0, 2)
+		next := make([]scalarFieldSearchNode, 0, len(level)*2)
+		for _, node := range level {
+			structRef, declaration, ok := i.resolveStruct(node.ref, make(map[string]bool))
+			if !ok {
+				continue
+			}
+			for _, candidate := range declaration.fields {
+				if declaration.packagePath != root.packagePath && !ast.IsExported(candidate.selector) {
+					continue
+				}
+				if candidate.selector == fieldName {
+					matches = append(matches, candidate.typeExpr)
+				}
+			}
+			if len(matches) > 0 || depth == maxScalarNumericFieldDepth {
+				continue
+			}
+			for _, embedded := range declaration.fields {
+				if !embedded.embedded {
+					continue
+				}
+				if declaration.packagePath != root.packagePath && !ast.IsExported(embedded.selector) {
+					continue
+				}
+				target, ok := embeddedStructTarget(embedded.typeExpr)
+				if !ok || node.visiting[target.key()] {
+					continue
+				}
+				visiting := make(map[string]bool, len(node.visiting)+1)
+				for key, value := range node.visiting {
+					visiting[key] = value
+				}
+				visiting[structRef.key()] = true
+				visiting[target.key()] = true
+				next = append(next, scalarFieldSearchNode{ref: target, visiting: visiting})
+			}
+		}
+		if len(matches) == 1 {
+			return matches[0], ""
+		}
+		if len(matches) > 1 {
+			return scalarTypeExpression{}, "receiver_field_selection_ambiguous"
+		}
+		level = next
+	}
+	return scalarTypeExpression{}, "receiver_field_type_unresolved"
+}
+
+func (i scalarNumericTypeIndex) resolveStruct(
+	ref traceTypeRef,
+	visiting map[string]bool,
+) (traceTypeRef, scalarTypeDeclaration, bool) {
+	if ref.name == "" || visiting[ref.key()] {
+		return traceTypeRef{}, scalarTypeDeclaration{}, false
+	}
+	visiting[ref.key()] = true
+	declaration, ok := i.types[ref.key()]
+	if !ok {
+		return traceTypeRef{}, scalarTypeDeclaration{}, false
+	}
+	if declaration.isStruct {
+		return ref, declaration, true
+	}
+	if declaration.underlying.kind != scalarTypeNamed {
+		return traceTypeRef{}, scalarTypeDeclaration{}, false
+	}
+	return i.resolveStruct(declaration.underlying.target, visiting)
+}
+
+func (i scalarNumericTypeIndex) isScalarNumeric(
+	expression scalarTypeExpression,
+	visiting map[string]bool,
+) (numeric bool, resolved bool) {
+	switch expression.kind {
+	case scalarTypeNumericBuiltin:
+		return true, true
+	case scalarTypeNonScalar, scalarTypePointerNamed:
+		return false, true
+	case scalarTypeUnresolved:
+		return false, false
+	case scalarTypeNamed:
+		if visiting[expression.target.key()] {
+			return false, false
+		}
+		declaration, ok := i.types[expression.target.key()]
+		if !ok {
+			return false, false
+		}
+		if declaration.isStruct {
+			return false, true
+		}
+		visiting[expression.target.key()] = true
+		defer delete(visiting, expression.target.key())
+		return i.isScalarNumeric(declaration.underlying, visiting)
+	default:
+		return false, false
+	}
+}
+
+func parseScalarTypeExpression(
+	packagePath string,
+	imports map[string]string,
+	expression ast.Expr,
+) scalarTypeExpression {
+	switch value := expression.(type) {
+	case *ast.ParenExpr:
+		return parseScalarTypeExpression(packagePath, imports, value.X)
+	case *ast.StarExpr:
+		inner := parseScalarTypeExpression(packagePath, imports, value.X)
+		if inner.kind == scalarTypeNamed {
+			return scalarTypeExpression{kind: scalarTypePointerNamed, target: inner.target}
+		}
+		if inner.kind == scalarTypeUnresolved {
+			return inner
+		}
+		return scalarTypeExpression{kind: scalarTypeNonScalar}
+	case *ast.IndexExpr:
+		return parseScalarTypeExpression(packagePath, imports, value.X)
+	case *ast.IndexListExpr:
+		return parseScalarTypeExpression(packagePath, imports, value.X)
+	case *ast.Ident:
+		if scalarNumericBuiltin(value.Name) {
+			return scalarTypeExpression{kind: scalarTypeNumericBuiltin}
+		}
+		if scalarNonNumericBuiltin(value.Name) {
+			return scalarTypeExpression{kind: scalarTypeNonScalar}
+		}
+		return scalarTypeExpression{
+			kind:   scalarTypeNamed,
+			target: traceTypeRef{packagePath: packagePath, name: value.Name},
+		}
+	case *ast.SelectorExpr:
+		alias, ok := value.X.(*ast.Ident)
+		if !ok {
+			return scalarTypeExpression{kind: scalarTypeUnresolved}
+		}
+		importPath, ok := imports[alias.Name]
+		if !ok {
+			return scalarTypeExpression{kind: scalarTypeUnresolved}
+		}
+		return scalarTypeExpression{
+			kind:   scalarTypeNamed,
+			target: traceTypeRef{packagePath: importPath, name: value.Sel.Name},
+		}
+	default:
+		return scalarTypeExpression{kind: scalarTypeNonScalar}
+	}
+}
+
+func embeddedStructTarget(expression scalarTypeExpression) (traceTypeRef, bool) {
+	if expression.kind != scalarTypeNamed && expression.kind != scalarTypePointerNamed {
+		return traceTypeRef{}, false
+	}
+	return expression.target, expression.target.name != ""
+}
+
+func embeddedFieldSelector(expression ast.Expr) string {
+	switch value := expression.(type) {
+	case *ast.ParenExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.StarExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.IndexExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.IndexListExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.Ident:
+		return value.Name
+	case *ast.SelectorExpr:
+		return value.Sel.Name
+	default:
+		return ""
+	}
+}
+
+func receiverBaseTypeName(receiverType string) string {
+	expression, err := parser.ParseExpr(strings.TrimSpace(receiverType))
+	if err != nil {
+		return ""
+	}
+	for {
+		switch value := expression.(type) {
+		case *ast.ParenExpr:
+			expression = value.X
+		case *ast.StarExpr:
+			expression = value.X
+		case *ast.IndexExpr:
+			expression = value.X
+		case *ast.IndexListExpr:
+			expression = value.X
+		case *ast.Ident:
+			return value.Name
+		default:
+			return ""
+		}
+	}
+}
+
+func scalarNumericBuiltin(name string) bool {
+	switch name {
+	case "byte", "float32", "float64", "int", "int8", "int16", "int32", "int64",
+		"rune", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr":
+		return true
+	default:
+		return false
+	}
+}
+
+func numericBuiltinType(expression ast.Expr) bool {
+	ident, ok := expression.(*ast.Ident)
+	return ok && scalarNumericBuiltin(ident.Name)
+}
+
+func scalarNonNumericBuiltin(name string) bool {
+	switch name {
+	case "any", "bool", "complex64", "complex128", "error", "string":
+		return true
+	default:
+		return false
+	}
+}
