+
+func (r *Runtime) recordNumericStateWrite(
+	slotID, sourceID string,
+	before, after float64,
+	inputs []NumericRef,
+	evidence DependencyEvidence,
+) string {
+	if !r.validStateSlot(slotID) || !finite(before) || !finite(after) {
+		return ""
+	}
+	eventID := r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventNumericStateWrite, SlotID: optionalString(slotID),
+		SourceID: optionalString(sourceID), Before: optionalFloat(before), After: optionalFloat(after),
+		Inputs:                      inputs,
+		CandidateDependencyComplete: evidence.CandidateDependencyComplete,
+		UncertaintyCodes:            evidence.UncertaintyCodes,
+	})
+	r.stateSlotValues[slotID] = after
+	return eventID
+}
+
+func (r *Runtime) validStateSlot(slotID string) bool {
+	if !r.Enabled() || slotID == "" {
+		return false
+	}
+	_, ok := r.stateSlotValues[slotID]
+	return ok
+}
+
+func (r *Runtime) RecordNumericEval(
+	sourceID, operator string,
+	inputs []NumericRef,
+	value float64,
+	evidence DependencyEvidence,
