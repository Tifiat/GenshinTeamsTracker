+func writeMultiFileModule(t *testing.T, files map[string]string) string {
+	t.Helper()
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "go.mod"), []byte("module example.test/fixture\n\ngo 1.25\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if _, exists := files["trace_root.go"]; !exists {
+		files["trace_root.go"] = `package fixture
+import "example.test/fixture/pkg/gtttrace"
+type unit struct {
+	trace *gtttrace.Runtime
+	level float64
+	limit float64
+	cap float64
+	output []float64
+}
+`
+	}
+	if _, exists := files["pkg/gtttrace/runtime.go"]; !exists {
+		files["pkg/gtttrace/runtime.go"] = "package gtttrace\ntype Runtime struct{}\n"
+	}
+	for name, source := range files {
+		path := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(source), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
