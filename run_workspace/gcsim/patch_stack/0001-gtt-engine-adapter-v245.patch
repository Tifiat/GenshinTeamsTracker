+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestAttackFieldOverlayUsesTypedSeamNotNames(t *testing.T) {
+	src := []byte(`package q
+import info "github.com/genshinsim/gcsim/pkg/core/info"
+func (who *odd) whatever(args ...any) {
+ other := args[1].(*info.AttackEvent)
+ size := min(who.MaxHP()*0.0004,0.123)
+ strength := who.Stat(attributes.EM)
+ other.Info.BaseDmgBonus += size
+ switch flag {case 1:other.Info.FlatDmg += strength*someTable[rank];case 2:other.Info.FlatDmg *= strength}
+}`)
+	fset := token.NewFileSet()
+	file, err := parser.ParseFile(fset, "fixture.go", src, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fn := file.Decls[1].(*ast.FuncDecl)
+	edits := attackFieldEdits(fset, fset.File(file.Pos()), file, fn.Body, "who.Core.Trace", `"source"`, "sample")
+	got, err := applyTextEdits(src, edits)
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(got)
+	for _, needle := range []string{"GTTReadMaxHP", "GTTReadStat", "GTTRecordAttackFieldWrite", "BaseDmgBonus", "multiply", "someTable[rank]"} {
+		if !strings.Contains(text, needle) {
+			t.Fatalf("missing %s", needle)
+		}
+	}
+	if _, err = parser.ParseFile(token.NewFileSet(), "generated.go", got, 0); err != nil {
+		t.Fatal(err)
+	}
+	wrong := strings.Replace(string(src), ".(*info.AttackEvent)", ".(*other.AttackEvent)", 1)
+	fset = token.NewFileSet()
+	file, err = parser.ParseFile(fset, "wrong.go", wrong, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if edits := attackFieldEdits(fset, fset.File(file.Pos()), file, file.Decls[1].(*ast.FuncDecl).Body, "who.Core.Trace", `"source"`, "bad"); len(edits) != 0 {
+		t.Fatal("unproven event type instrumented")
+	}
+}
+
+func TestAttackFieldFullTreeTargets(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	manifest, err := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay, err := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "out")}, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wanted := map[string][]string{
+		"internal/characters/sigewinne/asc.go": {"GTTReadMaxHP", " - baseConvalescenceHP", "_binding", "GTTRecordAttackFieldWrite"},
+		"internal/characters/columbina/asc.go": {"GTTReadMaxHP", "GTTRecordAttackFieldWrite"},
+		"internal/characters/lauma/burst.go":   {"GTTReadStat", "GTTRecordAttackFieldWrite"},
+	}
+	for _, file := range overlay.Files {
+		if needles, ok := wanted[file.RelativeFile]; ok {
+			for _, needle := range needles {
+				if !strings.Contains(string(file.Contents), needle) {
+					t.Fatalf("%s lacks %s", file.RelativeFile, needle)
+				}
+			}
+			delete(wanted, file.RelativeFile)
+		}
+	}
+	if len(wanted) != 0 {
+		t.Fatal(wanted)
+	}
+	// The source itself must remain unchanged by overlay generation.
+	data, _ := os.ReadFile(filepath.Join(root, "internal/characters/columbina/asc.go"))
+	if strings.Contains(string(data), "GTTRecordAttackFieldWrite") {
+		t.Fatal("upstream source mutated")
+	}
+}
diff --git a/pkg/gttsourcegen/canonical.go b/pkg/gttsourcegen/canonical.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/canonical.go
@@ -0,0 +1,79 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strconv"
+)
+
+// CanonicalJSON returns compact JSON with recursively sorted object keys and
+// ASCII-only string escapes. It is the one byte representation used for all
+// build-time source hashes.
+func CanonicalJSON(value any) ([]byte, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.UseNumber()
+	var normalized any
+	if err := decoder.Decode(&normalized); err != nil {
+		return nil, err
+	}
+	var out bytes.Buffer
+	if err := appendCanonicalJSON(&out, normalized); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
+
+func appendCanonicalJSON(out *bytes.Buffer, value any) error {
+	switch value := value.(type) {
+	case nil:
+		out.WriteString("null")
+	case bool:
+		if value {
+			out.WriteString("true")
+		} else {
+			out.WriteString("false")
+		}
+	case string:
+		out.WriteString(strconv.QuoteToASCII(value))
+	case json.Number:
+		out.WriteString(value.String())
+	case []any:
+		out.WriteByte('[')
+		for index, element := range value {
+			if index > 0 {
+				out.WriteByte(',')
+			}
+			if err := appendCanonicalJSON(out, element); err != nil {
+				return err
+			}
+		}
+		out.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(value))
+		for key := range value {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		out.WriteByte('{')
+		for index, key := range keys {
+			if index > 0 {
+				out.WriteByte(',')
+			}
+			out.WriteString(strconv.QuoteToASCII(key))
+			out.WriteByte(':')
+			if err := appendCanonicalJSON(out, value[key]); err != nil {
+				return err
+			}
+		}
+		out.WriteByte('}')
+	default:
+		return fmt.Errorf("unsupported canonical JSON value %T", value)
+	}
+	return nil
+}
diff --git a/pkg/gttsourcegen/captured_scalar.go b/pkg/gttsourcegen/captured_scalar.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/captured_scalar.go
@@ -0,0 +1,306 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"path"
+	"strconv"
+	"strings"
+)
+
+type scalarLocation struct{ Line, Column int }
+type capturedScalarPlan struct {
+	Name, Trace   string
+	Initial       scalarLocation
+	Writes, Reads []scalarLocation
+}
+
+func scalarLoc(fs *token.FileSet, n ast.Node) scalarLocation {
+	p := fs.Position(n.Pos())
+	return scalarLocation{p.Line, p.Column}
+}
+
+// Local storage pilot, not arbitrary closure/alias analysis. A single float
+// local in the containing function, simple writes, no shadowing/address escape.
+func bindCapturedScalars(fs *token.FileSet, files []parsedSourceFile, candidates []sourceCandidate, module string) {
+	index := buildTraceRuntimeIndex(module, files)
+	for i := range candidates {
+		c := &candidates[i]
+		if c.kind != KindModifierAmount || c.savedVector != nil {
+			continue
+		}
+		literal, ok := c.root.(*ast.FuncLit)
+		if !ok {
+			continue
+		}
+		var source *parsedSourceFile
+		for j := range files {
+			if files[j].rel == c.relativeFile {
+				source = &files[j]
+				break
+			}
+		}
+		if source == nil || vectorInfoAlias(source.file) == "" {
+			continue
+		}
+		var owner *ast.FuncDecl
+		for _, d := range source.file.Decls {
+			if f, ok := d.(*ast.FuncDecl); ok && f.Body != nil && f.Pos() < literal.Pos() && f.End() > literal.End() {
+				owner = f
+				break
+			}
+		}
+		if owner == nil {
+			continue
+		}
+		// Find a unique source-local value returned by this modifier. Other return
+		// expressions/guards keep their original behavior; nested closures excluded.
+		names := map[string]bool{}
+		ast.Inspect(literal.Body, func(n ast.Node) bool {
+			if _, ok := n.(*ast.FuncLit); ok {
+				return false
+			}
+			if r, ok := n.(*ast.ReturnStmt); ok && len(r.Results) == 1 {
+				if id, ok := r.Results[0].(*ast.Ident); ok {
+					names[id.Name] = true
+				}
+			}
+			return true
+		})
+		if len(names) != 1 {
+			continue
+		}
+		name := ""
+		for k := range names {
+			name = k
+		}
+		var initial *ast.AssignStmt
+		for _, stmt := range owner.Body.List {
+			a, ok := stmt.(*ast.AssignStmt)
+			if !ok || a.Tok != token.DEFINE || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+				continue
+			}
+			id, ok := a.Lhs[0].(*ast.Ident)
+			if !ok || id.Name != name {
+				continue
+			}
+			value, ok := a.Rhs[0].(*ast.BasicLit)
+			if !ok || value.Kind != token.FLOAT {
+				continue
+			}
+			initial = a
+		}
+		if initial == nil {
+			continue
+		}
+		trace := scalarTraceParameter(index, source, owner)
+		if trace == "" {
+			continue
+		}
+		traceRoot := strings.Split(trace, ".")[0]
+		stable := true
+		ast.Inspect(owner.Body, func(n ast.Node) bool {
+			switch v := n.(type) {
+			case *ast.AssignStmt:
+				for _, lhs := range v.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok && id.Name == traceRoot {
+						stable = false
+					}
+				}
+			case *ast.Field:
+				for _, id := range v.Names {
+					if id.Name == traceRoot {
+						stable = false
+					}
+				}
+			case *ast.ValueSpec:
+				for _, id := range v.Names {
+					if id.Name == traceRoot {
+						stable = false
+					}
+				}
+			case *ast.UnaryExpr:
+				if id, ok := v.X.(*ast.Ident); ok && id.Name == traceRoot && v.Op == token.AND {
+					stable = false
+				}
+			case *ast.RangeStmt:
+				for _, expr := range []ast.Expr{v.Key, v.Value} {
+					if id, ok := expr.(*ast.Ident); ok && id.Name == traceRoot {
+						stable = false
+					}
+				}
+			}
+			return true
+		})
+		if !stable {
+			continue
+		}
+		p := &capturedScalarPlan{Name: name, Trace: trace, Initial: scalarLoc(fs, initial)}
+		parents := vectorParents(owner)
+		valid := true
+		ast.Inspect(owner, func(n ast.Node) bool {
+			id, ok := n.(*ast.Ident)
+			if !ok || id.Name != name {
+				return true
+			}
+			switch parent := parents[id].(type) {
+			case *ast.SelectorExpr:
+				if parent.Sel == id {
+					return true
+				}
+			case *ast.Field, *ast.ValueSpec, *ast.RangeStmt:
+				valid = false
+			case *ast.UnaryExpr:
+				if parent.Op == token.AND {
+					valid = false
+				}
+			case *ast.IncDecStmt:
+				valid = false
+			case *ast.AssignStmt:
+				for _, lhs := range parent.Lhs {
+					if lhs == id {
+						if parent == initial {
+							return true
+						}
+						if parent.Tok != token.ASSIGN || len(parent.Lhs) != 1 || len(parent.Rhs) != 1 {
+							valid = false
+							return true
+						}
+						p.Writes = append(p.Writes, scalarLoc(fs, parent))
+					}
+				}
+			}
+			return true
+		})
+		ast.Inspect(literal.Body, func(n ast.Node) bool {
+			if _, ok := n.(*ast.FuncLit); ok {
+				return false
+			}
+			if r, ok := n.(*ast.ReturnStmt); ok && len(r.Results) == 1 {
+				if id, ok := r.Results[0].(*ast.Ident); ok && id.Name == name {
+					p.Reads = append(p.Reads, scalarLoc(fs, id))
+				}
+			}
+			return true
+		})
+		if valid && len(p.Writes) > 0 && len(p.Writes) <= 16 && len(p.Reads) > 0 {
+			c.capturedScalar = p
+			c.template = opaqueTemplate("captured_scalar_runtime_receipt")
+		}
+	}
+}
+
+// Resolve a typed parameter's unique shortest public path to this module's
+// trace runtime. Never treat an arbitrary spelling such as "core" as proof.
+func scalarTraceParameter(index traceRuntimeIndex, source *parsedSourceFile, fn *ast.FuncDecl) string {
+	all := map[string]bool{}
+	if fn.Type.Params == nil {
+		return ""
+	}
+	pkg := index.packagePath(path.Dir(source.rel))
+	for _, field := range fn.Type.Params.List {
+		ref, ok := traceFieldType(pkg, sourceImportAliases(source.file), field.Type)
+		if !ok {
+			continue
+		}
+		paths := map[string]struct{}{}
+		index.walk(ref, pkg, nil, map[string]bool{}, paths, 0)
+		shortest := maxTraceRuntimePathDepth + 1
+		for p := range paths {
+			if selectorPathDepth(p) < shortest {
+				shortest = selectorPathDepth(p)
+			}
+		}
+		for _, name := range field.Names {
+			for p := range paths {
+				if selectorPathDepth(p) == shortest {
+					all[name.Name+"."+p] = true
+				}
+			}
+		}
+	}
+	if len(all) != 1 {
+		return ""
+	}
+	for p := range all {
+		return p
+	}
+	return ""
+}
+
+func capturedScalarEdits(fs *token.FileSet, tf *token.File, rel string, file *ast.File, entries []SourceEntry) ([]textEdit, bool, error) {
+	type item struct {
+		entry   SourceEntry
+		initial bool
+	}
+	writes := map[scalarLocation]item{}
+	reads := map[scalarLocation]SourceEntry{}
+	for _, e := range entries {
+		p := e.capturedScalar
+		if p == nil || e.RelativeFile != rel {
+			continue
+		}
+		if _, ok := writes[p.Initial]; !ok {
+			writes[p.Initial] = item{e, true}
+		}
+		for _, w := range p.Writes {
+			if _, ok := writes[w]; !ok {
+				writes[w] = item{e, false}
+			}
+		}
+		for _, r := range p.Reads {
+			reads[r] = e
+		}
+	}
+	if len(writes) == 0 {
+		return nil, false, nil
+	}
+	alias := vectorInfoAlias(file)
+	edits := []textEdit{}
+	containerEdits := map[int]textEdit{}
+	var failure error
+	ast.Inspect(file, func(n ast.Node) bool {
+		if failure != nil {
+			return false
+		}
+		switch v := n.(type) {
+		case *ast.Ident:
+			if e, ok := reads[scalarLoc(fs, v)]; ok {
+				p := e.capturedScalar
+				edits = append(edits, textEdit{start: tf.Offset(v.Pos()), end: tf.Offset(v.End()), replacement: fmt.Sprintf("%s.GTTReadSavedScalar(%s,%q,&%s)", alias, p.Trace, e.SourceID, p.Name)})
+			}
+		case *ast.AssignStmt:
+			item, ok := writes[scalarLoc(fs, v)]
+			if !ok {
+				return true
+			}
+			p := item.entry.capturedScalar
+			code := ""
+			if item.initial {
+				code = fmt.Sprintf("%s; %s.StoreStatCell(&%s,%s.LiteralRef(float64(%s)))", rootText(fs, v), p.Trace, p.Name, traceImportAlias, p.Name)
+			} else {
+				pos := fs.Position(v.Pos())
+				prefix := fmt.Sprintf("gttScalar_%d_%d", pos.Line, pos.Column)
+				refs, extra := selectStatsRefs(fs, tf, file, v.Pos(), p.Trace)
+				for _, edit := range extra {
+					containerEdits[edit.start] = edit
+				}
+				expr := fieldExpression{fset: fs, rt: p.Trace, source: strconv.Quote(item.entry.SourceID), prefix: prefix, info: alias, refs: refs, constants: sourceNamedConstants(file)}
+				value, e := expr.emit(v.Rhs[0], 0)
+				if e != nil {
+					failure = e
+					return false
+				}
+				code = fmt.Sprintf("if !%s.Enabled(){%s}else{\n%s\n%s=%s\n%s.StoreStatCell(&%s,%s)\n}", p.Trace, rootText(fs, v), expr.code.String(), p.Name, value.value, p.Trace, p.Name, value.ref)
+			}
+			// Keep statement boundaries when the original source is formatted on one line.
+			edits = append(edits, textEdit{start: tf.Offset(v.Pos()), end: tf.Offset(v.End()), replacement: strings.TrimSpace(code)})
+		}
+		return true
+	})
+	for _, edit := range containerEdits {
+		edits = append(edits, edit)
+	}
+	return edits, true, failure
+}
diff --git a/pkg/gttsourcegen/captured_scalar_test.go b/pkg/gttsourcegen/captured_scalar_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/captured_scalar_test.go
@@ -0,0 +1,114 @@
+package gttsourcegen
+
+import (
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestCapturedScalarRenamesAndBoundaries(t *testing.T) {
+	src := `package arbitrary
+ import(
+  "github.com/genshinsim/gcsim/pkg/gtttrace"
+  "github.com/genshinsim/gcsim/pkg/core/info"
+ )
+ type context struct{ Recorder *gtttrace.Runtime }
+ func prepare(ctx *context){
+  stored:=0.0
+  update:=func(){stored=min(actor.NonExtraStat(attrs.EM)*.00013,.27)}
+  _=update
+  actor.AddReactBonusMod(character.ReactBonusMod{Amount:func(a info.AttackInfo)float64{if a.X{return 0};return stored}})
+ }`
+	for name, text := range map[string]string{
+		"normal":            src,
+		"renamed":           strings.NewReplacer("stored", "amount", "context", "container", "ctx", "owner", "Recorder", "Tracer", "prepare", "setup").Replace(src),
+		"escape":            strings.Replace(src, "_=update", "_=update; ptr:=&stored;_=ptr", 1),
+		"shadow":            strings.Replace(src, "_=update", "_=update; _=func(stored float64){_ = stored}", 1),
+		"compound":          strings.Replace(src, "stored=min", "stored+=min", 1),
+		"ambiguous runtime": strings.Replace(src, "ctx *context", "ctx, other *context", 1),
+		"shadowed runtime":  strings.Replace(src, "_=update", "_=update; _=func(ctx *context){_ = ctx}", 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			f, e := parser.ParseFile(fs, "example.go", text, parser.SkipObjectResolution)
+			if e != nil {
+				t.Fatal(e)
+			}
+			candidates, e := scanFile(fs, "example.go", f)
+			if e != nil {
+				t.Fatal(e)
+			}
+			bindCapturedScalars(fs, []parsedSourceFile{{rel: "example.go", file: f}}, candidates, "github.com/genshinsim/gcsim")
+			count := 0
+			for _, c := range candidates {
+				if c.capturedScalar != nil {
+					count++
+				}
+			}
+			want := name == "normal" || name == "renamed"
+			if (count == 1) != want {
+				t.Fatal("plans", count)
+			}
+			if !want {
+				return
+			}
+			entries, e := finalizeCandidates(candidates)
+			if e != nil {
+				t.Fatal(e)
+			}
+			edits, _, e := capturedScalarEdits(fs, fs.File(f.Pos()), "example.go", f, entries)
+			if e != nil {
+				t.Fatal(e)
+			}
+			out, e := applyTextEdits([]byte(text), edits)
+			if e != nil {
+				t.Fatal(e)
+			}
+			if _, e = parser.ParseFile(token.NewFileSet(), "rewritten.go", out, 0); e != nil {
+				t.Fatal(e)
+			}
+			for _, s := range []string{"GTTReadNonExtraStat", "StoreStatCell", "GTTReadSavedScalar", ".00013", ".27"} {
+				if !strings.Contains(string(out), s) {
+					t.Fatal(s)
+				}
+			}
+		})
+	}
+}
+
+func TestCapturedScalarFullTree(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	manifest, e := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if e != nil {
+		t.Fatal(e)
+	}
+	count := 0
+	for _, e := range manifest.Entries {
+		if e.RelativeFile == "pkg/simulation/setup.go" && e.capturedScalar != nil {
+			count++
+			if len(e.capturedScalar.Writes) != 4 {
+				t.Fatal("branch writes", len(e.capturedScalar.Writes))
+			}
+		}
+	}
+	if count != 1 {
+		t.Fatal("expected captured scalar", count)
+	}
+	overlay, e := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")}, manifest)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for _, f := range overlay.Files {
+		if f.RelativeFile == "pkg/simulation/setup.go" {
+			for _, s := range []string{"GTTReadNonExtraStat", "StoreStatCell", "GTTReadSavedScalar"} {
+				if !strings.Contains(string(f.Contents), s) {
+					t.Fatal(s)
+				}
+			}
+			return
+		}
+	}
+	t.Fatal("scalar overlay absent")
+}
diff --git a/pkg/gttsourcegen/contributor_group.go b/pkg/gttsourcegen/contributor_group.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/contributor_group.go
@@ -0,0 +1,343 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strconv"
+	"strings"
+	"unicode"
+)
+
+// A deliberately narrow protocol verifier. It recognizes the independent-
+// crit / descending-sort / weighted-sum structure, not a reaction name or
+// gameplay coefficient. Renamed locals and changed source weights are valid.
+// Unknown control flow loses this seal; the rest of the engine still builds.
+func rewriteContributorGroups(rel string, data []byte) ([]byte, error) {
+	if !bytes.Contains(data, []byte("GTTSealContributorGroup")) {
+		return data, nil
+	}
+	fs := token.NewFileSet()
+	file, err := parser.ParseFile(fs, rel, data, 0)
+	if err != nil {
+		return nil, err
+	}
+	var edits []textEdit
+	for _, decl := range file.Decls {
+		fn, ok := decl.(*ast.FuncDecl)
+		if !ok || fn.Body == nil {
+			continue
+		}
+		ast.Inspect(fn.Body, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			sel, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || sel.Sel.Name != "GTTSealContributorGroup" || len(call.Args) != 4 {
+				return true
+			}
+			hash := ""
+			if contributorProtocol(fs, file, fn, call) {
+				hash = fmt.Sprintf("%x", sha256.Sum256([]byte(rel+"\n"+rootText(fs, fn))))
+			}
+			replacement := fmt.Sprintf("%s.GTTAttachContributorGroup(%s,%s,%s,%q)",
+				rootText(fs, sel.X), rootText(fs, call.Args[0]), rootText(fs, call.Args[2]), rootText(fs, call.Args[3]), hash)
+			edits = append(edits, textEdit{start: fs.Position(call.Pos()).Offset, end: fs.Position(call.End()).Offset, replacement: replacement})
+			return false
+		})
+	}
+	return applyTextEdits(data, edits)
+}
+
+func contributorProtocol(fs *token.FileSet, file *ast.File, fn *ast.FuncDecl, seal *ast.CallExpr) bool {
+	compact := func(s string) string {
+		return strings.Map(func(r rune) rune {
+			if unicode.IsSpace(r) || r == ';' {
+				return -1
+			}
+			return r
+		}, s)
+	}
+	text := func(n ast.Node) string {
+		if n == nil {
+			return ""
+		}
+		return compact(rootText(fs, n))
+	}
+	group, list, weights, target := text(seal.Args[0]), text(seal.Args[1]), text(seal.Args[2]), text(seal.Args[3])
+	// Resolve the configured runtime from the marker's actual constructor.
+	// Receivers and free functions share the protocol; no reaction names.
+	core := ""
+	for _, stmt := range fn.Body.List {
+		a, ok := stmt.(*ast.AssignStmt)
+		if !ok || a.Tok != token.DEFINE || len(a.Lhs) != 1 || text(a.Lhs[0]) != group || len(a.Rhs) != 1 {
+			continue
+		}
+		call, ok := a.Rhs[0].(*ast.CallExpr)
+		if !ok || len(call.Args) != 1 {
+			return false
+		}
+		method, ok := call.Fun.(*ast.SelectorExpr)
+		if !ok || method.Sel.Name != "GTTNewContributorGroup" || sourceImportAliases(file)[text(method.X)] != "github.com/genshinsim/gcsim/pkg/core/info" {
+			return false
+		}
+		runtime, ok := call.Args[0].(*ast.SelectorExpr)
+		if !ok || runtime.Sel.Name != "GTTTrace" || !safeSelectorChain(text(runtime.X)) {
+			return false
+		}
+		core = text(runtime.X)
+	}
+	if core == "" {
+		return false
+	}
+	// Rank weights must really be fixed source data, not an untraced stat-
+	// dependent vector. Values themselves are captured, never copied here.
+	fixedWeights := false
+	for _, decl := range file.Decls {
+		gd, ok := decl.(*ast.GenDecl)
+		if !ok {
+			continue
+		}
+		for _, sp := range gd.Specs {
+			v, ok := sp.(*ast.ValueSpec)
+			if !ok || len(v.Names) != 1 || v.Names[0].Name != weights || len(v.Values) != 1 {
+				continue
+			}
+			lit, ok := v.Values[0].(*ast.CompositeLit)
+			if !ok || text(lit.Type) != "[]float64" || len(lit.Elts) < 1 || len(lit.Elts) > 4 {
+				return false
+			}
+			for _, e := range lit.Elts {
+				number, ok := e.(*ast.BasicLit)
+				if !ok {
+					return false
+				}
+				f, err := strconv.ParseFloat(number.Value, 64)
+				if err != nil || f < 0 {
+					return false
+				}
+			}
+			fixedWeights = true
+		}
+	}
+	if !fixedWeights {
+		return false
+	}
+	if _, ok := seal.Args[1].(*ast.Ident); !ok {
+		return false
+	}
+	var loop *ast.RangeStmt
+	var record *ast.CallExpr
+	loopIndex, sealIndex := -1, -1
+	for i, stmt := range fn.Body.List {
+		if stmt.Pos() <= seal.Pos() && stmt.End() >= seal.End() {
+			sealIndex = i
+		}
+		r, ok := stmt.(*ast.RangeStmt)
+		if !ok {
+			continue
+		}
+		ast.Inspect(r.Body, func(n ast.Node) bool {
+			c, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			s, ok := c.Fun.(*ast.SelectorExpr)
+			if ok && s.Sel.Name == "GTTRecordContributor" && len(c.Args) == 8 && text(c.Args[0]) == group {
+				if record != nil {
+					loopIndex = -2
+					return false
+				}
+				loop, record, loopIndex = r, c, i
+			}
+			return true
+		})
+	}
+	if loop == nil || record == nil || loopIndex < 0 || sealIndex != loopIndex+4 {
+		return false
+	}
+	body := loop.Body.List
+	if len(body) < 7 || text(body[len(body)-1]) != text(record) {
+		return false
+	}
+	pre, damage, roll, crit, cr, cd := text(record.Args[2]), text(record.Args[3]), text(record.Args[4]), text(record.Args[5]), text(record.Args[6]), text(record.Args[7])
+	// The tail is uninterrupted; no hidden writes can intervene in crit/append.
+	if text(body[len(body)-6]) != pre+":="+damage ||
+		text(body[len(body)-5]) != crit+":=false" {
+		return false
+	}
+	draw, ok := body[len(body)-4].(*ast.AssignStmt)
+	if !ok || draw.Tok != token.DEFINE || len(draw.Lhs) != 1 || text(draw.Lhs[0]) != roll || len(draw.Rhs) != 1 {
+		return false
+	}
+	rng, ok := draw.Rhs[0].(*ast.CallExpr)
+	if !ok || len(rng.Args) != 0 {
+		return false
+	}
+	// Configured engine RNG, not an arbitrary function with a matching name.
+	if text(rng.Fun) != core+".Rand.Float64" {
+		return false
+	}
+	expectedIf := "if" + roll + "<=" + cr + "{" + damage + "*=(1+" + cd + ");" + crit + "=true}"
+	if text(body[len(body)-3]) != compact(expectedIf) {
+		return false
+	}
+	app, ok := body[len(body)-2].(*ast.AssignStmt)
+	if !ok || app.Tok != token.ASSIGN || len(app.Lhs) != 1 || text(app.Lhs[0]) != list || len(app.Rhs) != 1 {
+		return false
+	}
+	appendCall, ok := app.Rhs[0].(*ast.CallExpr)
+	if !ok || text(appendCall.Fun) != "append" || len(appendCall.Args) != 2 || text(appendCall.Args[0]) != list {
+		return false
+	}
+	literal, ok := appendCall.Args[1].(*ast.CompositeLit)
+	if !ok || len(literal.Elts) < 2 || text(literal.Elts[0]) != damage || text(literal.Elts[1]) != crit {
+		return false
+	}
+	typ := text(literal.Type)
+	field := ""
+	for _, d := range file.Decls {
+		gd, ok := d.(*ast.GenDecl)
+		if !ok {
+			continue
+		}
+		for _, sp := range gd.Specs {
+			ts, ok := sp.(*ast.TypeSpec)
+			if !ok || ts.Name.Name != typ {
+				continue
+			}
+			st, ok := ts.Type.(*ast.StructType)
+			if !ok || len(st.Fields.List) == 0 || len(st.Fields.List[0].Names) != 1 {
+				return false
+			}
+			field = st.Fields.List[0].Names[0].Name
+		}
+	}
+	if field == "" {
+		return false
+	}
+	if text(fn.Body.List[loopIndex+1]) != "iflen("+list+")==0{return}" {
+		return false
+	}
+	sortStmt, ok := fn.Body.List[loopIndex+2].(*ast.ExprStmt)
+	if !ok {
+		return false
+	}
+	sortCall, ok := sortStmt.X.(*ast.CallExpr)
+	if !ok || len(sortCall.Args) != 2 || text(sortCall.Args[0]) != list {
+		return false
+	}
+	sortFn, ok := sortCall.Fun.(*ast.SelectorExpr)
+	if !ok || sortFn.Sel.Name != "SortStableFunc" {
+		return false
+	}
+	importOK := false
+	for _, imp := range file.Imports {
+		v, _ := strconv.Unquote(imp.Path.Value)
+		name := "slices"
+		if imp.Name != nil {
+			name = imp.Name.Name
+		}
+		if v == "slices" && text(sortFn.X) == name {
+			importOK = true
+		}
+	}
+	if !importOK {
+		return false
+	}
+	comparator, ok := sortCall.Args[1].(*ast.FuncLit)
+	if !ok || len(comparator.Type.Params.List) != 1 {
+		return false
+	}
+	params := comparator.Type.Params.List[0]
+	if len(params.Names) != 2 || text(params.Type) != typ || len(comparator.Body.List) != 2 {
+		return false
+	}
+	diffAssign, ok := comparator.Body.List[0].(*ast.AssignStmt)
+	if !ok || len(diffAssign.Lhs) != 1 {
+		return false
+	}
+	diff := text(diffAssign.Lhs[0])
+	left, right := params.Names[0].Name, params.Names[1].Name
+	if text(comparator.Body) != compact("{"+diff+":="+right+"."+field+"-"+left+"."+field+";switch{case"+diff+"<0:return-1;case"+diff+">0:return1;default:return0}}") {
+		return false
+	}
+	reduce, ok := fn.Body.List[loopIndex+3].(*ast.RangeStmt)
+	if !ok || text(reduce.X) != list {
+		return false
+	}
+	index, item := text(reduce.Key), text(reduce.Value)
+	statements := reduce.Body.List
+	if item == "" && len(statements) > 0 {
+		// Equivalent indexed iteration: item := &items[index]. Require this
+		// exact alias, and deny every mutation beyond the checked accumulation.
+		a, ok := statements[0].(*ast.AssignStmt)
+		if !ok || a.Tok != token.DEFINE || len(a.Lhs) != 1 || len(a.Rhs) != 1 || text(a.Rhs[0]) != "&"+list+"["+index+"]" {
+			return false
+		}
+		id, ok := a.Lhs[0].(*ast.Ident)
+		if !ok {
+			return false
+		}
+		item = id.Name
+		statements = statements[1:]
+	}
+	sum := target + "+=" + item + "." + field + "*" + weights + "[" + index + "]"
+	sums := 0
+	for _, stmt := range statements {
+		if text(stmt) == sum {
+			sums++
+			continue
+		}
+		// Engine logging is observational. All other reducer statements are denied.
+		es, ok := stmt.(*ast.ExprStmt)
+		if !ok || !strings.Contains(text(es), core+".Combat.Log.NewEvent(") {
+			return false
+		}
+		bad := false
+		ast.Inspect(es, func(n ast.Node) bool {
+			if _, ok := n.(*ast.FuncLit); ok {
+				bad = true
+			}
+			return true
+		})
+		if bad {
+			return false
+		}
+	}
+	if sums != 1 {
+		return false
+	}
+	// Before the reducer, the collection has exactly its empty initializer and
+	// the checked append. Additional assignments/aliases fail closed.
+	valid := true
+	ast.Inspect(fn.Body, func(n ast.Node) bool {
+		if n == nil || n.Pos() >= seal.Pos() {
+			return false
+		}
+		a, ok := n.(*ast.AssignStmt)
+		if !ok {
+			return true
+		}
+		for _, lhs := range a.Lhs {
+			l := text(lhs)
+			if l == weights || strings.HasPrefix(l, weights+"[") {
+				valid = false
+			}
+			if l == list {
+				initial := a.Tok == token.DEFINE && len(a.Rhs) == 1 && text(a.Rhs[0]) == "[]"+typ+"{}"
+				if a != app && !initial {
+					valid = false
+				}
+			} else if strings.HasPrefix(l, list+"[") {
+				valid = false
+			}
+		}
+		return true
+	})
+	return valid
+}
diff --git a/pkg/gttsourcegen/contributor_group_test.go b/pkg/gttsourcegen/contributor_group_test.go
new file mode 100644
