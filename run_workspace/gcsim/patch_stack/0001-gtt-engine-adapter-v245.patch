+}
+
+// RecordNumericStateWriteWithInputs keeps the arithmetic event that produced a
+// write connected to the ordered slot ledger. The legacy wrapper above remains
+// for callers that have no typed input evidence yet.
+func (r *Runtime) RecordNumericStateWriteWithInputs(
+	slotID, sourceID string,
+	before, after float64,
+	inputs []NumericRef,
+	evidence DependencyEvidence,
+) string {
+	return r.recordNumericStateWrite(slotID, sourceID, before, after, inputs, evidence)
