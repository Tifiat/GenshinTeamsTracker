+package info
+
+import (
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"testing"
+)
+
+func TestNumericWriteBeforeAndAfterHitCreation(t *testing.T) {
+	var disabled *gtttrace.Runtime
+	if GTTNewNumericCapture(disabled, gtttrace.NumericRef{}) != nil {
+		t.Fatal("disabled observer allocated")
+	}
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	a := &AttackEvent{}
+	GTTRecordAttackFieldWrite(a, r, "FlatDmg", "add", 0, 2, 2, gtttrace.LiteralRef(2))
+	a.GTTTraceHit = &GTTTraceHit{NumericFieldWrites: append([]GTTNumericFieldWrite(nil), a.GTTNumericFieldWrites...)}
+	GTTRecordAttackFieldWrite(a, r, "FlatDmg", "add", 2, 5, 3, gtttrace.LiteralRef(3))
+	if len(a.GTTTraceHit.NumericFieldWrites) != 2 || a.GTTTraceHit.NumericFieldWrites[1].Order != 1 {
+		t.Fatal("late write missing")
+	}
+}
diff --git a/pkg/core/info/gtt_numeric_recipe.go b/pkg/core/info/gtt_numeric_recipe.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/info/gtt_numeric_recipe.go
@@ -0,0 +1,68 @@
+package info
+
+import "github.com/genshinsim/gcsim/pkg/gtttrace"
+
+// Numeric recipes are an internal, versioned observer/compact-compiler ABI.
+// They are generated from the patched upstream calculation, not a second
+// gameplay formula registry. The public compact graph format is unchanged.
+const GTTNumericRecipeVersion = "gtt_numeric_recipe_v1"
+
+type GTTNumericInput struct {
+	Kind      string
+	StatKey   string
+	Value     float64
+	Source    string
+	Reference gtttrace.NumericRef
+	Recipe    *GTTNumericRecipe
+}
+
+// One observed scalar can be nested into another source recipe without
+// inventing a reaction-specific mathematical operator.
+type GTTNumericCapture struct {
+	Hit            GTTTraceHit
+	InputReference gtttrace.NumericRef
+}
+
+func GTTNewNumericCapture(rt *gtttrace.Runtime, ref gtttrace.NumericRef) *GTTNumericCapture {
+	if !rt.Enabled() {
+		return nil
+	}
+	return &GTTNumericCapture{InputReference: ref}
+}
+
+type GTTNumericNode struct {
+	Op    string
+	Args  []int
+	Value float64
+	Input int
+}
+
+type GTTNumericRecipe struct {
+	Version      string
+	SourceSHA256 string
+	Nodes        []GTTNumericNode
+	Root         int
+	Inputs       []GTTNumericInput
+	Observed     float64
+}
+
+// GTTTraceCaptureNumeric is a build-overlay marker. An uninstrumented build
+// retains the explicit old boundary; it must never pretend to have a recipe.
+// Inputs contain already computed scalars: no additional gameplay calls/RNG.
+func GTTTraceCaptureNumeric(hit *GTTTraceHit, observed float64, inputs ...GTTNumericInput) {
+	if hit != nil {
+		hit.AddUnsupported("numeric_recipe_overlay_missing")
+	}
+}
+
+func GTTTraceAttachNumeric(hit *GTTTraceHit, recipe GTTNumericRecipe) {
+	if hit != nil {
+		hit.NumericRecipe = &recipe
+	}
+}
+
+func GTTTraceNumericUnsupported(hit *GTTTraceHit, reason string) {
+	if hit != nil {
+		hit.AddUnsupported(reason)
+	}
+}
diff --git a/pkg/core/info/gtt_snapshot_stats.go b/pkg/core/info/gtt_snapshot_stats.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/info/gtt_snapshot_stats.go
@@ -0,0 +1,96 @@
+package info
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+// Immutable origin, copied with the snapshot. Never infer an owner from a
+// matching number, a current active character, or the eventual damage owner.
+type GTTStatsOrigin struct {
+	// Private: receipt metadata must not become a second discoverable path to
+	// a character's runtime (e.g. through a saved Snapshot field).
+	runtime     *gtttrace.Runtime
+	Owner       int
+	Values      attributes.Stats
+	ModifierIDs []string
+}
+
+func GTTSelectStats(rt *gtttrace.Runtime, owner any, nonExtra bool, keys []attributes.Stat, fallback func() attributes.Stats) (attributes.Stats, *GTTStatsOrigin) {
+	if c, ok := owner.(interface {
+		Index() int
+		GTTSelectStat(bool, ...attributes.Stat) (attributes.Stats, []string)
+	}); ok {
+		value, ids := c.GTTSelectStat(nonExtra, keys...)
+		if !rt.Enabled() {
+			return value, nil
+		}
+		return value, GTTStatsOriginFromModifiers(rt, c.Index(), value, ids)
+	}
+	return fallback(), nil
+}
+
+// Central stat-container arithmetic, not character/weapon mechanics. This is
+// the same base*(1+percent)+flat contract already used by MaxHP/direct scaling.
+// It consumes the saved filtered getter outputs, never a later ordinary Stat.
+func GTTStatsTotalRef(rt *gtttrace.Runtime, origin *GTTStatsOrigin, stats attributes.Stats, base, percent, flat attributes.Stat, observed float64) gtttrace.NumericRef {
+	freeze := func() gtttrace.NumericRef {
+		return gtttrace.EventRef(rt.RecordNumericEval("", "frozen_attack_operand", nil, observed, gtttrace.IncompleteEvidence("stats_container_origin_unproven_or_mutated")))
+	}
+	if origin == nil || origin.runtime != rt || origin.Values != stats {
+		return freeze()
+	}
+	refs := []gtttrace.NumericRef{}
+	for _, key := range []attributes.Stat{base, percent, flat} {
+		if key <= attributes.NoStat || key >= attributes.EndStatType {
+			return freeze()
+		}
+		if key >= attributes.DelimBaseStat {
+			refs = append(refs, gtttrace.LiteralRef(stats[key]))
+		} else {
+			refs = append(refs, gtttrace.EventRef(rt.RecordArtifactStatRead(origin.Owner, key.String(), stats[key], origin.ModifierIDs)))
+		}
+	}
+	if stats[base]*(1+stats[percent])+stats[flat] != observed {
+		return freeze()
+	}
+	record := func(op string, inputs []gtttrace.NumericRef, value float64) gtttrace.NumericRef {
+		return gtttrace.EventRef(rt.RecordNumericEval("", op, inputs, value, gtttrace.IncompleteEvidence("stats_container_observed_schedule")))
+	}
+	p := record("add", []gtttrace.NumericRef{gtttrace.LiteralRef(1), refs[1]}, 1+stats[percent])
+	x := record("multiply", []gtttrace.NumericRef{refs[0], p}, stats[base]*(1+stats[percent]))
+	return record("add", []gtttrace.NumericRef{x, refs[2]}, observed)
+}
+
+func GTTNewStatsOrigin(rt *gtttrace.Runtime, owner int, values attributes.Stats, contributions []GTTTraceStatContribution) *GTTStatsOrigin {
+	if !rt.Enabled() {
+		return nil
+	}
+	ids := []string{}
+	for _, c := range contributions {
+		if c.Accepted && c.ModifierEvalEventID != "" {
+			ids = append(ids, c.ModifierEvalEventID)
+		}
+	}
+	return GTTStatsOriginFromModifiers(rt, owner, values, ids)
+}
+
+func GTTStatsOriginFromModifiers(rt *gtttrace.Runtime, owner int, values attributes.Stats, ids []string) *GTTStatsOrigin {
+	if !rt.Enabled() {
+		return nil
+	}
+	return &GTTStatsOrigin{runtime: rt, Owner: owner, Values: values, ModifierIDs: append([]string(nil), ids...)}
+}
+
+// observed is the value already read by gameplay, not a fresh getter call.
+// A later unobserved mutation is a boundary, never stale snapshot ancestry.
+func GTTSnapshotStatRef(rt *gtttrace.Runtime, snapshot Snapshot, key attributes.Stat, observed float64) gtttrace.NumericRef {
+	origin := snapshot.GTTStatsOrigin
+	if origin == nil || origin.runtime != rt || key <= attributes.NoStat || key >= attributes.EndStatType || origin.Values[key] != observed || snapshot.Stats[key] != observed {
+		return gtttrace.EventRef(rt.RecordNumericEval("", "frozen_attack_operand", nil, observed, gtttrace.IncompleteEvidence("snapshot_stat_origin_unproven_or_mutated")))
+	}
+	if key >= attributes.DelimBaseStat {
+		return gtttrace.LiteralRef(observed)
+	}
+	return gtttrace.EventRef(rt.RecordArtifactStatRead(origin.Owner, key.String(), observed, origin.ModifierIDs))
+}
diff --git a/pkg/core/info/gtt_snapshot_stats_test.go b/pkg/core/info/gtt_snapshot_stats_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/info/gtt_snapshot_stats_test.go
@@ -0,0 +1,45 @@
+package info
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"testing"
+)
+
+func TestSnapshotStatOwnershipAndMutationBoundary(t *testing.T) {
+	rt := gtttrace.NewRuntime()
+	rt.Enable()
+	snap := Snapshot{}
+	snap.Stats[attributes.EM] = 412
+	snap.GTTStatsOrigin = GTTNewStatsOrigin(rt, 3, snap.Stats, []GTTTraceStatContribution{{Accepted: true, ModifierEvalEventID: "old-modifier"}, {Accepted: false, ModifierEvalEventID: "rejected"}})
+	ref := GTTSnapshotStatRef(rt, snap, attributes.EM, 412)
+	if ref.EventID == nil {
+		t.Fatal("missing ref")
+	}
+	rows := rt.StateEvents()
+	event := rows[len(rows)-1]
+	if *event.OwnerIndex != 3 || len(event.ModifierEvalIDs) != 1 || event.ModifierEvalIDs[0] != "old-modifier" {
+		t.Fatal("lost snapshot owner/time", event)
+	}
+	copy := snap
+	copy.Stats[attributes.EM] = 413
+	GTTSnapshotStatRef(rt, copy, attributes.EM, 413)
+	rows = rt.StateEvents()
+	event = rows[len(rows)-1]
+	if *event.Operation != "frozen_attack_operand" {
+		t.Fatal("stale origin reused", event)
+	}
+	if snap.Stats[attributes.EM] != 412 {
+		t.Fatal("copy changed original")
+	}
+	another := gtttrace.NewRuntime()
+	another.Enable()
+	GTTSnapshotStatRef(another, snap, attributes.EM, 412)
+	rows = another.StateEvents()
+	if *rows[len(rows)-1].Operation != "frozen_attack_operand" {
+		t.Fatal("cross-simulation ref")
+	}
+	if GTTNewStatsOrigin(nil, 0, snap.Stats, nil) != nil {
+		t.Fatal("disabled allocation")
+	}
+}
diff --git a/pkg/core/info/gtt_trace.go b/pkg/core/info/gtt_trace.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/info/gtt_trace.go
@@ -0,0 +1,375 @@
+package info
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+// GTTTraceFormulaVersion is the interpretation contract for the flattened
+// numeric formula fields in GTTTraceHit. FormulaComplete means the terminal
+// numeric calculation is captured; the other completeness flags independently
+// guard provenance and topology.
+const GTTTraceFormulaVersion = "gtt_trace_formula_v3"
+
+const (
+	GTTTraceTransformativeFormulaID     = "gtt_transformative_reaction_v1"
+	GTTTraceTransformativeFormulaSHA256 = "c5e843111092ced9e2979cc228715acaafb4701b462923bb21b2c59091d43139"
+)
+
+type GTTTraceSourceParameter = gtttrace.SourceValueParameter
+
+func GTTTraceReadFrame(attack *AttackEvent) int {
+	if attack == nil {
+		return -1
+	}
+	if attack.GTTTraceHit != nil {
+		return attack.GTTTraceHit.Frame
+	}
+	if attack.Snapshot.SourceFrame != 0 {
+		return attack.Snapshot.SourceFrame
+	}
+	return attack.SourceFrame
+}
+
+// GTTTraceCaptureSourceParameters is the generic target of build-time AST
+// instrumentation for a supported modifier Amount expression. It records no
+// semantic names and has no effect on gameplay arithmetic.
+func GTTTraceCaptureSourceParameters(
+	attack *AttackEvent,
+	sourceID string,
+	templateSHA256 string,
+	parameters []GTTTraceSourceParameter,
+) {
+	if attack == nil {
+		return
+	}
+	attack.GTTTraceCapturedSourceID = sourceID
+	attack.GTTTraceCapturedTemplateSHA256 = templateSHA256
+	attack.GTTTraceCapturedSourceParameters = cloneGTTTraceSourceParameters(parameters)
+}
+
+func GTTTraceTakeCapturedSourceParameters(
+	attack *AttackEvent,
+) (string, string, []GTTTraceSourceParameter) {
+	if attack == nil {
+		return "", "", nil
+	}
+	sourceID := attack.GTTTraceCapturedSourceID
+	templateSHA256 := attack.GTTTraceCapturedTemplateSHA256
+	parameters := cloneGTTTraceSourceParameters(attack.GTTTraceCapturedSourceParameters)
+	attack.GTTTraceCapturedSourceID = ""
+	attack.GTTTraceCapturedTemplateSHA256 = ""
+	attack.GTTTraceCapturedSourceParameters = nil
+	return sourceID, templateSHA256, parameters
+}
+
+func GTTTraceNormalizeSourceParameters(
+	parameters []GTTTraceSourceParameter,
+	frame int,
+	actorIndex int,
+) []GTTTraceSourceParameter {
+	out := cloneGTTTraceSourceParameters(parameters)
+	for index := range out {
+		if out[index].ReadFrame < 0 {
+			out[index].ReadFrame = frame
+		}
+		if out[index].ActorIndex == nil && out[index].Kind == "candidate_stat" {
+			actor := actorIndex
+			out[index].ActorIndex = &actor
+		}
+	}
+	return out
+}
+
+func cloneGTTTraceSourceParameters(
+	parameters []GTTTraceSourceParameter,
+) []GTTTraceSourceParameter {
+	out := append(make([]GTTTraceSourceParameter, 0, len(parameters)), parameters...)
+	for index := range out {
+		if out[index].ActorIndex != nil {
+			actor := *out[index].ActorIndex
+			out[index].ActorIndex = &actor
+		}
+		if out[index].ActorKey != nil {
+			actorKey := *out[index].ActorKey
+			out[index].ActorKey = &actorKey
+		}
+		if out[index].StatKey != nil {
+			statKey := *out[index].StatKey
+			out[index].StatKey = &statKey
+		}
+	}
+	return out
+}
+
+// GTTTraceFormulaSHA256 identifies the interpretation registry, not the
+// current numeric values of a hit. Numeric inputs are carried separately in
+// GTTTraceHit so a safe perturbation does not masquerade as formula drift.
+func GTTTraceFormulaSHA256() string {
+	digest := sha256.Sum256([]byte(GTTTraceFormulaVersion))
+	return hex.EncodeToString(digest[:])
+}
+
+const (
+	GTTTraceFormulaStandard       = "standard"
+	GTTTraceFormulaDirectReaction = "direct_reaction"
+	// Legacy serialized category: read old evidence, never emit it for new hits.
+	GTTTraceFormulaDirectLunar  = "direct_lunar"
+	GTTTraceFormulaOpaqueCustom = "opaque_custom"
+)
+
+type GTTTraceAttackContext struct {
+	AttackID uint64
+}
+
+const (
+	GTTTraceReactionReadLive             = "live"
+	GTTTraceReactionReadSnapshot         = "snapshot"
+	GTTTraceReactionReadLiveTrigger      = "live_trigger"
+	GTTTraceReactionReadPersistentUpdate = "persistent_update"
+	GTTTraceReactionReadGadgetCreation   = "gadget_creation"
+	GTTTraceReactionReadGadgetRupture    = "gadget_rupture"
+	GTTTraceReactionReadGadgetConversion = "gadget_conversion"
+)
+
+// GTTTraceReactionContext carries only causal metadata. Numeric construction
+// inputs are filled at the exact CalcReactionDmg call that reads them.
+type GTTTraceReactionContext struct {
+	ElementalMasteryRef     gtttrace.NumericRef
+	Enabled                 bool
+	ReadFrame               int
+	ReadMode                string
+	ReadPhase               string
+	ParentAttackID          *uint64
+	ParentTargetKey         *int
+	ChildRole               string
+	ChildOrdinal            int
+	PersistentStateID       *string
+	PersistentStateRevision *uint64
+	GadgetID                *string
+	GadgetCreatorIndex      *int
+	GadgetConverterIndex    *int
+	GadgetResolutionReason  *string
+	ReactionType            string
+	OperatorID              string
+	AuraSourceIndices       []int
+}
+
+type GTTTraceStatContribution struct {
+	ModifierKey         string             `json:"modifier_key"`
+	ModifierEvalEventID string             `json:"modifier_eval_event_id"`
+	RecipientIndex      int                `json:"recipient_index"`
+	Accepted            bool               `json:"accepted"`
+	Values              map[string]float64 `json:"values"`
+	SourceID            string             `json:"-"`
+	SourceOccurrenceID  string             `json:"-"`
+	Provider            gtttrace.Provider  `json:"provider"`
+}
+
+type GTTTraceCallbackAttempt struct {
+	NumericWrites          []GTTNumericFieldWrite `json:"-"`
+	Event                  int                    `json:"event"`
+	HookKey                string                 `json:"hook_key"`
+	SourceID               string                 `json:"-"`
+	ParentSourceID         *string                `json:"-"`
+	SourceOccurrenceID     string                 `json:"-"`
+	Provider               gtttrace.Provider      `json:"provider"`
+	Changed                bool                   `json:"changed"`
+	TopologyChanged        bool                   `json:"topology_changed"`
+	StateEffectsUnobserved bool                   `json:"state_effects_unobserved"`
+	SnapshotDelta          map[string]float64     `json:"snapshot_delta"`
+	MultDelta              float64                `json:"mult_delta"`
+	FlatDmgDelta           float64                `json:"flat_dmg_delta"`
+	BaseDmgBonusDelta      float64                `json:"base_dmg_bonus_delta"`
+	ElevationDelta         float64                `json:"elevation_delta"`
+	IgnoreDefDelta         float64                `json:"ignore_def_delta"`
+	AmpMultiplierDelta     float64                `json:"amp_multiplier_delta"`
+}
+
+type GTTTraceTargetModContribution struct {
+	Channel            string            `json:"channel"`
+	ModifierKey        string            `json:"modifier_key"`
+	Value              float64           `json:"value"`
+	SourceID           string            `json:"-"`
