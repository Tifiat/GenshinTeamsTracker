+// NumericPayload is copied into a task enqueue receipt. It is deliberately a
+// small key/value pair rather than an arbitrary interface so task evidence is
+// deterministic and JSON-safe.
+type NumericPayload struct {
+	Key       string     `json:"key"`
+	Value     float64    `json:"value"`
+	Reference NumericRef `json:"reference"`
+}
+
+type NumericRef struct {
+	Kind              string   `json:"kind"`
+	EventID           *string  `json:"event_id"`
+	HealthOperationID *string  `json:"health_operation_id"`
+	FieldKey          *string  `json:"field_key"`
+	LiteralValue      *float64 `json:"literal_value"`
+}
+
+type DependencyEvidence struct {
+	CandidateDependencyComplete bool
+	UncertaintyCodes            []string
+}
+
+func CompleteEvidence() DependencyEvidence {
+	return DependencyEvidence{CandidateDependencyComplete: true, UncertaintyCodes: []string{}}
+}
+
+func IncompleteEvidence(codes ...string) DependencyEvidence {
+	return DependencyEvidence{CandidateDependencyComplete: false, UncertaintyCodes: canonicalStrings(codes)}
+}
+
+func SourceDependencyEvidence(
+	sourceID, templateSHA256 string,
+	parameters []SourceValueParameter,
+) DependencyEvidence {
+	if !validSHA256(sourceID) || gttsource.TemplateSHA256(sourceID) == "" {
+		return IncompleteEvidence("numeric_source_identity_missing")
+	}
+	if templateSHA256 == "" || gttsource.TemplateSHA256(sourceID) != templateSHA256 {
+		return IncompleteEvidence("numeric_source_template_missing")
+	}
+	for _, parameter := range parameters {
+		if !parameter.CandidateDependencyComplete {
+			return IncompleteEvidence("numeric_source_parameter_dependency_incomplete")
+		}
+	}
+	return CompleteEvidence()
+}
+
+func EventRef(eventID string) NumericRef {
+	return NumericRef{Kind: "event", EventID: optionalString(eventID)}
+}
+
+func EventOutputRef(eventID, fieldKey string) NumericRef {
+	return NumericRef{
+		Kind: "event", EventID: optionalString(eventID), FieldKey: optionalString(fieldKey),
+	}
+}
+
+func LiteralRef(value float64) NumericRef {
+	return NumericRef{Kind: "literal", LiteralValue: optionalFloat(value)}
+}
+
+func HealthFieldRef(operationID, fieldKey string) NumericRef {
+	return NumericRef{
+		Kind: "health_field", HealthOperationID: optionalString(operationID),
+		FieldKey: optionalString(fieldKey),
+	}
+}
+
+// EnterHelperNumericArguments carries observed numeric arguments across one
+// synchronous helper call. It is generic runtime context; source discovery is
+// responsible for limiting resolution to one unambiguous same-receiver hop.
+func (r *Runtime) EnterHelperNumericArguments(payloads []NumericPayload) func() {
+	if !r.Enabled() {
+		return func() {}
+	}
+	depth := len(r.helperNumericContexts)
+	r.helperNumericContexts = append(r.helperNumericContexts, cloneNumericPayloads(payloads))
+	return func() {
+		if len(r.helperNumericContexts) >= depth {
+			r.helperNumericContexts = r.helperNumericContexts[:depth]
+		}
+	}
+}
+
+// CurrentHelperNumericRef returns the caller-side evidence for one formal
+// parameter when the observed value still matches. Missing/mismatched context
+// fails open to a literal reference and never changes gameplay execution.
+func (r *Runtime) CurrentHelperNumericRef(key string, observed float64) NumericRef {
+	if r == nil {
+		return LiteralRef(observed)
+	}
+	return currentNumericContextRef(r.Enabled(), r.helperNumericContexts, key, observed)
+}
+
+// CurrentTaskNumericRef returns the enqueue-side evidence for one numeric
+// payload while the corresponding queued callback is executing. Missing or
+// mismatched context remains a literal boundary and never changes gameplay.
+func (r *Runtime) CurrentTaskNumericRef(key string, observed float64) NumericRef {
+	if r == nil {
+		return LiteralRef(observed)
+	}
+	return currentNumericContextRef(r.Enabled(), r.taskNumericContexts, key, observed)
+}
+
+// UpdateTaskNumericArgument advances one task-local numeric dependency after
+// the callback mutates its formal parameter. The source compiler emits this
+// only for a proven numeric formal assignment; absent context fails open.
+func (r *Runtime) UpdateTaskNumericArgument(key string, observed float64, reference NumericRef) {
+	if r == nil || !r.Enabled() || len(r.taskNumericContexts) == 0 || key == "" || !finite(observed) {
+		return
+	}
+	context := r.taskNumericContexts[len(r.taskNumericContexts)-1]
+	for index := range context {
+		if context[index].Key != key {
+			continue
+		}
+		context[index].Value = observed
+		context[index].Reference = cloneNumericRef(reference)
+		return
+	}
+}
+
+func currentNumericContextRef(enabled bool, contexts [][]NumericPayload, key string, observed float64) NumericRef {
+	if !enabled || len(contexts) == 0 || !finite(observed) {
+		return LiteralRef(observed)
+	}
+	context := contexts[len(contexts)-1]
+	for _, payload := range context {
+		if payload.Key != key || !finite(payload.Value) {
+			continue
+		}
+		tolerance := 1e-9 * math.Max(1, math.Max(math.Abs(payload.Value), math.Abs(observed)))
+		if math.Abs(payload.Value-observed) <= tolerance {
+			return cloneNumericRef(payload.Reference)
+		}
+	}
+	return LiteralRef(observed)
+}
