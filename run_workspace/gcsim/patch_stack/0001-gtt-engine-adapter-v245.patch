+func appendTraceCallbackAttempt(
+	e Event,
+	hook ehook,
+	parentSourceID string,
+	occurrenceID string,
+	attack *info.AttackEvent,
+	beforeInfo info.AttackInfo,
+	beforeStats attributes.Stats,
+) {
+	row := info.GTTTraceCallbackAttempt{
+		Event: int(e), HookKey: hook.key, SourceID: hook.sourceID, Provider: hook.provider,
+		SourceOccurrenceID:     occurrenceID,
+		StateEffectsUnobserved: true,
+		SnapshotDelta:          make(map[string]float64),
+		MultDelta:              attack.Info.Mult - beforeInfo.Mult,
+		FlatDmgDelta:           attack.Info.FlatDmg - beforeInfo.FlatDmg,
+		BaseDmgBonusDelta:      attack.Info.BaseDmgBonus - beforeInfo.BaseDmgBonus,
+		ElevationDelta:         attack.Info.Elevation - beforeInfo.Elevation,
+		IgnoreDefDelta:         attack.Info.IgnoreDefPercent - beforeInfo.IgnoreDefPercent,
+		AmpMultiplierDelta:     attack.Info.AmpMult - beforeInfo.AmpMult,
+	}
+	for _, write := range attack.GTTNumericFieldWrites {
+		if write.OccurrenceID == occurrenceID {
+			row.NumericWrites = append(row.NumericWrites, write)
+		}
+	}
+	if gttsource.ValidID(parentSourceID) {
+		row.ParentSourceID = &parentSourceID
+	}
+	for stat := attributes.Stat(0); stat < attributes.EndStatType; stat++ {
+		delta := attack.Snapshot.Stats[stat] - beforeStats[stat]
+		if delta != 0 && stat.String() != "" {
+			row.SnapshotDelta[stat.String()] = delta
+		}
+	}
+	row.TopologyChanged = attack.Info.Element != beforeInfo.Element ||
+		attack.Info.AttackTag != beforeInfo.AttackTag ||
+		attack.Info.ICDTag != beforeInfo.ICDTag ||
+		attack.Info.ICDGroup != beforeInfo.ICDGroup ||
+		attack.Info.Durability != beforeInfo.Durability ||
+		attack.Info.UseDef != beforeInfo.UseDef ||
+		attack.Info.UseHP != beforeInfo.UseHP ||
+		attack.Info.UseEM != beforeInfo.UseEM ||
+		attack.Info.Amped != beforeInfo.Amped ||
+		attack.Info.AmpType != beforeInfo.AmpType ||
+		attack.Info.Catalyzed != beforeInfo.Catalyzed ||
+		attack.Info.CatalyzedType != beforeInfo.CatalyzedType
+	row.Changed = row.TopologyChanged || len(row.SnapshotDelta) > 0 ||
+		row.MultDelta != 0 || row.FlatDmgDelta != 0 ||
+		row.BaseDmgBonusDelta != 0 || row.ElevationDelta != 0 ||
+		row.IgnoreDefDelta != 0 || row.AmpMultiplierDelta != 0
+	if attack.GTTTraceHit == nil {
+		attack.GTTTraceCallbackAttempts = append(attack.GTTTraceCallbackAttempts, row)
+		return
+	}
+	attack.GTTTraceHit.CallbackAttempts = append(attack.GTTTraceHit.CallbackAttempts, row)
+	attack.GTTTraceHit.AddUnsupported("untyped_callback_state_effects_unmodeled")
+	if !row.Provider.Complete() {
+		attack.GTTTraceHit.Completeness.ProviderIdentityComplete = false
+		attack.GTTTraceHit.AddUnsupported("callback_provider_unattributed")
+	}
+	if row.TopologyChanged {
+		attack.GTTTraceHit.Completeness.ReactionTopologyComplete = false
+		attack.GTTTraceHit.AddUnsupported("callback_changed_attack_topology")
+	}
