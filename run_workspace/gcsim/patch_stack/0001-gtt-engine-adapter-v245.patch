+func assertTemplateContract(t *testing.T, template SliceTemplate) {
+	t.Helper()
+	canonical, err := CanonicalJSON(templateHashBody(template))
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(canonical)
+	if template.TemplateSHA256 != hex.EncodeToString(sum[:]) {
+		t.Fatal("template SHA mismatch")
+	}
+	if template.Status == TemplateOpaqueFrozen {
+		if len(template.Nodes) != 0 || template.RootNodeID != nil || len(template.ParameterKeys) != 0 || template.DependenciesComplete || template.StopReasonCode == nil {
+			t.Fatalf("invalid opaque template: %#v", template)
+		}
+		return
+	}
+	if len(template.Nodes) == 0 || template.RootNodeID == nil || *template.RootNodeID != len(template.Nodes)-1 || !template.DependenciesComplete || template.StopReasonCode != nil {
+		t.Fatalf("invalid supported template: %#v", template)
+	}
+	for index, node := range template.Nodes {
+		if node.NodeID != index {
+			t.Fatal("non-contiguous node ids")
+		}
+		for _, input := range node.InputNodeIDs {
+			if input >= index {
+				t.Fatal("template input is not earlier")
+			}
+		}
+	}
+}
