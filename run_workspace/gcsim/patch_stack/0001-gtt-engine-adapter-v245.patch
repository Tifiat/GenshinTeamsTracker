+package gttcompact
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func TestCompileSyntheticDirectReactionSupportAndOpaque(t *testing.T) {
+	maxHPEventID := "state-event:0"
+	modifierEventID := "state-event:1"
+	maxHPOwner := 0 // RecordMaxHPRead always carries the typed receiver owner.
+	buffer := optstats.GTTTraceEquationBuffer{
+		Seed: 101, DurationFrames: 120,
+		Hits: []info.GTTTraceHit{
+			{
+				HitID: 1, ActorIndex: 1, FormulaKind: info.GTTTraceFormulaStandard,
+				Completeness: info.GTTTraceCompleteness{FormulaComplete: true}, UncappedDamage: 100100,
+				AttackTag: 1, Element: "hydro", Mult: 1, ScalingStatKind: "atk", ScalingStatValue: 100,
+				SnapshotStats: map[string]float64{"base_atk": 100, "atk": 100, "cr": 0, "cd": 0},
+				DamageBonus:   1000, DefMod: 1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+				AttackMods: []info.GTTTraceAttackModAttempt{{Accepted: true, ModifierEvalEventID: modifierEventID, Delta: map[string]float64{"dmg%": 1000}}},
+			},
+			{
+				HitID: 2, ActorIndex: 1, FormulaKind: info.GTTTraceFormulaStandard,
+				Completeness: info.GTTTraceCompleteness{FormulaComplete: true}, UncappedDamage: 100,
+				AttackTag: 2, Element: "dendro", SnapshotStats: map[string]float64{},
+				DefMod: 1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+				ReactionFormula: &info.GTTTraceReactionFormula{
+					FormulaID: info.GTTTraceTransformativeFormulaID, FormulaSHA256: info.GTTTraceTransformativeFormulaSHA256,
+					OwnerIndex: 1, LevelBase: 100, EMCurveNumerator: 1, EMCurveDenominatorOffset: 1000, Coefficient: 1,
+				},
+			},
+		},
+		StateEvents: []gtttrace.StateEvent{
+			{
+				SequenceIndex: 0, EventID: maxHPEventID, Kind: gtttrace.StateEventMaxHPRead,
+				OwnerIndex:                  &maxHPOwner,
+				Provider:                    gtttrace.Provider{Known: true, Kind: "character", Key: "bennett", OwnerIndex: 0},
+				Output:                      map[string]float64{"base_hp": 1000, "hp%": 0, "hp": 0, "max_hp": 1000},
+				CandidateDependencyComplete: true, UncertaintyCodes: []string{},
+			},
+			{
+				SequenceIndex: 1, EventID: modifierEventID, Kind: gtttrace.StateEventModifierEval,
+				Provider: gtttrace.Provider{Known: true, Kind: "character", Key: "support", OwnerIndex: 0},
+				Inputs:   []gtttrace.NumericRef{gtttrace.EventOutputRef(maxHPEventID, "max_hp")},
+				Output:   map[string]float64{"dmg%": 1000}, CandidateDependencyComplete: false,
+				UncertaintyCodes: []string{"synthetic_modifier_uncertain"},
+			},
+		},
+		StateSlots: []gtttrace.StateSlot{}, HealthOperations: []gtttrace.HealthOperation{},
+		SourceOccurrences: []gtttrace.SourceOccurrence{}, SourceValueBindings: []gtttrace.SourceValueBinding{},
+		Unsupported: []string{}, TopologyEvents: []optstats.GTTTraceTopologyEvent{},
+	}
+	member, audit, err := CompileSeedMember(buffer, []string{"bennett", "actor_a"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The old synthetic reaction has no bonus-read receipt, even at zero.
+	if audit.ChannelCount != 2 || audit.OpaqueReasonCount != 3 || len(member.OpaqueBoundaries) != 3 {
+		t.Fatalf("audit = %#v", audit)
+	}
+	if audit.BaselineDamage != 100200 {
+		t.Fatalf("baseline = %v, want 100200", audit.BaselineDamage)
+	}
+	foundSupport := false
+	for _, coordinate := range member.Channels[0].ResponseCoordinates {
+		if coordinate == "bennett.hp_percent" {
+			foundSupport = true
+		}
+	}
+	if !foundSupport {
+		t.Fatal("direct channel lost support HP coordinate")
+	}
+	if member.Channels[1].Kind != "reaction" {
+		t.Fatalf("reaction kind = %q", member.Channels[1].Kind)
+	}
+}
diff --git a/pkg/gttcompact/contributor_group.go b/pkg/gttcompact/contributor_group.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/contributor_group.go
@@ -0,0 +1,160 @@
+package gttcompact
+
+import (
+	"encoding/hex"
+	"math"
+	"sort"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+// This is a mathematical reducer, not a registry of gameplay reactions.
+// Sort realized values within EACH crit state. Sorting expected contributor
+// values is not equivalent when crits can exchange their rank weights.
+func contributorReceiptValid(hit info.GTTTraceHit) bool {
+	g := hit.ContributorGroup
+	if g == nil || g.Version != info.GTTContributorGroupVersion || len(g.Contributors) < 1 || len(g.Contributors) > 4 || len(g.Weights) < len(g.Contributors) || len(g.Weights) > 4 {
+		return false
+	}
+	hash, err := hex.DecodeString(g.SourceSHA256)
+	if err != nil || len(hash) != 32 || !hit.Completeness.FormulaComplete {
+		return false
+	}
+	// The supported producer supplies final flat damage and a display-only crit.
+	// Changed outer semantics are a boundary, never a second owner-stat formula.
+	if hit.Mult != 0 || hit.CritDamage != 0 || hit.Amped || hit.DamageBonus != 0 || !closeEnough(hit.FlatDmg, g.ObservedFlat) {
+		return false
+	}
+	finite := func(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) }
+	values := make([]float64, len(g.Contributors))
+	owners := map[int]bool{}
+	for i, part := range g.Contributors {
+		h := part.Hit
+		if owners[h.ActorIndex] || h.ActorIndex < 0 || h.ContributorGroup != nil ||
+			h.NumericRecipe == nil || !closeEnough(h.NumericRecipe.Observed, part.PreCrit) ||
+			!finite(part.PreCrit) || part.PreCrit < 0 || !finite(part.Realized) ||
+			!finite(h.RawCritRate) || !finite(h.CritDamage) || h.CritDamage < 0 ||
+			!finite(part.Roll) || part.Roll < 0 || part.Roll >= 1 ||
+			!closeEnough(part.CritRate, h.RawCritRate) || !closeEnough(part.CritDamage, h.CritDamage) ||
+			part.IsCrit != (part.Roll <= h.RawCritRate) {
+			return false
+		}
+		owners[h.ActorIndex] = true
+		v := part.PreCrit
+		if part.IsCrit {
+			v *= 1 + h.CritDamage
+		}
+		if !closeEnough(v, part.Realized) {
+			return false
+		}
+		values[i] = v
+	}
+	for _, w := range g.Weights {
+		if !finite(w) || w < 0 {
+			return false
+		}
+	}
+	sort.SliceStable(values, func(i, j int) bool { return values[i] > values[j] })
+	actual := 0.0
+	for i, v := range values {
+		actual += v * g.Weights[i]
+	}
+	if !closeEnough(actual, g.ObservedFlat) {
+		return false
+	}
+	factor := contributorTerminalFactor(hit)
+	return finite(factor) && factor >= 0 && closeEnough(actual*factor, hit.UncappedDamage)
+}
+
+func contributorTerminalFactor(hit info.GTTTraceHit) float64 {
+	return hit.ResMod * hit.DefMod * hit.DamageGroupMultiplier * hit.ElevationMultiplier
+}
+
+// Independent scalar oracle for the OBSERVED input point; it does not inspect
+// compiled graph baselines. Actual rolls first validate the upstream reduction.
+func observedContributorExpected(hit info.GTTTraceHit) (float64, bool) {
+	if !contributorReceiptValid(hit) {
+		return 0, false
+	}
+	g := hit.ContributorGroup
+	expected := 0.0
+	for mask := 0; mask < 1<<len(g.Contributors); mask++ {
+		probability := 1.0
+		values := make([]float64, len(g.Contributors))
+		for i, part := range g.Contributors {
+			cr := math.Min(1, math.Max(0, part.Hit.RawCritRate))
+			values[i] = part.PreCrit
+			if mask&(1<<i) != 0 {
+				probability *= cr
+				values[i] *= 1 + part.Hit.CritDamage
+			} else {
+				probability *= 1 - cr
+			}
+		}
+		sort.SliceStable(values, func(i, j int) bool { return values[i] > values[j] })
+		for i, value := range values {
+			expected += probability * value * g.Weights[i]
+		}
+	}
+	return expected * contributorTerminalFactor(hit), true
+}
+
+func (c *directCompiler) compileContributorGroup(hit info.GTTTraceHit) compiledNode {
+	fail := func() compiledNode {
+		c.unknown["contributor_group_unproven"] = struct{}{}
+		return c.b.constant(expectedFallbackDamage(hit))
+	}
+	if !contributorReceiptValid(hit) {
+		return fail()
+	}
+	g := hit.ContributorGroup
+	n := len(g.Contributors)
+	pre, cr, cd := make([]compiledNode, n), make([]compiledNode, n), make([]compiledNode, n)
+	for i, part := range g.Contributors {
+		h := part.Hit
+		if h.ActorIndex >= len(c.characterKeys) {
+			return fail()
+		}
+		actor := c.characterKeys[h.ActorIndex]
+		budget := 512
+		pre[i] = c.compileNumericRecipePart(h, actor, false, 0, &budget, true)
+		dynamic := c.dynamicStatDeltas(h)
+		stat := func(key string, observed float64) compiledNode {
+			v := c.b.add(c.b.constant(observed), c.b.artifactDelta(actor, key))
+			if d, ok := dynamic[key]; ok {
+				v = c.b.add(v, d)
+			}
+			return v
+		}
+		cr[i] = c.b.min(c.b.constant(1), c.b.max(c.b.constant(0), stat("cr", h.RawCritRate)))
+		cd[i] = c.b.add(c.b.constant(1), stat("cd", h.CritDamage))
+	}
+	states := make([]compiledNode, 0, 1<<n)
+	for mask := 0; mask < 1<<n; mask++ {
+		values := make([]compiledNode, n)
+		probs := make([]compiledNode, n)
+		for i := 0; i < n; i++ {
+			values[i] = pre[i]
+			probs[i] = c.b.subtract(c.b.constant(1), cr[i])
+			if mask&(1<<i) != 0 {
+				values[i] = c.b.multiply(pre[i], cd[i])
+				probs[i] = cr[i]
+			}
+		}
+		// A fixed insertion network; min/max recompute rank under candidate stats.
+		// Equal values are interchangeable for this scalar weighted sum.
+		for i := 1; i < n; i++ {
+			for j := i; j > 0; j-- {
+				a, b := values[j-1], values[j]
+				values[j-1], values[j] = c.b.max(a, b), c.b.min(a, b)
+			}
+		}
+		terms := make([]compiledNode, n)
+		for i := range values {
+			terms[i] = c.b.multiply(c.b.constant(g.Weights[i]), values[i])
+		}
+		states = append(states, c.b.multiply(c.b.multiply(probs...), c.b.add(terms...)))
+	}
+	c.unknown["contributor_membership_schedule_frozen"] = struct{}{}
+	return c.b.multiply(c.b.add(states...), c.resistanceInput(hit), c.b.constant(hit.DefMod*hit.DamageGroupMultiplier*hit.ElevationMultiplier))
+}
diff --git a/pkg/gttcompact/contributor_group_test.go b/pkg/gttcompact/contributor_group_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/contributor_group_test.go
@@ -0,0 +1,139 @@
+package gttcompact
+
+import (
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+func groupFixture(n int) info.GTTTraceHit {
+	g := &info.GTTContributorGroup{Version: info.GTTContributorGroupVersion, SourceSHA256: strings.Repeat("a", 64), Weights: []float64{.6, .3, .05, .05}}
+	vals := []float64{}
+	for i := 0; i < n; i++ {
+		v := 100 + float64(i)*20
+		cr, cd := .5, 1.0
+		h := info.GTTTraceHit{ActorIndex: i, RawCritRate: cr, CritDamage: cd, SnapshotStats: map[string]float64{"em": v},
+			NumericRecipe: &info.GTTNumericRecipe{Version: info.GTTNumericRecipeVersion, SourceSHA256: strings.Repeat("b", 64),
+				Inputs: []info.GTTNumericInput{{Kind: "snapshot_stat", StatKey: "em", Value: v}},
+				Nodes:  []info.GTTNumericNode{{Op: "INPUT", Input: 0}}, Root: 0, Observed: v}}
+		g.Contributors = append(g.Contributors, info.GTTContributor{Hit: h, PreCrit: v, Realized: v, Roll: .75, CritRate: cr, CritDamage: cd})
+		vals = append(vals, v)
+	}
+	sort.Slice(vals, func(i, j int) bool { return vals[i] > vals[j] })
+	for i, v := range vals {
+		g.ObservedFlat += v * g.Weights[i]
+	}
+	return info.GTTTraceHit{ActorIndex: 3, ContributorGroup: g, FlatDmg: g.ObservedFlat, UncappedDamage: g.ObservedFlat,
+		Completeness: info.GTTTraceCompleteness{FormulaComplete: true}, ResMod: 1, DefMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1}
+}
+
+func evalContributorGraph(t *testing.T, b *nodeBuilder, root compiledNode, deltas map[string]float64) float64 {
+	t.Helper()
+	values := map[uint32]float64{}
+	for _, n := range b.nodes {
+		v := 0.0
+		switch n.Operation {
+		case "constant":
+			v, _ = strconv.ParseFloat(n.Value, 64)
+		case "artifact_stat":
+			v = deltas[n.Coordinate]
+		case "add":
+			for _, a := range n.Inputs {
+				v += values[a.NodeID]
+			}
+		case "multiply":
+			v = 1
+			for _, a := range n.Inputs {
+				v *= values[a.NodeID]
+			}
+		case "min":
+			v = math.Inf(1)
+			for _, a := range n.Inputs {
+				v = math.Min(v, values[a.NodeID])
+			}
+		case "max":
+			v = math.Inf(-1)
+			for _, a := range n.Inputs {
+				v = math.Max(v, values[a.NodeID])
+			}
+		case "power":
+			v = math.Pow(values[n.Inputs[0].NodeID], values[n.Inputs[1].NodeID])
+		default:
+			t.Fatal(n.Operation)
+		}
+		values[n.NodeID] = v
+	}
+	return values[root.id]
+}
+
+func TestContributorCritBeforeSortAndOwnership(t *testing.T) {
+	hit := groupFixture(2)
+	// A:100 guaranteed; B:80 or240 equiprobably. Winner changes on B's crit.
+	// E[.6*max+.3*min]=(.6*100+.3*80 + .6*240+.3*100)/2=129.
+	// Sorting means would give .6*160+.3*100=126: the wrong shortcut.
+	a, b := &hit.ContributorGroup.Contributors[0], &hit.ContributorGroup.Contributors[1]
+	a.Hit.RawCritRate, a.CritRate = 0, 0
+	b.Hit.CritDamage, b.CritDamage = 2, 2
+	b.PreCrit, b.Realized, b.Hit.NumericRecipe.Observed = 80, 80, 80
+	b.Hit.SnapshotStats["em"], b.Hit.NumericRecipe.Inputs[0].Value = 80, 80
+	hit.FlatDmg, hit.UncappedDamage, hit.ContributorGroup.ObservedFlat = 84, 84, 84
+	c := directCompiler{b: &nodeBuilder{}, characterKeys: []string{"a", "b", "c", "last_trigger"}, unknown: map[string]struct{}{}}
+	root := c.compileContributorGroup(hit)
+	if got := evalContributorGraph(t, c.b, root, nil); math.Abs(got-129) > 1e-10 {
+		t.Fatal(got, c.unknown)
+	}
+	for coord := range root.coords {
+		if strings.HasPrefix(coord, "last_trigger.") || strings.Contains(coord, "percent") {
+			t.Fatal("invented owner/bonus", coord)
+		}
+	}
+	got := evalContributorGraph(t, c.b, root, map[string]float64{"b.em": 120})
+	// B:200/600 now always wins; expected .6*400+.3*100=270.
+	if math.Abs(got-270) > 1e-10 {
+		t.Fatal("rank did not change", got)
+	}
+	if got := evalContributorGraph(t, c.b, root, map[string]float64{normalizeCoordinate("b", "cr"): 2}); math.Abs(got-174) > 1e-10 {
+		t.Fatal("CR cap", got)
+	}
+	if got := evalContributorGraph(t, c.b, root, map[string]float64{normalizeCoordinate("a", "dmg%"): 1, normalizeCoordinate("b", "electro%"): 1}); got != root.baseline {
+		t.Fatal("invented damage bonus")
+	}
+}
+
+func TestContributorFourParticipantsAndBoundaries(t *testing.T) {
+	for n := 1; n <= 4; n++ {
+		hit := groupFixture(n)
+		c := directCompiler{b: &nodeBuilder{}, characterKeys: []string{"a", "b", "c", "d"}, unknown: map[string]struct{}{}}
+		expected, ok := observedContributorExpected(hit)
+		if !ok {
+			t.Fatal("fixture", n)
+		}
+		root := c.compileContributorGroup(hit)
+		if got := evalContributorGraph(t, c.b, root, nil); math.Abs(got-expected) > 1e-10 {
+			t.Fatal(n, got, expected)
+		}
+		if len(c.b.nodes) > 1600 {
+			t.Fatal("unbounded expansion", n, len(c.b.nodes))
+		}
+	}
+	for _, mutation := range []func(*info.GTTTraceHit){
+		func(h *info.GTTTraceHit) { h.ContributorGroup.SourceSHA256 = "" },
+		func(h *info.GTTTraceHit) { h.ContributorGroup.Contributors[0].Realized++ },
+		func(h *info.GTTTraceHit) { h.ContributorGroup.Contributors[1].Hit.ActorIndex = 0 },
+		func(h *info.GTTTraceHit) { h.CritDamage = 1 },
+		func(h *info.GTTTraceHit) { h.FlatDmg++ },
+		func(h *info.GTTTraceHit) { h.ContributorGroup.Weights[0] = math.NaN() },
+	} {
+		h := groupFixture(4)
+		mutation(&h)
+		c := directCompiler{b: &nodeBuilder{}, characterKeys: []string{"a", "b", "c", "d"}, unknown: map[string]struct{}{}}
+		root := c.compileContributorGroup(h)
+		if len(root.coords) != 0 || root.baseline != h.UncappedDamage {
+			t.Fatal("unsafe group did not freeze", root)
+		}
+	}
+}
diff --git a/pkg/gttcompact/dependency_validation_test.go b/pkg/gttcompact/dependency_validation_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/dependency_validation_test.go
@@ -0,0 +1,126 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/combat"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"math"
+	"strconv"
+	"testing"
+)
+
+type updateRiskSource struct{}
+
+func (updateRiskSource) Index() int                                                     { return 0 }
+func (updateRiskSource) ReactBonus(info.AttackInfo) float64                             { return 0 }
+func (updateRiskSource) ReactBonusWithTrace(info.AttackInfo, *info.GTTTraceHit) float64 { return 0 }
+
+// Use the upstream producer as an independent reference, with no reaction names.
+func TestTransformativeProducerOwnsCoordinates(t *testing.T) {
+	damage, snap := combat.CalcReactionDmg(90, updateRiskSource{}, info.AttackInfo{}, 100, 2,
+		info.GTTTraceReactionContext{Enabled: true})
+	hit := info.GTTTraceHit{ActorIndex: 0, FormulaKind: info.GTTTraceFormulaStandard,
+		ReactionFormula: snap.GTTReactionFormula,
+		DefMod:          1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1}
+	b := &nodeBuilder{}
+	c := directCompiler{b: b, characterKeys: []string{"actor"}, unknown: make(map[string]struct{})}
+	root := c.compileTransformative(hit, "actor")
+	eval := func(deltas map[string]float64) float64 {
+		values := make(map[uint32]float64)
+		for _, node := range b.nodes {
+			value := 0.0
+			switch node.Operation {
+			case "constant":
+				value, _ = strconv.ParseFloat(node.Value, 64)
+			case "artifact_stat":
+				value = deltas[node.Coordinate]
+			case "add":
+				for _, input := range node.Inputs {
+					value += values[input.NodeID]
+				}
+			case "multiply":
+				value = 1
+				for _, input := range node.Inputs {
+					value *= values[input.NodeID]
+				}
+			case "min":
+				value = math.Inf(1)
+				for _, input := range node.Inputs {
+					value = math.Min(value, values[input.NodeID])
+				}
+			case "max":
+				value = math.Inf(-1)
+				for _, input := range node.Inputs {
+					value = math.Max(value, values[input.NodeID])
+				}
+			case "power":
+				value = math.Pow(values[node.Inputs[0].NodeID], values[node.Inputs[1].NodeID])
+			default:
+				t.Fatal(node.Operation)
+			}
+			values[node.NodeID] = value
+		}
+		return values[root.id]
+	}
+	baseline := eval(nil)
+	crit := eval(map[string]float64{normalizeCoordinate("actor", "cr"): 0.2, normalizeCoordinate("actor", "cd"): 1})
+	bonus := eval(map[string]float64{normalizeCoordinate("actor", "dmg%"): 0.4})
+	if math.Abs(baseline-damage) > 1e-8 || crit != baseline || bonus != baseline {
+		t.Fatal(baseline, damage, crit, bonus)
+	}
+	changedEM, _ := combat.CalcReactionDmg(90, updateRiskSource{}, info.AttackInfo{}, 200, 2, info.GTTTraceReactionContext{})
+	if actual := eval(map[string]float64{normalizeCoordinate("actor", "em"): 100}); math.Abs(actual-changedEM) > 1e-8 {
+		t.Fatal(actual, changedEM)
+	}
+	hit.RawCritRate, hit.CritDamage = 0.2, 1
+	root = c.compileTransformative(hit, "actor")
+	if actual := eval(map[string]float64{normalizeCoordinate("actor", "cr"): 0.5, normalizeCoordinate("actor", "cd"): 1}); math.Abs(actual-damage*1.2) > 1e-8 {
+		t.Fatal("fixed reaction crit lost or owner crit inherited", actual)
+	}
+	c.support.eventOutputs = map[string]map[string]compiledNode{"proven": {"cr": b.add(b.constant(0.2), b.multiply(b.constant(0.001), b.artifactDelta("support", "em")))}}
+	hit.StatContributions = []info.GTTTraceStatContribution{{ModifierEvalEventID: "proven", Values: map[string]float64{"cr": 0.2}}}
+	root = c.compileTransformative(hit, "actor")
+	if actual := eval(map[string]float64{normalizeCoordinate("support", "em"): 100}); math.Abs(actual-damage*1.3) > 1e-8 {
+		t.Fatal("proven support dependency lost", actual)
+	}
+}
+
+func TestTerminalMismatchFreezesLocally(t *testing.T) {
+	hit := info.GTTTraceHit{HitID: 1, ActorIndex: 0,
+		FormulaKind: info.GTTTraceFormulaStandard, ScalingStatKind: "atk",
+		ScalingStatValue: 100, Mult: 1, UncappedDamage: 200, ReportedDamage: 200,
+		Completeness: info.GTTTraceCompleteness{FormulaComplete: true},
+		DefMod:       1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1}
+	good := hit
+	good.HitID, good.UncappedDamage = 2, 100
+	member, _, err := CompileSeedMember(optstats.GTTTraceEquationBuffer{
+		Seed: 101, DurationFrames: 60, Hits: []info.GTTTraceHit{hit, good}}, []string{"actor"})
+	if err != nil || member.Channels[0].BaselineDamage != "200" || len(member.OpaqueBoundaries) != 1 || len(member.Channels[0].ResponseCoordinates) != 0 {
+		t.Fatal(member, err)
+	}
+	if member.Channels[1].BaselineDamage != "100" || len(member.Channels[1].ResponseCoordinates) == 0 {
+		t.Fatal("neighbor frozen", member)
+	}
+}
+
+func TestTerminalExpectedCritUsesObservedOutcome(t *testing.T) {
+	for _, tc := range []struct {
+		name                       string
+		cr, cd, observed, expected float64
+		crit, weak                 bool
+	}{
+		{"noncrit", .5, 1, 100, 150, false, false},
+		{"crit", .5, 1, 200, 150, true, false},
+		{"cap", 2, 1, 200, 200, true, false},
+		{"negativecr", -.5, 1, 100, 100, false, false},
+		{"weak", 0, 1, 200, 200, true, true},
+		{"zero", .5, 1, 0, 0, false, false},
+	} {
+		hit := info.GTTTraceHit{RawCritRate: tc.cr, CritDamage: tc.cd, UncappedDamage: tc.observed,
+			IsCrit: tc.crit, HitWeakPoint: tc.weak, Completeness: info.GTTTraceCompleteness{FormulaComplete: true}}
+		actual, ok := observedExpectedDamage(hit)
+		if !ok || actual != tc.expected {
+			t.Fatal(tc.name, actual, ok)
+		}
+	}
+}
diff --git a/pkg/gttcompact/direct.go b/pkg/gttcompact/direct.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/direct.go
@@ -0,0 +1,453 @@
+package gttcompact
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+type directCompiler struct {
+	b             *nodeBuilder
+	buffer        optstats.GTTTraceEquationBuffer
+	characterKeys []string
+	support       supportProgram
+	unknown       map[string]struct{}
+	occurrence    map[string]gtttrace.SourceOccurrence
+	flatBinding   map[string]gtttrace.SourceValueBinding
+}
+
+func compileChannels(b *nodeBuilder, buffer optstats.GTTTraceEquationBuffer, characterKeys []string, support supportProgram) ([]IRChannel, map[string]struct{}, float64) {
+	c := &directCompiler{
+		b: b, buffer: buffer, characterKeys: characterKeys, support: support,
+		unknown: make(map[string]struct{}), occurrence: make(map[string]gtttrace.SourceOccurrence),
+		flatBinding: make(map[string]gtttrace.SourceValueBinding),
+	}
+	for reason := range support.unknown {
+		c.unknown[reason] = struct{}{}
+	}
+	for _, reason := range buffer.Unsupported {
+		c.unknown[reason] = struct{}{}
+	}
+	for _, occurrence := range buffer.SourceOccurrences {
+		c.occurrence[occurrence.OccurrenceID] = occurrence
+	}
+	for _, binding := range buffer.SourceValueBindings {
+		if binding.OutputKind == "terminal_flat_dmg" && binding.TerminalEventID != nil {
+			c.flatBinding[*binding.TerminalEventID] = binding
+		}
+	}
+	channels := make([]IRChannel, 0, len(buffer.Hits))
+	total := 0.0
+	for index, hit := range buffer.Hits {
+		for _, reason := range hit.Unsupported {
+			c.unknown[reason] = struct{}{}
+		}
+		actor := "unknown_actor"
+		if hit.ActorIndex >= 0 && hit.ActorIndex < len(characterKeys) {
+			actor = characterKeys[hit.ActorIndex]
+		}
+		root, kind := c.compileHit(hit, actor)
+		// Compare against the engine's observed terminal value, not the baseline
+		// just produced by this compiler. Undo only the observed crit factor and
+		// replace it with the expected one; all other engine multipliers remain.
+		if expected, ok := observedExpectedDamage(hit); !ok {
+			c.unknown["terminal_observation_incomplete"] = struct{}{}
+			root = c.b.constant(expectedFallbackDamage(hit))
+		} else if !closeEnough(root.baseline, expected) {
+			c.unknown["terminal_formula_baseline_mismatch"] = struct{}{}
+			root = c.b.constant(expected)
+		}
+		total += root.baseline
+		channels = append(channels, IRChannel{
+			ChannelID: fmt.Sprintf("hit/%06d", index+1), Kind: kind, ActorKey: actor,
+			AttackTag: "tag/" + strconv.Itoa(hit.AttackTag), DamageType: normalizeToken(hit.Element, "unknown_damage"),
+			RootNodeID: root.id, HitCount: 1, BaselineDamage: decimal(root.baseline),
+			ResponseCoordinates: sortedCoords(root.coords),
+		})
+	}
+	return channels, c.unknown, total
+}
+
+func (c *directCompiler) compileHit(hit info.GTTTraceHit, actor string) (compiledNode, string) {
+	if hit.ContributorGroup != nil {
+		return c.compileContributorGroup(hit), "reaction"
+	}
+	if hit.FormulaKind == info.GTTTraceFormulaDirectReaction || hit.FormulaKind == info.GTTTraceFormulaDirectLunar {
+		if hit.NumericRecipe != nil {
+			return c.compileNumericRecipe(hit, actor), "reaction"
+		}
+		// A captured terminal number is not a candidate-dependent direct-reaction
+		// formula. In particular, its EM curve and flat-add order differ from
+		// ordinary talents. Do not route it through the standard compiler.
+		c.unknown["direct_reaction_dependency_formula_not_compiled"] = struct{}{}
+		return c.b.constant(expectedFallbackDamage(hit)), "reaction"
+	}
+	if hit.FormulaKind != info.GTTTraceFormulaStandard ||
+		(hit.ReactionOperatorID == "opaque_custom" && hit.ReactionFormula == nil) {
+		c.unknown["terminal_formula_not_instrumented"] = struct{}{}
+		return c.b.constant(expectedFallbackDamage(hit)), "direct"
+	}
+	if hit.ReactionFormula != nil {
+		for _, reason := range hit.Unsupported {
+			if reason == "transformative_reaction_formula_mismatch" && !hasFlatWriteReceipt(hit) {
+				// The producer is valid, but a later change has no proven candidate
+				// expression. Do not silently score only the original reaction.
+				c.unknown["reaction_terminal_dependency_not_compiled"] = struct{}{}
+				return c.b.constant(expectedFallbackDamage(hit)), "reaction"
+			}
+		}
+		return c.compileTransformative(hit, actor), "reaction"
+	}
+	dynamic := c.dynamicStatDeltas(hit)
+	stat := func(key string) compiledNode {
+		observed := hit.SnapshotStats[key]
+		values := []compiledNode{c.b.constant(observed)}
+		if artifactVariableStat(key) {
+			values = append(values, c.b.artifactDelta(actor, key))
+		}
+		if value, ok := dynamic[key]; ok {
+			values = append(values, value)
+		}
+		return c.b.add(values...)
+	}
+	scaling := c.b.constant(hit.ScalingStatValue)
+	switch hit.ScalingStatKind {
+	case "atk":
+		scaling = c.scalingStat(hit.ScalingStatValue, hit.SnapshotStats["base_atk"], actor, "atk%", "atk", dynamic)
+	case "hp":
+		scaling = c.scalingStat(hit.ScalingStatValue, hit.SnapshotStats["base_hp"], actor, "hp%", "hp", dynamic)
+	case "def":
+		scaling = c.scalingStat(hit.ScalingStatValue, hit.SnapshotStats["base_def"], actor, "def%", "def", dynamic)
+	case "em":
+		scaling = stat("em")
+	}
+	flat := c.compileTerminalFlat(hit, actor, dynamic)
+	base := c.b.add(
+		c.b.multiply(c.compileTalentMultiplier(hit), scaling),
+		flat,
+	)
+	bonusValues := []compiledNode{c.b.constant(1 + hit.DamageBonus), c.b.artifactDelta(actor, "dmg%")}
+	if hit.Element != "" && hit.Element != "none" && hit.Element != "n/a" {
+		bonusValues = append(bonusValues, c.b.artifactDelta(actor, hit.Element+"%"))
+	}
+	for _, key := range []string{"dmg%", hit.Element + "%"} {
+		if value, ok := dynamic[key]; ok {
+			bonusValues = append(bonusValues, value)
+		}
+	}
+	bonus := c.b.add(bonusValues...)
+	cr := c.b.add(c.b.constant(hit.RawCritRate), c.b.artifactDelta(actor, "cr"))
+	if value, ok := dynamic["cr"]; ok {
+		cr = c.b.add(cr, value)
+	}
+	cd := c.b.add(c.b.constant(hit.CritDamage), c.b.artifactDelta(actor, "cd"))
+	if value, ok := dynamic["cd"]; ok {
+		cd = c.b.add(cd, value)
+	}
+	crit := c.b.add(c.b.constant(1), c.b.multiply(c.b.min(c.b.constant(1), c.b.max(c.b.constant(0), cr)), cd))
+	if hit.HitWeakPoint {
+		crit = c.b.add(c.b.constant(1), cd)
+	}
+	root := c.b.multiply(base, bonus, c.b.constant(hit.DefMod), c.resistanceInput(hit), crit)
+	if hit.Amped {
+		em := stat("em")
+		curve := c.b.add(c.b.constant(1), c.reactionBonusNode(hit.ReactionBonus, hit.ReactionBonusRef), c.b.divide(c.b.multiply(c.b.constant(2.78), em), c.b.add(c.b.constant(1400), em)))
+		root = c.b.multiply(root, c.b.constant(hit.AmpMult), curve)
+	}
+	root = c.b.multiply(root, c.b.constant(hit.DamageGroupMultiplier), c.b.constant(hit.ElevationMultiplier))
+	return root, "direct"
+}
+
+func (c *directCompiler) scalingStat(observed, base float64, actor, percentKey, flatKey string, dynamic map[string]compiledNode) compiledNode {
+	values := []compiledNode{
+		c.b.constant(observed),
+		c.b.multiply(c.b.constant(base), c.b.artifactDelta(actor, percentKey)),
+		c.b.artifactDelta(actor, flatKey),
+	}
+	if value, ok := dynamic[percentKey]; ok {
+		values = append(values, c.b.multiply(c.b.constant(base), value))
+	}
+	if value, ok := dynamic[flatKey]; ok {
+		values = append(values, value)
+	}
+	return c.b.add(values...)
+}
+
+func (c *directCompiler) compileTransformative(hit info.GTTTraceHit, fallbackActor string) compiledNode {
+	formula := hit.ReactionFormula
+	if formula.FormulaID != info.GTTTraceTransformativeFormulaID || formula.FormulaSHA256 != info.GTTTraceTransformativeFormulaSHA256 {
+		c.unknown["reaction_producer_formula_unrecognized"] = struct{}{}
+		return c.b.constant(expectedFallbackDamage(hit))
+	}
+	for _, reason := range hit.Unsupported {
+		if reason == "transformative_reaction_formula_mismatch" && !hasFlatWriteReceipt(hit) {
+			c.unknown[reason] = struct{}{}
+			return c.b.constant(expectedFallbackDamage(hit))
+		}
+	}
+	actor := fallbackActor
+	if formula.OwnerIndex >= 0 && formula.OwnerIndex < len(c.characterKeys) {
+		actor = c.characterKeys[formula.OwnerIndex]
+	} else {
+		c.unknown["reaction_producer_owner_unrecognized"] = struct{}{}
+		return c.b.constant(expectedFallbackDamage(hit))
+	}
+	em := c.reactionMasteryNode(formula.ElementalMastery, formula.ElementalMasteryRef, actor)
+	core := c.b.multiply(c.b.constant(formula.LevelBase), c.b.add(
+		c.b.constant(1), c.reactionBonusNode(formula.ReactionBonus, formula.ReactionBonusRef),
+		c.b.divide(c.b.multiply(c.b.constant(formula.EMCurveNumerator), em), c.b.add(c.b.constant(formula.EMCurveDenominatorOffset), em)),
+	))
+	// This producer constructs an isolated reaction snapshot, not a character
+	// snapshot. Preserve actual fixed crit and proven modifier-event deltas,
+	// but never invent owner artifact CR/CD or DMG% inheritance.
+	dynamic := c.dynamicStatDeltas(hit)
+	cr := c.b.constant(hit.RawCritRate)
+	cd := c.b.constant(hit.CritDamage)
+	if value, ok := dynamic["cr"]; ok {
+		cr = c.b.add(cr, value)
+	}
+	if value, ok := dynamic["cd"]; ok {
+		cd = c.b.add(cd, value)
+	}
+	crit := c.b.add(c.b.constant(1), c.b.multiply(c.b.min(c.b.constant(1), c.b.max(c.b.constant(0), cr)), cd))
+	if hit.HitWeakPoint {
+		crit = c.b.add(c.b.constant(1), cd)
+	}
+	if !hasFlatWriteReceipt(hit) {
+		return c.b.multiply(c.b.constant(formula.Coefficient), core, c.b.constant(1+hit.DamageBonus), c.b.constant(hit.DefMod), c.resistanceInput(hit), crit, c.b.constant(hit.DamageGroupMultiplier), c.b.constant(hit.ElevationMultiplier))
+	}
+	flat := c.compileAttackField(hit, "FlatDmg", c.b.multiply(c.b.constant(formula.Coefficient), core), hit.FlatDmg)
+	return c.b.multiply(
+		flat,
+		c.b.constant(1+hit.DamageBonus),
+		c.b.constant(hit.DefMod), c.resistanceInput(hit), crit,
+		c.b.constant(hit.DamageGroupMultiplier), c.b.constant(hit.ElevationMultiplier),
+	)
+}
+
+func (c *directCompiler) dynamicStatDeltas(hit info.GTTTraceHit) map[string]compiledNode {
+	parts := make(map[string][]compiledNode)
+	add := func(eventID string, baseline map[string]float64) {
+		if eventID == "" {
+			return
+		}
+		outputs := c.support.eventOutputs[eventID]
+		for key, observed := range baseline {
+			candidate, ok := outputs[key]
+			if !ok {
+				continue
+			}
+			parts[key] = append(parts[key], c.b.subtract(candidate, c.b.constant(observed)))
+		}
+	}
+	for _, contribution := range hit.StatContributions {
+		add(contribution.ModifierEvalEventID, contribution.Values)
+	}
+	for _, contribution := range hit.AttackMods {
+		add(contribution.ModifierEvalEventID, contribution.Delta)
+	}
+	out := make(map[string]compiledNode, len(parts))
+	for key, values := range parts {
+		out[key] = c.b.add(values...)
+	}
+	return out
+}
+
+func (c *directCompiler) compileFlatDamage(hit info.GTTTraceHit, actor string, dynamic map[string]compiledNode) compiledNode {
+	if producer := hit.FlatProducer; producer != nil {
+		if producer.Reference.Kind == "event" && producer.Reference.EventID != nil && closeEnough(producer.Value, hit.FlatDmg) {
+			if value, ok := c.support.eventNodes[*producer.Reference.EventID]; ok && closeEnough(value.baseline, producer.Value) {
+				return value
+			}
+		}
+		c.unknown["flat_return_reference_unresolved_or_later_change"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	if hit.FlatDmg == 0 {
+		return c.b.constant(0)
+	}
+	binding, ok := c.flatBinding["hit:"+strconv.FormatUint(hit.HitID, 10)]
+	if !ok {
+		c.unknown["flat_damage_source_binding_missing"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	occurrence, ok := c.occurrence[binding.OccurrenceID]
+	if !ok {
+		c.unknown["flat_damage_source_occurrence_missing"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	template, ok := gttsource.CompactSliceTemplate(occurrence.SourceID)
+	if !ok || template.Status != "SUPPORTED" || template.TemplateSHA256 != binding.TemplateSHA256 || template.RootNodeID == nil {
+		c.unknown["flat_damage_source_template_unavailable"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	parameters := make(map[string]compiledNode, len(binding.Parameters))
+	for _, parameter := range binding.Parameters {
+		node := c.b.constant(parameter.ObservedValue)
+		if !parameter.CandidateDependencyComplete {
+			c.unknown["flat_source_parameter_dependencies_incomplete"] = struct{}{}
+		}
+		if parameter.Kind == "candidate_stat" && parameter.ActorKey != nil && parameter.StatKey != nil {
+			parameterActor, key := *parameter.ActorKey, *parameter.StatKey
+			if key == "max_hp" {
+				if parameterActor != actor {
+					c.unknown["flat_damage_external_base_hp_unproven"] = struct{}{}
+					parameters[parameter.ParameterKey] = node
+					continue
+				}
+				baseHP := hit.SnapshotStats["base_hp"]
+				values := []compiledNode{c.b.constant(parameter.ObservedValue), c.b.multiply(c.b.constant(baseHP), c.b.artifactDelta(parameterActor, "hp%")), c.b.artifactDelta(parameterActor, "hp")}
+				if parameterActor == actor {
+					if value, exists := dynamic["hp%"]; exists {
+						values = append(values, c.b.multiply(c.b.constant(baseHP), value))
+					}
+					if value, exists := dynamic["hp"]; exists {
+						values = append(values, value)
+					}
+				}
+				node = c.b.add(values...)
+			} else {
+				node = c.b.add(node, c.b.artifactDelta(parameterActor, key))
+			}
+		}
+		parameters[parameter.ParameterKey] = node
+	}
+	nodes := make(map[int]compiledNode, len(template.Nodes))
+	for _, row := range template.Nodes {
+		var node compiledNode
+		switch row.Operator {
+		case "CONST":
+			if row.ConstantValue == nil {
+				c.unknown["flat_template_constant_missing"] = struct{}{}
+				return c.b.constant(hit.FlatDmg)
+			}
+			node = c.b.constant(*row.ConstantValue)
+		case "PARAM":
+			if row.ParameterKey == nil {
+				c.unknown["flat_template_parameter_missing"] = struct{}{}
+				return c.b.constant(hit.FlatDmg)
+			}
+			node, ok = parameters[*row.ParameterKey]
+			if !ok {
+				c.unknown["flat_template_parameter_unbound"] = struct{}{}
+				return c.b.constant(hit.FlatDmg)
+			}
+		default:
+			inputs := make([]compiledNode, 0, len(row.InputNodeIDs))
+			for _, id := range row.InputNodeIDs {
+				input, exists := nodes[id]
+				if !exists {
+					c.unknown["flat_template_order_invalid"] = struct{}{}
+					return c.b.constant(hit.FlatDmg)
+				}
+				inputs = append(inputs, input)
+			}
+			switch row.Operator {
+			case "ADD":
+				node = c.b.add(inputs...)
+			case "SUB":
+				if len(inputs) != 2 {
+					return c.freezeFlat(inputs, hit.FlatDmg)
+				}
+				node = c.b.subtract(inputs[0], inputs[1])
+			case "MUL":
+				node = c.b.multiply(inputs...)
+			case "DIV":
+				if len(inputs) != 2 || inputs[1].baseline == 0 {
+					return c.freezeFlat(inputs, hit.FlatDmg)
+				}
+				node = c.b.divide(inputs[0], inputs[1])
+			case "MIN":
+				node = c.b.min(inputs...)
+			case "MAX":
+				node = c.b.max(inputs...)
+			default:
+				return c.freezeFlat(inputs, hit.FlatDmg)
+			}
+		}
+		nodes[row.NodeID] = node
+	}
+	root, ok := nodes[*template.RootNodeID]
+	// The binding observes terminal flat damage, not the original producer.
+	// compileTerminalFlat has already rewound every recorded later write; the
+	// original source must match that value. The ordered ledger and final hit
+	// checks separately validate composition back to the terminal observation.
+	if !ok || !closeEnough(root.baseline, hit.FlatDmg) {
+		c.unknown["flat_template_baseline_mismatch"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	return root
+}
+
+func (c *directCompiler) freezeFlat(inputs []compiledNode, observed float64) compiledNode {
+	if hasCoordinates(inputs) {
+		c.unknown["flat_template_operator_unresolved"] = struct{}{}
+	}
+	return c.b.constant(observed)
+}
+
+func artifactVariableStat(key string) bool {
+	switch key {
+	case "atk", "atk%", "hp", "hp%", "def", "def%", "em", "cr", "cd", "dmg%", "heal", "er",
+		"pyro%", "hydro%", "cryo%", "electro%", "anemo%", "geo%", "dendro%", "phys%":
+		return true
+	default:
+		return false
+	}
+}
+
+func expectedFallbackDamage(hit info.GTTTraceHit) float64 {
+	if expected, ok := observedExpectedDamage(hit); ok {
+		return expected
+	}
+	if hit.UncappedDamage != 0 {
+		return hit.UncappedDamage
+	}
+	return hit.ReportedDamage
+}
+
+func observedExpectedDamage(hit info.GTTTraceHit) (float64, bool) {
+	if hit.ContributorGroup != nil {
+		return observedContributorExpected(hit)
+	}
+	if !hit.Completeness.FormulaComplete {
+		return 0, false
+	}
+	actual := 1.0
+	if hit.IsCrit {
+		actual += hit.CritDamage
+	}
+	expected := 1 + math.Min(1, math.Max(0, hit.RawCritRate))*hit.CritDamage
+	if hit.HitWeakPoint {
+		expected = 1 + hit.CritDamage
+	}
+	if actual <= 0 || expected < 0 {
+		return 0, false
+	}
+	value := hit.UncappedDamage / actual * expected
+	return value, value >= 0 && !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func normalizeToken(value, fallback string) string {
+	value = normalizeCoordinate("x", value)
+	value = value[2:]
+	if value == "" {
+		return fallback
+	}
+	return value
+}
+
+func sortedKeys[V any](values map[string]V) []string {
+	out := make([]string, 0, len(values))
+	for key := range values {
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/pkg/gttcompact/effect_input.go b/pkg/gttcompact/effect_input.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/effect_input.go
@@ -0,0 +1,43 @@
+package gttcompact
+
+// Observer annotation only; does NOT alter IR arithmetic or expose proof.
+// Node IDs are usable only with the exact graph of this capture, not by label
+// or float equality. Duplicate/ambiguous ports are rejected rather than guessed.
+import (
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"strconv"
+	"strings"
+)
+
+type EffectInput struct {
+	EventID   string `json:"event_id"`
+	NodeID    uint32 `json:"node_id"`
+	Kind      string `json:"kind"`
+	Owner     string `json:"owner"`
+	AttackTag string `json:"attack_tag"`
+	Observed  string `json:"observed"`
+}
+
+func collectEffectInputs(buffer optstats.GTTTraceEquationBuffer, owners []string, support supportProgram) []EffectInput {
+	out := []EffectInput{}
+	for _, event := range buffer.StateEvents {
+		if event.Channel == nil || !strings.HasPrefix(*event.Channel, "effect_input:") || event.OwnerIndex == nil || *event.OwnerIndex < 0 || *event.OwnerIndex >= len(owners) || event.Value == nil {
+			continue
+		}
+		node, ok := support.eventNodes[event.EventID]
+		if !ok || !closeEnough(node.baseline, *event.Value) {
+			continue
+		}
+		tag := ""
+		for _, field := range event.NumericPayload {
+			if field.Key == "attack_tag" && field.Value >= 0 && field.Value == float64(int(field.Value)) {
+				tag = "tag/" + strconv.Itoa(int(field.Value))
+			}
+		}
+		if tag == "" {
+			continue
+		}
+		out = append(out, EffectInput{event.EventID, node.id, strings.TrimPrefix(*event.Channel, "effect_input:"), owners[*event.OwnerIndex], tag, decimal(*event.Value)})
+	}
+	return out
+}
diff --git a/pkg/gttcompact/effect_input_test.go b/pkg/gttcompact/effect_input_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/effect_input_test.go
@@ -0,0 +1,42 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"testing"
+)
+
+func TestEffectInputUsesActualOwnerAndExactEventBinding(t *testing.T) {
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	id := r.RecordEffectRead("", "reaction_bonus", 0, 31, "literal", nil, 0, gtttrace.IncompleteEvidence("synthetic"))
+	b := &nodeBuilder{}
+	n := b.constant(0)
+	buffer := optstats.GTTTraceEquationBuffer{StateEvents: r.StateEvents()}
+	support := supportProgram{eventNodes: map[string]compiledNode{id: n}}
+	got := collectEffectInputs(buffer, []string{"actual_owner", "display_actor"}, support)
+	if len(got) != 1 || got[0].Owner != "actual_owner" || got[0].NodeID != n.id || got[0].AttackTag != "tag/31" {
+		t.Fatal(got)
+	}
+	support.eventNodes[id] = b.constant(1)
+	if len(collectEffectInputs(buffer, []string{"actual_owner"}, support)) != 0 {
+		t.Fatal("different observed value accepted")
+	}
+	delete(support.eventNodes, id)
+	if len(collectEffectInputs(buffer, []string{"actual_owner"}, support)) != 0 {
+		t.Fatal("missing event guessed by value")
+	}
+}
+
+func TestResistanceInputsDoNotExposeFailedFormulaNodes(t *testing.T) {
+	b := &nodeBuilder{}
+	c := directCompiler{b: b}
+	accepted := c.resistanceInput(info.GTTTraceHit{HitID: 1, TargetKey: 7, Element: "electro", Resistance: 0.1, ResMod: 0.9})
+	_ = c.resistanceInput(info.GTTTraceHit{HitID: 2, TargetKey: 8, Element: "dendro", Resistance: 0.1, ResMod: 0.9})
+	root := b.multiply(accepted, b.constant(123))
+	got := b.usedResistanceInputs([]IRChannel{{RootNodeID: root.id}})
+	if len(got) != 1 || got[0].NodeID != accepted.id || got[0].HitID != 1 || got[0].TargetKey != 7 {
+		t.Fatal(got)
+	}
+}
diff --git a/pkg/gttcompact/flat_return_test.go b/pkg/gttcompact/flat_return_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/flat_return_test.go
@@ -0,0 +1,29 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"testing"
+)
+
+func TestFlatReturnKeepsOwnerAndRejectsUnrecordedLaterAddition(t *testing.T) {
+	b := &nodeBuilder{}
+	c := &directCompiler{b: b, unknown: map[string]struct{}{}, support: supportProgram{eventNodes: map[string]compiledNode{}}}
+	c.support.eventNodes["return"] = b.add(b.constant(10), b.artifactDelta("actual_owner", "em"))
+	hit := info.GTTTraceHit{FlatDmg: 10, FlatProducer: &info.GTTFlatProducer{Value: 10, Reference: gtttrace.EventRef("return")}}
+	got := c.compileTerminalFlat(hit, "last_trigger", nil)
+	if got.baseline != 10 || len(got.coords) != 1 {
+		t.Fatal("return lost")
+	}
+	if _, ok := got.coords["actual_owner.em"]; !ok {
+		t.Fatal("ownership replaced")
+	}
+	hit.FlatDmg = 15
+	got = c.compileTerminalFlat(hit, "last_trigger", nil)
+	if got.baseline != 15 || len(got.coords) != 0 {
+		t.Fatal("unrecorded later addition ignored")
+	}
+	if _, ok := c.unknown["flat_return_reference_unresolved_or_later_change"]; !ok {
+		t.Fatal("missing boundary")
+	}
+}
