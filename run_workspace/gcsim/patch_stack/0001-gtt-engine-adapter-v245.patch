+package optimization
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gttcompact"
+)
+
+func TestEffectInputsOptInAndByteBinding(t *testing.T) {
+	r := GTTTraceEquationRequest{SchemaVersion: 1, ContextSHA256: strings.Repeat("a", 64), Seed: "71", Iterations: 1, Workers: 1}
+	r.IncludeEffectInputs = true
+	if r.validate() == nil {
+		t.Fatal("sidecar without compact mode accepted")
+	}
+	r.OutputMode = "compact_ir_v1"
+	if err := r.validate(); err != nil {
+		t.Fatal(err)
+	}
+	member := []byte("{\"seed\":\"71\"}\n")
+	digest := sha256.Sum256(member)
+	path := filepath.Join(t.TempDir(), "member.json")
+	if err := writeGTTEffectInputs(path, member, r, "config\r\n", "config\n\n", []string{"actor_b", "actor_a"}, gttcompact.Audit{}); err != nil {
+		t.Fatal(err)
+	}
+	payload, err := os.ReadFile(path + ".effects.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out GTTEffectInputs
+	if err := json.Unmarshal(payload, &out); err != nil {
+		t.Fatal(err)
+	}
+	if out.MemberContentSHA256 != hex.EncodeToString(digest[:]) || out.ContextSHA256 != r.ContextSHA256 || out.Seed != r.Seed || out.CharacterKeys[0] != "actor_b" || out.EffectInputs == nil || out.ResistanceInputs == nil {
+		t.Fatalf("sidecar binding incomplete: %+v", out)
+	}
+	if out.InputConfigSHA256 != traceTextSHA256("config\r\n") || out.SourceConfigSHA256 != traceTextSHA256("config\n\n") {
+		t.Fatal("raw and engine-resolved text hashes conflated")
+	}
+	r.IncludeEffectInputs = false
+	payload, _ = json.Marshal(r)
+	if strings.Contains(string(payload), "include_effect_inputs") {
+		t.Fatal("legacy request changed")
+	}
+}
diff --git a/pkg/optimization/gtt_trace_equation.go b/pkg/optimization/gtt_trace_equation.go
new file mode 100644
--- /dev/null
+++ b/pkg/optimization/gtt_trace_equation.go
@@ -0,0 +1,823 @@
+package optimization
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gcs/ast"
+	"github.com/genshinsim/gcsim/pkg/gcs/eval"
+	"github.com/genshinsim/gcsim/pkg/gcs/parser"
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/gttcompact"
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"github.com/genshinsim/gcsim/pkg/simulation"
+	"github.com/genshinsim/gcsim/pkg/simulator"
+)
+
+const (
+	GTTTraceEquationRequestSchemaVersion = 1
+	GTTTraceEquationOutputSchemaVersion  = 6
+)
+
+func requireJSONEOF(decoder *json.Decoder) error {
+	var extra any
+	err := decoder.Decode(&extra)
+	if errors.Is(err, io.EOF) {
+		return nil
+	}
+	if err == nil {
+		return errors.New("multiple JSON values are not allowed")
+	}
+	return err
+}
+
+func canonicalSHA256(value any) (string, error) {
+	payload, err := json.Marshal(value)
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+type GTTTraceEquationRequest struct {
+	SchemaVersion       int    `json:"schema_version"`
+	ContextSHA256       string `json:"context_sha256"`
+	Seed                string `json:"seed"`
+	Iterations          int    `json:"iterations"`
+	Workers             int    `json:"workers"`
+	IgnoreBurstEnergy   bool   `json:"ignore_burst_energy"`
+	OutputMode          string `json:"output_mode,omitempty"`
+	IncludeEffectInputs bool   `json:"include_effect_inputs,omitempty"`
+}
+
+type GTTTraceEquationOutput struct {
+	SchemaVersion            int                              `json:"schema_version"`
+	Capability               string                           `json:"capability"`
+	EngineVersion            string                           `json:"engine_version"`
+	PatchVersion             string                           `json:"patch_version"`
+	FormulaVersion           string                           `json:"formula_version"`
+	FormulaSHA256            string                           `json:"formula_sha256"`
+	ContextSHA256            string                           `json:"context_sha256"`
+	RequestSHA256            string                           `json:"request_sha256"`
+	SourceConfigSHA256       string                           `json:"source_config_sha256"`
+	CompiledActionSHA256     string                           `json:"compiled_action_sha256"`
+	TargetSHA256             string                           `json:"target_sha256"`
+	Seed                     string                           `json:"seed"`
+	DurationFrames           int                              `json:"duration_frames"`
+	CharacterKeys            []string                         `json:"character_keys"`
+	Hits                     []info.GTTTraceHit               `json:"hits"`
+	TopologyEvents           []optstats.GTTTraceTopologyEvent `json:"topology_events"`
+	Unsupported              []string                         `json:"unsupported"`
+	GuardSummary             optstats.GTTTraceGuardSummary    `json:"guard_summary"`
+	ProviderTransitions      []gtttrace.ModifierTransition    `json:"provider_transitions"`
+	SourceManifestBodySHA256 string                           `json:"source_manifest_body_sha256"`
+	SourceOccurrences        []gtttrace.SourceOccurrence      `json:"source_occurrences"`
+	SourceValueBindings      []gtttrace.SourceValueBinding    `json:"source_value_bindings"`
+	HealthOperations         []gtttrace.HealthOperation       `json:"health_operations"`
+	StateSlots               []gtttrace.StateSlot             `json:"state_slots"`
+	StateEvents              []gtttrace.StateEvent            `json:"state_events"`
+}
+
+func RunGTTTraceEquation(ctx context.Context, opts simulator.Options, requestPath string) error {
+	if strings.TrimSpace(opts.ResultSaveToPath) == "" {
+		return errors.New("gtt trace equation requires -out")
+	}
+	data, err := os.ReadFile(requestPath)
+	if err != nil {
+		return err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var request GTTTraceEquationRequest
+	if err := decoder.Decode(&request); err != nil {
+		return fmt.Errorf("gtt trace equation: decode: %w", err)
+	}
+	if err := requireJSONEOF(decoder); err != nil {
+		return err
+	}
+	if err := request.validate(); err != nil {
+		return err
+	}
+	requestSHA, err := canonicalSHA256(request)
+	if err != nil {
+		return err
+	}
+	seed, _ := strconv.ParseInt(request.Seed, 10, 64)
+
+	var inputConfig []byte
+	if request.IncludeEffectInputs {
+		inputConfig, err = os.ReadFile(opts.ConfigPath)
+		if err != nil {
+			return err
+		}
+	}
+	cfg, err := simulator.ReadConfig(opts.ConfigPath)
+	if err != nil {
+		return err
+	}
+	file := ast.NewFile()
+	p := parser.New(file, cfg)
+	simcfg, gcsl, err := p.Parse()
+	if err != nil {
+		return err
+	}
+	if err := gtt.ApplyWaveScenarioFile(opts.GTTWaveScenarioPath, simcfg); err != nil {
+		return err
+	}
+	simcfg.Settings.Iterations = 1
+	simcfg.Settings.NumberOfWorkers = 1
+	simcfg.Settings.IgnoreBurstEnergy = request.IgnoreBurstEnergy
+	simcfg.Settings.CollectStats = []string{""}
+
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	default:
+	}
+	core, err := simulation.NewCore(seed, false, simcfg)
+	if err != nil {
+		return err
+	}
+	optstats.PrepareOptimizerTraceEquation(core)
+	evaluator, err := eval.NewEvaluator(file, gcsl, core)
+	if err != nil {
+		return err
+	}
+	sim, err := simulation.New(simcfg, evaluator, core)
+	if err != nil {
+		return err
+	}
+	collector, err := optstats.OptimizerTraceEquation(core)
+	if err != nil {
+		return err
+	}
+	if _, err := sim.Run(); err != nil {
+		return err
+	}
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	default:
+	}
+	buffer := collector.Flush(core)
+	characterKeys := make([]string, len(simcfg.Characters))
+	for index, character := range simcfg.Characters {
+		characterKeys[index] = character.Base.Key.String()
+	}
+	if err := validateGTTTraceEquationBuffer(buffer, seed, characterKeys); err != nil {
+		return err
+	}
+	if request.OutputMode == "compact_ir_v1" {
+		member, audit, err := gttcompact.CompileSeedMember(buffer, characterKeys)
+		if err != nil {
+			return fmt.Errorf("gtt compact equation: %w", err)
+		}
+		payload, err := json.Marshal(member)
+		if err != nil {
+			return fmt.Errorf("gtt compact equation: encode output: %w", err)
+		}
+		payload = append(payload, '\n')
+		if request.IncludeEffectInputs {
+			if err := writeGTTEffectInputs(opts.ResultSaveToPath, payload, request, string(inputConfig), cfg, characterKeys, audit); err != nil {
+				return err
+			}
+		}
+		if err := os.WriteFile(opts.ResultSaveToPath, payload, 0o644); err != nil {
+			return fmt.Errorf("gtt compact equation: write output: %w", err)
+		}
+		if os.Getenv("GTT_COMPACT_AUDIT") == "1" {
+			auditPayload, _ := json.Marshal(audit)
+			fmt.Fprintln(os.Stderr, string(auditPayload))
+		}
+		return nil
+	}
+
+	targetSHA, err := canonicalSHA256(struct {
+		Targets []info.EnemyProfile   `json:"targets"`
+		Waves   [][]info.EnemyProfile `json:"sequential_waves"`
+	}{simcfg.Targets, simcfg.GTTSequentialWaveScenario})
+	if err != nil {
+		return err
+	}
+	engineVersion := strings.TrimSpace(simulator.Version())
+	if engineVersion == "" {
+		engineVersion = "unversioned-local-build"
+	}
+	out := GTTTraceEquationOutput{
+		SchemaVersion:            GTTTraceEquationOutputSchemaVersion,
+		Capability:               gtt.TraceEquationV6Capability,
+		EngineVersion:            engineVersion,
+		PatchVersion:             gtt.PatchVersion,
+		FormulaVersion:           info.GTTTraceFormulaVersion,
+		FormulaSHA256:            info.GTTTraceFormulaSHA256(),
+		ContextSHA256:            request.ContextSHA256,
+		RequestSHA256:            requestSHA,
+		SourceConfigSHA256:       traceTextSHA256(cfg),
+		CompiledActionSHA256:     traceTextSHA256(gcsl.String()),
+		TargetSHA256:             targetSHA,
+		Seed:                     strconv.FormatInt(buffer.Seed, 10),
+		DurationFrames:           buffer.DurationFrames,
+		CharacterKeys:            characterKeys,
+		Hits:                     buffer.Hits,
+		TopologyEvents:           buffer.TopologyEvents,
+		Unsupported:              buffer.Unsupported,
+		GuardSummary:             buffer.GuardSummary(),
+		ProviderTransitions:      buffer.ProviderTransitions,
+		SourceManifestBodySHA256: gttsource.ManifestBodySHA256(),
+		SourceOccurrences:        buffer.SourceOccurrences,
+		SourceValueBindings:      buffer.SourceValueBindings,
+		HealthOperations:         buffer.HealthOperations,
+		StateSlots:               buffer.StateSlots,
+		StateEvents:              buffer.StateEvents,
+	}
+	payload, err := json.MarshalIndent(out, "", "  ")
+	if err != nil {
+		return fmt.Errorf("gtt trace equation: encode output: %w", err)
+	}
+	payload = append(payload, '\n')
+	if err := os.WriteFile(opts.ResultSaveToPath, payload, 0o644); err != nil {
+		return fmt.Errorf("gtt trace equation: write output: %w", err)
+	}
+	return nil
+}
+
+func (r GTTTraceEquationRequest) validate() error {
+	if r.SchemaVersion != GTTTraceEquationRequestSchemaVersion {
+		return errors.New("gtt trace equation: schema_version must be 1")
+	}
+	if len(r.ContextSHA256) != sha256.Size*2 {
+		return errors.New("gtt trace equation: invalid context_sha256")
+	}
+	if _, err := hex.DecodeString(r.ContextSHA256); err != nil || strings.ToLower(r.ContextSHA256) != r.ContextSHA256 {
+		return errors.New("gtt trace equation: invalid context_sha256")
+	}
+	seed, err := strconv.ParseInt(r.Seed, 10, 64)
+	if err != nil || seed <= 0 || strconv.FormatInt(seed, 10) != r.Seed {
+		return errors.New("gtt trace equation: seed must be a canonical positive int64 string")
+	}
+	if r.Iterations != 1 || r.Workers != 1 {
+		return errors.New("gtt trace equation: iterations and workers must both equal 1")
+	}
+	if r.OutputMode != "" && r.OutputMode != "compact_ir_v1" {
+		return errors.New("gtt trace equation: unsupported output_mode")
+	}
+	if r.IncludeEffectInputs && r.OutputMode != "compact_ir_v1" {
+		return errors.New("gtt effect inputs require compact_ir_v1 output")
+	}
+	return nil
+}
+
+func validateGTTTraceEquationBuffer(buffer optstats.GTTTraceEquationBuffer, seed int64, characterKeys []string) error {
+	if buffer.Seed != seed {
+		return errors.New("gtt trace equation: simulation seed mismatch")
+	}
+	if buffer.DurationFrames <= 0 {
+		return errors.New("gtt trace equation: non-positive duration")
+	}
+	if len(buffer.Hits) == 0 {
+		return errors.New("gtt trace equation: no enemy damage hits captured")
+	}
+	for index, hit := range buffer.Hits {
+		if hit.HitID != uint64(index+1) || hit.AttackID == 0 {
+			return errors.New("gtt trace equation: unstable hit identity")
+		}
+		switch hit.FormulaKind {
+		case info.GTTTraceFormulaStandard, info.GTTTraceFormulaDirectReaction, info.GTTTraceFormulaDirectLunar, info.GTTTraceFormulaOpaqueCustom:
+		default:
+			return fmt.Errorf("gtt trace equation: invalid formula_kind %q", hit.FormulaKind)
+		}
+		if len(hit.FormulaSHA256) != sha256.Size*2 {
+			return errors.New("gtt trace equation: missing formula_sha256")
+		}
+		if hit.FormulaSHA256 != info.GTTTraceFormulaSHA256() {
+			return errors.New("gtt trace equation: formula_sha256 drift")
+		}
+		if err := validateGTTTraceProvider(hit.Provider); err != nil {
+			return fmt.Errorf("gtt trace equation: hit %d provider: %w", index, err)
+		}
+		if err := validateGTTTraceReactionFormula(hit); err != nil {
+			return fmt.Errorf("gtt trace equation: hit %d reaction formula: %w", index, err)
+		}
+		if hit.StatContributions == nil || hit.CallbackAttempts == nil ||
+			hit.TargetModContributions == nil || hit.ReactionBonusContributions == nil ||
+			hit.AttackMods == nil {
+			return fmt.Errorf("gtt trace equation: hit %d has null provider evidence", index)
+		}
+		for _, row := range hit.StatContributions {
+			if strings.TrimSpace(row.ModifierKey) == "" || row.RecipientIndex < 0 || row.Values == nil {
+				return fmt.Errorf("gtt trace equation: hit %d invalid stat contribution", index)
+			}
+			if err := validateGTTTraceProvider(row.Provider); err != nil {
+				return fmt.Errorf("gtt trace equation: hit %d stat provider: %w", index, err)
+			}
+			for key, value := range row.Values {
+				if strings.TrimSpace(key) == "" || !gttTraceFinite(value) {
+					return fmt.Errorf("gtt trace equation: hit %d invalid stat value", index)
+				}
+			}
+		}
+		for _, row := range hit.CallbackAttempts {
+			if strings.TrimSpace(row.HookKey) == "" || row.SnapshotDelta == nil {
+				return fmt.Errorf("gtt trace equation: hit %d invalid callback attempt", index)
+			}
+			if err := validateGTTTraceProvider(row.Provider); err != nil {
+				return fmt.Errorf("gtt trace equation: hit %d callback provider: %w", index, err)
+			}
+			for key, value := range row.SnapshotDelta {
+				if strings.TrimSpace(key) == "" || !gttTraceFinite(value) {
+					return fmt.Errorf("gtt trace equation: hit %d invalid callback delta", index)
+				}
+			}
+			for _, value := range []float64{
+				row.MultDelta, row.FlatDmgDelta, row.BaseDmgBonusDelta,
+				row.ElevationDelta, row.IgnoreDefDelta, row.AmpMultiplierDelta,
+			} {
+				if !gttTraceFinite(value) {
+					return fmt.Errorf("gtt trace equation: hit %d non-finite callback delta", index)
+				}
+			}
+		}
+		for _, row := range hit.TargetModContributions {
+			if strings.TrimSpace(row.Channel) == "" || strings.TrimSpace(row.ModifierKey) == "" || !gttTraceFinite(row.Value) {
+				return fmt.Errorf("gtt trace equation: hit %d invalid target modifier", index)
+			}
+			if err := validateGTTTraceProvider(row.Provider); err != nil {
+				return fmt.Errorf("gtt trace equation: hit %d target provider: %w", index, err)
+			}
+		}
+		for _, row := range hit.ReactionBonusContributions {
+			if strings.TrimSpace(row.ModifierKey) == "" || !gttTraceFinite(row.Value) {
+				return fmt.Errorf("gtt trace equation: hit %d invalid reaction bonus", index)
+			}
+			if err := validateGTTTraceProvider(row.Provider); err != nil {
+				return fmt.Errorf("gtt trace equation: hit %d reaction provider: %w", index, err)
+			}
+		}
+		for _, row := range hit.AttackMods {
+			if strings.TrimSpace(row.ModifierKey) == "" || row.Delta == nil {
+				return fmt.Errorf("gtt trace equation: hit %d invalid attack mod", index)
+			}
+			if err := validateGTTTraceProvider(row.Provider); err != nil {
+				return fmt.Errorf("gtt trace equation: hit %d attack-mod provider: %w", index, err)
+			}
+			if row.SourceKey != row.Provider.Kind+":"+row.Provider.Key || row.OwnerIndex != row.Provider.OwnerIndex {
+				return fmt.Errorf("gtt trace equation: hit %d attack-mod identity mismatch", index)
+			}
+			for key, value := range row.Delta {
+				if strings.TrimSpace(key) == "" || !gttTraceFinite(value) {
+					return fmt.Errorf("gtt trace equation: hit %d invalid attack-mod delta", index)
+				}
+			}
+			if (row.BeforeDamage != nil && !gttTraceFinite(*row.BeforeDamage)) ||
+				(row.AfterDamage != nil && !gttTraceFinite(*row.AfterDamage)) {
+				return fmt.Errorf("gtt trace equation: hit %d non-finite attack-mod damage", index)
+			}
+		}
+	}
+	for index, row := range buffer.ProviderTransitions {
+		if strings.TrimSpace(row.Channel) == "" || strings.TrimSpace(row.ModifierKey) == "" ||
+			row.RecipientIndex < -1 {
+			return fmt.Errorf("gtt trace equation: invalid provider transition %d", index)
+		}
+		if err := validateGTTTraceProvider(row.Provider); err != nil {
+			return fmt.Errorf("gtt trace equation: transition %d provider: %w", index, err)
+		}
+		if row.DisplacedProvider != nil {
+			if err := validateGTTTraceProvider(*row.DisplacedProvider); err != nil {
+				return fmt.Errorf("gtt trace equation: transition %d displaced provider: %w", index, err)
+			}
+		}
+	}
+	if err := validateGTTSourceRows(buffer); err != nil {
+		return err
+	}
+	if err := validateGTTHealthOperations(buffer, characterKeys); err != nil {
+		return err
+	}
+	if err := validateGTTStateRows(buffer, characterKeys); err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateGTTHealthOperations(buffer optstats.GTTTraceEquationBuffer, characterKeys []string) error {
+	return validateGTTHealthOperationsWithSourceLookup(
+		buffer,
+		characterKeys,
+		func(sourceID string) bool { return gttsource.TemplateSHA256(sourceID) != "" },
+	)
+}
+
+func validateGTTHealthOperationsWithSourceLookup(
+	buffer optstats.GTTTraceEquationBuffer,
+	characterKeys []string,
+	sourceKnown func(string) bool,
+) error {
+	if buffer.HealthOperations == nil {
+		return errors.New("gtt trace equation: null health_operations")
+	}
+	characterCount := len(characterKeys)
+	if characterCount <= 0 {
+		return errors.New("gtt trace equation: invalid health character catalog")
+	}
+	if sourceKnown == nil {
+		return errors.New("gtt trace equation: missing health source catalog")
+	}
+	occurrences := make(map[string]gtttrace.SourceOccurrence, len(buffer.SourceOccurrences))
+	for _, occurrence := range buffer.SourceOccurrences {
+		occurrences[occurrence.OccurrenceID] = occurrence
+	}
+	lastFrame := -1
+	for index, row := range buffer.HealthOperations {
+		if row.SequenceIndex != index || row.OperationID != "health-operation:"+strconv.Itoa(index) ||
+			row.Frame < 0 || row.Frame < lastFrame || row.TargetIndex < 0 || row.TargetIndex >= characterCount ||
+			row.ModifierContributions == nil || row.UncertaintyCodes == nil {
+			return fmt.Errorf("gtt trace equation: invalid health operation %d", index)
+		}
+		if err := validateGTTHealthProvider(row.Provider, characterKeys); err != nil {
+			return fmt.Errorf("gtt trace equation: health operation %d provider: %w", index, err)
+		}
+		if row.ParentOccurrenceID != nil {
+			occurrence, ok := occurrences[*row.ParentOccurrenceID]
+			if !ok || occurrence.Frame > row.Frame {
+				return fmt.Errorf("gtt trace equation: health operation %d missing parent occurrence", index)
+			}
+		}
+		if row.CallerIndex != nil && (*row.CallerIndex < 0 || *row.CallerIndex >= characterCount) {
+			return fmt.Errorf("gtt trace equation: health operation %d invalid caller", index)
+		}
+		for _, value := range []float64{
+			row.InputValue, row.AdjustedInputValue, row.RawAmount, row.EventAmount,
+			row.EventEffectiveAmount, row.HPDeltaMagnitude, row.HPDebtBefore,
+			row.HPDebtAfter, row.MaxHPBefore, row.MaxHPAfter, row.HPBefore,
+			row.HPAfter, row.HPRatioBefore, row.HPRatioAfter,
+		} {
+			if !gttTraceFinite(value) {
+				return fmt.Errorf("gtt trace equation: health operation %d non-finite value", index)
+			}
+		}
+		if row.InputValue < 0 || row.AdjustedInputValue < 0 || row.RawAmount < 0 ||
+			row.EventAmount < 0 || row.EventEffectiveAmount < 0 ||
+			row.MaxHPBefore <= 0 || row.MaxHPAfter <= 0 || row.HPDebtBefore < 0 ||
+			row.HPDebtAfter < 0 || row.HPBefore < 0 || row.HPAfter < 0 || row.HPDeltaMagnitude < 0 ||
+			row.HPBefore > row.MaxHPBefore || row.HPAfter > row.MaxHPAfter ||
+			row.HPRatioBefore < 0 || row.HPRatioBefore > 1 ||
+			row.HPRatioAfter < 0 || row.HPRatioAfter > 1 ||
+			!gttTraceClose(row.HPBefore, row.HPRatioBefore*row.MaxHPBefore) ||
+			!gttTraceClose(row.HPAfter, row.HPRatioAfter*row.MaxHPAfter) ||
+			!gttTraceClose(row.HPDeltaMagnitude, math.Abs(row.HPAfter-row.HPBefore)) {
+			return fmt.Errorf("gtt trace equation: health operation %d invalid HP ledger", index)
+		}
+		previousCode := ""
+		for codeIndex, code := range row.UncertaintyCodes {
+			if strings.TrimSpace(code) == "" || (codeIndex > 0 && code <= previousCode) {
+				return fmt.Errorf("gtt trace equation: health operation %d uncertainty codes not canonical", index)
+			}
+			previousCode = code
+		}
+		if row.CandidateDependencyComplete && len(row.UncertaintyCodes) != 0 {
+			return fmt.Errorf("gtt trace equation: health operation %d complete with uncertainty", index)
+		}
+		if !row.CandidateDependencyComplete && len(row.UncertaintyCodes) == 0 {
+			return fmt.Errorf("gtt trace equation: health operation %d incomplete without uncertainty", index)
+		}
+		modifierTotal := 0.0
+		for contributionIndex, contribution := range row.ModifierContributions {
+			wantID := row.OperationID + ":modifier:" + strconv.Itoa(contributionIndex)
+			if contribution.ContributionID != wantID || strings.TrimSpace(contribution.ModifierKey) == "" ||
+				!gttTraceFinite(contribution.Value) ||
+				(contribution.ExpiryFrame != -1 && contribution.ExpiryFrame <= row.Frame) {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid modifier contribution %d", index, contributionIndex)
+			}
+			if !gttTraceSHA256(contribution.SourceID) || !sourceKnown(contribution.SourceID) {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid modifier source %d", index, contributionIndex)
+			}
+			if err := validateGTTHealthProvider(contribution.Provider, characterKeys); err != nil {
+				return fmt.Errorf("gtt trace equation: health operation %d modifier provider %d: %w", index, contributionIndex, err)
+			}
+			if contribution.SourceOccurrenceID != nil {
+				occurrence, ok := occurrences[*contribution.SourceOccurrenceID]
+				if !ok || occurrence.Frame > row.Frame || occurrence.SourceID != contribution.SourceID || occurrence.Provider != contribution.Provider {
+					return fmt.Errorf("gtt trace equation: health operation %d invalid modifier occurrence %d", index, contributionIndex)
+				}
+			}
+			if row.CandidateDependencyComplete && !contribution.CandidateDependencyComplete {
+				return fmt.Errorf("gtt trace equation: health operation %d incomplete modifier dependency %d", index, contributionIndex)
+			}
+			modifierTotal += contribution.Value
+		}
+		switch row.Kind {
+		case gtttrace.HealthOperationHeal:
+			if row.HealType == nil || (*row.HealType != gtttrace.HealthHealTypeAbsolute &&
+				*row.HealType != gtttrace.HealthHealTypePercent) || row.External != nil ||
+				row.BaseAmount == nil || row.SourceBonus == nil || row.HealBonusTotal == nil ||
+				row.Overheal == nil {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid heal shape", index)
+			}
+			for _, value := range []*float64{row.BaseAmount, row.SourceBonus, row.HealBonusTotal, row.Overheal} {
+				if !gttTraceFinite(*value) {
+					return fmt.Errorf("gtt trace equation: health operation %d non-finite heal value", index)
+				}
+			}
+			expectedBase := row.AdjustedInputValue
+			if *row.HealType == gtttrace.HealthHealTypePercent {
+				expectedBase *= row.MaxHPBefore
+			}
+			if *row.BaseAmount < 0 || *row.Overheal < 0 ||
+				!gttTraceClose(row.InputValue, row.AdjustedInputValue) ||
+				!gttTraceClose(*row.BaseAmount, expectedBase) ||
+				!gttTraceClose(modifierTotal, *row.HealBonusTotal) ||
+				!gttTraceClose(row.RawAmount, *row.BaseAmount*(1+*row.SourceBonus+*row.HealBonusTotal)) ||
+				!gttTraceClose(row.EventEffectiveAmount, math.Max(row.EventAmount-*row.Overheal, 0)) {
+				return fmt.Errorf("gtt trace equation: health operation %d heal arithmetic mismatch", index)
+			}
+		case gtttrace.HealthOperationDrain:
+			if row.CallerIndex != nil || row.HealType != nil || row.External == nil ||
+				row.BaseAmount != nil || row.SourceBonus != nil || row.HealBonusTotal != nil ||
+				row.Overheal != nil || len(row.ModifierContributions) != 0 ||
+				!gttTraceClose(row.RawAmount, row.AdjustedInputValue) ||
+				!gttTraceClose(row.EventAmount, row.AdjustedInputValue) ||
+				!gttTraceClose(row.EventEffectiveAmount, row.EventAmount) {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid drain shape", index)
+			}
+		default:
+			return fmt.Errorf("gtt trace equation: health operation %d invalid kind", index)
+		}
+		lastFrame = row.Frame
+	}
+	return nil
+}
+
+func validateGTTSourceRows(buffer optstats.GTTTraceEquationBuffer) error {
+	manifestSHA256 := gttsource.ManifestBodySHA256()
+	if manifestSHA256 == "" {
+		if len(buffer.SourceOccurrences) != 0 || len(buffer.SourceValueBindings) != 0 {
+			return errors.New("gtt trace equation: source rows without manifest identity")
+		}
+		return nil
+	}
+	if !gttTraceSHA256(manifestSHA256) || buffer.SourceOccurrences == nil || buffer.SourceValueBindings == nil {
+		return errors.New("gtt trace equation: invalid source manifest or null source rows")
+	}
+	occurrences := make(map[string]int, len(buffer.SourceOccurrences))
+	lastFrame := -1
+	for index, row := range buffer.SourceOccurrences {
+		if row.SequenceIndex != index || row.OccurrenceID != "source-occurrence:"+strconv.Itoa(index) ||
+			!gttTraceSHA256(row.SourceID) || row.Frame < lastFrame {
+			return fmt.Errorf("gtt trace equation: invalid source occurrence %d", index)
+		}
+		switch row.Seam {
+		case gttsource.KindModifierAmount, gttsource.KindEventCallback,
+			gttsource.KindTaskCallback, gttsource.KindQueuedAttack:
+		default:
+			return fmt.Errorf("gtt trace equation: invalid source occurrence seam %d", index)
+		}
+		if err := validateGTTTraceProvider(row.Provider); err != nil {
+			return fmt.Errorf("gtt trace equation: source occurrence %d provider: %w", index, err)
+		}
+		if row.ParentOccurrenceID != nil {
+			parentIndex, ok := occurrences[*row.ParentOccurrenceID]
+			if !ok || parentIndex >= index {
+				return fmt.Errorf("gtt trace equation: invalid source occurrence parent %d", index)
+			}
+		}
+		occurrences[row.OccurrenceID] = index
+		lastFrame = row.Frame
+	}
+	for index, row := range buffer.SourceValueBindings {
+		if strings.TrimSpace(row.BindingID) == "" || !gttTraceSHA256(row.TemplateSHA256) ||
+			strings.TrimSpace(row.OutputKey) == "" || !gttTraceFinite(row.ObservedValue) || row.Parameters == nil {
+			return fmt.Errorf("gtt trace equation: invalid source value binding %d", index)
+		}
+		if _, ok := occurrences[row.OccurrenceID]; !ok {
+			return fmt.Errorf("gtt trace equation: missing source occurrence for binding %d", index)
+		}
+		switch row.OutputKind {
+		case "attack_mod_stat", "terminal_flat_dmg", "diagnostic_scalar":
+		default:
+			return fmt.Errorf("gtt trace equation: invalid source output kind %d", index)
+		}
+		for parameterIndex, parameter := range row.Parameters {
+			if strings.TrimSpace(parameter.ParameterKey) == "" || !gttTraceFinite(parameter.ObservedValue) ||
+				parameter.ReadFrame < 0 {
+				return fmt.Errorf("gtt trace equation: invalid source parameter %d/%d", index, parameterIndex)
+			}
+			switch parameter.Kind {
+			case "candidate_stat", "frozen_source_value", "frozen_runtime_state":
+			default:
+				return fmt.Errorf("gtt trace equation: invalid source parameter kind %d/%d", index, parameterIndex)
+			}
+			switch parameter.ReadMode {
+			case "snapshot", "live", "constant":
+			default:
+				return fmt.Errorf("gtt trace equation: invalid source read mode %d/%d", index, parameterIndex)
+			}
+		}
+	}
+	return nil
+}
+
+func gttTraceSHA256(value string) bool {
+	if len(value) != sha256.Size*2 || strings.ToLower(value) != value {
+		return false
+	}
+	_, err := hex.DecodeString(value)
+	return err == nil
+}
+
+func validateGTTTraceReactionFormula(hit info.GTTTraceHit) error {
+	receipt := hit.ReactionFormula
+	if receipt == nil {
+		return nil
+	}
+	if receipt.FormulaID != info.GTTTraceTransformativeFormulaID ||
+		receipt.FormulaSHA256 != info.GTTTraceTransformativeFormulaSHA256 {
+		return errors.New("formula identity drift")
+	}
+	if receipt.ReactionType == "" || receipt.OperatorID != "spawn_damage_attack" ||
+		hit.ReactionOperatorID != receipt.OperatorID {
+		return errors.New("invalid reaction/operator identity")
+	}
+	if receipt.ReadMode != info.GTTTraceReactionReadLive &&
+		receipt.ReadMode != info.GTTTraceReactionReadSnapshot {
+		return errors.New("read_mode must be live or snapshot")
+	}
+	switch receipt.ReadPhase {
+	case info.GTTTraceReactionReadLiveTrigger,
+		info.GTTTraceReactionReadPersistentUpdate,
+		info.GTTTraceReactionReadGadgetRupture,
+		info.GTTTraceReactionReadGadgetConversion:
+	default:
+		return errors.New("invalid read_phase")
+	}
+	if receipt.OwnerIndex != hit.ActorIndex || receipt.Level != hit.CharLevel ||
+		receipt.ReadFrame != hit.SnapshotFrame {
+		return errors.New("owner, level, or read-frame binding mismatch")
+	}
+	em, ok := hit.SnapshotStats["em"]
+	if !ok || !gttTraceClose(receipt.ElementalMastery, em) {
+		return errors.New("elemental mastery binding mismatch")
+	}
+	if receipt.Level <= 0 || receipt.ReadFrame < 0 || receipt.ChildOrdinal < 0 ||
+		receipt.ChildRole == "" || receipt.ParentAttackID == nil ||
+		*receipt.ParentAttackID == 0 || receipt.ParentTargetKey == nil {
+		return errors.New("incomplete construction lineage")
+	}
+	if !gttTraceUint64PointerEqual(hit.ParentAttackID, receipt.ParentAttackID) ||
+		!gttTraceIntPointerEqual(hit.ParentTargetKey, receipt.ParentTargetKey) {
+		return errors.New("top-level parent binding mismatch")
+	}
+	if receipt.ReactionBonusContributions == nil || receipt.AuraSourceIndices == nil {
+		return errors.New("null reaction evidence")
+	}
+	previousAuraSource := -1
+	for _, source := range receipt.AuraSourceIndices {
+		if source < 0 || source <= previousAuraSource {
+			return errors.New("aura sources must be unique and sorted")
+		}
+		previousAuraSource = source
+	}
+	bonusFromProviders := 0.0
+	for _, row := range receipt.ReactionBonusContributions {
+		if strings.TrimSpace(row.ModifierKey) == "" || !gttTraceFinite(row.Value) {
+			return errors.New("invalid construction reaction bonus")
+		}
+		bonusFromProviders += row.Value
+		if err := validateGTTTraceProvider(row.Provider); err != nil {
+			return fmt.Errorf("construction reaction provider: %w", err)
+		}
+	}
+	if !gttTraceClose(bonusFromProviders, receipt.ReactionBonus) {
+		return errors.New("construction reaction bonus rows do not sum to total")
+	}
+	if receipt.PersistentStateID != nil {
+		if strings.TrimSpace(*receipt.PersistentStateID) == "" ||
+			receipt.PersistentRevision == nil || *receipt.PersistentRevision == 0 {
+			return errors.New("invalid persistent state identity")
+		}
+	} else if receipt.PersistentRevision != nil {
+		return errors.New("persistent revision without state")
+	}
+	if receipt.GadgetID != nil {
+		if strings.TrimSpace(*receipt.GadgetID) == "" || receipt.GadgetCreatorIndex == nil ||
+			*receipt.GadgetCreatorIndex < 0 || receipt.GadgetResolutionReason == nil ||
+			strings.TrimSpace(*receipt.GadgetResolutionReason) == "" {
+			return errors.New("invalid gadget lineage")
+		}
+	} else if receipt.GadgetCreatorIndex != nil || receipt.GadgetConverterIndex != nil ||
+		receipt.GadgetResolutionReason != nil {
+		return errors.New("gadget metadata without gadget identity")
+	}
+	if receipt.GadgetConverterIndex != nil && *receipt.GadgetConverterIndex < 0 {
+		return errors.New("invalid gadget converter")
+	}
+	for _, value := range []float64{
+		receipt.LevelBase,
+		receipt.ElementalMastery,
+		receipt.EMCurveNumerator,
+		receipt.EMCurveDenominatorOffset,
+		receipt.ReactionBonus,
+		receipt.CoreDamage,
+		receipt.Coefficient,
+		receipt.ConstructedFlatDmg,
+	} {
+		if !gttTraceFinite(value) {
+			return errors.New("non-finite construction input")
+		}
+	}
+	if receipt.LevelBase <= 0 || receipt.ElementalMastery < 0 ||
+		receipt.EMCurveNumerator != 16 || receipt.EMCurveDenominatorOffset != 2000 ||
+		receipt.Coefficient <= 0 {
+		return errors.New("invalid construction coefficient")
+	}
+	coreDamage := (1 +
+		receipt.EMCurveNumerator*receipt.ElementalMastery/
+			(receipt.EMCurveDenominatorOffset+receipt.ElementalMastery) +
+		receipt.ReactionBonus) * receipt.LevelBase
+	if !gttTraceClose(coreDamage, receipt.CoreDamage) ||
+		!gttTraceClose(receipt.Coefficient*receipt.CoreDamage, receipt.ConstructedFlatDmg) {
+		return errors.New("construction arithmetic mismatch")
+	}
+	if !gttTraceClose(receipt.ConstructedFlatDmg, hit.FlatDmg) {
+		// A later runtime callback can change an otherwise valid producer value.
+		// Retain the receipt as evidence, not as a complete terminal formula.
+		marked := false
+		for _, reason := range hit.Unsupported {
+			marked = marked || reason == "transformative_reaction_formula_mismatch"
+		}
+		if !marked || hit.Completeness.FlatDmgProvenanceComplete {
+			return errors.New("unmarked reaction terminal arithmetic mismatch")
+		}
+	}
+	return nil
+}
+
+func gttTraceUint64PointerEqual(left, right *uint64) bool {
+	return (left == nil && right == nil) ||
+		(left != nil && right != nil && *left == *right)
+}
+
+func gttTraceIntPointerEqual(left, right *int) bool {
+	return (left == nil && right == nil) ||
+		(left != nil && right != nil && *left == *right)
+}
+
+func gttTraceClose(left, right float64) bool {
+	if !gttTraceFinite(left) || !gttTraceFinite(right) {
+		return false
+	}
+	scale := math.Max(1, math.Max(math.Abs(left), math.Abs(right)))
+	return math.Abs(left-right) <= 1e-10*scale
+}
+
+func validateGTTTraceProvider(provider gtttrace.Provider) error {
+	if !provider.Known {
+		if provider.OwnerIndex != -1 || provider.PieceCount != 0 {
+			return errors.New("unknown provider carries owner or piece count")
+		}
+		return nil
+	}
+	if !provider.Complete() {
+		return errors.New("known provider is incomplete")
+	}
+	return nil
+}
+
+func validateGTTHealthProvider(provider gtttrace.Provider, characterKeys []string) error {
+	if err := validateGTTTraceProvider(provider); err != nil {
+		return err
+	}
+	if !provider.Known {
+		return nil
+	}
+	if provider.OwnerIndex < 0 || provider.OwnerIndex >= len(characterKeys) {
+		return errors.New("provider owner exceeds character catalog")
+	}
+	if strings.EqualFold(provider.Kind, "character") && characterKeys[provider.OwnerIndex] != provider.Key {
+		return errors.New("character provider owner binding mismatch")
+	}
+	return nil
+}
+
+func gttTraceFinite(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func traceTextSHA256(value string) string {
+	digest := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(digest[:])
+}
diff --git a/pkg/optimization/gtt_trace_equation_health_test.go b/pkg/optimization/gtt_trace_equation_health_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/optimization/gtt_trace_equation_health_test.go
@@ -0,0 +1,123 @@
+package optimization
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func healthFloat(value float64) *float64 { return &value }
+func healthString(value string) *string  { return &value }
+func healthInt(value int) *int           { return &value }
+func healthBool(value bool) *bool        { return &value }
+
+var healthFixtureCharacterKeys = []string{"chasca", "furina"}
+
+func validateHealthFixture(buffer optstats.GTTTraceEquationBuffer) error {
+	knownSourceID := strings.Repeat("a", 64)
+	return validateGTTHealthOperationsWithSourceLookup(
+		buffer,
+		healthFixtureCharacterKeys,
+		func(sourceID string) bool { return sourceID == knownSourceID },
+	)
+}
+
+func validHealthBuffer() optstats.GTTTraceEquationBuffer {
+	provider := gtttrace.UnknownProvider("fixture", "health")
+	modifierProvider := gtttrace.UnknownProvider("fixture", "modifier")
+	sourceID := strings.Repeat("a", 64)
+	return optstats.GTTTraceEquationBuffer{HealthOperations: []gtttrace.HealthOperation{
+		{
+			SequenceIndex: 0, OperationID: "health-operation:0", Kind: gtttrace.HealthOperationHeal,
+			Frame: 10, Provider: provider, CallerIndex: healthInt(0), TargetIndex: 1,
+			HealType:   healthString(gtttrace.HealthHealTypeAbsolute),
+			InputValue: 200, AdjustedInputValue: 200,
+			BaseAmount: healthFloat(200), SourceBonus: healthFloat(0.1), HealBonusTotal: healthFloat(0.2),
+			RawAmount: 260, EventAmount: 210, EventEffectiveAmount: 200, HPDeltaMagnitude: 200,
+			Overheal: healthFloat(10), HPDebtBefore: 50, HPDebtAfter: 0,
+			MaxHPBefore: 1000, MaxHPAfter: 1000, HPBefore: 800, HPAfter: 1000,
+			HPRatioBefore: 0.8, HPRatioAfter: 1,
+			ModifierContributions: []gtttrace.HealthModifierContribution{{
+				ContributionID: "health-operation:0:modifier:0", ModifierKey: "incoming-heal",
+				SourceID: sourceID, Provider: modifierProvider, Value: 0.2, ExpiryFrame: -1,
+			}},
+			UncertaintyCodes: []string{"health_input_candidate_dependency_unbound"},
+		},
+		{
+			SequenceIndex: 1, OperationID: "health-operation:1", Kind: gtttrace.HealthOperationDrain,
+			Frame: 11, Provider: provider, TargetIndex: 1, External: healthBool(false),
+			InputValue: 400, AdjustedInputValue: 200, RawAmount: 200, EventAmount: 200,
+			EventEffectiveAmount: 200, HPDeltaMagnitude: 100,
+			HPDebtBefore: 0, HPDebtAfter: 0, MaxHPBefore: 1000, MaxHPAfter: 1000,
+			HPBefore: 100, HPAfter: 0, HPRatioBefore: 0.1, HPRatioAfter: 0,
+			ModifierContributions: []gtttrace.HealthModifierContribution{},
+			UncertaintyCodes:      []string{"health_effective_delta_unexplained"},
+		},
+	}}
+}
+
+func TestTraceEquationV6PreservesV5HealthValidation(t *testing.T) {
+	if GTTTraceEquationOutputSchemaVersion != 6 ||
+		gtt.TraceEquationV5Capability != "gtt_trace_equation_v5" ||
+		gtt.TraceEquationV6Capability != "gtt_trace_equation_v6" {
+		t.Fatal("v6 schema/capability drift")
+	}
+	buffer := validHealthBuffer()
+	if err := validateHealthFixture(buffer); err != nil {
+		t.Fatalf("valid ledger: %v", err)
+	}
+
+	broken := validHealthBuffer()
+	broken.HealthOperations[0].RawAmount++
+	if err := validateHealthFixture(broken); err == nil || !strings.Contains(err.Error(), "arithmetic mismatch") {
+		t.Fatalf("raw mismatch error = %v", err)
+	}
+
+	broken = validHealthBuffer()
+	broken.HealthOperations[0].ModifierContributions[0].ContributionID = "duplicate"
+	if err := validateHealthFixture(broken); err == nil || !strings.Contains(err.Error(), "modifier contribution") {
+		t.Fatalf("contribution identity error = %v", err)
+	}
+
+	broken = validHealthBuffer()
+	broken.HealthOperations = nil
+	if err := validateHealthFixture(broken); err == nil || !strings.Contains(err.Error(), "null health_operations") {
+		t.Fatalf("null ledger error = %v", err)
+	}
+
+	invalidCases := map[string]func(*optstats.GTTTraceEquationBuffer){
+		"missing source identity": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].ModifierContributions[0].SourceID = ""
+		},
+		"unknown source identity": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].ModifierContributions[0].SourceID = strings.Repeat("b", 64)
+		},
+		"expired contribution": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].ModifierContributions[0].ExpiryFrame = 10
+		},
+		"missing uncertainty": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].UncertaintyCodes = []string{}
+		},
+		"bad character index": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].TargetIndex = 2
+		},
+		"mismatched character provider": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].Provider = gtttrace.NewProvider("character", "chasca", 1, 0)
+		},
+		"bad percent base": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].HealType = healthString(gtttrace.HealthHealTypePercent)
+		},
+	}
+	for name, mutate := range invalidCases {
+		t.Run(name, func(t *testing.T) {
+			broken := validHealthBuffer()
+			mutate(&broken)
+			if err := validateHealthFixture(broken); err == nil {
+				t.Fatal("invalid health ledger was accepted")
+			}
+		})
+	}
+}
diff --git a/pkg/optimization/gtt_trace_equation_state.go b/pkg/optimization/gtt_trace_equation_state.go
new file mode 100644
--- /dev/null
+++ b/pkg/optimization/gtt_trace_equation_state.go
@@ -0,0 +1,773 @@
+package optimization
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+type gttStateValidation struct {
+	events         map[string]gtttrace.StateEvent
+	slots          map[string]gtttrace.StateSlot
+	slotValues     map[string]float64
+	health         map[string]gtttrace.HealthOperation
+	occurrences    map[string]gtttrace.SourceOccurrence
+	tasks          map[string]gtttrace.StateEvent
+	taskEnters     map[string]gtttrace.StateEvent
+	openCalls      map[string]string
+	queueLastRun   map[string][2]int
+	executedTasks  map[string]bool
+	characterKeys  []string
+	durationFrames int
+}
+
+func validateGTTStateRows(buffer optstats.GTTTraceEquationBuffer, characterKeys []string) error {
+	if buffer.StateSlots == nil || buffer.StateEvents == nil {
+		return errors.New("gtt trace equation: null v6 state ledger")
+	}
+	v := gttStateValidation{
+		events: make(map[string]gtttrace.StateEvent), slots: make(map[string]gtttrace.StateSlot),
+		slotValues: make(map[string]float64), health: make(map[string]gtttrace.HealthOperation),
+		occurrences: make(map[string]gtttrace.SourceOccurrence), tasks: make(map[string]gtttrace.StateEvent),
+		taskEnters: make(map[string]gtttrace.StateEvent), openCalls: make(map[string]string),
+		queueLastRun:  make(map[string][2]int),
+		executedTasks: make(map[string]bool), characterKeys: characterKeys,
+		durationFrames: buffer.DurationFrames,
+	}
+	for _, row := range buffer.HealthOperations {
+		v.health[row.OperationID] = row
+	}
+	for _, row := range buffer.SourceOccurrences {
+		v.occurrences[row.OccurrenceID] = row
+	}
+	for index, row := range buffer.StateSlots {
+		if row.SequenceIndex != index || row.SlotID != "state-slot:"+strconv.Itoa(index) ||
+			strings.TrimSpace(row.Scope) == "" || strings.TrimSpace(row.SlotKey) == "" ||
+			!gttTraceFinite(row.InitialValue) || strings.TrimSpace(row.RegistrationEventID) == "" ||
+			row.Authoritative {
+			return fmt.Errorf("gtt trace equation: invalid state slot %d", index)
+		}
+		if err := validateGTTTraceProvider(row.Provider); err != nil {
+			return fmt.Errorf("gtt trace equation: state slot %d provider: %w", index, err)
+		}
+		if err := validateGTTDependencyEvidence(row.CandidateDependencyComplete, row.UncertaintyCodes); err != nil {
+			return fmt.Errorf("gtt trace equation: state slot %d evidence: %w", index, err)
+		}
+		if _, exists := v.slots[row.SlotID]; exists {
+			return fmt.Errorf("gtt trace equation: duplicate state slot %d", index)
+		}
+		v.slots[row.SlotID] = row
+		v.slotValues[row.SlotID] = row.InitialValue
+	}
+	lastFrame := -1
+	for index, row := range buffer.StateEvents {
+		if row.SequenceIndex != index || row.EventID != "state-event:"+strconv.Itoa(index) ||
+			row.Frame < 0 || row.Frame < lastFrame || row.Authoritative || row.Inputs == nil ||
+			row.ModifierEvalIDs == nil || row.Parameters == nil || row.NumericPayload == nil || row.Output == nil {
+			return fmt.Errorf("gtt trace equation: invalid state event %d", index)
+		}
+		if err := validateGTTTraceProvider(row.Provider); err != nil {
+			return fmt.Errorf("gtt trace equation: state event %d provider: %w", index, err)
+		}
+		if err := validateGTTDependencyEvidence(row.CandidateDependencyComplete, row.UncertaintyCodes); err != nil {
+			return fmt.Errorf("gtt trace equation: state event %d evidence: %w", index, err)
+		}
+		if row.SourceID != nil {
+			if !gttTraceSHA256(*row.SourceID) || gttsource.TemplateSHA256(*row.SourceID) == "" {
+				return fmt.Errorf("gtt trace equation: state event %d unknown source", index)
+			}
+		}
+		if row.SourceOccurrenceID != nil {
+			occurrence, ok := v.occurrences[*row.SourceOccurrenceID]
+			if !ok || occurrence.Frame > row.Frame || row.SourceID == nil || occurrence.SourceID != *row.SourceID ||
+				occurrence.Provider != row.Provider {
+				return fmt.Errorf("gtt trace equation: state event %d invalid source occurrence", index)
+			}
+		}
+		if row.ParentEventID != nil {
+			if _, ok := v.events[*row.ParentEventID]; !ok {
+				return fmt.Errorf("gtt trace equation: state event %d invalid parent", index)
+			}
+		}
+		if row.HealthOperationID != nil {
+			if _, ok := v.health[*row.HealthOperationID]; !ok {
+				return fmt.Errorf("gtt trace equation: state event %d invalid health operation", index)
+			}
+		}
+		for _, value := range []*float64{row.Before, row.Value, row.After} {
+			if value != nil && !gttTraceFinite(*value) {
+				return fmt.Errorf("gtt trace equation: state event %d non-finite scalar", index)
+			}
+		}
+		for key, value := range row.Output {
+			if strings.TrimSpace(key) == "" || !gttTraceFinite(value) {
+				return fmt.Errorf("gtt trace equation: state event %d invalid output", index)
+			}
+		}
+		if err := v.validateParameters(row); err != nil {
+			return fmt.Errorf("gtt trace equation: state event %d parameters: %w", index, err)
+		}
+		inputs, err := v.resolveRefs(row.Inputs, index)
+		if err != nil {
+			return err
+		}
+		if row.CandidateDependencyComplete {
+			if err := v.validateCompleteDependencies(row); err != nil {
+				return fmt.Errorf("gtt trace equation: state event %d complete dependency: %w", index, err)
+			}
+		}
+		if err := v.validateEventShapeAndArithmetic(row, inputs); err != nil {
+			return fmt.Errorf("gtt trace equation: state event %d: %w", index, err)
+		}
+		v.events[row.EventID] = row
+		lastFrame = row.Frame
+	}
+	for _, slot := range v.slots {
+		row, ok := v.events[slot.RegistrationEventID]
+		if !ok || row.Kind != gtttrace.StateEventSlotRegister || row.SlotID == nil || *row.SlotID != slot.SlotID ||
+			row.Value == nil || !gttTraceClose(*row.Value, slot.InitialValue) || row.Provider != slot.Provider {
+			return fmt.Errorf("gtt trace equation: invalid registration for %s", slot.SlotID)
+		}
+	}
+	if len(v.openCalls) != 0 || len(v.taskEnters) != 0 {
+		return errors.New("gtt trace equation: unclosed state scope")
+	}
+	for taskID, enqueue := range v.tasks {
+		if enqueue.CandidateDependencyComplete && enqueue.ExecuteByFrame != nil &&
+			*enqueue.ExecuteByFrame <= v.durationFrames && !v.executedTasks[taskID] {
+			return fmt.Errorf("gtt trace equation: complete due task %s was not executed", taskID)
+		}
+	}
+	return nil
+}
+
+func validateGTTDependencyEvidence(complete bool, codes []string) error {
+	if codes == nil {
+		return errors.New("null uncertainty codes")
+	}
+	previous := ""
+	for index, code := range codes {
+		if strings.TrimSpace(code) == "" || (index > 0 && code <= previous) {
+			return errors.New("uncertainty codes not sorted and unique")
+		}
+		previous = code
+	}
+	if complete && len(codes) != 0 {
+		return errors.New("complete evidence has uncertainty")
+	}
+	if !complete && len(codes) == 0 {
+		return errors.New("incomplete evidence lacks uncertainty")
+	}
+	return nil
+}
+
+func (v *gttStateValidation) validateParameters(row gtttrace.StateEvent) error {
+	if len(row.Parameters) > 0 && row.TemplateSHA256 == nil {
+		return errors.New("parameters without template")
+	}
+	if row.TemplateSHA256 != nil && (row.SourceID == nil || gttsource.TemplateSHA256(*row.SourceID) != *row.TemplateSHA256) {
+		return errors.New("template/source mismatch")
+	}
+	for _, parameter := range row.Parameters {
+		if strings.TrimSpace(parameter.ParameterKey) == "" || !gttTraceFinite(parameter.ObservedValue) || parameter.ReadFrame < 0 {
+			return errors.New("invalid parameter scalar")
+		}
+		switch parameter.Kind {
+		case "candidate_stat", "frozen_source_value", "frozen_runtime_state":
+		default:
+			return errors.New("invalid parameter kind")
+		}
+		switch parameter.ReadMode {
+		case "snapshot", "live", "constant":
+		default:
+			return errors.New("invalid parameter read mode")
+		}
+		if parameter.ActorIndex != nil {
+			if *parameter.ActorIndex < 0 || *parameter.ActorIndex >= len(v.characterKeys) {
+				return errors.New("parameter actor outside catalog")
+			}
+			if parameter.ActorKey != nil && *parameter.ActorKey != v.characterKeys[*parameter.ActorIndex] {
+				return errors.New("parameter actor key mismatch")
+			}
+		} else if parameter.ActorKey != nil {
+			return errors.New("parameter actor key without index")
+		}
+		if parameter.Kind == "candidate_stat" &&
+			(parameter.ActorIndex == nil || parameter.ActorKey == nil || parameter.StatKey == nil || strings.TrimSpace(*parameter.StatKey) == "") {
+			return errors.New("candidate stat parameter incomplete")
+		}
+	}
+	return nil
+}
+
+func (v *gttStateValidation) resolveRefs(refs []gtttrace.NumericRef, eventIndex int) ([]float64, error) {
+	out := make([]float64, 0, len(refs))
+	for refIndex, ref := range refs {
+		value, err := v.resolveRef(ref)
+		if err != nil {
+			return nil, fmt.Errorf("gtt trace equation: state event %d input %d: %w", eventIndex, refIndex, err)
+		}
+		out = append(out, value)
+	}
+	return out, nil
+}
+
+func (v *gttStateValidation) resolveRef(ref gtttrace.NumericRef) (float64, error) {
+	switch ref.Kind {
+	case "event":
+		if ref.EventID == nil || ref.HealthOperationID != nil || ref.LiteralValue != nil {
+			return 0, errors.New("invalid event ref shape")
+		}
+		row, ok := v.events[*ref.EventID]
+		if !ok {
+			return 0, errors.New("event ref is not prior")
+		}
+		if ref.FieldKey != nil {
+			value, ok := row.Output[*ref.FieldKey]
+			if !ok {
+				return 0, errors.New("event output selector missing")
+			}
+			return value, nil
+		}
+		if row.Value == nil {
+			return 0, errors.New("event ref has no scalar value")
+		}
+		return *row.Value, nil
+	case "literal":
+		if ref.LiteralValue == nil || ref.EventID != nil || ref.HealthOperationID != nil || ref.FieldKey != nil || !gttTraceFinite(*ref.LiteralValue) {
+			return 0, errors.New("invalid literal ref shape")
+		}
+		return *ref.LiteralValue, nil
+	case "health_field":
+		if ref.HealthOperationID == nil || ref.FieldKey == nil || ref.EventID != nil || ref.LiteralValue != nil {
+			return 0, errors.New("invalid health field ref shape")
+		}
+		row, ok := v.health[*ref.HealthOperationID]
+		if !ok {
+			return 0, errors.New("unknown health field operation")
+		}
+		return healthFieldValue(row, *ref.FieldKey)
+	default:
+		return 0, errors.New("invalid numeric ref kind")
+	}
+}
+
+func healthFieldValue(row gtttrace.HealthOperation, key string) (float64, error) {
+	switch key {
+	case "input_value":
+		return row.InputValue, nil
+	case "adjusted_input_value":
+		return row.AdjustedInputValue, nil
+	case "raw_amount":
+		return row.RawAmount, nil
+	case "event_amount":
+		return row.EventAmount, nil
+	case "event_effective_amount":
+		return row.EventEffectiveAmount, nil
+	case "hp_delta_magnitude":
+		return row.HPDeltaMagnitude, nil
+	case "max_hp_before":
+		return row.MaxHPBefore, nil
+	case "max_hp_after":
+		return row.MaxHPAfter, nil
+	case "hp_before":
+		return row.HPBefore, nil
+	case "hp_after":
+		return row.HPAfter, nil
+	case "hp_ratio_before":
+		return row.HPRatioBefore, nil
+	case "hp_ratio_after":
+		return row.HPRatioAfter, nil
+	default:
+		return 0, errors.New("invalid health field key")
+	}
+}
+
+func (v *gttStateValidation) validateCompleteDependencies(row gtttrace.StateEvent) error {
+	for _, ref := range row.Inputs {
+		switch ref.Kind {
+		case "event":
+			if ref.EventID == nil || !v.events[*ref.EventID].CandidateDependencyComplete {
+				return errors.New("depends on incomplete event")
+			}
+		case "health_field":
+			if ref.HealthOperationID == nil || !v.health[*ref.HealthOperationID].CandidateDependencyComplete {
+				return errors.New("depends on incomplete health field")
+			}
+		}
+	}
+	for _, id := range row.ModifierEvalIDs {
+		dependency, ok := v.events[id]
+		if !ok || !dependency.CandidateDependencyComplete {
+			return errors.New("depends on incomplete modifier")
+		}
+	}
+	for _, payload := range row.NumericPayload {
+		if payload.Reference.Kind == "event" {
+			if payload.Reference.EventID == nil || !v.events[*payload.Reference.EventID].CandidateDependencyComplete {
+				return errors.New("task payload depends on incomplete event")
+			}
+		} else if payload.Reference.Kind == "health_field" {
+			if payload.Reference.HealthOperationID == nil || !v.health[*payload.Reference.HealthOperationID].CandidateDependencyComplete {
+				return errors.New("task payload depends on incomplete health field")
+			}
+		}
+	}
+	if row.SlotID != nil {
+		if slot, ok := v.slots[*row.SlotID]; ok && !slot.CandidateDependencyComplete {
+			return errors.New("depends on incomplete slot")
+		}
+	}
+	return nil
+}
+
+func (v *gttStateValidation) validateEventShapeAndArithmetic(row gtttrace.StateEvent, inputs []float64) error {
+	switch row.Kind {
+	case gtttrace.StateEventSlotRegister:
+		if row.SlotID == nil || row.Key == nil || row.Value == nil {
+			return errors.New("invalid slot registration shape")
+		}
+		slot, ok := v.slots[*row.SlotID]
+		if !ok || slot.SlotKey != *row.Key || !gttTraceClose(slot.InitialValue, *row.Value) {
+			return errors.New("slot registration mismatch")
+		}
+	case gtttrace.StateEventNumericStateRead:
+		if row.SlotID == nil || row.Value == nil {
+			return errors.New("invalid state read shape")
+		}
+		value, ok := v.slotValues[*row.SlotID]
+		if !ok || !gttTraceClose(value, *row.Value) {
+			return errors.New("state read ledger mismatch")
+		}
+	case gtttrace.StateEventNumericStateWrite:
+		if row.SlotID == nil || row.Before == nil || row.After == nil {
+			return errors.New("invalid state write shape")
+		}
+		value, ok := v.slotValues[*row.SlotID]
+		if !ok || !gttTraceClose(value, *row.Before) {
+			return errors.New("state write ledger mismatch")
+		}
+		v.slotValues[*row.SlotID] = *row.After
+	case gtttrace.StateEventStateResync:
+		if row.SlotID == nil || row.Before == nil || row.After == nil || row.CandidateDependencyComplete ||
+			!containsString(row.UncertaintyCodes, "state_slot_unobserved_mutation") {
+			return errors.New("invalid state resync shape")
+		}
+		value, ok := v.slotValues[*row.SlotID]
+		if !ok || !gttTraceClose(value, *row.Before) {
+			return errors.New("state resync ledger mismatch")
+		}
+		v.slotValues[*row.SlotID] = *row.After
+	case gtttrace.StateEventNumericEval:
+		if row.Operation == nil || row.Value == nil {
+			return errors.New("invalid numeric eval shape")
+		}
+		if *row.Operation == "artifact_stat_read" || *row.Operation == "frozen_attack_operand" {
+			if len(inputs) != 0 || row.CandidateDependencyComplete {
+				return errors.New("invalid observed attack input boundary")
+			}
+			if *row.Operation == "artifact_stat_read" {
+				if row.OwnerIndex == nil || *row.OwnerIndex < 0 || *row.OwnerIndex >= len(v.characterKeys) || row.Key == nil || strings.TrimSpace(*row.Key) == "" || !containsString(row.UncertaintyCodes, "stat_read_external_dependencies_incomplete") {
+					return errors.New("invalid typed artifact stat read")
+				}
+				seen := map[string]bool{}
+				for _, id := range row.ModifierEvalIDs {
+					dependency, ok := v.events[id]
+					if !ok || dependency.Kind != gtttrace.StateEventModifierEval || dependency.Channel == nil || *dependency.Channel != "stat" || dependency.OwnerIndex == nil || *dependency.OwnerIndex != *row.OwnerIndex || seen[id] {
+						return errors.New("invalid stat read modifier reference")
+					}
+					seen[id] = true
+				}
+			} else if !containsString(row.UncertaintyCodes, "attack_field_operand_dependency_frozen") {
+				return errors.New("undiagnosed frozen attack operand")
+			}
+			return nil
+		}
+		if err := validateNumericArithmetic(*row.Operation, inputs, *row.Value); err != nil {
+			return err
+		}
+		if row.CandidateDependencyComplete && (*row.Operation == "source_expression" || *row.Operation == "health_input" || *row.Operation == "task_payload" || *row.Operation == "state_transition") {
+			return errors.New("non-recomputed marker cannot be complete")
+		}
+		if row.TemplateSHA256 != nil {
+			if row.SourceID == nil || gttsource.TemplateSHA256(*row.SourceID) != *row.TemplateSHA256 {
+				return errors.New("numeric source template mismatch")
+			}
+		}
+	case gtttrace.StateEventGuardEval:
+		if row.Operation == nil || row.Result == nil {
+			return errors.New("invalid guard shape")
+		}
+		if *row.Operation == "observed" {
+			if len(inputs) != 0 || row.CandidateDependencyComplete ||
+				!containsString(row.UncertaintyCodes, "guard_operand_dependency_incomplete") {
+				return errors.New("invalid observed guard boundary")
+			}
+		} else {
+			if err := validateGuardArithmetic(*row.Operation, inputs, *row.Result); err != nil {
+				return err
+			}
+		}
+	case gtttrace.StateEventModifierEval:
+		if row.Channel == nil || row.Key == nil || row.Accepted == nil || row.ExpiryFrame == nil || row.OwnerIndex == nil {
+			return errors.New("invalid modifier eval shape")
+		}
+		if !*row.Accepted && len(row.Output) != 0 {
+			return errors.New("rejected modifier has output")
+		}
+	case gtttrace.StateEventMaxHPRead:
+		if row.OwnerIndex == nil || len(row.Output) != 4 {
+			return errors.New("invalid max hp shape")
+		}
+		baseHP, okBase := row.Output["base_hp"]
+		hpp, okHPP := row.Output["hp%"]
+		hp, okHP := row.Output["hp"]
+		maxHP, okMax := row.Output["max_hp"]
+		if !okBase || !okHPP || !okHP || !okMax || !gttTraceClose(baseHP*(1+hpp)+hp, maxHP) {
+			return errors.New("max hp arithmetic mismatch")
+		}
+		seen := make(map[string]bool)
+		for _, id := range row.ModifierEvalIDs {
+			dependency, ok := v.events[id]
+			if !ok || dependency.Kind != gtttrace.StateEventModifierEval || dependency.Channel == nil ||
+				*dependency.Channel != "stat" || dependency.OwnerIndex == nil || *dependency.OwnerIndex != *row.OwnerIndex || seen[id] {
+				return errors.New("invalid max hp modifier reference")
+			}
+			seen[id] = true
+		}
+	case gtttrace.StateEventHealthFieldBinding:
+		if row.HealthOperationID == nil || row.Key == nil || row.Value == nil || row.BoundEventID == nil {
+			return errors.New("invalid health binding shape")
+		}
+		healthValue, err := healthFieldValue(v.health[*row.HealthOperationID], *row.Key)
+		if err != nil || !gttTraceClose(healthValue, *row.Value) {
+			return errors.New("health binding value mismatch")
+		}
+		bound, ok := v.events[*row.BoundEventID]
+		if !ok {
+			return errors.New("health binding target is not prior")
+		}
+		var boundValue float64
+		if *row.Key == "max_hp_before" || *row.Key == "max_hp_after" {
+			if bound.Kind != gtttrace.StateEventMaxHPRead {
+				return errors.New("max hp field not bound to max hp read")
+			}
+			boundValue = bound.Output["max_hp"]
+		} else {
+			if bound.Kind != gtttrace.StateEventNumericEval || bound.Value == nil {
+				return errors.New("health input not bound to numeric eval")
+			}
+			boundValue = *bound.Value
+		}
+		if !gttTraceClose(boundValue, *row.Value) {
+			return errors.New("health binding target value mismatch")
+		}
+	case gtttrace.StateEventHealthContextEnter, gtttrace.StateEventCallbackEnter,
+		gtttrace.StateEventTaskExecuteEnter:
+		return v.openScope(row)
+	case gtttrace.StateEventHealthContextExit, gtttrace.StateEventCallbackExit,
+		gtttrace.StateEventTaskExecuteExit:
+		return v.closeScope(row)
+	case gtttrace.StateEventTaskEnqueue:
+		return v.recordTaskEnqueue(row)
+	case gtttrace.StateEventStatusRead:
+		return validateStatusRead(row)
+	case gtttrace.StateEventStatusAdd:
+		if row.OwnerIndex == nil || row.Key == nil || row.Before == nil || row.After == nil || row.ExpiryFrame == nil || row.Result == nil ||
+			int(*row.After) != *row.ExpiryFrame {
+			return errors.New("invalid status add shape")
+		}
+	case gtttrace.StateEventStatusDelete:
+		if row.OwnerIndex == nil || row.Key == nil || row.Before == nil || row.Result == nil || row.Accepted == nil {
+			return errors.New("invalid status delete shape")
+		}
+	default:
+		return errors.New("invalid state event kind")
+	}
+	return nil
+}
+
+func containsString(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func validateNumericArithmetic(operator string, inputs []float64, output float64) error {
+	want := output
+	switch operator {
+	case "literal":
+		if len(inputs) != 0 {
+			return errors.New("literal has inputs")
+		}
+		return nil
+	case "source_expression", "health_input", "task_payload", "state_transition":
+		return nil
+	case "identity":
+		if len(inputs) != 1 {
+			return errors.New("identity arity")
+		}
+		want = inputs[0]
+	case "add":
+		if len(inputs) == 0 {
+			return errors.New("add arity")
+		}
+		want = 0
+		for _, value := range inputs {
+			want += value
+		}
+	case "subtract", "divide":
+		if len(inputs) != 2 || (operator == "divide" && inputs[1] == 0) {
+			return errors.New(operator + " arity/domain")
+		}
+		want = inputs[0] - inputs[1]
+		if operator == "divide" {
+			want = inputs[0] / inputs[1]
+		}
+	case "multiply":
+		if len(inputs) == 0 {
+			return errors.New("multiply arity")
+		}
+		want = 1
+		for _, value := range inputs {
+			want *= value
+		}
+	case "min", "max":
+		if len(inputs) == 0 {
+			return errors.New(operator + " arity")
+		}
+		want = inputs[0]
+		for _, value := range inputs[1:] {
+			if (operator == "min" && value < want) || (operator == "max" && value > want) {
+				want = value
+			}
+		}
+	case "negate":
+		if len(inputs) != 1 {
+			return errors.New("negate arity")
+		}
+		want = -inputs[0]
+	case "select_lt":
+		if len(inputs) != 4 {
+			return errors.New("select_lt arity")
+		}
+		want = inputs[3]
+		if inputs[0] < inputs[1] {
+			want = inputs[2]
+		}
+	default:
+		return errors.New("invalid numeric operator")
+	}
+	if !gttTraceClose(want, output) {
+		return errors.New("numeric arithmetic mismatch")
+	}
+	return nil
+}
+
+func validateGuardArithmetic(operator string, inputs []float64, output bool) error {
+	want := false
+	switch operator {
+	case "eq", "ne", "lt", "lte", "gt", "gte":
+		if len(inputs) != 2 {
+			return errors.New("comparison arity")
+		}
+		switch operator {
+		case "eq":
+			want = inputs[0] == inputs[1]
+		case "ne":
+			want = inputs[0] != inputs[1]
+		case "lt":
+			want = inputs[0] < inputs[1]
+		case "lte":
+			want = inputs[0] <= inputs[1]
+		case "gt":
+			want = inputs[0] > inputs[1]
+		case "gte":
+			want = inputs[0] >= inputs[1]
+		}
+	case "and", "or":
+		if len(inputs) < 2 {
+			return errors.New("boolean arity")
+		}
+		want = operator == "and"
+		for _, value := range inputs {
+			if value != 0 && value != 1 {
+				return errors.New("boolean input domain")
+			}
+			if operator == "and" {
+				want = want && value == 1
+			} else {
+				want = want || value == 1
+			}
+		}
+	case "not":
+		if len(inputs) != 1 || (inputs[0] != 0 && inputs[0] != 1) {
+			return errors.New("not arity/domain")
+		}
+		want = inputs[0] == 0
+	default:
+		return errors.New("invalid guard operator")
+	}
+	if want != output {
+		return errors.New("guard result mismatch")
+	}
+	return nil
+}
+
+func (v *gttStateValidation) openScope(row gtttrace.StateEvent) error {
+	if row.CallID == nil || *row.CallID != row.EventID {
+		return errors.New("invalid scope enter identity")
+	}
+	if _, exists := v.openCalls[*row.CallID]; exists {
+		return errors.New("duplicate scope enter")
+	}
+	v.openCalls[*row.CallID] = row.Kind
+	if row.Kind == gtttrace.StateEventCallbackEnter && row.HealthOperationID == nil {
+		return errors.New("health callback missing operation")
+	}
+	if row.Kind == gtttrace.StateEventTaskExecuteEnter {
+		if err := v.validateTaskMetadata(row); err != nil {
+			return err
+		}
+		if _, ok := v.tasks[*row.TaskID]; !ok {
+			return errors.New("task execute without enqueue")
+		}
+		if _, duplicate := v.taskEnters[*row.TaskID]; duplicate {
+			return errors.New("duplicate task execution")
+		}
+		v.taskEnters[*row.TaskID] = row
+		pair := [2]int{*row.ExecuteByFrame, *row.QueueSequence}
+		if previous, ok := v.queueLastRun[*row.QueueID]; ok && (pair[0] < previous[0] || (pair[0] == previous[0] && pair[1] <= previous[1])) {
+			return errors.New("task heap order mismatch")
+		}
+		v.queueLastRun[*row.QueueID] = pair
+	}
+	return nil
+}
+
+func (v *gttStateValidation) closeScope(row gtttrace.StateEvent) error {
+	if row.CallID == nil || row.ParentEventID == nil || *row.ParentEventID != *row.CallID {
+		return errors.New("invalid scope exit identity")
+	}
+	enterKind, ok := v.openCalls[*row.CallID]
+	if !ok {
+		return errors.New("scope exit without enter")
+	}
+	want := map[string]string{
+		gtttrace.StateEventHealthContextExit: gtttrace.StateEventHealthContextEnter,
+		gtttrace.StateEventCallbackExit:      gtttrace.StateEventCallbackEnter,
+		gtttrace.StateEventTaskExecuteExit:   gtttrace.StateEventTaskExecuteEnter,
+	}[row.Kind]
+	if enterKind != want {
+		return errors.New("scope exit kind mismatch")
+	}
+	delete(v.openCalls, *row.CallID)
+	if row.Kind == gtttrace.StateEventTaskExecuteExit {
+		if err := v.validateTaskMetadata(row); err != nil {
+			return err
+		}
+		enter, ok := v.taskEnters[*row.TaskID]
+		if !ok || !sameTaskMetadata(enter, row) {
+			return errors.New("task execute pair mismatch")
+		}
+		delete(v.taskEnters, *row.TaskID)
+		v.executedTasks[*row.TaskID] = true
+	}
+	return nil
+}
+
+func (v *gttStateValidation) recordTaskEnqueue(row gtttrace.StateEvent) error {
+	if err := v.validateTaskMetadata(row); err != nil {
+		return err
+	}
+	if _, exists := v.tasks[*row.TaskID]; exists {
+		return errors.New("duplicate task id")
+	}
+	if *row.ExecuteByFrame != *row.EnqueueFrame+*row.DelayFrames {
+		return errors.New("task schedule arithmetic mismatch")
+	}
+	for _, payload := range row.NumericPayload {
+		if strings.TrimSpace(payload.Key) == "" || !gttTraceFinite(payload.Value) {
+			return errors.New("invalid task numeric payload")
+		}
+		value, err := v.resolveRef(payload.Reference)
+		if err != nil || !gttTraceClose(value, payload.Value) {
+			return errors.New("task numeric payload reference mismatch")
+		}
+	}
+	v.tasks[*row.TaskID] = row
+	return nil
+}
+
+func (v *gttStateValidation) validateTaskMetadata(row gtttrace.StateEvent) error {
+	if row.TaskID == nil || row.QueueID == nil || row.QueueSequence == nil || row.EnqueueFrame == nil ||
+		row.DelayFrames == nil || row.ExecuteByFrame == nil || *row.QueueSequence < 0 || *row.EnqueueFrame < 0 {
+		return errors.New("invalid task metadata")
+	}
+	enqueue, ok := v.tasks[*row.TaskID]
+	if row.Kind != gtttrace.StateEventTaskEnqueue && (!ok || !sameTaskMetadata(enqueue, row)) {
+		return errors.New("task metadata differs from enqueue")
+	}
+	if row.Kind == gtttrace.StateEventTaskEnqueue {
+		if row.Value != nil {
+			return errors.New("enqueue carries execution clock")
+		}
+	} else if row.Value == nil || *row.Value < float64(*row.ExecuteByFrame) || math.Trunc(*row.Value) != *row.Value {
+		return errors.New("task executed before due queue frame")
+	}
+	return nil
+}
+
+func sameTaskMetadata(left, right gtttrace.StateEvent) bool {
+	return left.TaskID != nil && right.TaskID != nil && *left.TaskID == *right.TaskID &&
+		left.QueueID != nil && right.QueueID != nil && *left.QueueID == *right.QueueID &&
+		left.QueueSequence != nil && right.QueueSequence != nil && *left.QueueSequence == *right.QueueSequence &&
+		left.EnqueueFrame != nil && right.EnqueueFrame != nil && *left.EnqueueFrame == *right.EnqueueFrame &&
+		left.DelayFrames != nil && right.DelayFrames != nil && *left.DelayFrames == *right.DelayFrames &&
+		left.ExecuteByFrame != nil && right.ExecuteByFrame != nil && *left.ExecuteByFrame == *right.ExecuteByFrame &&
+		reflect.DeepEqual(left.NumericPayload, right.NumericPayload)
+}
+
+func validateStatusRead(row gtttrace.StateEvent) error {
+	if row.OwnerIndex == nil || row.Key == nil || row.Operation == nil || row.ExpiryFrame == nil || row.Value == nil {
+		return errors.New("invalid status read shape")
+	}
+	switch *row.Operation {
+	case "active":
+		if row.Result == nil || (*row.Value != 0 && *row.Value != 1) || (*row.Value == 1) != *row.Result {
+			return errors.New("invalid active status value")
+		}
+		want := *row.ExpiryFrame == -1 || *row.ExpiryFrame >= row.Frame
+		if *row.ExpiryFrame == 0 {
+			want = false
+		}
+		if want != *row.Result {
+			return errors.New("status active expiry mismatch")
+		}
+	case "duration":
+		want := 0
+		if *row.ExpiryFrame > row.Frame {
+			want = *row.ExpiryFrame - row.Frame
+		}
+		if !gttTraceClose(float64(want), *row.Value) || row.Result != nil {
+			return errors.New("status duration mismatch")
+		}
+	case "expiry":
+		if !gttTraceClose(float64(*row.ExpiryFrame), *row.Value) || row.Result != nil {
+			return errors.New("status expiry mismatch")
+		}
+	default:
+		return errors.New("invalid status read mode")
+	}
+	return nil
+}
