@@ -0,0 +1,139 @@
+package character
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	playercharacter "github.com/genshinsim/gcsim/pkg/core/player/character"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/modifier"
+)
+
+type healthTestResult struct {
+	currentHP         float64
+	hpDebt            float64
+	received          float64
+	raw               float64
+	rows              []gtttrace.HealthOperation
+	legacyTransitions int
+	legacyOccurrences int
+	legacyBindings    int
+}
+
+func newHealthTestCharacter(t *testing.T, traceEnabled bool) (*core.Core, *Character) {
+	t.Helper()
+	c, err := core.New(core.Opt{Seed: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	stats := make([]float64, attributes.EndStatType)
+	stats[attributes.BaseHP] = 1000
+	wrapper, err := playercharacter.New(info.CharacterProfile{
+		Stats: stats, Talents: info.TalentProfile{Attack: 1, Skill: 1, Burst: 1},
+	}, &c.F, false, c.Log, c.Events, c.Tasks, c.GTTTrace)
+	if err != nil {
+		t.Fatal(err)
+	}
+	character := NewWithWrapper(c, wrapper)
+	wrapper.Character = character
+	c.Player.AddChar(wrapper)
+	character.SetHPByRatio(0.8)
+	character.ModifyHPDebtByAmount(50)
+	if traceEnabled {
+		c.GTTTrace.Enable()
+	}
+	return c, character
+}
+
+func runHealthTestHeal(t *testing.T, traceEnabled bool, healType info.HealType, src float64) healthTestResult {
+	t.Helper()
+	c, character := newHealthTestCharacter(t, traceEnabled)
+	provider := gtttrace.NewProvider("character", "fixture", 0, 0)
+	restore := c.GTTTrace.Enter(provider)
+	character.AddHealBonusMod(playercharacter.HealBonusMod{
+		Base: modifier.NewBase("fixture-heal-bonus", -1),
+		Amount: func() float64 {
+			return 0.2
+		},
+	})
+	received, raw := character.Heal(&info.HealInfo{
+		Caller: 0, Target: 0, Type: healType, Message: "fixture", Src: src, Bonus: 0.1,
+	})
+	restore()
+	return healthTestResult{
+		currentHP: character.CurrentHP(), hpDebt: character.CurrentHPDebt(),
+		received: received, raw: raw, rows: c.GTTTrace.HealthOperations(),
+		legacyTransitions: len(c.GTTTrace.ModifierTransitions()),
+		legacyOccurrences: len(c.GTTTrace.SourceOccurrences()),
+		legacyBindings:    len(c.GTTTrace.SourceValueBindings()),
+	}
+}
+
+func TestTraceHealthHealPreservesGameplayForAbsoluteAndPercent(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		healType info.HealType
+		src      float64
+	}{
+		{name: "absolute", healType: info.HealTypeAbsolute, src: 200},
+		{name: "percent", healType: info.HealTypePercent, src: 0.2},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			off := runHealthTestHeal(t, false, test.healType, test.src)
+			on := runHealthTestHeal(t, true, test.healType, test.src)
+			if off.currentHP != on.currentHP || off.hpDebt != on.hpDebt ||
+				off.received != on.received || off.raw != on.raw {
+				t.Fatalf("trace changed gameplay: off=%#v on=%#v", off, on)
+			}
+			if len(off.rows) != 0 || len(on.rows) != 1 {
+				t.Fatalf("health rows off=%d on=%d", len(off.rows), len(on.rows))
+			}
+			if on.legacyTransitions != 0 || on.legacyOccurrences != 0 || on.legacyBindings != 0 {
+				t.Fatalf("health trace changed inherited evidence: %#v", on)
+			}
+			row := on.rows[0]
+			if row.Kind != gtttrace.HealthOperationHeal || row.EventAmount != 210 ||
+				row.EventEffectiveAmount != 200 || row.HPDeltaMagnitude != 200 ||
+				row.Overheal == nil || *row.Overheal != 10 || row.HealBonusTotal == nil ||
+				*row.HealBonusTotal != 0.2 || row.SourceBonus == nil || *row.SourceBonus != 0.1 ||
+				len(row.ModifierContributions) != 1 || row.ModifierContributions[0].Value != 0.2 {
+				t.Fatalf("unexpected heal row: %#v", row)
+			}
+		})
+	}
+}
+
+func runHealthTestDrain(t *testing.T, traceEnabled bool) (float64, float64, []gtttrace.HealthOperation) {
+	t.Helper()
+	c, character := newHealthTestCharacter(t, traceEnabled)
+	character.SetHPByRatio(0.1)
+	c.Events.Subscribe(event.OnPlayerPreHPDrain, func(args ...any) {
+		args[0].(*info.DrainInfo).Amount *= 0.5
+	}, "gtt-trace-health-test-pre-drain")
+	provider := gtttrace.NewProvider("character", "fixture", 0, 0)
+	restore := c.GTTTrace.Enter(provider)
+	delivered := c.Player.Drain(info.DrainInfo{ActorIndex: 0, Abil: "fixture", Amount: 400})
+	restore()
+	return delivered, character.CurrentHP(), c.GTTTrace.HealthOperations()
+}
+
+func TestTraceHealthDrainPreservesGameplayAndSeparatesEventFromHPDelta(t *testing.T) {
+	offDelivered, offHP, offRows := runHealthTestDrain(t, false)
+	onDelivered, onHP, onRows := runHealthTestDrain(t, true)
+	if offDelivered != onDelivered || offHP != onHP || !reflect.DeepEqual(offRows, []gtttrace.HealthOperation{}) {
+		t.Fatalf("trace changed drain: off=%v/%v on=%v/%v", offDelivered, offHP, onDelivered, onHP)
+	}
+	if len(onRows) != 1 {
+		t.Fatalf("health rows = %d", len(onRows))
+	}
+	row := onRows[0]
+	if row.Kind != gtttrace.HealthOperationDrain || row.InputValue != 400 ||
+		row.AdjustedInputValue != 200 || row.EventAmount != 200 ||
+		row.EventEffectiveAmount != 200 || row.HPDeltaMagnitude != 100 || row.HPAfter != 0 {
+		t.Fatalf("unexpected drain row: %#v", row)
+	}
+}
