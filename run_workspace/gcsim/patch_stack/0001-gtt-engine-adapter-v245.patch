+package gtt
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+)
+
+func TestWaveDummyInitializesResistanceMap(t *testing.T) {
+	level, hp, resist := 95, 1000.0, 0.25
+	target := waveScenarioTarget{Level: &level, Type: "dummy", HP: &hp}
+	profile, err := target.enemyProfile(0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if profile.HP != hp || profile.Resist[attributes.Pyro] != 0.1 {
+		t.Fatalf("default dummy profile: %+v", profile)
+	}
+	target.Resist = &resist
+	profile, err = target.enemyProfile(1, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(profile.Resist) != 8 {
+		t.Fatalf("missing element resistances: %+v", profile.Resist)
+	}
+	for element, value := range profile.Resist {
+		if value != resist {
+			t.Fatalf("override for %v: %v", element, value)
+		}
+	}
+}
