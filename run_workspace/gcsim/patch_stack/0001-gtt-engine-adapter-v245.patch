+package optimization
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func TestPureNumericConditionalValidation(t *testing.T) {
+	for _, tc := range []struct {
+		in    []float64
+		out   float64
+		valid bool
+	}{
+		{[]float64{1, 2, 7, 8}, 7, true}, {[]float64{2, 2, 7, 8}, 8, true},
+		{[]float64{3, 2, 7, 8}, 8, true}, {[]float64{1, 2, 7}, 7, false},
+		{[]float64{1, 2, 7, 8}, 8, false},
+	} {
+		if err := validateNumericArithmetic("select_lt", tc.in, tc.out); (err == nil) != tc.valid {
+			t.Fatal(tc, err)
+		}
+	}
+}
+
+func syntheticV6StateBuffer(t *testing.T) optstats.GTTTraceEquationBuffer {
+	t.Helper()
+	frame := 0
+	runtime := gtttrace.NewRuntime()
+	runtime.BindFrame(&frame)
+	runtime.Enable()
+	provider := gtttrace.UnknownProvider("fixture", "ordered-state")
+	incomplete := gtttrace.IncompleteEvidence("fixture_candidate_dependency_incomplete")
+
+	slotID := runtime.RegisterNumericStateSlot("fixture", provider, "S", 100, incomplete)
+	readID := runtime.RecordNumericStateRead(slotID, "", 100, incomplete)
+	if resynced := runtime.RegisterNumericStateSlot("fixture", provider, "S", 101, incomplete); resynced != slotID {
+		t.Fatalf("resynced slot = %q, want %q", resynced, slotID)
+	}
+	runtime.RecordNumericStateRead(slotID, "", 101, incomplete)
+	runtime.RecordNumericEval(
+		"", "state_transition", []gtttrace.NumericRef{gtttrace.EventRef(readID)}, 101,
+		gtttrace.CompleteEvidence(),
+	)
+	runtime.RecordGuard(
+		"", "observed", nil, true,
+		gtttrace.IncompleteEvidence("guard_operand_dependency_incomplete"),
+	)
+	amountCalls := 0
+	amountCalls++
+	modifierID := runtime.RecordModifierEval(
+		"stat", "fixture-hp", 0, "", provider, -1, true,
+		map[string]float64{"hp%": 0.2}, []gtttrace.NumericRef{gtttrace.EventRef(readID)}, incomplete,
+	)
+	if amountCalls != 1 {
+		t.Fatalf("modifier amount calls = %d", amountCalls)
+	}
+	maxHPID := runtime.RecordMaxHPRead(0, 1000, 0.2, 0, 1200, []string{modifierID})
+	healthInputID := runtime.RecordNumericEval(
+		"", "multiply",
+		[]gtttrace.NumericRef{gtttrace.EventOutputRef(maxHPID, "max_hp"), gtttrace.LiteralRef(0.1)},
+		120, incomplete,
+	)
+	healthIndex, healthID := runtime.BeginHealthOperation()
+	runtime.CompleteHealthOperation(healthIndex, gtttrace.HealthOperation{
+		Kind: gtttrace.HealthOperationDrain, Frame: frame, Provider: provider, TargetIndex: 0,
+		InputValue: 120, AdjustedInputValue: 120, RawAmount: 120, EventAmount: 120,
+		EventEffectiveAmount: 120, MaxHPBefore: 1200, MaxHPAfter: 1200,
+		ModifierContributions:       []gtttrace.HealthModifierContribution{},
+		CandidateDependencyComplete: false, UncertaintyCodes: []string{"fixture"},
+	})
+	runtime.RecordHealthFieldBinding(healthID, "input_value", healthInputID, 120)
+	runtime.RecordHealthFieldBinding(healthID, "adjusted_input_value", healthInputID, 120)
+	runtime.RecordHealthFieldBinding(healthID, "max_hp_before", maxHPID, 1200)
+	runtime.RecordHealthFieldBinding(healthID, "max_hp_after", maxHPID, 1200)
+	restoreHealth := runtime.EnterHealthOperation(healthID)
+	callbackID := runtime.BeginEventCallback("heal", "fixture", "", provider)
+	callbackValueID := runtime.RecordNumericEval(
+		"", "multiply",
+		[]gtttrace.NumericRef{gtttrace.HealthFieldRef(healthID, "event_amount"), gtttrace.LiteralRef(2)},
+		240, incomplete,
+	)
+	queueID := runtime.RegisterTaskQueue()
+	payloads := []gtttrace.NumericPayload{{
+		Key: "gain", Value: 240, Reference: gtttrace.EventRef(callbackValueID),
+	}}
+	taskID := runtime.RecordTaskEnqueue(queueID, 0, 0, 5, 5, "", payloads)
+	runtime.CompleteEventCallback(callbackID, "heal", "fixture", "", "", provider)
+	restoreHealth()
+
+	frame = 5
+	taskCallID := runtime.BeginTaskExecution(taskID, queueID, 0, 0, 5, 5, 5, "", "", provider, payloads)
+	runtime.RecordNumericStateWrite(slotID, "", 101, 340, incomplete)
+	runtime.CompleteTaskExecution(taskCallID, taskID, queueID, 0, 0, 5, 5, 5, "", "", provider, payloads)
+
+	return optstats.GTTTraceEquationBuffer{
+		DurationFrames:    5,
+		HealthOperations:  runtime.HealthOperations(),
+		SourceOccurrences: []gtttrace.SourceOccurrence{},
+		StateSlots:        runtime.StateSlots(), StateEvents: runtime.StateEvents(),
+	}
+}
+
+func TestTraceEquationV6SyntheticOrderedStateLoop(t *testing.T) {
+	buffer := syntheticV6StateBuffer(t)
+	if err := validateGTTStateRows(buffer, []string{"fixture"}); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("max hp arithmetic corruption", func(t *testing.T) {
+		broken := buffer
+		broken.StateEvents = append([]gtttrace.StateEvent{}, buffer.StateEvents...)
+		for index := range broken.StateEvents {
+			if broken.StateEvents[index].Kind == gtttrace.StateEventMaxHPRead {
+				output := make(map[string]float64)
+				for key, value := range broken.StateEvents[index].Output {
+					output[key] = value
+				}
+				output["max_hp"]++
+				broken.StateEvents[index].Output = output
+				break
+			}
+		}
+		if err := validateGTTStateRows(broken, []string{"fixture"}); err == nil {
+			t.Fatal("accepted corrupted max hp")
+		}
+	})
+
+	t.Run("task payload corruption", func(t *testing.T) {
+		broken := buffer
+		broken.StateEvents = append([]gtttrace.StateEvent{}, buffer.StateEvents...)
+		for index := range broken.StateEvents {
+			if broken.StateEvents[index].Kind == gtttrace.StateEventTaskEnqueue {
+				broken.StateEvents[index].NumericPayload = append([]gtttrace.NumericPayload{}, broken.StateEvents[index].NumericPayload...)
+				broken.StateEvents[index].NumericPayload[0].Value++
+				break
+			}
+		}
+		if err := validateGTTStateRows(broken, []string{"fixture"}); err == nil {
+			t.Fatal("accepted corrupted task payload")
+		}
+	})
+
+	t.Run("observed guard cannot claim complete evidence", func(t *testing.T) {
+		broken := buffer
+		broken.StateEvents = append([]gtttrace.StateEvent{}, buffer.StateEvents...)
+		for index := range broken.StateEvents {
+			if broken.StateEvents[index].Kind == gtttrace.StateEventGuardEval {
+				broken.StateEvents[index].CandidateDependencyComplete = true
+				broken.StateEvents[index].UncertaintyCodes = nil
+				break
+			}
+		}
+		if err := validateGTTStateRows(broken, []string{"fixture"}); err == nil {
+			t.Fatal("accepted complete observed guard")
+		}
+	})
+}
+
+func TestAttackInputBoundariesAreValidated(t *testing.T) {
+	rt := gtttrace.NewRuntime()
+	frame := 0
+	rt.BindFrame(&frame)
+	rt.Enable()
+	rt.RecordArtifactStatRead(0, "em", 500, nil)
+	rt.RecordNumericEval("", "frozen_attack_operand", nil, 3, gtttrace.IncompleteEvidence("attack_field_operand_dependency_frozen"))
+	buffer := optstats.GTTTraceEquationBuffer{DurationFrames: 1, StateSlots: rt.StateSlots(), StateEvents: rt.StateEvents()}
+	if err := validateGTTStateRows(buffer, []string{"provider"}); err != nil {
+		t.Fatal(err)
+	}
+	for _, corrupt := range []string{"owner", "complete", "modifier", "key"} {
+		t.Run(corrupt, func(t *testing.T) {
+			bad := buffer
+			bad.StateEvents = append([]gtttrace.StateEvent{}, buffer.StateEvents...)
+			switch corrupt {
+			case "owner":
+				n := 2
+				bad.StateEvents[0].OwnerIndex = &n
+			case "complete":
+				bad.StateEvents[0].CandidateDependencyComplete = true
+				bad.StateEvents[0].UncertaintyCodes = []string{}
+			case "modifier":
+				bad.StateEvents[0].ModifierEvalIDs = []string{"missing"}
+			case "key":
+				bad.StateEvents[0].Key = nil
+			}
+			if err := validateGTTStateRows(bad, []string{"provider"}); err == nil {
+				t.Fatal("invalid boundary accepted")
+			}
+		})
+	}
+}
+
+func TestTraceEquationV6DisabledRuntimeIsInert(t *testing.T) {
+	frame := 0
+	runtime := gtttrace.NewRuntime()
+	runtime.BindFrame(&frame)
+	provider := gtttrace.UnknownProvider("fixture", "disabled")
+	value := 7.0
+	calls := 0
+	evaluate := func() float64 {
+		calls++
+		return value
+	}
+	observed := evaluate()
+	if runtime.RegisterNumericStateSlot("fixture", provider, "S", observed, gtttrace.CompleteEvidence()) != "" ||
+		len(runtime.StateSlots()) != 0 || len(runtime.StateEvents()) != 0 || observed != value || calls != 1 {
+		t.Fatalf("disabled trace changed execution: value=%v calls=%d slots=%d events=%d", observed, calls, len(runtime.StateSlots()), len(runtime.StateEvents()))
+	}
+}
