+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+)
+
+// Unknown API names are not claimed as supported source roots. Required bundle
+// integration tests must additionally detect loss of runtime source coverage.
+func TestUnknownHealthAPINotClaimedAsSupported(t *testing.T) {
+	for _, name := range []string{"Heal", "RestoreHealth"} {
+		fset := token.NewFileSet()
+		expression, err := parser.ParseExprFrom(fset, "test.go", "p."+name+"(info.HealInfo{Src: 100})", 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _, _, recognized := describeSeamCall(fset, expression.(*ast.CallExpr), bindingSet{})
+		if recognized != (name == "Heal") {
+			t.Fatal(name, recognized)
+		}
+	}
+}
diff --git a/pkg/gttsourcegen/attack_fields.go b/pkg/gttsourcegen/attack_fields.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/attack_fields.go
@@ -0,0 +1,285 @@
+package gttsourcegen
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"strconv"
+	"strings"
+)
+
+// GP-2b bounded callback pilot. Typed AttackEvent assertions + scalar field
+// writes are API seams, not character/reaction rules. Unsupported operands
+// remain frozen; no new gameplay functions are evaluated twice.
+type fieldExpression struct {
+	fset                     *token.FileSet
+	rt, source, prefix, info string
+	refs                     map[string]string
+	constants                map[string]bool
+	serial, visits           int
+	code                     strings.Builder
+}
+type fieldValue struct{ value, ref string }
+
+func (c *fieldExpression) emit(e ast.Expr, depth int) (fieldValue, error) {
+	c.visits++
+	if depth > 12 || c.visits > 64 {
+		return fieldValue{}, fmt.Errorf("field expression budget")
+	}
+	text := rootText(c.fset, e)
+	// Keep named constants in the original expression: assigning an untyped
+	// integer constant to a temporary would default it to int and break a
+	// mixed floating expression that is valid in the upstream source.
+	if id, ok := e.(*ast.Ident); ok && c.constants[id.Name] {
+		return fieldValue{text, fmt.Sprintf("%s.LiteralRef(float64(%s))", traceImportAlias, text)}, nil
+	}
+	if ref, ok := c.refs[text]; ok {
+		return fieldValue{text, ref}, nil
+	}
+	if p, ok := e.(*ast.ParenExpr); ok {
+		return c.emit(p.X, depth+1)
+	}
+	if v, ok := e.(*ast.BasicLit); ok && (v.Kind == token.INT || v.Kind == token.FLOAT) {
+		return fieldValue{text, fmt.Sprintf("%s.LiteralRef(float64(%s))", traceImportAlias, text)}, nil
+	}
+	if v, ok := e.(*ast.UnaryExpr); ok && (v.Op == token.ADD || v.Op == token.SUB) {
+		if n, ok := v.X.(*ast.BasicLit); ok && (n.Kind == token.INT || n.Kind == token.FLOAT) {
+			return fieldValue{text, fmt.Sprintf("%s.LiteralRef(float64(%s))", traceImportAlias, text)}, nil
+		}
+	}
+	c.serial++
+	name := c.prefix + "_n" + strconv.Itoa(c.serial)
+	ref := name + "_ref"
+	operation := ""
+	var operands []ast.Expr
+	switch v := e.(type) {
+	case *ast.BinaryExpr:
+		operation = map[token.Token]string{token.ADD: "add", token.SUB: "subtract", token.MUL: "multiply", token.QUO: "divide"}[v.Op]
+		if operation != "" {
+			operands = []ast.Expr{v.X, v.Y}
+		}
+	case *ast.CallExpr:
+		if id, ok := v.Fun.(*ast.Ident); ok && (id.Name == "min" || id.Name == "max") && len(v.Args) == 2 {
+			operation = id.Name
+			operands = v.Args
+		}
+		if s, ok := v.Fun.(*ast.SelectorExpr); ok && safeSelectorChain(rootText(c.fset, s.X)) {
+			if (s.Sel.Name == "MaxHP" || s.Sel.Name == "TotalAtk") && len(v.Args) == 0 {
+				fmt.Fprintf(&c.code, "%s,%s := %s.GTTRead%s(%s,func()float64{return %s});\n", name, ref, c.info, s.Sel.Name, rootText(c.fset, s.X), text)
+				return fieldValue{name, ref}, nil
+			}
+			if (s.Sel.Name == "Stat" || s.Sel.Name == "NonExtraStat") && len(v.Args) == 1 {
+				// The attribute enum is evaluated once too.
+				fmt.Fprintf(&c.code, "%s_key := %s;\n", name, rootText(c.fset, v.Args[0]))
+				fmt.Fprintf(&c.code, "%s,%s := %s.GTTRead%s(%s,%s_key,func()float64{return %s.%s(%s_key)});\n", name, ref, c.info, s.Sel.Name, rootText(c.fset, s.X), name, rootText(c.fset, s.X), s.Sel.Name, name)
+				return fieldValue{name, ref}, nil
+			}
+		}
+	}
+	if operation != "" {
+		values := make([]fieldValue, len(operands))
+		for i, arg := range operands {
+			v, err := c.emit(arg, depth+1)
+			if err != nil {
+				return fieldValue{}, err
+			}
+			values[i] = v
+		}
+		expression := ""
+		if b, ok := e.(*ast.BinaryExpr); ok {
+			expression = values[0].value + " " + b.Op.String() + " " + values[1].value
+		} else {
+			expression = operation + "(" + values[0].value + "," + values[1].value + ")"
+		}
+		fmt.Fprintf(&c.code, "%s := (%s);\n", name, expression)
+		fmt.Fprintf(&c.code, "%s_event := %s.RecordNumericEval(%s,%q,[]%s.NumericRef{%s,%s},float64(%s),%s.IncompleteEvidence(%q));\n", name, c.rt, c.source, operation, traceImportAlias, values[0].ref, values[1].ref, name, traceImportAlias, "numeric_expression_candidate_dependency_incomplete")
+	} else {
+		switch e.(type) {
+		case *ast.Ident, *ast.SelectorExpr, *ast.IndexExpr, *ast.CallExpr:
+		default:
+			return fieldValue{}, fmt.Errorf("unsupported numeric operand")
+		}
+		fmt.Fprintf(&c.code, "%s := (%s);\n", name, text)
+		fmt.Fprintf(&c.code, "%s_event := %s.RecordNumericEval(%s,%q,nil,float64(%s),%s.IncompleteEvidence(%q));\n", name, c.rt, c.source, "frozen_attack_operand", name, traceImportAlias, "attack_field_operand_dependency_frozen")
+	}
+	fmt.Fprintf(&c.code, "%s := %s.EventRef(%s_event);\n", ref, traceImportAlias, name)
+	return fieldValue{name, ref}, nil
+}
+
+func hasFieldStatInput(expr ast.Expr, refs map[string]string, fset *token.FileSet) bool {
+	found := false
+	ast.Inspect(expr, func(n ast.Node) bool {
+		if e, ok := n.(ast.Expr); ok {
+			if _, yes := refs[rootText(fset, e)]; yes {
+				found = true
+				return false
+			}
+		}
+		if call, ok := n.(*ast.CallExpr); ok {
+			if s, ok := call.Fun.(*ast.SelectorExpr); ok && ((s.Sel.Name == "MaxHP" && len(call.Args) == 0) || (s.Sel.Name == "Stat" && len(call.Args) == 1)) {
+				found = true
+			}
+		}
+		return true
+	})
+	return found
+}
+
+func attackFieldEdits(fset *token.FileSet, tf *token.File, file *ast.File, body *ast.BlockStmt, rt, source, prefix string) []textEdit {
+	infoAlias := ""
+	for alias, path := range sourceImportAliases(file) {
+		if path == "github.com/genshinsim/gcsim/pkg/core/info" {
+			infoAlias = alias
+		}
+	}
+	if infoAlias == "" {
+		return nil
+	}
+	// Only unambiguous local type assertions establish an AttackEvent owner.
+	locals := map[string]bool{}
+	writes := map[string]int{}
+	ast.Inspect(body, func(n ast.Node) bool {
+		if _, ok := n.(*ast.FuncLit); ok {
+			return false
+		}
+		if a, ok := n.(*ast.AssignStmt); ok {
+			for _, lhs := range a.Lhs {
+				if id, ok := lhs.(*ast.Ident); ok {
+					writes[id.Name]++
+				}
+			}
+			if len(a.Rhs) == 1 && len(a.Lhs) >= 1 {
+				if assertion, ok := a.Rhs[0].(*ast.TypeAssertExpr); ok && rootText(fset, assertion.Type) == "*"+infoAlias+".AttackEvent" {
+					if id, ok := a.Lhs[0].(*ast.Ident); ok {
+						locals[id.Name] = true
+					}
+				}
+			}
+		}
+		return true
+	})
+	fieldTarget := func(e ast.Expr) (string, string, bool) {
+		sel, ok := e.(*ast.SelectorExpr)
+		if !ok {
+			return "", "", false
+		}
+		// The two accepted numeric AttackInfo fields have the same ordered-write
+		// contract. New fields can reuse it after consumer coverage is added.
+		if sel.Sel.Name != "BaseDmgBonus" && sel.Sel.Name != "FlatDmg" {
+			return "", "", false
+		}
+		inner, ok := sel.X.(*ast.SelectorExpr)
+		if !ok || inner.Sel.Name != "Info" {
+			return "", "", false
+		}
+		id, ok := inner.X.(*ast.Ident)
+		if !ok || !locals[id.Name] || writes[id.Name] != 1 {
+			return "", "", false
+		}
+		return id.Name, sel.Sel.Name, true
+	}
+	hasTarget := false
+	ast.Inspect(body, func(n ast.Node) bool {
+		if a, ok := n.(*ast.AssignStmt); ok && len(a.Lhs) == 1 {
+			_, _, yes := fieldTarget(a.Lhs[0])
+			hasTarget = hasTarget || yes
+		}
+		return true
+	})
+	if !hasTarget {
+		return nil
+	}
+	refs := map[string]string{}
+	constants := map[string]bool{}
+	for _, decl := range file.Decls {
+		if group, ok := decl.(*ast.GenDecl); ok && group.Tok == token.CONST {
+			for _, spec := range group.Specs {
+				for _, name := range spec.(*ast.ValueSpec).Names {
+					constants[name.Name] = true
+				}
+			}
+		}
+	}
+	// A local binding can shadow a file constant. Conservatively discard the
+	// name for this callback rather than treating mutable state as a constant.
+	ast.Inspect(body, func(n ast.Node) bool {
+		switch v := n.(type) {
+		case *ast.AssignStmt:
+			if v.Tok == token.DEFINE {
+				for _, lhs := range v.Lhs {
+					if id, ok := lhs.(*ast.Ident); ok {
+						delete(constants, id.Name)
+					}
+				}
+			}
+		case *ast.ValueSpec:
+			for _, name := range v.Names {
+				delete(constants, name.Name)
+			}
+		}
+		return true
+	})
+	var edits []textEdit
+	sequence := 0
+	for _, stmt := range body.List {
+		a, ok := stmt.(*ast.AssignStmt)
+		if !ok || len(a.Lhs) != 1 || len(a.Rhs) != 1 || a.Tok != token.DEFINE {
+			continue
+		}
+		id, ok := a.Lhs[0].(*ast.Ident)
+		if !ok || writes[id.Name] != 1 || !hasFieldStatInput(a.Rhs[0], refs, fset) {
+			continue
+		}
+		sequence++
+		p := "gttAF_" + prefix + "_" + strconv.Itoa(sequence)
+		compiler := fieldExpression{fset: fset, rt: rt, source: source, prefix: p, info: infoAlias, refs: refs, constants: constants}
+		root, err := compiler.emit(a.Rhs[0], 0)
+		if err != nil {
+			continue
+		}
+		ref := p + "_binding"
+		replacement := fmt.Sprintf("%s,%s := func()(float64,%s.NumericRef){if !%s.Enabled(){return %s,%s.NumericRef{}};\n%s return float64(%s),%s }(); _ = %s", id.Name, ref, traceImportAlias, rt, rootText(fset, a.Rhs[0]), traceImportAlias, compiler.code.String(), root.value, root.ref, ref)
+		edits = append(edits, textEdit{tf.Offset(a.Pos()), tf.Offset(a.End()), replacement})
+		refs[id.Name] = ref
+	}
+	ast.Inspect(body, func(n ast.Node) bool {
+		if _, ok := n.(*ast.FuncLit); ok {
+			return false
+		}
+		a, ok := n.(*ast.AssignStmt)
+		if !ok || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+			return true
+		}
+		owner, field, ok := fieldTarget(a.Lhs[0])
+		if !ok {
+			return true
+		}
+		operation := map[token.Token]string{token.ASSIGN: "assign", token.ADD_ASSIGN: "add", token.SUB_ASSIGN: "subtract", token.MUL_ASSIGN: "multiply", token.QUO_ASSIGN: "divide"}[a.Tok]
+		if operation == "" {
+			return true
+		}
+		sequence++
+		p := "gttAF_" + prefix + "_" + strconv.Itoa(sequence)
+		compiler := fieldExpression{fset: fset, rt: rt, source: source, prefix: p, info: infoAlias, refs: refs, constants: constants}
+		root, err := compiler.emit(a.Rhs[0], 0)
+		if err != nil {
+			return true
+		}
+		lhs := rootText(fset, a.Lhs[0])
+		original := rootText(fset, a)
+		selfRead := false
+		ast.Inspect(a.Rhs[0], func(n ast.Node) bool {
+			if e, ok := n.(ast.Expr); ok && rootText(fset, e) == lhs {
+				selfRead = true
+			}
+			return true
+		})
+		if selfRead {
+			operation = "opaque"
+		}
+		replacement := fmt.Sprintf("if !%s.Enabled(){%s}else{\n%s_before := %s;\n%s %s %s float64(%s);\n%s.GTTRecordAttackFieldWrite(%s,%s,%q,%q,float64(%s_before),float64(%s),float64(%s),%s)\n}", rt, original, p, lhs, compiler.code.String(), lhs, a.Tok.String(), root.value, infoAlias, owner, rt, field, operation, p, lhs, root.value, root.ref)
+		edits = append(edits, textEdit{tf.Offset(a.Pos()), tf.Offset(a.End()), replacement})
+		return true
+	})
+	return edits
+}
diff --git a/pkg/gttsourcegen/attack_fields_test.go b/pkg/gttsourcegen/attack_fields_test.go
