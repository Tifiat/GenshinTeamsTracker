diff --git a/pkg/gttsource/source.go b/pkg/gttsource/source.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsource/source.go
@@ -0,0 +1,165 @@
+// Package gttsource resolves build-time source identities at the small runtime
+// seams used by the opt-in GTT equation trace. Source identities describe code
+// roots; they are deliberately separate from gtttrace.Provider, which describes
+// the character, weapon, or set that owns an effect at runtime.
+package gttsource
+
+import (
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+const (
+	KindModifierAmount = "modifier_amount"
+	KindEventCallback  = "event_callback"
+	KindTaskCallback   = "task_callback"
+	KindQueuedAttack   = "queued_attack"
+)
+
+// CompactTemplateNode and CompactTemplate are the small, immutable numeric
+// slice needed by the opt-in compact trace adapter. They deliberately omit
+// source locations and gameplay identities. The generated lookup is bound to
+// the same manifest hash as source provenance, so runtime code cannot silently
+// interpret a template from another engine build.
+type CompactTemplateNode struct {
+	NodeID        int
+	Operator      string
+	InputNodeIDs  []int
+	ConstantValue *float64
+	ParameterKey  *string
+}
+
+type CompactTemplate struct {
+	Status               string
+	Nodes                []CompactTemplateNode
+	RootNodeID           *int
+	ParameterKeys        []string
+	DependenciesComplete bool
+	StopReasonCode       *string
+	TemplateSHA256       string
+}
+
+// ManifestBodySHA256 identifies the canonical, executable-external source
+// manifest body used to generate this lookup table. The installed-engine
+// manifest binds this value to the final executable SHA256 after compilation.
+func ManifestBodySHA256() string {
+	return generatedSourceManifestBodySHA256
+}
+
+func CompilerVersion() string {
+	return generatedSourceCompilerVersion
+}
+
+func TemplateSHA256(sourceID string) string {
+	if !ValidID(sourceID) {
+		return ""
+	}
+	value := generatedTemplateSHA256BySourceID[sourceID]
+	if !validSHA256(value) {
+		return ""
+	}
+	return value
+}
+
+func CompactSliceTemplate(sourceID string) (CompactTemplate, bool) {
+	if !ValidID(sourceID) {
+		return CompactTemplate{}, false
+	}
+	value, ok := generatedCompactTemplateBySourceID[sourceID]
+	if !ok || value.TemplateSHA256 == "" {
+		return CompactTemplate{}, false
+	}
+	return cloneCompactTemplate(value), true
+}
+
+func cloneCompactTemplate(value CompactTemplate) CompactTemplate {
+	value.Nodes = append([]CompactTemplateNode(nil), value.Nodes...)
+	for index := range value.Nodes {
+		value.Nodes[index].InputNodeIDs = append([]int(nil), value.Nodes[index].InputNodeIDs...)
+		if value.Nodes[index].ConstantValue != nil {
+			cloned := *value.Nodes[index].ConstantValue
+			value.Nodes[index].ConstantValue = &cloned
+		}
+		if value.Nodes[index].ParameterKey != nil {
+			cloned := *value.Nodes[index].ParameterKey
+			value.Nodes[index].ParameterKey = &cloned
+		}
+	}
+	value.ParameterKeys = append([]string(nil), value.ParameterKeys...)
+	if value.RootNodeID != nil {
+		cloned := *value.RootNodeID
+		value.RootNodeID = &cloned
+	}
+	if value.StopReasonCode != nil {
+		cloned := *value.StopReasonCode
+		value.StopReasonCode = &cloned
+	}
+	return value
+}
+
+// CaptureCaller resolves the caller above the seam invoking this helper.
+// callerSkip=1 means the direct caller of the public seam (for example the
+// gameplay call site that invoked AddAttackMod or QueueAttack).
+//
+// Runtime file/line data is used only as a lookup address into a build-time
+// generated table. It never classifies behavior by a Go function, character,
+// set, modifier, hook, or ability name.
+func CaptureCaller(kind string, callerSkip int) string {
+	if callerSkip < 0 || len(generatedSourceIDByLookupKey) == 0 {
+		return ""
+	}
+	_, file, line, ok := runtime.Caller(callerSkip + 1)
+	if !ok || file == "" || line <= 0 {
+		return ""
+	}
+	return Lookup(kind, file, line)
+}
+
+// Lookup resolves a build-time call-site entry. Absolute staging paths are
+// normalized by suffix against module-relative manifest paths. Ambiguity fails
+// closed: the generator rejects same-key collisions, and this runtime lookup
+// refuses multiple suffix matches.
+func Lookup(kind, file string, line int) string {
+	if kind == "" || file == "" || line <= 0 {
+		return ""
+	}
+	normalized := filepath.ToSlash(filepath.Clean(file))
+	suffix := "|" + strconv.Itoa(line)
+	prefix := kind + "|"
+	match := ""
+	for key, sourceID := range generatedSourceIDByLookupKey {
+		if !strings.HasPrefix(key, prefix) || !strings.HasSuffix(key, suffix) {
+			continue
+		}
+		relative := strings.TrimSuffix(strings.TrimPrefix(key, prefix), suffix)
+		if normalized != relative && !strings.HasSuffix(normalized, "/"+relative) {
+			continue
+		}
+		if match != "" && match != sourceID {
+			return ""
+		}
+		match = sourceID
+	}
+	if !ValidID(match) {
+		return ""
+	}
+	return match
+}
+
+func ValidID(sourceID string) bool {
+	return validSHA256(sourceID)
+}
+
+func validSHA256(sourceID string) bool {
+	if len(sourceID) != 64 {
+		return false
+	}
+	for _, char := range sourceID {
+		if (char < '0' || char > '9') && (char < 'a' || char > 'f') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/pkg/gttsource/source_test.go b/pkg/gttsource/source_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsource/source_test.go
@@ -0,0 +1,32 @@
+package gttsource
+
+import "testing"
+
+func TestLookupUsesModuleRelativeSuffixAndFailsClosed(t *testing.T) {
+	originalIDs := generatedSourceIDByLookupKey
+	originalTemplates := generatedTemplateSHA256BySourceID
+	defer func() {
+		generatedSourceIDByLookupKey = originalIDs
+		generatedTemplateSHA256BySourceID = originalTemplates
+	}()
+
+	sourceID := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+	templateSHA := "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
+	generatedSourceIDByLookupKey = map[string]string{
+		KindQueuedAttack + "|internal/characters/example/skill.go|42": sourceID,
+	}
+	generatedTemplateSHA256BySourceID = map[string]string{sourceID: templateSHA}
+
+	if got := Lookup(KindQueuedAttack, `C:\staging\gcsim\internal\characters\example\skill.go`, 42); got != sourceID {
+		t.Fatalf("Lookup() = %q, want %q", got, sourceID)
+	}
+	if got := TemplateSHA256(sourceID); got != templateSHA {
+		t.Fatalf("TemplateSHA256() = %q, want %q", got, templateSHA)
+	}
+	if got := Lookup(KindTaskCallback, `C:\staging\gcsim\internal\characters\example\skill.go`, 42); got != "" {
+		t.Fatalf("wrong seam resolved %q", got)
+	}
+	if ValidID("gttsrc-v1:" + sourceID) {
+		t.Fatal("prefixed source ID must be rejected by the v4 wire contract")
+	}
+}
diff --git a/pkg/gttsourcegen/api_boundary_test.go b/pkg/gttsourcegen/api_boundary_test.go
