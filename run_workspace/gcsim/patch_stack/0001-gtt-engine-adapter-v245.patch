+func (r *Runtime) RecordModifierEval(
+	channel, modifierKey string,
+	recipientIndex int,
+	sourceID string,
+	provider Provider,
+	expiryFrame int,
+	accepted bool,
+	output map[string]float64,
+	inputs []NumericRef,
+	evidence DependencyEvidence,
+) string {
+	if !r.Enabled() || strings.TrimSpace(channel) == "" || strings.TrimSpace(modifierKey) == "" || recipientIndex < 0 {
+		return ""
+	}
+	eventID := r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventModifierEval, SourceID: optionalString(sourceID),
+		Provider: provider, Channel: optionalString(channel), Key: optionalString(modifierKey),
+		ExpiryFrame: optionalInt(expiryFrame), OwnerIndex: optionalInt(recipientIndex),
+		Accepted: optionalBool(accepted), Output: output, Inputs: inputs,
+		CandidateDependencyComplete: evidence.CandidateDependencyComplete,
+		UncertaintyCodes:            evidence.UncertaintyCodes,
+	})
+	if eventID != "" {
+		for index := range r.modifierEvalCaptures {
+			// A nested getter belongs to the modifier's input formula, not to
+			// the outer getter's directly added stat amounts (even for one owner).
+			if channel == "stat" && r.modifierEvalCaptures[index].depth == r.modifierAmountDepth {
+				r.modifierEvalCaptures[index].ids = append(r.modifierEvalCaptures[index].ids, eventID)
+			}
+		}
+	}
+	return eventID
+}
