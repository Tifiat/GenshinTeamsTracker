+
+func (r *Runtime) healthOperation(operationID string) (HealthOperation, bool) {
+	if r == nil || operationID == "" {
+		return HealthOperation{}, false
+	}
+	for index := range r.healthOperations {
+		if r.healthOperations[index].OperationID == operationID {
+			return r.healthOperations[index], true
+		}
+	}
