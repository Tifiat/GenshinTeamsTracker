+func TestSnapshotTotalDEFAndCompoundScaleStayOneProducer(t *testing.T) {
+	src := `package x
+ import("github.com/genshinsim/gcsim/pkg/core/info"; a "github.com/genshinsim/gcsim/pkg/core/attributes")
+ func (c *provider) run(){
+ ai:=info.AttackInfo{}
+ snap:=c.Snapshot(&ai)
+ scale:=2.35
+ ai.FlatDmg=snap.Stats.TotalDEF()
+ ai.FlatDmg*=scale
+ _=a.DEF
+ }`
+	fs := token.NewFileSet()
+	f, err := parser.ParseFile(fs, "x.go", src, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	edits := snapshotFlatEdits(fs, fs.File(f.Pos()), f, []SourceEntry{{Line: 8, SourceID: strings.Repeat("a", 64), traceRuntimePath: "Core.GTTTrace"}})
+	if len(edits) != 1 {
+		t.Fatalf("edits = %d; want one combined producer", len(edits))
+	}
+	out, err := applyTextEdits([]byte(src), edits)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = parser.ParseFile(token.NewFileSet(), "out.go", out, 0); err != nil {
+		t.Fatal(err)
+	}
+	text := string(out)
+	if !strings.Contains(text, "GTTSnapshotTotalRef") || !strings.Contains(text, "GTTFlatProducer") {
+		t.Fatal(text)
+	}
+	if strings.Count(text, "ai.FlatDmg=float64") != 1 {
+		t.Fatalf("compound write was not collapsed into one traced producer: %s", text)
+	}
+}
