+// GTTFlatProducerRef returns the dependency that produced the current flat
+// damage value before a compound write. Missing or stale metadata stays an
+// explicit incomplete numeric boundary instead of silently turning the old
+// value into a candidate-independent literal.
+func GTTFlatProducerRef(rt *gtttrace.Runtime, source string, attack any) gtttrace.NumericRef {
+	var value float64
+	var producer *GTTFlatProducer
+	switch typed := attack.(type) {
+	case AttackInfo:
+		value, producer = typed.FlatDmg, typed.GTTFlatProducer
+	case *AttackInfo:
+		if typed == nil {
+			return gtttrace.NumericRef{}
+		}
+		value, producer = typed.FlatDmg, typed.GTTFlatProducer
+	default:
+		return gtttrace.NumericRef{}
+	}
+	if producer != nil && producer.Reference.Kind != "" {
+		scale := math.Max(1, math.Max(math.Abs(value), math.Abs(producer.Value)))
+		if math.Abs(value-producer.Value) <= 1e-12*scale {
+			return producer.Reference
+		}
+	}
+	if rt == nil || !rt.Enabled() {
+		return gtttrace.LiteralRef(value)
+	}
+	reason := "flat_damage_previous_producer_missing"
+	if producer != nil {
+		reason = "flat_damage_previous_producer_mismatch"
+	}
+	eventID := rt.RecordNumericEval(
+		source, "frozen_attack_flat_damage", nil, value,
+		gtttrace.IncompleteEvidence(reason),
+	)
+	if eventID == "" {
+		return gtttrace.LiteralRef(value)
+	}
+	return gtttrace.EventRef(eventID)
+}
