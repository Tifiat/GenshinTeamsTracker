+func directStatGetter(fs *token.FileSet, e ast.Expr) (string, bool) {
+	call, ok := e.(*ast.CallExpr)
+	if !ok {
+		return "", false
+	}
+	method, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok || !safeSelectorChain(rootText(fs, method.X)) {
+		return "", false
+	}
+	if stats, ok := method.X.(*ast.SelectorExpr); ok && stats.Sel.Name == "Stats" {
+		return "", false
+	}
+	switch method.Sel.Name {
+	case "MaxHP", "TotalAtk":
+		if len(call.Args) != 0 {
+			return "", false
+		}
+	case "TotalDef":
+		if len(call.Args) != 1 || !booleanLiteral(call.Args[0]) {
+			return "", false
+		}
+	case "Stat", "NonExtraStat":
+		if len(call.Args) != 1 {
+			return "", false
+		}
+	default:
+		return "", false
+	}
+	return rootText(fs, method.X), true
+}
+
+func directStatGetterOwners(fs *token.FileSet, e ast.Expr) map[string]bool {
+	owners := map[string]bool{}
+	ast.Inspect(e, func(node ast.Node) bool {
+		expr, ok := node.(ast.Expr)
+		if !ok {
+			return true
+		}
+		if owner, ok := directStatGetter(fs, expr); ok {
+			owners[owner] = true
+			return false
+		}
+		return true
+	})
+	return owners
+}
+
+func statGetterOwners(fs *token.FileSet, e ast.Expr, aliases map[string]ast.Expr) map[string]bool {
+	owners := map[string]bool{}
+	visiting := map[string]bool{}
+	var inspect func(ast.Expr, int)
+	inspect = func(expr ast.Expr, depth int) {
+		if expr == nil || depth > 12 {
+			return
+		}
+		if owner, ok := directStatGetter(fs, expr); ok {
+			owners[owner] = true
+			return
+		}
+		if id, ok := expr.(*ast.Ident); ok {
+			if value, exists := aliases[id.Name]; exists && !visiting[id.Name] {
+				visiting[id.Name] = true
+				inspect(value, depth+1)
+				delete(visiting, id.Name)
+			}
+			return
+		}
+		ast.Inspect(expr, func(node ast.Node) bool {
+			child, ok := node.(ast.Expr)
+			if !ok {
+				return true
+			}
+			if child == expr {
+				return true
+			}
+			inspect(child, depth+1)
+			return false
+		})
+	}
+	inspect(e, 0)
+	return owners
+}
+
+func mergeStringSet(dst, src map[string]bool) {
+	for value := range src {
+		dst[value] = true
+	}
+}
+
+func snapshotTotalReference(fs *token.FileSet, e ast.Expr, snapshots, snapshotPointers map[string]bool, infoAlias, rt string) (string, bool) {
+	call, ok := e.(*ast.CallExpr)
+	if !ok || len(call.Args) != 0 {
+		return "", false
+	}
+	method, ok := call.Fun.(*ast.SelectorExpr)
+	if !ok {
+		return "", false
+	}
+	stats, ok := method.X.(*ast.SelectorExpr)
+	if !ok || stats.Sel.Name != "Stats" || !snapshots[rootText(fs, stats.X)] {
+		return "", false
+	}
+	suffix := map[string]string{
+		"MaxHP":    "MaxHP",
+		"TotalATK": "ATK",
+		"TotalDEF": "DEF",
+	}[method.Sel.Name]
+	if suffix == "" {
+		return "", false
+	}
+	helper := "GTTSnapshotTotalRef" + suffix
+	if snapshotPointers[rootText(fs, stats.X)] {
+		helper = "GTTSnapshotPointerTotalRef" + suffix
+	}
+	return fmt.Sprintf(
+		"%s.%s(%s,%s,%s)",
+		infoAlias, helper, rt, rootText(fs, stats.X),
+		rootText(fs, call),
+	), true
+}
+
+func flatAssignmentOperator(operator token.Token) string {
+	return map[token.Token]string{
+		token.ASSIGN:     "=",
+		token.ADD_ASSIGN: "+",
+		token.SUB_ASSIGN: "-",
+		token.MUL_ASSIGN: "*",
+		token.QUO_ASSIGN: "/",
+	}[operator]
+}
+
+func snapshotFlatCompoundAssignment(fs *token.FileSet, stmt ast.Stmt, attack string) (*ast.AssignStmt, string, bool) {
+	a, ok := stmt.(*ast.AssignStmt)
+	if !ok || len(a.Lhs) != 1 || len(a.Rhs) != 1 {
+		return nil, "", false
+	}
+	lhs, ok := a.Lhs[0].(*ast.SelectorExpr)
+	if !ok || lhs.Sel.Name != "FlatDmg" {
+		return nil, "", false
+	}
+	if rootText(fs, lhs.X) != attack || !safeSelectorChain(attack) {
+		return nil, "", false
+	}
+	operator := flatAssignmentOperator(a.Tok)
+	if a.Tok == token.ASSIGN {
+		operator = ""
+	}
+	if operator == "" {
+		return nil, "", false
+	}
+	referencesFlat := false
+	ast.Inspect(a.Rhs[0], func(n ast.Node) bool {
+		selector, ok := n.(*ast.SelectorExpr)
+		if !ok || selector.Sel.Name != "FlatDmg" {
+			return true
+		}
+		referencesFlat = referencesFlat || rootText(fs, selector.X) == attack
+		return !referencesFlat
+	})
+	return a, operator, !referencesFlat
+}
