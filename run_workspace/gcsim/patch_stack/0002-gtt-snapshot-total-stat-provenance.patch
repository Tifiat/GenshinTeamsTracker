+		name, signature, setup, assignment, queued, helper string
+	}{
+		{"compound local", "func (c *provider) run()", "ai:=info.AttackInfo{}", "ai.FlatDmg+=c.MaxHP()*2", "ai", "GTTReadMaxHP"},
+		{"compound parameter", "func (c *provider) run(ai *info.AttackInfo)", "", "ai.FlatDmg+=c.TotalAtk()*2", "*ai", "GTTReadTotalAtk"},
+		{"persistent field", "func (c *provider) run()", "c.saved=info.AttackInfo{}", "c.saved.FlatDmg=c.TotalDef(false)*2", "c.saved", "GTTReadTotalDef"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			src := `package arbitrary
+import "github.com/genshinsim/gcsim/pkg/core/info"
+` + tc.signature + `{
+ ` + tc.setup + `
+ ` + tc.assignment + `
+ c.Core.QueueAttack(` + tc.queued + `)
+}`
+			fs := token.NewFileSet()
+			file, err := parser.ParseFile(fs, "x.go", src, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			edits := snapshotFlatEdits(fs, fs.File(file.Pos()), file, nil)
+			if len(edits) != 1 {
+				t.Fatalf("edits=%d, want 1\n%s", len(edits), src)
+			}
+			out, err := applyTextEdits([]byte(src), edits)
+			if err != nil {
+				t.Fatal(err)
+			}
+			text := string(out)
+			for _, want := range []string{tc.helper, "GTTFlatProducer"} {
+				if !strings.Contains(text, want) {
+					t.Fatalf("missing %q:\n%s", want, text)
+				}
+			}
+			if tc.name != "persistent field" && !strings.Contains(text, "GTTFlatProducerRef") {
+				t.Fatalf("compound write lost the previous producer:\n%s", text)
+			}
+			if _, err := parser.ParseFile(token.NewFileSet(), "rewritten.go", out, 0); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
