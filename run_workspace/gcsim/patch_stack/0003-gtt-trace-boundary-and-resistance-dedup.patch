+func TestResistanceInputReusesOnePortPerExecutedHit(t *testing.T) {
+	b := &nodeBuilder{}
+	c := &directCompiler{b: b}
+	hit := info.GTTTraceHit{HitID: 7, TargetKey: 3, Element: "physical", Resistance: 0.1, ResMod: 0.9}
+	first := c.resistanceInput(hit)
+	second := c.resistanceInput(hit)
+	if first.id != second.id || len(b.resistanceInputs) != 1 {
+		t.Fatalf("duplicate hit created multiple resistance ports: first=%d second=%d ports=%d", first.id, second.id, len(b.resistanceInputs))
+	}
