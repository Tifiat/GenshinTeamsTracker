 func (c *directCompiler) resistanceInput(hit info.GTTTraceHit) compiledNode {
+	if hit.Element == "" {
+		// NoElement damage has no addressable resistance category. Keep the
+		// observed multiplier in the formula, but do not expose a set-effect
+		// intervention port that no elemental/physical resistance term can own.
+		return c.b.constant(hit.ResMod)
+	}
 	if existing, ok := c.b.resistanceByHit[hit.HitID]; ok {
 		return existing
 	}
