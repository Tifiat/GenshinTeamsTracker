+func TestEffectInputsKeepDistinctPortsForSharedUpstreamValue(t *testing.T) {
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	base := r.RecordNumericEval("", "literal", nil, 0.25, gtttrace.IncompleteEvidence("synthetic"))
+	first := r.RecordEffectRead("", "reaction_bonus", 0, 31, "identity", []gtttrace.NumericRef{gtttrace.EventRef(base)}, 0.25, gtttrace.IncompleteEvidence("synthetic"))
+	second := r.RecordEffectRead("", "reaction_bonus", 0, 32, "identity", []gtttrace.NumericRef{gtttrace.EventRef(base)}, 0.25, gtttrace.IncompleteEvidence("synthetic"))
+	buffer := optstats.GTTTraceEquationBuffer{
+		StateEvents: r.StateEvents(),
+		Hits: []info.GTTTraceHit{
+			{ReactionBonusRef: gtttrace.EventRef(first)},
+			{ReactionBonusRef: gtttrace.EventRef(second)},
+		},
+	}
+	support := compileSupportProgram(&nodeBuilder{}, buffer, []string{"owner"})
+	got := collectEffectInputs(buffer, []string{"owner"}, support)
+	if len(got) != 2 || got[0].EventID != first || got[1].EventID != second || got[0].NodeID == got[1].NodeID {
+		t.Fatalf("shared upstream value collapsed effect ports: %#v", got)
+	}
+}
