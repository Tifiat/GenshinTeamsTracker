+
+func TestContributorSealSurvivesLaterNumericRecipeRewrite(t *testing.T) {
+	data, err := os.ReadFile(filepath.Join("..", "reactable", "lunarcharged.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	sealed, err := rewriteContributorGroups("pkg/reactable/lunarcharged.go", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rewritten, err := rewriteNumericRecipes("pkg/reactable/lunarcharged.go", sealed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	line := ""
+	for _, candidate := range strings.Split(string(rewritten), "\n") {
+		if strings.Contains(candidate, "GTTAttachContributorGroup(") {
+			line = candidate
+		}
+	}
+	if line == "" || strings.Contains(line, `,""`) || strings.Contains(line, `, ""`) {
+		t.Fatalf("later numeric rewrite lost contributor seal: %s", line)
+	}
+}
+
+func TestContributorSealSurvivesFullOverlayPipeline(t *testing.T) {
+	root, err := filepath.Abs(filepath.Join("..", ".."))
+	if err != nil {
+		t.Fatal(err)
+	}
+	manifest, err := Generate(Options{ModuleRoot: root, Binding: testBinding()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay, err := BuildOverlay(
+		OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")},
+		manifest,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, file := range overlay.Files {
+		if file.RelativeFile != "pkg/reactable/lunarcharged.go" {
+			continue
+		}
+		for _, line := range strings.Split(string(file.Contents), "\n") {
+			if strings.Contains(line, "GTTAttachContributorGroup(") &&
+				!strings.Contains(line, `,""`) && !strings.Contains(line, `, ""`) {
+				return
+			}
+		}
+		t.Fatal("full overlay pipeline emitted an unsealed Lunar Charged contributor group")
+	}
+	t.Fatal("Lunar Charged overlay absent")
+}
