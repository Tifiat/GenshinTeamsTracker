+++ b/pkg/optimization/gtt_response.go
@@ -0,0 +1,526 @@
+package optimization
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gcs/ast"
+	"github.com/genshinsim/gcsim/pkg/gcs/parser"
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"github.com/genshinsim/gcsim/pkg/simulator"
+)
+
+const (
+	GTTStatResponseSchemaVersion = 2
+	gttResponseObjectiveDPS      = "dps"
+	gttResponseObjectiveClear    = "clear_time"
+	gttResponseChangeAdd         = "add"
+	gttResponseChangeSet         = "set"
+)
+
+type GTTStatResponseRequest struct {
+	SchemaVersion     int                           `json:"schema_version"`
+	ContextSHA256     string                        `json:"context_sha256"`
+	Objective         string                        `json:"objective"`
+	Iterations        int                           `json:"iterations"`
+	Workers           int                           `json:"workers"`
+	MasterSeed        string                        `json:"master_seed"`
+	IgnoreBurstEnergy bool                          `json:"ignore_burst_energy"`
+	BaselineChanges   []GTTStatResponseChange       `json:"baseline_changes"`
+	Interventions     []GTTStatResponseIntervention `json:"interventions"`
+}
+
+type GTTStatResponseIntervention struct {
+	ID      string                  `json:"id"`
+	Changes []GTTStatResponseChange `json:"changes"`
+}
+
+type GTTStatResponseChange struct {
+	CharacterIndex int     `json:"character_index"`
+	Stat           string  `json:"stat"`
+	Mode           string  `json:"mode"`
+	Value          float64 `json:"value"`
+}
+
+type GTTStatResponseOutput struct {
+	SchemaVersion     int                          `json:"schema_version"`
+	ContextSHA256     string                       `json:"context_sha256"`
+	RequestSHA256     string                       `json:"request_sha256"`
+	Objective         string                       `json:"objective"`
+	IgnoreBurstEnergy bool                         `json:"ignore_burst_energy"`
+	CharacterKeys     []string                     `json:"character_keys"`
+	SeedPanelSHA256   string                       `json:"seed_panel_sha256"`
+	Source            GTTStatResponseObservation   `json:"source"`
+	Baseline          GTTStatResponseObservation   `json:"baseline"`
+	Interventions     []GTTStatResponseObservation `json:"interventions"`
+}
+
+type GTTStatResponseObservation struct {
+	ID          string                  `json:"id"`
+	Samples     []GTTStatResponseSample `json:"samples"`
+	Summary     GTTStatResponseSummary  `json:"summary"`
+	PairedDelta *GTTStatResponseSummary `json:"paired_delta,omitempty"`
+}
+
+type GTTStatResponseSample struct {
+	Seed                    string    `json:"seed"`
+	DurationFrames          int       `json:"duration_frames"`
+	DurationSeconds         float64   `json:"duration_seconds"`
+	TeamExpectedDamage      float64   `json:"team_expected_damage"`
+	TeamExpectedDPS         float64   `json:"team_expected_dps"`
+	CharacterExpectedDamage []float64 `json:"character_expected_damage"`
+	CharacterExpectedDPS    []float64 `json:"character_expected_dps"`
+}
+
+type GTTStatResponseSummary struct {
+	DurationSeconds      GTTStatResponseEstimate   `json:"duration_seconds"`
+	TeamExpectedDamage   GTTStatResponseEstimate   `json:"team_expected_damage"`
+	TeamExpectedDPS      GTTStatResponseEstimate   `json:"team_expected_dps"`
+	CharacterExpectedDPS []GTTStatResponseEstimate `json:"character_expected_dps"`
+}
+
+type GTTStatResponseEstimate struct {
+	Count         int     `json:"count"`
+	Mean          float64 `json:"mean"`
+	SampleSD      float64 `json:"sample_sd"`
+	StandardError float64 `json:"standard_error"`
+}
+
+func RunGTTStatResponse(ctx context.Context, opts simulator.Options, requestPath string) error {
+	if strings.TrimSpace(opts.ResultSaveToPath) == "" {
+		return errors.New("gtt stat response requires -out")
+	}
+	request, err := loadGTTStatResponseRequest(requestPath)
+	if err != nil {
+		return err
+	}
+	requestSHA256, err := canonicalSHA256(request)
+	if err != nil {
+		return fmt.Errorf("gtt stat response: hash request: %w", err)
+	}
+	masterSeed, err := strconv.ParseInt(request.MasterSeed, 10, 64)
+	if err != nil || masterSeed <= 0 {
+		return errors.New("gtt stat response: master_seed must be a positive signed 64-bit decimal string")
+	}
+
+	cfg, err := simulator.ReadConfig(opts.ConfigPath)
+	if err != nil {
+		return fmt.Errorf("gtt stat response: read config: %w", err)
+	}
+	file := ast.NewFile()
+	p := parser.New(file, cfg)
+	simcfg, gcsl, err := p.Parse()
+	if err != nil {
+		return fmt.Errorf("gtt stat response: parse config: %w", err)
+	}
+	if err := gtt.ApplyConfigDirectives(cfg, simcfg); err != nil {
+		return fmt.Errorf("gtt stat response: apply config directives: %w", err)
+	}
+	if err := gtt.ApplyWaveScenarioFile(opts.GTTWaveScenarioPath, simcfg); err != nil {
+		return fmt.Errorf("gtt stat response: apply wave scenario: %w", err)
+	}
+	if err := request.validate(len(simcfg.Characters)); err != nil {
+		return err
+	}
+
+	simcfg.Settings.Iterations = request.Iterations
+	simcfg.Settings.NumberOfWorkers = request.Workers
+	simcfg.Settings.IgnoreBurstEnergy = request.IgnoreBurstEnergy
+	simcfg.Settings.CollectStats = []string{""}
+
+	source, err := runGTTStatResponseObservation(
+		ctx, "source", nil, nil, cfg, file, simcfg, gcsl, opts, masterSeed,
+	)
+	if err != nil {
+		return err
+	}
+	baseline, err := runGTTStatResponseObservation(
+		ctx, "baseline", request.BaselineChanges, nil, cfg, file, simcfg, gcsl, opts, masterSeed,
+	)
+	if err != nil {
+		return err
+	}
+	if err := requireSameSeedPanel(source.Samples, baseline.Samples); err != nil {
+		return fmt.Errorf("gtt stat response baseline: %w", err)
+	}
+	baselineDelta := summarizeGTTStatResponsePairedDelta(source.Samples, baseline.Samples)
+	baseline.PairedDelta = &baselineDelta
+	seedPanelSHA256, err := responseSeedPanelSHA256(baseline.Samples)
+	if err != nil {
+		return err
+	}
+
+	observations := make([]GTTStatResponseObservation, 0, len(request.Interventions))
+	for _, intervention := range request.Interventions {
+		observation, err := runGTTStatResponseObservation(
+			ctx, intervention.ID, request.BaselineChanges, intervention.Changes, cfg, file, simcfg, gcsl, opts, masterSeed,
+		)
+		if err != nil {
+			return err
+		}
+		if err := requireSameSeedPanel(baseline.Samples, observation.Samples); err != nil {
+			return fmt.Errorf("gtt stat response intervention %q: %w", intervention.ID, err)
+		}
+		paired := summarizeGTTStatResponsePairedDelta(baseline.Samples, observation.Samples)
+		observation.PairedDelta = &paired
+		observations = append(observations, observation)
+	}
+
+	characterKeys := make([]string, len(simcfg.Characters))
+	for i, character := range simcfg.Characters {
+		characterKeys[i] = character.Base.Key.String()
+	}
+	output := GTTStatResponseOutput{
+		SchemaVersion:     GTTStatResponseSchemaVersion,
+		ContextSHA256:     request.ContextSHA256,
+		RequestSHA256:     requestSHA256,
+		Objective:         request.Objective,
+		IgnoreBurstEnergy: request.IgnoreBurstEnergy,
+		CharacterKeys:     characterKeys,
+		SeedPanelSHA256:   seedPanelSHA256,
+		Source:            source,
+		Baseline:          baseline,
+		Interventions:     observations,
+	}
+	return saveGTTStatResponseOutput(opts.ResultSaveToPath, output)
+}
+
+func loadGTTStatResponseRequest(path string) (GTTStatResponseRequest, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return GTTStatResponseRequest{}, fmt.Errorf("gtt stat response: read request %q: %w", path, err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var request GTTStatResponseRequest
+	if err := decoder.Decode(&request); err != nil {
+		return GTTStatResponseRequest{}, fmt.Errorf("gtt stat response: decode request %q: %w", path, err)
+	}
+	if err := requireJSONEOF(decoder); err != nil {
+		return GTTStatResponseRequest{}, fmt.Errorf("gtt stat response: decode request %q: %w", path, err)
+	}
+	return request, nil
+}
+
+func requireJSONEOF(decoder *json.Decoder) error {
+	var extra any
+	err := decoder.Decode(&extra)
+	if errors.Is(err, io.EOF) {
+		return nil
+	}
+	if err == nil {
+		return errors.New("multiple JSON values are not allowed")
+	}
+	return err
+}
+
+func (request GTTStatResponseRequest) validate(characterCount int) error {
+	if request.SchemaVersion != GTTStatResponseSchemaVersion {
+		return fmt.Errorf("gtt stat response: schema_version must be %d", GTTStatResponseSchemaVersion)
+	}
+	if len(request.ContextSHA256) != sha256.Size*2 {
+		return errors.New("gtt stat response: context_sha256 must be a lowercase SHA-256 digest")
+	}
+	if _, err := hex.DecodeString(request.ContextSHA256); err != nil || strings.ToLower(request.ContextSHA256) != request.ContextSHA256 {
+		return errors.New("gtt stat response: context_sha256 must be a lowercase SHA-256 digest")
+	}
+	if request.Objective != gttResponseObjectiveDPS && request.Objective != gttResponseObjectiveClear {
+		return errors.New("gtt stat response: objective must be dps or clear_time")
+	}
+	if request.Iterations < 1 || request.Iterations > 1024 {
+		return errors.New("gtt stat response: iterations must be between 1 and 1024")
+	}
+	if request.Workers < 1 || request.Workers > 64 || request.Workers > request.Iterations {
+		return errors.New("gtt stat response: workers must be between 1 and min(iterations, 64)")
+	}
+	if len(request.Interventions) > 256 {
+		return errors.New("gtt stat response: at most 256 interventions are allowed")
+	}
+	if err := validateGTTStatResponseChanges("baseline_changes", request.BaselineChanges, characterCount, true); err != nil {
+		return err
+	}
+	seenIDs := map[string]bool{"baseline": true}
+	for index, intervention := range request.Interventions {
+		if strings.TrimSpace(intervention.ID) == "" || intervention.ID != strings.TrimSpace(intervention.ID) {
+			return fmt.Errorf("gtt stat response: interventions[%d].id must be non-empty and trimmed", index)
+		}
+		if seenIDs[intervention.ID] {
+			return fmt.Errorf("gtt stat response: duplicate/reserved intervention id %q", intervention.ID)
+		}
+		seenIDs[intervention.ID] = true
+		if err := validateGTTStatResponseChanges("intervention "+strconv.Quote(intervention.ID), intervention.Changes, characterCount, false); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateGTTStatResponseChanges(label string, changes []GTTStatResponseChange, characterCount int, allowEmpty bool) error {
+	if (!allowEmpty && len(changes) == 0) || len(changes) > 128 {
+		return fmt.Errorf("gtt stat response: %s must contain %s128 changes", label, map[bool]string{true: "0..", false: "1.."}[allowEmpty])
+	}
+	seenChanges := make(map[string]bool)
+	for changeIndex, change := range changes {
+		if change.CharacterIndex < 0 || change.CharacterIndex >= characterCount {
+			return fmt.Errorf("gtt stat response: %s change %d character_index out of range", label, changeIndex)
+		}
+		stat := attributes.StrToStatType(change.Stat)
+		if stat <= attributes.NoStat || stat >= attributes.DelimBaseStat {
+			return fmt.Errorf("gtt stat response: %s change %d has unsupported stat %q", label, changeIndex, change.Stat)
+		}
+		if change.Mode != gttResponseChangeAdd && change.Mode != gttResponseChangeSet {
+			return fmt.Errorf("gtt stat response: %s change %d mode must be add or set", label, changeIndex)
+		}
+		if math.IsNaN(change.Value) || math.IsInf(change.Value, 0) {
+			return fmt.Errorf("gtt stat response: %s change %d value must be finite", label, changeIndex)
+		}
+		if change.Mode == gttResponseChangeSet && change.Value < 0 {
+			return fmt.Errorf("gtt stat response: %s change %d set value must be non-negative", label, changeIndex)
+		}
+		key := fmt.Sprintf("%d/%d", change.CharacterIndex, stat)
+		if seenChanges[key] {
+			return fmt.Errorf("gtt stat response: %s changes character/stat %s more than once", label, key)
+		}
+		seenChanges[key] = true
+	}
+	return nil
+}
+
+func runGTTStatResponseObservation(
+	ctx context.Context,
+	id string,
+	baselineChanges []GTTStatResponseChange,
+	changes []GTTStatResponseChange,
+	cfg string,
+	file *ast.File,
+	base *info.ActionList,
+	gcsl ast.Node,
+	opts simulator.Options,
+	masterSeed int64,
+) (GTTStatResponseObservation, error) {
+	simcfg := base.Copy()
+	if err := applyGTTStatResponseChanges(simcfg, baselineChanges); err != nil {
+		return GTTStatResponseObservation{}, fmt.Errorf("gtt stat response intervention %q baseline: %w", id, err)
+	}
+	if err := applyGTTStatResponseChanges(simcfg, changes); err != nil {
+		return GTTStatResponseObservation{}, fmt.Errorf("gtt stat response intervention %q: %w", id, err)
+	}
+	buffers := make([]optstats.CustomDamageStatsBuffer, 0, simcfg.Settings.Iterations)
+	_, err := optstats.RunWithConfigCustomStats(
+		ctx, cfg, file, simcfg, gcsl, opts, masterSeed,
+		optstats.OptimizerDmgStat,
+		func(buffer optstats.CustomDamageStatsBuffer) {
+			buffers = append(buffers, buffer)
+		},
+	)
+	if err != nil {
+		return GTTStatResponseObservation{}, fmt.Errorf("gtt stat response intervention %q: simulate: %w", id, err)
+	}
+	samples, err := responseSamplesFromBuffers(buffers, len(simcfg.Characters))
+	if err != nil {
+		return GTTStatResponseObservation{}, fmt.Errorf("gtt stat response intervention %q: %w", id, err)
+	}
+	return GTTStatResponseObservation{
+		ID:      id,
+		Samples: samples,
+		Summary: summarizeGTTStatResponseSamples(samples),
+	}, nil
+}
+
+func applyGTTStatResponseChanges(simcfg *info.ActionList, changes []GTTStatResponseChange) error {
+	for _, change := range changes {
+		stat := attributes.StrToStatType(change.Stat)
+		profile := &simcfg.Characters[change.CharacterIndex]
+		current := profile.Stats[stat]
+		switch change.Mode {
+		case gttResponseChangeAdd:
+			profile.Stats[stat] += change.Value
+		case gttResponseChangeSet:
+			profile.Stats[stat] = change.Value
+		default:
+			return fmt.Errorf("unsupported change mode %q", change.Mode)
+		}
+		if profile.Stats[stat] < 0 {
+			return fmt.Errorf("change %d/%s makes stat negative: %v -> %v", change.CharacterIndex, change.Stat, current, profile.Stats[stat])
+		}
+	}
+	return nil
+}
+
+func responseSamplesFromBuffers(buffers []optstats.CustomDamageStatsBuffer, characterCount int) ([]GTTStatResponseSample, error) {
+	if len(buffers) == 0 {
+		return nil, errors.New("no response samples completed")
+	}
+	slices.SortFunc(buffers, func(a, b optstats.CustomDamageStatsBuffer) int {
+		if a.Seed < b.Seed {
+			return -1
+		}
+		if a.Seed > b.Seed {
+			return 1
+		}
+		return 0
+	})
+	samples := make([]GTTStatResponseSample, len(buffers))
+	for i, buffer := range buffers {
+		if buffer.DurationFrames <= 0 {
+			return nil, fmt.Errorf("seed %d returned non-positive duration", buffer.Seed)
+		}
+		if len(buffer.ExpectedDmgCumu) != characterCount {
+			return nil, fmt.Errorf("seed %d returned %d character rows, expected %d", buffer.Seed, len(buffer.ExpectedDmgCumu), characterCount)
+		}
+		durationSeconds := float64(buffer.DurationFrames) / 60.0
+		characterDamage := slices.Clone(buffer.ExpectedDmgCumu)
+		characterDPS := make([]float64, characterCount)
+		teamDamage := 0.0
+		for characterIndex, damage := range characterDamage {
+			characterDPS[characterIndex] = damage / durationSeconds
+			teamDamage += damage
+		}
+		samples[i] = GTTStatResponseSample{
+			Seed:                    strconv.FormatInt(buffer.Seed, 10),
+			DurationFrames:          buffer.DurationFrames,
+			DurationSeconds:         durationSeconds,
+			TeamExpectedDamage:      teamDamage,
+			TeamExpectedDPS:         teamDamage / durationSeconds,
+			CharacterExpectedDamage: characterDamage,
+			CharacterExpectedDPS:    characterDPS,
+		}
+	}
+	return samples, nil
+}
+
+func summarizeGTTStatResponseSamples(samples []GTTStatResponseSample) GTTStatResponseSummary {
+	characterCount := len(samples[0].CharacterExpectedDPS)
+	duration := make([]float64, len(samples))
+	teamDamage := make([]float64, len(samples))
+	teamDPS := make([]float64, len(samples))
+	characterDPS := make([][]float64, characterCount)
+	for i, sample := range samples {
+		duration[i] = sample.DurationSeconds
+		teamDamage[i] = sample.TeamExpectedDamage
+		teamDPS[i] = sample.TeamExpectedDPS
+		for characterIndex, value := range sample.CharacterExpectedDPS {
+			characterDPS[characterIndex] = append(characterDPS[characterIndex], value)
+		}
+	}
+	characterEstimates := make([]GTTStatResponseEstimate, characterCount)
+	for i := range characterEstimates {
+		characterEstimates[i] = estimateGTTStatResponse(characterDPS[i])
+	}
+	return GTTStatResponseSummary{
+		DurationSeconds:      estimateGTTStatResponse(duration),
+		TeamExpectedDamage:   estimateGTTStatResponse(teamDamage),
+		TeamExpectedDPS:      estimateGTTStatResponse(teamDPS),
+		CharacterExpectedDPS: characterEstimates,
+	}
+}
+
+func summarizeGTTStatResponsePairedDelta(baseline, variant []GTTStatResponseSample) GTTStatResponseSummary {
+	characterCount := len(baseline[0].CharacterExpectedDPS)
+	duration := make([]float64, len(baseline))
+	teamDamage := make([]float64, len(baseline))
+	teamDPS := make([]float64, len(baseline))
+	characterDPS := make([][]float64, characterCount)
+	for i := range baseline {
+		duration[i] = variant[i].DurationSeconds - baseline[i].DurationSeconds
+		teamDamage[i] = variant[i].TeamExpectedDamage - baseline[i].TeamExpectedDamage
+		teamDPS[i] = variant[i].TeamExpectedDPS - baseline[i].TeamExpectedDPS
+		for characterIndex := range characterCount {
+			characterDPS[characterIndex] = append(
+				characterDPS[characterIndex],
+				variant[i].CharacterExpectedDPS[characterIndex]-baseline[i].CharacterExpectedDPS[characterIndex],
+			)
+		}
+	}
+	characterEstimates := make([]GTTStatResponseEstimate, characterCount)
+	for i := range characterEstimates {
+		characterEstimates[i] = estimateGTTStatResponse(characterDPS[i])
+	}
+	return GTTStatResponseSummary{
+		DurationSeconds:      estimateGTTStatResponse(duration),
+		TeamExpectedDamage:   estimateGTTStatResponse(teamDamage),
+		TeamExpectedDPS:      estimateGTTStatResponse(teamDPS),
+		CharacterExpectedDPS: characterEstimates,
+	}
+}
+
+func estimateGTTStatResponse(values []float64) GTTStatResponseEstimate {
+	count := len(values)
+	if count == 0 {
+		return GTTStatResponseEstimate{}
+	}
+	mean := 0.0
+	for _, value := range values {
+		mean += value
+	}
+	mean /= float64(count)
+	sampleSD := 0.0
+	if count > 1 {
+		for _, value := range values {
+			delta := value - mean
+			sampleSD += delta * delta
+		}
+		sampleSD = math.Sqrt(sampleSD / float64(count-1))
+	}
+	return GTTStatResponseEstimate{
+		Count:         count,
+		Mean:          mean,
+		SampleSD:      sampleSD,
+		StandardError: sampleSD / math.Sqrt(float64(count)),
+	}
+}
+
+func requireSameSeedPanel(baseline, variant []GTTStatResponseSample) error {
+	if len(baseline) != len(variant) {
+		return fmt.Errorf("seed panel size mismatch: %d != %d", len(baseline), len(variant))
+	}
+	for i := range baseline {
+		if baseline[i].Seed != variant[i].Seed {
+			return fmt.Errorf("seed mismatch at %d: %s != %s", i, baseline[i].Seed, variant[i].Seed)
+		}
+	}
+	return nil
+}
+
+func responseSeedPanelSHA256(samples []GTTStatResponseSample) (string, error) {
+	seeds := make([]string, len(samples))
+	for i, sample := range samples {
+		seeds[i] = sample.Seed
+	}
+	return canonicalSHA256(seeds)
+}
+
+func canonicalSHA256(value any) (string, error) {
+	payload, err := json.Marshal(value)
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func saveGTTStatResponseOutput(path string, output GTTStatResponseOutput) error {
+	payload, err := json.MarshalIndent(output, "", "  ")
+	if err != nil {
+		return fmt.Errorf("gtt stat response: encode output: %w", err)
+	}
+	payload = append(payload, '\n')
+	if err := os.WriteFile(path, payload, 0o644); err != nil {
+		return fmt.Errorf("gtt stat response: write output %q: %w", path, err)
+	}
+	return nil
+}
