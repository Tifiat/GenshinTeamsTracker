+package optimization
+
+import (
+	"math"
+	"strings"
+	"testing"
+)
+
+func TestGTTStatResponseRequestValidation(t *testing.T) {
+	request := GTTStatResponseRequest{
+		SchemaVersion:     GTTStatResponseSchemaVersion,
+		ContextSHA256:     strings.Repeat("a", 64),
+		Objective:         gttResponseObjectiveDPS,
+		Iterations:        8,
+		Workers:           4,
+		MasterSeed:        "123",
+		IgnoreBurstEnergy: true,
+		BaselineChanges: []GTTStatResponseChange{
+			{CharacterIndex: 0, Stat: "cr", Mode: "set", Value: 0.95},
+		},
+		Interventions: []GTTStatResponseIntervention{
+			{
+				ID: "furina/hp",
+				Changes: []GTTStatResponseChange{
+					{CharacterIndex: 1, Stat: "hp%", Mode: gttResponseChangeAdd, Value: 0.466},
+				},
+			},
+		},
+	}
+	if err := request.validate(4); err != nil {
+		t.Fatalf("valid request rejected: %v", err)
+	}
+
+	request.Interventions[0].Changes[0].Stat = "base_hp"
+	if err := request.validate(4); err == nil {
+		t.Fatal("base stat change should be rejected")
+	}
+}
+
+func TestGTTStatResponsePairedDeltaUsesSeedAlignedDifferences(t *testing.T) {
+	baseline := []GTTStatResponseSample{
+		responseTestSample("1", 10, 100, []float64{60, 40}),
+		responseTestSample("2", 20, 200, []float64{120, 80}),
+	}
+	variant := []GTTStatResponseSample{
+		responseTestSample("1", 9, 108, []float64{72, 36}),
+		responseTestSample("2", 18, 216, []float64{144, 72}),
+	}
+
+	delta := summarizeGTTStatResponsePairedDelta(baseline, variant)
+	if got, want := delta.TeamExpectedDPS.Mean, 2.0; math.Abs(got-want) > 1e-12 {
+		t.Fatalf("team paired DPS mean = %v, want %v", got, want)
+	}
+	if got, want := delta.DurationSeconds.Mean, -1.5; got != want {
+		t.Fatalf("duration paired mean = %v, want %v", got, want)
+	}
+	if got, want := delta.CharacterExpectedDPS[1].Mean, 0.0; got != want {
+		t.Fatalf("second character paired DPS mean = %v, want %v", got, want)
+	}
+}
+
+func TestGTTStatResponseSeedPanelMustMatch(t *testing.T) {
+	baseline := []GTTStatResponseSample{{Seed: "1"}, {Seed: "2"}}
+	variant := []GTTStatResponseSample{{Seed: "1"}, {Seed: "3"}}
+	if err := requireSameSeedPanel(baseline, variant); err == nil {
+		t.Fatal("mismatched seed panel should fail")
+	}
+}
+
+func responseTestSample(seed string, duration float64, damage float64, characterDamage []float64) GTTStatResponseSample {
+	characterDPS := make([]float64, len(characterDamage))
+	for i, value := range characterDamage {
+		characterDPS[i] = value / duration
+	}
+	return GTTStatResponseSample{
+		Seed:                    seed,
+		DurationFrames:          int(duration * 60),
+		DurationSeconds:         duration,
+		TeamExpectedDamage:      damage,
+		TeamExpectedDPS:         damage / duration,
+		CharacterExpectedDamage: characterDamage,
+		CharacterExpectedDPS:    characterDPS,
+	}
+}
