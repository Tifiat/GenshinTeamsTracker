+func TestGTTSetResponseChangeValidation(t *testing.T) {
+	request := GTTStatResponseRequest{
+		SchemaVersion:     GTTStatResponseSchemaVersion,
+		ContextSHA256:     strings.Repeat("b", 64),
+		Objective:         gttResponseObjectiveDPS,
+		Iterations:        8,
+		Workers:           1,
+		MasterSeed:        "123",
+		IgnoreBurstEnergy: true,
+		Interventions: []GTTStatResponseIntervention{
+			{
+				ID: "bennett/noblesse",
+				Changes: []GTTStatResponseChange{
+					{CharacterIndex: 3, SetKey: "noblesse", SetCount: 4},
+				},
+			},
+		},
+	}
+	if err := request.validate(4); err != nil {
+		t.Fatalf("valid set response rejected: %v", err)
+	}
+	request.Interventions[0].Changes[0].SetCount = 3
+	if err := request.validate(4); err == nil {
+		t.Fatal("invalid set count should be rejected")
+	}
+}
