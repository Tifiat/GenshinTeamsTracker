+func TestV6RealSavedStateRetainsCandidateStatInput(t *testing.T) {
+	root, _ := filepath.Abs(filepath.Join("..", ".."))
+	manifest, err := Generate(Options{
+		ModuleRoot: root,
+		Includes: []string{
+			"internal/characters/nilou/asc.go",
+			"internal/characters/nilou/nilou.go",
+			"internal/template/character/character.go",
+			"pkg/core/core.go",
+			"pkg/gtttrace/runtime.go",
+		},
+		Binding: testBinding(),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	overlay, err := BuildOverlay(
+		OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")},
+		manifest,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var nilouASC []byte
+	for _, file := range overlay.Files {
+		if _, err := parser.ParseFile(token.NewFileSet(), file.RelativeFile, file.Contents, parser.AllErrors); err != nil {
+			t.Fatalf("real overlay %s does not parse: %v", file.RelativeFile, err)
+		}
+		if file.RelativeFile == "internal/characters/nilou/asc.go" {
+			nilouASC = file.Contents
+		}
+	}
+	for _, marker := range [][]byte{
+		[]byte("GTTReadMaxHP"),
+		[]byte("RecordNumericStateWriteWithInputs"),
+		[]byte("a4Bonus"),
+	} {
+		if !bytes.Contains(nilouASC, marker) {
+			t.Fatalf("saved state overlay lacks candidate-stat lineage marker %s", marker)
+		}
+	}
+}
