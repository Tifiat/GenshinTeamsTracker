+// GTTEffectiveResistance and GTTEffectiveDefenseAdjustment expose the exact
+// target state used by damage calculation without scraping a debug log.
+func (e *Enemy) GTTEffectiveResistance(ai *info.AttackInfo) float64 {
+	r := e.resists[ai.Element]
+	for _, raw := range e.mods {
+		mod, ok := raw.(*info.ResistMod)
+		if ok && mod.Expiry() > e.Core.F && mod.Ele == ai.Element {
+			r += mod.Value
+		}
+	}
+	return r
+}
+
+func (e *Enemy) GTTEffectiveDefenseAdjustment() float64 {
+	r := 0.0
+	for _, raw := range e.mods {
+		mod, ok := raw.(*info.DefMod)
+		if ok && mod.Expiry() > e.Core.F {
+			r += mod.Value
+		}
+	}
+	if r > 0.9 {
+		return 0.9
+	}
+	return r
+}
+
+func (e *Enemy) GTTEffectiveDefenseMultiplier(atk *info.AttackEvent) float64 {
+	adj := e.GTTEffectiveDefenseAdjustment()
+	return float64(atk.Snapshot.CharLvl+100) /
+		(float64(atk.Snapshot.CharLvl+100) + float64(e.Level+100)*(1+adj)*(1-atk.Info.IgnoreDefPercent))
+}
