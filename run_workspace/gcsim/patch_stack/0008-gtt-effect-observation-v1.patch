 func TestGTTStatResponsePairedDeltaUsesSeedAlignedDifferences(t *testing.T) {
 	baseline := []GTTStatResponseSample{
 		responseTestSample("1", 10, 100, []float64{60, 40}),
diff --git a/new/pkg/optimization/optstats/effect_observation.go b/pkg/optimization/optstats/effect_observation.go
new file mode 100644
index 0000000..62229bb
--- /dev/null
+++ b/pkg/optimization/optstats/effect_observation.go
@@ -0,0 +1,151 @@
+package optstats
+
+import (
+	"math"
+	"slices"
+	"strconv"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/core/player/character"
+)
+
+type GTTEffectModifierTransition struct {
+	Frame          int                `json:"frame"`
+	CharacterIndex int                `json:"character_index"`
+	ModifierKey    string             `json:"modifier_key"`
+	Transition     string             `json:"transition"`
+	ExpiryFrame    int                `json:"expiry_frame"`
+	DurationFrames int                `json:"duration_frames"`
+	StatAmounts    map[string]float64 `json:"stat_amounts"`
+}
+
+type GTTEffectExposure struct {
+	CharacterIndex           int                          `json:"character_index"`
+	Element                  string                       `json:"element"`
+	AttackTag                int                          `json:"attack_tag"`
+	Reaction                 string                       `json:"reaction"`
+	TimeBucket               int                          `json:"time_bucket"`
+	ExpectedDamage           float64                      `json:"expected_damage"`
+	HitCount                 int                          `json:"hit_count"`
+	DamageWeightedSnapshot   map[string]float64           `json:"damage_weighted_snapshot_stats"`
+	DamageWeightedResistance float64                      `json:"damage_weighted_effective_resistance"`
+	DamageWeightedDefense    float64                      `json:"damage_weighted_effective_defense_multiplier"`
+	DamageWeightedReaction   float64                      `json:"damage_weighted_effective_reaction_multiplier"`
+	ActiveStatModifiers      []character.GTTEffectStatMod `json:"active_stat_modifiers"`
+}
+
+type GTTEffectObservationBuffer struct {
+	ExpectedDmgCumu []float64                     `json:"-"`
+	DurationFrames  int                           `json:"duration_frames"`
+	Seed            int64                         `json:"-"`
+	Exposures       []GTTEffectExposure           `json:"exposures"`
+	Transitions     []GTTEffectModifierTransition `json:"modifier_transitions"`
+	byKey           map[string]int
+}
+
+type gttTargetState interface {
+	GTTEffectiveResistance(*info.AttackInfo) float64
+	GTTEffectiveDefenseMultiplier(*info.AttackEvent) float64
+}
+
+func OptimizerEffectObservation(core *core.Core) (CollectorCustomStats[GTTEffectObservationBuffer], error) {
+	out := GTTEffectObservationBuffer{
+		ExpectedDmgCumu: make([]float64, len(core.Player.Chars())),
+		byKey:           make(map[string]int),
+	}
+	core.Events.Subscribe(event.OnGTTEffectModifierChange, func(args ...any) {
+		amount := make(map[string]float64)
+		for stat, value := range args[5].([]float64) {
+			if value != 0 {
+				amount[attributes.Stat(stat).String()] = value
+			}
+		}
+		out.Transitions = append(out.Transitions, GTTEffectModifierTransition{
+			Frame: core.F, CharacterIndex: args[0].(int), ModifierKey: args[1].(string),
+			Transition: args[2].(string), ExpiryFrame: args[3].(int),
+			DurationFrames: args[4].(int), StatAmounts: amount,
+		})
+	}, "gtt-effect-modifier-change")
+	core.Events.Subscribe(event.OnEnemyDamage, func(args ...any) {
+		target := args[0].(info.Target)
+		attack := args[1].(*info.AttackEvent)
+		damage := args[2].(float64)
+		crit := args[3].(bool)
+		if target.Type() != info.TargettableEnemy {
+			return
+		}
+		cr := math.Max(0, math.Min(1, attack.Snapshot.Stats[attributes.CR]))
+		cd := attack.Snapshot.Stats[attributes.CD]
+		if crit && 1+cd > 0 {
+			damage /= 1 + cd
+		}
+		expected := damage * (1 + cr*cd)
+		out.ExpectedDmgCumu[attack.Info.ActorIndex] += expected
+		reaction := string(attack.Info.AmpType)
+		if reaction == "" {
+			reaction = string(attack.Info.CatalyzedType)
+		}
+		reactionMult := 1.0
+		if attack.Info.Amped {
+			em := attack.Snapshot.Stats[attributes.EM]
+			reactionMult = attack.Info.AmpMult * (1 + (2.78*em)/(1400+em) + core.Player.ByIndex(attack.Info.ActorIndex).ReactBonus(attack.Info))
+		}
+		res, def := 0.0, 1.0
+		if state, ok := target.(gttTargetState); ok {
+			res = state.GTTEffectiveResistance(&attack.Info)
+			def = state.GTTEffectiveDefenseMultiplier(attack)
+		}
+		key := strconv.Itoa(attack.Info.ActorIndex) + "/" + attack.Info.Element.String() + "/" + strconv.Itoa(int(attack.Info.AttackTag)) + "/" + reaction + "/" + strconv.Itoa(core.F/60)
+		idx, exists := out.byKey[key]
+		if !exists {
+			idx = len(out.Exposures)
+			out.byKey[key] = idx
+			out.Exposures = append(out.Exposures, GTTEffectExposure{
+				CharacterIndex: attack.Info.ActorIndex, Element: attack.Info.Element.String(),
+				AttackTag: int(attack.Info.AttackTag), Reaction: reaction, TimeBucket: core.F / 60,
+				DamageWeightedSnapshot: make(map[string]float64),
+			})
+		}
+		row := &out.Exposures[idx]
+		row.ExpectedDamage += expected
+		row.HitCount++
+		for stat := attributes.Stat(1); stat < attributes.DelimBaseStat; stat++ {
+			row.DamageWeightedSnapshot[stat.String()] += expected * attack.Snapshot.Stats[stat]
+		}
+		row.DamageWeightedResistance += expected * res
+		row.DamageWeightedDefense += expected * def
+		row.DamageWeightedReaction += expected * reactionMult
+		row.ActiveStatModifiers = core.Player.ByIndex(attack.Info.ActorIndex).GTTActiveStatMods()
+	}, "gtt-effect-observation")
+	return &out, nil
+}
+
+func (b GTTEffectObservationBuffer) Flush(core *core.Core) GTTEffectObservationBuffer {
+	b.DurationFrames = core.F
+	b.Seed = core.Seed
+	for i := range b.Exposures {
+		row := &b.Exposures[i]
+		if row.ExpectedDamage > 0 {
+			for key, value := range row.DamageWeightedSnapshot {
+				row.DamageWeightedSnapshot[key] = value / row.ExpectedDamage
+			}
+			row.DamageWeightedResistance /= row.ExpectedDamage
+			row.DamageWeightedDefense /= row.ExpectedDamage
+			row.DamageWeightedReaction /= row.ExpectedDamage
+		}
+		slices.SortFunc(row.ActiveStatModifiers, func(a, b character.GTTEffectStatMod) int {
+			if a.Key < b.Key {
+				return -1
+			}
+			if a.Key > b.Key {
+				return 1
+			}
+			return 0
+		})
+	}
+	slices.SortFunc(b.Transitions, func(a, c GTTEffectModifierTransition) int { return a.Frame - c.Frame })
+	return b
+}
