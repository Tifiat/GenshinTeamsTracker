@@ -0,0 +1,244 @@
+package optimization
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gcs/ast"
+	"github.com/genshinsim/gcsim/pkg/gcs/parser"
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"github.com/genshinsim/gcsim/pkg/simulator"
+)
+
+const GTTEffectObservationSchemaVersion = 1
+
+type GTTEffectObservationRequest struct {
+	SchemaVersion     int                           `json:"schema_version"`
+	ContextSHA256     string                        `json:"context_sha256"`
+	Objective         string                        `json:"objective"`
+	Iterations        int                           `json:"iterations"`
+	Workers           int                           `json:"workers"`
+	MasterSeed        string                        `json:"master_seed"`
+	IgnoreBurstEnergy bool                          `json:"ignore_burst_energy"`
+	BaselineChanges   []GTTStatResponseChange       `json:"baseline_changes"`
+	Interventions     []GTTStatResponseIntervention `json:"interventions"`
+}
+
+type GTTEffectObservationSample struct {
+	Seed                    string                              `json:"seed"`
+	DurationFrames          int                                 `json:"duration_frames"`
+	DurationSeconds         float64                             `json:"duration_seconds"`
+	TeamExpectedDamage      float64                             `json:"team_expected_damage"`
+	TeamExpectedDPS         float64                             `json:"team_expected_dps"`
+	CharacterExpectedDamage []float64                           `json:"character_expected_damage"`
+	CharacterExpectedDPS    []float64                           `json:"character_expected_dps"`
+	EffectObservation       optstats.GTTEffectObservationBuffer `json:"effect_observation"`
+}
+
+type GTTEffectObservationRow struct {
+	ID          string                       `json:"id"`
+	Samples     []GTTEffectObservationSample `json:"samples"`
+	Summary     GTTStatResponseSummary       `json:"summary"`
+	PairedDelta *GTTStatResponseSummary      `json:"paired_delta,omitempty"`
+}
+
+type GTTEffectObservationOutput struct {
+	SchemaVersion   int                       `json:"schema_version"`
+	Capability      string                    `json:"capability"`
+	ContextSHA256   string                    `json:"context_sha256"`
+	RequestSHA256   string                    `json:"request_sha256"`
+	Objective       string                    `json:"objective"`
+	CharacterKeys   []string                  `json:"character_keys"`
+	SeedPanelSHA256 string                    `json:"seed_panel_sha256"`
+	Baseline        GTTEffectObservationRow   `json:"baseline"`
+	Interventions   []GTTEffectObservationRow `json:"interventions"`
+}
+
+func RunGTTEffectObservation(ctx context.Context, opts simulator.Options, requestPath string) error {
+	if strings.TrimSpace(opts.ResultSaveToPath) == "" {
+		return errors.New("gtt effect observation requires -out")
+	}
+	data, err := os.ReadFile(requestPath)
+	if err != nil {
+		return err
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	var request GTTEffectObservationRequest
+	if err := dec.Decode(&request); err != nil {
+		return fmt.Errorf("gtt effect observation: decode: %w", err)
+	}
+	if err := requireJSONEOF(dec); err != nil {
+		return err
+	}
+	if err := request.validate(); err != nil {
+		return err
+	}
+	requestSHA, err := canonicalSHA256(request)
+	if err != nil {
+		return err
+	}
+	masterSeed, _ := strconv.ParseInt(request.MasterSeed, 10, 64)
+	cfg, err := simulator.ReadConfig(opts.ConfigPath)
+	if err != nil {
+		return err
+	}
+	file := ast.NewFile()
+	p := parser.New(file, cfg)
+	simcfg, gcsl, err := p.Parse()
+	if err != nil {
+		return err
+	}
+	if err := gtt.ApplyConfigDirectives(cfg, simcfg); err != nil {
+		return err
+	}
+	if err := gtt.ApplyWaveScenarioFile(opts.GTTWaveScenarioPath, simcfg); err != nil {
+		return err
+	}
+	if err := validateGTTStatResponseChanges("baseline_changes", request.BaselineChanges, len(simcfg.Characters), true); err != nil {
+		return err
+	}
+	for _, row := range request.Interventions {
+		if err := validateGTTStatResponseChanges("intervention "+strconv.Quote(row.ID), row.Changes, len(simcfg.Characters), false); err != nil {
+			return err
+		}
+	}
+	simcfg.Settings.Iterations = request.Iterations
+	simcfg.Settings.NumberOfWorkers = request.Workers
+	simcfg.Settings.IgnoreBurstEnergy = request.IgnoreBurstEnergy
+	simcfg.Settings.CollectStats = []string{""}
+	baseline, err := runGTTEffectObservationRow(ctx, "baseline", request.BaselineChanges, nil, cfg, file, simcfg, gcsl, opts, masterSeed)
+	if err != nil {
+		return err
+	}
+	baseDamage := effectSamplesAsResponse(baseline.Samples)
+	seedSHA, err := responseSeedPanelSHA256(baseDamage)
+	if err != nil {
+		return err
+	}
+	rows := make([]GTTEffectObservationRow, 0, len(request.Interventions))
+	for _, intervention := range request.Interventions {
+		row, err := runGTTEffectObservationRow(ctx, intervention.ID, request.BaselineChanges, intervention.Changes, cfg, file, simcfg, gcsl, opts, masterSeed)
+		if err != nil {
+			return err
+		}
+		plain := effectSamplesAsResponse(row.Samples)
+		if err := requireSameSeedPanel(baseDamage, plain); err != nil {
+			return err
+		}
+		delta := summarizeGTTStatResponsePairedDelta(baseDamage, plain)
+		row.PairedDelta = &delta
+		rows = append(rows, row)
+	}
+	keys := make([]string, len(simcfg.Characters))
+	for i, c := range simcfg.Characters {
+		keys[i] = c.Base.Key.String()
+	}
+	out := GTTEffectObservationOutput{GTTEffectObservationSchemaVersion, "gtt_effect_observation_v1", request.ContextSHA256, requestSHA, request.Objective, keys, seedSHA, baseline, rows}
+	payload, err := json.MarshalIndent(out, "", "  ")
+	if err != nil {
+		return fmt.Errorf("gtt effect observation: encode output: %w", err)
+	}
+	payload = append(payload, '\n')
+	if err := os.WriteFile(opts.ResultSaveToPath, payload, 0o644); err != nil {
+		return fmt.Errorf("gtt effect observation: write output: %w", err)
+	}
+	return nil
+}
+
+func (r GTTEffectObservationRequest) validate() error {
+	if r.SchemaVersion != GTTEffectObservationSchemaVersion {
+		return errors.New("gtt effect observation: schema_version must be 1")
+	}
+	if len(r.ContextSHA256) != sha256.Size*2 {
+		return errors.New("gtt effect observation: invalid context_sha256")
+	}
+	if _, err := hex.DecodeString(r.ContextSHA256); err != nil || strings.ToLower(r.ContextSHA256) != r.ContextSHA256 {
+		return errors.New("gtt effect observation: invalid context_sha256")
+	}
+	if r.Objective != gttResponseObjectiveDPS && r.Objective != gttResponseObjectiveClear {
+		return errors.New("gtt effect observation: invalid objective")
+	}
+	if r.Iterations < 1 || r.Iterations > 1024 || r.Workers < 1 || r.Workers > r.Iterations || r.Workers > 64 {
+		return errors.New("gtt effect observation: invalid iterations/workers")
+	}
+	seed, err := strconv.ParseInt(r.MasterSeed, 10, 64)
+	if err != nil || seed <= 0 {
+		return errors.New("gtt effect observation: invalid master_seed")
+	}
+	if !r.IgnoreBurstEnergy {
+		return errors.New("gtt effect observation: ignore_burst_energy required")
+	}
+	if len(r.Interventions) > 256 {
+		return errors.New("gtt effect observation: at most 256 interventions")
+	}
+	seen := map[string]bool{"baseline": true}
+	for _, x := range r.Interventions {
+		if strings.TrimSpace(x.ID) != x.ID || x.ID == "" || seen[x.ID] {
+			return errors.New("gtt effect observation: invalid intervention id")
+		}
+		seen[x.ID] = true
+	}
+	return nil
+}
+
+func runGTTEffectObservationRow(ctx context.Context, id string, base, changes []GTTStatResponseChange, cfg string, file *ast.File, simcfg *info.ActionList, gcsl ast.Node, opts simulator.Options, seed int64) (GTTEffectObservationRow, error) {
+	copy := simcfg.Copy()
+	if err := applyGTTStatResponseChanges(copy, base); err != nil {
+		return GTTEffectObservationRow{}, err
+	}
+	if err := applyGTTStatResponseChanges(copy, changes); err != nil {
+		return GTTEffectObservationRow{}, err
+	}
+	buffers := make([]optstats.GTTEffectObservationBuffer, 0, copy.Settings.Iterations)
+	_, err := optstats.RunWithConfigCustomStats(ctx, cfg, file, copy, gcsl, opts, seed, optstats.OptimizerEffectObservation, func(b optstats.GTTEffectObservationBuffer) { buffers = append(buffers, b) })
+	if err != nil {
+		return GTTEffectObservationRow{}, err
+	}
+	slices.SortFunc(buffers, func(a, b optstats.GTTEffectObservationBuffer) int {
+		if a.Seed < b.Seed {
+			return -1
+		}
+		if a.Seed > b.Seed {
+			return 1
+		}
+		return 0
+	})
+	samples := make([]GTTEffectObservationSample, len(buffers))
+	plain := make([]GTTStatResponseSample, len(buffers))
+	for i, b := range buffers {
+		if b.DurationFrames <= 0 {
+			return GTTEffectObservationRow{}, errors.New("non-positive duration")
+		}
+		dur := float64(b.DurationFrames) / 60
+		chars := slices.Clone(b.ExpectedDmgCumu)
+		dps := make([]float64, len(chars))
+		team := 0.0
+		for j, v := range chars {
+			dps[j] = v / dur
+			team += v
+		}
+		samples[i] = GTTEffectObservationSample{strconv.FormatInt(b.Seed, 10), b.DurationFrames, dur, team, team / dur, chars, dps, b}
+		plain[i] = GTTStatResponseSample{strconv.FormatInt(b.Seed, 10), b.DurationFrames, dur, team, team / dur, chars, dps}
+	}
+	return GTTEffectObservationRow{ID: id, Samples: samples, Summary: summarizeGTTStatResponseSamples(plain)}, nil
+}
+
+func effectSamplesAsResponse(rows []GTTEffectObservationSample) []GTTStatResponseSample {
+	out := make([]GTTStatResponseSample, len(rows))
+	for i, x := range rows {
+		out[i] = GTTStatResponseSample{x.Seed, x.DurationFrames, x.DurationSeconds, x.TeamExpectedDamage, x.TeamExpectedDPS, x.CharacterExpectedDamage, x.CharacterExpectedDPS}
+	}
+	return out
+}
