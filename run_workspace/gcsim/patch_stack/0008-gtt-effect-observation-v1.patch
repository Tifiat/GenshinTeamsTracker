+func TestGTTSetCountCanonicalPresenceAndValidation(t *testing.T) {
+	statOnly := GTTStatResponseChange{CharacterIndex: 0, Stat: "cr", Mode: "add", Value: 0.1}
+	payload, err := json.Marshal(statOnly)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(payload), "set_key") || strings.Contains(string(payload), "set_count") {
+		t.Fatalf("stat-only change leaked set fields: %s", payload)
+	}
+	for _, count := range []int{0, 2, 4} {
+		original := GTTStatResponseChange{CharacterIndex: 0, SetKey: "noblesse", SetCount: testIntPtr(count)}
+		payload, err := json.Marshal(original)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(payload), `"set_count":`+strconv.Itoa(count)) {
+			t.Fatalf("explicit set_count lost: %s", payload)
+		}
+		var decoded GTTStatResponseChange
+		if err := json.Unmarshal(payload, &decoded); err != nil {
+			t.Fatal(err)
+		}
+		if decoded.SetCount == nil || *decoded.SetCount != count {
+			t.Fatalf("set_count %d did not survive decode", count)
+		}
+		if err := validateGTTStatResponseChanges("test", []GTTStatResponseChange{decoded}, 4, false); err != nil {
+			t.Fatalf("set_count %d rejected: %v", count, err)
+		}
+	}
+	if err := validateGTTStatResponseChanges("test", []GTTStatResponseChange{{CharacterIndex: 0, SetKey: "noblesse"}}, 4, false); err == nil {
+		t.Fatal("set_key without set_count accepted")
+	}
+	if err := validateGTTStatResponseChanges("test", []GTTStatResponseChange{{CharacterIndex: 0, SetCount: testIntPtr(0)}}, 4, false); err == nil {
+		t.Fatal("set_count without set_key accepted")
+	}
+}
