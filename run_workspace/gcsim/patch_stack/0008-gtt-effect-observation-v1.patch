+	statExpected := map[int]string{
+		0: "6a6ad6409975f3c564d30f396144b76782ac6d6406fcfe6f9a734a79ecfa508a",
+		2: "194252b86707c1179f0a4f7041ebf8d980c65c5263c27aa8ae65ee8991291baa",
+		4: "5132909fd5d181e8121df46719be5f49907db7a8558938a25376f6225783ffcb",
+	}
+	effectExpected := map[int]string{
+		0: "611e5326f3997205adc9efb576240bcacd44e310adecc17951604ff5e9d43dc6",
+		2: "dd8e17ac6da6026081f843d26dbfaed66d5842931591cadd0b332eccbb85f0f5",
+		4: "f68d12357cc4b4208df53ed0a49befa9601b6f2959bd2f419cfc81925fc368c5",
+	}
+	for _, count := range []int{0, 2, 4} {
+		t.Run(strconv.Itoa(count), func(t *testing.T) {
+			interventions := []GTTStatResponseIntervention{{
+				ID:      "set-" + strconv.Itoa(count),
+				Changes: []GTTStatResponseChange{{CharacterIndex: 0, SetKey: "noblesse", SetCount: testIntPtr(count)}},
+			}}
+			stat := GTTStatResponseRequest{SchemaVersion: 2, ContextSHA256: strings.Repeat("a", 64), Objective: "dps", Iterations: 8, Workers: 1, MasterSeed: "123", IgnoreBurstEnergy: true, BaselineChanges: []GTTStatResponseChange{}, Interventions: interventions}
+			effect := GTTEffectObservationRequest{SchemaVersion: 1, ContextSHA256: strings.Repeat("a", 64), Objective: "dps", Iterations: 8, Workers: 1, MasterSeed: "123", IgnoreBurstEnergy: true, BaselineChanges: []GTTStatResponseChange{}, Interventions: interventions}
+			statHash, err := canonicalSHA256(stat)
+			if err != nil {
+				t.Fatal(err)
+			}
+			effectHash, err := canonicalSHA256(effect)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if statHash != statExpected[count] {
+				t.Fatalf("stat hash %s != Python %s", statHash, statExpected[count])
+			}
+			if effectHash != effectExpected[count] {
+				t.Fatalf("effect hash %s != Python %s", effectHash, effectExpected[count])
+			}
+		})
+	}
+}
