+// observedModifierStateReadEdits preserves candidate lineage through opaque
+// modifier callbacks without pretending to compile their control flow.  It
+// instruments only executed return expressions that read proven numeric state
+// fields; the surrounding modifier dependency capture then binds those reads
+// to the observed modifier result.
+func observedModifierStateReadEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	root ast.Node,
+	entry SourceEntry,
+	receiver, traceExpr, scope string,
+) ([]textEdit, bool, error) {
+	fn, ok := root.(*ast.FuncLit)
+	if !ok {
+		return nil, false, fmt.Errorf("modifier %s root is not a function", entry.LookupKey)
+	}
+	allowlist := make(map[string]struct{}, len(entry.observedModifierFields))
+	for _, field := range entry.observedModifierFields {
+		allowlist[field] = struct{}{}
+	}
+	edits := make([]textEdit, 0)
+	matched := 0
+	ast.Inspect(fn.Body, func(node ast.Node) bool {
+		ret, ok := node.(*ast.ReturnStmt)
+		if !ok || len(ret.Results) != 1 {
+			return true
+		}
+		fields := sortedFieldSet(receiverFields(ret.Results[0], receiver))
+		if len(fields) == 0 {
+			return true
+		}
+		for _, field := range fields {
+			if _, proven := allowlist[field]; !proven {
+				return true
+			}
+		}
+		indent := indentationBefore(data, tokenFile.Offset(ret.Pos()))
+		prefix := "gttV6_" + entry.SourceID[:10] + "_observed_" + strconv.Itoa(matched)
+		matched++
+		valueByField := make(map[string]string, len(fields))
+		var declarations strings.Builder
+		for index, field := range fields {
+			valueName := prefix + "_read_" + strconv.Itoa(index)
+			slotName := prefix + "_slot_" + strconv.Itoa(index)
+			valueByField[field] = valueName
+			fmt.Fprintf(&declarations, "%s := %s.%s\n%s", valueName, receiver, field, indent)
+			fmt.Fprintf(&declarations, "%s := %s.RegisterNumericStateSlot(%s,%s.Current(),%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				slotName, traceExpr, strconv.Quote(scope), traceExpr, strconv.Quote(field), valueName,
+				traceImportAlias, strconv.Quote("modifier_state_slot_candidate_dependency_incomplete"), indent)
+			fmt.Fprintf(&declarations, "_ = %s.RecordNumericStateRead(%s,%s,float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				traceExpr, slotName, strconv.Quote(entry.SourceID), valueName,
+				traceImportAlias, strconv.Quote("modifier_state_read_candidate_dependency_incomplete"), indent)
+		}
+		expression := rootText(fset, ret.Results[0])
+		expression, err := replaceReceiverFieldSelectors(expression, receiver, valueByField)
+		if err != nil {
+			return true
+		}
+		outputName := prefix + "_output"
+		fmt.Fprintf(&declarations, "%s := %s\n%s", outputName, expression, indent)
+		edits = append(edits,
+			textEdit{start: tokenFile.Offset(ret.Pos()), end: tokenFile.Offset(ret.Pos()), replacement: declarations.String()},
+			textEdit{start: tokenFile.Offset(ret.Results[0].Pos()), end: tokenFile.Offset(ret.Results[0].End()), replacement: outputName},
+		)
+		return true
+	})
+	if matched == 0 {
+		return nil, false, fmt.Errorf("modifier %s has no observed numeric state return", entry.LookupKey)
+	}
+	return edits, true, nil
+}
