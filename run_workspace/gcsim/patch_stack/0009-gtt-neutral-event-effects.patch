diff --git a/pkg/gtttrace/stat_query.go b/pkg/gtttrace/stat_query.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/stat_query.go
@@ -0,0 +1,60 @@
+package gtttrace
+
+// A query belongs to the instant at which gameplay evaluated its getter, not
+// the later use of a saved snapshot. It records identity and Extra filtering
+// only: it does not prove a changed set's lifecycle or call any modifier again.
+type StatQueryContext struct {
+	runtime  *Runtime
+	id       uint64
+	frame    int
+	sequence int
+	order    uint64
+	nonExtra bool
+	selectedKeys *[]string
+}
+
+func (r *Runtime) NewStatQuery(nonExtra bool) StatQueryContext {
+	if !r.Enabled() || r.nextStatQueryID >= 1<<53-1 {
+		return StatQueryContext{}
+	}
+	r.nextStatQueryID++
+	return StatQueryContext{runtime: r, id: r.nextStatQueryID, frame: r.Frame(), sequence: len(r.stateEvents), order: r.NextNeutralObservationOrder(), nonExtra: nonExtra}
+}
+
+func (r *Runtime) RecordStatQuery(owner int, key string, value float64, modifiers []string, query StatQueryContext) string {
+	if !r.Enabled() || query.runtime != r || query.id == 0 || owner < 0 || key == "" || !finite(value) {
+		return ""
+	}
+	mode := "stat"
+	if query.nonExtra {
+		mode = "non_extra_stat"
+	}
+	row := StateEvent{
+		Frame: r.Frame(), Kind: StateEventNumericEval, OwnerIndex: optionalInt(owner),
+		Operation: optionalString("artifact_stat_read"), Key: optionalString(key),
+		Channel: optionalString("stat_input:" + mode),
+		Value: optionalFloat(value), ModifierEvalIDs: modifiers,
+		CandidateDependencyComplete: false, UncertaintyCodes: []string{"stat_read_external_dependencies_incomplete"},
+	}
+	query.annotate(&row)
+	return r.appendStateEvent(row)
+}
+
+// Selected queries differ from a full snapshot even if their output numbers
+// coincide: AffectedStat controls which modifier closures are evaluated.
+func (r *Runtime) NewSelectedStatQuery(nonExtra bool, keys []string) StatQueryContext {
+	q := r.NewStatQuery(nonExtra)
+	copy := append([]string{}, keys...)
+	q.selectedKeys = &copy
+	return q
+}
+func (q StatQueryContext) annotate(row *StateEvent) {
+	if q.id == 0 { return }
+	row.NeutralStatKeys = q.selectedKeys
+	payload := func(key string, value float64) NumericPayload {
+		return NumericPayload{Key: key, Value: value, Reference: LiteralRef(value)}
+	}
+	row.NumericPayload = append(row.NumericPayload,
+		payload("stat_query_id", float64(q.id)), payload("stat_query_frame", float64(q.frame)),
+		payload("stat_query_sequence", float64(q.sequence)), payload("stat_query_order", float64(q.order)))
+}
