+}
+
+func TestNeutralElementInputUsesEngineStatLabel(t *testing.T) {
+	b := &nodeBuilder{neutral: true, inputPoint: NeutralInputPoint{Mode: "snapshot", Order: 1}}
+	b.artifactDelta("owner", "physical%")
+	if len(b.neutralInputs) != 1 || b.neutralInputs[0].Stat != "phys%" { t.Fatal(b.neutralInputs) }
