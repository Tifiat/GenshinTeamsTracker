+
+func TestNeutralHitIdentityValidation(t *testing.T) {
+	for _, ids := range [][]uint64{{1, 2, 3}, {2, 1, 3}, {2, 5, 1}} {
+		hits := make([]info.GTTTraceHit, len(ids))
+		for i, id := range ids { hits[i] = info.GTTTraceHit{HitID:id, AttackID:7} }
+		before := append([]info.GTTTraceHit(nil), hits...)
+		if err := validateGTTTraceHitIdentities(hits); err != nil { t.Fatal(ids, err) }
+		if !reflect.DeepEqual(hits, before) { t.Fatal("validator changed observations/identities") }
+	}
+	for _, hits := range [][]info.GTTTraceHit{
+		{{HitID:0, AttackID:7}}, {{HitID:1, AttackID:0}},
+		{{HitID:2, AttackID:7}, {HitID:2, AttackID:8}},
+	} {
+		if validateGTTTraceHitIdentities(hits) == nil { t.Fatal("accepted invalid identity", hits) }
+	}
+}
