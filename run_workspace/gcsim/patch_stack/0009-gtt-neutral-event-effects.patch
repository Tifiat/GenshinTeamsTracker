diff --git a/pkg/gtttrace/combat_events.go b/pkg/gtttrace/combat_events.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/combat_events.go
@@ -0,0 +1,86 @@
+package gtttrace
+
+// Subscription-independent, observation-only event tape. Values are copied at
+// emission, before callbacks; no Amount/getter/task is executed to reconstruct
+// missing gameplay. Unknown payloads and truncation are explicit boundaries.
+type EventValue struct {
+	Kind string `json:"kind"`
+	Type string `json:"type,omitempty"`
+	Number float64 `json:"number,omitempty"`
+	Text string `json:"text,omitempty"`
+	Boolean bool `json:"boolean,omitempty"`
+	Fields map[string]EventValue `json:"fields,omitempty"`
+	Items []EventValue `json:"items,omitempty"`
+}
+type CombatEvent struct {
+	Order uint64 `json:"order"`
+	EndOrder uint64 `json:"end_order"`
+	ParentOrder uint64 `json:"parent_order"`
+	Frame int `json:"frame"`
+	Event int `json:"event"`
+	Active int `json:"active"`
+	StateSequence int `json:"state_sequence"`
+	Provider Provider `json:"provider"`
+	Arguments []EventValue `json:"arguments"`
+}
+type CombatEventLedger struct {
+	Events []CombatEvent `json:"events"`
+	Truncated bool `json:"truncated"`
+}
+const maxCombatEventRows = 100000
+
+func (r *Runtime) BindActiveIndex(active func() int) {
+	if r != nil { r.combatActive = active }
+}
+func (r *Runtime) NextObservationOrder() uint64 {
+	if !r.Enabled() { return 0 }
+	r.observationOrder++
+	return r.observationOrder
+}
+func (r *Runtime) BeginCombatEvent(event int, args []EventValue) uint64 {
+	if !r.NeutralEnabled() { return 0 }
+	order := r.NextNeutralObservationOrder()
+	if len(r.combatEvents) >= maxCombatEventRows {
+		r.combatEventsTruncated = true
+		return 0
+	}
+	active, parent := -1, uint64(0)
+	if r.combatActive != nil { active = r.combatActive() }
+	if n := len(r.combatEventStack); n > 0 { parent = r.combatEvents[r.combatEventStack[n-1]].Order }
+	row := CombatEvent{Order: order, ParentOrder: parent, Frame: r.Frame(),
+		Event: event, Active: active, StateSequence: len(r.stateEvents),
+		Provider: r.Current(), Arguments: cloneEventValues(args)}
+	r.combatEventStack = append(r.combatEventStack, len(r.combatEvents))
+	r.combatEvents = append(r.combatEvents, row)
+	return order
+}
+func (r *Runtime) EndCombatEvent(order uint64) {
+	if !r.Enabled() || order == 0 { return }
+	n := len(r.combatEventStack)
+	if n == 0 || r.combatEvents[r.combatEventStack[n-1]].Order != order {
+		r.combatEventsTruncated = true
+		return
+	}
+	r.combatEvents[r.combatEventStack[n-1]].EndOrder = r.NextObservationOrder()
+	r.combatEventStack = r.combatEventStack[:n-1]
+}
+func (r *Runtime) CombatEvents() CombatEventLedger {
+	out := CombatEventLedger{Events: []CombatEvent{}}
+	if r == nil { return out }
+	out.Truncated = r.combatEventsTruncated || len(r.combatEventStack) != 0
+	out.Events = append(out.Events, r.combatEvents...)
+	for i := range out.Events { out.Events[i].Arguments = cloneEventValues(out.Events[i].Arguments) }
+	return out
+}
+func cloneEventValues(values []EventValue) []EventValue {
+	out := make([]EventValue, len(values))
+	for i, v := range values {
+		out[i] = v
+		if v.Items != nil { out[i].Items = cloneEventValues(v.Items) }
+		if v.Fields != nil {
+			out[i].Fields = make(map[string]EventValue, len(v.Fields))
+			for k, f := range v.Fields { out[i].Fields[k] = cloneEventValues([]EventValue{f})[0] }
+		}
+	}
+	return out
+}
