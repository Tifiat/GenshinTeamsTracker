@@ -0,0 +1,25 @@
+package gttsourcegen
+import("go/ast";"go/parser";"go/token";"strings";"testing")
+func TestHealthClosureCapturesBeforeDelayedConsumer(t *testing.T){
+ source:=`package arbitrary
+ import "github.com/genshinsim/gcsim/pkg/core/info"
+ func(p *provider) makeHeal()func(){
+  amount:=p.MaxHP()*0.2
+  bonus:=p.NonExtraStat(attributes.Heal)
+  changeState()
+  return func(){p.Core.Player.Heal(info.HealInfo{Caller:p.Index(),Src:amount,Bonus:bonus})}
+ }`
+ fs:=token.NewFileSet();file,err:=parser.ParseFile(fs,"test.go",source,parser.SkipObjectResolution);if err!=nil{t.Fatal(err)}
+ fn:=file.Decls[1].(*ast.FuncDecl);var lit *ast.CompositeLit
+ ast.Inspect(fn,func(n ast.Node)bool{if x,ok:=n.(*ast.CompositeLit);ok{lit=x};return true})
+ entry:=SourceEntry{SourceID:strings.Repeat("a",64),healthInput:&healthInputPlan{ValueField:"Src"}}
+ edits,ok:=typedHealthInputEdits(fs,fs.File(file.Pos()),[]byte(source),file,fn,lit,entry,"p.Core.GTTTrace")
+ if !ok{t.Fatal("outer lexical definition was rejected")}
+ out,err:=applyTextEdits([]byte(source),edits);if err!=nil{t.Fatal(err)}
+ if _,err=parser.ParseFile(token.NewFileSet(),"out.go",out,0);err!=nil{t.Fatal(err,string(out))}
+ text:=string(out)
+ for _,name:=range []string{"GTTReadMaxHP(","GTTReadNonExtraStat("}{
+  if strings.Count(text,name)!=1||strings.Index(text,name)>strings.Index(text,"changeState()"){t.Fatal(name,text)}
+ }
+ if strings.Count(text,"GTTTraceBonusEventID:")!=1{t.Fatal(text)}
+}
