+package gttcompact
+
+import (
+	"sort"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+type NeutralReadRoot struct {
+	NodeID uint32 `json:"node_id"`
+	Owner string `json:"owner"`
+	Stat string `json:"stat"`
+	Observed string `json:"observed"`
+	Point NeutralInputPoint `json:"point"`
+	Projection bool `json:"projection"`
+	Uncertainty []string `json:"uncertainty"`
+}
+func(c *supportCompiler) compileNeutralStatReads(){
+	rows:=append([]gtttrace.NeutralStatObservation{},c.buffer.NeutralStatObservations...)
+	sort.SliceStable(rows,func(i,j int)bool{return rows[i].Order<rows[j].Order})
+	for _,row:=range rows{
+		if row.Owner<0||row.Owner>=len(c.characterKeys)||row.Order==0{continue}
+		c.compileNeutralVector(row,false)
+		// Removing already observed Extra amounts is a projection of this
+		// full-vector query, NOT an exact new single-stat NonExtraStat query.
+		if row.Mode=="stat"&&row.ExtraModifiers!=nil{c.compileNeutralVector(row,true)}
+	}
+}
+func(c *supportCompiler) compileNeutralVector(row gtttrace.NeutralStatObservation,projection bool){
+	excluded:=map[string]bool{}
+	mode:=row.Mode
+	if projection {
+		mode="non_extra_stat"
+		for _,id:=range *row.ExtraModifiers{excluded[id]=true}
+	}
+	keys:=make([]string,0,len(row.Values))
+	for key:=range row.Values{if key!=""{keys=append(keys,key)}}
+	sort.Strings(keys)
+	for _,key:=range keys{
+		observed:=row.Values[key]
+		if projection {for id:=range excluded{observed-=c.eventByID[id].Output[key]}}
+		actor:=c.characterKeys[row.Owner]
+		node:=c.b.constant(observed)
+		// This root excludes the DIRECT set contribution, supplied by the rule
+		// getter itself. Nested neutral buff ancestry still keeps its own ports.
+		if artifactVariableStat(key){
+			neutral:=c.b.neutral;c.b.neutral=false
+			raw:=c.b.artifactDelta(actor,key)
+			c.b.neutral=neutral
+			node=c.b.add(node,raw)
+		}
+		unknown:=[]string{}
+		for _,id:=range row.Modifiers{
+			if excluded[id]{continue}
+			event,ok:=c.eventByID[id]
+			if !ok{unknown=append(unknown,"neutral_modifier_observation_missing");continue}
+			if candidate,ok:=c.eventOutputs[id][key];ok{
+				node=c.b.add(node,c.b.subtract(candidate,c.b.constant(event.Output[key])))
+			}else if _,has:=event.Output[key];has{
+				unknown=append(unknown,"neutral_modifier_stat_expression_missing")
+			}
+		}
+		c.b.neutralReads=append(c.b.neutralReads,NeutralReadRoot{NodeID:node.id,Owner:actor,Stat:key,Observed:decimal(observed),Point:NeutralInputPoint{Frame:row.Frame,Order:row.Order,Mode:mode,StatKeys:row.Keys},Projection:projection,Uncertainty:unknown})
+	}
+}
