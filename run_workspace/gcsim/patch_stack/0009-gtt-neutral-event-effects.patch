diff --git a/pkg/core/event/gtt_combat_event_test.go b/pkg/core/event/gtt_combat_event_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/event/gtt_combat_event_test.go
@@ -0,0 +1,59 @@
+package event
+
+import (
+	"testing"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestNeutralEventWithoutSubscriptionAndNestedOrder(t *testing.T) {
+	rt := gtttrace.NewRuntime()
+	rt.Enable()
+	frame, active := 10, 2
+	rt.BindFrame(&frame)
+	rt.BindActiveIndex(func() int { return active })
+	h := New(rt)
+	h.Emit(OnSwirlElectro, 7, &info.AttackEvent{Info: info.AttackInfo{ActorIndex: 2}})
+	first := rt.CombatEvents()
+	if len(first.Events) != 1 || first.Events[0].Event != int(OnSwirlElectro) || first.Events[0].Active != 2 {
+		t.Fatal("unsubscribed reaction was lost", first)
+	}
+	calls := 0
+	h.Subscribe(OnNightsoulConsume, func(args ...any) {
+		calls++
+		h.Emit(OnCharacterSwap, 2, 1)
+	}, "test-only")
+	h.Emit(OnNightsoulConsume, 2, 1.0)
+	rows := rt.CombatEvents().Events
+	if calls != 1 || len(rows) != 3 || rows[2].ParentOrder != rows[1].Order ||
+		rows[2].EndOrder >= rows[1].EndOrder || rows[0].EndOrder >= rows[1].Order {
+		t.Fatal("event observation repeated or reordered gameplay", calls, rows)
+	}
+}
+
+func TestNeutralEventPayloadCapturedBeforeMutation(t *testing.T) {
+	rt := gtttrace.NewRuntime()
+	rt.Enable()
+	h := New(rt)
+	atk := &info.AttackEvent{Info: info.AttackInfo{ActorIndex: 1, FlatDmg: 3}}
+	h.Subscribe(OnApplyAttack, func(args ...any) { args[0].(*info.AttackEvent).Info.FlatDmg = 9 }, "mutate")
+	h.Emit(OnApplyAttack, atk)
+	row := rt.CombatEvents().Events[0]
+	if row.Arguments[0].Fields["Info"].Fields["FlatDmg"].Number != 3 || atk.Info.FlatDmg != 9 {
+		t.Fatal("stored payload aliases gameplay")
+	}
+	row.Arguments[0].Fields["Info"].Fields["FlatDmg"] = gtttrace.EventValue{Kind: "number", Number: 77}
+	if rt.CombatEvents().Events[0].Arguments[0].Fields["Info"].Fields["FlatDmg"].Number != 3 {
+		t.Fatal("export mutated retained tape")
+	}
+}
+
+func TestNeutralEventDisabledAndUnknownPayload(t *testing.T) {
+	rt := gtttrace.NewRuntime()
+	h := New(rt)
+	h.Emit(OnTick)
+	if len(rt.CombatEvents().Events) != 0 { t.Fatal("ordinary simulation allocated event evidence") }
+	rt.Enable()
+	h.Emit(OnTick, func(){})
+	if rt.CombatEvents().Events[0].Arguments[0].Kind != "unknown" { t.Fatal("unknown payload silently erased") }
+}
