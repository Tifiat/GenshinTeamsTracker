+package gtttrace
+
+import "testing"
+
+func TestParametricStatQueryIdentityAndCaptureTime(t *testing.T) {
+	r := NewRuntime()
+	r.Enable()
+	frame := 10
+	r.BindFrame(&frame)
+	q := r.NewStatQuery(true)
+	frame = 35
+	a := r.RecordStatQuery(2, "em", 125, nil, q)
+	b := r.RecordStatQuery(2, "em", 125, nil, q)
+	if a == "" || a == b {
+		t.Fatal("source uses must retain separate event identities")
+	}
+	rows := r.StateEvents()
+	for _, row := range rows {
+		if row.Channel == nil || *row.Channel != "stat_input:non_extra_stat" || row.Frame != 35 ||
+			row.NumericPayload[0].Value != 1 || row.NumericPayload[1].Value != 10 ||
+			row.NumericPayload[2].Value != 0 || row.CandidateDependencyComplete {
+			t.Fatal("query time/filter lost or unproved replacement accepted", row)
+		}
+	}
+	r.RecordArtifactStatRead(2, "em", 125, nil)
+	rows = r.StateEvents()
+	last := rows[len(rows)-1]
+	if *last.Channel != "stat_input:stat" || last.NumericPayload[0].Value != 2 || last.NumericPayload[1].Value != 35 {
+		t.Fatal("equal values merged distinct reads", last)
+	}
+	other := NewRuntime()
+	other.Enable()
+	if other.RecordStatQuery(2, "em", 125, nil, q) != "" {
+		t.Fatal("foreign runtime query accepted")
+	}
+	var disabled *Runtime
+	if disabled.RecordArtifactStatRead(0, "em", 1, nil) != "" {
+		t.Fatal("disabled trace produced evidence")
+	}
+}
