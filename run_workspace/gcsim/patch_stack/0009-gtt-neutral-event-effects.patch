--- /dev/null
+++ b/pkg/core/info/gtt_live_stats.go
@@ -0,0 +1,49 @@
+package info
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+// GTTReadStats keeps a raw Stats() array's ordinary Stat query at the getter
+// site while returning the same gameplay values exactly once. The fallback is
+// used unchanged when tracing or typed owner provenance is unavailable.
+func GTTReadStats(rt *gtttrace.Runtime, owner any, fallback func() ([attributes.EndStatType]float64, []any)) ([attributes.EndStatType]float64, []any, *GTTStatsOrigin) {
+	if rt == nil || !rt.Enabled() {
+		stats, debug := fallback()
+		return stats, debug, nil
+	}
+	c, ok := owner.(interface {
+		Index() int
+		GTTStats() ([attributes.EndStatType]float64, []any, []GTTTraceStatContribution)
+	})
+	if !ok || GTTStatOwnerRuntime(owner) != rt {
+		stats, debug := fallback()
+		return stats, debug, nil
+	}
+	query := rt.NewStatQuery(false)
+	stats, debug, contributions := c.GTTStats()
+	origin := GTTNewStatsOrigin(rt, c.Index(), attributes.Stats(stats), contributions, query)
+	return stats, debug, origin
+}
+
+// GTTStatsCellRef relates an already-observed array cell to the original
+// ordinary Stats() query. Mutation or owner/query mismatch stays frozen.
+func GTTStatsCellRef(rt *gtttrace.Runtime, origin *GTTStatsOrigin, values [attributes.EndStatType]float64, key attributes.Stat, observed float64) gtttrace.NumericRef {
+	freeze := func() gtttrace.NumericRef {
+		if rt == nil || !rt.Enabled() {
+			return gtttrace.LiteralRef(observed)
+		}
+		return gtttrace.EventRef(rt.RecordNumericEval("", "frozen_attack_operand", nil, observed, gtttrace.IncompleteEvidence("stats_container_origin_unproven_or_mutated")))
+	}
+	if rt == nil || !rt.Enabled() {
+		return gtttrace.LiteralRef(observed)
+	}
+	if origin == nil || origin.runtime != rt || origin.Values != attributes.Stats(values) || key <= attributes.NoStat || key >= attributes.EndStatType || values[key] != observed {
+		return freeze()
+	}
+	if key >= attributes.DelimBaseStat {
+		return gtttrace.LiteralRef(observed)
+	}
+	return gtttrace.EventRef(rt.RecordStatQuery(origin.Owner, key.String(), observed, origin.ModifierIDs, origin.query))
+}
