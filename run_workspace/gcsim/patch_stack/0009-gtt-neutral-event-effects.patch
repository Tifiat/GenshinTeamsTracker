+package gtttrace
+import "testing"
+func TestHitIdentityIsPerCoreAndTraceOnly(t *testing.T) {
+ var absent *Runtime
+ if absent.NextHitID()!=0 {t.Fatal("nil trace allocated an ID")}
+ a,b:=NewRuntime(),NewRuntime()
+ if a.NextHitID()!=0 {t.Fatal("disabled trace allocated an ID")}
+ a.Enable();b.Enable()
+ for i:=uint64(1);i<=100;i++ {if a.NextHitID()!=i {t.Fatal("nonunique hit ID")}}
+ if b.NextHitID()!=1 {t.Fatal("identity leaked across simulations")}
+ if a.NextObservationOrder()!=1 {t.Fatal("hit numbering changed event order")}
+}
