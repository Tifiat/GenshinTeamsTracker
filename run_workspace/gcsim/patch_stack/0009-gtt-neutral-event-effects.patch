+// Original getter query retained by value, before any modifier Amount executes.
+func GTTStatsOriginAtQuery(rt *gtttrace.Runtime, owner int, values attributes.Stats, ids []string, query gtttrace.StatQueryContext, extraIDs ...[]string) *GTTStatsOrigin {
+	if !rt.Enabled() { return nil }
+	if rt.NeutralEnabled() {
+	observed:=map[string]float64{}
+	if keys:=query.SelectedKeys();keys!=nil {
+		for _,key:=range *keys {
+			for stat:=attributes.NoStat+1;stat<attributes.EndStatType;stat++ {
+				if stat.String()==key {observed[key]=values[stat];break}
+			}
+		}
+	} else {
+		for stat:=attributes.NoStat+1;stat<attributes.EndStatType;stat++ {observed[stat.String()]=values[stat]}
+	}
+	rt.RecordNeutralStatVector(owner,observed,ids,query,extraIDs...)
+	}
+	return &GTTStatsOrigin{runtime: rt, query: query, Owner: owner, Values: values, ModifierIDs: append([]string(nil), ids...)}
+}
+func GTTNewSelectedStatQuery(rt *gtttrace.Runtime, nonExtra bool, keys ...attributes.Stat) gtttrace.StatQueryContext {
+	names := make([]string, len(keys))
+	for i, key := range keys { names[i] = key.String() }
+	return rt.NewSelectedStatQuery(nonExtra, names)
+}
