+++ b/pkg/gtttrace/neutral_stat_reads.go
@@ -0,0 +1,34 @@
+package gtttrace
+
+// Already-computed stat vectors, never a new Amount/getter evaluation. These
+// latent inputs may become damage-relevant after changing an artifact bonus.
+type NeutralStatObservation struct {
+	Owner int
+	Order uint64
+	Frame int
+	Mode string
+	Keys *[]string
+	Values map[string]float64
+	Modifiers []string
+	ExtraModifiers *[]string
+}
+func (r *Runtime) RecordNeutralStatVector(owner int, values map[string]float64, modifiers []string, q StatQueryContext, extra ...[]string) {
+	if !r.NeutralEnabled() || q.runtime!=r || q.id==0 || owner<0 { return }
+	if len(r.neutralStatObservations)>=20000 { r.neutralStatObservationsTruncated=true;return }
+	mode:="stat";if q.nonExtra {mode="non_extra_stat"}
+	copied:=make(map[string]float64,len(values))
+	for key,value:=range values {
+		if !finite(value) {r.neutralStatObservationsTruncated=true;return}
+		copied[key]=value
+	}
+	row:=NeutralStatObservation{Owner:owner,Order:q.order,Frame:q.frame,Mode:mode,Keys:q.selectedKeys,Values:copied,Modifiers:append([]string{},modifiers...)}
+	if len(extra)==1 {ids:=append([]string{},extra[0]...);row.ExtraModifiers=&ids}
+	r.neutralStatObservations=append(r.neutralStatObservations,row)
+}
+func (r *Runtime) NeutralStatObservations() ([]NeutralStatObservation,bool) {
+	return append([]NeutralStatObservation{},r.neutralStatObservations...),!r.neutralStatObservationsTruncated
+}
+func (q StatQueryContext) SelectedKeys() *[]string {
+	if q.selectedKeys==nil{return nil}
+	keys:=append([]string{},(*q.selectedKeys)...);return &keys
+}
diff --git a/pkg/gtttrace/neutral_world.go b/pkg/gtttrace/neutral_world.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/neutral_world.go
@@ -0,0 +1,70 @@
+package gtttrace
+
+import ("sort";"reflect")
+
+// Pure identity/expiry snapshots. Never evaluate a modifier Amount or stat
+// getter. Intern unchanged world states so many formula reads share one row.
+type NeutralModifierIdentity struct {
+ Owner int `json:"owner"`
+ Key string `json:"key"`
+ Expiry int `json:"expiry"`
+}
+type NeutralWorldState struct {
+ Facts *EventValue `json:"facts,omitempty"`
+ Targets []EventValue `json:"targets,omitempty"`
+ Order uint64 `json:"order"`
+ Frame int `json:"frame"`
+ Active int `json:"active"`
+ Modifiers []NeutralModifierIdentity `json:"modifiers"`
+}
+type NeutralWorldLedger struct {
+ Complete bool `json:"complete"`
+ States []NeutralWorldState `json:"states"`
+}
+// The production entrypoint decides this before character/weapon/set setup.
+// Query identities remain enabled for Selected; only neutral-only observers stop.
+func (r *Runtime) SetNeutralObservationEnabled(enabled bool) { if r != nil { r.neutralObservationDisabled = !enabled } }
+func (r *Runtime) NeutralEnabled() bool { return r.Enabled() && !r.neutralObservationDisabled }
+func (r *Runtime) BindNeutralWorld(read func() []NeutralModifierIdentity) {
+ if r != nil { r.neutralWorldReader = read }
+}
+func (r *Runtime) BindNeutralTargets(read func() []EventValue) { if r != nil { r.neutralTargetReader = read } }
+func (r *Runtime) BindNeutralResources(read func() EventValue) { if r != nil { r.neutralResourceReader = read } }
+func (r *Runtime) NextNeutralObservationOrder() uint64 {
+ order := r.NextObservationOrder()
+ r.CaptureNeutralWorldAt(order)
+ return order
+}
+func (r *Runtime) CaptureNeutralWorldAt(order uint64) {
+ if !r.NeutralEnabled() || order == 0 || r.neutralWorldReader == nil { return }
+ mods := r.neutralWorldReader()
+ var targets []EventValue
+ if r.neutralTargetReader != nil { targets = r.neutralTargetReader() }
+ var facts *EventValue
+ if r.neutralResourceReader != nil { value:=r.neutralResourceReader();facts=&value }
+ sort.Slice(mods, func(i,j int) bool { if mods[i].Owner != mods[j].Owner { return mods[i].Owner < mods[j].Owner }; return mods[i].Key < mods[j].Key })
+ active := -1
+ if r.combatActive != nil { active = r.combatActive() }
+ if len(r.neutralWorldStates) > 0 {
+  previous := r.neutralWorldStates[len(r.neutralWorldStates)-1]
+  equal := previous.Active == active && len(previous.Modifiers) == len(mods) && ((len(previous.Targets)==0 && len(targets)==0) || reflect.DeepEqual(previous.Targets, targets))
+  equal = equal && reflect.DeepEqual(previous.Facts,facts)
+  if equal { for i, m := range mods { if previous.Modifiers[i] != m { equal = false; break } } }
+  if equal { return }
+ }
+ if len(r.neutralWorldStates) >= maxCombatEventRows { r.neutralWorldTruncated = true; return }
+ if facts!=nil {value:=cloneEventValues([]EventValue{*facts})[0];facts=&value}
+ r.neutralWorldStates = append(r.neutralWorldStates, NeutralWorldState{Order:order,Frame:r.Frame(),Active:active,Modifiers:append([]NeutralModifierIdentity{},mods...),Targets:cloneEventValues(targets),Facts:facts})
+}
+func (r *Runtime) NeutralWorld() NeutralWorldLedger {
+ out := NeutralWorldLedger{States: []NeutralWorldState{}}
+ if r == nil { return out }
+ out.Complete = r.NeutralEnabled() && r.neutralWorldReader != nil && !r.neutralWorldTruncated
+ for _, row := range r.neutralWorldStates {
+  row.Modifiers = append([]NeutralModifierIdentity{},row.Modifiers...)
+  row.Targets = cloneEventValues(row.Targets)
+  if row.Facts!=nil {value:=cloneEventValues([]EventValue{*row.Facts})[0];row.Facts=&value}
+  out.States = append(out.States,row)
+ }
+ return out
+}
