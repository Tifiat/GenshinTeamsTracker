diff --git a/pkg/core/info/gtt_combat_event.go b/pkg/core/info/gtt_combat_event.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/info/gtt_combat_event.go
@@ -0,0 +1,114 @@
+package info
+
+import (
+	"math"
+	"reflect"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+// Copy event arguments without walking the mutable core graph or calling game
+// stat getters. Engine-owned payload field names/types survive into the tape;
+// unsupported payloads are unknown, never silently empty/zero.
+func GTTCombatEventValues(args []any) []gtttrace.EventValue {
+	if len(args) > 64 { return []gtttrace.EventValue{{Kind: "unknown", Text: "argument_limit"}} }
+	out := make([]gtttrace.EventValue, len(args))
+	for i, value := range args { out[i] = gttCombatValue(value) }
+	return out
+}
+func gttCombatValue(value any) gtttrace.EventValue {
+	if value != nil { reflected := reflect.ValueOf(value); if (reflected.Kind() == reflect.Pointer || reflected.Kind() == reflect.Interface) && reflected.IsNil() { return gtttrace.EventValue{Kind: "nil"} } }
+	switch v := value.(type) {
+	case interface { ShieldOwner() int; ShieldTarget() int; Expiry() int; Element() attributes.Element }:
+		// The enum-returning Type method cannot appear in this interface without
+		// a package import cycle. Validate its exact signature before calling it.
+		m:=reflect.ValueOf(value).MethodByName("Type")
+		if !m.IsValid() || m.Type().NumIn()!=0 || m.Type().NumOut()!=1 || eventType(m.Type().Out(0))!="github.com/genshinsim/gcsim/pkg/core/player/shield.Type" {return gtttrace.EventValue{Kind:"unknown",Text:"shield_type_signature"}}
+		return gtttrace.EventValue{Kind:"observation",Type:"github.com/genshinsim/gcsim/pkg/core/player/shield.Shield",Fields:map[string]gtttrace.EventValue{
+		 "Type":eventData(m.Call(nil)[0],0),"Expiry":{Kind:"number",Number:float64(v.Expiry())},"Element":eventData(reflect.ValueOf(v.Element()),0),
+		 "ShieldOwner":{Kind:"number",Number:float64(v.ShieldOwner())},"ShieldTarget":{Kind:"number",Number:float64(v.ShieldTarget())},
+		}}
+	case *AttackEvent:
+		if v == nil { return gtttrace.EventValue{Kind: "nil"} }
+		return gtttrace.EventValue{Kind: "object", Type: eventType(reflect.TypeOf(v)),
+			Fields: map[string]gtttrace.EventValue{
+				"HitID": {Kind:"number",Number:func()float64{if v.GTTTraceHit!=nil{return float64(v.GTTTraceHit.HitID)};return 0}()},
+				"Info": eventData(reflect.ValueOf(v.Info), 0),
+				"SourceFrame": {Kind: "number", Number: float64(v.SourceFrame)},
+				"Reacted": {Kind: "bool", Boolean: v.Reacted},
+				"Snapshot": {Kind: "object", Fields: map[string]gtttrace.EventValue{
+					"SourceFrame": {Kind: "number", Number: float64(v.Snapshot.SourceFrame)},
+					"Stats": eventData(reflect.ValueOf(v.Snapshot.Stats), 0),
+				}},
+			}}
+	case Target:
+		return gtttrace.EventValue{Kind: "target", Type: eventType(reflect.TypeOf(v)),
+			Fields: map[string]gtttrace.EventValue{
+				"Key": {Kind: "number", Number: float64(v.Key())},
+				"Type": {Kind: "number", Number: float64(v.Type())},
+			}}
+	case interface{ Index() int }:
+		return gtttrace.EventValue{Kind: "character", Type: eventType(reflect.TypeOf(v)),
+			Fields: map[string]gtttrace.EventValue{"Index": {Kind: "number", Number: float64(v.Index())}}}
+	default:
+		return eventData(reflect.ValueOf(value), 0)
+	}
+}
+func eventType(t reflect.Type) string {
+	if t == nil { return "" }
+	if t.Kind() == reflect.Pointer { return "*" + eventType(t.Elem()) }
+	if t.PkgPath() == "" { return t.String() }
+	return t.PkgPath() + "." + t.Name()
+}
+func eventData(v reflect.Value, depth int) gtttrace.EventValue {
+	if !v.IsValid() { return gtttrace.EventValue{Kind: "nil"} }
+	unknown := gtttrace.EventValue{Kind: "unknown", Type: eventType(v.Type())}
+	if depth > 4 { unknown.Text = "payload_depth"; return unknown }
+	if v.Kind() == reflect.Interface {
+		if v.IsNil() { return gtttrace.EventValue{Kind: "nil"} }
+		return eventData(v.Elem(), depth+1)
+	}
+	out := gtttrace.EventValue{Type: eventType(v.Type())}
+	switch v.Kind() {
+	case reflect.Bool:
+		out.Kind, out.Boolean = "bool", v.Bool()
+	case reflect.String:
+		if v.Len() > 4096 { unknown.Text = "text_limit"; return unknown }
+		out.Kind, out.Text = "string", v.String()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if v.Int() > 1<<53 || v.Int() < -(1<<53) { unknown.Text = "integer_precision"; return unknown }
+		out.Kind, out.Number = "number", float64(v.Int())
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if v.Uint() > 1<<53 { unknown.Text = "integer_precision"; return unknown }
+		out.Kind, out.Number = "number", float64(v.Uint())
+	case reflect.Float32, reflect.Float64:
+		if math.IsNaN(v.Float()) || math.IsInf(v.Float(), 0) { unknown.Text = "non_finite"; return unknown }
+		out.Kind, out.Number = "number", v.Float()
+	case reflect.Pointer:
+		// Only explicitly value-like engine health request pointers are admitted.
+		if v.IsNil() { return gtttrace.EventValue{Kind: "nil"} }
+		if v.Type() != reflect.TypeOf((*DrainInfo)(nil)) && v.Type() != reflect.TypeOf((*HealInfo)(nil)) { return unknown }
+		out = eventData(v.Elem(), depth+1)
+		out.Type = eventType(v.Type())
+	case reflect.Struct:
+		out.Kind, out.Fields = "object", map[string]gtttrace.EventValue{}
+		for i := 0; i < v.NumField(); i++ {
+			field := v.Type().Field(i)
+			if field.PkgPath != "" || field.Tag.Get("json") == "-" { continue }
+			out.Fields[field.Name] = eventData(v.Field(i), depth+1)
+		}
+	case reflect.Slice, reflect.Array:
+		if v.Len() > 128 { unknown.Text = "array_limit"; return unknown }
+		out.Kind, out.Items = "array", make([]gtttrace.EventValue, v.Len())
+		for i := 0; i < v.Len(); i++ { out.Items[i] = eventData(v.Index(i), depth+1) }
+	case reflect.Map:
+		if v.Type().Key().Kind() != reflect.String || v.Len() > 64 { return unknown }
+		out.Kind, out.Fields = "map", map[string]gtttrace.EventValue{}
+		iter := v.MapRange()
+		for iter.Next() { out.Fields[iter.Key().String()] = eventData(iter.Value(), depth+1) }
+	default:
+		return unknown
+	}
+	return out
+}
