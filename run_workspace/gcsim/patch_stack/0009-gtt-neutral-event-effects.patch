--- /dev/null
+++ b/pkg/optimization/gtt_hit_identity.go
@@ -0,0 +1,20 @@
+package optimization
+
+import (
+	"fmt"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+// Identity is allocated before reactions/callbacks run. A nested hit can
+// complete before its parent, so completion order is not identity order.
+// Preserve the observed order and every event reference; never renumber/sort.
+func validateGTTTraceHitIdentities(hits []info.GTTTraceHit) error {
+	seen := make(map[uint64]bool, len(hits))
+	for index, hit := range hits {
+		if hit.HitID == 0 || hit.AttackID == 0 || seen[hit.HitID] {
+			return fmt.Errorf("gtt trace equation: invalid hit identity at observation %d: hit=%d attack=%d duplicate=%t", index, hit.HitID, hit.AttackID, seen[hit.HitID])
+		}
+		seen[hit.HitID] = true
+	}
+	return nil
+}
