diff --git a/pkg/optimization/gtt_trace_equation.go b/pkg/optimization/gtt_trace_equation.go
new file mode 100644
index 0000000..c4e1961
--- /dev/null
+++ b/pkg/optimization/gtt_trace_equation.go
@@ -0,0 +1,236 @@
+package optimization
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gcs/ast"
+	"github.com/genshinsim/gcsim/pkg/gcs/eval"
+	"github.com/genshinsim/gcsim/pkg/gcs/parser"
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"github.com/genshinsim/gcsim/pkg/simulation"
+	"github.com/genshinsim/gcsim/pkg/simulator"
+)
+
+const GTTTraceEquationSchemaVersion = 1
+
+type GTTTraceEquationRequest struct {
+	SchemaVersion     int    `json:"schema_version"`
+	ContextSHA256     string `json:"context_sha256"`
+	Seed              string `json:"seed"`
+	Iterations        int    `json:"iterations"`
+	Workers           int    `json:"workers"`
+	IgnoreBurstEnergy bool   `json:"ignore_burst_energy"`
+}
+
+type GTTTraceEquationOutput struct {
+	SchemaVersion        int                              `json:"schema_version"`
+	Capability           string                           `json:"capability"`
+	EngineVersion        string                           `json:"engine_version"`
+	PatchVersion         string                           `json:"patch_version"`
+	FormulaVersion       string                           `json:"formula_version"`
+	FormulaSHA256        string                           `json:"formula_sha256"`
+	ContextSHA256        string                           `json:"context_sha256"`
+	RequestSHA256        string                           `json:"request_sha256"`
+	SourceConfigSHA256   string                           `json:"source_config_sha256"`
+	CompiledActionSHA256 string                           `json:"compiled_action_sha256"`
+	TargetSHA256         string                           `json:"target_sha256"`
+	Seed                 string                           `json:"seed"`
+	DurationFrames       int                              `json:"duration_frames"`
+	CharacterKeys        []string                         `json:"character_keys"`
+	Hits                 []info.GTTTraceHit               `json:"hits"`
+	TopologyEvents       []optstats.GTTTraceTopologyEvent `json:"topology_events"`
+	Unsupported          []string                         `json:"unsupported"`
+	GuardSummary         optstats.GTTTraceGuardSummary    `json:"guard_summary"`
+}
+
+func RunGTTTraceEquation(ctx context.Context, opts simulator.Options, requestPath string) error {
+	if strings.TrimSpace(opts.ResultSaveToPath) == "" {
+		return errors.New("gtt trace equation requires -out")
+	}
+	data, err := os.ReadFile(requestPath)
+	if err != nil {
+		return err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var request GTTTraceEquationRequest
+	if err := decoder.Decode(&request); err != nil {
+		return fmt.Errorf("gtt trace equation: decode: %w", err)
+	}
+	if err := requireJSONEOF(decoder); err != nil {
+		return err
+	}
+	if err := request.validate(); err != nil {
+		return err
+	}
+	requestSHA, err := canonicalSHA256(request)
+	if err != nil {
+		return err
+	}
+	seed, _ := strconv.ParseInt(request.Seed, 10, 64)
+
+	cfg, err := simulator.ReadConfig(opts.ConfigPath)
+	if err != nil {
+		return err
+	}
+	file := ast.NewFile()
+	p := parser.New(file, cfg)
+	simcfg, gcsl, err := p.Parse()
+	if err != nil {
+		return err
+	}
+	if err := gtt.ApplyConfigDirectives(cfg, simcfg); err != nil {
+		return err
+	}
+	if err := gtt.ApplyWaveScenarioFile(opts.GTTWaveScenarioPath, simcfg); err != nil {
+		return err
+	}
+	simcfg.Settings.Iterations = 1
+	simcfg.Settings.NumberOfWorkers = 1
+	simcfg.Settings.IgnoreBurstEnergy = request.IgnoreBurstEnergy
+	simcfg.Settings.CollectStats = []string{""}
+
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	default:
+	}
+	core, err := simulation.NewCore(seed, false, simcfg)
+	if err != nil {
+		return err
+	}
+	evaluator, err := eval.NewEvaluator(file, gcsl, core)
+	if err != nil {
+		return err
+	}
+	sim, err := simulation.New(simcfg, evaluator, core)
+	if err != nil {
+		return err
+	}
+	collector, err := optstats.OptimizerTraceEquation(core)
+	if err != nil {
+		return err
+	}
+	if _, err := sim.Run(); err != nil {
+		return err
+	}
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	default:
+	}
+	buffer := collector.Flush(core)
+	if err := validateGTTTraceEquationBuffer(buffer, seed); err != nil {
+		return err
+	}
+
+	targetSHA, err := canonicalSHA256(struct {
+		Targets []info.EnemyProfile   `json:"targets"`
+		Waves   [][]info.EnemyProfile `json:"sequential_waves"`
+	}{simcfg.Targets, simcfg.GTTSequentialWaveScenario})
+	if err != nil {
+		return err
+	}
+	characterKeys := make([]string, len(simcfg.Characters))
+	for index, character := range simcfg.Characters {
+		characterKeys[index] = character.Base.Key.String()
+	}
+	engineVersion := strings.TrimSpace(simulator.Version())
+	if engineVersion == "" {
+		engineVersion = "unversioned-local-build"
+	}
+	out := GTTTraceEquationOutput{
+		SchemaVersion:        GTTTraceEquationSchemaVersion,
+		Capability:           gtt.TraceEquationV1Capability,
+		EngineVersion:        engineVersion,
+		PatchVersion:         gtt.PatchVersion,
+		FormulaVersion:       info.GTTTraceFormulaVersion,
+		FormulaSHA256:        info.GTTTraceFormulaSHA256(),
+		ContextSHA256:        request.ContextSHA256,
+		RequestSHA256:        requestSHA,
+		SourceConfigSHA256:   traceTextSHA256(cfg),
+		CompiledActionSHA256: traceTextSHA256(gcsl.String()),
+		TargetSHA256:         targetSHA,
+		Seed:                 strconv.FormatInt(buffer.Seed, 10),
+		DurationFrames:       buffer.DurationFrames,
+		CharacterKeys:        characterKeys,
+		Hits:                 buffer.Hits,
+		TopologyEvents:       buffer.TopologyEvents,
+		Unsupported:          buffer.Unsupported,
+		GuardSummary:         buffer.GuardSummary(),
+	}
+	payload, err := json.MarshalIndent(out, "", "  ")
+	if err != nil {
+		return fmt.Errorf("gtt trace equation: encode output: %w", err)
+	}
+	payload = append(payload, '\n')
+	if err := os.WriteFile(opts.ResultSaveToPath, payload, 0o644); err != nil {
+		return fmt.Errorf("gtt trace equation: write output: %w", err)
+	}
+	return nil
+}
+
+func (r GTTTraceEquationRequest) validate() error {
+	if r.SchemaVersion != GTTTraceEquationSchemaVersion {
+		return errors.New("gtt trace equation: schema_version must be 1")
+	}
+	if len(r.ContextSHA256) != sha256.Size*2 {
+		return errors.New("gtt trace equation: invalid context_sha256")
+	}
+	if _, err := hex.DecodeString(r.ContextSHA256); err != nil || strings.ToLower(r.ContextSHA256) != r.ContextSHA256 {
+		return errors.New("gtt trace equation: invalid context_sha256")
+	}
+	seed, err := strconv.ParseInt(r.Seed, 10, 64)
+	if err != nil || seed <= 0 || strconv.FormatInt(seed, 10) != r.Seed {
+		return errors.New("gtt trace equation: seed must be a canonical positive int64 string")
+	}
+	if r.Iterations != 1 || r.Workers != 1 {
+		return errors.New("gtt trace equation: iterations and workers must both equal 1")
+	}
+	return nil
+}
+
+func validateGTTTraceEquationBuffer(buffer optstats.GTTTraceEquationBuffer, seed int64) error {
+	if buffer.Seed != seed {
+		return errors.New("gtt trace equation: simulation seed mismatch")
+	}
+	if buffer.DurationFrames <= 0 {
+		return errors.New("gtt trace equation: non-positive duration")
+	}
+	if len(buffer.Hits) == 0 {
+		return errors.New("gtt trace equation: no enemy damage hits captured")
+	}
+	for index, hit := range buffer.Hits {
+		if hit.HitID != uint64(index+1) || hit.AttackID == 0 {
+			return errors.New("gtt trace equation: unstable hit identity")
+		}
+		switch hit.FormulaKind {
+		case info.GTTTraceFormulaStandard, info.GTTTraceFormulaDirectLunar, info.GTTTraceFormulaOpaqueCustom:
+		default:
+			return fmt.Errorf("gtt trace equation: invalid formula_kind %q", hit.FormulaKind)
+		}
+		if len(hit.FormulaSHA256) != sha256.Size*2 {
+			return errors.New("gtt trace equation: missing formula_sha256")
+		}
+		if hit.FormulaSHA256 != info.GTTTraceFormulaSHA256() {
+			return errors.New("gtt trace equation: formula_sha256 drift")
+		}
+	}
+	return nil
+}
+
+func traceTextSHA256(value string) string {
+	digest := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(digest[:])
+}
diff --git a/pkg/optimization/optstats/trace_equation.go b/pkg/optimization/optstats/trace_equation.go
new file mode 100644
index 0000000..e8215d3
--- /dev/null
+++ b/pkg/optimization/optstats/trace_equation.go
@@ -0,0 +1,202 @@
+package optstats
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"reflect"
+	"sort"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+type GTTTraceTopologyEvent struct {
+	EventID     uint64 `json:"event_id"`
+	Frame       int    `json:"frame"`
+	Phase       string `json:"phase"`
+	Kind        string `json:"kind"`
+	SubjectKey  int    `json:"subject_key"`
+	StateSHA256 string `json:"state_sha256"`
+}
+
+type GTTTraceGuardSummary struct {
+	HitCount                    int            `json:"hit_count"`
+	TopologyEventCount          int            `json:"topology_event_count"`
+	UnsupportedHitCount         int            `json:"unsupported_hit_count"`
+	UnsupportedCount            int            `json:"unsupported_count"`
+	FormulaKindCounts           map[string]int `json:"formula_kind_counts"`
+	ReactionOperatorCounts      map[string]int `json:"reaction_operator_counts"`
+	FormulaComplete             bool           `json:"formula_complete"`
+	FlatDmgProvenanceComplete   bool           `json:"flat_dmg_provenance_complete"`
+	AttackModProvenanceComplete bool           `json:"attack_mod_provenance_complete"`
+	ReactionTopologyComplete    bool           `json:"reaction_topology_complete"`
+	ProviderIdentityComplete    bool           `json:"provider_identity_complete"`
+	ExactReplayEligible         bool           `json:"exact_replay_eligible"`
+}
+
+type GTTTraceEquationBuffer struct {
+	DurationFrames int                     `json:"-"`
+	Seed           int64                   `json:"-"`
+	Hits           []info.GTTTraceHit      `json:"hits"`
+	TopologyEvents []GTTTraceTopologyEvent `json:"topology_events"`
+	Unsupported    []string                `json:"unsupported"`
+	nextAttackID   uint64
+	nextHitID      uint64
+	nextEventID    uint64
+}
+
+func OptimizerTraceEquation(core *core.Core) (CollectorCustomStats[GTTTraceEquationBuffer], error) {
+	out := GTTTraceEquationBuffer{
+		Hits:           make([]info.GTTTraceHit, 0),
+		TopologyEvents: make([]GTTTraceTopologyEvent, 0),
+		Unsupported:    make([]string, 0),
+	}
+	core.Events.Subscribe(event.OnApplyAttack, func(args ...any) {
+		attack := args[0].(*info.AttackEvent)
+		out.nextAttackID++
+		attack.GTTTraceContext = &info.GTTTraceAttackContext{AttackID: out.nextAttackID}
+	}, "gtt-trace-equation-attack")
+	core.Events.Subscribe(event.OnEnemyDamage, func(args ...any) {
+		target := args[0].(info.Target)
+		if target.Type() != info.TargettableEnemy {
+			return
+		}
+		attack := args[1].(*info.AttackEvent)
+		actualDamage := args[2].(float64)
+		trace := attack.GTTTraceHit
+		if trace == nil {
+			trace = opaqueTraceHit(core, target, attack, actualDamage)
+		}
+		out.nextHitID++
+		trace.HitID = out.nextHitID
+		if trace.ReportedDamage != actualDamage {
+			trace.AddUnsupported("reported_damage_event_mismatch")
+		}
+		trace.ReportedDamage = actualDamage
+		if trace.FormulaKind == "" {
+			trace.FormulaKind = info.GTTTraceFormulaOpaqueCustom
+			trace.Completeness.FormulaComplete = false
+			trace.AddUnsupported("terminal_formula_not_instrumented")
+		}
+		trace.FormulaSHA256 = info.GTTTraceFormulaSHA256()
+		sort.Strings(trace.Unsupported)
+		out.Hits = append(out.Hits, *trace)
+
+		if !reflect.DeepEqual(trace.AuraBefore, trace.AuraAfterReaction) {
+			out.addTopology(core.F, "reaction", "aura_state_changed", int(target.Key()), trace.AuraAfterReaction)
+		}
+		if !reflect.DeepEqual(trace.AuraAfterReaction, trace.AuraAfterAttachment) {
+			out.addTopology(core.F, "attachment", "aura_state_changed", int(target.Key()), trace.AuraAfterAttachment)
+		}
+		if trace.Killed {
+			out.addTopology(core.F, "damage", "target_death", int(target.Key()), struct {
+				TargetKey int     `json:"target_key"`
+				HPAfter   float64 `json:"hp_after"`
+			}{int(target.Key()), trace.HPAfter})
+		}
+	}, "gtt-trace-equation-damage")
+	return &out, nil
+}
+
+func opaqueTraceHit(core *core.Core, target info.Target, attack *info.AttackEvent, actualDamage float64) *info.GTTTraceHit {
+	stats := make(map[string]float64)
+	for stat := attributes.Stat(0); stat < attributes.EndStatType; stat++ {
+		name := stat.String()
+		if name != "" {
+			stats[name] = attack.Snapshot.Stats[stat]
+		}
+	}
+	hit := &info.GTTTraceHit{
+		Frame:               core.F,
+		SourceFrame:         attack.SourceFrame,
+		SnapshotFrame:       attack.Snapshot.SourceFrame,
+		ActorIndex:          attack.Info.ActorIndex,
+		DamageSrc:           int(attack.Info.DamageSrc),
+		Ability:             attack.Info.Abil,
+		AttackTag:           int(attack.Info.AttackTag),
+		Element:             attack.Info.Element.String(),
+		TargetKey:           int(target.Key()),
+		TargetType:          int(target.Type()),
+		FormulaKind:         info.GTTTraceFormulaOpaqueCustom,
+		ReactionOperatorID:  "opaque_custom",
+		DamageMode:          core.Flags.DamageMode,
+		HPCapActive:         core.Flags.DamageMode,
+		ReportedDamage:      actualDamage,
+		SnapshotStats:       stats,
+		AttackMods:          make([]info.GTTTraceAttackModAttempt, 0),
+		AuraBefore:          make([]info.GTTTraceAuraRow, 0),
+		AuraAfterReaction:   make([]info.GTTTraceAuraRow, 0),
+		AuraAfterAttachment: make([]info.GTTTraceAuraRow, 0),
+		Unsupported:         []string{"terminal_formula_not_instrumented"},
+	}
+	if attack.GTTTraceContext != nil {
+		hit.AttackID = attack.GTTTraceContext.AttackID
+	}
+	return hit
+}
+
+func (b *GTTTraceEquationBuffer) addTopology(frame int, phase, kind string, subject int, state any) {
+	b.nextEventID++
+	b.TopologyEvents = append(b.TopologyEvents, GTTTraceTopologyEvent{
+		EventID: b.nextEventID, Frame: frame, Phase: phase, Kind: kind,
+		SubjectKey: subject, StateSHA256: traceSHA256(state),
+	})
+}
+
+func traceSHA256(value any) string {
+	payload, err := json.Marshal(value)
+	if err != nil {
+		return ""
+	}
+	digest := sha256.Sum256(payload)
+	return hex.EncodeToString(digest[:])
+}
+
+func (b GTTTraceEquationBuffer) GuardSummary() GTTTraceGuardSummary {
+	summary := GTTTraceGuardSummary{
+		HitCount: len(b.Hits), TopologyEventCount: len(b.TopologyEvents),
+		UnsupportedCount: len(b.Unsupported), FormulaKindCounts: make(map[string]int),
+		ReactionOperatorCounts: make(map[string]int), FormulaComplete: len(b.Hits) > 0,
+		FlatDmgProvenanceComplete: len(b.Hits) > 0, AttackModProvenanceComplete: len(b.Hits) > 0,
+		ReactionTopologyComplete: len(b.Hits) > 0, ProviderIdentityComplete: len(b.Hits) > 0,
+	}
+	for _, hit := range b.Hits {
+		summary.FormulaKindCounts[hit.FormulaKind]++
+		summary.ReactionOperatorCounts[hit.ReactionOperatorID]++
+		if len(hit.Unsupported) > 0 {
+			summary.UnsupportedHitCount++
+		}
+		summary.FormulaComplete = summary.FormulaComplete && hit.Completeness.FormulaComplete
+		summary.FlatDmgProvenanceComplete = summary.FlatDmgProvenanceComplete && hit.Completeness.FlatDmgProvenanceComplete
+		summary.AttackModProvenanceComplete = summary.AttackModProvenanceComplete && hit.Completeness.AttackModProvenanceComplete
+		summary.ReactionTopologyComplete = summary.ReactionTopologyComplete && hit.Completeness.ReactionTopologyComplete
+		summary.ProviderIdentityComplete = summary.ProviderIdentityComplete && hit.Completeness.ProviderIdentityComplete
+	}
+	summary.ExactReplayEligible = summary.FormulaComplete && summary.FlatDmgProvenanceComplete &&
+		summary.AttackModProvenanceComplete && summary.ReactionTopologyComplete &&
+		summary.ProviderIdentityComplete && len(b.Unsupported) == 0
+	return summary
+}
+
+func (b GTTTraceEquationBuffer) Flush(core *core.Core) GTTTraceEquationBuffer {
+	b.DurationFrames = core.F
+	b.Seed = core.Seed
+	seen := map[string]bool{
+		"provider_identity_not_instrumented":         true,
+		"gadget_wave_state_lineage_not_instrumented": true,
+	}
+	for _, hit := range b.Hits {
+		for _, code := range hit.Unsupported {
+			seen[code] = true
+		}
+	}
+	b.Unsupported = b.Unsupported[:0]
+	for code := range seen {
+		b.Unsupported = append(b.Unsupported, code)
+	}
+	sort.Strings(b.Unsupported)
+	return b
+}
