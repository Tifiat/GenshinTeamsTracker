+package info
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+// GTTTraceFormulaVersion is the interpretation contract for the flattened
+// numeric formula fields in GTTTraceHit. FormulaComplete means the terminal
+// numeric calculation is captured; the other completeness flags independently
+// guard provenance and topology.
+const GTTTraceFormulaVersion = "gtt_trace_formula_v1"
+
+// GTTTraceFormulaSHA256 identifies the interpretation registry, not the
+// current numeric values of a hit. Numeric inputs are carried separately in
+// GTTTraceHit so a safe perturbation does not masquerade as formula drift.
+func GTTTraceFormulaSHA256() string {
+	digest := sha256.Sum256([]byte(GTTTraceFormulaVersion))
+	return hex.EncodeToString(digest[:])
+}
+
+const (
+	GTTTraceFormulaStandard     = "standard"
+	GTTTraceFormulaDirectLunar  = "direct_lunar"
+	GTTTraceFormulaOpaqueCustom = "opaque_custom"
+)
+
+type GTTTraceAttackContext struct {
+	AttackID uint64
+}
+
+type GTTTraceAuraRow struct {
+	Element    string  `json:"element"`
+	Durability float64 `json:"durability"`
+}
+
+type GTTTraceAttackModAttempt struct {
+	ModifierKey  string             `json:"modifier_key"`
+	SourceKey    string             `json:"source_key"`
+	OwnerIndex   int                `json:"owner_index"`
+	Accepted     bool               `json:"accepted"`
+	BeforeDamage *float64           `json:"before_damage"`
+	AfterDamage  *float64           `json:"after_damage"`
+	Delta        map[string]float64 `json:"delta"`
+}
+
+type GTTTraceCompleteness struct {
+	FormulaComplete             bool `json:"formula_complete"`
+	FlatDmgProvenanceComplete   bool `json:"flat_dmg_provenance_complete"`
+	AttackModProvenanceComplete bool `json:"attack_mod_provenance_complete"`
+	ReactionTopologyComplete    bool `json:"reaction_topology_complete"`
+	ProviderIdentityComplete    bool `json:"provider_identity_complete"`
+}
+
+// GTTTraceHit intentionally keeps the wire representation flat. It is a
+// versioned numeric receipt, not a claim that arbitrary Go expressions have
+// been converted to symbolic formulae.
+type GTTTraceHit struct {
+	AttackID       uint64  `json:"attack_id"`
+	HitID          uint64  `json:"hit_id"`
+	ParentAttackID *uint64 `json:"parent_attack_id"`
+	ParentHitID    *uint64 `json:"parent_hit_id"`
+	Frame          int     `json:"frame"`
+	SourceFrame    int     `json:"source_frame"`
+	SnapshotFrame  int     `json:"snapshot_frame"`
+	ActorIndex     int     `json:"actor_index"`
+	DamageSrc      int     `json:"damage_src"`
+	Ability        string  `json:"ability"`
+	AttackTag      int     `json:"attack_tag"`
+	Element        string  `json:"element"`
+	TargetKey      int     `json:"target_key"`
+	TargetType     int     `json:"target_type"`
+
+	FormulaKind        string `json:"formula_kind"`
+	FormulaSHA256      string `json:"formula_sha256"`
+	ReactionOperatorID string `json:"reaction_operator_id"`
+
+	Mult                  float64                    `json:"mult"`
+	FlatDmg               float64                    `json:"flat_dmg"`
+	UseDef                bool                       `json:"use_def"`
+	UseHP                 bool                       `json:"use_hp"`
+	UseEM                 bool                       `json:"use_em"`
+	BaseDmgBonus          float64                    `json:"base_dmg_bonus"`
+	Elevation             float64                    `json:"elevation"`
+	IgnoreDefPercent      float64                    `json:"ignore_def_percent"`
+	Amped                 bool                       `json:"amped"`
+	AmpMult               float64                    `json:"amp_mult"`
+	AmpType               string                     `json:"amp_type"`
+	Catalyzed             bool                       `json:"catalyzed"`
+	ICDTag                int                        `json:"icd_tag"`
+	ICDGroup              int                        `json:"icd_group"`
+	DurabilityInitial     float64                    `json:"durability_initial"`
+	DurabilityPostICD     float64                    `json:"durability_post_icd"`
+	DamageGroupMultiplier float64                    `json:"damage_group_multiplier"`
+	SnapshotStats         map[string]float64         `json:"snapshot_stats"`
+	CharLevel             int                        `json:"char_level"`
+	TargetLevel           int                        `json:"target_level"`
+	ScalingStatKind       string                     `json:"scaling_stat_kind"`
+	ScalingStatValue      float64                    `json:"scaling_stat_value"`
+	BaseDamage            float64                    `json:"base_damage"`
+	DamageBonus           float64                    `json:"damage_bonus"`
+	RawCritRate           float64                    `json:"raw_crit_rate"`
+	CritRateClamped       float64                    `json:"crit_rate_clamped"`
+	CritDamage            float64                    `json:"crit_damage"`
+	CritRoll              *float64                   `json:"crit_roll"`
+	HitWeakPoint          bool                       `json:"hit_weak_point"`
+	IsCrit                bool                       `json:"is_crit"`
+	Resistance            float64                    `json:"resistance"`
+	ResMod                float64                    `json:"res_mod"`
+	DefAdj                float64                    `json:"def_adj"`
+	DefMod                float64                    `json:"def_mod"`
+	EM                    float64                    `json:"em"`
+	EMBonus               float64                    `json:"em_bonus"`
+	ReactionBonus         float64                    `json:"reaction_bonus"`
+	AmpTotal              float64                    `json:"amp_total"`
+	PreAmpDamage          float64                    `json:"pre_amp_damage"`
+	ElevationMultiplier   float64                    `json:"elevation_multiplier"`
+	UncappedDamage        float64                    `json:"uncapped_damage"`
+	DamageMode            bool                       `json:"damage_mode"`
+	HPCapActive           bool                       `json:"hp_cap_active"`
+	HPBefore              float64                    `json:"hp_before"`
+	ActualDamage          float64                    `json:"actual_damage"`
+	ReportedDamage        float64                    `json:"reported_damage"`
+	HPAfter               float64                    `json:"hp_after"`
+	Killed                bool                       `json:"killed"`
+	AttackMods            []GTTTraceAttackModAttempt `json:"attack_mods"`
+	AuraBefore            []GTTTraceAuraRow          `json:"aura_before"`
+	AuraAfterReaction     []GTTTraceAuraRow          `json:"aura_after_reaction"`
+	AuraAfterAttachment   []GTTTraceAuraRow          `json:"aura_after_attachment"`
+	Completeness          GTTTraceCompleteness       `json:"completeness"`
+	Unsupported           []string                   `json:"unsupported"`
+}
+
+func (h *GTTTraceHit) AddUnsupported(code string) {
+	for _, existing := range h.Unsupported {
+		if existing == code {
+			return
+		}
+	}
+	h.Unsupported = append(h.Unsupported, code)
+}
