diff --git a/pkg/enemy/gtt_trace.go b/pkg/enemy/gtt_trace.go
new file mode 100644
index 0000000..0037da6
--- /dev/null
+++ b/pkg/enemy/gtt_trace.go
@@ -0,0 +1,171 @@
+package enemy
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/attacks"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+func (e *Enemy) gttTraceBeginHit(atk *info.AttackEvent, grpMult float64) {
+	if atk.GTTTraceContext == nil {
+		return
+	}
+	atk.GTTTraceHit = &info.GTTTraceHit{
+		AttackID:              atk.GTTTraceContext.AttackID,
+		Frame:                 e.Core.F,
+		SourceFrame:           atk.SourceFrame,
+		SnapshotFrame:         atk.Snapshot.SourceFrame,
+		ActorIndex:            atk.Info.ActorIndex,
+		DamageSrc:             int(atk.Info.DamageSrc),
+		Ability:               atk.Info.Abil,
+		AttackTag:             int(atk.Info.AttackTag),
+		Element:               atk.Info.Element.String(),
+		TargetKey:             int(e.Key()),
+		TargetType:            int(e.Type()),
+		TargetLevel:           e.Level,
+		ReactionOperatorID:    "none",
+		DamageGroupMultiplier: grpMult,
+		DamageMode:            e.Core.Flags.DamageMode,
+		HPCapActive:           e.Core.Flags.DamageMode,
+		SnapshotStats:         make(map[string]float64),
+		AttackMods:            make([]info.GTTTraceAttackModAttempt, 0),
+		AuraBefore:            make([]info.GTTTraceAuraRow, 0),
+		AuraAfterReaction:     make([]info.GTTTraceAuraRow, 0),
+		AuraAfterAttachment:   make([]info.GTTTraceAuraRow, 0),
+		Unsupported:           make([]string, 0),
+		Completeness: info.GTTTraceCompleteness{
+			FormulaComplete:             false,
+			FlatDmgProvenanceComplete:   true,
+			AttackModProvenanceComplete: true,
+			ReactionTopologyComplete:    true,
+			ProviderIdentityComplete:    false,
+		},
+	}
+	atk.GTTTraceHit.AddUnsupported("provider_identity_not_instrumented")
+}
+
+func (e *Enemy) gttTraceCaptureAttackInput(atk *info.AttackEvent) {
+	trace := atk.GTTTraceHit
+	if trace == nil {
+		return
+	}
+	trace.ActorIndex = atk.Info.ActorIndex
+	trace.DamageSrc = int(atk.Info.DamageSrc)
+	trace.Ability = atk.Info.Abil
+	trace.AttackTag = int(atk.Info.AttackTag)
+	trace.Element = atk.Info.Element.String()
+	trace.Mult = atk.Info.Mult
+	trace.FlatDmg = atk.Info.FlatDmg
+	trace.UseDef = atk.Info.UseDef
+	trace.UseHP = atk.Info.UseHP
+	trace.UseEM = atk.Info.UseEM
+	trace.BaseDmgBonus = atk.Info.BaseDmgBonus
+	trace.Elevation = atk.Info.Elevation
+	trace.IgnoreDefPercent = atk.Info.IgnoreDefPercent
+	trace.Amped = atk.Info.Amped
+	trace.AmpMult = atk.Info.AmpMult
+	trace.AmpType = string(atk.Info.AmpType)
+	trace.Catalyzed = atk.Info.Catalyzed
+	trace.ICDTag = int(atk.Info.ICDTag)
+	trace.ICDGroup = int(atk.Info.ICDGroup)
+	trace.CharLevel = atk.Snapshot.CharLvl
+	trace.HitWeakPoint = atk.Info.HitWeakPoint
+	trace.SnapshotStats = make(map[string]float64)
+	for stat := attributes.Stat(0); stat < attributes.EndStatType; stat++ {
+		name := stat.String()
+		if name != "" {
+			trace.SnapshotStats[name] = atk.Snapshot.Stats[stat]
+		}
+	}
+	trace.ReactionOperatorID = gttTraceReactionOperatorID(atk)
+	trace.Completeness.FlatDmgProvenanceComplete = atk.Info.FlatDmg == 0
+	trace.Completeness.AttackModProvenanceComplete = len(trace.AttackMods) == 0
+	trace.AddUnsupported("multiplier_source_expression_not_instrumented")
+	if atk.Info.FlatDmg != 0 {
+		trace.AddUnsupported("flat_dmg_expression_collapsed")
+	}
+	if len(trace.AttackMods) > 0 {
+		trace.AddUnsupported("attack_mod_closure_expression_collapsed")
+	}
+	if trace.ReactionOperatorID == "opaque_custom" {
+		trace.AddUnsupported("unknown_reaction_operator")
+	}
+}
+
+func (e *Enemy) gttTraceAura() []info.GTTTraceAuraRow {
+	values := e.GetDurability()
+	out := make([]info.GTTTraceAuraRow, 0, len(values))
+	for index, durability := range values {
+		name := info.ReactionModKey(index).String()
+		if name == "" {
+			continue
+		}
+		out = append(out, info.GTTTraceAuraRow{
+			Element:    name,
+			Durability: float64(durability),
+		})
+	}
+	return out
+}
+
+func gttTraceAuraActive(rows []info.GTTTraceAuraRow) bool {
+	for _, row := range rows {
+		if row.Durability > float64(info.ZeroDur) {
+			return true
+		}
+	}
+	return false
+}
+
+func (e *Enemy) gttTraceFinalizeReactionGuard(atk *info.AttackEvent) {
+	trace := atk.GTTTraceHit
+	if trace == nil {
+		return
+	}
+	reactionRelevant := (atk.Info.Element != attributes.Physical && trace.DurabilityInitial > 0) || atk.Reacted ||
+		trace.ReactionOperatorID != "none" || gttTraceAuraActive(trace.AuraBefore) ||
+		gttTraceAuraActive(trace.AuraAfterReaction)
+	trace.Completeness.ReactionTopologyComplete = !reactionRelevant
+	if reactionRelevant {
+		trace.AddUnsupported("reaction_topology_aggregate_only")
+	}
+	if trace.ReactionOperatorID != "none" {
+		trace.AddUnsupported("reaction_parent_lineage_not_instrumented")
+	}
+}
+
+func gttTraceReactionOperatorID(atk *info.AttackEvent) string {
+	if atk.Info.Amped {
+		return "multiply_parent_hit"
+	}
+	if atk.Info.Catalyzed {
+		return "add_flat_to_parent_hit_before_bonuses"
+	}
+	switch atk.Info.AttackTag {
+	case attacks.AttackTagOverloadDamage,
+		attacks.AttackTagSuperconductDamage,
+		attacks.AttackTagECDamage,
+		attacks.AttackTagShatter,
+		attacks.AttackTagSwirlPyro,
+		attacks.AttackTagSwirlHydro,
+		attacks.AttackTagSwirlCryo,
+		attacks.AttackTagSwirlElectro,
+		attacks.AttackTagBurningDamage,
+		attacks.AttackTagBloom,
+		attacks.AttackTagBountifulCore,
+		attacks.AttackTagBurgeon,
+		attacks.AttackTagHyperbloom:
+		return "spawn_damage_attack"
+	case attacks.AttackTagReactionLunarCharge:
+		return "spawn_damage_attack"
+	case attacks.AttackTagDirectLunarCharged:
+		return "opaque_custom"
+	case attacks.AttackTagDirectLunarBloom:
+		return "opaque_custom"
+	default:
+		if attacks.ReactionAttackStartDelim < atk.Info.AttackTag && atk.Info.AttackTag < attacks.DirectLunarReactionEndDelim {
+			return "opaque_custom"
+		}
+		return "none"
+	}
+}
