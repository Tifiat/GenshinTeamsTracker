+	provider := e.Core.GTTTrace.Current()
+	if !provider.Complete() {
+		provider = gtttrace.UnknownProvider("unattributed", mod.Key())
+	}
+	mod.SetGTTSource(provider)
+	index := modifier.Find(&e.mods, mod.Key())
+	if index < 0 {
