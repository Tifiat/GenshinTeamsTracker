+		attack.Info.AmpType != beforeInfo.AmpType ||
+		attack.Info.Catalyzed != beforeInfo.Catalyzed ||
+		attack.Info.CatalyzedType != beforeInfo.CatalyzedType
+	row.Changed = row.TopologyChanged || len(row.SnapshotDelta) > 0 ||
+		row.MultDelta != 0 || row.FlatDmgDelta != 0 ||
+		row.BaseDmgBonusDelta != 0 || row.ElevationDelta != 0 ||
+		row.IgnoreDefDelta != 0 || row.AmpMultiplierDelta != 0
