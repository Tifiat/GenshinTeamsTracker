diff --git a/pkg/core/event/gtt_trace_test.go b/pkg/core/event/gtt_trace_test.go
new file mode 100644
index 0000000..798246f
--- /dev/null
+++ b/pkg/core/event/gtt_trace_test.go
@@ -0,0 +1,63 @@
+package event
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestOnApplyAttackCallbackEvidenceSurvivesBeforeHitAllocation(t *testing.T) {
+	runtime := gtttrace.NewRuntime()
+	runtime.Enable()
+	handler := New(runtime)
+	provider := gtttrace.NewProvider("set", "echoesofanoffering", 0, 4)
+	restore := runtime.Enter(provider)
+	handler.Subscribe(OnApplyAttack, func(args ...any) {
+		attack := args[0].(*info.AttackEvent)
+		attack.Info.FlatDmg += 123
+	}, "echoes-flat-dmg")
+	restore()
+
+	attack := &info.AttackEvent{}
+	handler.Emit(OnApplyAttack, attack)
+	if len(attack.GTTTraceCallbackAttempts) != 1 {
+		t.Fatalf("callback attempts = %d, want 1", len(attack.GTTTraceCallbackAttempts))
+	}
+	row := attack.GTTTraceCallbackAttempts[0]
+	if row.Provider != provider || !row.Changed || row.FlatDmgDelta != 123 {
+		t.Fatalf("unexpected callback evidence: %#v", row)
+	}
+	if !row.StateEffectsUnobserved {
+		t.Fatal("untyped callback must retain state-effect uncertainty")
+	}
+}
+
+func TestSubscriptionReplacementRecordsBothProviders(t *testing.T) {
+	runtime := gtttrace.NewRuntime()
+	runtime.Enable()
+	handler := New(runtime)
+	first := gtttrace.NewProvider("set", "first", 0, 4)
+	second := gtttrace.NewProvider("set", "second", 1, 4)
+	restore := runtime.Enter(first)
+	handler.Subscribe(OnEnemyHit, func(args ...any) {}, "shared-key")
+	restore()
+	restore = runtime.Enter(second)
+	handler.Subscribe(OnEnemyHit, func(args ...any) {}, "shared-key")
+	restore()
+
+	rows := runtime.ModifierTransitions()
+	if len(rows) != 2 {
+		t.Fatalf("subscription transitions = %d, want 2", len(rows))
+	}
+	var replacement *gtttrace.ModifierTransition
+	for index := range rows {
+		if rows[index].Transition == "subscription_replacement" {
+			replacement = &rows[index]
+		}
+	}
+	if replacement == nil || replacement.Provider != second ||
+		replacement.DisplacedProvider == nil || *replacement.DisplacedProvider != first {
+		t.Fatalf("unexpected replacement transition: %#v", replacement)
+	}
+}
