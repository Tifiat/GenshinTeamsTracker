+func (r *Reactable) GTTActiveAuraSourceIndices(elements ...attributes.Element) []int {
+	if !r.core.GTTTrace.Enabled() {
+		return []int{}
+	}
+	seen := make(map[int]bool)
+	result := make([]int, 0, info.MaxChars)
+	for mod := range info.ReactionModKeyEnd {
+		if !slices.Contains(elements, mod.Element()) {
+			continue
+		}
+		for source, durability := range r.Durability[mod] {
+			if durability <= info.ZeroDur || seen[source] {
+				continue
+			}
+			seen[source] = true
+			result = append(result, source)
+		}
+	}
+	slices.Sort(result)
+	return result
+}
