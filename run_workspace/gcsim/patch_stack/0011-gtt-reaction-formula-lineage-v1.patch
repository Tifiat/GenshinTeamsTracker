+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/combat"
+	"github.com/genshinsim/gcsim/pkg/core/event"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+type reactionFormulaCapture struct {
+	nextAttackID uint64
+	attackIDs    map[string]uint64
+	formulas     map[string][]info.GTTTraceReactionFormula
+}
+
+func installReactionFormulaCapture(c *core.Core) *reactionFormulaCapture {
+	capture := &reactionFormulaCapture{
+		attackIDs: make(map[string]uint64),
+		formulas:  make(map[string][]info.GTTTraceReactionFormula),
+	}
+	c.GTTTrace.Enable()
+	c.Events.Subscribe(event.OnApplyAttack, func(args ...any) {
+		attack := args[0].(*info.AttackEvent)
+		capture.nextAttackID++
+		attack.GTTTraceContext = &info.GTTTraceAttackContext{AttackID: capture.nextAttackID}
+		if attack.Info.Abil != "" {
+			capture.attackIDs[attack.Info.Abil] = capture.nextAttackID
+		}
+		if attack.Snapshot.GTTReactionFormula == nil {
+			return
+		}
+		formula := *attack.Snapshot.GTTReactionFormula
+		formula.ReactionBonusContributions = append(
+			[]info.GTTTraceReactionBonusContribution(nil),
+			formula.ReactionBonusContributions...,
+		)
+		formula.AuraSourceIndices = append([]int(nil), formula.AuraSourceIndices...)
+		capture.formulas[attack.Info.Abil] = append(capture.formulas[attack.Info.Abil], formula)
+	}, "reaction-formula-lineage-capture")
+	return capture
+}
+
+func queueLineageElement(
+	c *core.Core,
+	target info.Target,
+	actor int,
+	ability string,
+	element attributes.Element,
+) {
+	c.QueueAttackEvent(&info.AttackEvent{
+		Info: info.AttackInfo{
+			ActorIndex: actor,
+			Abil:       ability,
+			Element:    element,
+			Durability: 50,
+		},
+		Pattern: combat.NewCircleHitOnTarget(target, nil, 10),
+	}, 0)
+}
+
+func createLineageBloomCore(t *testing.T) (*core.Core, info.Target, *reactionFormulaCapture, int, uint64) {
+	t.Helper()
+	c, targets := makeCore(1)
+	if err := c.Init(); err != nil {
+		t.Fatalf("initialize core: %v", err)
+	}
+	capture := installReactionFormulaCapture(c)
+	queueLineageElement(c, targets[0], 0, "dendro-aura", attributes.Dendro)
+	advanceCoreFrame(c)
+	const creator = 1
+	queueLineageElement(c, targets[0], creator, "bloom-creator", attributes.Hydro)
+	for range dendrocore.Delay + 1 {
+		advanceCoreFrame(c)
+	}
+	if c.Combat.GadgetCount() != 1 {
+		t.Fatalf("expected one dendro core, got %d", c.Combat.GadgetCount())
+	}
+	creatorAttackID := capture.attackIDs["bloom-creator"]
+	if creatorAttackID == 0 {
+		t.Fatal("missing Bloom creator attack identity")
+	}
+	return c, targets[0], capture, creator, creatorAttackID
+}
+
+func requireSingleReactionFormula(
+	t *testing.T,
+	capture *reactionFormulaCapture,
+	ability string,
+) info.GTTTraceReactionFormula {
+	t.Helper()
+	formulas := capture.formulas[ability]
+	if len(formulas) != 1 {
+		t.Fatalf("expected one %s formula, got %d", ability, len(formulas))
+	}
+	return formulas[0]
+}
+
+func lineageIntPointer(value int) *int { return &value }
+
+func requireGadgetLineage(
+	t *testing.T,
+	formula info.GTTTraceReactionFormula,
+	owner int,
+	creator int,
+	converter *int,
+	parentAttackID uint64,
+	parentTargetKey int,
+	readPhase string,
+	reason string,
+) {
+	t.Helper()
+	if formula.OwnerIndex != owner {
+		t.Fatalf("owner: expected %d, got %d", owner, formula.OwnerIndex)
+	}
+	if formula.GadgetID == nil || *formula.GadgetID == "" {
+		t.Fatal("missing gadget identity")
+	}
+	if formula.GadgetCreatorIndex == nil || *formula.GadgetCreatorIndex != creator {
+		t.Fatalf("creator: expected %d, got %v", creator, formula.GadgetCreatorIndex)
+	}
+	if converter == nil {
+		if formula.GadgetConverterIndex != nil {
+			t.Fatalf("expected no converter, got %d", *formula.GadgetConverterIndex)
+		}
+	} else if formula.GadgetConverterIndex == nil || *formula.GadgetConverterIndex != *converter {
+		t.Fatalf("converter: expected %d, got %v", *converter, formula.GadgetConverterIndex)
+	}
+	if formula.ParentAttackID == nil || *formula.ParentAttackID != parentAttackID {
+		t.Fatalf("parent attack: expected %d, got %v", parentAttackID, formula.ParentAttackID)
+	}
+	if formula.ParentTargetKey == nil || *formula.ParentTargetKey != parentTargetKey {
+		t.Fatalf("parent target: expected %d, got %v", parentTargetKey, formula.ParentTargetKey)
+	}
+	if formula.ReadPhase != readPhase {
+		t.Fatalf("read phase: expected %q, got %q", readPhase, formula.ReadPhase)
+	}
+	if formula.GadgetResolutionReason == nil || *formula.GadgetResolutionReason != reason {
+		t.Fatalf("resolution reason: expected %q, got %v", reason, formula.GadgetResolutionReason)
+	}
+}
+
+func TestReactionFormulaGadgetOwnershipAndLineage(t *testing.T) {
+	t.Run("natural Bloom keeps creator ownership", func(t *testing.T) {
+		c, target, capture, creator, creatorAttackID := createLineageBloomCore(t)
+		for range 302 {
+			advanceCoreFrame(c)
+		}
+		formula := requireSingleReactionFormula(t, capture, string(info.ReactionTypeBloom))
+		requireGadgetLineage(
+			t,
+			formula,
+			creator,
+			creator,
+			nil,
+			creatorAttackID,
+			int(target.Key()),
+			info.GTTTraceReactionReadGadgetRupture,
+			"expired",
+		)
+	})
+
+	t.Run("Hyperbloom transfers ownership to electro converter", func(t *testing.T) {
+		c, target, capture, creator, _ := createLineageBloomCore(t)
+		gadgetKey := int(c.Combat.Gadget(0).Key())
+		const converter = 2
+		queueLineageElement(c, target, converter, "hyperbloom-converter", attributes.Electro)
+		for range 70 {
+			advanceCoreFrame(c)
+		}
+		formula := requireSingleReactionFormula(t, capture, string(info.ReactionTypeHyperbloom))
+		requireGadgetLineage(
+			t,
+			formula,
+			converter,
+			creator,
+			lineageIntPointer(converter),
+			capture.attackIDs["hyperbloom-converter"],
+			gadgetKey,
+			info.GTTTraceReactionReadGadgetConversion,
+			"hyperbloom_conversion",
+		)
+	})
+
+	t.Run("Burgeon transfers ownership to pyro converter", func(t *testing.T) {
+		c, target, capture, creator, _ := createLineageBloomCore(t)
+		gadgetKey := int(c.Combat.Gadget(0).Key())
+		const converter = 3
+		queueLineageElement(c, target, converter, "burgeon-converter", attributes.Pyro)
+		for range 3 {
+			advanceCoreFrame(c)
+		}
+		formula := requireSingleReactionFormula(t, capture, string(info.ReactionTypeBurgeon))
+		requireGadgetLineage(
+			t,
+			formula,
+			converter,
+			creator,
+			lineageIntPointer(converter),
+			capture.attackIDs["burgeon-converter"],
+			gadgetKey,
+			info.GTTTraceReactionReadGadgetConversion,
+			"burgeon_conversion",
+		)
+	})
+}
