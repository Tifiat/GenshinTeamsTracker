+
+func (traceReactionSource) ReactBonusWithTrace(_ info.AttackInfo, hit *info.GTTTraceHit) float64 {
+	hit.ReactionBonusContributions = append(
+		hit.ReactionBonusContributions,
+		info.GTTTraceReactionBonusContribution{
+			ModifierKey: "reaction-bonus",
+			Value:       0.4,
+			Provider:    gtttrace.NewProvider("set", "trace-set", 2, 4),
+		},
+	)
+	return 0.4
+}
+
+func TestCalcReactionDmgEmitsTypedConstructionReceipt(t *testing.T) {
+	parentAttackID := uint64(17)
+	parentTargetKey := 3
+	flatDamage, snapshot := CalcReactionDmg(
+		90,
+		traceReactionSource{},
+		info.AttackInfo{Abil: string(info.ReactionTypeOverload)},
+		321,
+		2.75,
+		info.GTTTraceReactionContext{
+			Enabled:           true,
+			ReadFrame:         77,
+			ReadMode:          info.GTTTraceReactionReadLive,
+			ReadPhase:         info.GTTTraceReactionReadLiveTrigger,
+			ParentAttackID:    &parentAttackID,
+			ParentTargetKey:   &parentTargetKey,
+			AuraSourceIndices: []int{0, 1},
+			ChildRole:         "reaction_damage",
+		},
+	)
+	receipt := snapshot.GTTReactionFormula
+	if receipt == nil {
+		t.Fatal("missing reaction construction receipt")
+	}
+	if receipt.FormulaID != info.GTTTraceTransformativeFormulaID ||
+		receipt.FormulaSHA256 != info.GTTTraceTransformativeFormulaSHA256 {
+		t.Fatal("reaction formula identity drift")
+	}
+	if receipt.ReadMode != info.GTTTraceReactionReadLive ||
+		receipt.ReadPhase != info.GTTTraceReactionReadLiveTrigger ||
+		receipt.OwnerIndex != 2 || receipt.Level != 90 || receipt.ElementalMastery != 321 {
+		t.Fatal("reaction construction inputs are not bound")
+	}
+	if receipt.ParentAttackID == nil || *receipt.ParentAttackID != parentAttackID ||
+		receipt.ParentTargetKey == nil || *receipt.ParentTargetKey != parentTargetKey {
+		t.Fatal("reaction parent lineage is not bound")
+	}
+	if receipt.ConstructedFlatDmg != flatDamage || len(receipt.ReactionBonusContributions) != 1 {
+		t.Fatal("reaction arithmetic or provider rows are not captured")
+	}
+
+	child := WithReactionChild(snapshot, "secondary_reaction_aoe", 1)
+	if child.GTTReactionFormula == receipt ||
+		child.GTTReactionFormula.ChildOrdinal != 1 || receipt.ChildOrdinal != 0 {
+		t.Fatal("reaction child receipt was not copied independently")
+	}
+}
