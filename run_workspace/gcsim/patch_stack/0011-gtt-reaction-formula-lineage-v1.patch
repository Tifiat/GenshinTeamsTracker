@@ -1,10 +1,75 @@
 package core
 
 import (
+	"strconv"
+
 	"github.com/genshinsim/gcsim/pkg/core/info"
 	"github.com/genshinsim/gcsim/pkg/gtttrace"
 )
 
+func (c *Core) GTTReactionContext(
+	parent *info.AttackEvent,
+	readPhase string,
+	childRole string,
+	childOrdinal int,
+) info.GTTTraceReactionContext {
+	ctx := info.GTTTraceReactionContext{
+		Enabled:      c.GTTTrace.Enabled(),
+		ReadFrame:    c.F,
+		ReadMode:     info.GTTTraceReactionReadLive,
+		ReadPhase:    readPhase,
+		ChildRole:    childRole,
+		ChildOrdinal: childOrdinal,
+	}
+	if !ctx.Enabled || parent == nil || parent.GTTTraceContext == nil {
+		return ctx
+	}
+	attackID := parent.GTTTraceContext.AttackID
+	ctx.ParentAttackID = &attackID
+	if parent.GTTTraceHit != nil {
+		targetKey := parent.GTTTraceHit.TargetKey
+		ctx.ParentTargetKey = &targetKey
+	}
+	return ctx
+}
+
+func (c *Core) GTTReactionContextWithPersistentState(
+	ctx info.GTTTraceReactionContext,
+	stateID uint64,
+	revision uint64,
+) info.GTTTraceReactionContext {
+	if !ctx.Enabled || stateID == 0 || revision == 0 {
+		return ctx
+	}
+	stateKey := "persistent:" + strconv.FormatUint(stateID, 10)
+	ctx.PersistentStateID = &stateKey
+	ctx.PersistentStateRevision = &revision
+	return ctx
+}
+
+func (c *Core) GTTReactionContextWithGadget(
+	ctx info.GTTTraceReactionContext,
+	gadgetID uint64,
+	creatorIndex int,
+	converterIndex *int,
+	reason string,
+) info.GTTTraceReactionContext {
+	if !ctx.Enabled || gadgetID == 0 {
+		return ctx
+	}
+	gadgetKey := "gadget:" + strconv.FormatUint(gadgetID, 10)
+	ctx.GadgetID = &gadgetKey
+	ctx.GadgetCreatorIndex = &creatorIndex
+	if converterIndex != nil {
+		converter := *converterIndex
+		ctx.GadgetConverterIndex = &converter
+	}
+	if reason != "" {
+		ctx.GadgetResolutionReason = &reason
+	}
+	return ctx
+}
+
 func (c *Core) QueueAttackWithSnap(
 	a info.AttackInfo,
 	s info.Snapshot,
