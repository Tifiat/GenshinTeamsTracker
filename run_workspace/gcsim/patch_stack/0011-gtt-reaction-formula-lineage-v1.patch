+		return false
+	}
+	for _, value := range []float64{
+		receipt.LevelBase,
+		receipt.ElementalMastery,
+		receipt.EMCurveNumerator,
+		receipt.EMCurveDenominatorOffset,
+		receipt.ReactionBonus,
+		receipt.CoreDamage,
+		receipt.Coefficient,
+		receipt.ConstructedFlatDmg,
+	} {
