+	if receipt.ReactionType == "" || receipt.OperatorID != "spawn_damage_attack" ||
+		hit.ReactionOperatorID != receipt.OperatorID {
+		return errors.New("invalid reaction/operator identity")
+	}
+	if receipt.ReadMode != info.GTTTraceReactionReadLive &&
+		receipt.ReadMode != info.GTTTraceReactionReadSnapshot {
+		return errors.New("read_mode must be live or snapshot")
