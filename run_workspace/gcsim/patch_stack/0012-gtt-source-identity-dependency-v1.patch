+const syntheticSource = `package fixture
+import "example/info"
+func (c *char) sources() {
+	ratio := burstRatio[c.TalentLvlBurst()]
+	c.AddAttackMod(info.AttackMod{Amount: func(atk *info.AttackEvent, target info.Target) []float64 {
+		if !c.Active() { return nil }
+		c.buff[0] = min(c.cur, c.maximum) * ratio
+		return c.buff
+	}})
+	ai := info.AttackInfo{FlatDmg: bubble[c.TalentLvlSkill()] * c.MaxHP()}
+	c.Core.QueueAttack(ai)
+	c.Core.Events.Subscribe(1, func(args ...any) { c.value = unknown(args) })
+	c.Core.Tasks.Add(func() { c.value++ }, 1)
+}
+func (c *char) simple() {
+	c.AddAttackMod(info.AttackMod{Amount: func(atk *info.AttackEvent, target info.Target) []float64 {
+		c.buff[0] = min(c.cur, c.maximum) * 2
+		return c.buff
+	}})
+}
+`
+
+func TestExactManifestTemplatesAndDeterminism(t *testing.T) {
+	root := writeModule(t, syntheticSource)
+	first := generateFixture(t, root)
+	second := generateFixture(t, root)
+	body, err := RenderManifestBody(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bodyAgain, _ := RenderManifestBody(second)
+	if !bytes.Equal(body, bodyAgain) || first.ManifestBodySHA256 != second.ManifestBodySHA256 {
+		t.Fatal("manifest generation is not deterministic")
+	}
+	if bytes.Contains(body, []byte("manifest_body_sha256")) {
+		t.Fatal("body contains its own hash")
+	}
+	var top map[string]json.RawMessage
+	if err := json.Unmarshal(body, &top); err != nil {
+		t.Fatal(err)
+	}
+	wantKeys := []string{"build_flags", "compiler_version", "entries", "formula_identities", "go_toolchain", "kind", "patch_stack_sha256", "patched_source_tree_sha256", "patches", "pristine_source_tree_sha256", "schema_version", "trace_capability", "trace_schema_version", "upstream_ref", "upstream_repo"}
+	for _, key := range wantKeys {
+		if _, ok := top[key]; !ok {
+			t.Fatalf("manifest body lacks %s", key)
+		}
+	}
+	if len(top) != len(wantKeys) {
+		t.Fatalf("manifest body has unexpected top-level fields: %s", body)
+	}
+	sum := sha256.Sum256(body)
+	if first.ManifestBodySHA256 != hex.EncodeToString(sum[:]) {
+		t.Fatal("body hash is not over exact canonical output")
+	}
+	for index, entry := range first.Entries {
+		if index > 0 && first.Entries[index-1].SourceID >= entry.SourceID {
+			t.Fatal("entries are not strictly source_id sorted")
+		}
+		if !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(entry.SourceID) || !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(entry.Template.TemplateSHA256) {
+			t.Fatalf("invalid identity hashes: %#v", entry)
+		}
+		identityBody, err := CanonicalJSON(struct {
+			SourceIDSchema  int    `json:"source_id_schema"`
+			ModulePath      string `json:"module_path"`
+			EnclosingSymbol string `json:"enclosing_symbol"`
+			Seam            string `json:"seam"`
+			Ordinal         int    `json:"ordinal"`
+		}{1, entry.Locator.ModulePath, entry.Locator.EnclosingSymbol, entry.Locator.Seam, entry.Locator.Ordinal})
+		if err != nil {
+			t.Fatal(err)
+		}
+		identitySum := sha256.Sum256(identityBody)
+		if entry.SourceID != hex.EncodeToString(identitySum[:]) {
+			t.Fatal("source ID preimage contract mismatch")
+		}
+		assertTemplateContract(t, entry.Template)
+	}
+	var rawBody struct {
+		Entries []map[string]json.RawMessage `json:"entries"`
+	}
+	if err := json.Unmarshal(body, &rawBody); err != nil || len(rawBody.Entries) == 0 {
+		t.Fatalf("decode entries: %v", err)
+	}
+	for _, key := range []string{"source_id", "locator", "source_node_sha256", "template"} {
+		if _, ok := rawBody.Entries[0][key]; !ok {
+			t.Fatalf("entry lacks exact field %s", key)
+		}
+	}
+	if len(rawBody.Entries[0]) != 4 {
+		t.Fatalf("entry has extra fields: %#v", rawBody.Entries[0])
+	}
+	guarded := findEntry(t, first, KindModifierAmount, "(*char).sources")
+	if guarded.Template.Status != TemplateOpaqueFrozen || *guarded.Template.StopReasonCode != "modifier_guarded_control_flow" {
+		t.Fatalf("guarded modifier should be opaque: %#v", guarded.Template)
+	}
+	simple := findEntry(t, first, KindModifierAmount, "(*char).simple")
+	if simple.Template.Status != TemplateSupported || simple.Template.Nodes[len(simple.Template.Nodes)-1].Operator != "MUL" {
+		t.Fatalf("simple modifier not compiled: %#v", simple.Template)
+	}
+	queued := findEntry(t, first, KindQueuedAttack, "(*char).sources")
+	if queued.Template.Status != TemplateSupported || len(queued.parameterPlans) != 2 {
+		t.Fatalf("HP attack not compiled: %#v", queued.Template)
+	}
+	if queued.parameterPlans[0].Kind != "frozen_source_value" || queued.parameterPlans[0].ReadMode != "constant" || queued.parameterPlans[0].ActorExpression != "" {
+		t.Fatalf("frozen source invariant broken: %#v", queued.parameterPlans[0])
+	}
+	if queued.parameterPlans[1].Kind != "candidate_stat" || queued.parameterPlans[1].StatKey != "max_hp" || queued.parameterPlans[1].ActorExpression != "c" {
+		t.Fatalf("candidate stat invariant broken: %#v", queued.parameterPlans[1])
+	}
+	generated, err := RenderLookupGo(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := parser.ParseFile(token.NewFileSet(), "generated_manifest.go", generated, 0); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"generatedSourceManifestBodySHA256", "generatedSourceCompilerVersion", "generatedSourceIDByLookupKey", "generatedTemplateSHA256BySourceID"} {
+		if !bytes.Contains(generated, []byte(name)) {
+			t.Fatalf("generated Go lacks %s", name)
+		}
+	}
+}
