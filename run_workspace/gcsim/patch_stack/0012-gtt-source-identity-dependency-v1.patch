+	seam string,
+	sourceID string,
+	frame int,
+	provider Provider,
+	parentOccurrenceID string,
+) string {
+	if !r.Enabled() || !gttsource.ValidID(sourceID) || !validSourceSeam(seam) {
+		return ""
+	}
+	if parentOccurrenceID == "" {
+		parentOccurrenceID = r.EnsureCurrentOccurrence()
+	}
+	if parentOccurrenceID != "" {
+		if _, ok := r.occurrenceIndex[parentOccurrenceID]; !ok {
+			parentOccurrenceID = ""
+		}
+	}
+	sequenceIndex := len(r.sourceOccurrences)
+	occurrenceID := "source-occurrence:" + strconv.Itoa(sequenceIndex)
+	row := SourceOccurrence{
+		SequenceIndex: sequenceIndex,
+		OccurrenceID:  occurrenceID,
+		SourceID:      sourceID,
+		Seam:          seam,
+		Frame:         frame,
+		Provider:      NormalizeProvider(provider),
+	}
+	if parentOccurrenceID != "" {
+		parent := parentOccurrenceID
+		row.ParentOccurrenceID = &parent
+	}
+	r.occurrenceIndex[occurrenceID] = sequenceIndex
+	r.sourceOccurrences = append(r.sourceOccurrences, row)
+	return occurrenceID
