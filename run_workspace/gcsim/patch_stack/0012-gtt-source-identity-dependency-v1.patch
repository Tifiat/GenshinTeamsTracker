+func TestSharedAttackInfoKeepsCallsiteIDsAndInjectsMetadataOnce(t *testing.T) {
+	root := writeModule(t, `package fixture
+func shared(c *char) {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP() * 2}
+	c.Core.QueueAttack(ai)
+	c.Core.QueueAttack(ai)
+}
+`)
+	manifest := generateFixture(t, root)
+	queued := make([]SourceEntry, 0, 2)
+	for _, entry := range manifest.Entries {
+		if entry.Locator.Seam == KindQueuedAttack {
+			queued = append(queued, entry)
+		}
+	}
+	if len(queued) != 2 || queued[0].SourceID == queued[1].SourceID {
+		t.Fatalf("shared root must retain two call-site identities: %#v", queued)
+	}
+	if !reflect.DeepEqual(queued[0].Template, queued[1].Template) || !reflect.DeepEqual(queued[0].parameterPlans, queued[1].parameterPlans) {
+		t.Fatal("shared root call sites disagree on template/parameters")
+	}
+	opts := OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay")}
+	first, err := BuildOverlay(opts, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := BuildOverlay(opts, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(first.JSON, second.JSON) || len(first.Files) != 1 || len(second.Files) != 1 || !bytes.Equal(first.Files[0].Contents, second.Files[0].Contents) {
+		t.Fatal("shared-root overlay is not deterministic")
+	}
+	rewritten := string(first.Files[0].Contents)
+	if strings.Count(rewritten, "GTTTraceSourceTemplateSHA256:") != 1 || strings.Count(rewritten, "GTTTraceSourceParameters:") != 1 || strings.Contains(rewritten, "GTTTraceSourceID:") {
+		t.Fatalf("shared metadata injection mismatch:\n%s", rewritten)
+	}
+	conflicting := manifest
+	conflicting.Entries = append([]SourceEntry(nil), manifest.Entries...)
+	conflicting.Entries[1].Template.TemplateSHA256 = strings.Repeat("f", 64)
+	if _, err := BuildOverlay(opts, conflicting); err == nil || !strings.Contains(err.Error(), "conflicting template") {
+		t.Fatalf("conflicting shared root error=%v", err)
+	}
+}
