+func TestAmbiguousLookupFailsAndStructuralIDSurvivesLineShift(t *testing.T) {
+	root := writeModule(t, `package fixture
+func f(c *char) { c.Core.QueueAttack(info.AttackInfo{FlatDmg:c.MaxHP()}); c.Core.QueueAttack(info.AttackInfo{FlatDmg:c.MaxHP()}) }
