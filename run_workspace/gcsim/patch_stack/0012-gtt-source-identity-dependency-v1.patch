+func TestHPOverlayCapturesExactParameterInvariants(t *testing.T) {
+	root := writeModule(t, syntheticSource)
+	manifest := generateFixture(t, root)
+	overlay, err := BuildOverlay(OverlayOptions{ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "rewrites")}, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(overlay.Files) != 1 {
+		t.Fatalf("overlay files=%d", len(overlay.Files))
+	}
+	rewritten := string(overlay.Files[0].Contents)
+	for _, expected := range []string{
+		`Kind: "frozen_source_value"`, `ReadMode: "constant"`,
+		`Kind: "candidate_stat"`, `StatKey: &`, `ReadMode: "live"`,
+		"_index := c.Index()", "_key := c.Base.Key.String()", "ActorKey: &", "ReadFrame: c.Core.F",
+		"GTTTraceSourceTemplateSHA256:", "GTTTraceSourceParameters:",
+		"//line source.go:11",
+	} {
+		if !strings.Contains(rewritten, expected) {
+			t.Fatalf("overlay lacks %q:\n%s", expected, rewritten)
+		}
+	}
+	if strings.Count(rewritten, "bubble[c.TalentLvlSkill()]") != 1 || strings.Count(rewritten, "c.MaxHP()") != 1 || strings.Count(rewritten, "ObservedValue:") != 2 {
+		t.Fatalf("overlay did not capture two pure operands exactly once:\n%s", rewritten)
+	}
+	if strings.Contains(rewritten, "GTTTraceCaptureSourceParameters") {
+		t.Fatal("modifier instrumentation escaped the bounded HP-only overlay")
+	}
+	if strings.Contains(rewritten, "GTTTraceSourceID:") {
+		t.Fatal("AttackInfo must leave call-site source identity to QueueAttack")
+	}
+	if _, err := parser.ParseFile(token.NewFileSet(), "source.go", overlay.Files[0].Contents, 0); err != nil {
+		t.Fatal(err)
+	}
+}
