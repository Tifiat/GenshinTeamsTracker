+		count++
+		if entry.Template.Status != TemplateOpaqueFrozen || entry.Template.StopReasonCode == nil || *entry.Template.StopReasonCode != "shared_attack_info_flat_dmg_mutation" {
+			t.Fatalf("mutated shared root did not fail closed: %#v", entry.Template)
