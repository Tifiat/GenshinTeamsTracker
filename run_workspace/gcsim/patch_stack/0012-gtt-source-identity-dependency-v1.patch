+	parameters := cloneGTTTraceSourceParameters(attack.GTTTraceCapturedSourceParameters)
+	attack.GTTTraceCapturedSourceID = ""
+	attack.GTTTraceCapturedTemplateSHA256 = ""
+	attack.GTTTraceCapturedSourceParameters = nil
+	return sourceID, templateSHA256, parameters
