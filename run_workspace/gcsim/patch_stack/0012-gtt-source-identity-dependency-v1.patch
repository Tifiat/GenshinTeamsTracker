+func validateGTTSourceRows(buffer optstats.GTTTraceEquationBuffer) error {
+	manifestSHA256 := gttsource.ManifestBodySHA256()
+	if manifestSHA256 == "" {
+		if len(buffer.SourceOccurrences) != 0 || len(buffer.SourceValueBindings) != 0 {
+			return errors.New("gtt trace equation: source rows without manifest identity")
+		}
+		return nil
+	}
+	if !gttTraceSHA256(manifestSHA256) || buffer.SourceOccurrences == nil || buffer.SourceValueBindings == nil {
+		return errors.New("gtt trace equation: invalid source manifest or null source rows")
+	}
+	occurrences := make(map[string]int, len(buffer.SourceOccurrences))
+	lastFrame := -1
+	for index, row := range buffer.SourceOccurrences {
+		if row.SequenceIndex != index || row.OccurrenceID != "source-occurrence:"+strconv.Itoa(index) ||
+			!gttTraceSHA256(row.SourceID) || row.Frame < lastFrame {
+			return fmt.Errorf("gtt trace equation: invalid source occurrence %d", index)
+		}
+		switch row.Seam {
+		case gttsource.KindModifierAmount, gttsource.KindEventCallback,
+			gttsource.KindTaskCallback, gttsource.KindQueuedAttack:
+		default:
+			return fmt.Errorf("gtt trace equation: invalid source occurrence seam %d", index)
+		}
+		if err := validateGTTTraceProvider(row.Provider); err != nil {
+			return fmt.Errorf("gtt trace equation: source occurrence %d provider: %w", index, err)
+		}
+		if row.ParentOccurrenceID != nil {
+			parentIndex, ok := occurrences[*row.ParentOccurrenceID]
+			if !ok || parentIndex >= index {
+				return fmt.Errorf("gtt trace equation: invalid source occurrence parent %d", index)
+			}
+		}
+		occurrences[row.OccurrenceID] = index
+		lastFrame = row.Frame
+	}
+	for index, row := range buffer.SourceValueBindings {
+		if strings.TrimSpace(row.BindingID) == "" || !gttTraceSHA256(row.TemplateSHA256) ||
+			strings.TrimSpace(row.OutputKey) == "" || !gttTraceFinite(row.ObservedValue) || row.Parameters == nil {
+			return fmt.Errorf("gtt trace equation: invalid source value binding %d", index)
+		}
+		if _, ok := occurrences[row.OccurrenceID]; !ok {
+			return fmt.Errorf("gtt trace equation: missing source occurrence for binding %d", index)
+		}
+		switch row.OutputKind {
+		case "attack_mod_stat", "terminal_flat_dmg", "diagnostic_scalar":
+		default:
+			return fmt.Errorf("gtt trace equation: invalid source output kind %d", index)
+		}
+		for parameterIndex, parameter := range row.Parameters {
+			if strings.TrimSpace(parameter.ParameterKey) == "" || !gttTraceFinite(parameter.ObservedValue) ||
+				parameter.ReadFrame < 0 {
+				return fmt.Errorf("gtt trace equation: invalid source parameter %d/%d", index, parameterIndex)
+			}
+			switch parameter.Kind {
+			case "candidate_stat", "frozen_source_value", "frozen_runtime_state":
+			default:
+				return fmt.Errorf("gtt trace equation: invalid source parameter kind %d/%d", index, parameterIndex)
+			}
+			switch parameter.ReadMode {
+			case "snapshot", "live", "constant":
+			default:
+				return fmt.Errorf("gtt trace equation: invalid source read mode %d/%d", index, parameterIndex)
+			}
+		}
+	}
 	return nil
 }
 
+func gttTraceSHA256(value string) bool {
+	if len(value) != sha256.Size*2 || strings.ToLower(value) != value {
+		return false
+	}
+	_, err := hex.DecodeString(value)
+	return err == nil
+}
