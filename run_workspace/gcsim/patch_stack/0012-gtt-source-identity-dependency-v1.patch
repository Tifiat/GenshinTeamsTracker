+func TestPatchedTreeHashExclusionsAndMutation(t *testing.T) {
+	root := writeModule(t, syntheticSource)
+	base := generateFixture(t, root).PatchedSourceTreeSHA256
+	paths := []string{filepath.Join(root, "build", "artifact"), filepath.Join(root, "pkg", "gttsource", "generated_manifest.go")}
+	for _, path := range paths {
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte("ignored"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := generateFixture(t, root).PatchedSourceTreeSHA256; got != base {
+		t.Fatalf("excluded output changed tree hash: %s != %s", got, base)
+	}
+	if err := os.WriteFile(filepath.Join(root, "ordinary.go"), []byte("package fixture\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if got := generateFixture(t, root).PatchedSourceTreeSHA256; got == base {
+		t.Fatal("ordinary source mutation did not change tree hash")
+	}
+}
