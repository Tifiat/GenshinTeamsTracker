+package gttsource
+
+import "testing"
+
+func TestLookupUsesModuleRelativeSuffixAndFailsClosed(t *testing.T) {
+	originalIDs := generatedSourceIDByLookupKey
+	originalTemplates := generatedTemplateSHA256BySourceID
+	defer func() {
+		generatedSourceIDByLookupKey = originalIDs
+		generatedTemplateSHA256BySourceID = originalTemplates
+	}()
+
+	sourceID := "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
+	templateSHA := "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
+	generatedSourceIDByLookupKey = map[string]string{
+		KindQueuedAttack + "|internal/characters/example/skill.go|42": sourceID,
+	}
+	generatedTemplateSHA256BySourceID = map[string]string{sourceID: templateSHA}
+
+	if got := Lookup(KindQueuedAttack, `C:\staging\gcsim\internal\characters\example\skill.go`, 42); got != sourceID {
+		t.Fatalf("Lookup() = %q, want %q", got, sourceID)
+	}
+	if got := TemplateSHA256(sourceID); got != templateSHA {
+		t.Fatalf("TemplateSHA256() = %q, want %q", got, templateSHA)
+	}
+	if got := Lookup(KindTaskCallback, `C:\staging\gcsim\internal\characters\example\skill.go`, 42); got != "" {
+		t.Fatalf("wrong seam resolved %q", got)
+	}
+	if ValidID("gttsrc-v1:" + sourceID) {
+		t.Fatal("prefixed source ID must be rejected by the v4 wire contract")
+	}
+}
diff --git a/pkg/gttsourcegen/canonical.go b/pkg/gttsourcegen/canonical.go
new file mode 100644
index 0000000000000000000000000000000000000000..401d2bc1e77efa5985ee928403b6bad94cd88599
--- /dev/null
+++ b/pkg/gttsourcegen/canonical.go
@@ -0,0 +1,79 @@
+package gttsourcegen
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strconv"
+)
+
+// CanonicalJSON returns compact JSON with recursively sorted object keys and
+// ASCII-only string escapes. It is the one byte representation used for all
+// build-time source hashes.
+func CanonicalJSON(value any) ([]byte, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.UseNumber()
+	var normalized any
+	if err := decoder.Decode(&normalized); err != nil {
+		return nil, err
+	}
+	var out bytes.Buffer
+	if err := appendCanonicalJSON(&out, normalized); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
+
+func appendCanonicalJSON(out *bytes.Buffer, value any) error {
+	switch value := value.(type) {
+	case nil:
+		out.WriteString("null")
+	case bool:
+		if value {
+			out.WriteString("true")
+		} else {
+			out.WriteString("false")
+		}
+	case string:
+		out.WriteString(strconv.QuoteToASCII(value))
+	case json.Number:
+		out.WriteString(value.String())
+	case []any:
+		out.WriteByte('[')
+		for index, element := range value {
+			if index > 0 {
+				out.WriteByte(',')
+			}
+			if err := appendCanonicalJSON(out, element); err != nil {
+				return err
+			}
+		}
+		out.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(value))
+		for key := range value {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		out.WriteByte('{')
+		for index, key := range keys {
+			if index > 0 {
+				out.WriteByte(',')
+			}
+			out.WriteString(strconv.QuoteToASCII(key))
+			out.WriteByte(':')
+			if err := appendCanonicalJSON(out, value[key]); err != nil {
+				return err
+			}
+		}
+		out.WriteByte('}')
+	default:
+		return fmt.Errorf("unsupported canonical JSON value %T", value)
+	}
+	return nil
+}
