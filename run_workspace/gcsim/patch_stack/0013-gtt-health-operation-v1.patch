+
+func validateGTTHealthOperationsWithSourceLookup(
+	buffer optstats.GTTTraceEquationBuffer,
+	characterKeys []string,
+	sourceKnown func(string) bool,
+) error {
+	if buffer.HealthOperations == nil {
+		return errors.New("gtt trace equation: null health_operations")
+	}
+	characterCount := len(characterKeys)
+	if characterCount <= 0 {
+		return errors.New("gtt trace equation: invalid health character catalog")
+	}
+	if sourceKnown == nil {
+		return errors.New("gtt trace equation: missing health source catalog")
+	}
+	occurrences := make(map[string]gtttrace.SourceOccurrence, len(buffer.SourceOccurrences))
+	for _, occurrence := range buffer.SourceOccurrences {
+		occurrences[occurrence.OccurrenceID] = occurrence
+	}
+	lastFrame := -1
+	for index, row := range buffer.HealthOperations {
+		if row.SequenceIndex != index || row.OperationID != "health-operation:"+strconv.Itoa(index) ||
+			row.Frame < 0 || row.Frame < lastFrame || row.TargetIndex < 0 || row.TargetIndex >= characterCount ||
+			row.ModifierContributions == nil || row.UncertaintyCodes == nil {
+			return fmt.Errorf("gtt trace equation: invalid health operation %d", index)
+		}
+		if err := validateGTTHealthProvider(row.Provider, characterKeys); err != nil {
+			return fmt.Errorf("gtt trace equation: health operation %d provider: %w", index, err)
+		}
+		if row.ParentOccurrenceID != nil {
+			occurrence, ok := occurrences[*row.ParentOccurrenceID]
+			if !ok || occurrence.Frame > row.Frame {
+				return fmt.Errorf("gtt trace equation: health operation %d missing parent occurrence", index)
+			}
+		}
+		if row.CallerIndex != nil && (*row.CallerIndex < 0 || *row.CallerIndex >= characterCount) {
+			return fmt.Errorf("gtt trace equation: health operation %d invalid caller", index)
+		}
+		for _, value := range []float64{
+			row.InputValue, row.AdjustedInputValue, row.RawAmount, row.EventAmount,
+			row.EventEffectiveAmount, row.HPDeltaMagnitude, row.HPDebtBefore,
+			row.HPDebtAfter, row.MaxHPBefore, row.MaxHPAfter, row.HPBefore,
+			row.HPAfter, row.HPRatioBefore, row.HPRatioAfter,
+		} {
+			if !gttTraceFinite(value) {
+				return fmt.Errorf("gtt trace equation: health operation %d non-finite value", index)
+			}
+		}
+		if row.InputValue < 0 || row.AdjustedInputValue < 0 || row.RawAmount < 0 ||
+			row.EventAmount < 0 || row.EventEffectiveAmount < 0 ||
+			row.MaxHPBefore <= 0 || row.MaxHPAfter <= 0 || row.HPDebtBefore < 0 ||
+			row.HPDebtAfter < 0 || row.HPBefore < 0 || row.HPAfter < 0 || row.HPDeltaMagnitude < 0 ||
+			row.HPBefore > row.MaxHPBefore || row.HPAfter > row.MaxHPAfter ||
+			row.HPRatioBefore < 0 || row.HPRatioBefore > 1 ||
+			row.HPRatioAfter < 0 || row.HPRatioAfter > 1 ||
+			!gttTraceClose(row.HPBefore, row.HPRatioBefore*row.MaxHPBefore) ||
+			!gttTraceClose(row.HPAfter, row.HPRatioAfter*row.MaxHPAfter) ||
+			!gttTraceClose(row.HPDeltaMagnitude, math.Abs(row.HPAfter-row.HPBefore)) {
+			return fmt.Errorf("gtt trace equation: health operation %d invalid HP ledger", index)
+		}
+		previousCode := ""
+		for codeIndex, code := range row.UncertaintyCodes {
+			if strings.TrimSpace(code) == "" || (codeIndex > 0 && code <= previousCode) {
+				return fmt.Errorf("gtt trace equation: health operation %d uncertainty codes not canonical", index)
+			}
+			previousCode = code
+		}
+		if row.CandidateDependencyComplete && len(row.UncertaintyCodes) != 0 {
+			return fmt.Errorf("gtt trace equation: health operation %d complete with uncertainty", index)
+		}
+		if !row.CandidateDependencyComplete && len(row.UncertaintyCodes) == 0 {
+			return fmt.Errorf("gtt trace equation: health operation %d incomplete without uncertainty", index)
+		}
+		modifierTotal := 0.0
+		for contributionIndex, contribution := range row.ModifierContributions {
+			wantID := row.OperationID + ":modifier:" + strconv.Itoa(contributionIndex)
+			if contribution.ContributionID != wantID || strings.TrimSpace(contribution.ModifierKey) == "" ||
+				!gttTraceFinite(contribution.Value) ||
+				(contribution.ExpiryFrame != -1 && contribution.ExpiryFrame <= row.Frame) {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid modifier contribution %d", index, contributionIndex)
+			}
+			if !gttTraceSHA256(contribution.SourceID) || !sourceKnown(contribution.SourceID) {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid modifier source %d", index, contributionIndex)
+			}
+			if err := validateGTTHealthProvider(contribution.Provider, characterKeys); err != nil {
+				return fmt.Errorf("gtt trace equation: health operation %d modifier provider %d: %w", index, contributionIndex, err)
+			}
+			if contribution.SourceOccurrenceID != nil {
+				occurrence, ok := occurrences[*contribution.SourceOccurrenceID]
+				if !ok || occurrence.Frame > row.Frame || occurrence.SourceID != contribution.SourceID || occurrence.Provider != contribution.Provider {
+					return fmt.Errorf("gtt trace equation: health operation %d invalid modifier occurrence %d", index, contributionIndex)
+				}
+			}
+			if row.CandidateDependencyComplete && !contribution.CandidateDependencyComplete {
+				return fmt.Errorf("gtt trace equation: health operation %d incomplete modifier dependency %d", index, contributionIndex)
+			}
+			modifierTotal += contribution.Value
+		}
+		switch row.Kind {
+		case gtttrace.HealthOperationHeal:
+			if row.HealType == nil || (*row.HealType != gtttrace.HealthHealTypeAbsolute &&
+				*row.HealType != gtttrace.HealthHealTypePercent) || row.External != nil ||
+				row.BaseAmount == nil || row.SourceBonus == nil || row.HealBonusTotal == nil ||
+				row.Overheal == nil {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid heal shape", index)
+			}
+			for _, value := range []*float64{row.BaseAmount, row.SourceBonus, row.HealBonusTotal, row.Overheal} {
+				if !gttTraceFinite(*value) {
+					return fmt.Errorf("gtt trace equation: health operation %d non-finite heal value", index)
+				}
+			}
+			expectedBase := row.AdjustedInputValue
+			if *row.HealType == gtttrace.HealthHealTypePercent {
+				expectedBase *= row.MaxHPBefore
+			}
+			if *row.BaseAmount < 0 || *row.Overheal < 0 ||
+				!gttTraceClose(row.InputValue, row.AdjustedInputValue) ||
+				!gttTraceClose(*row.BaseAmount, expectedBase) ||
+				!gttTraceClose(modifierTotal, *row.HealBonusTotal) ||
+				!gttTraceClose(row.RawAmount, *row.BaseAmount*(1+*row.SourceBonus+*row.HealBonusTotal)) ||
+				!gttTraceClose(row.EventEffectiveAmount, math.Max(row.EventAmount-*row.Overheal, 0)) {
+				return fmt.Errorf("gtt trace equation: health operation %d heal arithmetic mismatch", index)
+			}
+		case gtttrace.HealthOperationDrain:
+			if row.CallerIndex != nil || row.HealType != nil || row.External == nil ||
+				row.BaseAmount != nil || row.SourceBonus != nil || row.HealBonusTotal != nil ||
+				row.Overheal != nil || len(row.ModifierContributions) != 0 ||
+				!gttTraceClose(row.RawAmount, row.AdjustedInputValue) ||
+				!gttTraceClose(row.EventAmount, row.AdjustedInputValue) ||
+				!gttTraceClose(row.EventEffectiveAmount, row.EventAmount) {
+				return fmt.Errorf("gtt trace equation: health operation %d invalid drain shape", index)
+			}
+		default:
+			return fmt.Errorf("gtt trace equation: health operation %d invalid kind", index)
+		}
+		lastFrame = row.Frame
+	}
 	return nil
 }
 
@@ -568,6 +721,22 @@ func validateGTTTraceProvider(provider gtttrace.Provider) error {
 	return nil
 }
 
+func validateGTTHealthProvider(provider gtttrace.Provider, characterKeys []string) error {
+	if err := validateGTTTraceProvider(provider); err != nil {
+		return err
+	}
+	if !provider.Known {
+		return nil
+	}
+	if provider.OwnerIndex < 0 || provider.OwnerIndex >= len(characterKeys) {
+		return errors.New("provider owner exceeds character catalog")
+	}
+	if strings.EqualFold(provider.Kind, "character") && characterKeys[provider.OwnerIndex] != provider.Key {
+		return errors.New("character provider owner binding mismatch")
+	}
+	return nil
+}
+
 func gttTraceFinite(value float64) bool {
 	return !math.IsNaN(value) && !math.IsInf(value, 0)
 }
