new file mode 100644
index 0000000000000000000000000000000000000000..519d8a86805dbbcee6c4030d875d194548ce6dd8
--- /dev/null
+++ b/pkg/optimization/optstats/trace_equation_health_test.go
@@ -0,0 +1,49 @@
+package optstats
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestFlushAddsHealthWithoutChangingInheritedEvidenceCollections(t *testing.T) {
+	c, err := core.New(core.Opt{Seed: 7})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.GTTTrace.Enable()
+	buffer := GTTTraceEquationBuffer{
+		Hits:           []info.GTTTraceHit{{HitID: 1, Ability: "sentinel"}},
+		TopologyEvents: []GTTTraceTopologyEvent{{EventID: 1, Frame: 3, Kind: "sentinel"}},
+		Unsupported:    []string{}, ProviderTransitions: []gtttrace.ModifierTransition{},
+		SourceOccurrences: []gtttrace.SourceOccurrence{}, SourceValueBindings: []gtttrace.SourceValueBinding{},
+		HealthOperations: []gtttrace.HealthOperation{},
+	}
+	wantHits := append([]info.GTTTraceHit{}, buffer.Hits...)
+	wantTopology := append([]GTTTraceTopologyEvent{}, buffer.TopologyEvents...)
+	wantTransitions := append([]gtttrace.ModifierTransition{}, buffer.ProviderTransitions...)
+	wantOccurrences := append([]gtttrace.SourceOccurrence{}, buffer.SourceOccurrences...)
+	wantBindings := append([]gtttrace.SourceValueBinding{}, buffer.SourceValueBindings...)
+
+	sequence, _ := c.GTTTrace.BeginHealthOperation()
+	c.GTTTrace.CompleteHealthOperation(sequence, gtttrace.HealthOperation{
+		Kind: gtttrace.HealthOperationDrain, Frame: 3,
+		Provider: gtttrace.UnknownProvider("fixture", "health"), TargetIndex: 0,
+		ModifierContributions: []gtttrace.HealthModifierContribution{},
+		UncertaintyCodes:      []string{"fixture_incomplete"},
+	})
+	flushed := buffer.Flush(c)
+	if !reflect.DeepEqual(flushed.Hits, wantHits) ||
+		!reflect.DeepEqual(flushed.TopologyEvents, wantTopology) ||
+		!reflect.DeepEqual(flushed.ProviderTransitions, wantTransitions) ||
+		!reflect.DeepEqual(flushed.SourceOccurrences, wantOccurrences) ||
+		!reflect.DeepEqual(flushed.SourceValueBindings, wantBindings) {
+		t.Fatal("health flush changed an inherited v4 evidence collection")
+	}
+	if len(flushed.HealthOperations) != 1 || flushed.HealthOperations[0].OperationID != "health-operation:0" {
+		t.Fatalf("health operations = %#v", flushed.HealthOperations)
+	}
+}
