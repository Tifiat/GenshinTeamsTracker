diff --git a/pkg/gtttrace/health.go b/pkg/gtttrace/health.go
new file mode 100644
index 0000000000000000000000000000000000000000..91c84b8747a3add0b52dd47d97412d7df40fd130
--- /dev/null
+++ b/pkg/gtttrace/health.go
@@ -0,0 +1,174 @@
+package gtttrace
+
+import (
+	"sort"
+	"strconv"
+)
+
+const (
+	HealthOperationHeal  = "heal"
+	HealthOperationDrain = "drain"
+
+	HealthHealTypeAbsolute = "absolute"
+	HealthHealTypePercent  = "percent"
+)
+
+// HealthModifierContribution is a health-local evaluation receipt. Its
+// ContributionID is intentionally separate from the v4 SourceOccurrence
+// namespace so enabling the additive v5 ledger cannot change inherited v4
+// source rows.
+type HealthModifierContribution struct {
+	ContributionID              string   `json:"contribution_id"`
+	ModifierKey                 string   `json:"modifier_key"`
+	SourceID                    string   `json:"source_id"`
+	SourceOccurrenceID          *string  `json:"source_occurrence_id"`
+	Provider                    Provider `json:"provider"`
+	Value                       float64  `json:"value"`
+	ExpiryFrame                 int      `json:"expiry_frame"`
+	CandidateDependencyComplete bool     `json:"candidate_dependency_complete"`
+}
+
+// HealthOperation is the additive gtt_trace_equation_v5 receipt for a single
+// central heal or drain. Nullable fields use pointers so their JSON shape is
+// explicit and stable rather than being omitted.
+type HealthOperation struct {
+	SequenceIndex               int                          `json:"sequence_index"`
+	OperationID                 string                       `json:"operation_id"`
+	Kind                        string                       `json:"kind"`
+	Frame                       int                          `json:"frame"`
+	ParentOccurrenceID          *string                      `json:"parent_occurrence_id"`
+	Provider                    Provider                     `json:"provider"`
+	CallerIndex                 *int                         `json:"caller_index"`
+	TargetIndex                 int                          `json:"target_index"`
+	HealType                    *string                      `json:"heal_type"`
+	External                    *bool                        `json:"external"`
+	InputValue                  float64                      `json:"input_value"`
+	AdjustedInputValue          float64                      `json:"adjusted_input_value"`
+	BaseAmount                  *float64                     `json:"base_amount"`
+	SourceBonus                 *float64                     `json:"source_bonus"`
+	HealBonusTotal              *float64                     `json:"heal_bonus_total"`
+	RawAmount                   float64                      `json:"raw_amount"`
+	EventAmount                 float64                      `json:"event_amount"`
+	EventEffectiveAmount        float64                      `json:"event_effective_amount"`
+	HPDeltaMagnitude            float64                      `json:"hp_delta_magnitude"`
+	Overheal                    *float64                     `json:"overheal"`
+	HPDebtBefore                float64                      `json:"hp_debt_before"`
+	HPDebtAfter                 float64                      `json:"hp_debt_after"`
+	MaxHPBefore                 float64                      `json:"max_hp_before"`
+	MaxHPAfter                  float64                      `json:"max_hp_after"`
+	HPBefore                    float64                      `json:"hp_before"`
+	HPAfter                     float64                      `json:"hp_after"`
+	HPRatioBefore               float64                      `json:"hp_ratio_before"`
+	HPRatioAfter                float64                      `json:"hp_ratio_after"`
+	ModifierContributions       []HealthModifierContribution `json:"modifier_contributions"`
+	CandidateDependencyComplete bool                         `json:"candidate_dependency_complete"`
+	UncertaintyCodes            []string                     `json:"uncertainty_codes"`
+}
+
+// BeginHealthOperation reserves ordering before any modifier evaluation or
+// event callback can trigger a nested health operation.
+func (r *Runtime) BeginHealthOperation() (int, string) {
+	if !r.Enabled() {
+		return -1, ""
+	}
+	sequenceIndex := len(r.healthOperations)
+	operationID := "health-operation:" + strconv.Itoa(sequenceIndex)
+	r.healthOperations = append(r.healthOperations, HealthOperation{
+		SequenceIndex:         sequenceIndex,
+		OperationID:           operationID,
+		ModifierContributions: []HealthModifierContribution{},
+		UncertaintyCodes:      []string{},
+	})
+	return sequenceIndex, operationID
+}
+
+// CompleteHealthOperation fills a previously reserved row while preserving
+// the runtime-owned identity. Invalid handles fail closed and are rejected by
+// the output validator rather than mutating another row.
+func (r *Runtime) CompleteHealthOperation(sequenceIndex int, row HealthOperation) {
+	if !r.Enabled() || sequenceIndex < 0 || sequenceIndex >= len(r.healthOperations) {
+		return
+	}
+	reserved := r.healthOperations[sequenceIndex]
+	row.SequenceIndex = reserved.SequenceIndex
+	row.OperationID = reserved.OperationID
+	row.Provider = NormalizeProvider(row.Provider)
+	row.ParentOccurrenceID = cloneString(row.ParentOccurrenceID)
+	row.CallerIndex = cloneInt(row.CallerIndex)
+	row.HealType = cloneString(row.HealType)
+	row.External = cloneBool(row.External)
+	row.BaseAmount = cloneFloat(row.BaseAmount)
+	row.SourceBonus = cloneFloat(row.SourceBonus)
+	row.HealBonusTotal = cloneFloat(row.HealBonusTotal)
+	row.Overheal = cloneFloat(row.Overheal)
+	row.ModifierContributions = cloneHealthModifierContributions(row.ModifierContributions)
+	row.UncertaintyCodes = canonicalStrings(row.UncertaintyCodes)
+	r.healthOperations[sequenceIndex] = row
+}
+
+func (r *Runtime) HealthOperations() []HealthOperation {
+	if r == nil || len(r.healthOperations) == 0 {
+		return []HealthOperation{}
+	}
+	out := make([]HealthOperation, len(r.healthOperations))
+	for index, row := range r.healthOperations {
+		row.ParentOccurrenceID = cloneString(row.ParentOccurrenceID)
+		row.CallerIndex = cloneInt(row.CallerIndex)
+		row.HealType = cloneString(row.HealType)
+		row.External = cloneBool(row.External)
+		row.BaseAmount = cloneFloat(row.BaseAmount)
+		row.SourceBonus = cloneFloat(row.SourceBonus)
+		row.HealBonusTotal = cloneFloat(row.HealBonusTotal)
+		row.Overheal = cloneFloat(row.Overheal)
+		row.ModifierContributions = cloneHealthModifierContributions(row.ModifierContributions)
+		row.UncertaintyCodes = append([]string{}, row.UncertaintyCodes...)
+		out[index] = row
+	}
+	return out
+}
+
+func cloneHealthModifierContributions(values []HealthModifierContribution) []HealthModifierContribution {
+	if values == nil {
+		return []HealthModifierContribution{}
+	}
+	out := make([]HealthModifierContribution, len(values))
+	for index, value := range values {
+		value.Provider = NormalizeProvider(value.Provider)
+		value.SourceOccurrenceID = cloneString(value.SourceOccurrenceID)
+		out[index] = value
+	}
+	return out
+}
+
+func canonicalStrings(values []string) []string {
+	if len(values) == 0 {
+		return []string{}
+	}
+	out := append([]string{}, values...)
+	sort.Strings(out)
+	write := 0
+	for _, value := range out {
+		if value == "" || (write > 0 && out[write-1] == value) {
+			continue
+		}
+		out[write] = value
+		write++
+	}
+	return out[:write]
+}
+
+func cloneBool(value *bool) *bool {
+	if value == nil {
+		return nil
+	}
+	cloned := *value
+	return &cloned
+}
+
+func cloneFloat(value *float64) *float64 {
+	if value == nil {
+		return nil
+	}
+	cloned := *value
+	return &cloned
+}
