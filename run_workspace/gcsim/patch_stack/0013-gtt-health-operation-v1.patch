@@ -0,0 +1,121 @@
+package optimization
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gtt"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func healthFloat(value float64) *float64 { return &value }
+func healthString(value string) *string  { return &value }
+func healthInt(value int) *int           { return &value }
+func healthBool(value bool) *bool        { return &value }
+
+var healthFixtureCharacterKeys = []string{"chasca", "furina"}
+
+func validateHealthFixture(buffer optstats.GTTTraceEquationBuffer) error {
+	knownSourceID := strings.Repeat("a", 64)
+	return validateGTTHealthOperationsWithSourceLookup(
+		buffer,
+		healthFixtureCharacterKeys,
+		func(sourceID string) bool { return sourceID == knownSourceID },
+	)
+}
+
+func validHealthBuffer() optstats.GTTTraceEquationBuffer {
+	provider := gtttrace.UnknownProvider("fixture", "health")
+	modifierProvider := gtttrace.UnknownProvider("fixture", "modifier")
+	sourceID := strings.Repeat("a", 64)
+	return optstats.GTTTraceEquationBuffer{HealthOperations: []gtttrace.HealthOperation{
+		{
+			SequenceIndex: 0, OperationID: "health-operation:0", Kind: gtttrace.HealthOperationHeal,
+			Frame: 10, Provider: provider, CallerIndex: healthInt(0), TargetIndex: 1,
+			HealType:   healthString(gtttrace.HealthHealTypeAbsolute),
+			InputValue: 200, AdjustedInputValue: 200,
+			BaseAmount: healthFloat(200), SourceBonus: healthFloat(0.1), HealBonusTotal: healthFloat(0.2),
+			RawAmount: 260, EventAmount: 210, EventEffectiveAmount: 200, HPDeltaMagnitude: 200,
+			Overheal: healthFloat(10), HPDebtBefore: 50, HPDebtAfter: 0,
+			MaxHPBefore: 1000, MaxHPAfter: 1000, HPBefore: 800, HPAfter: 1000,
+			HPRatioBefore: 0.8, HPRatioAfter: 1,
+			ModifierContributions: []gtttrace.HealthModifierContribution{{
+				ContributionID: "health-operation:0:modifier:0", ModifierKey: "incoming-heal",
+				SourceID: sourceID, Provider: modifierProvider, Value: 0.2, ExpiryFrame: -1,
+			}},
+			UncertaintyCodes: []string{"health_input_candidate_dependency_unbound"},
+		},
+		{
+			SequenceIndex: 1, OperationID: "health-operation:1", Kind: gtttrace.HealthOperationDrain,
+			Frame: 11, Provider: provider, TargetIndex: 1, External: healthBool(false),
+			InputValue: 400, AdjustedInputValue: 200, RawAmount: 200, EventAmount: 200,
+			EventEffectiveAmount: 200, HPDeltaMagnitude: 100,
+			HPDebtBefore: 0, HPDebtAfter: 0, MaxHPBefore: 1000, MaxHPAfter: 1000,
+			HPBefore: 100, HPAfter: 0, HPRatioBefore: 0.1, HPRatioAfter: 0,
+			ModifierContributions: []gtttrace.HealthModifierContribution{},
+			UncertaintyCodes:      []string{"health_effective_delta_unexplained"},
+		},
+	}}
+}
+
+func TestTraceEquationV5HealthValidation(t *testing.T) {
+	if GTTTraceEquationOutputSchemaVersion != 5 || gtt.TraceEquationV5Capability != "gtt_trace_equation_v5" {
+		t.Fatal("v5 schema/capability drift")
+	}
+	buffer := validHealthBuffer()
+	if err := validateHealthFixture(buffer); err != nil {
+		t.Fatalf("valid ledger: %v", err)
+	}
+
+	broken := validHealthBuffer()
+	broken.HealthOperations[0].RawAmount++
+	if err := validateHealthFixture(broken); err == nil || !strings.Contains(err.Error(), "arithmetic mismatch") {
+		t.Fatalf("raw mismatch error = %v", err)
+	}
+
+	broken = validHealthBuffer()
+	broken.HealthOperations[0].ModifierContributions[0].ContributionID = "duplicate"
+	if err := validateHealthFixture(broken); err == nil || !strings.Contains(err.Error(), "modifier contribution") {
+		t.Fatalf("contribution identity error = %v", err)
+	}
+
+	broken = validHealthBuffer()
+	broken.HealthOperations = nil
+	if err := validateHealthFixture(broken); err == nil || !strings.Contains(err.Error(), "null health_operations") {
+		t.Fatalf("null ledger error = %v", err)
+	}
+
+	invalidCases := map[string]func(*optstats.GTTTraceEquationBuffer){
+		"missing source identity": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].ModifierContributions[0].SourceID = ""
+		},
+		"unknown source identity": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].ModifierContributions[0].SourceID = strings.Repeat("b", 64)
+		},
+		"expired contribution": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].ModifierContributions[0].ExpiryFrame = 10
+		},
+		"missing uncertainty": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].UncertaintyCodes = []string{}
+		},
+		"bad character index": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].TargetIndex = 2
+		},
+		"mismatched character provider": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].Provider = gtttrace.NewProvider("character", "chasca", 1, 0)
+		},
+		"bad percent base": func(buffer *optstats.GTTTraceEquationBuffer) {
+			buffer.HealthOperations[0].HealType = healthString(gtttrace.HealthHealTypePercent)
+		},
+	}
+	for name, mutate := range invalidCases {
+		t.Run(name, func(t *testing.T) {
+			broken := validHealthBuffer()
+			mutate(&broken)
+			if err := validateHealthFixture(broken); err == nil {
+				t.Fatal("invalid health ledger was accepted")
+			}
+		})
+	}
+}
