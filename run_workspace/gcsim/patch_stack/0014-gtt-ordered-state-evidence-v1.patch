+// RecordSourceNumericEval records a build-time compiled numeric source without
+// re-evaluating it. The caller passes the already-observed value.
+func (r *Runtime) RecordSourceNumericEval(
+	sourceID, templateSHA256 string,
+	parameters []SourceValueParameter,
+	operator string,
+	inputs []NumericRef,
+	value float64,
+	evidence DependencyEvidence,
+) string {
+	return r.recordNumericEval(sourceID, templateSHA256, parameters, operator, inputs, value, evidence)
+}
+
+func (r *Runtime) recordNumericEval(
+	sourceID, templateSHA256 string,
+	parameters []SourceValueParameter,
+	operator string,
+	inputs []NumericRef,
+	value float64,
+	evidence DependencyEvidence,
+) string {
+	if !r.Enabled() || strings.TrimSpace(operator) == "" || !finite(value) {
+		return ""
+	}
+	row := StateEvent{
+		Frame: r.Frame(), Kind: StateEventNumericEval, SourceID: optionalString(sourceID),
+		Operation: optionalString(operator), Inputs: inputs,
+		Value: optionalFloat(value), Parameters: parameters,
+		CandidateDependencyComplete: evidence.CandidateDependencyComplete,
+		UncertaintyCodes:            evidence.UncertaintyCodes,
+	}
+	if operator == "source_expression" || operator == "health_input" || operator == "task_payload" || operator == "state_transition" {
+		row.CandidateDependencyComplete = false
+		row.UncertaintyCodes = append(row.UncertaintyCodes, "numeric_marker_replay_not_recomputed")
+	}
+	if validSHA256(templateSHA256) {
+		row.TemplateSHA256 = optionalString(templateSHA256)
+	}
+	return r.appendStateEvent(row)
+}
+
