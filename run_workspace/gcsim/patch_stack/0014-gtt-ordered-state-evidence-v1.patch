+func (r *Runtime) EnterHealthOperation(operationID string) func() {
+	if !r.Enabled() || !r.healthOperationExists(operationID) {
+		return func() {}
+	}
+	callID := r.nextStateEventID()
+	enterID := r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventHealthContextEnter,
+		HealthOperationID: optionalString(operationID), CallID: optionalString(callID),
+		UncertaintyCodes: []string{"health_context_candidate_dependency_incomplete"},
+	})
+	r.healthContextStack = append(r.healthContextStack, operationID)
+	r.stateEventStack = append(r.stateEventStack, enterID)
+	return func() {
+		if len(r.stateEventStack) > 0 && r.stateEventStack[len(r.stateEventStack)-1] == enterID {
+			r.stateEventStack = r.stateEventStack[:len(r.stateEventStack)-1]
+		}
+		if len(r.healthContextStack) > 0 && r.healthContextStack[len(r.healthContextStack)-1] == operationID {
+			r.healthContextStack = r.healthContextStack[:len(r.healthContextStack)-1]
+		}
+		r.appendStateEvent(StateEvent{
+			Frame: r.Frame(), Kind: StateEventHealthContextExit,
+			HealthOperationID: optionalString(operationID), CallID: optionalString(callID),
+			ParentEventID:    optionalString(enterID),
+			UncertaintyCodes: []string{"health_context_candidate_dependency_incomplete"},
+		})
+	}
+}
