+func (r *Runtime) RecordModifierEval(
+	channel, modifierKey string,
+	recipientIndex int,
+	sourceID string,
+	provider Provider,
+	expiryFrame int,
+	accepted bool,
+	output map[string]float64,
+	inputs []NumericRef,
+	evidence DependencyEvidence,
+) string {
+	if !r.Enabled() || strings.TrimSpace(channel) == "" || strings.TrimSpace(modifierKey) == "" || recipientIndex < 0 {
+		return ""
+	}
+	eventID := r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventModifierEval, SourceID: optionalString(sourceID),
+		Provider: provider, Channel: optionalString(channel), Key: optionalString(modifierKey),
+		ExpiryFrame: optionalInt(expiryFrame), OwnerIndex: optionalInt(recipientIndex),
+		Accepted: optionalBool(accepted), Output: output, Inputs: inputs,
+		CandidateDependencyComplete: evidence.CandidateDependencyComplete,
+		UncertaintyCodes:            evidence.UncertaintyCodes,
+	})
+	if eventID != "" {
+		for index := range r.modifierEvalCaptures {
+			r.modifierEvalCaptures[index].ids = append(r.modifierEvalCaptures[index].ids, eventID)
+		}
+	}
+	return eventID
+}
+
+func (r *Runtime) BeginNumericDependencyCapture() int {
+	if !r.Enabled() {
+		return -1
+	}
+	r.nextNumericDependencyCaptureToken++
+	token := r.nextNumericDependencyCaptureToken
+	r.numericDependencyCaptures = append(
+		r.numericDependencyCaptures,
+		numericDependencyCapture{token: token, ids: []string{}},
+	)
+	return token
+}
+
+func (r *Runtime) EndNumericDependencyCapture(token int) []NumericRef {
+	if !r.Enabled() || len(r.numericDependencyCaptures) == 0 {
+		return []NumericRef{}
+	}
+	index := len(r.numericDependencyCaptures) - 1
+	capture := r.numericDependencyCaptures[index]
+	if capture.token != token {
+		return []NumericRef{}
+	}
+	r.numericDependencyCaptures = r.numericDependencyCaptures[:index]
+	refs := make([]NumericRef, 0, len(capture.ids))
+	for _, eventID := range capture.ids {
+		refs = append(refs, EventRef(eventID))
+	}
+	return refs
+}
+
+func (r *Runtime) BeginModifierEvalCapture() int {
+	if !r.Enabled() {
+		return -1
+	}
+	r.nextModifierCaptureToken++
+	token := r.nextModifierCaptureToken
+	r.modifierEvalCaptures = append(r.modifierEvalCaptures, modifierEvalCapture{token: token, ids: []string{}})
+	return token
+}
+
+func (r *Runtime) EndModifierEvalCapture(token int) []string {
+	if !r.Enabled() || len(r.modifierEvalCaptures) == 0 {
+		return []string{}
+	}
+	index := len(r.modifierEvalCaptures) - 1
+	capture := r.modifierEvalCaptures[index]
+	if capture.token != token {
+		return []string{}
+	}
+	r.modifierEvalCaptures = r.modifierEvalCaptures[:index]
+	return cloneStrings(capture.ids)
+}
