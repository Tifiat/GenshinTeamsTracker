+// execution is unchanged and each payload expression must already have been
+// evaluated exactly once by the caller.
+func (s *Handler) AddSourceNumericPayloads(
+	f func(),
+	delay int,
+	sourceID string,
+	payloads []gtttrace.NumericPayload,
+) {
+	s.addSourceNumericPayloads(f, delay, sourceID, payloads)
+}
+
+func (s *Handler) addSourceNumericPayloads(
+	f func(),
+	delay int,
+	sourceID string,
+	payloads []gtttrace.NumericPayload,
+) {
+	enqueueFrame := *s.f
+	provider := s.trace.Current()
+	parentOccurrenceID := s.trace.EnsureCurrentOccurrence()
+	traceTaskID := s.trace.RecordTaskEnqueue(
+		s.queueID, s.counter, enqueueFrame, delay, enqueueFrame+delay,
+		sourceID, payloads,
+	)
