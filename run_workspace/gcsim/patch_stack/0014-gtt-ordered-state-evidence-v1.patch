+const v2IRContract = `{"ir_version":"gtt_source_ir_v2","operators":["ABS","ADD","AND","CONST","DIV","EQ","GE","GT","LE","LT","MAX","MIN","MUL","NE","NOT","OR","PARAM","SELECT","SUB"],"seams":["event_callback","health_input","modifier_amount","queued_attack","state_operation","task_callback"]}`
+
+func TestV2IRIdentityAndNumericOperators(t *testing.T) {
+	sum := sha256.Sum256([]byte(v2IRContract))
+	if got := hex.EncodeToString(sum[:]); got != IRSHA256 {
+		t.Fatalf("IR SHA=%s, want %s", got, IRSHA256)
+	}
+	fset := token.NewFileSet()
+	expr, err := parser.ParseExprFrom(fset, "formula.go", `max((left-right)/scale, 0) + math.Abs(delta)`, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	compiled := compileNumericTemplate(fset, expr, bindingSet{})
+	if compiled.template.Status != TemplateSupported {
+		t.Fatalf("numeric formula opaque: %#v", compiled.template)
+	}
+	want := map[string]bool{"SUB": false, "DIV": false, "MAX": false, "ABS": false, "ADD": false}
+	for _, node := range compiled.template.Nodes {
+		if _, ok := want[node.Operator]; ok {
+			want[node.Operator] = true
+		}
+	}
+	for operator, found := range want {
+		if !found {
+			t.Fatalf("operator %s missing: %#v", operator, compiled.template.Nodes)
+		}
+	}
+}
