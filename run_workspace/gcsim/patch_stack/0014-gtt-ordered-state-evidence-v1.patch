diff --git a/pkg/gtttrace/state.go b/pkg/gtttrace/state.go
new file mode 100644
index 0000000..afb5407
--- /dev/null
+++ b/pkg/gtttrace/state.go
@@ -0,0 +1,942 @@
+package gtttrace
+
+import (
+	"math"
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+)
+
+const (
+	StateEventHealthContextEnter = "health_context_enter"
+	StateEventHealthContextExit  = "health_context_exit"
+	StateEventCallbackEnter      = "event_callback_enter"
+	StateEventCallbackExit       = "event_callback_exit"
+	StateEventTaskEnqueue        = "task_enqueue"
+	StateEventTaskExecuteEnter   = "task_execute_enter"
+	StateEventTaskExecuteExit    = "task_execute_exit"
+	StateEventStatusRead         = "status_read"
+	StateEventStatusAdd          = "status_add"
+	StateEventStatusDelete       = "status_delete"
+	StateEventSlotRegister       = "state_slot_register"
+	StateEventNumericStateRead   = "state_read"
+	StateEventNumericStateWrite  = "state_write"
+	StateEventStateResync        = "state_resync"
+	StateEventNumericEval        = "numeric_eval"
+	StateEventGuardEval          = "guard_eval"
+	StateEventModifierEval       = "modifier_eval"
+	StateEventMaxHPRead          = "max_hp_read"
+	StateEventHealthFieldBinding = "health_field_binding"
+)
+
+// NumericPayload is copied into a task enqueue receipt. It is deliberately a
+// small key/value pair rather than an arbitrary interface so task evidence is
+// deterministic and JSON-safe.
+type NumericPayload struct {
+	Key       string     `json:"key"`
+	Value     float64    `json:"value"`
+	Reference NumericRef `json:"reference"`
+}
+
+type NumericRef struct {
+	Kind              string   `json:"kind"`
+	EventID           *string  `json:"event_id"`
+	HealthOperationID *string  `json:"health_operation_id"`
+	FieldKey          *string  `json:"field_key"`
+	LiteralValue      *float64 `json:"literal_value"`
+}
+
+type DependencyEvidence struct {
+	CandidateDependencyComplete bool
+	UncertaintyCodes            []string
+}
+
+func CompleteEvidence() DependencyEvidence {
+	return DependencyEvidence{CandidateDependencyComplete: true, UncertaintyCodes: []string{}}
+}
+
+func IncompleteEvidence(codes ...string) DependencyEvidence {
+	return DependencyEvidence{CandidateDependencyComplete: false, UncertaintyCodes: canonicalStrings(codes)}
+}
+
+func SourceDependencyEvidence(
+	sourceID, templateSHA256 string,
+	parameters []SourceValueParameter,
+) DependencyEvidence {
+	if !validSHA256(sourceID) || gttsource.TemplateSHA256(sourceID) == "" {
+		return IncompleteEvidence("numeric_source_identity_missing")
+	}
+	if templateSHA256 == "" || gttsource.TemplateSHA256(sourceID) != templateSHA256 {
+		return IncompleteEvidence("numeric_source_template_missing")
+	}
+	for _, parameter := range parameters {
+		if !parameter.CandidateDependencyComplete {
+			return IncompleteEvidence("numeric_source_parameter_dependency_incomplete")
+		}
+	}
+	return CompleteEvidence()
+}
+
+func EventRef(eventID string) NumericRef {
+	return NumericRef{Kind: "event", EventID: optionalString(eventID)}
+}
+
+func EventOutputRef(eventID, fieldKey string) NumericRef {
+	return NumericRef{
+		Kind: "event", EventID: optionalString(eventID), FieldKey: optionalString(fieldKey),
+	}
+}
+
+func LiteralRef(value float64) NumericRef {
+	return NumericRef{Kind: "literal", LiteralValue: optionalFloat(value)}
+}
+
+func HealthFieldRef(operationID, fieldKey string) NumericRef {
+	return NumericRef{
+		Kind: "health_field", HealthOperationID: optionalString(operationID),
+		FieldKey: optionalString(fieldKey),
+	}
+}
+
+// EnterHelperNumericArguments carries observed numeric arguments across one
+// synchronous helper call. It is generic runtime context; source discovery is
+// responsible for limiting resolution to one unambiguous same-receiver hop.
+func (r *Runtime) EnterHelperNumericArguments(payloads []NumericPayload) func() {
+	if !r.Enabled() {
+		return func() {}
+	}
+	depth := len(r.helperNumericContexts)
+	r.helperNumericContexts = append(r.helperNumericContexts, cloneNumericPayloads(payloads))
+	return func() {
+		if len(r.helperNumericContexts) >= depth {
+			r.helperNumericContexts = r.helperNumericContexts[:depth]
+		}
+	}
+}
+
+// CurrentHelperNumericRef returns the caller-side evidence for one formal
+// parameter when the observed value still matches. Missing/mismatched context
+// fails open to a literal reference and never changes gameplay execution.
+func (r *Runtime) CurrentHelperNumericRef(key string, observed float64) NumericRef {
+	if !r.Enabled() || len(r.helperNumericContexts) == 0 || !finite(observed) {
+		return LiteralRef(observed)
+	}
+	context := r.helperNumericContexts[len(r.helperNumericContexts)-1]
+	for _, payload := range context {
+		if payload.Key != key || !finite(payload.Value) {
+			continue
+		}
+		tolerance := 1e-9 * math.Max(1, math.Max(math.Abs(payload.Value), math.Abs(observed)))
+		if math.Abs(payload.Value-observed) <= tolerance {
+			return cloneNumericRef(payload.Reference)
+		}
+	}
+	return LiteralRef(observed)
+}
+
+// StateSlot is a simulation-local numeric state identity. Slots are registered
+// lazily and deduplicated by (scope, owner_index, slot_key).
+type StateSlot struct {
+	SequenceIndex               int      `json:"sequence_index"`
+	SlotID                      string   `json:"slot_id"`
+	Scope                       string   `json:"scope"`
+	Provider                    Provider `json:"provider"`
+	SlotKey                     string   `json:"slot_key"`
+	InitialValue                float64  `json:"initial_value"`
+	RegistrationEventID         string   `json:"registration_event_id"`
+	CandidateDependencyComplete bool     `json:"candidate_dependency_complete"`
+	UncertaintyCodes            []string `json:"uncertainty_codes"`
+	Authoritative               bool     `json:"authoritative"`
+}
+
+// StateEvent is one fixed-shape ordered union. Every key is emitted for every
+// kind; unused optional scalar fields are null and unused collections are
+// empty. Keeping one exact shape makes cross-language fail-closed decoding
+// possible without changing the inherited v1-v5 arrays.
+type StateEvent struct {
+	SequenceIndex               int                    `json:"sequence_index"`
+	EventID                     string                 `json:"event_id"`
+	Frame                       int                    `json:"frame"`
+	Kind                        string                 `json:"kind"`
+	SourceID                    *string                `json:"source_id"`
+	SourceOccurrenceID          *string                `json:"source_occurrence_id"`
+	Provider                    Provider               `json:"provider"`
+	ParentEventID               *string                `json:"parent_event_id"`
+	HealthOperationID           *string                `json:"health_operation_id"`
+	TaskID                      *string                `json:"task_id"`
+	CallID                      *string                `json:"call_id"`
+	SlotID                      *string                `json:"slot_id"`
+	Channel                     *string                `json:"channel"`
+	Key                         *string                `json:"key"`
+	Operation                   *string                `json:"operation"`
+	Inputs                      []NumericRef           `json:"inputs"`
+	ModifierEvalIDs             []string               `json:"modifier_eval_ids"`
+	TemplateSHA256              *string                `json:"template_sha256"`
+	Parameters                  []SourceValueParameter `json:"parameters"`
+	Before                      *float64               `json:"before"`
+	Value                       *float64               `json:"value"`
+	After                       *float64               `json:"after"`
+	Result                      *bool                  `json:"result"`
+	Accepted                    *bool                  `json:"accepted"`
+	NumericPayload              []NumericPayload       `json:"numeric_payload"`
+	EnqueueFrame                *int                   `json:"enqueue_frame"`
+	DelayFrames                 *int                   `json:"delay_frames"`
+	ExecuteByFrame              *int                   `json:"execute_by_frame"`
+	QueueID                     *string                `json:"queue_id"`
+	QueueSequence               *int                   `json:"queue_sequence"`
+	ExpiryFrame                 *int                   `json:"expiry_frame"`
+	OwnerIndex                  *int                   `json:"owner_index"`
+	TargetIndex                 *int                   `json:"target_index"`
+	Output                      map[string]float64     `json:"output"`
+	BoundEventID                *string                `json:"bound_event_id"`
+	CandidateDependencyComplete bool                   `json:"candidate_dependency_complete"`
+	UncertaintyCodes            []string               `json:"uncertainty_codes"`
+	Authoritative               bool                   `json:"authoritative"`
+}
+
+type modifierEvalCapture struct {
+	token int
+	ids   []string
+}
+
+type numericDependencyCapture struct {
+	token int
+	ids   []string
+}
+
+func (r *Runtime) nextStateEventID() string {
+	return "state-event:" + strconv.Itoa(len(r.stateEvents))
+}
+
+func (r *Runtime) appendStateEvent(row StateEvent) string {
+	if !r.Enabled() {
+		return ""
+	}
+	row.SequenceIndex = len(r.stateEvents)
+	row.EventID = r.nextStateEventID()
+	if row.Frame < 0 {
+		row.Frame = r.Frame()
+	}
+	if row.Provider == (Provider{}) {
+		row.Provider = r.Current()
+	} else {
+		row.Provider = NormalizeProvider(row.Provider)
+	}
+	row.SourceID = r.validOptionalSourceID(row.SourceID)
+	row.SourceOccurrenceID = r.validOptionalOccurrenceID(row.SourceOccurrenceID)
+	if row.SourceOccurrenceID == nil {
+		row.SourceOccurrenceID = r.matchingCurrentOccurrence(row.SourceID, row.Provider)
+	}
+	if row.ParentEventID == nil && len(r.stateEventStack) > 0 {
+		row.ParentEventID = optionalString(r.stateEventStack[len(r.stateEventStack)-1])
+	}
+	if row.HealthOperationID == nil && len(r.healthContextStack) > 0 {
+		row.HealthOperationID = optionalString(r.healthContextStack[len(r.healthContextStack)-1])
+	}
+	row.SourceID = cloneString(row.SourceID)
+	row.SourceOccurrenceID = cloneString(row.SourceOccurrenceID)
+	row.ParentEventID = cloneString(row.ParentEventID)
+	row.HealthOperationID = cloneString(row.HealthOperationID)
+	row.TaskID = cloneString(row.TaskID)
+	row.CallID = cloneString(row.CallID)
+	row.SlotID = cloneString(row.SlotID)
+	row.Channel = cloneString(row.Channel)
+	row.Key = cloneString(row.Key)
+	row.Operation = cloneString(row.Operation)
+	row.TemplateSHA256 = cloneString(row.TemplateSHA256)
+	row.Before = cloneFloat(row.Before)
+	row.Value = cloneFloat(row.Value)
+	row.After = cloneFloat(row.After)
+	row.Result = cloneBool(row.Result)
+	row.Accepted = cloneBool(row.Accepted)
+	row.EnqueueFrame = cloneInt(row.EnqueueFrame)
+	row.DelayFrames = cloneInt(row.DelayFrames)
+	row.ExecuteByFrame = cloneInt(row.ExecuteByFrame)
+	row.QueueID = cloneString(row.QueueID)
+	row.QueueSequence = cloneInt(row.QueueSequence)
+	row.ExpiryFrame = cloneInt(row.ExpiryFrame)
+	row.OwnerIndex = cloneInt(row.OwnerIndex)
+	row.TargetIndex = cloneInt(row.TargetIndex)
+	row.BoundEventID = cloneString(row.BoundEventID)
+	row.Inputs = cloneNumericRefs(row.Inputs)
+	row.ModifierEvalIDs = cloneStrings(row.ModifierEvalIDs)
+	row.Parameters = cloneSourceValueParameters(row.Parameters)
+	row.NumericPayload = cloneNumericPayloads(row.NumericPayload)
+	row.Output = cloneNumericMap(row.Output)
+	row.CandidateDependencyComplete, row.UncertaintyCodes = normalizeEvidence(
+		row.CandidateDependencyComplete, row.UncertaintyCodes,
+	)
+	row.Authoritative = false
+	r.stateEvents = append(r.stateEvents, row)
+	if numericProducerKind(row.Kind) {
+		for index := range r.numericDependencyCaptures {
+			r.numericDependencyCaptures[index].ids = append(r.numericDependencyCaptures[index].ids, row.EventID)
+		}
+	}
+	return row.EventID
+}
+
+// matchingCurrentOccurrence links a V6 state row to the inherited V4/V5
+// occurrence ledger only when both ledgers describe the same source and
+// provider. A state operation may carry its own source identity while running
+// inside a different callback occurrence; inventing that cross-source link is
+// worse than leaving the optional occurrence relation empty.
+func (r *Runtime) matchingCurrentOccurrence(sourceID *string, provider Provider) *string {
+	if sourceID == nil {
+		return nil
+	}
+	occurrenceID := r.CurrentOccurrenceID()
+	index, ok := r.occurrenceIndex[occurrenceID]
+	if !ok || index < 0 || index >= len(r.sourceOccurrences) {
+		return nil
+	}
+	occurrence := r.sourceOccurrences[index]
+	if occurrence.SourceID != *sourceID || occurrence.Provider != provider {
+		return nil
+	}
+	return optionalString(occurrenceID)
+}
+
+func (r *Runtime) validOptionalSourceID(value *string) *string {
+	if value == nil || !validSHA256(*value) {
+		return nil
+	}
+	return value
+}
+
+func (r *Runtime) validOptionalOccurrenceID(value *string) *string {
+	if value == nil {
+		return nil
+	}
+	if _, ok := r.occurrenceIndex[*value]; !ok {
+		return nil
+	}
+	return value
+}
+
+func (r *Runtime) StateSlots() []StateSlot {
+	if r == nil || len(r.stateSlots) == 0 {
+		return []StateSlot{}
+	}
+	out := make([]StateSlot, len(r.stateSlots))
+	for index, row := range r.stateSlots {
+		row.UncertaintyCodes = cloneStrings(row.UncertaintyCodes)
+		out[index] = row
+	}
+	return out
+}
+
+func (r *Runtime) CurrentHealthOperationID() string {
+	if !r.Enabled() || len(r.healthContextStack) == 0 {
+		return ""
+	}
+	return r.healthContextStack[len(r.healthContextStack)-1]
+}
+
+func (r *Runtime) StateEvents() []StateEvent {
+	if r == nil || len(r.stateEvents) == 0 {
+		return []StateEvent{}
+	}
+	out := make([]StateEvent, len(r.stateEvents))
+	for index, row := range r.stateEvents {
+		row.SourceID = cloneString(row.SourceID)
+		row.SourceOccurrenceID = cloneString(row.SourceOccurrenceID)
+		row.ParentEventID = cloneString(row.ParentEventID)
+		row.HealthOperationID = cloneString(row.HealthOperationID)
+		row.TaskID = cloneString(row.TaskID)
+		row.CallID = cloneString(row.CallID)
+		row.SlotID = cloneString(row.SlotID)
+		row.Channel = cloneString(row.Channel)
+		row.Key = cloneString(row.Key)
+		row.Operation = cloneString(row.Operation)
+		row.TemplateSHA256 = cloneString(row.TemplateSHA256)
+		row.Before = cloneFloat(row.Before)
+		row.Value = cloneFloat(row.Value)
+		row.After = cloneFloat(row.After)
+		row.Result = cloneBool(row.Result)
+		row.Accepted = cloneBool(row.Accepted)
+		row.EnqueueFrame = cloneInt(row.EnqueueFrame)
+		row.DelayFrames = cloneInt(row.DelayFrames)
+		row.ExecuteByFrame = cloneInt(row.ExecuteByFrame)
+		row.QueueID = cloneString(row.QueueID)
+		row.QueueSequence = cloneInt(row.QueueSequence)
+		row.ExpiryFrame = cloneInt(row.ExpiryFrame)
+		row.OwnerIndex = cloneInt(row.OwnerIndex)
+		row.TargetIndex = cloneInt(row.TargetIndex)
+		row.BoundEventID = cloneString(row.BoundEventID)
+		row.Inputs = cloneNumericRefs(row.Inputs)
+		row.ModifierEvalIDs = cloneStrings(row.ModifierEvalIDs)
+		row.Parameters = cloneSourceValueParameters(row.Parameters)
+		row.NumericPayload = cloneNumericPayloads(row.NumericPayload)
+		row.Output = cloneNumericMap(row.Output)
+		row.UncertaintyCodes = cloneStrings(row.UncertaintyCodes)
+		out[index] = row
+	}
+	return out
+}
+
+// RegisterNumericStateSlot lazily creates a stable numeric state identity.
+// Repeated calls for the same tuple return the original slot.
+func (r *Runtime) RegisterNumericStateSlot(
+	scope string,
+	provider Provider,
+	slotKey string,
+	initialValue float64,
+	evidence DependencyEvidence,
+) string {
+	if !r.Enabled() || strings.TrimSpace(scope) == "" || strings.TrimSpace(slotKey) == "" || !finite(initialValue) {
+		return ""
+	}
+	provider = NormalizeProvider(provider)
+	lookupKey := scope + "\x00" + providerSortKey(provider) + "\x00" + slotKey
+	if index, ok := r.stateSlotIndex[lookupKey]; ok {
+		slot := r.stateSlots[index]
+		before := r.stateSlotValues[slot.SlotID]
+		if !slot.CandidateDependencyComplete && !numericClose(before, initialValue) {
+			r.appendStateEvent(StateEvent{
+				Frame: r.Frame(), Kind: StateEventStateResync,
+				SlotID: optionalString(slot.SlotID), Provider: slot.Provider,
+				Before: optionalFloat(before), After: optionalFloat(initialValue),
+				CandidateDependencyComplete: false,
+				UncertaintyCodes:            []string{"state_slot_unobserved_mutation"},
+			})
+			r.stateSlotValues[slot.SlotID] = initialValue
+		}
+		return slot.SlotID
+	}
+	sequenceIndex := len(r.stateSlots)
+	slotID := "state-slot:" + strconv.Itoa(sequenceIndex)
+	eventID := r.nextStateEventID()
+	r.stateSlotIndex[lookupKey] = sequenceIndex
+	r.stateSlotValues[slotID] = initialValue
+	complete, uncertainty := normalizeEvidence(evidence.CandidateDependencyComplete, evidence.UncertaintyCodes)
+	r.stateSlots = append(r.stateSlots, StateSlot{
+		SequenceIndex: sequenceIndex, SlotID: slotID, Scope: scope,
+		Provider: provider, SlotKey: slotKey, InitialValue: initialValue,
+		RegistrationEventID: eventID, CandidateDependencyComplete: complete,
+		UncertaintyCodes: uncertainty, Authoritative: false,
+	})
+	r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventSlotRegister, SlotID: optionalString(slotID),
+		Provider: provider, Key: optionalString(slotKey), Value: optionalFloat(initialValue),
+		CandidateDependencyComplete: complete, UncertaintyCodes: uncertainty,
+	})
+	return slotID
+}
+
+func (r *Runtime) RecordNumericStateRead(
+	slotID, sourceID string,
+	value float64,
+	evidence DependencyEvidence,
+) string {
+	if !r.validStateSlot(slotID) || !finite(value) {
+		return ""
+	}
+	return r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventNumericStateRead, SlotID: optionalString(slotID),
+		SourceID: optionalString(sourceID), Value: optionalFloat(value),
+		CandidateDependencyComplete: evidence.CandidateDependencyComplete,
+		UncertaintyCodes:            evidence.UncertaintyCodes,
+	})
+}
+
+func (r *Runtime) RecordNumericStateWrite(
+	slotID, sourceID string,
+	before, after float64,
+	evidence DependencyEvidence,
+) string {
+	if !r.validStateSlot(slotID) || !finite(before) || !finite(after) {
+		return ""
+	}
+	eventID := r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventNumericStateWrite, SlotID: optionalString(slotID),
+		SourceID: optionalString(sourceID), Before: optionalFloat(before), After: optionalFloat(after),
+		CandidateDependencyComplete: evidence.CandidateDependencyComplete,
+		UncertaintyCodes:            evidence.UncertaintyCodes,
+	})
+	r.stateSlotValues[slotID] = after
+	return eventID
+}
+
+func (r *Runtime) validStateSlot(slotID string) bool {
+	if !r.Enabled() || slotID == "" {
+		return false
+	}
+	_, ok := r.stateSlotValues[slotID]
+	return ok
+}
