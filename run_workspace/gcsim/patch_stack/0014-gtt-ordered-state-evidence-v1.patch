+func (r *Runtime) healthOperationExists(operationID string) bool {
+	if r == nil || operationID == "" {
+		return false
+	}
+	for index := range r.healthOperations {
+		if r.healthOperations[index].OperationID == operationID {
+			return true
+		}
+	}
+	return false
+}
+
+func optionalString(value string) *string {
+	if value == "" {
+		return nil
+	}
+	return &value
+}
+
+func optionalInt(value int) *int { return &value }
+
+func optionalFloat(value float64) *float64 { return &value }
+
+func optionalBool(value bool) *bool { return &value }
+
+func cloneStrings(values []string) []string {
+	if values == nil {
+		return []string{}
+	}
+	return append([]string{}, values...)
+}
+
+func cloneNumericPayloads(values []NumericPayload) []NumericPayload {
+	if values == nil {
+		return []NumericPayload{}
+	}
+	out := append([]NumericPayload{}, values...)
+	for index := range out {
+		out[index].Reference = cloneNumericRef(out[index].Reference)
+	}
+	return out
+}
+
+func cloneNumericRefs(values []NumericRef) []NumericRef {
+	if values == nil {
+		return []NumericRef{}
+	}
+	out := append([]NumericRef{}, values...)
+	for index := range out {
+		out[index] = cloneNumericRef(out[index])
+	}
+	return out
+}
+
+func cloneNumericRef(value NumericRef) NumericRef {
+	value.EventID = cloneString(value.EventID)
+	value.HealthOperationID = cloneString(value.HealthOperationID)
+	value.FieldKey = cloneString(value.FieldKey)
+	value.LiteralValue = cloneFloat(value.LiteralValue)
+	return value
+}
+
+func cloneNumericMap(values map[string]float64) map[string]float64 {
+	if values == nil {
+		return map[string]float64{}
+	}
+	out := make(map[string]float64, len(values))
+	for key, value := range values {
+		out[key] = value
+	}
+	return out
+}
+
+func cloneSourceValueParameters(values []SourceValueParameter) []SourceValueParameter {
+	if values == nil {
+		return []SourceValueParameter{}
+	}
+	out := append([]SourceValueParameter{}, values...)
+	for index := range out {
+		out[index].ActorIndex = cloneInt(out[index].ActorIndex)
+		out[index].ActorKey = cloneString(out[index].ActorKey)
+		out[index].StatKey = cloneString(out[index].StatKey)
+	}
+	return out
+}
+
+func finite(value float64) bool {
+	return !math.IsNaN(value) && !math.IsInf(value, 0)
+}
+
+func numericClose(left, right float64) bool {
+	tolerance := 1e-9 * math.Max(1, math.Max(math.Abs(left), math.Abs(right)))
+	return math.Abs(left-right) <= tolerance
+}
+
+func numericProducerKind(kind string) bool {
+	switch kind {
+	case StateEventSlotRegister, StateEventNumericStateRead, StateEventNumericEval,
+		StateEventMaxHPRead, StateEventHealthFieldBinding:
+		return true
+	default:
+		return false
+	}
+}
+
+func normalizeEvidence(complete bool, codes []string) (bool, []string) {
+	canonical := canonicalStrings(codes)
+	if complete && len(canonical) == 0 {
+		return true, canonical
+	}
+	if len(canonical) == 0 {
+		canonical = []string{"state_event_candidate_dependency_incomplete"}
+	}
+	return false, canonical
+}
