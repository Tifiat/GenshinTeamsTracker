+func TestV6TraceRuntimePathResolutionIsStructuralAndFailClosed(t *testing.T) {
+	root := writeMultiFileModule(t, map[string]string{
+		"trace_root.go": `package fixture
+import "example.test/fixture/pkg/gtttrace"
+type Direct struct { Trace *gtttrace.Runtime }
+type Holder struct { Runtime *gtttrace.Runtime }
+type Embedded struct { *Holder }
+type Missing struct { Value float64 }
+type Ambiguous struct { First *gtttrace.Runtime; Second *gtttrace.Runtime }
+`,
+	})
+	files, err := collectGoFiles(root, nil, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fset := token.NewFileSet()
+	parsed := make([]parsedSourceFile, 0, len(files))
+	for _, rel := range files {
+		data, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		file, err := parser.ParseFile(fset, rel, data, parser.SkipObjectResolution)
+		if err != nil {
+			t.Fatal(err)
+		}
+		parsed = append(parsed, parsedSourceFile{rel: rel, file: file})
+	}
+	index := buildTraceRuntimeIndex("example.test/fixture", parsed)
+	for receiver, want := range map[string]string{
+		"Direct":   "Trace",
+		"Embedded": "Holder.Runtime",
+	} {
+		got, reason := index.resolve(".", receiver)
+		if got != want || reason != "" {
+			t.Fatalf("%s trace path=(%q,%q), want=(%q,empty)", receiver, got, reason, want)
+		}
+	}
+	if got, reason := index.resolve(".", "Missing"); got != "" || reason != "trace_runtime_path_unresolved" {
