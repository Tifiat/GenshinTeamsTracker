+func v6InstrumentationEdits(
+	fset *token.FileSet,
+	tokenFile *token.File,
+	data []byte,
+	rel string,
+	file *ast.File,
+	wanted []SourceEntry,
+) ([]textEdit, bool, error) {
+	edits := make([]textEdit, 0, 64)
+	needsImport := false
+	entryByCall := make(map[string]SourceEntry)
+	stateByLine := make(map[int]SourceEntry)
+	resolvedTasks := make(map[string]SourceEntry)
+	ordinaryCalls := make(map[string]struct {
+		entry SourceEntry
+		plan  ordinaryHelperPlan
+	})
+	ordinaryBodies := make(map[string]struct {
+		entry SourceEntry
+		plan  ordinaryHelperPlan
+	})
+	eventCallbackUses := make(map[string]int)
+	taskCallbackUses := make(map[string]int)
+	for _, entry := range wanted {
+		if entry.RelativeFile == rel {
+			switch entry.Locator.Seam {
+			case KindTaskCallback, KindModifierAmount, KindEventCallback:
+				entryByCall[entry.Locator.Seam+"|"+strconv.Itoa(entry.Line)] = entry
+			case KindStateOperation:
+				stateByLine[entry.Line] = entry
+			}
+		}
+		if entry.Locator.Seam == KindTaskCallback && entry.callback != nil && entry.callback.ResolvedFile == rel && entry.callback.ResolvedMethodName != "" {
+			key := entry.callback.ResolvedMethodName + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+			resolvedTasks[key] = entry
+		}
+		if entry.Locator.Seam == KindTaskCallback && entry.callback != nil {
+			callbackKey := entry.callback.ResolvedFile + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+			taskCallbackUses[callbackKey]++
+		}
+		if entry.Locator.Seam == KindEventCallback && entry.callback != nil {
+			callbackKey := entry.callback.ResolvedFile + "|" + strconv.Itoa(entry.callback.ResolvedLine)
+			eventCallbackUses[callbackKey]++
+			for _, helper := range entry.callback.OrdinaryHelpers {
+				callKey := helper.CallFile + "|" + strconv.Itoa(helper.CallLine) + "|" + strconv.Itoa(helper.CallColumn)
+				ordinaryCalls[callKey] = struct {
+					entry SourceEntry
+					plan  ordinaryHelperPlan
+				}{entry: entry, plan: helper}
+				bodyKey := helper.ResolvedFile + "|" + helper.MethodName + "|" + strconv.Itoa(helper.ResolvedLine)
+				ordinaryBodies[bodyKey] = struct {
+					entry SourceEntry
+					plan  ordinaryHelperPlan
+				}{entry: entry, plan: helper}
+			}
+		}
+	}
