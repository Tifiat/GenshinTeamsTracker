+++ b/pkg/gttsourcegen/forwarded_attack_test.go
@@ -0,0 +1,122 @@
+package gttsourcegen
+
+import (
+	"go/parser"
+	"go/token"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestForwardedAttackCarriesGenericFormulaAndExplicitIdentity(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) queueAttack(ai info.AttackInfo) {
+	c.Core.QueueAttack(ai)
+}
+func (c *char) attack() {
+	count := c.consumeAllies()
+	damageMultiplier := 1 + 0.1*float64(count)
+	ai := info.AttackInfo{FlatDmg: ratio[0] * c.MaxHP() * damageMultiplier}
+	c.queueAttack(ai)
+}
+`)
+	manifest := generateFixture(t, root)
+	entry := findEntry(t, manifest, KindQueuedAttack, "(*char).attack")
+	if entry.Template.Status != TemplateSupported || entry.forwardedAttack == nil {
+		t.Fatalf("forwarded attack not supported: %#v", entry)
+	}
+	if entry.forwardedAttack.CallDepth != 1 || entry.forwardedAttack.ArgumentIndex != 0 || entry.forwardedAttack.ReadFrameExpression != "c.Core.F" {
+		t.Fatalf("forwarded plan mismatch: %#v", entry.forwardedAttack)
+	}
+	if len(entry.parameterPlans) != 3 {
+		t.Fatalf("parameter plans=%#v", entry.parameterPlans)
+	}
+	foundCandidateHP := false
+	foundFrozenRuntime := false
+	for _, parameter := range entry.parameterPlans {
+		if parameter.Kind == "candidate_stat" && parameter.StatKey == "max_hp" && parameter.ActorExpression == "c" {
+			foundCandidateHP = true
+		}
+		if parameter.Kind == "frozen_runtime_state" && parameter.SourceExpression == "damageMultiplier" && !parameter.CandidateDependencyComplete {
+			foundFrozenRuntime = true
+		}
+	}
+	if !foundCandidateHP || !foundFrozenRuntime {
+		t.Fatalf("forwarded parameter semantics missing: %#v", entry.parameterPlans)
+	}
+
+	overlay, err := BuildOverlay(OverlayOptions{
+		ModuleRoot: root, OverlayDir: filepath.Join(t.TempDir(), "overlay"),
+	}, manifest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(overlay.Files) != 1 {
+		t.Fatalf("overlay files=%d", len(overlay.Files))
+	}
+	rewritten := string(overlay.Files[0].Contents)
+	for _, wanted := range []string{
+		"GTTTraceSourceID:", "GTTTraceSourceTemplateSHA256:",
+		"float64(damageMultiplier)", `Kind: "candidate_stat"`,
+		`Kind: "frozen_runtime_state"`, `ReadFrame: c.Core.F`,
+	} {
+		if !strings.Contains(rewritten, wanted) {
+			t.Fatalf("forwarded overlay lacks %q:\n%s", wanted, rewritten)
+		}
+	}
+	if _, err := parser.ParseFile(token.NewFileSet(), "source.go", overlay.Files[0].Contents, 0); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestForwardedAttackDepthBudgetFailsClosed(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) sink(ai info.AttackInfo) { c.Core.QueueAttack(ai) }
+func (c *char) hop4(ai info.AttackInfo) { c.sink(ai) }
+func (c *char) hop3(ai info.AttackInfo) { c.hop4(ai) }
+func (c *char) hop2(ai info.AttackInfo) { c.hop3(ai) }
+func (c *char) hop1(ai info.AttackInfo) { c.hop2(ai) }
+func (c *char) hop0(ai info.AttackInfo) { c.hop1(ai) }
+func (c *char) allowed() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()}
+	c.hop1(ai)
+}
+func (c *char) overflow() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()}
+	c.hop0(ai)
+}
+func (c *char) cycleA(ai info.AttackInfo) { c.cycleB(ai) }
+func (c *char) cycleB(ai info.AttackInfo) { c.cycleA(ai) }
+func (c *char) cycleOrigin() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()}
+	c.cycleA(ai)
+}
+`)
+	manifest := generateFixture(t, root)
+	allowed := findEntry(t, manifest, KindQueuedAttack, "(*char).allowed")
+	if allowed.Template.Status != TemplateSupported || allowed.forwardedAttack == nil || allowed.forwardedAttack.CallDepth != 5 {
+		t.Fatalf("depth-five attack not accepted: %#v", allowed)
+	}
+	overflow := findEntry(t, manifest, KindQueuedAttack, "(*char).overflow")
+	if overflow.Template.Status != TemplateOpaqueFrozen || overflow.Template.StopReasonCode == nil || *overflow.Template.StopReasonCode != "forwarded_attack_depth_budget_exceeded" {
+		t.Fatalf("depth overflow did not fail closed: %#v", overflow.Template)
+	}
+	for _, entry := range manifest.Entries {
+		if entry.Locator.EnclosingSymbol == "(*char).cycleOrigin" && entry.Locator.Seam == KindQueuedAttack {
+			t.Fatalf("cycle unexpectedly produced a forwarded attack: %#v", entry)
+		}
+	}
+}
+
+func TestNumericExpressionDepthBudgetFailsClosed(t *testing.T) {
+	root := writeModule(t, `package fixture
+func (c *char) attack() {
+	ai := info.AttackInfo{FlatDmg: c.MaxHP()*2*2*2*2*2*2*2*2*2*2*2*2*2}
+	c.Core.QueueAttack(ai)
+}
+`)
+	entry := findEntry(t, generateFixture(t, root), KindQueuedAttack, "(*char).attack")
+	if entry.Template.Status != TemplateOpaqueFrozen || entry.Template.StopReasonCode == nil || *entry.Template.StopReasonCode != "numeric_expression_depth_budget_exceeded" {
+		t.Fatalf("numeric depth overflow did not fail closed: %#v", entry.Template)
+	}
+}
