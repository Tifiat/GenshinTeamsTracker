diff --git a/pkg/gttsourcegen/v6_numeric_types.go b/pkg/gttsourcegen/v6_numeric_types.go
new file mode 100644
index 0000000..0e68190
--- /dev/null
+++ b/pkg/gttsourcegen/v6_numeric_types.go
@@ -0,0 +1,419 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	pathpkg "path"
+	"sort"
+	"strings"
+)
+
+const maxScalarNumericFieldDepth = 8
+
+type scalarTypeKind uint8
+
+const (
+	scalarTypeUnresolved scalarTypeKind = iota
+	scalarTypeNumericBuiltin
+	scalarTypeNamed
+	scalarTypePointerNamed
+	scalarTypeNonScalar
+)
+
+type scalarTypeExpression struct {
+	kind   scalarTypeKind
+	target traceTypeRef
+}
+
+type scalarStructField struct {
+	selector string
+	typeExpr scalarTypeExpression
+	embedded bool
+}
+
+type scalarTypeDeclaration struct {
+	packagePath string
+	isStruct    bool
+	underlying  scalarTypeExpression
+	fields      []scalarStructField
+}
+
+// scalarNumericTypeIndex is a deliberately bounded syntax index. It proves
+// only scalar Go types that are directly convertible to float64. Missing type
+// declarations, ambiguous promotion, pointers and all composite types fail
+// closed instead of being emitted into a numeric trace overlay.
+type scalarNumericTypeIndex struct {
+	modulePath string
+	types      map[string]scalarTypeDeclaration
+}
+
+func buildScalarNumericTypeIndex(modulePath string, files []parsedSourceFile) scalarNumericTypeIndex {
+	index := scalarNumericTypeIndex{
+		modulePath: strings.TrimSuffix(strings.TrimSpace(modulePath), "/"),
+		types:      make(map[string]scalarTypeDeclaration),
+	}
+	for _, source := range files {
+		packagePath := index.packagePath(pathpkg.Dir(source.rel))
+		imports := sourceImportAliases(source.file)
+		for _, declaration := range source.file.Decls {
+			general, ok := declaration.(*ast.GenDecl)
+			if !ok {
+				continue
+			}
+			for _, spec := range general.Specs {
+				typeSpec, ok := spec.(*ast.TypeSpec)
+				if !ok {
+					continue
+				}
+				row := scalarTypeDeclaration{packagePath: packagePath}
+				if body, ok := typeSpec.Type.(*ast.StructType); ok {
+					row.isStruct = true
+					row.fields = make([]scalarStructField, 0, len(body.Fields.List))
+					for _, field := range body.Fields.List {
+						typeExpr := parseScalarTypeExpression(packagePath, imports, field.Type)
+						if len(field.Names) == 0 {
+							selector := embeddedFieldSelector(field.Type)
+							if selector != "" {
+								row.fields = append(row.fields, scalarStructField{
+									selector: selector,
+									typeExpr: typeExpr,
+									embedded: true,
+								})
+							}
+							continue
+						}
+						for _, name := range field.Names {
+							row.fields = append(row.fields, scalarStructField{
+								selector: name.Name,
+								typeExpr: typeExpr,
+							})
+						}
+					}
+					sort.Slice(row.fields, func(left, right int) bool {
+						if row.fields[left].selector != row.fields[right].selector {
+							return row.fields[left].selector < row.fields[right].selector
+						}
+						return row.fields[left].typeExpr.target.key() < row.fields[right].typeExpr.target.key()
+					})
+				} else {
+					row.underlying = parseScalarTypeExpression(packagePath, imports, typeSpec.Type)
+				}
+				ref := traceTypeRef{packagePath: packagePath, name: typeSpec.Name.Name}
+				index.types[ref.key()] = row
+			}
+		}
+	}
+	return index
+}
+
+func (i scalarNumericTypeIndex) packagePath(packageDir string) string {
+	if packageDir == "." || packageDir == "" {
+		return i.modulePath
+	}
+	return i.modulePath + "/" + strings.TrimPrefix(packageDir, "./")
+}
+
+func (i scalarNumericTypeIndex) filterReceiverFields(
+	packageDir, receiverType string,
+	fields map[string]struct{},
+) map[string]struct{} {
+	result := make(map[string]struct{}, len(fields))
+	for field := range fields {
+		if i.receiverFieldReason(packageDir, receiverType, field) == "" {
+			result[field] = struct{}{}
+		}
+	}
+	return result
+}
+
+func (i scalarNumericTypeIndex) validateReceiverFields(
+	packageDir, receiverType string,
+	fields map[string]struct{},
+) string {
+	ordered := sortedFieldSet(fields)
+	for _, field := range ordered {
+		if reason := i.receiverFieldReason(packageDir, receiverType, field); reason != "" {
+			return reason
+		}
+	}
+	return ""
+}
+
+func (i scalarNumericTypeIndex) receiverFieldReason(packageDir, receiverType, field string) string {
+	receiverName := receiverBaseTypeName(receiverType)
+	if receiverName == "" || strings.TrimSpace(field) == "" {
+		return "receiver_field_type_unresolved"
+	}
+	root := traceTypeRef{packagePath: i.packagePath(packageDir), name: receiverName}
+	expression, reason := i.resolveFieldExpression(root, field)
+	if reason != "" {
+		return reason
+	}
+	numeric, resolved := i.isScalarNumeric(expression, make(map[string]bool))
+	if !resolved {
+		return "receiver_field_type_unresolved"
+	}
+	if !numeric {
+		return "receiver_field_type_not_scalar_numeric"
+	}
+	return ""
+}
+
+func (i scalarNumericTypeIndex) methodParameterProof(method receiverMethod) ([]string, []int) {
+	if method.decl == nil || method.decl.Type.Params == nil {
+		return []string{}, []int{}
+	}
+	names := make([]string, 0, len(method.decl.Type.Params.List))
+	numeric := make([]int, 0, len(method.decl.Type.Params.List))
+	for _, field := range method.decl.Type.Params.List {
+		count := len(field.Names)
+		if count == 0 {
+			count = 1
+		}
+		expression := parseScalarTypeExpression(i.packagePath(method.packageDir), method.imports, field.Type)
+		isNumeric, resolved := i.isScalarNumeric(expression, make(map[string]bool))
+		for offset := 0; offset < count; offset++ {
+			name := ""
+			if len(field.Names) > 0 {
+				name = field.Names[offset].Name
+			}
+			index := len(names)
+			names = append(names, name)
+			if resolved && isNumeric {
+				numeric = append(numeric, index)
+			}
+		}
+	}
+	return names, numeric
+}
+
+type scalarFieldSearchNode struct {
+	ref      traceTypeRef
+	visiting map[string]bool
+}
+
+func (i scalarNumericTypeIndex) resolveFieldExpression(root traceTypeRef, fieldName string) (scalarTypeExpression, string) {
+	level := []scalarFieldSearchNode{{ref: root, visiting: map[string]bool{root.key(): true}}}
+	for depth := 0; depth <= maxScalarNumericFieldDepth && len(level) > 0; depth++ {
+		matches := make([]scalarTypeExpression, 0, 2)
+		next := make([]scalarFieldSearchNode, 0, len(level)*2)
+		for _, node := range level {
+			structRef, declaration, ok := i.resolveStruct(node.ref, make(map[string]bool))
+			if !ok {
+				continue
+			}
+			for _, candidate := range declaration.fields {
+				if declaration.packagePath != root.packagePath && !ast.IsExported(candidate.selector) {
+					continue
+				}
+				if candidate.selector == fieldName {
+					matches = append(matches, candidate.typeExpr)
+				}
+			}
+			if len(matches) > 0 || depth == maxScalarNumericFieldDepth {
+				continue
+			}
+			for _, embedded := range declaration.fields {
+				if !embedded.embedded {
+					continue
+				}
+				if declaration.packagePath != root.packagePath && !ast.IsExported(embedded.selector) {
+					continue
+				}
+				target, ok := embeddedStructTarget(embedded.typeExpr)
+				if !ok || node.visiting[target.key()] {
+					continue
+				}
+				visiting := make(map[string]bool, len(node.visiting)+1)
+				for key, value := range node.visiting {
+					visiting[key] = value
+				}
+				visiting[structRef.key()] = true
+				visiting[target.key()] = true
+				next = append(next, scalarFieldSearchNode{ref: target, visiting: visiting})
+			}
+		}
+		if len(matches) == 1 {
+			return matches[0], ""
+		}
+		if len(matches) > 1 {
+			return scalarTypeExpression{}, "receiver_field_selection_ambiguous"
+		}
+		level = next
+	}
+	return scalarTypeExpression{}, "receiver_field_type_unresolved"
+}
+
+func (i scalarNumericTypeIndex) resolveStruct(
+	ref traceTypeRef,
+	visiting map[string]bool,
+) (traceTypeRef, scalarTypeDeclaration, bool) {
+	if ref.name == "" || visiting[ref.key()] {
+		return traceTypeRef{}, scalarTypeDeclaration{}, false
+	}
+	visiting[ref.key()] = true
+	declaration, ok := i.types[ref.key()]
+	if !ok {
+		return traceTypeRef{}, scalarTypeDeclaration{}, false
+	}
+	if declaration.isStruct {
+		return ref, declaration, true
+	}
+	if declaration.underlying.kind != scalarTypeNamed {
+		return traceTypeRef{}, scalarTypeDeclaration{}, false
+	}
+	return i.resolveStruct(declaration.underlying.target, visiting)
+}
+
+func (i scalarNumericTypeIndex) isScalarNumeric(
+	expression scalarTypeExpression,
+	visiting map[string]bool,
+) (numeric bool, resolved bool) {
+	switch expression.kind {
+	case scalarTypeNumericBuiltin:
+		return true, true
+	case scalarTypeNonScalar, scalarTypePointerNamed:
+		return false, true
+	case scalarTypeUnresolved:
+		return false, false
+	case scalarTypeNamed:
+		if visiting[expression.target.key()] {
+			return false, false
+		}
+		declaration, ok := i.types[expression.target.key()]
+		if !ok {
+			return false, false
+		}
+		if declaration.isStruct {
+			return false, true
+		}
+		visiting[expression.target.key()] = true
+		defer delete(visiting, expression.target.key())
+		return i.isScalarNumeric(declaration.underlying, visiting)
+	default:
+		return false, false
+	}
+}
+
+func parseScalarTypeExpression(
+	packagePath string,
+	imports map[string]string,
+	expression ast.Expr,
+) scalarTypeExpression {
+	switch value := expression.(type) {
+	case *ast.ParenExpr:
+		return parseScalarTypeExpression(packagePath, imports, value.X)
+	case *ast.StarExpr:
+		inner := parseScalarTypeExpression(packagePath, imports, value.X)
+		if inner.kind == scalarTypeNamed {
+			return scalarTypeExpression{kind: scalarTypePointerNamed, target: inner.target}
+		}
+		if inner.kind == scalarTypeUnresolved {
+			return inner
+		}
+		return scalarTypeExpression{kind: scalarTypeNonScalar}
+	case *ast.IndexExpr:
+		return parseScalarTypeExpression(packagePath, imports, value.X)
+	case *ast.IndexListExpr:
+		return parseScalarTypeExpression(packagePath, imports, value.X)
+	case *ast.Ident:
+		if scalarNumericBuiltin(value.Name) {
+			return scalarTypeExpression{kind: scalarTypeNumericBuiltin}
+		}
+		if scalarNonNumericBuiltin(value.Name) {
+			return scalarTypeExpression{kind: scalarTypeNonScalar}
+		}
+		return scalarTypeExpression{
+			kind:   scalarTypeNamed,
+			target: traceTypeRef{packagePath: packagePath, name: value.Name},
+		}
+	case *ast.SelectorExpr:
+		alias, ok := value.X.(*ast.Ident)
+		if !ok {
+			return scalarTypeExpression{kind: scalarTypeUnresolved}
+		}
+		importPath, ok := imports[alias.Name]
+		if !ok {
+			return scalarTypeExpression{kind: scalarTypeUnresolved}
+		}
+		return scalarTypeExpression{
+			kind:   scalarTypeNamed,
+			target: traceTypeRef{packagePath: importPath, name: value.Sel.Name},
+		}
+	default:
+		return scalarTypeExpression{kind: scalarTypeNonScalar}
+	}
+}
+
+func embeddedStructTarget(expression scalarTypeExpression) (traceTypeRef, bool) {
+	if expression.kind != scalarTypeNamed && expression.kind != scalarTypePointerNamed {
+		return traceTypeRef{}, false
+	}
+	return expression.target, expression.target.name != ""
+}
+
+func embeddedFieldSelector(expression ast.Expr) string {
+	switch value := expression.(type) {
+	case *ast.ParenExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.StarExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.IndexExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.IndexListExpr:
+		return embeddedFieldSelector(value.X)
+	case *ast.Ident:
+		return value.Name
+	case *ast.SelectorExpr:
+		return value.Sel.Name
+	default:
+		return ""
+	}
+}
+
+func receiverBaseTypeName(receiverType string) string {
+	expression, err := parser.ParseExpr(strings.TrimSpace(receiverType))
+	if err != nil {
+		return ""
+	}
+	for {
+		switch value := expression.(type) {
+		case *ast.ParenExpr:
+			expression = value.X
+		case *ast.StarExpr:
+			expression = value.X
+		case *ast.IndexExpr:
+			expression = value.X
+		case *ast.IndexListExpr:
+			expression = value.X
+		case *ast.Ident:
+			return value.Name
+		default:
+			return ""
+		}
+	}
+}
+
+func scalarNumericBuiltin(name string) bool {
+	switch name {
+	case "byte", "float32", "float64", "int", "int8", "int16", "int32", "int64",
+		"rune", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr":
+		return true
+	default:
+		return false
+	}
+}
+
+func numericBuiltinType(expression ast.Expr) bool {
+	ident, ok := expression.(*ast.Ident)
+	return ok && scalarNumericBuiltin(ident.Name)
+}
+
+func scalarNonNumericBuiltin(name string) bool {
+	switch name {
+	case "any", "bool", "complex64", "complex128", "error", "string":
+		return true
+	default:
+		return false
+	}
+}
