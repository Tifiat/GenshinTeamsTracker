+func numericFormalParameterNames(fn *ast.FuncDecl, numericPositions []int) map[string]int {
+	result := make(map[string]int, len(numericPositions))
+	if fn == nil || fn.Type.Params == nil {
+		return result
+	}
+	allowlist := integerAllowlist(numericPositions)
+	index := 0
+	for _, field := range fn.Type.Params.List {
+		for _, name := range field.Names {
+			if _, numeric := allowlist[index]; numeric {
+				result[name.Name] = index
+			}
+			index++
+		}
+	}
+	return result
+}
