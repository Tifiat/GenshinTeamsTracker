+type numericTraceLeaf struct {
+	valueExpr     string
+	referenceExpr string
+}
+
+func numericAssignmentOperator(operator token.Token) (string, bool) {
+	value, ok := map[token.Token]string{
+		token.ADD_ASSIGN: "add",
+		token.SUB_ASSIGN: "subtract",
+		token.MUL_ASSIGN: "multiply",
+		token.QUO_ASSIGN: "divide",
+	}[operator]
+	return value, ok
+}
+
+func numericTraceTemplateEvents(
+	compiled templateCompilation,
+	leaves map[string]numericTraceLeaf,
+	traceExpr, sourceExpr, prefix, indent string,
+) (string, numericTraceLeaf, error) {
+	if compiled.template.Status != TemplateSupported || compiled.template.RootNodeID == nil {
+		return "", numericTraceLeaf{}, fmt.Errorf("numeric trace expression is opaque")
+	}
+	parameterByKey := make(map[string]parameterPlan, len(compiled.parameters))
+	for _, parameter := range compiled.parameters {
+		parameterByKey[parameter.ParameterKey] = parameter
+	}
+	nodes := make([]numericTraceLeaf, len(compiled.template.Nodes))
+	var out strings.Builder
+	for _, node := range compiled.template.Nodes {
+		switch node.Operator {
+		case "PARAM":
+			if node.ParameterKey == nil {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace PARAM has nil key")
+			}
+			parameter, exists := parameterByKey[*node.ParameterKey]
+			if !exists {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace PARAM plan is missing")
+			}
+			leaf, exists := leaves[parameter.SourceExpression]
+			if !exists || leaf.valueExpr == "" || leaf.referenceExpr == "" {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace leaf %s is unbound", parameter.SourceExpression)
+			}
+			nodes[node.NodeID] = leaf
+		case "CONST":
+			if node.ConstantValue == nil {
+				return "", numericTraceLeaf{}, fmt.Errorf("numeric trace CONST has nil value")
+			}
+			value := strconv.FormatFloat(*node.ConstantValue, 'g', -1, 64)
+			nodes[node.NodeID] = numericTraceLeaf{
+				valueExpr:     value,
+				referenceExpr: traceImportAlias + ".LiteralRef(" + value + ")",
+			}
+		default:
+			children := make([]numericTraceLeaf, len(node.InputNodeIDs))
+			for index, childID := range node.InputNodeIDs {
+				if childID < 0 || childID >= node.NodeID || nodes[childID].valueExpr == "" {
+					return "", numericTraceLeaf{}, fmt.Errorf("numeric trace child is invalid")
+				}
+				children[index] = nodes[childID]
+			}
+			operation, expression, err := numericTraceOperation(node.Operator, children)
+			if err != nil {
+				return "", numericTraceLeaf{}, err
+			}
+			valueName := "gttV6_" + prefix + "_node_" + strconv.Itoa(node.NodeID)
+			eventName := valueName + "_event"
+			refs := make([]string, len(children))
+			for index, child := range children {
+				refs[index] = child.referenceExpr
+			}
+			fmt.Fprintf(&out, "%s := %s\n%s", valueName, expression, indent)
+			fmt.Fprintf(&out, "%s := %s.RecordNumericEval(%s,%s,[]%s.NumericRef{%s},float64(%s),%s.IncompleteEvidence(%s))\n%s",
+				eventName, traceExpr, sourceExpr, strconv.Quote(operation), traceImportAlias,
+				strings.Join(refs, ","), valueName, traceImportAlias,
+				strconv.Quote("numeric_expression_candidate_dependency_incomplete"), indent)
+			nodes[node.NodeID] = numericTraceLeaf{
+				valueExpr:     valueName,
+				referenceExpr: traceImportAlias + ".EventRef(" + eventName + ")",
+			}
+		}
+	}
+	root := *compiled.template.RootNodeID
+	if root < 0 || root >= len(nodes) || nodes[root].valueExpr == "" {
+		return "", numericTraceLeaf{}, fmt.Errorf("numeric trace root is invalid")
+	}
+	return out.String(), nodes[root], nil
+}
+
+func numericTraceOperation(
+	operator string,
+	children []numericTraceLeaf,
+) (string, string, error) {
+	if len(children) != 2 {
+		return "", "", fmt.Errorf("numeric trace operator %s has unsupported arity", operator)
+	}
+	left, right := children[0].valueExpr, children[1].valueExpr
+	switch operator {
+	case "ADD":
+		return "add", "(" + left + " + " + right + ")", nil
+	case "SUB":
+		return "subtract", "(" + left + " - " + right + ")", nil
+	case "MUL":
+		return "multiply", "(" + left + " * " + right + ")", nil
+	case "DIV":
+		return "divide", "(" + left + " / " + right + ")", nil
+	case "MIN":
+		return "min", "min(" + left + "," + right + ")", nil
+	case "MAX":
+		return "max", "max(" + left + "," + right + ")", nil
+	default:
+		return "", "", fmt.Errorf("numeric trace operator %s is unsupported", operator)
+	}
+}
