+func CompactSliceTemplate(sourceID string) (CompactTemplate, bool) {
+	if !ValidID(sourceID) {
+		return CompactTemplate{}, false
+	}
+	value, ok := generatedCompactTemplateBySourceID[sourceID]
+	if !ok || value.TemplateSHA256 == "" {
+		return CompactTemplate{}, false
+	}
+	return cloneCompactTemplate(value), true
+}
+
+func cloneCompactTemplate(value CompactTemplate) CompactTemplate {
+	value.Nodes = append([]CompactTemplateNode(nil), value.Nodes...)
+	for index := range value.Nodes {
+		value.Nodes[index].InputNodeIDs = append([]int(nil), value.Nodes[index].InputNodeIDs...)
+		if value.Nodes[index].ConstantValue != nil {
+			cloned := *value.Nodes[index].ConstantValue
+			value.Nodes[index].ConstantValue = &cloned
+		}
+		if value.Nodes[index].ParameterKey != nil {
+			cloned := *value.Nodes[index].ParameterKey
+			value.Nodes[index].ParameterKey = &cloned
+		}
+	}
+	value.ParameterKeys = append([]string(nil), value.ParameterKeys...)
+	if value.RootNodeID != nil {
+		cloned := *value.RootNodeID
+		value.RootNodeID = &cloned
+	}
+	if value.StopReasonCode != nil {
+		cloned := *value.StopReasonCode
+		value.StopReasonCode = &cloned
+	}
+	return value
+}
