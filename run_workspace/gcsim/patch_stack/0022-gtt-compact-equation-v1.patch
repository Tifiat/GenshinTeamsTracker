+package gttcompact
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+func TestCompileSyntheticDirectReactionSupportAndOpaque(t *testing.T) {
+	maxHPEventID := "state-event:0"
+	modifierEventID := "state-event:1"
+	buffer := optstats.GTTTraceEquationBuffer{
+		Seed: 101, DurationFrames: 120,
+		Hits: []info.GTTTraceHit{
+			{
+				HitID: 1, ActorIndex: 1, FormulaKind: info.GTTTraceFormulaStandard,
+				AttackTag: 1, Element: "hydro", Mult: 1, ScalingStatKind: "atk", ScalingStatValue: 100,
+				SnapshotStats: map[string]float64{"base_atk": 100, "atk": 100, "cr": 0, "cd": 0},
+				DamageBonus:   1000, DefMod: 1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+				AttackMods: []info.GTTTraceAttackModAttempt{{Accepted: true, ModifierEvalEventID: modifierEventID, Delta: map[string]float64{"dmg%": 1000}}},
+			},
+			{
+				HitID: 2, ActorIndex: 1, FormulaKind: info.GTTTraceFormulaStandard,
+				AttackTag: 2, Element: "dendro", SnapshotStats: map[string]float64{},
+				DefMod: 1, ResMod: 1, DamageGroupMultiplier: 1, ElevationMultiplier: 1,
+				ReactionFormula: &info.GTTTraceReactionFormula{
+					FormulaID: info.GTTTraceTransformativeFormulaID, FormulaSHA256: info.GTTTraceTransformativeFormulaSHA256,
+					OwnerIndex: 1, LevelBase: 100, EMCurveNumerator: 1, EMCurveDenominatorOffset: 1000, Coefficient: 1,
+				},
+			},
+		},
+		StateEvents: []gtttrace.StateEvent{
+			{
+				SequenceIndex: 0, EventID: maxHPEventID, Kind: gtttrace.StateEventMaxHPRead,
+				Provider:                    gtttrace.Provider{Known: true, Kind: "character", Key: "bennett", OwnerIndex: 0},
+				Output:                      map[string]float64{"base_hp": 1000, "hp%": 0, "hp": 0, "max_hp": 1000},
+				CandidateDependencyComplete: true, UncertaintyCodes: []string{},
+			},
+			{
+				SequenceIndex: 1, EventID: modifierEventID, Kind: gtttrace.StateEventModifierEval,
+				Provider: gtttrace.Provider{Known: true, Kind: "character", Key: "support", OwnerIndex: 0},
+				Inputs:   []gtttrace.NumericRef{gtttrace.EventOutputRef(maxHPEventID, "max_hp")},
+				Output:   map[string]float64{"dmg%": 1000}, CandidateDependencyComplete: false,
+				UncertaintyCodes: []string{"synthetic_modifier_uncertain"},
+			},
+		},
+		StateSlots: []gtttrace.StateSlot{}, HealthOperations: []gtttrace.HealthOperation{},
+		SourceOccurrences: []gtttrace.SourceOccurrence{}, SourceValueBindings: []gtttrace.SourceValueBinding{},
+		Unsupported: []string{}, TopologyEvents: []optstats.GTTTraceTopologyEvent{},
+	}
+	member, audit, err := CompileSeedMember(buffer, []string{"bennett", "actor_a"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if audit.ChannelCount != 2 || audit.OpaqueReasonCount != 1 || len(member.OpaqueBoundaries) != 1 {
+		t.Fatalf("audit = %#v", audit)
+	}
+	if audit.BaselineDamage != 100200 {
+		t.Fatalf("baseline = %v, want 100200", audit.BaselineDamage)
+	}
+	foundSupport := false
+	for _, coordinate := range member.Channels[0].ResponseCoordinates {
+		if coordinate == "bennett.hp_percent" {
+			foundSupport = true
+		}
+	}
+	if !foundSupport {
+		t.Fatal("direct channel lost support HP coordinate")
+	}
+	if member.Channels[1].Kind != "reaction" {
+		t.Fatalf("reaction kind = %q", member.Channels[1].Kind)
+	}
+}
diff --git a/pkg/gttcompact/direct.go b/pkg/gttcompact/direct.go
new file mode 100644
index 0000000..8841a3a
--- /dev/null
+++ b/pkg/gttcompact/direct.go
@@ -0,0 +1,346 @@
+package gttcompact
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+type directCompiler struct {
+	b             *nodeBuilder
+	buffer        optstats.GTTTraceEquationBuffer
+	characterKeys []string
+	support       supportProgram
+	unknown       map[string]struct{}
+	occurrence    map[string]gtttrace.SourceOccurrence
+	flatBinding   map[string]gtttrace.SourceValueBinding
+}
+
+func compileChannels(b *nodeBuilder, buffer optstats.GTTTraceEquationBuffer, characterKeys []string, support supportProgram) ([]IRChannel, map[string]struct{}, float64) {
+	c := &directCompiler{
+		b: b, buffer: buffer, characterKeys: characterKeys, support: support,
+		unknown: make(map[string]struct{}), occurrence: make(map[string]gtttrace.SourceOccurrence),
+		flatBinding: make(map[string]gtttrace.SourceValueBinding),
+	}
+	for reason := range support.unknown {
+		c.unknown[reason] = struct{}{}
+	}
+	for _, reason := range buffer.Unsupported {
+		c.unknown[reason] = struct{}{}
+	}
+	for _, occurrence := range buffer.SourceOccurrences {
+		c.occurrence[occurrence.OccurrenceID] = occurrence
+	}
+	for _, binding := range buffer.SourceValueBindings {
+		if binding.OutputKind == "terminal_flat_dmg" && binding.TerminalEventID != nil {
+			c.flatBinding[*binding.TerminalEventID] = binding
+		}
+	}
+	channels := make([]IRChannel, 0, len(buffer.Hits))
+	total := 0.0
+	for index, hit := range buffer.Hits {
+		for _, reason := range hit.Unsupported {
+			c.unknown[reason] = struct{}{}
+		}
+		actor := "unknown_actor"
+		if hit.ActorIndex >= 0 && hit.ActorIndex < len(characterKeys) {
+			actor = characterKeys[hit.ActorIndex]
+		}
+		root, kind := c.compileHit(hit, actor)
+		total += root.baseline
+		channels = append(channels, IRChannel{
+			ChannelID: fmt.Sprintf("hit/%06d", index+1), Kind: kind, ActorKey: actor,
+			AttackTag: "tag/" + strconv.Itoa(hit.AttackTag), DamageType: normalizeToken(hit.Element, "unknown_damage"),
+			RootNodeID: root.id, HitCount: 1, BaselineDamage: decimal(root.baseline),
+			ResponseCoordinates: sortedCoords(root.coords),
+		})
+	}
+	return channels, c.unknown, total
+}
+
+func (c *directCompiler) compileHit(hit info.GTTTraceHit, actor string) (compiledNode, string) {
+	if hit.FormulaKind == info.GTTTraceFormulaOpaqueCustom {
+		c.unknown["terminal_formula_not_instrumented"] = struct{}{}
+		return c.b.constant(expectedFallbackDamage(hit)), "direct"
+	}
+	if hit.ReactionFormula != nil {
+		return c.compileTransformative(hit, actor), "reaction"
+	}
+	dynamic := c.dynamicStatDeltas(hit)
+	stat := func(key string) compiledNode {
+		observed := hit.SnapshotStats[key]
+		values := []compiledNode{c.b.constant(observed)}
+		if artifactVariableStat(key) {
+			values = append(values, c.b.artifactDelta(actor, key))
+		}
+		if value, ok := dynamic[key]; ok {
+			values = append(values, value)
+		}
+		return c.b.add(values...)
+	}
+	scaling := c.b.constant(hit.ScalingStatValue)
+	switch hit.ScalingStatKind {
+	case "atk":
+		scaling = c.scalingStat(hit.ScalingStatValue, hit.SnapshotStats["base_atk"], actor, "atk%", "atk", dynamic)
+	case "hp":
+		scaling = c.scalingStat(hit.ScalingStatValue, hit.SnapshotStats["base_hp"], actor, "hp%", "hp", dynamic)
+	case "def":
+		scaling = c.scalingStat(hit.ScalingStatValue, hit.SnapshotStats["base_def"], actor, "def%", "def", dynamic)
+	case "em":
+		scaling = stat("em")
+	}
+	flat := c.compileFlatDamage(hit, actor, dynamic)
+	base := c.b.add(
+		c.b.multiply(c.b.constant(hit.Mult*(1+hit.BaseDmgBonus)), scaling),
+		flat,
+	)
+	bonusValues := []compiledNode{c.b.constant(1 + hit.DamageBonus), c.b.artifactDelta(actor, "dmg%")}
+	if hit.Element != "" && hit.Element != "none" && hit.Element != "n/a" {
+		bonusValues = append(bonusValues, c.b.artifactDelta(actor, hit.Element+"%"))
+	}
+	for _, key := range []string{"dmg%", hit.Element + "%"} {
+		if value, ok := dynamic[key]; ok {
+			bonusValues = append(bonusValues, value)
+		}
+	}
+	bonus := c.b.add(bonusValues...)
+	cr := c.b.add(c.b.constant(hit.RawCritRate), c.b.artifactDelta(actor, "cr"))
+	if value, ok := dynamic["cr"]; ok {
+		cr = c.b.add(cr, value)
+	}
+	cd := c.b.add(c.b.constant(hit.CritDamage), c.b.artifactDelta(actor, "cd"))
+	if value, ok := dynamic["cd"]; ok {
+		cd = c.b.add(cd, value)
+	}
+	crit := c.b.add(c.b.constant(1), c.b.multiply(c.b.min(c.b.constant(1), c.b.max(c.b.constant(0), cr)), cd))
+	if hit.HitWeakPoint {
+		crit = c.b.add(c.b.constant(1), cd)
+	}
+	root := c.b.multiply(base, bonus, c.b.constant(hit.DefMod), c.b.constant(hit.ResMod), crit)
+	if hit.Amped {
+		em := stat("em")
+		curve := c.b.add(c.b.constant(1+hit.ReactionBonus), c.b.divide(c.b.multiply(c.b.constant(2.78), em), c.b.add(c.b.constant(1400), em)))
+		root = c.b.multiply(root, c.b.constant(hit.AmpMult), curve)
+	}
+	root = c.b.multiply(root, c.b.constant(hit.DamageGroupMultiplier), c.b.constant(hit.ElevationMultiplier))
+	return root, "direct"
+}
+
+func (c *directCompiler) scalingStat(observed, base float64, actor, percentKey, flatKey string, dynamic map[string]compiledNode) compiledNode {
+	values := []compiledNode{
+		c.b.constant(observed),
+		c.b.multiply(c.b.constant(base), c.b.artifactDelta(actor, percentKey)),
+		c.b.artifactDelta(actor, flatKey),
+	}
+	if value, ok := dynamic[percentKey]; ok {
+		values = append(values, c.b.multiply(c.b.constant(base), value))
+	}
+	if value, ok := dynamic[flatKey]; ok {
+		values = append(values, value)
+	}
+	return c.b.add(values...)
+}
+
+func (c *directCompiler) compileTransformative(hit info.GTTTraceHit, fallbackActor string) compiledNode {
+	formula := hit.ReactionFormula
+	actor := fallbackActor
+	if formula.OwnerIndex >= 0 && formula.OwnerIndex < len(c.characterKeys) {
+		actor = c.characterKeys[formula.OwnerIndex]
+	}
+	em := c.b.add(c.b.constant(formula.ElementalMastery), c.b.artifactDelta(actor, "em"))
+	core := c.b.multiply(c.b.constant(formula.LevelBase), c.b.add(
+		c.b.constant(1+formula.ReactionBonus),
+		c.b.divide(c.b.multiply(c.b.constant(formula.EMCurveNumerator), em), c.b.add(c.b.constant(formula.EMCurveDenominatorOffset), em)),
+	))
+	cr := c.b.add(c.b.constant(hit.RawCritRate), c.b.artifactDelta(actor, "cr"))
+	cd := c.b.add(c.b.constant(hit.CritDamage), c.b.artifactDelta(actor, "cd"))
+	crit := c.b.add(c.b.constant(1), c.b.multiply(c.b.min(c.b.constant(1), c.b.max(c.b.constant(0), cr)), cd))
+	if hit.HitWeakPoint {
+		crit = c.b.add(c.b.constant(1), cd)
+	}
+	return c.b.multiply(
+		c.b.constant(formula.Coefficient), core,
+		c.b.add(c.b.constant(1+hit.DamageBonus), c.b.artifactDelta(actor, "dmg%")),
+		c.b.constant(hit.DefMod), c.b.constant(hit.ResMod), crit,
+		c.b.constant(hit.DamageGroupMultiplier), c.b.constant(hit.ElevationMultiplier),
+	)
+}
+
+func (c *directCompiler) dynamicStatDeltas(hit info.GTTTraceHit) map[string]compiledNode {
+	parts := make(map[string][]compiledNode)
+	add := func(eventID string, baseline map[string]float64) {
+		if eventID == "" {
+			return
+		}
+		outputs := c.support.eventOutputs[eventID]
+		for key, observed := range baseline {
+			candidate, ok := outputs[key]
+			if !ok {
+				continue
+			}
+			parts[key] = append(parts[key], c.b.subtract(candidate, c.b.constant(observed)))
+		}
+	}
+	for _, contribution := range hit.StatContributions {
+		add(contribution.ModifierEvalEventID, contribution.Values)
+	}
+	for _, contribution := range hit.AttackMods {
+		add(contribution.ModifierEvalEventID, contribution.Delta)
+	}
+	out := make(map[string]compiledNode, len(parts))
+	for key, values := range parts {
+		out[key] = c.b.add(values...)
+	}
+	return out
+}
+
+func (c *directCompiler) compileFlatDamage(hit info.GTTTraceHit, actor string, dynamic map[string]compiledNode) compiledNode {
+	if hit.FlatDmg == 0 {
+		return c.b.constant(0)
+	}
+	binding, ok := c.flatBinding["hit:"+strconv.FormatUint(hit.HitID, 10)]
+	if !ok {
+		c.unknown["flat_damage_source_binding_missing"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	occurrence, ok := c.occurrence[binding.OccurrenceID]
+	if !ok {
+		c.unknown["flat_damage_source_occurrence_missing"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	template, ok := gttsource.CompactSliceTemplate(occurrence.SourceID)
+	if !ok || template.Status != "SUPPORTED" || template.TemplateSHA256 != binding.TemplateSHA256 || template.RootNodeID == nil {
+		c.unknown["flat_damage_source_template_unavailable"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	parameters := make(map[string]compiledNode, len(binding.Parameters))
+	for _, parameter := range binding.Parameters {
+		node := c.b.constant(parameter.ObservedValue)
+		if parameter.Kind == "candidate_stat" && parameter.ActorKey != nil && parameter.StatKey != nil {
+			parameterActor, key := *parameter.ActorKey, *parameter.StatKey
+			if key == "max_hp" {
+				baseHP := hit.SnapshotStats["base_hp"]
+				values := []compiledNode{c.b.constant(parameter.ObservedValue), c.b.multiply(c.b.constant(baseHP), c.b.artifactDelta(parameterActor, "hp%")), c.b.artifactDelta(parameterActor, "hp")}
+				if parameterActor == actor {
+					if value, exists := dynamic["hp%"]; exists {
+						values = append(values, c.b.multiply(c.b.constant(baseHP), value))
+					}
+					if value, exists := dynamic["hp"]; exists {
+						values = append(values, value)
+					}
+				}
+				node = c.b.add(values...)
+			} else {
+				node = c.b.add(node, c.b.artifactDelta(parameterActor, key))
+			}
+		}
+		parameters[parameter.ParameterKey] = node
+	}
+	nodes := make(map[int]compiledNode, len(template.Nodes))
+	for _, row := range template.Nodes {
+		var node compiledNode
+		switch row.Operator {
+		case "CONST":
+			if row.ConstantValue == nil {
+				c.unknown["flat_template_constant_missing"] = struct{}{}
+				return c.b.constant(hit.FlatDmg)
+			}
+			node = c.b.constant(*row.ConstantValue)
+		case "PARAM":
+			if row.ParameterKey == nil {
+				c.unknown["flat_template_parameter_missing"] = struct{}{}
+				return c.b.constant(hit.FlatDmg)
+			}
+			node, ok = parameters[*row.ParameterKey]
+			if !ok {
+				c.unknown["flat_template_parameter_unbound"] = struct{}{}
+				return c.b.constant(hit.FlatDmg)
+			}
+		default:
+			inputs := make([]compiledNode, 0, len(row.InputNodeIDs))
+			for _, id := range row.InputNodeIDs {
+				input, exists := nodes[id]
+				if !exists {
+					c.unknown["flat_template_order_invalid"] = struct{}{}
+					return c.b.constant(hit.FlatDmg)
+				}
+				inputs = append(inputs, input)
+			}
+			switch row.Operator {
+			case "ADD":
+				node = c.b.add(inputs...)
+			case "SUB":
+				if len(inputs) != 2 {
+					return c.freezeFlat(inputs, hit.FlatDmg)
+				}
+				node = c.b.subtract(inputs[0], inputs[1])
+			case "MUL":
+				node = c.b.multiply(inputs...)
+			case "DIV":
+				if len(inputs) != 2 || inputs[1].baseline == 0 {
+					return c.freezeFlat(inputs, hit.FlatDmg)
+				}
+				node = c.b.divide(inputs[0], inputs[1])
+			case "MIN":
+				node = c.b.min(inputs...)
+			case "MAX":
+				node = c.b.max(inputs...)
+			default:
+				return c.freezeFlat(inputs, hit.FlatDmg)
+			}
+		}
+		nodes[row.NodeID] = node
+	}
+	root, ok := nodes[*template.RootNodeID]
+	if !ok || !closeEnough(root.baseline, binding.ObservedValue) {
+		c.unknown["flat_template_baseline_mismatch"] = struct{}{}
+		return c.b.constant(hit.FlatDmg)
+	}
+	return root
+}
+
+func (c *directCompiler) freezeFlat(inputs []compiledNode, observed float64) compiledNode {
+	if hasCoordinates(inputs) {
+		c.unknown["flat_template_operator_unresolved"] = struct{}{}
+	}
+	return c.b.constant(observed)
+}
+
+func artifactVariableStat(key string) bool {
+	switch key {
+	case "atk", "atk%", "hp", "hp%", "def", "def%", "em", "cr", "cd", "dmg%", "heal":
+		return true
+	default:
+		return false
+	}
+}
+
+func expectedFallbackDamage(hit info.GTTTraceHit) float64 {
+	if hit.UncappedDamage != 0 {
+		return hit.UncappedDamage
+	}
+	return hit.ReportedDamage
+}
+
+func normalizeToken(value, fallback string) string {
+	value = normalizeCoordinate("x", value)
+	value = value[2:]
+	if value == "" {
+		return fallback
+	}
+	return value
+}
+
+func sortedKeys[V any](values map[string]V) []string {
+	out := make([]string, 0, len(values))
+	for key := range values {
+		out = append(out, key)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/pkg/gttcompact/model.go b/pkg/gttcompact/model.go
new file mode 100644
index 0000000..e2c2ad4
--- /dev/null
+++ b/pkg/gttcompact/model.go
@@ -0,0 +1,63 @@
+// Package gttcompact compiles the opt-in equation trace into the stable,
+// engine-neutral seed-member boundary consumed by GenshinTeamsTracker. It owns
+// no artifact search or candidate ranking.
+package gttcompact
+
+type IRInput struct {
+	NodeID   uint32 `json:"node_id"`
+	Relation string `json:"relation"`
+}
+
+type IRNode struct {
+	NodeID     uint32    `json:"node_id"`
+	Operation  string    `json:"operation"`
+	Inputs     []IRInput `json:"inputs"`
+	Value      string    `json:"value,omitempty"`
+	Coordinate string    `json:"coordinate,omitempty"`
+}
+
+type IRChannel struct {
+	ChannelID           string   `json:"channel_id"`
+	Kind                string   `json:"kind"`
+	ActorKey            string   `json:"actor_key"`
+	AttackTag           string   `json:"attack_tag"`
+	DamageType          string   `json:"damage_type"`
+	RootNodeID          uint32   `json:"root_node_id"`
+	HitCount            int      `json:"hit_count"`
+	BaselineDamage      string   `json:"baseline_damage"`
+	ResponseCoordinates []string `json:"response_coordinates"`
+}
+
+type IROpaqueBoundary struct {
+	BoundaryID          string `json:"boundary_id"`
+	NodeID              uint32 `json:"node_id"`
+	ReasonCode          string `json:"reason_code"`
+	BaselineDamage      string `json:"baseline_damage"`
+	BaselineDamageShare string `json:"baseline_damage_share"`
+}
+
+type IRSeedMember struct {
+	Seed             uint64             `json:"seed"`
+	DurationMS       int64              `json:"duration_ms"`
+	TopologySHA256   string             `json:"topology_sha256"`
+	Nodes            []IRNode           `json:"nodes"`
+	Channels         []IRChannel        `json:"channels"`
+	OpaqueBoundaries []IROpaqueBoundary `json:"opaque_boundaries"`
+}
+
+// Audit is not serialized into the optimizer contract. The engine command may
+// include it in a GOB-2 receipt, and tests use it to prove that compaction did
+// not silently discard an executed path.
+type Audit struct {
+	SourceHitCount          int
+	AncestorStateEventCount int
+	NodeCount               int
+	ChannelCount            int
+	OpaqueReasonCount       int
+	BaselineDamage          float64
+	AdapterElapsedNS        int64
+	HeapInuseStartBytes     uint64
+	HeapInusePeakBytes      uint64
+	HeapInuseEndBytes       uint64
+	TotalAllocDeltaBytes    uint64
+}
diff --git a/pkg/gttcompact/support.go b/pkg/gttcompact/support.go
new file mode 100644
index 0000000..cfead9d
--- /dev/null
+++ b/pkg/gttcompact/support.go
@@ -0,0 +1,666 @@
+package gttcompact
+
+import (
+	"math"
+	"sort"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gttsource"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+type supportProgram struct {
+	eventOutputs map[string]map[string]compiledNode
+	unknown      map[string]struct{}
+	ancestorIDs  map[string]struct{}
+}
+
+type supportCompiler struct {
+	b             *nodeBuilder
+	buffer        optstats.GTTTraceEquationBuffer
+	characterKeys []string
+	unknown       map[string]struct{}
+	ancestorIDs   map[string]struct{}
+	eventByID     map[string]gtttrace.StateEvent
+	operationByID map[string]gtttrace.HealthOperation
+	eventNodes    map[string]compiledNode
+	eventOutputs  map[string]map[string]compiledNode
+	healthNodes   map[string]map[string]compiledNode
+	slotNodes     map[string]compiledNode
+	bindings      map[string]map[string]compiledNode
+	previousHP    map[int]observedNode
+	maxHPSnapshot map[string]map[string]float64
+}
+
+type observedNode struct {
+	node     compiledNode
+	observed float64
+}
+
+func compileSupportProgram(b *nodeBuilder, buffer optstats.GTTTraceEquationBuffer, characterKeys []string) supportProgram {
+	ancestorIDs := hitAncestorEventIDs(buffer)
+	c := &supportCompiler{
+		b: b, buffer: buffer, characterKeys: characterKeys,
+		unknown: make(map[string]struct{}), ancestorIDs: ancestorIDs,
+		eventByID:     make(map[string]gtttrace.StateEvent, len(buffer.StateEvents)),
+		operationByID: make(map[string]gtttrace.HealthOperation, len(buffer.HealthOperations)),
+		eventNodes:    make(map[string]compiledNode), eventOutputs: make(map[string]map[string]compiledNode),
+		healthNodes: make(map[string]map[string]compiledNode), slotNodes: make(map[string]compiledNode),
+		bindings: make(map[string]map[string]compiledNode), previousHP: make(map[int]observedNode),
+		maxHPSnapshot: make(map[string]map[string]float64),
+	}
+	for _, event := range buffer.StateEvents {
+		c.eventByID[event.EventID] = event
+		if event.Kind == gtttrace.StateEventMaxHPRead && event.Provider.Key != "" {
+			c.maxHPSnapshot[event.Provider.Key] = event.Output
+		}
+	}
+	for _, operation := range buffer.HealthOperations {
+		c.operationByID[operation.OperationID] = operation
+	}
+	for _, event := range buffer.StateEvents {
+		if _, ok := ancestorIDs[event.EventID]; !ok {
+			continue
+		}
+		if !event.CandidateDependencyComplete {
+			for _, code := range event.UncertaintyCodes {
+				c.markUnknown(code)
+			}
+		}
+		c.compileEvent(event)
+	}
+	return supportProgram{eventOutputs: c.eventOutputs, unknown: c.unknown, ancestorIDs: ancestorIDs}
+}
+
+func hitAncestorEventIDs(buffer optstats.GTTTraceEquationBuffer) map[string]struct{} {
+	parents := make(map[string]map[string]struct{}, len(buffer.StateEvents))
+	lastSlot := make(map[string]string)
+	bindingEvents := make(map[string][]string)
+	healthContext := make(map[string]string)
+	previousHealthByTarget := make(map[int]string)
+	operationByID := make(map[string]gtttrace.HealthOperation, len(buffer.HealthOperations))
+	for _, operation := range buffer.HealthOperations {
+		operationByID[operation.OperationID] = operation
+	}
+	addParent := func(child, parent string) {
+		if child == "" || parent == "" {
+			return
+		}
+		if parents[child] == nil {
+			parents[child] = make(map[string]struct{})
+		}
+		parents[child][parent] = struct{}{}
+	}
+	addReference := func(child string, ref gtttrace.NumericRef) {
+		if ref.Kind == "event" && ref.EventID != nil {
+			addParent(child, *ref.EventID)
+		} else if ref.Kind == "health_field" && ref.HealthOperationID != nil {
+			addParent(child, healthContext[*ref.HealthOperationID])
+		}
+	}
+	for _, event := range buffer.StateEvents {
+		if parents[event.EventID] == nil {
+			parents[event.EventID] = make(map[string]struct{})
+		}
+		switch event.Kind {
+		case gtttrace.StateEventSlotRegister:
+			if event.SlotID != nil {
+				lastSlot[*event.SlotID] = event.EventID
+			}
+		case gtttrace.StateEventNumericStateRead:
+			if event.SlotID != nil {
+				addParent(event.EventID, lastSlot[*event.SlotID])
+			}
+		case gtttrace.StateEventMaxHPRead:
+			for _, id := range event.ModifierEvalIDs {
+				addParent(event.EventID, id)
+			}
+		case gtttrace.StateEventHealthFieldBinding:
+			if event.HealthOperationID != nil && event.BoundEventID != nil {
+				addParent(event.EventID, *event.BoundEventID)
+				bindingEvents[*event.HealthOperationID] = append(bindingEvents[*event.HealthOperationID], event.EventID)
+			}
+		case gtttrace.StateEventHealthContextEnter:
+			if event.HealthOperationID != nil {
+				operation, ok := operationByID[*event.HealthOperationID]
+				if ok {
+					for _, id := range bindingEvents[operation.OperationID] {
+						addParent(event.EventID, id)
+					}
+					addParent(event.EventID, previousHealthByTarget[operation.TargetIndex])
+					healthContext[operation.OperationID] = event.EventID
+					previousHealthByTarget[operation.TargetIndex] = event.EventID
+				}
+			}
+		case gtttrace.StateEventNumericEval, gtttrace.StateEventModifierEval:
+			for _, ref := range event.Inputs {
+				addReference(event.EventID, ref)
+			}
+		case gtttrace.StateEventNumericStateWrite:
+			for _, ref := range event.Inputs {
+				addReference(event.EventID, ref)
+			}
+			if event.SlotID != nil {
+				lastSlot[*event.SlotID] = event.EventID
+			}
+		case gtttrace.StateEventStateResync:
+			if event.SlotID != nil {
+				lastSlot[*event.SlotID] = event.EventID
+			}
+		}
+	}
+	pending := make([]string, 0)
+	for _, hit := range buffer.Hits {
+		for _, contribution := range hit.StatContributions {
+			if contribution.ModifierEvalEventID != "" {
+				pending = append(pending, contribution.ModifierEvalEventID)
+			}
+		}
+		for _, contribution := range hit.AttackMods {
+			if contribution.ModifierEvalEventID != "" {
+				pending = append(pending, contribution.ModifierEvalEventID)
+			}
+		}
+	}
+	ancestors := make(map[string]struct{})
+	for len(pending) > 0 {
+		id := pending[len(pending)-1]
+		pending = pending[:len(pending)-1]
+		if _, seen := ancestors[id]; seen || id == "" {
+			continue
+		}
+		ancestors[id] = struct{}{}
+		for parent := range parents[id] {
+			pending = append(pending, parent)
+		}
+	}
+	return ancestors
+}
+
+func (c *supportCompiler) compileEvent(event gtttrace.StateEvent) {
+	switch event.Kind {
+	case gtttrace.StateEventSlotRegister:
+		value := valueOr(event.Value, 0)
+		node := c.b.constant(value)
+		c.eventNodes[event.EventID] = node
+		if event.SlotID != nil {
+			c.slotNodes[*event.SlotID] = node
+		}
+	case gtttrace.StateEventNumericStateRead:
+		node, ok := compiledNode{}, false
+		if event.SlotID != nil {
+			node, ok = c.slotNodes[*event.SlotID]
+		}
+		if !ok {
+			node = c.b.constant(valueOr(event.Value, 0))
+			c.markUnknown("state_read_without_compact_predecessor")
+		}
+		c.eventNodes[event.EventID] = node
+	case gtttrace.StateEventMaxHPRead:
+		c.compileMaxHPRead(event)
+	case gtttrace.StateEventHealthFieldBinding:
+		if event.HealthOperationID == nil || event.Key == nil || event.BoundEventID == nil {
+			c.markUnknown("health_binding_shape_unresolved")
+			return
+		}
+		if c.bindings[*event.HealthOperationID] == nil {
+			c.bindings[*event.HealthOperationID] = make(map[string]compiledNode)
+		}
+		c.bindings[*event.HealthOperationID][*event.Key] = c.resolveBound(*event.BoundEventID, *event.Key)
+	case gtttrace.StateEventHealthContextEnter:
+		c.compileHealthOperation(event)
+	case gtttrace.StateEventNumericEval:
+		node := c.compileNumericEvent(event)
+		c.eventNodes[event.EventID] = node
+	case gtttrace.StateEventNumericStateWrite:
+		if event.SlotID == nil {
+			c.markUnknown("state_write_slot_unresolved")
+			return
+		}
+		node := c.b.constant(valueOr(event.After, 0))
+		if len(event.Inputs) > 0 {
+			node = c.resolve(event.Inputs[len(event.Inputs)-1])
+		}
+		c.slotNodes[*event.SlotID] = node
+		c.eventNodes[event.EventID] = node
+	case gtttrace.StateEventStateResync:
+		if event.SlotID != nil {
+			previous := c.slotNodes[*event.SlotID]
+			if len(previous.coords) > 0 {
+				c.markUnknown("candidate_sensitive_state_resync")
+			}
+			node := c.b.constant(valueOr(event.After, 0))
+			c.slotNodes[*event.SlotID] = node
+			c.eventNodes[event.EventID] = node
+		}
+	case gtttrace.StateEventModifierEval:
+		c.compileModifierEvent(event)
+	}
+}
+
+func (c *supportCompiler) compileMaxHPRead(event gtttrace.StateEvent) {
+	actor := event.Provider.Key
+	base := c.b.constant(event.Output["base_hp"])
+	hpPercent := c.b.add(c.b.constant(event.Output["hp%"]), c.b.artifactDelta(actor, "hp%"))
+	flatHP := c.b.add(c.b.constant(event.Output["hp"]), c.b.artifactDelta(actor, "hp"))
+	for _, eventID := range event.ModifierEvalIDs {
+		for key, target := range map[string]*compiledNode{"hp%": &hpPercent, "hp": &flatHP} {
+			baseline := c.eventByID[eventID].Output[key]
+			candidate, ok := c.eventOutputs[eventID][key]
+			if ok {
+				*target = c.b.add(*target, c.b.subtract(candidate, c.b.constant(baseline)))
+			}
+		}
+	}
+	maxHP := c.b.add(c.b.multiply(base, c.b.add(c.b.constant(1), hpPercent)), flatHP)
+	c.eventOutputs[event.EventID] = map[string]compiledNode{
+		"base_hp": base, "hp%": hpPercent, "hp": flatHP, "max_hp": maxHP,
+	}
+}
+
+func (c *supportCompiler) compileNumericEvent(event gtttrace.StateEvent) compiledNode {
+	observed := valueOr(event.Value, 0)
+	operation := valueOr(event.Operation, "")
+	if operation == "health_input" && len(event.Inputs) == 0 {
+		return c.compileSourceTemplate(event.SourceID, event.TemplateSHA256, event.Parameters, observed)
+	}
+	inputs := make([]compiledNode, 0, len(event.Inputs))
+	for _, ref := range event.Inputs {
+		inputs = append(inputs, c.resolve(ref))
+	}
+	switch operation {
+	case "literal":
+		return c.b.constant(observed)
+	case "identity", "task_payload", "health_input":
+		if len(inputs) == 1 {
+			return inputs[0]
+		}
+	case "negate":
+		if len(inputs) == 1 {
+			return c.b.multiply(c.b.constant(-1), inputs[0])
+		}
+	case "add":
+		return c.b.add(inputs...)
+	case "multiply":
+		return c.b.multiply(inputs...)
+	case "min":
+		return c.b.min(inputs...)
+	case "max":
+		return c.b.max(inputs...)
+	case "subtract":
+		if len(inputs) == 2 {
+			return c.b.subtract(inputs[0], inputs[1])
+		}
+	case "divide":
+		if len(inputs) == 2 && inputs[1].baseline != 0 {
+			return c.b.divide(inputs[0], inputs[1])
+		}
+	case "source_expression", "state_transition":
+		if hasCoordinates(inputs) {
+			c.markUnknown("candidate_sensitive_" + operation)
+		}
+		return c.b.constant(observed)
+	}
+	if hasCoordinates(inputs) {
+		c.markUnknown("candidate_sensitive_numeric_operation_unresolved")
+	}
+	return c.b.constant(observed)
+}
+
+func (c *supportCompiler) compileModifierEvent(event gtttrace.StateEvent) {
+	outputs := make(map[string]compiledNode, len(event.Output))
+	for key, observed := range event.Output {
+		matches := make([]compiledNode, 0, 1)
+		for _, ref := range event.Inputs {
+			node := c.resolve(ref)
+			if closeEnough(node.baseline, observed) {
+				matches = append(matches, node)
+			}
+		}
+		if len(matches) == 1 {
+			outputs[key] = matches[0]
+			continue
+		}
+		if hasCoordinates(matchesForRefs(c, event.Inputs)) {
+			c.markUnknown("candidate_sensitive_modifier_output_unresolved")
+		}
+		outputs[key] = c.b.constant(observed)
+	}
+	c.eventOutputs[event.EventID] = outputs
+}
+
+func matchesForRefs(c *supportCompiler, refs []gtttrace.NumericRef) []compiledNode {
+	out := make([]compiledNode, 0, len(refs))
+	for _, ref := range refs {
+		out = append(out, c.resolve(ref))
+	}
+	return out
+}
+
+func (c *supportCompiler) compileSourceTemplate(sourceID, templateSHA256 *string, parameters []gtttrace.SourceValueParameter, observed float64) compiledNode {
+	if sourceID == nil || templateSHA256 == nil {
+		c.markUnknown("source_template_identity_missing")
+		return c.b.constant(observed)
+	}
+	template, ok := gttsource.CompactSliceTemplate(*sourceID)
+	if !ok || template.Status != "SUPPORTED" || template.TemplateSHA256 != *templateSHA256 || template.RootNodeID == nil {
+		c.markUnknown("source_template_unavailable")
+		return c.b.constant(observed)
+	}
+	parameterNodes := make(map[string]compiledNode, len(parameters))
+	for _, parameter := range parameters {
+		parameterNodes[parameter.ParameterKey] = c.parameterNode(parameter)
+	}
+	nodes := make(map[int]compiledNode, len(template.Nodes))
+	for _, row := range template.Nodes {
+		var node compiledNode
+		switch row.Operator {
+		case "CONST":
+			if row.ConstantValue == nil {
+				c.markUnknown("source_template_constant_missing")
+				return c.b.constant(observed)
+			}
+			node = c.b.constant(*row.ConstantValue)
+		case "PARAM":
+			if row.ParameterKey == nil {
+				c.markUnknown("source_template_parameter_missing")
+				return c.b.constant(observed)
+			}
+			node, ok = parameterNodes[*row.ParameterKey]
+			if !ok {
+				c.markUnknown("source_template_parameter_unbound")
+				return c.b.constant(observed)
+			}
+		default:
+			inputs := make([]compiledNode, 0, len(row.InputNodeIDs))
+			for _, id := range row.InputNodeIDs {
+				input, exists := nodes[id]
+				if !exists {
+					c.markUnknown("source_template_order_invalid")
+					return c.b.constant(observed)
+				}
+				inputs = append(inputs, input)
+			}
+			switch row.Operator {
+			case "ADD":
+				node = c.b.add(inputs...)
+			case "SUB":
+				if len(inputs) != 2 {
+					return c.freezeTemplate(inputs, observed, "source_template_sub_arity")
+				}
+				node = c.b.subtract(inputs[0], inputs[1])
+			case "MUL":
+				node = c.b.multiply(inputs...)
+			case "DIV":
+				if len(inputs) != 2 || inputs[1].baseline == 0 {
+					return c.freezeTemplate(inputs, observed, "source_template_div_arity")
+				}
+				node = c.b.divide(inputs[0], inputs[1])
+			case "MIN":
+				node = c.b.min(inputs...)
+			case "MAX":
+				node = c.b.max(inputs...)
+			case "ABS":
+				if len(inputs) != 1 {
+					return c.freezeTemplate(inputs, observed, "source_template_abs_arity")
+				}
+				node = c.b.max(inputs[0], c.b.multiply(c.b.constant(-1), inputs[0]))
+			default:
+				return c.freezeTemplate(inputs, observed, "source_template_operator_unresolved")
+			}
+		}
+		nodes[row.NodeID] = node
+	}
+	root, ok := nodes[*template.RootNodeID]
+	if !ok || !closeEnough(root.baseline, observed) {
+		c.markUnknown("source_template_baseline_mismatch")
+		return c.b.constant(observed)
+	}
+	return root
+}
+
+func (c *supportCompiler) freezeTemplate(inputs []compiledNode, observed float64, reason string) compiledNode {
+	if hasCoordinates(inputs) {
+		c.markUnknown(reason)
+	}
+	return c.b.constant(observed)
+}
+
+func (c *supportCompiler) parameterNode(parameter gtttrace.SourceValueParameter) compiledNode {
+	if parameter.Kind != "candidate_stat" || parameter.ActorKey == nil || parameter.StatKey == nil {
+		return c.b.constant(parameter.ObservedValue)
+	}
+	actor, stat := *parameter.ActorKey, *parameter.StatKey
+	if stat != "max_hp" {
+		return c.b.add(c.b.constant(parameter.ObservedValue), c.b.artifactDelta(actor, stat))
+	}
+	snapshot := c.maxHPSnapshot[actor]
+	if snapshot == nil {
+		c.markUnknown("candidate_max_hp_snapshot_missing")
+		return c.b.constant(parameter.ObservedValue)
+	}
+	return c.b.add(
+		c.b.constant(parameter.ObservedValue),
+		c.b.multiply(c.b.constant(snapshot["base_hp"]), c.b.artifactDelta(actor, "hp%")),
+		c.b.artifactDelta(actor, "hp"),
+	)
+}
+
+func (c *supportCompiler) compileHealthOperation(event gtttrace.StateEvent) {
+	if event.HealthOperationID == nil {
+		c.markUnknown("health_operation_identity_missing")
+		return
+	}
+	operation, ok := c.operationByID[*event.HealthOperationID]
+	if !ok {
+		c.markUnknown("health_operation_missing")
+		return
+	}
+	if operation.HPDebtBefore != 0 || operation.HPDebtAfter != 0 {
+		c.markUnknown("health_debt_unresolved")
+		c.healthNodes[operation.OperationID] = c.observedHealthNodes(operation)
+		return
+	}
+	bindings := c.bindings[operation.OperationID]
+	get := func(key string, observed float64) compiledNode {
+		if value, exists := bindings[key]; exists {
+			return value
+		}
+		return c.b.constant(observed)
+	}
+	maxBefore := get("max_hp_before", operation.MaxHPBefore)
+	maxAfter := get("max_hp_after", operation.MaxHPAfter)
+	input := get("input_value", operation.InputValue)
+	adjusted := get("adjusted_input_value", operation.AdjustedInputValue)
+	if _, exists := bindings["adjusted_input_value"]; !exists && operation.InputValue != 0 {
+		adjusted = c.b.multiply(input, c.b.constant(operation.AdjustedInputValue/operation.InputValue))
+	}
+	prior := c.previousHP[operation.TargetIndex]
+	hpBeforeBase := c.b.constant(operation.HPBefore)
+	if prior.node.id != 0 {
+		hpBeforeBase = c.b.add(hpBeforeBase, c.b.subtract(prior.node, c.b.constant(prior.observed)))
+	}
+	hpBefore := c.b.min(maxBefore, c.b.max(c.b.constant(0), hpBeforeBase))
+	base, sourceBonus, raw, eventAmount, effective, hpAfter, overheal := adjusted, c.b.constant(0), adjusted, adjusted, adjusted, adjusted, c.b.constant(0)
+	if operation.Kind == gtttrace.HealthOperationHeal {
+		if operation.HealType == nil || operation.SourceBonus == nil || operation.HealBonusTotal == nil {
+			c.markUnknown("health_formula_fields_missing")
+			c.healthNodes[operation.OperationID] = c.observedHealthNodes(operation)
+			return
+		}
+		if *operation.HealType == gtttrace.HealthHealTypePercent {
+			base = c.b.multiply(adjusted, maxBefore)
+		} else if *operation.HealType != gtttrace.HealthHealTypeAbsolute {
+			c.markUnknown("health_type_unresolved")
+			c.healthNodes[operation.OperationID] = c.observedHealthNodes(operation)
+			return
+		}
+		sourceBonus = c.b.constant(*operation.SourceBonus)
+		if operation.CallerIndex != nil && *operation.CallerIndex >= 0 && *operation.CallerIndex < len(c.characterKeys) {
+			sourceBonus = c.b.add(sourceBonus, c.b.artifactDelta(c.characterKeys[*operation.CallerIndex], "heal"))
+		}
+		raw = c.b.multiply(base, c.b.add(c.b.constant(1+*operation.HealBonusTotal), sourceBonus))
+		eventAmount = raw
+		effective = c.b.min(eventAmount, c.b.max(c.b.constant(0), c.b.subtract(maxAfter, hpBefore)))
+		hpAfter = c.b.min(maxAfter, c.b.add(hpBefore, effective))
+		overheal = c.b.max(c.b.constant(0), c.b.subtract(eventAmount, effective))
+	} else {
+		effective = c.b.min(eventAmount, hpBefore)
+		hpAfter = c.b.max(c.b.constant(0), c.b.subtract(hpBefore, effective))
+	}
+	fields := map[string]compiledNode{
+		"input_value": input, "adjusted_input_value": adjusted, "base_amount": base,
+		"source_bonus": sourceBonus, "raw_amount": raw, "event_amount": eventAmount,
+		"event_effective_amount": effective, "hp_delta_magnitude": effective, "overheal": overheal,
+		"max_hp_before": maxBefore, "max_hp_after": maxAfter, "hp_before": hpBefore, "hp_after": hpAfter,
+		"hp_ratio_before": c.b.divide(hpBefore, maxBefore), "hp_ratio_after": c.b.divide(hpAfter, maxAfter),
+	}
+	c.healthNodes[operation.OperationID] = fields
+	c.previousHP[operation.TargetIndex] = observedNode{node: hpAfter, observed: operation.HPAfter}
+}
+
+func (c *supportCompiler) observedHealthNodes(operation gtttrace.HealthOperation) map[string]compiledNode {
+	values := map[string]float64{
+		"input_value": operation.InputValue, "adjusted_input_value": operation.AdjustedInputValue,
+		"raw_amount": operation.RawAmount, "event_amount": operation.EventAmount,
+		"event_effective_amount": operation.EventEffectiveAmount, "hp_delta_magnitude": operation.HPDeltaMagnitude,
+		"max_hp_before": operation.MaxHPBefore, "max_hp_after": operation.MaxHPAfter,
+		"hp_before": operation.HPBefore, "hp_after": operation.HPAfter,
+		"hp_ratio_before": operation.HPRatioBefore, "hp_ratio_after": operation.HPRatioAfter,
+	}
+	if operation.BaseAmount != nil {
+		values["base_amount"] = *operation.BaseAmount
+	}
+	if operation.SourceBonus != nil {
+		values["source_bonus"] = *operation.SourceBonus
+	}
+	if operation.Overheal != nil {
+		values["overheal"] = *operation.Overheal
+	}
+	out := make(map[string]compiledNode, len(values))
+	for key, value := range values {
+		out[key] = c.b.constant(value)
+	}
+	return out
+}
+
+func (c *supportCompiler) resolve(reference gtttrace.NumericRef) compiledNode {
+	if reference.Kind == "literal" && reference.LiteralValue != nil {
+		return c.b.constant(*reference.LiteralValue)
+	}
+	if reference.Kind == "event" && reference.EventID != nil {
+		if reference.FieldKey != nil {
+			if node, ok := c.eventOutputs[*reference.EventID][*reference.FieldKey]; ok {
+				return node
+			}
+		}
+		if node, ok := c.eventNodes[*reference.EventID]; ok {
+			return node
+		}
+		return c.b.constant(c.observedEventReference(*reference.EventID, reference.FieldKey))
+	}
+	if reference.Kind == "health_field" && reference.HealthOperationID != nil && reference.FieldKey != nil {
+		if node, ok := c.healthNodes[*reference.HealthOperationID][*reference.FieldKey]; ok {
+			return node
+		}
+		if operation, ok := c.operationByID[*reference.HealthOperationID]; ok {
+			return c.b.constant(observedHealthField(operation, *reference.FieldKey))
+		}
+	}
+	c.markUnknown("numeric_reference_unresolved")
+	return c.b.constant(0)
+}
+
+func (c *supportCompiler) resolveBound(eventID, fieldKey string) compiledNode {
+	if node, ok := c.eventOutputs[eventID][fieldKey]; ok {
+		return node
+	}
+	for _, suffix := range []string{"_before", "_after"} {
+		if strings.HasSuffix(fieldKey, suffix) {
+			if node, ok := c.eventOutputs[eventID][strings.TrimSuffix(fieldKey, suffix)]; ok {
+				return node
+			}
+		}
+	}
+	if node, ok := c.eventNodes[eventID]; ok {
+		return node
+	}
+	return c.b.constant(c.observedEventReference(eventID, &fieldKey))
+}
+
+func (c *supportCompiler) observedEventReference(eventID string, fieldKey *string) float64 {
+	event, ok := c.eventByID[eventID]
+	if !ok {
+		c.markUnknown("observed_event_missing")
+		return 0
+	}
+	if fieldKey != nil {
+		if value, exists := event.Output[*fieldKey]; exists {
+			return value
+		}
+		for _, suffix := range []string{"_before", "_after"} {
+			if strings.HasSuffix(*fieldKey, suffix) {
+				if value, exists := event.Output[strings.TrimSuffix(*fieldKey, suffix)]; exists {
+					return value
+				}
+			}
+		}
+	}
+	return valueOr(event.Value, 0)
+}
+
+func observedHealthField(operation gtttrace.HealthOperation, key string) float64 {
+	values := map[string]float64{
+		"input_value": operation.InputValue, "adjusted_input_value": operation.AdjustedInputValue,
+		"raw_amount": operation.RawAmount, "event_amount": operation.EventAmount,
+		"event_effective_amount": operation.EventEffectiveAmount, "hp_delta_magnitude": operation.HPDeltaMagnitude,
+		"max_hp_before": operation.MaxHPBefore, "max_hp_after": operation.MaxHPAfter,
+		"hp_before": operation.HPBefore, "hp_after": operation.HPAfter,
+		"hp_ratio_before": operation.HPRatioBefore, "hp_ratio_after": operation.HPRatioAfter,
+	}
+	if operation.BaseAmount != nil {
+		values["base_amount"] = *operation.BaseAmount
+	}
+	if operation.SourceBonus != nil {
+		values["source_bonus"] = *operation.SourceBonus
+	}
+	if operation.Overheal != nil {
+		values["overheal"] = *operation.Overheal
+	}
+	return values[key]
+}
+
+func (c *supportCompiler) markUnknown(reason string) { c.unknown[reason] = struct{}{} }
+
+func hasCoordinates(nodes []compiledNode) bool {
+	for _, node := range nodes {
+		if len(node.coords) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func closeEnough(left, right float64) bool {
+	return math.Abs(left-right) <= 1e-9*math.Max(1, math.Max(math.Abs(left), math.Abs(right)))
+}
+
+func valueOr[T any](value *T, fallback T) T {
+	if value == nil {
+		return fallback
+	}
+	return *value
+}
+
+func sortedUnknown(values map[string]struct{}) []string {
+	out := make([]string, 0, len(values))
+	for value := range values {
+		out = append(out, value)
+	}
+	sort.Strings(out)
+	return out
+}
+
