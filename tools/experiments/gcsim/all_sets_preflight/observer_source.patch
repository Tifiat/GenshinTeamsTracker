@@ -0,0 +1,50 @@
+package optimization
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/gttcompact"
+)
+
+func TestEffectInputsOptInAndByteBinding(t *testing.T) {
+	r := GTTTraceEquationRequest{SchemaVersion: 1, ContextSHA256: strings.Repeat("a", 64), Seed: "71", Iterations: 1, Workers: 1}
+	r.IncludeEffectInputs = true
+	if r.validate() == nil {
+		t.Fatal("sidecar without compact mode accepted")
+	}
+	r.OutputMode = "compact_ir_v1"
+	if err := r.validate(); err != nil {
+		t.Fatal(err)
+	}
+	member := []byte("{\"seed\":\"71\"}\n")
+	digest := sha256.Sum256(member)
+	path := filepath.Join(t.TempDir(), "member.json")
+	if err := writeGTTEffectInputs(path, member, r, "config\r\n", "config\n\n", []string{"actor_b", "actor_a"}, gttcompact.Audit{}); err != nil {
+		t.Fatal(err)
+	}
+	payload, err := os.ReadFile(path + ".effects.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out GTTEffectInputs
+	if err := json.Unmarshal(payload, &out); err != nil {
+		t.Fatal(err)
+	}
+	if out.MemberContentSHA256 != hex.EncodeToString(digest[:]) || out.ContextSHA256 != r.ContextSHA256 || out.Seed != r.Seed || out.CharacterKeys[0] != "actor_b" || out.EffectInputs == nil || out.ResistanceInputs == nil {
+		t.Fatalf("sidecar binding incomplete: %+v", out)
+	}
+	if out.InputConfigSHA256 != traceTextSHA256("config\r\n") || out.SourceConfigSHA256 != traceTextSHA256("config\n\n") {
+		t.Fatal("raw and engine-resolved text hashes conflated")
+	}
+	r.IncludeEffectInputs = false
+	payload, _ = json.Marshal(r)
+	if strings.Contains(string(payload), "include_effect_inputs") {
+		t.Fatal("legacy request changed")
+	}
+}
