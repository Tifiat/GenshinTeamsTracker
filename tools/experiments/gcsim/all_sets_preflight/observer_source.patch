@@ -0,0 +1,42 @@
+package gttcompact
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+	"testing"
+)
+
+func TestEffectInputUsesActualOwnerAndExactEventBinding(t *testing.T) {
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	id := r.RecordEffectRead("", "reaction_bonus", 0, 31, "literal", nil, 0, gtttrace.IncompleteEvidence("synthetic"))
+	b := &nodeBuilder{}
+	n := b.constant(0)
+	buffer := optstats.GTTTraceEquationBuffer{StateEvents: r.StateEvents()}
+	support := supportProgram{eventNodes: map[string]compiledNode{id: n}}
+	got := collectEffectInputs(buffer, []string{"actual_owner", "display_actor"}, support)
+	if len(got) != 1 || got[0].Owner != "actual_owner" || got[0].NodeID != n.id || got[0].AttackTag != "tag/31" {
+		t.Fatal(got)
+	}
+	support.eventNodes[id] = b.constant(1)
+	if len(collectEffectInputs(buffer, []string{"actual_owner"}, support)) != 0 {
+		t.Fatal("different observed value accepted")
+	}
+	delete(support.eventNodes, id)
+	if len(collectEffectInputs(buffer, []string{"actual_owner"}, support)) != 0 {
+		t.Fatal("missing event guessed by value")
+	}
+}
+
+func TestResistanceInputsDoNotExposeFailedFormulaNodes(t *testing.T) {
+	b := &nodeBuilder{}
+	c := directCompiler{b: b}
+	accepted := c.resistanceInput(info.GTTTraceHit{HitID: 1, TargetKey: 7, Element: "electro", Resistance: 0.1, ResMod: 0.9})
+	_ = c.resistanceInput(info.GTTTraceHit{HitID: 2, TargetKey: 8, Element: "dendro", Resistance: 0.1, ResMod: 0.9})
+	root := b.multiply(accepted, b.constant(123))
+	got := b.usedResistanceInputs([]IRChannel{{RootNodeID: root.id}})
+	if len(got) != 1 || got[0].NodeID != accepted.id || got[0].HitID != 1 || got[0].TargetKey != 7 {
+		t.Fatal(got)
+	}
+}
