+func (b *nodeBuilder) snapshotDelta(actorKey, statKey string) compiledNode {
+	// An explicitly unsnapshotted attack never inherited character artifacts
+	// or StatMods. AttackMods still execute at impact and need their own ports.
+	// Independent source/reaction reads retain their own event input points.
+	if b.inputPoint.noStatSnapshot {
+		n := b.constant(0)
+		if b.neutral { return b.withNeutralStatInputs(n, actorKey, statKey, true) }
+		return n
+	}
+	return b.artifactDelta(actorKey, statKey)
+}
