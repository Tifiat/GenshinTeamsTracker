+package gttcompact
+
+import (
+    "testing"
+    "github.com/genshinsim/gcsim/pkg/core/info"
+    "github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestNoStatSnapshotKeepsAttackInputsOnly(t *testing.T) {
+    hit := info.GTTTraceHit{NoStatSnapshot: true, Frame: 9, HitOrder: 31, AttackModOrder: 27}
+    for _, neutral := range []bool{false, true} {
+        b := &nodeBuilder{neutral: neutral, inputPoint: neutralHitPoint(hit)}
+        got := b.snapshotDelta("owner", "cr")
+        if got.baseline != 0 || len(got.coords) != 0 { t.Fatal("invented artifact inheritance", got) }
+        for _, n := range b.nodes { if n.Operation == "artifact_stat" { t.Fatal("raw artifact leaf survived", n) } }
+        if !neutral {
+            if len(b.neutralInputs) != 0 { t.Fatal("Selected gained effect ports") }
+            continue
+        }
+        if len(b.neutralInputs) != 1 { t.Fatal("wrong ports", b.neutralInputs) }
+        p := b.neutralInputs[0]
+        if p.Kind != "attack" || p.Point.Order != 27 || p.Point.Frame != 9 { t.Fatal(p) }
+    }
+}
+
+func TestNoStatSnapshotDoesNotBlessMissingOrigin(t *testing.T) {
+    // No explicit producer attestation: even all-zero observations must retain
+    // the unresolved stat query. A custom/lost snapshot is not a known zero.
+    b := &nodeBuilder{neutral: true, inputPoint: neutralHitPoint(info.GTTTraceHit{AttackModOrder: 27})}
+    got := b.snapshotDelta("owner", "cr")
+    if len(got.coords) != 1 || len(b.neutralInputs) != 2 || b.neutralInputs[0].Kind != "stat" || b.neutralInputs[0].Point.Order != 0 {
+        t.Fatal("missing origin silently treated as empty", b.neutralInputs)
+    }
+}
+
+func TestNoStatSnapshotLeavesIndependentReadsVariable(t *testing.T) {
+    b := &nodeBuilder{neutral: true, inputPoint: neutralHitPoint(info.GTTTraceHit{NoStatSnapshot: true})}
+    b.snapshotDelta("owner", "em")
+    channel := "stat_input:stat"
+    b.inputPoint = neutralEventPoint(gtttrace.StateEvent{ObservationOrder: 15, Channel: &channel})
+    got := b.artifactDelta("reaction_owner", "em")
+    if len(got.coords) != 1 || len(b.neutralInputs) != 1 || b.neutralInputs[0].Point.Order != 15 {
+        t.Fatal("independent reaction/buff read frozen", got, b.neutralInputs)
+    }
+}
+
+func TestNoStatSnapshotGenericHitLocalReadNotFrozen(t *testing.T) {
+    b := &nodeBuilder{neutral: true, inputPoint: neutralHitPoint(info.GTTTraceHit{NoStatSnapshot: true})}
+    got := b.artifactDelta("producer", "em")
+    if len(got.coords) != 1 || len(b.neutralInputs) != 1 || b.neutralInputs[0].Point.Order != 0 {
+        t.Fatal("live producer dependency frozen or missing query fabricated", got, b.neutralInputs)
+    }
+}
+
+func TestNoStatSnapshotPreservesAuraHitsInSidecar(t *testing.T) {
+    // The point retains hit and attack identity even when no stat read occurred.
+    hit := info.GTTTraceHit{NoStatSnapshot: true, HitID: 42, Frame: 9, HitOrder: 31, AttackModOrder: 27, Element: "hydro"}
+    p := neutralHitPoint(hit)
+    if p.HitID != 42 || p.HitOrder != 31 || p.AttackOrder != 27 || p.Element != "hydro" || p.Mode != "snapshot" || !p.noStatSnapshot {
+        t.Fatal("aura/event identity lost", p)
+    }
+}
