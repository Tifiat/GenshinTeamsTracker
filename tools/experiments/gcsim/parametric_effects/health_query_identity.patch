+package optimization
+import("testing";"github.com/genshinsim/gcsim/pkg/gtttrace")
+func TestHealthSourceBonusBindingRequiresExactOriginalValue(t *testing.T){
+ bonus,wrong:=.2,.3
+ operation,key,boundID:="heal","source_bonus","bonus"
+ v:=gttStateValidation{health:map[string]gtttrace.HealthOperation{operation:{SourceBonus:&bonus}},events:map[string]gtttrace.StateEvent{boundID:{Kind:gtttrace.StateEventNumericEval,Value:&bonus}}}
+ row:=gtttrace.StateEvent{Kind:gtttrace.StateEventHealthFieldBinding,HealthOperationID:&operation,Key:&key,Value:&bonus,BoundEventID:&boundID}
+ if err:=v.validateEventShapeAndArithmetic(row,nil);err!=nil{t.Fatal(err)}
+ row.Value=&wrong
+ if err:=v.validateEventShapeAndArithmetic(row,nil);err==nil{t.Fatal("accepted changed operation value")}
+ row.Value=&bonus
+ v.events[boundID]=gtttrace.StateEvent{Kind:gtttrace.StateEventNumericEval,Value:&wrong}
+ if err:=v.validateEventShapeAndArithmetic(row,nil);err==nil{t.Fatal("accepted changed source value")}
+ v.events[boundID]=gtttrace.StateEvent{Kind:gtttrace.StateEventNumericEval,Value:&bonus}
+ v.health[operation]=gtttrace.HealthOperation{}
+ if err:=v.validateEventShapeAndArithmetic(row,nil);err==nil{t.Fatal("accepted absent source bonus")}
+}
