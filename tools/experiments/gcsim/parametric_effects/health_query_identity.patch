+++ b/pkg/gttsourcegen/health_field_capture.go
@@ -0,0 +1,1 @@
+package gttsourcegen
+
+import (
+ "fmt"
+ "go/ast"
+ "go/token"
+ "sort"
+ "strconv"
+)
+
+// Follow a unique scalar definition through lexical ancestor blocks. The
+// receipt is created where gameplay evaluates the expression, including before
+// a returned closure, not where that closure eventually consumes the value.
+// Name shadowing, writes, aliases and additional consumers fail conservatively.
+func healthFieldOrigin(fn *ast.FuncDecl, stmt ast.Stmt, value ast.Expr) (ast.Expr, ast.Stmt, bool) {
+ id, local := value.(*ast.Ident)
+ if !local { return value, stmt, true }
+ blocks := []*ast.BlockStmt{}
+ ast.Inspect(fn.Body,func(n ast.Node)bool{
+  if b,ok:=n.(*ast.BlockStmt);ok && b.Pos()<stmt.Pos() && b.End()>stmt.End(){blocks=append(blocks,b)}
+  return true
+ })
+ sort.Slice(blocks,func(i,j int)bool{return blocks[i].End()-blocks[i].Pos()<blocks[j].End()-blocks[j].Pos()})
+ for _,block:=range blocks {
+  for _,s:=range block.List {
+   a,ok:=s.(*ast.AssignStmt)
+   if !ok || a.End()>=stmt.Pos(){continue}
+   for _,lhs:=range a.Lhs {
+    name,ok:=lhs.(*ast.Ident);if !ok || name.Name!=id.Name{continue}
+    if a.Tok!=token.DEFINE || len(a.Lhs)!=1 || len(a.Rhs)!=1{return value,stmt,false}
+    uses:=0
+    ast.Inspect(block,func(n ast.Node)bool{if v,ok:=n.(*ast.Ident);ok&&v.Name==id.Name{uses++};return true})
+    if uses!=2{return value,stmt,false}
+    return a.Rhs[0],a,true
+   }
+  }
+ }
+ return value,stmt,false
+}
+
+// Evaluate a field exactly once and bind the actual NumericRef. A copied stat
+// array is accepted only with explicit producer provenance (healthStatsRefs).
+func healthFieldCapture(fs *token.FileSet,tf *token.File,data []byte,file *ast.File,fn *ast.FuncDecl,lit *ast.CompositeLit,field *ast.KeyValueExpr,entry SourceEntry,rt string,requireTyped bool)([]textEdit,string,bool){
+ stmt:=containingStatement(fn.Body,lit);if stmt==nil{return nil,"",false}
+ original,at,proven:=healthFieldOrigin(fn,stmt,field.Value)
+ if !proven && requireTyped{return nil,"",false}
+ if !proven {original,at=field.Value,stmt}
+ refs,originEdits:=healthStatsRefs(fs,tf,file,fn,original,rt)
+ if requireTyped && !hasFieldStatInput(original,refs,fs){return nil,"",false}
+ prefix:=fmt.Sprintf("gttHealthInput_%d",field.Pos())
+ expr:=fieldExpression{fset:fs,rt:rt,source:strconv.Quote(entry.SourceID),prefix:prefix,info:vectorInfoAlias(file),refs:refs,constants:sourceNamedConstants(file)}
+ value,err:=expr.emit(original,0);if err!=nil{return nil,"",false}
+ event:=prefix+"_event"
+ capture:=fmt.Sprintf("func()float64{if !%s.Enabled(){return %s};%s\n%s=%s.RecordNumericEval(%s,\"identity\",[]%s.NumericRef{%s},float64(%s),%s.IncompleteEvidence(\"health_input_branch_schedule_frozen\"));return float64(%s)}()",rt,rootText(fs,original),expr.code.String(),event,rt,strconv.Quote(entry.SourceID),traceImportAlias,value.ref,value.value,traceImportAlias,value.value)
+ edits:=append(originEdits,
+  textEdit{start:tf.Offset(at.Pos()),end:tf.Offset(at.Pos()),replacement:"var "+event+" string;\n"+indentationBefore(data,tf.Offset(at.Pos()))},
+  textEdit{start:tf.Offset(original.Pos()),end:tf.Offset(original.End()),replacement:capture})
+ return edits,event,true
+}
+
+func healthBonusCapture(fs *token.FileSet,tf *token.File,data []byte,file *ast.File,fn *ast.FuncDecl,lit *ast.CompositeLit,entry SourceEntry,rt string)([]textEdit,string){
+ if selectorFinalName(lit.Type)!="HealInfo"{return nil,""}
+ if field:=compositeKeyValue(lit,"Bonus");field!=nil {
+  edits,event,ok:=healthFieldCapture(fs,tf,data,file,fn,lit,field,entry,rt,false)
+  if ok{return edits,"GTTTraceBonusEventID:"+event+","}
+  return nil,""
+ }
+ // Omitted bonus is a literal zero, not the caller's Heal stat at heal time.
+ return nil,fmt.Sprintf("GTTTraceBonusEventID:%s.RecordNumericEval(%s,\"identity\",[]%s.NumericRef{%s.LiteralRef(0)},0,%s.IncompleteEvidence(\"health_input_branch_schedule_frozen\")),",rt,strconv.Quote(entry.SourceID),traceImportAlias,traceImportAlias,traceImportAlias)
+}
+
+func typedHealthInputEdits(fs *token.FileSet,tf *token.File,data []byte,file *ast.File,fn *ast.FuncDecl,lit *ast.CompositeLit,entry SourceEntry,rt string)([]textEdit,bool){
+ qual:=vectorInfoAlias(file)
+ if qual=="" || expressionQualifier(lit.Type)!=qual{return nil,false}
+ field:=compositeKeyValue(lit,entry.healthInput.ValueField);if field==nil{return nil,false}
+ edits,event,ok:=healthFieldCapture(fs,tf,data,file,fn,lit,field,entry,rt,true)
+ if !ok{return nil,false}
+ bonusEdits,bonusMetadata:=healthBonusCapture(fs,tf,data,file,fn,lit,entry,rt)
+ edits=append(edits,bonusEdits...)
+ metadata:=healthMetadataInsertion(data,tf,lit,entry,"nil")+"GTTTraceInputEventID:"+event+","+bonusMetadata
+ return append(edits,textEdit{start:tf.Offset(lit.Rbrace),end:tf.Offset(lit.Rbrace),replacement:metadata}),true
+}
