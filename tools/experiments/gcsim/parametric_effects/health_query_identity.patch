+package info
+import("testing";"github.com/genshinsim/gcsim/pkg/core/attributes";"github.com/genshinsim/gcsim/pkg/gtttrace")
+type healthStatsOwner struct {rt *gtttrace.Runtime; frame *int; calls int}
+func(c *healthStatsOwner)Index()int{return 2}
+func(c *healthStatsOwner)GTTTraceRuntime()*gtttrace.Runtime{return c.rt}
+func(c *healthStatsOwner)GTTStats()([attributes.EndStatType]float64,[]any,[]GTTTraceStatContribution){
+ c.calls++;*c.frame=9
+ var stats [attributes.EndStatType]float64;stats[attributes.Heal]=.2
+ return stats,[]any{"debug"},[]GTTTraceStatContribution{{Accepted:true,Extra:true,ModifierEvalEventID:"extra"}}
+}
+func TestGTTStatsHealthOriginKeepsGetterTimeAndSingleEvaluation(t *testing.T){
+ rt:=gtttrace.NewRuntime();rt.Enable();frame:=8;rt.BindFrame(&frame)
+ owner:=&healthStatsOwner{rt:rt,frame:&frame};fallbackCalls:=0
+ fallback:=func()([attributes.EndStatType]float64,[]any){fallbackCalls++;return [attributes.EndStatType]float64{},nil}
+ values,debug,origin:=GTTReadStats(rt,owner,fallback)
+ if owner.calls!=1||fallbackCalls!=0||origin==nil||values[attributes.Heal]!=.2||debug[0]!="debug"{t.Fatal("getter count/values changed")}
+ observations,complete:=rt.NeutralStatObservations()
+ if !complete||len(observations)!=1||observations[0].Frame!=8||observations[0].Owner!=2||observations[0].Mode!="stat"||observations[0].ExtraModifiers==nil||len(*observations[0].ExtraModifiers)!=1{t.Fatal("original full Stats query lost",observations)}
+ frame=44
+ GTTStatsCellRef(rt,origin,values,attributes.Heal,.2)
+ rows:=rt.StateEvents();last:=rows[len(rows)-1]
+ if last.Channel==nil||*last.Channel!="stat_input:stat"||last.NumericPayload[1].Value!=8||*last.OwnerIndex!=2{t.Fatal("later read replaced original query",last)}
+ values[attributes.Heal]=.3
+ GTTStatsCellRef(rt,origin,values,attributes.Heal,.3)
+ rows=rt.StateEvents();if *rows[len(rows)-1].Operation!="frozen_attack_operand"{t.Fatal("mutation was not rejected")}
+ _,_,foreign:=GTTReadStats(rt,struct{}{},fallback);if foreign!=nil||fallbackCalls!=1{t.Fatal("unknown owner inferred")}
+ _,_,disabled:=GTTReadStats(nil,owner,fallback);if disabled!=nil||owner.calls!=1||fallbackCalls!=2{t.Fatal("disabled getter changed")}
+}
