@@ -0,0 +1,1 @@
+package gttcompact
+import("testing";"github.com/genshinsim/gcsim/pkg/gtttrace")
+func TestSourceBonusUsesActualBindingNotCallerGuess(t *testing.T){
+ for _,mode:=range []string{"literal","foreign","missing"}{t.Run(mode,func(t *testing.T){
+  b:=&nodeBuilder{neutral:true,inputPoint:NeutralInputPoint{Mode:"stat",Frame:9,Order:12}}
+  id:="health";caller:=0;kind:=gtttrace.HealthHealTypeAbsolute;bonus:=.15;incoming:=0.0
+  op:=gtttrace.HealthOperation{OperationID:id,Kind:gtttrace.HealthOperationHeal,CallerIndex:&caller,TargetIndex:1,
+   HealType:&kind,SourceBonus:&bonus,HealBonusTotal:&incoming,InputValue:100,AdjustedInputValue:100,
+   MaxHPBefore:1000,MaxHPAfter:1000,HPBefore:0,HPAfter:115}
+  bindings:=map[string]compiledNode{}
+  if mode!="missing"{bindings["source_bonus"]=b.constant(.15)}
+  if mode=="foreign"{bindings["source_bonus"]=b.add(bindings["source_bonus"],b.artifactDelta("receiver","heal"))}
+  c:=supportCompiler{b:b,characterKeys:[]string{"caller","receiver"},unknown:map[string]struct{}{},
+   operationByID:map[string]gtttrace.HealthOperation{id:op},bindings:map[string]map[string]compiledNode{id:bindings},
+   previousHP:map[int]observedNode{},healthNodes:map[string]map[string]compiledNode{}}
+  c.compileHealthOperation(gtttrace.StateEvent{HealthOperationID:&id})
+  want:=115.0;if mode=="foreign"{want=135}
+  got:=evalContributorGraph(t,b,c.healthNodes[id]["raw_amount"],map[string]float64{"caller.healing_bonus":99,"receiver.healing_bonus":.2})
+  if got<want-1e-9||got>want+1e-9{t.Fatal(mode,got,want)}
+  _,unknown:=c.unknown["health_source_bonus_origin_unbound"]
+  if unknown!=(mode=="missing"){t.Fatal("missing origin must stay diagnosed",c.unknown)}
+  for _,port:=range b.neutralInputs{if port.Kind=="stat"&&port.Owner=="caller"{t.Fatal("invented caller stat",port)}}
+ })}
+}
