diff --git a/pkg/gtttrace/hit_identity.go b/pkg/gtttrace/hit_identity.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/hit_identity.go
@@ -0,0 +1,14 @@
+package gtttrace
+
+// NextHitID is trace-only, per core, and independent of observation ordering.
+// Allocate before OnEnemyHit is copied so event writes and the terminal formula
+// share one identity, including multiple targets or hits in the same frame.
+func (r *Runtime) NextHitID() uint64 {
+	if !r.Enabled() { return 0 }
+	r.nextHitID++
+	return r.nextHitID
+}
diff --git a/pkg/gtttrace/hit_identity_test.go b/pkg/gtttrace/hit_identity_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/hit_identity_test.go
@@ -0,0 +1,21 @@
+package gtttrace
+import "testing"
+func TestHitIdentityIsPerCoreAndTraceOnly(t *testing.T) {
+ var absent *Runtime
+ if absent.NextHitID()!=0 {t.Fatal("nil trace allocated an ID")}
+ a,b:=NewRuntime(),NewRuntime()
+ if a.NextHitID()!=0 {t.Fatal("disabled trace allocated an ID")}
+ a.Enable();b.Enable()
+ for i:=uint64(1);i<=100;i++ {if a.NextHitID()!=i {t.Fatal("nonunique hit ID")}}
+ if b.NextHitID()!=1 {t.Fatal("identity leaked across simulations")}
+ if a.NextObservationOrder()!=1 {t.Fatal("hit numbering changed event order")}
+}
