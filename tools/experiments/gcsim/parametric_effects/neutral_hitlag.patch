diff --git a/pkg/gtttrace/neutral_hitlag.go b/pkg/gtttrace/neutral_hitlag.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/neutral_hitlag.go
@@ -0,0 +1,27 @@
+package gtttrace
+
+// Observe the extension already computed by each central ApplyHitlag, even
+// when no modifier exists. Never calculate hitlag again or change gameplay.
+type NeutralHitlagEvent struct {
+	Order uint64 `json:"order"`
+	Frame int `json:"frame"`
+	Owner int `json:"owner"`
+	Target int `json:"target"`
+	Extension int `json:"extension"`
+}
+type NeutralHitlagLedger struct {
+	Complete bool `json:"complete"`
+	Events []NeutralHitlagEvent `json:"events"`
+}
+func (r *Runtime) RecordNeutralHitlag(owner, target, extension int) {
+	if !r.Enabled() { return }
+	if len(r.neutralHitlag) >= maxCombatEventRows { r.neutralHitlagTruncated = true; return }
+	r.neutralHitlag = append(r.neutralHitlag, NeutralHitlagEvent{r.NextNeutralObservationOrder(), r.Frame(), owner, target, extension})
+}
+func (r *Runtime) NeutralHitlag() NeutralHitlagLedger {
+	out := NeutralHitlagLedger{Events: []NeutralHitlagEvent{}}
+	if !r.Enabled() { return out }
+	out.Complete = !r.neutralHitlagTruncated
+	out.Events = append(out.Events, r.neutralHitlag...)
+	return out
+}
