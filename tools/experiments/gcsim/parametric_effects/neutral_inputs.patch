diff --git a/pkg/gttcompact/neutral_inputs.go b/pkg/gttcompact/neutral_inputs.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttcompact/neutral_inputs.go
@@ -0,0 +1,112 @@
+package gttcompact
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+
+// These ports supplement RAW artifact leaves, never old-set replacement. All
+// producers are bound to a no-set capture. Missing query/branch coverage remains
+// explicit; ports preserve zero-valued future inputs before consumer reduction.
+type NeutralInputPoint struct {
+	Frame int `json:"frame"`
+	Order uint64 `json:"order"`
+	HitFrame int `json:"hit_frame"`
+	HitOrder uint64 `json:"hit_order"`
+	HitID uint64 `json:"hit_id"`
+	TargetKey int `json:"target_key"`
+	EventID string `json:"event_id,omitempty"`
+	Mode string `json:"mode"`
+	AttackTag string `json:"attack_tag,omitempty"`
+	Element string `json:"element,omitempty"`
+}
+type NeutralStatInput struct {
+	NodeID uint32 `json:"node_id"`
+	Kind string `json:"kind"`
+	Owner string `json:"owner"`
+	Stat string `json:"stat"`
+	Point NeutralInputPoint `json:"point"`
+}
+type NeutralStatePoint struct {
+	Order uint64 `json:"order"`
+	Frame int `json:"frame"`
+	Kind string `json:"kind"`
+	Owner int `json:"owner"`
+	Key string `json:"key"`
+	Expiry *int `json:"expiry,omitempty"`
+}
+type NeutralHitPoint struct {
+	HitID uint64 `json:"hit_id"`
+	Actor int `json:"actor"`
+	Point NeutralInputPoint `json:"point"`
+}
+type NeutralInputs struct {
+	SchemaVersion int `json:"schema_version"`
+	Context optstats.GTTNeutralContext `json:"context"`
+	Ledger gtttrace.CombatEventLedger `json:"ledger"`
+	States []NeutralStatePoint `json:"states"`
+	Stats []NeutralStatInput `json:"stats"`
+	Hits []NeutralHitPoint `json:"hits"`
+	Uncertainty []string `json:"uncertainty"`
+}
+func neutralEventPoint(e gtttrace.StateEvent) NeutralInputPoint {
+	p := NeutralInputPoint{Frame: e.Frame, Order: e.ObservationOrder, EventID: e.EventID, Mode: "unresolved"}
+	if e.Channel != nil && strings.HasPrefix(*e.Channel, "stat_input:") { p.Mode = strings.TrimPrefix(*e.Channel, "stat_input:") }
+	if e.Kind == gtttrace.StateEventMaxHPRead { p.Mode = "stat" }
+	for _, f := range e.NumericPayload {
+		switch f.Key {
+		case "stat_query_frame": p.Frame = int(f.Value)
+		case "stat_query_order": p.Order = uint64(f.Value)
+		}
+	}
+	return p
+}
+func neutralHitPoint(h info.GTTTraceHit) NeutralInputPoint {
+	return NeutralInputPoint{Frame: h.SnapshotFrame, Order: h.SnapshotOrder,
+		HitFrame: h.Frame, HitOrder: h.HitOrder, HitID: h.HitID, TargetKey: h.TargetKey,
+		Mode: "snapshot", AttackTag: "tag/" + strconv.Itoa(h.AttackTag), Element: h.Element}
+}
+func (b *nodeBuilder) withNeutralStatInputs(raw compiledNode, owner, stat string) compiledNode {
+	add := func(kind string, point NeutralInputPoint) compiledNode {
+		n := b.constant(0)
+		b.neutralInputs = append(b.neutralInputs, NeutralStatInput{NodeID: n.id, Kind: kind, Owner: owner, Stat: stat, Point: point})
+		return n
+	}
+	p := b.inputPoint
+	if p.Mode == "" { p.Mode = "unresolved" }
+	node := b.add(raw, add("stat", p))
+	if p.Mode == "snapshot" {
+		p.Frame, p.Order = p.HitFrame, p.HitOrder
+		node = b.add(node, add("attack", p))
+	}
+	return node
+}
+func (b *nodeBuilder) collectNeutralInputs(buffer optstats.GTTTraceEquationBuffer, channels []IRChannel) *NeutralInputs {
+	if !b.neutral { return nil }
+	out := &NeutralInputs{SchemaVersion: 1, Context: buffer.NeutralContext, Ledger: buffer.CombatEvents,
+		States: []NeutralStatePoint{}, Stats: []NeutralStatInput{}, Hits: []NeutralHitPoint{},
+		Uncertainty: []string{"event_state_schedule_observed_not_counterfactual", "unresolved_query_modes_require_effect_coverage"}}
+	live := make([]bool, len(b.nodes)+1)
+	stack := []uint32{}
+	for _, ch := range channels { stack = append(stack, ch.RootNodeID) }
+	for len(stack) != 0 {
+		id := stack[len(stack)-1]; stack = stack[:len(stack)-1]
+		if id == 0 || int(id) > len(b.nodes) || live[id] { continue }
+		live[id] = true
+		for _, in := range b.nodes[id-1].Inputs { stack = append(stack, in.NodeID) }
+	}
+	for _, p := range b.neutralInputs { if live[p.NodeID] { out.Stats = append(out.Stats, p) } }
+	for _, e := range buffer.StateEvents {
+		if e.OwnerIndex == nil || e.Key == nil { continue }
+		switch e.Kind {
+		case gtttrace.StateEventStatusAdd, gtttrace.StateEventStatusDelete:
+			out.States = append(out.States, NeutralStatePoint{e.ObservationOrder, e.Frame, e.Kind, *e.OwnerIndex, *e.Key, e.ExpiryFrame})
+		}
+	}
+	for _, h := range buffer.Hits { out.Hits = append(out.Hits, NeutralHitPoint{h.HitID, h.ActorIndex, neutralHitPoint(h)}) }
+	return out
+}
