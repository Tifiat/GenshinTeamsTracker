+++ b/pkg/gttcompact/neutral_inputs_test.go
@@ -0,0 +1,32 @@
+package gttcompact
+
+import (
+	"testing"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+func TestNeutralPortsKeepZeroIdentityAndQueryPoint(t *testing.T) {
+	b := &nodeBuilder{neutral: true, inputPoint: NeutralInputPoint{Frame: 17, Order: 31, Mode: "non_extra_stat", EventID: "saved"}}
+	a := b.artifactDelta("owner", "em")
+	z := b.artifactDelta("owner", "em")
+	if a.id == z.id || len(b.neutralInputs) != 2 || b.neutralInputs[0].NodeID == b.neutralInputs[1].NodeID ||
+		b.neutralInputs[0].Point.Mode != "non_extra_stat" || b.neutralInputs[0].Point.Order != 31 {
+		t.Fatal("equal zero ports were merged or query identity lost", b.neutralInputs)
+	}
+	b.neutral = false
+	b.artifactDelta("owner", "em")
+	if len(b.neutralInputs) != 2 { t.Fatal("non-neutral capture gained replacement ports") }
+}
+func TestNeutralSnapshotAndAttackInputsHaveDifferentTimes(t *testing.T) {
+	b := &nodeBuilder{neutral: true, inputPoint: NeutralInputPoint{Mode: "snapshot", Frame: 5, Order: 10, HitFrame: 12, HitOrder: 30}}
+	b.artifactDelta("owner", "cr")
+	if len(b.neutralInputs) != 2 || b.neutralInputs[0].Kind != "stat" ||
+		b.neutralInputs[0].Point.Order != 10 || b.neutralInputs[1].Kind != "attack" || b.neutralInputs[1].Point.Order != 30 {
+		t.Fatal("saved snapshot and per-hit bonus share one time", b.neutralInputs)
+	}
+}
+func TestNeutralQueryUsesOriginalObservationOrder(t *testing.T) {
+	channel := "stat_input:non_extra_stat"
+	point := neutralEventPoint(gtttrace.StateEvent{Frame: 50, ObservationOrder: 90, Channel: &channel,
+		NumericPayload: []gtttrace.NumericPayload{{Key: "stat_query_frame", Value: 3}, {Key: "stat_query_order", Value: 7}}})
+	if point.Frame != 3 || point.Order != 7 || point.Mode != "non_extra_stat" { t.Fatal(point) }
+}
