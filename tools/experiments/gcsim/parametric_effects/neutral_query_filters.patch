+// Original getter query retained by value, before any modifier Amount executes.
+func GTTStatsOriginAtQuery(rt *gtttrace.Runtime, owner int, values attributes.Stats, ids []string, query gtttrace.StatQueryContext) *GTTStatsOrigin {
+	if !rt.Enabled() { return nil }
