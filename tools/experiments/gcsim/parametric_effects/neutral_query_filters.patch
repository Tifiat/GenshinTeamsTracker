+func TestParametricQueryStartsBeforeAmountAndRetainsSelectedKeys(t *testing.T) {
+	frame := 17
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	r.BindFrame(&frame)
+	c := &CharWrapper{index: 0, f: &frame, gttTrace: r}
+	c.BaseStats[attributes.EM] = 100
+	calls := 0
+	m := &StatMod{Base: modifier.NewBase("mutating-query-test", -1), AffectedStat: attributes.EM,
+		Amount: func() []float64 { calls++; frame++; v := make([]float64, attributes.EndStatType); v[attributes.EM] = 1; return v }}
+	m.SetExpiry(frame)
+	c.mods = append(c.mods, m)
+	value, _ := c.GTTStat(attributes.EM)
+	rows := r.StateEvents()
+	row := rows[len(rows)-1]
+	queryFrame := -1
+	for _, p := range row.NumericPayload { if p.Key == "stat_query_frame" { queryFrame = int(p.Value) } }
+	if value != 101 || calls != 1 || queryFrame != 17 || row.Frame != 18 || row.NeutralStatKeys == nil || len(*row.NeutralStatKeys) != 1 || (*row.NeutralStatKeys)[0] != "em" { t.Fatal(value, calls, queryFrame, row) }
+}
