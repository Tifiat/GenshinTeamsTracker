+// Selected queries differ from a full snapshot even if their output numbers
+// coincide: AffectedStat controls which modifier closures are evaluated.
+func (r *Runtime) NewSelectedStatQuery(nonExtra bool, keys []string) StatQueryContext {
+	q := r.NewStatQuery(nonExtra)
+	copy := append([]string{}, keys...)
+	q.selectedKeys = &copy
+	return q
+}
+func (q StatQueryContext) annotate(row *StateEvent) {
+	if q.id == 0 { return }
+	row.NeutralStatKeys = q.selectedKeys
+	payload := func(key string, value float64) NumericPayload {
+		return NumericPayload{Key: key, Value: value, Reference: LiteralRef(value)}
+	}
+	row.NumericPayload = append(row.NumericPayload,
+		payload("stat_query_id", float64(q.id)), payload("stat_query_frame", float64(q.frame)),
+		payload("stat_query_sequence", float64(q.sequence)), payload("stat_query_order", float64(q.order)))
-	})
 }
