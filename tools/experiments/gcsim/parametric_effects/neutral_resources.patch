diff --git a/pkg/gtttrace/neutral_resources_test.go b/pkg/gtttrace/neutral_resources_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/neutral_resources_test.go
@@ -0,0 +1,15 @@
+package gtttrace
+import "testing"
+func TestNeutralResourceSnapshotsDoNotAlias(t *testing.T){
+ r:=NewRuntime();r.Enable();r.BindNeutralWorld(func()[]NeutralModifierIdentity{return []NeutralModifierIdentity{}})
+ facts:=EventValue{Kind:"object",Fields:map[string]EventValue{"Energy":{Kind:"number",Number:15}}}
+ r.BindNeutralResources(func()EventValue{return facts})
+ r.NextNeutralObservationOrder();r.NextNeutralObservationOrder()
+ facts.Fields["Energy"]=EventValue{Kind:"number",Number:0};r.NextNeutralObservationOrder()
+ rows:=r.NeutralWorld().States
+ if len(rows)!=2 || rows[0].Facts.Fields["Energy"].Number!=15 || rows[1].Facts.Fields["Energy"].Number!=0 {t.Fatal(rows)}
+ rows[0].Facts.Fields["Energy"]=EventValue{Kind:"number",Number:999}
+ if r.NeutralWorld().States[0].Facts.Fields["Energy"].Number!=15{t.Fatal("export aliases stored facts")}
+}
