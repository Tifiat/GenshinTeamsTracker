+package info_test
+import (
+ "testing"
+ "github.com/genshinsim/gcsim/pkg/core/info"
+ "github.com/genshinsim/gcsim/pkg/core/attributes"
+ "github.com/genshinsim/gcsim/pkg/core/player/shield"
+)
+func TestNeutralShieldAndHitPayload(t *testing.T){
+ s:=&shield.Tmpl{ShieldType:shield.IneffaSkill,Expires:123,Ele:attributes.Electro}
+ value:=info.GTTCombatEventValues([]any{s})[0]
+ if value.Kind!="observation" || value.Fields["Type"].Number!=float64(shield.IneffaSkill) || value.Fields["Expiry"].Number!=123 {t.Fatal(value)}
+ s.Expires=0
+ if value.Fields["Expiry"].Number!=123{t.Fatal("shield snapshot is live")}
+ attack:=&info.AttackEvent{GTTTraceHit:&info.GTTTraceHit{HitID:7}}
+ value=info.GTTCombatEventValues([]any{attack})[0]
+ if value.Fields["HitID"].Number!=7{t.Fatal("hit identity lost",value)}
+}
