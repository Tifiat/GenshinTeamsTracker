new file mode 100644
--- /dev/null
+++ b/pkg/core/gtt_neutral_resources.go
@@ -0,0 +1,45 @@
+package core
+
+// Pure resource identities, positions and existing scalar fields. No stat
+// getter, modifier Amount, callback, random draw or gameplay mutation.
+import (
+ "github.com/genshinsim/gcsim/pkg/core/construct"
+ "github.com/genshinsim/gcsim/pkg/core/info"
+ "github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+func (c *Core) gttNeutralResources() gtttrace.EventValue {
+ encode:=func(value any)gtttrace.EventValue{return info.GTTCombatEventValues([]any{value})[0]}
+ chars:=[]gtttrace.EventValue{}
+ for _,char:=range c.Player.Chars(){chars=append(chars,gtttrace.EventValue{Kind:"object",Fields:map[string]gtttrace.EventValue{"Energy":encode(char.Energy),"EnergyMax":encode(char.EnergyMax)}})}
+ shields:=[]gtttrace.EventValue{}
+ for _,s:=range c.Player.Shields.List(){shields=append(shields,encode(s))}
+ objects:=[]gtttrace.EventValue{}
+ // ConstructsByType returns both limited and unlimited lists, partitioned.
+ yes,no:=c.Constructs.ConstructsByType(construct.GeoConstructInvalid)
+ for _,s:=range append(yes,no...){objects=append(objects,gtttrace.EventValue{Kind:"observation",Type:"github.com/genshinsim/gcsim/pkg/core/construct.Construct",Fields:map[string]gtttrace.EventValue{"Type":encode(s.Type()),"Expiry":encode(s.Expiry()),"Pos":gttNeutralPosition(s.Pos())}})}
+ position:=gtttrace.EventValue{Kind:"unknown",Text:"player_not_initialized"}
+ if player:=c.Combat.Player();player!=nil {position=gttNeutralPosition(player.Pos())}
+ return gtttrace.EventValue{Kind:"object",Fields:map[string]gtttrace.EventValue{
+  "Characters":{Kind:"array",Items:chars},"Shields":{Kind:"array",Items:shields},"Constructs":{Kind:"array",Items:objects},
+  "Statuses":encode(c.Status.GTTNeutralExpiries()),"Custom":encode(c.Flags.Custom),"IgnoreBurstEnergy":encode(c.Flags.IgnoreBurstEnergy),"Position":position,
+ }}
+}
+func gttNeutralPosition(p info.Point)gtttrace.EventValue{return gtttrace.EventValue{Kind:"observation",Type:"github.com/genshinsim/gcsim/pkg/core/info.Point",Fields:map[string]gtttrace.EventValue{"X":{Kind:"number",Number:p.X},"Y":{Kind:"number",Number:p.Y}}}}
