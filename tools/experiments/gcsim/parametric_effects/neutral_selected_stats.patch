diff --git a/pkg/gttsourcegen/neutral_selected_test.go b/pkg/gttsourcegen/neutral_selected_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gttsourcegen/neutral_selected_test.go
@@ -0,0 +1,50 @@
+package gttsourcegen
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"strings"
+	"testing"
+)
+
+func TestNeutralSelectedStatsExpression(t *testing.T) {
+	base := `package x
+import(info "github.com/genshinsim/gcsim/pkg/core/info";a "github.com/genshinsim/gcsim/pkg/core/attributes")
+func(q *provider)tick(){
+ stats:=q.SelectStat(true,a.BaseATK,a.ATKP,a.ATK)
+ // CHANGE
+ q.bank[a.EM]=stats.TotalATK()*.06
+}`
+	for _, tc := range []struct{name, change string; supported bool}{
+		{"direct total", "", true},
+		{"mutation", "stats[a.ATKP]=1", false},
+		{"escape", "observe(&stats)", false},
+		{"alias", "other:=stats;_ = other", false},
+		{"reassign", "stats=q.SelectStat(false,a.ATKP)", false},
+	} {
+		t.Run(tc.name, func(t *testing.T){
+			src:=strings.Replace(base,"// CHANGE",tc.change,1)
+			fs:=token.NewFileSet()
+			file,err:=parser.ParseFile(fs,"test.go",src,0)
+			if err!=nil{t.Fatal(err)}
+			fn:=file.Decls[1].(*ast.FuncDecl)
+			write:=fn.Body.List[len(fn.Body.List)-1].(*ast.AssignStmt)
+			refs,totals,edits:=selectedStatsBindings(fs,fs.File(file.Pos()),file,write.Pos(),"q.Core.GTTTrace",write.Rhs[0])
+			if (len(totals)>0)!=tc.supported{t.Fatalf("bindings=%v",totals)}
+			if !tc.supported{return}
+			expr:=fieldExpression{fset:fs,rt:"q.Core.GTTTrace",source:`"test"`,prefix:"probe",info:"info",refs:refs,selectedTotals:totals}
+			v,err:=expr.emit(write.Rhs[0],0)
+			if err!=nil{t.Fatal(err)}
+			edits=append(edits,textEdit{start:fs.File(file.Pos()).Offset(write.Pos()),end:fs.File(file.Pos()).Offset(write.End()),replacement:expr.code.String()+";q.bank[a.EM]="+v.value})
+			out,err:=applyTextEdits([]byte(src),edits)
+			if err!=nil{t.Fatal(err)}
+			if _,err=parser.ParseFile(token.NewFileSet(),"out.go",out,0);err!=nil{t.Fatal(err,string(out))}
+			for _,token:=range []string{"GTTSelectStats", "GTTStatsTotalRef", "stats.TotalATK()", "q.SelectStat("}{
+				if strings.Count(string(out),token)!=1{t.Fatalf("not single eval %s: %s",token,out)}
+			}
+			if !strings.Contains(string(out),"q,true,[]a.Stat"){t.Fatal("lost receiver/filter",string(out))}
+			if strings.Contains(string(out),"frozen_attack_operand"){t.Fatal("selected total frozen",string(out))}
+		})
+	}
+}
