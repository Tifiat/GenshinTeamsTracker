new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/neutral_stat_reads.go
@@ -0,0 +1,34 @@
+package gtttrace
+
+// Already-computed stat vectors, never a new Amount/getter evaluation. These
+// latent inputs may become damage-relevant after changing an artifact bonus.
+type NeutralStatObservation struct {
+	Owner int
+	Order uint64
+	Frame int
+	Mode string
+	Keys *[]string
+	Values map[string]float64
+	Modifiers []string
+	ExtraModifiers *[]string
+}
+func (r *Runtime) RecordNeutralStatVector(owner int, values map[string]float64, modifiers []string, q StatQueryContext, extra ...[]string) {
+	if !r.Enabled() || q.runtime!=r || q.id==0 || owner<0 { return }
+	if len(r.neutralStatObservations)>=20000 { r.neutralStatObservationsTruncated=true;return }
+	mode:="stat";if q.nonExtra {mode="non_extra_stat"}
+	copied:=make(map[string]float64,len(values))
+	for key,value:=range values {
+		if !finite(value) {r.neutralStatObservationsTruncated=true;return}
+		copied[key]=value
+	}
+	row:=NeutralStatObservation{Owner:owner,Order:q.order,Frame:q.frame,Mode:mode,Keys:q.selectedKeys,Values:copied,Modifiers:append([]string{},modifiers...)}
+	if len(extra)==1 {ids:=append([]string{},extra[0]...);row.ExtraModifiers=&ids}
+	r.neutralStatObservations=append(r.neutralStatObservations,row)
+}
+func (r *Runtime) NeutralStatObservations() ([]NeutralStatObservation,bool) {
+	return append([]NeutralStatObservation{},r.neutralStatObservations...),!r.neutralStatObservationsTruncated
+}
+func (q StatQueryContext) SelectedKeys() *[]string {
+	if q.selectedKeys==nil{return nil}
+	keys:=append([]string{},(*q.selectedKeys)...);return &keys
+}
