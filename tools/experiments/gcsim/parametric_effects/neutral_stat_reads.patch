@@ -0,0 +1,21 @@
+package info
+
+import (
+	"testing"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+func TestNeutralLatentStatVectorsKeepOriginalValuesAndFilters(t *testing.T){
+	r:=gtttrace.NewRuntime();r.Enable()
+	frame:=5;r.BindFrame(&frame)
+	stats:=attributes.Stats{};stats[attributes.ER]=1.2;stats[attributes.EM]=50
+	q:=r.NewStatQuery(false)
+	GTTNewStatsOrigin(r,2,stats,[]GTTTraceStatContribution{{Accepted:true,Extra:true,ModifierEvalEventID:"extra"}},q)
+	stats[attributes.ER]=9
+	frame=8
+	q=GTTNewSelectedStatQuery(r,true,attributes.EM)
+	GTTStatsOriginAtQuery(r,1,stats,nil,q)
+	rows,complete:=r.NeutralStatObservations()
+	if !complete||len(rows)!=2||rows[0].Owner!=2||rows[0].Frame!=5||rows[0].Values["er"]!=1.2||rows[0].ExtraModifiers==nil||len(*rows[0].ExtraModifiers)!=1 {t.Fatal(rows)}
+	if rows[1].Mode!="non_extra_stat"||len(rows[1].Values)!=1||rows[1].Values["em"]!=50||rows[1].Keys==nil||len(*rows[1].Keys)!=1 {t.Fatal(rows[1])}
+}
