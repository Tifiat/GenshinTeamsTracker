+package gttcompact
+
+import (
+	"testing"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/optimization/optstats"
+)
+func TestNeutralLatentReadExcludesDirectSetInputAndProjectsExtra(t *testing.T){
+	extra:=[]string{"extra"}
+	b:=&nodeBuilder{neutral:true}
+	c:=&supportCompiler{b:b,characterKeys:[]string{"owner"},eventByID:map[string]gtttrace.StateEvent{"extra":{Output:map[string]float64{"er":.2}}},eventOutputs:map[string]map[string]compiledNode{"extra":{"er":b.constant(.2)}},buffer:optstats.GTTTraceEquationBuffer{NeutralStatObservations:[]gtttrace.NeutralStatObservation{{Owner:0,Order:4,Frame:3,Mode:"stat",Values:map[string]float64{"er":1.2},Modifiers:[]string{"extra"},ExtraModifiers:&extra}}}}
+	c.compileNeutralStatReads()
+	if len(b.neutralReads)!=2||len(b.neutralInputs)!=0 {t.Fatal(b.neutralReads,b.neutralInputs)}
+	if b.neutralReads[0].Observed!="1.2"||b.neutralReads[0].Projection||b.neutralReads[1].Observed!="1"||!b.neutralReads[1].Projection||b.neutralReads[1].Point.Mode!="non_extra_stat"{t.Fatal(b.neutralReads)}
+	for _,r:=range b.neutralReads{if r.NodeID==0||r.Owner!="owner"||r.Stat!="er"||r.Point.Order!=4||len(r.Uncertainty)!=0{t.Fatal(r)}}
+}
