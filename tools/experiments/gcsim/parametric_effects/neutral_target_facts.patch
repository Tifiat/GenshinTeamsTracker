diff --git a/pkg/core/gtt_neutral_targets.go b/pkg/core/gtt_neutral_targets.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/gtt_neutral_targets.go
@@ -0,0 +1,32 @@
+package core
+
+// Pure target identity/interface/aura observation. It never evaluates stats,
+// modifier Amounts or callbacks. The aura implementation remains engine-owned.
+import (
+ "github.com/genshinsim/gcsim/pkg/core/attributes"
+ "github.com/genshinsim/gcsim/pkg/core/info"
+ "github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func (c *Core) gttNeutralTargets() []gtttrace.EventValue {
+ out:=[]gtttrace.EventValue{}
+ for _, target:=range c.Combat.Enemies() {
+  value:=info.GTTCombatEventValues([]any{target})[0]
+  reactable, hasReactable:=target.(Reactable)
+  _, hasAuraTarget:=target.(info.TargetWithAura)
+  value.Fields["Interfaces"]=gtttrace.EventValue{Kind:"map",Fields:map[string]gtttrace.EventValue{
+   "github.com/genshinsim/gcsim/pkg/core/info.Target":{Kind:"bool",Boolean:true},
+   "github.com/genshinsim/gcsim/pkg/core/info.TargetWithAura":{Kind:"bool",Boolean:hasAuraTarget},
+   "github.com/genshinsim/gcsim/pkg/core.Reactable":{Kind:"bool",Boolean:hasReactable},
+  }}
+  if hasReactable {
+   auras:=make([]gtttrace.EventValue,attributes.EndEleType)
+   for ele:=attributes.Element(0);ele<attributes.EndEleType;ele++ {
+    auras[ele]=gtttrace.EventValue{Kind:"bool",Boolean:reactable.AuraContains(ele)}
+   }
+   value.Fields["Auras"]=gtttrace.EventValue{Kind:"array",Items:auras}
+  }
+  out=append(out,value)
+ }
+ return out
+}
