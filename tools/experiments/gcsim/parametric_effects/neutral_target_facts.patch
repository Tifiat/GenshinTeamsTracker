+ r.NextNeutralObservationOrder();r.NextNeutralObservationOrder()
+ target.Fields["Auras"].Items[0].Boolean=true;r.NextNeutralObservationOrder()
+ out:=r.NeutralWorld()
+ if len(out.States)!=2 || out.States[0].Targets[0].Fields["Auras"].Items[0].Boolean || !out.States[1].Targets[0].Fields["Auras"].Items[0].Boolean {t.Fatal(out)}
+ out.States[1].Targets[0].Fields["Auras"].Items[0].Boolean=false
+ if !r.NeutralWorld().States[1].Targets[0].Fields["Auras"].Items[0].Boolean {t.Fatal("target export aliases live facts")}
+}
