diff --git a/pkg/gtttrace/neutral_world.go b/pkg/gtttrace/neutral_world.go
new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/neutral_world.go
@@ -0,0 +1,51 @@
+package gtttrace
+
+import "sort"
+
+// Pure identity/expiry snapshots. Never evaluate a modifier Amount or stat
+// getter. Intern unchanged world states so many formula reads share one row.
+type NeutralModifierIdentity struct {
+ Owner int `json:"owner"`
+ Key string `json:"key"`
+ Expiry int `json:"expiry"`
+}
+type NeutralWorldState struct {
+ Order uint64 `json:"order"`
+ Frame int `json:"frame"`
+ Active int `json:"active"`
+ Modifiers []NeutralModifierIdentity `json:"modifiers"`
+}
+type NeutralWorldLedger struct {
+ Complete bool `json:"complete"`
+ States []NeutralWorldState `json:"states"`
+}
+func (r *Runtime) BindNeutralWorld(read func() []NeutralModifierIdentity) {
+ if r != nil { r.neutralWorldReader = read }
+}
+func (r *Runtime) NextNeutralObservationOrder() uint64 {
+ order := r.NextObservationOrder()
+ if order == 0 || r.neutralWorldReader == nil { return order }
+ mods := r.neutralWorldReader()
+ sort.Slice(mods, func(i,j int) bool { if mods[i].Owner != mods[j].Owner { return mods[i].Owner < mods[j].Owner }; return mods[i].Key < mods[j].Key })
+ active := -1
+ if r.combatActive != nil { active = r.combatActive() }
+ if len(r.neutralWorldStates) > 0 {
+  previous := r.neutralWorldStates[len(r.neutralWorldStates)-1]
+  equal := previous.Active == active && len(previous.Modifiers) == len(mods)
+  if equal { for i, m := range mods { if previous.Modifiers[i] != m { equal = false; break } } }
+  if equal { return order }
+ }
+ if len(r.neutralWorldStates) >= maxCombatEventRows { r.neutralWorldTruncated = true; return order }
+ r.neutralWorldStates = append(r.neutralWorldStates, NeutralWorldState{order,r.Frame(),active,append([]NeutralModifierIdentity{},mods...)})
+ return order
+}
+func (r *Runtime) NeutralWorld() NeutralWorldLedger {
+ out := NeutralWorldLedger{States: []NeutralWorldState{}}
+ if r == nil { return out }
+ out.Complete = r.Enabled() && r.neutralWorldReader != nil && !r.neutralWorldTruncated
+ for _, row := range r.neutralWorldStates {
+  row.Modifiers = append([]NeutralModifierIdentity{},row.Modifiers...)
+  out.States = append(out.States,row)
+ }
+ return out
+}
diff --git a/pkg/core/player/character/gtt_neutral_world.go b/pkg/core/player/character/gtt_neutral_world.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/player/character/gtt_neutral_world.go
@@ -0,0 +1,11 @@
+package character
+
+import "github.com/genshinsim/gcsim/pkg/gtttrace"
+
+// Includes the shared modifier list, not only Status. Expired entries are kept:
+// FindCheckExpiry and actual amount evaluation have distinct boundary rules.
+func (c *CharWrapper) GTTNeutralModifierIdentities() []gtttrace.NeutralModifierIdentity {
+ out := make([]gtttrace.NeutralModifierIdentity,0,len(c.mods))
+ for _, m := range c.mods { out = append(out,gtttrace.NeutralModifierIdentity{Owner:c.Index(),Key:m.Key(),Expiry:m.Expiry()}) }
+ return out
+}
