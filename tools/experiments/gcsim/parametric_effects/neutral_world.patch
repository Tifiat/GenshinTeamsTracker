new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/neutral_world_test.go
@@ -0,0 +1,17 @@
+package gtttrace
+
+import "testing"
+
+func TestNeutralWorldKeepsExpiryRefreshAndInternsStableState(t *testing.T) {
+ r:=NewRuntime(); r.Enable(); frame,active:=3,0; r.BindFrame(&frame);r.BindActiveIndex(func()int{return active})
+ mods:=[]NeutralModifierIdentity{{Owner:1,Key:"shared",Expiry:30}}
+ calls:=0;r.BindNeutralWorld(func()[]NeutralModifierIdentity{calls++;return append([]NeutralModifierIdentity(nil),mods...)})
+ first:=r.NextNeutralObservationOrder();frame=4;r.NextNeutralObservationOrder()
+ mods[0].Expiry=35;r.NextNeutralObservationOrder();active=1;r.NextNeutralObservationOrder()
+ out:=r.NeutralWorld()
+ if !out.Complete || len(out.States)!=3 || out.States[0].Order!=first || out.States[0].Modifiers[0].Expiry!=30 || out.States[1].Modifiers[0].Expiry!=35 || calls!=4 {t.Fatal(out,calls)}
+ out.States[0].Modifiers[0].Expiry=-1
+ if r.NeutralWorld().States[0].Modifiers[0].Expiry!=30 {t.Fatal("mutable world export")}
+ var disabled *Runtime
+ if disabled.NextNeutralObservationOrder()!=0 || disabled.NeutralWorld().Complete {t.Fatal("disabled evidence")}
+}
