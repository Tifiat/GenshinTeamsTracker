+package info
+
+import (
+	"testing"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+)
+
+func TestParametricSnapshotQueryKeepsOriginalFilterAndTime(t *testing.T) {
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	frame := 8
+	r.BindFrame(&frame)
+	var values attributes.Stats
+	values[attributes.BaseDEF], values[attributes.DEFP], values[attributes.DEF] = 100, .2, 10
+	origin := GTTStatsOriginFromModifiers(r, 2, values, nil, true)
+	frame = 44
+	ref := GTTStatsTotalRef(r, origin, values, attributes.BaseDEF, attributes.DEFP, attributes.DEF, 130)
+	if ref.EventID == nil {
+		t.Fatal("missing total ref")
+	}
+	reads := 0
+	for _, row := range r.StateEvents() {
+		if row.Operation == nil || *row.Operation != "artifact_stat_read" {
+			continue
+		}
+		reads++
+		if *row.Channel != "stat_input:non_extra_stat" || row.NumericPayload[1].Value != 8 || *row.OwnerIndex != 2 {
+			t.Fatal("saved getter became an ordinary/later getter", row)
+		}
+	}
+	if reads != 2 {
+		t.Fatal("flat/percent lineage missing", reads)
+	}
+}
