+package character
+
+import (
+	"testing"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/gtttrace"
+	"github.com/genshinsim/gcsim/pkg/modifier"
+)
+
+func TestParametricGetterFilterDoesNotReevaluateModifiers(t *testing.T) {
+	frame := 17
+	r := gtttrace.NewRuntime()
+	r.Enable()
+	r.BindFrame(&frame)
+	c := &CharWrapper{index: 1, f: &frame, gttTrace: r}
+	c.BaseStats[attributes.EM] = 100
+	calls := 0
+	extra := &StatMod{Base: modifier.NewBase("query-test-extra", -1), AffectedStat: attributes.EM, Extra: true,
+		Amount: func() []float64 {
+			calls++
+			v := make([]float64, attributes.EndStatType)
+			v[attributes.EM] = 25
+			return v
+		}}
+	extra.SetExpiry(frame)
+	c.mods = append(c.mods, extra)
+	for _, filtered := range []bool{true, false} {
+		var got float64
+		if filtered {
+			got, _ = c.GTTNonExtraStat(attributes.EM)
+		} else {
+			got, _ = c.GTTStat(attributes.EM)
+		}
+		rows := r.StateEvents()
+		row := rows[len(rows)-1]
+		mode, want := "stat_input:stat", 125.0
+		if filtered {
+			mode, want = "stat_input:non_extra_stat", 100
+		}
+		if got != want || row.Channel == nil || *row.Channel != mode {
+			t.Fatal(got, want, row)
+		}
+	}
+	if calls != 1 {
+		t.Fatal("observer changed gameplay evaluation count", calls)
+	}
+}
