+func GTTSelectStats(rt *gtttrace.Runtime, owner any, nonExtra bool, keys []attributes.Stat, fallback func() attributes.Stats) (attributes.Stats, *GTTStatsOrigin) {
+	if c, ok := owner.(interface {
+		Index() int
+		GTTSelectStat(bool, ...attributes.Stat) (attributes.Stats, []string)
+	}); ok {
+		value, ids := c.GTTSelectStat(nonExtra, keys...)
+		if !rt.Enabled() {
+			return value, nil
+		}
+		return value, GTTStatsOriginFromModifiers(rt, c.Index(), value, ids, nonExtra)
+	}
+	return fallback(), nil
+}
+
+// Central stat-container arithmetic, not character/weapon mechanics. This is
+// the same base*(1+percent)+flat contract already used by MaxHP/direct scaling.
+// It consumes the saved filtered getter outputs, never a later ordinary Stat.
+func GTTStatsTotalRef(rt *gtttrace.Runtime, origin *GTTStatsOrigin, stats attributes.Stats, base, percent, flat attributes.Stat, observed float64) gtttrace.NumericRef {
+	freeze := func() gtttrace.NumericRef {
+		return gtttrace.EventRef(rt.RecordNumericEval("", "frozen_attack_operand", nil, observed, gtttrace.IncompleteEvidence("stats_container_origin_unproven_or_mutated")))
+	}
+	if origin == nil || origin.runtime != rt || origin.Values != stats {
+		return freeze()
+	}
+	refs := []gtttrace.NumericRef{}
+	for _, key := range []attributes.Stat{base, percent, flat} {
+		if key <= attributes.NoStat || key >= attributes.EndStatType {
+			return freeze()
+		}
+		if key >= attributes.DelimBaseStat {
+			refs = append(refs, gtttrace.LiteralRef(stats[key]))
+		} else {
+			refs = append(refs, gtttrace.EventRef(rt.RecordStatQuery(origin.Owner, key.String(), stats[key], origin.ModifierIDs, origin.query)))
+		}
+	}
+	if stats[base]*(1+stats[percent])+stats[flat] != observed {
+		return freeze()
+	}
+	record := func(op string, inputs []gtttrace.NumericRef, value float64) gtttrace.NumericRef {
+		return gtttrace.EventRef(rt.RecordNumericEval("", op, inputs, value, gtttrace.IncompleteEvidence("stats_container_observed_schedule")))
+	}
+	p := record("add", []gtttrace.NumericRef{gtttrace.LiteralRef(1), refs[1]}, 1+stats[percent])
+	x := record("multiply", []gtttrace.NumericRef{refs[0], p}, stats[base]*(1+stats[percent]))
+	return record("add", []gtttrace.NumericRef{x, refs[2]}, observed)
+}
+
+func GTTNewStatsOrigin(rt *gtttrace.Runtime, owner int, values attributes.Stats, contributions []GTTTraceStatContribution) *GTTStatsOrigin {
+	if !rt.Enabled() {
+		return nil
+	}
+	ids := []string{}
+	for _, c := range contributions {
+		if c.Accepted && c.ModifierEvalEventID != "" {
+			ids = append(ids, c.ModifierEvalEventID)
+		}
+	}
+	return GTTStatsOriginFromModifiers(rt, owner, values, ids)
+}
+
+func GTTStatsOriginFromModifiers(rt *gtttrace.Runtime, owner int, values attributes.Stats, ids []string, nonExtra ...bool) *GTTStatsOrigin {
+	if !rt.Enabled() || len(nonExtra) > 1 {
+		return nil
+	}
+	filtered := len(nonExtra) == 1 && nonExtra[0]
+	return &GTTStatsOrigin{runtime: rt, query: rt.NewStatQuery(filtered), Owner: owner, Values: values, ModifierIDs: append([]string(nil), ids...)}
+}
+
+// observed is the value already read by gameplay, not a fresh getter call.
+// A later unobserved mutation is a boundary, never stale snapshot ancestry.
+func GTTSnapshotStatRef(rt *gtttrace.Runtime, snapshot Snapshot, key attributes.Stat, observed float64) gtttrace.NumericRef {
+	origin := snapshot.GTTStatsOrigin
+	if origin == nil || origin.runtime != rt || key <= attributes.NoStat || key >= attributes.EndStatType || origin.Values[key] != observed || snapshot.Stats[key] != observed {
+		return gtttrace.EventRef(rt.RecordNumericEval("", "frozen_attack_operand", nil, observed, gtttrace.IncompleteEvidence("snapshot_stat_origin_unproven_or_mutated")))
+	}
+	if key >= attributes.DelimBaseStat {
+		return gtttrace.LiteralRef(observed)
+	}
+	return gtttrace.EventRef(rt.RecordStatQuery(origin.Owner, key.String(), observed, origin.ModifierIDs, origin.query))
 }
 
