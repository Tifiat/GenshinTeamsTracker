new file mode 100644
--- /dev/null
+++ b/pkg/gtttrace/stat_query.go
@@ -0,0 +1,47 @@
+package gtttrace
+
+// A query belongs to the instant at which gameplay evaluated its getter, not
+// the later use of a saved snapshot. It records identity and Extra filtering
+// only: it does not prove a changed set's lifecycle or call any modifier again.
+type StatQueryContext struct {
+	runtime  *Runtime
+	id       uint64
+	frame    int
+	sequence int
+	order    uint64
+	nonExtra bool
+}
+
+func (r *Runtime) NewStatQuery(nonExtra bool) StatQueryContext {
+	if !r.Enabled() || r.nextStatQueryID >= 1<<53-1 {
+		return StatQueryContext{}
+	}
+	r.nextStatQueryID++
+	return StatQueryContext{runtime: r, id: r.nextStatQueryID, frame: r.Frame(), sequence: len(r.stateEvents), order: r.NextObservationOrder(), nonExtra: nonExtra}
+}
+
+func (r *Runtime) RecordStatQuery(owner int, key string, value float64, modifiers []string, query StatQueryContext) string {
+	if !r.Enabled() || query.runtime != r || query.id == 0 || owner < 0 || key == "" || !finite(value) {
+		return ""
+	}
+	mode := "stat"
+	if query.nonExtra {
+		mode = "non_extra_stat"
+	}
+	payload := func(key string, value float64) NumericPayload {
+		return NumericPayload{Key: key, Value: value, Reference: LiteralRef(value)}
+	}
+	return r.appendStateEvent(StateEvent{
+		Frame: r.Frame(), Kind: StateEventNumericEval, OwnerIndex: optionalInt(owner),
+		Operation: optionalString("artifact_stat_read"), Key: optionalString(key),
+		Channel: optionalString("stat_input:" + mode),
+		Value: optionalFloat(value), ModifierEvalIDs: modifiers,
+		NumericPayload: []NumericPayload{
+			payload("stat_query_id", float64(query.id)),
+			payload("stat_query_frame", float64(query.frame)),
+			payload("stat_query_sequence", float64(query.sequence)),
+			payload("stat_query_order", float64(query.order)),
+		},
+		CandidateDependencyComplete: false, UncertaintyCodes: []string{"stat_read_external_dependencies_incomplete"},
+	})
+}
